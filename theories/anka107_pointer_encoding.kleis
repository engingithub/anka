// Reserved ABI v2 encodings, not yet executable ISA declarations. No axioms.
import "anka107_pointer_events.kleis"
// Same 32-bit R/I/S formats as desc.rs; six-bit opcode at bits 31..26.
define encoding107_r(op : BitVec32, d : BitVec32, s : BitVec32,
    t : BitVec32, f : BitVec32) =
    bvor(bvshl(op,bvconst(26,32)),bvor(bvshl(d,bvconst(22,32)),
    bvor(bvshl(s,bvconst(18,32)),bvor(bvshl(t,bvconst(14,32)),f))))
define encoding107_i(op : BitVec32, d : BitVec32, s : BitVec32, bits : BitVec32) =
    encoding107_r(op,d,s,bvconst(0,32),bits)
define encoding107_op(w : BitVec32) = bvlshr(w,bvconst(26,32))
define encoding107_d(w : BitVec32) = bvand(bvlshr(w,bvconst(22,32)),bvconst(15,32))
define encoding107_s(w : BitVec32) = bvand(bvlshr(w,bvconst(18,32)),bvconst(15,32))
define encoding107_t(w : BitVec32) = bvand(bvlshr(w,bvconst(14,32)),bvconst(15,32))
define encoding107_f(w : BitVec32) = bvand(w,bvconst(16383,32))
define encoding107_imm(w : BitVec32) = bvand(w,bvconst(262143,32))
define encoding107_pair(x : BitVec32) = bvule(x,bvconst(10,32)) ∧
    (bvand(x,bvconst(1,32))=bvconst(0,32))
define encoding107_scalar(x : BitVec32) = bvule(x,bvconst(12,32))
// Signed immediate bits must be supplied only after representability checking.
define encoding107_imm_fits(x : BitVec64) =
    bvsge(x,bvsub(bvconst(0,64),bvconst(131072,64))) ∧ bvsle(x,bvconst(131071,64))
define encoding107_signed(bits : BitVec64) =
    if bvuge(bits,bvconst(131072,64)) then bvsub(bits,bvconst(262144,64)) else bits
// PMOV 26: pair,pair; PADD 27: pair,pair,scalar signed byte displacement.
// PLOAD/PSTORE 28/29: pair,[pair + signed imm18]; no raw storage address.
// PREAD/PWRITE 2a/2b: scalar,[pair]; func is log2(width) 0..3, rs2=0.
// PFRAME 2c S: manifest index26. PLOCAL 2d I: pair,local index17, rs1=0.
// PUNFRAME 2e S: all payload bits zero. 2f remains unassigned.
define encoding107_valid(w : BitVec32) =
    if encoding107_op(w)=bvconst(38,32) then
        encoding107_pair(encoding107_d(w)) ∧ encoding107_pair(encoding107_s(w)) ∧
        (encoding107_t(w)=bvconst(0,32)) ∧ (encoding107_f(w)=bvconst(0,32))
    else if encoding107_op(w)=bvconst(39,32) then
        encoding107_pair(encoding107_d(w)) ∧ encoding107_pair(encoding107_s(w)) ∧
        encoding107_scalar(encoding107_t(w)) ∧ (encoding107_f(w)=bvconst(0,32))
    else if (encoding107_op(w)=bvconst(40,32)) ∨ (encoding107_op(w)=bvconst(41,32)) then
        encoding107_pair(encoding107_d(w)) ∧ encoding107_pair(encoding107_s(w))
    else if (encoding107_op(w)=bvconst(42,32)) ∨ (encoding107_op(w)=bvconst(43,32)) then
        encoding107_scalar(encoding107_d(w)) ∧ encoding107_pair(encoding107_s(w)) ∧
        (encoding107_t(w)=bvconst(0,32)) ∧ bvule(encoding107_f(w),bvconst(3,32))
    else if encoding107_op(w)=bvconst(44,32) then (bvconst(0,32)=bvconst(0,32))
    else if encoding107_op(w)=bvconst(45,32) then
        encoding107_pair(encoding107_d(w)) ∧ (encoding107_s(w)=bvconst(0,32)) ∧
        bvule(encoding107_imm(w),bvconst(131071,32))
    else if encoding107_op(w)=bvconst(46,32) then
        bvand(w,bvconst(67108863,32))=bvconst(0,32)
    else ¬(bvconst(0,32)=bvconst(0,32))
// Decode validity is not authority. ABI profile, source kind, descriptor and
// Fabric admission still precede any effect; reserved words fault unchanged.
define encoding107_execute(w : BitVec32, profile : BitVec8, semantic_admit : BitVec8) =
    encoding107_valid(w) ∧ (profile=bvconst(1,8)) ∧ (semantic_admit=bvconst(1,8))

define encoding107_r_inputs(op : BitVec32, d : BitVec32, s : BitVec32, t : BitVec32, f : BitVec32) = bvule(op,bvconst(63,32)) ∧ bvule(d,bvconst(15,32)) ∧ bvule(s,bvconst(15,32)) ∧ bvule(t,bvconst(15,32)) ∧ bvule(f,bvconst(16383,32))

example "PMOV canonical encoding" { assert(encoding107_valid(encoding107_r(bvconst(38,32),bvconst(4,32),bvconst(2,32),bvconst(0,32),bvconst(0,32)))) }

example "PADD canonical encoding" { assert(encoding107_valid(encoding107_r(bvconst(39,32),bvconst(4,32),bvconst(2,32),bvconst(12,32),bvconst(0,32)))) }

example "PLOAD canonical encoding" { assert(encoding107_valid(encoding107_r(bvconst(40,32),bvconst(4,32),bvconst(2,32),bvconst(0,32),bvconst(0,32)))) }

example "PSTORE canonical encoding" { assert(encoding107_valid(encoding107_r(bvconst(41,32),bvconst(4,32),bvconst(2,32),bvconst(0,32),bvconst(0,32)))) }

example "PREAD canonical encoding" { assert(encoding107_valid(encoding107_r(bvconst(42,32),bvconst(4,32),bvconst(2,32),bvconst(0,32),bvconst(0,32)))) }

example "PWRITE canonical encoding" { assert(encoding107_valid(encoding107_r(bvconst(43,32),bvconst(4,32),bvconst(2,32),bvconst(0,32),bvconst(0,32)))) }

example "PFRAME canonical encoding" { assert(encoding107_valid(encoding107_r(bvconst(44,32),bvconst(0,32),bvconst(0,32),bvconst(0,32),bvconst(0,32)))) }

example "PLOCAL canonical encoding" { assert(encoding107_valid(encoding107_r(bvconst(45,32),bvconst(4,32),bvconst(0,32),bvconst(0,32),bvconst(0,32)))) }

example "PUNFRAME canonical encoding" { assert(encoding107_valid(encoding107_r(bvconst(46,32),bvconst(0,32),bvconst(0,32),bvconst(0,32),bvconst(0,32)))) }

example "pair 0" { assert(encoding107_pair(bvconst(0,32))) }

example "pair 2" { assert(encoding107_pair(bvconst(2,32))) }

example "pair 4" { assert(encoding107_pair(bvconst(4,32))) }

example "pair 6" { assert(encoding107_pair(bvconst(6,32))) }

example "pair 8" { assert(encoding107_pair(bvconst(8,32))) }

example "pair 10" { assert(encoding107_pair(bvconst(10,32))) }

example "invalid pair 1" { assert(¬(encoding107_valid(encoding107_r(bvconst(38,32),bvconst(1,32),bvconst(2,32),bvconst(0,32),bvconst(0,32))))) }

example "invalid pair 11" { assert(¬(encoding107_valid(encoding107_r(bvconst(38,32),bvconst(11,32),bvconst(2,32),bvconst(0,32),bvconst(0,32))))) }

example "invalid pair 12" { assert(¬(encoding107_valid(encoding107_r(bvconst(38,32),bvconst(12,32),bvconst(2,32),bvconst(0,32),bvconst(0,32))))) }

example "invalid pair 13" { assert(¬(encoding107_valid(encoding107_r(bvconst(38,32),bvconst(13,32),bvconst(2,32),bvconst(0,32),bvconst(0,32))))) }

example "invalid pair 14" { assert(¬(encoding107_valid(encoding107_r(bvconst(38,32),bvconst(14,32),bvconst(2,32),bvconst(0,32),bvconst(0,32))))) }

example "invalid pair 15" { assert(¬(encoding107_valid(encoding107_r(bvconst(38,32),bvconst(15,32),bvconst(2,32),bvconst(0,32),bvconst(0,32))))) }

example "PMOV unused rs2" { assert(¬(encoding107_valid(encoding107_r(bvconst(38,32),bvconst(4,32),bvconst(2,32),bvconst(1,32),bvconst(0,32))))) }

example "PMOV reserved func" { assert(¬(encoding107_valid(encoding107_r(bvconst(38,32),bvconst(4,32),bvconst(2,32),bvconst(0,32),bvconst(1,32))))) }

example "PADD reserved scalar" { assert(¬(encoding107_valid(encoding107_r(bvconst(39,32),bvconst(4,32),bvconst(2,32),bvconst(13,32),bvconst(0,32))))) }

example "PREAD reserved destination" { assert(¬(encoding107_valid(encoding107_r(bvconst(42,32),bvconst(13,32),bvconst(2,32),bvconst(0,32),bvconst(0,32))))) }

example "PWRITE odd address pair" { assert(¬(encoding107_valid(encoding107_r(bvconst(43,32),bvconst(4,32),bvconst(3,32),bvconst(0,32),bvconst(0,32))))) }

example "PREAD reserved rs2" { assert(¬(encoding107_valid(encoding107_r(bvconst(42,32),bvconst(4,32),bvconst(2,32),bvconst(1,32),bvconst(0,32))))) }

example "PREAD invalid width" { assert(¬(encoding107_valid(encoding107_r(bvconst(42,32),bvconst(4,32),bvconst(2,32),bvconst(0,32),bvconst(4,32))))) }

example "PLOCAL raw base rejected" { assert(¬(encoding107_valid(encoding107_r(bvconst(45,32),bvconst(4,32),bvconst(2,32),bvconst(0,32),bvconst(0,32))))) }

example "PLOCAL negative index" { assert(¬(encoding107_valid(encoding107_r(bvconst(45,32),bvconst(4,32),bvconst(0,32),bvconst(0,32),bvconst(131072,32))))) }

example "PUNFRAME reserved payload" { assert(¬(encoding107_valid(encoding107_r(bvconst(46,32),bvconst(0,32),bvconst(0,32),bvconst(0,32),bvconst(1,32))))) }

example "unassigned opcode" { assert(¬(encoding107_valid(encoding107_r(bvconst(47,32),bvconst(0,32),bvconst(0,32),bvconst(0,32),bvconst(0,32))))) }

example "PREAD width 1" { assert(encoding107_valid(encoding107_r(bvconst(42,32),bvconst(12,32),bvconst(2,32),bvconst(0,32),bvconst(0,32)))) }

example "PREAD width 2" { assert(encoding107_valid(encoding107_r(bvconst(42,32),bvconst(12,32),bvconst(2,32),bvconst(0,32),bvconst(1,32)))) }

example "PREAD width 4" { assert(encoding107_valid(encoding107_r(bvconst(42,32),bvconst(12,32),bvconst(2,32),bvconst(0,32),bvconst(2,32)))) }

example "PREAD width 8" { assert(encoding107_valid(encoding107_r(bvconst(42,32),bvconst(12,32),bvconst(2,32),bvconst(0,32),bvconst(3,32)))) }

example "imm18 boundary -131072" { assert(encoding107_imm_fits(bvsub(bvconst(0,64),bvconst(131072,64)))) }

example "imm18 boundary 131071" { assert(encoding107_imm_fits(bvconst(131071,64))) }

example "imm18 overflow 131072" { assert(¬(encoding107_imm_fits(bvconst(131072,64)))) }

example "imm18 overflow -131073" { assert(¬(encoding107_imm_fits(bvsub(bvconst(0,64),bvconst(131073,64))))) }

example "negative immediate sign extends" { assert(encoding107_signed(bvconst(262143,64))=bvsub(bvconst(0,64),bvconst(1,64))) }

example "typed negative displacement 40" { assert(encoding107_valid(encoding107_i(bvconst(40,32),bvconst(4,32),bvconst(2,32),bvconst(262143,32)))) }

example "typed negative displacement 41" { assert(encoding107_valid(encoding107_i(bvconst(41,32),bvconst(4,32),bvconst(2,32),bvconst(262143,32)))) }

example "invalid profile no dispatch" { assert(¬(encoding107_execute(encoding107_r(bvconst(38,32),bvconst(4,32),bvconst(2,32),bvconst(0,32),bvconst(0,32)),bvconst(0,8),bvconst(1,8)))) }

example "valid encoding cannot manufacture kind" { assert(¬(encoding107_execute(encoding107_r(bvconst(38,32),bvconst(4,32),bvconst(2,32),bvconst(0,32),bvconst(0,32)),bvconst(1,8),bvconst(0,8)))) }

example "all R fields round trip" { assert(∀(op : BitVec32). ∀(d : BitVec32). ∀(s : BitVec32). ∀(t : BitVec32). ∀(f : BitVec32). (bvule(op,bvconst(63,32)) ∧ bvule(d,bvconst(15,32)) ∧ bvule(s,bvconst(15,32)) ∧ bvule(t,bvconst(15,32)) ∧ bvule(f,bvconst(16383,32))) → (encoding107_op(encoding107_r(op,d,s,t,f))=op ∧ encoding107_d(encoding107_r(op,d,s,t,f))=d ∧ encoding107_s(encoding107_r(op,d,s,t,f))=s ∧ encoding107_t(encoding107_r(op,d,s,t,f))=t ∧ encoding107_f(encoding107_r(op,d,s,t,f))=f)) }

example "all I immediates round trip" { assert(∀(bits : BitVec32). bvule(bits,bvconst(262143,32)) → (encoding107_imm(encoding107_i(bvconst(40,32),bvconst(4,32),bvconst(2,32),bits))=bits)) }

example "assembler rejects oversized register before encoding" { assert(¬(encoding107_r_inputs(bvconst(38,32),bvconst(16,32),bvconst(2,32),bvconst(0,32),bvconst(0,32)))) }

example "assembler rejects oversized function before encoding" { assert(¬(encoding107_r_inputs(bvconst(38,32),bvconst(4,32),bvconst(2,32),bvconst(0,32),bvconst(16384,32)))) }
