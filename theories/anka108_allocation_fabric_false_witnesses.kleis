}

example "raw write: overlap clears both touched cells" {
    assert(¬((kind107_raw_memory(bvconst(8207,64),bvconst(2,64),bvconst(8192,64),bvconst(1,8))=bvconst(0,8)) ∧ (kind107_raw_memory(bvconst(8207,64),bvconst(2,64),bvconst(8208,64),bvconst(1,8))=bvconst(0,8))))
}

example "raw write: neighbor outside write survives" {
    assert(¬(kind107_raw_memory(bvconst(8207,64),bvconst(2,64),bvconst(8224,64),bvconst(1,8))=bvconst(1,8)))
}

example "cleanup: revision exhaustion does not block closure" {
    assert(¬(a23_close(a23_true(),bvconst(2,8),bvconst(1,8),a23_true(),bvconst(1,8)) ∧ (a22_cleanup_revision(ptr107_max())=ptr107_max())))
}

example "reuse: new lifetime authenticates with new epoch" {
    assert(¬(a23_current(repr107_handle(bvconst(2,64),bvconst(10,64)),bvconst(1,8),bvconst(2,64),bvconst(10,64),bvconst(2,8),a23_true())))
}

example "reuse: same address cannot rescue old token" {
    assert(a23_current(repr107_handle(bvconst(2,64),bvconst(9,64)),bvconst(1,8),bvconst(2,64),bvconst(10,64),bvconst(2,8),a23_true()))
}

example "trace: attach, two chunks, publication and close all admitted" {
    assert(¬(a23_trace_attach() ∧ a23_trace_first() ∧ a23_trace_second() ∧ a23_trace_publish() ∧ a23_trace_current() ∧ a23_trace_close()))
}

example "trace: half initialized backing never publishes" {
    assert(a23_publish(a23_true(),a23_true(),a23_true(),a23_trace_private(),a23_trace_attached(),a23_trace_done1(),bvconst(4096,64),a23_trace_version1(),a23_trace_version1(),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(1,8),a23_true(),a23_true(),a23_trace_revision2(),a23_trace_revision2(),bvconst(1,8)))
}

example "trace: final logical byte has a successful zero read" {
    assert(¬(a23_access(a23_trace_current(),a23_trace_key(),bvconst(30,64),bvconst(31,64),bvconst(1,64),bvconst(1,64),a23_true()) ∧ (a23_trace_byte(bvconst(8222,64),bvconst(255,8))=bvconst(0,8))))
}

example "trace: cleared padding is still inaccessible" {
    assert(a23_access(a23_trace_current(),a23_trace_key(),bvconst(31,64),bvconst(31,64),bvconst(1,64),bvconst(1,64),a23_true()))
}

example "trace: register spill or event copy fails after closure" {
    assert(a23_current(a23_trace_handle(),a23_trace_tag(),bvconst(2,64),bvconst(9,64),a23_trace_closed(),a23_trace_owner()))
}

example "trace: attached failure never takes direct cancel" {
    assert(a23_direct_cancel(a23_trace_private(),a23_trace_attached(),a23_true()))
}

example "trace: unrelated owner B remains current" {
    assert(¬(a23_current(repr107_handle(bvconst(3,64),bvconst(4,64)),bvconst(1,8),bvconst(3,64),bvconst(4,64),heap108_record_phase(a23_trace_close(),bvconst(7,64),bvconst(8,64),bvconst(2,8),bvconst(3,8)),a23_true())))
}

example "trace: trusted mutation resets initialized prefix" {
    assert(¬(a23_trace_dirty() ∧ (init108_dirty_done(a23_trace_dirty(),a23_trace_done2())=bvconst(0,64))))
}

example "trace: old clean receipt cannot follow mutation" {
    assert(a23_publish(a23_true(),a23_true(),a23_true(),bvconst(1,8),bvconst(1,8),init108_dirty_done(a23_trace_dirty(),a23_trace_done2()),bvconst(4096,64),init108_version(a23_trace_dirty(),a23_trace_version2()),a23_trace_version2(),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(1,8),a23_true(),a23_true(),a23_next(a23_trace_dirty(),a23_trace_revision3()),a23_next(a23_trace_dirty(),a23_trace_revision3()),bvconst(1,8)))
}


example "hostile skip new high row" { assert(a23_prefix_attach(bvconst(5,64),bvconst(7000,64),bvconst(5,64),bvconst(36864,64))) }
example "hostile erase earlier rows on hole reuse" { assert(a23_prefix_attach(bvconst(7001,64),bvconst(2,64),bvconst(3,64),bvconst(36864,64))) }
example "hostile prefix exceeds storage" { assert(a23_prefix_row(bvconst(1,64),bvconst(36865,64),bvconst(36864,64))) }
example "hostile trim occupied suffix" { assert(a23_prefix_trim(bvconst(7001,64),bvconst(5,64),bvconst(36864,64),a23_false())) }
example "hostile wrap attachment" { assert(a23_prefix_attach(bvconst(0,64),bvsub(a23_z(),a23_o()),a23_z(),bvsub(a23_z(),a23_o()))) }
