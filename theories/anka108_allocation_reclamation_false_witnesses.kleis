// Every assertion deliberately contradicts the reclamation contract.
// Acceptance requires explicit Z3 disproof of EACH example; unknown,
// timeout, parser errors or unevaluated expressions are never a pass.
import "anka108_allocation_reclamation.kleis"

example "HOSTILE reclaim108_take rejects empty request" {
    assert(reclaim108_take(bvconst(4096,64),bvconst(16384,64),bvconst(0,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8)))
}

