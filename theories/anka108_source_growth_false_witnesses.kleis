import "anka108_source_growth.kleis"
example "hostile: source 0 65528 65528" { assert(¬(sg108_source(bvconst(0,64),bvconst(65528,64),bvconst(65528,64)))) }
example "hostile: source 0 65529 65536" { assert(¬(¬(sg108_source(bvconst(0,64),bvconst(65529,64),bvconst(65536,64))))) }
