}

example "trace: old clean receipt cannot follow mutation" {
    assert(¬(a23_publish(a23_true(),a23_true(),a23_true(),bvconst(1,8),bvconst(1,8),init108_dirty_done(a23_trace_dirty(),a23_trace_done2()),bvconst(4096,64),init108_version(a23_trace_dirty(),a23_trace_version2()),a23_trace_version2(),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(1,8),a23_true(),a23_true(),a23_next(a23_trace_dirty(),a23_trace_revision3()),a23_next(a23_trace_dirty(),a23_trace_revision3()),bvconst(1,8))))
}

example "law: encoded slot indexes a retained Fabric row" {
    assert(∀(s : BitVec64). ∀(n : BitVec64). ∀(cap : BitVec64). (a23_row(s,n,cap) → (bvult(a23_row_index(s),cap) ∧ (bvadd(a23_row_index(s),bvconst(1,64))=s))))
}

example "law: valid physical cell indexes bounded dense shadow" {
    assert(∀(p : BitVec64). ∀(n : BitVec64). ∀(a : BitVec64). (a23_shadow_cell(p,n,a) → bvult(a23_shadow_index(p,a),a23_shadow_count(n))))
}

example "law: distinct valid physical cells have distinct shadow entries" {
    assert(∀(p : BitVec64). ∀(n : BitVec64). ∀(a : BitVec64). ∀(b : BitVec64). ((a23_shadow_cell(p,n,a) ∧ a23_shadow_cell(p,n,b) ∧ ¬(a=b)) → ¬(a23_shadow_index(p,a)=a23_shadow_index(p,b))))
}

example "law: fresh object counter never wraps" {
    assert(∀(n : BitVec64). (a23_object(n,n,a23_true()) → bvugt(a23_next(a23_true(),n),n)))
}

example "law: new publication preserves the reserved allocation epoch" {
    assert(∀(epoch : BitVec64). (a23_epoch(epoch)=epoch))
}

example "law: attachment and publication neither recharge nor refund payload" {
    assert(∀(used : BitVec64). (a23_charge(used)=used))
}

example "law: successful fixed storage is charged exactly once" {
    assert(∀(old : BitVec64). ∀(rows : BitVec64). ∀(shadow : BitVec64). ∀(scratch : BitVec64). ∀(total : BitVec64). (a22_fixed(old,rows,shadow,scratch,bvconst(0,64),bvconst(0,64),total) → (total=bvadd(bvadd(bvadd(old,rows),shadow),scratch))))
}

example "law: each initialized prefix step stays within rounded custody" {
    assert(∀(d : BitVec64). ∀(a : BitVec64). ∀(r : BitVec64). ∀(ver : BitVec64). (init108_chunk(bvconst(1,8),d,a,r,ver,ver,bvconst(1,8),bvconst(1,8)) → (bvugt(init108_done(a23_true(),d,a),d) ∧ bvule(init108_done(a23_true(),d,a),r))))
}

example "law: chunk initializes every newly reached byte" {
    assert(∀(d : BitVec64). ∀(a : BitVec64). ∀(r : BitVec64). ∀(ver : BitVec64). ∀(q : BitVec64). ∀(old : BitVec8). ((init108_chunk(bvconst(1,8),d,a,r,ver,ver,bvconst(1,8),bvconst(1,8)) ∧ bvuge(q,d) ∧ bvult(q,bvadd(d,a))) → (init108_byte(a23_true(),d,a,q,old)=bvconst(0,8))))
}

example "law: chunk preserves the already zero prefix" {
    assert(∀(d : BitVec64). ∀(a : BitVec64). ∀(q : BitVec64). ((bvult(q,d)) → (init108_byte(a23_true(),d,a,q,bvconst(0,8))=bvconst(0,8))))
}

example "law: failed initialization preserves every byte" {
    assert(∀(b : BitVec64). ∀(d : BitVec64). ∀(a : BitVec64). ∀(q : BitVec64). ∀(old : BitVec8). (a23_byte(a23_false(),b,d,a,q,old)=old))
}

example "law: failed initialization preserves every protected tag" {
    assert(∀(b : BitVec64). ∀(d : BitVec64). ∀(a : BitVec64). ∀(q : BitVec64). ∀(old : BitVec8). (a23_tag(a23_false(),b,d,a,q,old)=old))
}

example "law: rejected commit preserves stage and sticky attachment" {
    assert(∀(s : BitVec8). ∀(sticky : BitVec8). ((a23_stage(a23_false(),s,bvconst(2,8))=s) ∧ (a23_attached(a23_false(),sticky)=sticky)))
}

example "law: rejected commit preserves counters and result payload" {
    assert(∀(counter : BitVec64). ∀(slot : BitVec64). ∀(epoch : BitVec64). ∀(h : BitVec64). ∀(pos : BitVec64). ∀(tag : BitVec8). ((a23_next(a23_false(),counter)=counter) ∧ (a23_result_handle(a23_false(),slot,epoch,h)=h) ∧ (a23_result_position(a23_false(),pos)=pos) ∧ (a23_result_tag(a23_false(),tag)=tag)))
}

example "law: unselected owner fields are unchanged" {
    assert(∀(s : BitVec64). ∀(q : BitVec64). ∀(old : BitVec64). ∀(next : BitVec64). ∀(commit : Bool). (¬(s=q) → (a23_field(commit,s,q,old,next)=old)))
}

example "law: object map and grant become visible together" {
    assert(∀(s : BitVec8). ∀(owner : Bool). ((a23_object_visible(s,owner)=a23_map_visible(s,owner)) ∧ (a23_map_visible(s,owner)=a23_grant_visible(s,owner))))
}

example "law: private and closing stages expose no authority" {
    assert(∀(s : BitVec8). ∀(owner : Bool). (¬(s=bvconst(2,8)) → ¬(a23_visible(s,owner))))
}

example "law: a closed owner has no visible heap even in live stage" {
    assert(∀(s : BitVec8). (¬(a23_visible(s,a23_false()))))
}

example "law: all old aliases fail after close regardless of storage location" {
    assert(∀(h : BitVec64). ∀(slot : BitVec64). ∀(epoch : BitVec64). ∀(tag : BitVec8). ∀(owner : Bool). (¬(a23_current(h,tag,slot,epoch,bvconst(3,8),owner))))
}

example "law: scalar words never recreate pointer kind" {
    assert(∀(h : BitVec64). ∀(slot : BitVec64). ∀(epoch : BitVec64). (¬(a23_current(h,bvconst(0,8),slot,epoch,bvconst(2,8),a23_true()))))
}

example "law: one past end is not a data access" {
    assert(∀(n : BitVec64). ∀(width : BitVec64). (¬(a23_access(a23_true(),a23_true(),n,n,width,bvconst(1,64),a23_true()))))
}

example "law: sticky attachment permanently excludes direct cancellation" {
    assert(∀(s : BitVec8). (¬(a23_direct_cancel(s,bvconst(1,8),a23_true()))))
}

example "law: same virtual or physical address cannot authenticate a stale epoch" {
    assert(∀(slot : BitVec64). ∀(epoch : BitVec64). ((repr107_components(slot,epoch) ∧ bvult(epoch,repr107_mask())) → ¬(a23_current(repr107_handle(slot,epoch),bvconst(1,8),slot,bvadd(epoch,bvconst(1,64)),bvconst(2,8),a23_true()))))
}

example "law: trace clears every byte including rounded padding" {
    assert(∀(q : BitVec64). ∀(secret : BitVec8). ((bvuge(q,bvconst(8192,64)) ∧ bvult(q,bvconst(12288,64))) → (a23_trace_byte(q,secret)=bvconst(0,8))))
}

example "law: trace reveals no prior byte for any newly readable position" {
    assert(∀(pos : BitVec64). ∀(x : BitVec8). ∀(y : BitVec8). (bvult(pos,bvconst(31,64)) → (a23_access(a23_trace_current(),a23_trace_key(),pos,bvconst(31,64),bvconst(1,64),bvconst(1,64),a23_true()) ∧ (a23_trace_byte(bvadd(bvconst(8192,64),pos),x)=a23_trace_byte(bvadd(bvconst(8192,64),pos),y)))))
}

example "law: trace preserves every byte outside A backing including B" {
    assert(∀(q : BitVec64). ∀(old : BitVec8). ((bvult(q,bvconst(8192,64)) ∨ bvuge(q,bvconst(12288,64))) → (a23_trace_byte(q,old)=old)))
}

example "law: trace clears every aligned tag in A backing" {
    assert(∀(cell : BitVec64). ∀(old : BitVec8). ((init108_aligned(cell) ∧ bvuge(cell,bvconst(8192,64)) ∧ bvult(cell,bvconst(12288,64))) → (a23_trace_shadow(cell,old)=bvconst(0,8))))
}

example "law: trace preserves all aligned tags in B backing" {
    assert(∀(cell : BitVec64). ∀(old : BitVec8). ((init108_aligned(cell) ∧ bvuge(cell,bvconst(12288,64))) → (a23_trace_shadow(cell,old)=old)))
}

example "law: failed publication result preserves existing pair" {
    assert(∀(h : BitVec64). ∀(p : BitVec64). ∀(s : BitVec64). ∀(e : BitVec64). ∀(tag : BitVec8). ((a23_result_handle(a23_false(),s,e,h)=h) ∧ (a23_result_position(a23_false(),p)=p) ∧ (a23_result_tag(a23_false(),tag)=tag)))
}

example "law: typed heap store cannot contain fallible host work" {
    assert(∀(cell : Bool). ∀(source : Bool). ∀(coherent : BitVec8). ∀(locked : BitVec8). (¬(a23_store(cell,source,coherent,a23_false(),locked))))
}

