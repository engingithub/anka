// Every hostile must be explicitly disproved, never Unknown.
import "anka107_pointer_concurrency.kleis"

example "FALSE-CONC107-1 CPU admission first" { assert(¬(conc107_admit(bvconst(1,8),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8)))) }

