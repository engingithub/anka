// AS110: bounded artifact staging, durable completion and atomic reference publication.
// No new axioms. One serialized candidate plus one existing selected object and
// an arbitrary unaffected peer. Phase 0 empty, 1 private, 2 durable orphan,
// 3 published retained. Published GC and multiple concurrent candidate tables
// require further refinement; other_bytes accounts all previous retained data.
// IDs denote exact immutable content identities, not hashes or Fabric pointers.
// Authority verdicts are trusted CURRENT T1/evidence-provider projections.
// Backend phase/poison/deletion observations are trusted, never caller booleans.
// d110 host/filesystem durability assumptions apply. This is not cryptography,
// a byte codec, a power-failure experiment or a distributed consensus proof.
import "anka110_stored_launch.kleis"
import "anka110_durable_record.kleis"
define as110_true() = (bvconst(1,8)=bvconst(1,8))
define as110_false() = (bvconst(1,8)=bvconst(0,8))

data AS110State = AS110State(phase : BitVec64,ticket : BitVec64,owner : BitVec64,inc : BitVec64,cursor : BitVec64,charge : BitVec64,work : BitVec64,last_off : BitVec64,last_n : BitVec64,last_data : BitVec64,high : BitVec64,boot : BitVec64,other_bytes : BitVec64,peer : BitVec64,revision : BitVec64,selected : BitVec64,selected_gen : BitVec64,request : BitVec64,expected : BitVec64,anchor : BitVec64,installation : BitVec64,artifact : BitVec64,generation : BitVec64,role : BitVec8,profile : BitVec64,size : BitVec64,image : BitVec64,metadata : BitVec64,dependencies : BitVec64,provenance : BitVec64)
define ast_phase(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => phase }
define ast_ticket(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => ticket }
define ast_owner(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => owner }
define ast_inc(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => inc }
define ast_cursor(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => cursor }
define ast_charge(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => charge }
define ast_work(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => work }
define ast_last_off(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => last_off }
define ast_last_n(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => last_n }
define ast_last_data(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => last_data }
define ast_high(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => high }
define ast_boot(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => boot }
define ast_other_bytes(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => other_bytes }
define ast_peer(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => peer }
define ast_revision(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => revision }
define ast_selected(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => selected }
define ast_selected_gen(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => selected_gen }
define ast_request(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => request }
define ast_expected(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => expected }
define ast_anchor(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => anchor }
define ast_installation(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => installation }
define ast_artifact(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => artifact }
define ast_generation(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => generation }
define ast_role(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => role }
define ast_profile(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => profile }
define ast_size(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => size }
define ast_image(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => image }
define ast_metadata(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => metadata }
define ast_dependencies(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => dependencies }
define ast_provenance(x : AS110State) = match x { AS110State(phase,ticket,owner,inc,cursor,charge,work,last_off,last_n,last_data,high,boot,other_bytes,peer,revision,selected,selected_gen,request,expected,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => provenance }
data AS110Access = AS110Access(anchor : BitVec64,installation : BitVec64,owner : BitVec64,inc : BitVec64,boot : BitVec64,operation : BitVec64,artifact : BitVec64,generation : BitVec64,verdict : A109Verdict)
define asa_anchor(x : AS110Access) = match x { AS110Access(anchor,installation,owner,inc,boot,operation,artifact,generation,verdict) => anchor }
define asa_installation(x : AS110Access) = match x { AS110Access(anchor,installation,owner,inc,boot,operation,artifact,generation,verdict) => installation }
define asa_owner(x : AS110Access) = match x { AS110Access(anchor,installation,owner,inc,boot,operation,artifact,generation,verdict) => owner }
define asa_inc(x : AS110Access) = match x { AS110Access(anchor,installation,owner,inc,boot,operation,artifact,generation,verdict) => inc }
define asa_boot(x : AS110Access) = match x { AS110Access(anchor,installation,owner,inc,boot,operation,artifact,generation,verdict) => boot }
define asa_operation(x : AS110Access) = match x { AS110Access(anchor,installation,owner,inc,boot,operation,artifact,generation,verdict) => operation }
define asa_artifact(x : AS110Access) = match x { AS110Access(anchor,installation,owner,inc,boot,operation,artifact,generation,verdict) => artifact }
define asa_generation(x : AS110Access) = match x { AS110Access(anchor,installation,owner,inc,boot,operation,artifact,generation,verdict) => generation }
define asa_verdict(x : AS110Access) = match x { AS110Access(anchor,installation,owner,inc,boot,operation,artifact,generation,verdict) => verdict }
define as110_same(s : AS110State,t : AS110State) = (ast_phase(t)=ast_phase(s)) ∧ (ast_ticket(t)=ast_ticket(s)) ∧ (ast_owner(t)=ast_owner(s)) ∧ (ast_inc(t)=ast_inc(s)) ∧ (ast_cursor(t)=ast_cursor(s)) ∧ (ast_charge(t)=ast_charge(s)) ∧ (ast_work(t)=ast_work(s)) ∧ (ast_last_off(t)=ast_last_off(s)) ∧ (ast_last_n(t)=ast_last_n(s)) ∧ (ast_last_data(t)=ast_last_data(s)) ∧ (ast_high(t)=ast_high(s)) ∧ (ast_boot(t)=ast_boot(s)) ∧ (ast_other_bytes(t)=ast_other_bytes(s)) ∧ (ast_peer(t)=ast_peer(s)) ∧ (ast_revision(t)=ast_revision(s)) ∧ (ast_selected(t)=ast_selected(s)) ∧ (ast_selected_gen(t)=ast_selected_gen(s)) ∧ (ast_request(t)=ast_request(s)) ∧ (ast_expected(t)=ast_expected(s)) ∧ (ast_anchor(t)=ast_anchor(s)) ∧ (ast_installation(t)=ast_installation(s)) ∧ (ast_artifact(t)=ast_artifact(s)) ∧ (ast_generation(t)=ast_generation(s)) ∧ (ast_role(t)=ast_role(s)) ∧ (ast_profile(t)=ast_profile(s)) ∧ (ast_size(t)=ast_size(s)) ∧ (ast_image(t)=ast_image(s)) ∧ (ast_metadata(t)=ast_metadata(s)) ∧ (ast_dependencies(t)=ast_dependencies(s)) ∧ (ast_provenance(t)=ast_provenance(s))

define as110_bound(s : AS110State,m : SL110Artifact) =
(ast_anchor(s)=sa_anchor(m)) ∧ (ast_installation(s)=sa_installation(m)) ∧ (ast_artifact(s)=sa_artifact(m)) ∧ (ast_generation(s)=sa_generation(m)) ∧ (ast_role(s)=sa_role(m)) ∧ (ast_profile(s)=sa_profile(m)) ∧ (ast_size(s)=sa_size(m)) ∧ (ast_image(s)=sa_image(m)) ∧ (ast_metadata(s)=sa_metadata(m)) ∧ (ast_dependencies(s)=sa_dependencies(m)) ∧ (ast_provenance(s)=sa_provenance(m))
define as110_auth(s : AS110State,a : AS110Access,op : BitVec64) =
    (asa_verdict(a)=A109Valid) ∧ (asa_anchor(a)=ast_anchor(s)) ∧ (asa_installation(a)=ast_installation(s)) ∧
    (asa_boot(a)=ast_boot(s)) ∧ a109_nonzero(ast_boot(s)) ∧ (asa_operation(a)=op) ∧
    (asa_artifact(a)=ast_artifact(s)) ∧ (asa_generation(a)=ast_generation(s)) ∧
    a109_nonzero(asa_owner(a)) ∧ a109_nonzero(asa_inc(a))
define as110_owned(s : AS110State,a : AS110Access,ticket : BitVec64,op : BitVec64) =
    as110_auth(s,a,op) ∧ (asa_owner(a)=ast_owner(s)) ∧ (asa_inc(a)=ast_inc(s)) ∧
    a109_nonzero(ticket) ∧ (ticket=ast_ticket(s)) ∧ (ticket=ast_high(s))
define as110_charge(size : BitVec64,meta : BitVec64,own : BitVec64,other : BitVec64,limit : BitVec64) =
    a109_nonzero(size) ∧ a109_nonzero(meta) ∧ bvule(meta,bvsub(a109_max(),size)) ∧
    bvule(bvadd(size,meta),own) ∧ sl110_room(other,bvadd(size,meta),limit)
// Empty lane already carries the proposed manifest fields, but owns no bytes.
// Reservation validates them and freezes them; all subsequent steps preserve them.
define as110_can_reserve(s : AS110State,a : AS110Access,meta : BitVec64,own : BitVec64,limit : BitVec64,work : BitVec64) =
    (ast_phase(s)=a109_z()) ∧ (ast_charge(s)=a109_z()) ∧ as110_auth(s,a,a109_one()) ∧
    a109_nonzero(ast_anchor(s)) ∧ a109_nonzero(ast_installation(s)) ∧ a109_nonzero(ast_artifact(s)) ∧ a109_nonzero(ast_generation(s)) ∧
    ((ast_role(s)=bvconst(1,8)) ∨ (ast_role(s)=bvconst(2,8))) ∧ a109_nonzero(ast_profile(s)) ∧
    a109_nonzero(ast_image(s)) ∧ a109_nonzero(ast_metadata(s)) ∧ a109_nonzero(ast_provenance(s)) ∧
    ¬((ast_artifact(s)=ast_selected(s)) ∧ (ast_generation(s)=ast_selected_gen(s))) ∧
    as110_charge(ast_size(s),meta,own,ast_other_bytes(s),limit) ∧ a109_nonzero(work) ∧ bvult(ast_high(s),a109_max())

// Reservation and serial watermark must be durably settled before a handle
// escapes. An uncertain reservation is reconciled under the exclusive backend
// lock before any new reservation; its serial must not be reissued.
define as110_reserve(s : AS110State,t : AS110State,a : AS110Access,meta : BitVec64,own : BitVec64,limit : BitVec64,work : BitVec64,ledger_phase : BitVec8,poison : Bool) =
    if as110_can_reserve(s,a,meta,own,limit,work) ∧ d110_ack(ledger_phase,poison) then
    (ast_boot(t)=ast_boot(s)) ∧ (ast_other_bytes(t)=ast_other_bytes(s)) ∧ (ast_peer(t)=ast_peer(s)) ∧ (ast_revision(t)=ast_revision(s)) ∧ (ast_selected(t)=ast_selected(s)) ∧ (ast_selected_gen(t)=ast_selected_gen(s)) ∧ (ast_request(t)=ast_request(s)) ∧ (ast_expected(t)=ast_expected(s)) ∧ (ast_anchor(t)=ast_anchor(s)) ∧ (ast_installation(t)=ast_installation(s)) ∧ (ast_artifact(t)=ast_artifact(s)) ∧ (ast_generation(t)=ast_generation(s)) ∧ (ast_role(t)=ast_role(s)) ∧ (ast_profile(t)=ast_profile(s)) ∧ (ast_size(t)=ast_size(s)) ∧ (ast_image(t)=ast_image(s)) ∧ (ast_metadata(t)=ast_metadata(s)) ∧ (ast_dependencies(t)=ast_dependencies(s)) ∧ (ast_provenance(t)=ast_provenance(s)) ∧ (ast_phase(t)=bvconst(1,64)) ∧ (ast_ticket(t)=bvadd(ast_high(s),a109_one())) ∧ (ast_high(t)=bvadd(ast_high(s),a109_one())) ∧ (ast_owner(t)=asa_owner(a)) ∧ (ast_inc(t)=asa_inc(a)) ∧ (ast_cursor(t)=bvconst(0,64)) ∧ (ast_charge(t)=bvadd(ast_size(s),meta)) ∧ (ast_work(t)=work) ∧ (ast_last_off(t)=bvconst(0,64)) ∧ (ast_last_n(t)=bvconst(0,64)) ∧ (ast_last_data(t)=bvconst(0,64))
    else as110_same(s,t)

define as110_chunk_new(s : AS110State,off : BitVec64,n : BitVec64) =
    (off=ast_cursor(s)) ∧ bvule(off,ast_size(s)) ∧ bvule(n,bvsub(ast_size(s),off))
define as110_chunk_retry(s : AS110State,off : BitVec64,n : BitVec64,data : BitVec64) =
    a109_nonzero(ast_last_n(s)) ∧ (off=ast_last_off(s)) ∧ (n=ast_last_n(s)) ∧ (data=ast_last_data(s))
// data is equality of ACTUAL most-recent chunk bytes; a supplied digest alone
// does not establish it. Retrying older chunks is conservatively refused.
define as110_can_chunk(s : AS110State,a : AS110Access,ticket : BitVec64,off : BitVec64,n : BitVec64,data : BitVec64,window : BitVec64) =
    (ast_phase(s)=a109_one()) ∧ as110_owned(s,a,ticket,a109_one()) ∧
    a109_nonzero(ast_work(s)) ∧ a109_nonzero(n) ∧ a109_nonzero(data) ∧ bvule(n,window) ∧
    (as110_chunk_new(s,off,n) ∨ as110_chunk_retry(s,off,n,data))

define as110_chunk(s : AS110State,t : AS110State,a : AS110Access,ticket : BitVec64,off : BitVec64,n : BitVec64,data : BitVec64,window : BitVec64) =
    if as110_can_chunk(s,a,ticket,off,n,data,window) then
    (ast_phase(t)=ast_phase(s)) ∧ (ast_ticket(t)=ast_ticket(s)) ∧ (ast_owner(t)=ast_owner(s)) ∧ (ast_inc(t)=ast_inc(s)) ∧ (ast_charge(t)=ast_charge(s)) ∧ (ast_high(t)=ast_high(s)) ∧ (ast_boot(t)=ast_boot(s)) ∧ (ast_other_bytes(t)=ast_other_bytes(s)) ∧ (ast_peer(t)=ast_peer(s)) ∧ (ast_revision(t)=ast_revision(s)) ∧ (ast_selected(t)=ast_selected(s)) ∧ (ast_selected_gen(t)=ast_selected_gen(s)) ∧ (ast_request(t)=ast_request(s)) ∧ (ast_expected(t)=ast_expected(s)) ∧ (ast_anchor(t)=ast_anchor(s)) ∧ (ast_installation(t)=ast_installation(s)) ∧ (ast_artifact(t)=ast_artifact(s)) ∧ (ast_generation(t)=ast_generation(s)) ∧ (ast_role(t)=ast_role(s)) ∧ (ast_profile(t)=ast_profile(s)) ∧ (ast_size(t)=ast_size(s)) ∧ (ast_image(t)=ast_image(s)) ∧ (ast_metadata(t)=ast_metadata(s)) ∧ (ast_dependencies(t)=ast_dependencies(s)) ∧ (ast_provenance(t)=ast_provenance(s)) ∧ (ast_cursor(t)=(if as110_chunk_new(s,off,n) then bvadd(off,n) else ast_cursor(s))) ∧ (ast_work(t)=bvsub(ast_work(s),a109_one())) ∧ (ast_last_off(t)=off) ∧ (ast_last_n(t)=n) ∧ (ast_last_data(t)=data)
    else as110_same(s,t)

// Actual full content/profile/dependency/provenance identities are derived by
// independent backend validation. Active controller/DMA/storage work must drain.
define as110_complete(s : AS110State,actual : SL110Artifact,verified : A109Verdict,phase : BitVec8,poison : Bool,active : BitVec64) =
    (ast_cursor(s)=ast_size(s)) ∧ as110_bound(s,actual) ∧ (verified=A109Valid) ∧
    (active=a109_z()) ∧ d110_ack(phase,poison)
define as110_can_seal(s : AS110State,a : AS110Access,ticket : BitVec64,actual : SL110Artifact,verified : A109Verdict,phase : BitVec8,poison : Bool,active : BitVec64) =
    ((ast_phase(s)=a109_one()) ∨ (ast_phase(s)=bvconst(2,64))) ∧ as110_owned(s,a,ticket,a109_one()) ∧
    as110_complete(s,actual,verified,phase,poison,active)

define as110_seal(s : AS110State,t : AS110State,a : AS110Access,ticket : BitVec64,actual : SL110Artifact,verified : A109Verdict,phase : BitVec8,poison : Bool,active : BitVec64) =
    if as110_can_seal(s,a,ticket,actual,verified,phase,poison,active) then
    (ast_ticket(t)=ast_ticket(s)) ∧ (ast_owner(t)=ast_owner(s)) ∧ (ast_inc(t)=ast_inc(s)) ∧ (ast_cursor(t)=ast_cursor(s)) ∧ (ast_charge(t)=ast_charge(s)) ∧ (ast_work(t)=ast_work(s)) ∧ (ast_last_off(t)=ast_last_off(s)) ∧ (ast_last_n(t)=ast_last_n(s)) ∧ (ast_last_data(t)=ast_last_data(s)) ∧ (ast_high(t)=ast_high(s)) ∧ (ast_boot(t)=ast_boot(s)) ∧ (ast_other_bytes(t)=ast_other_bytes(s)) ∧ (ast_peer(t)=ast_peer(s)) ∧ (ast_revision(t)=ast_revision(s)) ∧ (ast_selected(t)=ast_selected(s)) ∧ (ast_selected_gen(t)=ast_selected_gen(s)) ∧ (ast_request(t)=ast_request(s)) ∧ (ast_expected(t)=ast_expected(s)) ∧ (ast_anchor(t)=ast_anchor(s)) ∧ (ast_installation(t)=ast_installation(s)) ∧ (ast_artifact(t)=ast_artifact(s)) ∧ (ast_generation(t)=ast_generation(s)) ∧ (ast_role(t)=ast_role(s)) ∧ (ast_profile(t)=ast_profile(s)) ∧ (ast_size(t)=ast_size(s)) ∧ (ast_image(t)=ast_image(s)) ∧ (ast_metadata(t)=ast_metadata(s)) ∧ (ast_dependencies(t)=ast_dependencies(s)) ∧ (ast_provenance(t)=ast_provenance(s)) ∧ (ast_phase(t)=bvconst(2,64))
    else as110_same(s,t)
define as110_recover_object(s : AS110State,t : AS110State,actual : SL110Artifact,verified : A109Verdict,phase : BitVec8,poison : Bool,active : BitVec64) =
    if (ast_phase(s)=a109_one()) ∧ as110_complete(s,actual,verified,phase,poison,active) then
    (ast_ticket(t)=ast_ticket(s)) ∧ (ast_owner(t)=ast_owner(s)) ∧ (ast_inc(t)=ast_inc(s)) ∧ (ast_cursor(t)=ast_cursor(s)) ∧ (ast_charge(t)=ast_charge(s)) ∧ (ast_work(t)=ast_work(s)) ∧ (ast_last_off(t)=ast_last_off(s)) ∧ (ast_last_n(t)=ast_last_n(s)) ∧ (ast_last_data(t)=ast_last_data(s)) ∧ (ast_high(t)=ast_high(s)) ∧ (ast_boot(t)=ast_boot(s)) ∧ (ast_other_bytes(t)=ast_other_bytes(s)) ∧ (ast_peer(t)=ast_peer(s)) ∧ (ast_revision(t)=ast_revision(s)) ∧ (ast_selected(t)=ast_selected(s)) ∧ (ast_selected_gen(t)=ast_selected_gen(s)) ∧ (ast_request(t)=ast_request(s)) ∧ (ast_expected(t)=ast_expected(s)) ∧ (ast_anchor(t)=ast_anchor(s)) ∧ (ast_installation(t)=ast_installation(s)) ∧ (ast_artifact(t)=ast_artifact(s)) ∧ (ast_generation(t)=ast_generation(s)) ∧ (ast_role(t)=ast_role(s)) ∧ (ast_profile(t)=ast_profile(s)) ∧ (ast_size(t)=ast_size(s)) ∧ (ast_image(t)=ast_image(s)) ∧ (ast_metadata(t)=ast_metadata(s)) ∧ (ast_dependencies(t)=ast_dependencies(s)) ∧ (ast_provenance(t)=ast_provenance(s)) ∧ (ast_phase(t)=bvconst(2,64))
    else as110_same(s,t)

// One reference and exact retry outcome are committed together. Previous objects
// remain conservatively charged in other_bytes. Request is bound to owner,
// incarnation, ticket, complete frozen manifest and expected revision.
define as110_can_publish(s : AS110State,a : AS110Access,ticket : BitVec64,request : BitVec64,expected : BitVec64) =
    (ast_phase(s)=bvconst(2,64)) ∧ as110_owned(s,a,ticket,bvconst(2,64)) ∧ a109_nonzero(request) ∧
    (expected=ast_revision(s)) ∧ bvult(expected,a109_max())

define as110_commit_image(s : AS110State,t : AS110State,request : BitVec64) = (ast_ticket(t)=ast_ticket(s)) ∧ (ast_owner(t)=ast_owner(s)) ∧ (ast_inc(t)=ast_inc(s)) ∧ (ast_cursor(t)=ast_cursor(s)) ∧ (ast_charge(t)=ast_charge(s)) ∧ (ast_work(t)=ast_work(s)) ∧ (ast_last_off(t)=ast_last_off(s)) ∧ (ast_last_n(t)=ast_last_n(s)) ∧ (ast_last_data(t)=ast_last_data(s)) ∧ (ast_high(t)=ast_high(s)) ∧ (ast_boot(t)=ast_boot(s)) ∧ (ast_other_bytes(t)=ast_other_bytes(s)) ∧ (ast_peer(t)=ast_peer(s)) ∧ (ast_anchor(t)=ast_anchor(s)) ∧ (ast_installation(t)=ast_installation(s)) ∧ (ast_artifact(t)=ast_artifact(s)) ∧ (ast_generation(t)=ast_generation(s)) ∧ (ast_role(t)=ast_role(s)) ∧ (ast_profile(t)=ast_profile(s)) ∧ (ast_size(t)=ast_size(s)) ∧ (ast_image(t)=ast_image(s)) ∧ (ast_metadata(t)=ast_metadata(s)) ∧ (ast_dependencies(t)=ast_dependencies(s)) ∧ (ast_provenance(t)=ast_provenance(s)) ∧ (ast_phase(t)=bvconst(3,64)) ∧ (ast_revision(t)=bvadd(ast_revision(s),a109_one())) ∧ (ast_selected(t)=ast_artifact(s)) ∧ (ast_selected_gen(t)=ast_generation(s)) ∧ (ast_request(t)=request) ∧ (ast_expected(t)=ast_revision(s))
define as110_publish(s : AS110State,t : AS110State,a : AS110Access,ticket : BitVec64,request : BitVec64,expected : BitVec64,phase : BitVec8,poison : Bool) =
    if as110_can_publish(s,a,ticket,request,expected) ∧ d110_ack(phase,poison) then
    (ast_ticket(t)=ast_ticket(s)) ∧ (ast_owner(t)=ast_owner(s)) ∧ (ast_inc(t)=ast_inc(s)) ∧ (ast_cursor(t)=ast_cursor(s)) ∧ (ast_charge(t)=ast_charge(s)) ∧ (ast_work(t)=ast_work(s)) ∧ (ast_last_off(t)=ast_last_off(s)) ∧ (ast_last_n(t)=ast_last_n(s)) ∧ (ast_last_data(t)=ast_last_data(s)) ∧ (ast_high(t)=ast_high(s)) ∧ (ast_boot(t)=ast_boot(s)) ∧ (ast_other_bytes(t)=ast_other_bytes(s)) ∧ (ast_peer(t)=ast_peer(s)) ∧ (ast_anchor(t)=ast_anchor(s)) ∧ (ast_installation(t)=ast_installation(s)) ∧ (ast_artifact(t)=ast_artifact(s)) ∧ (ast_generation(t)=ast_generation(s)) ∧ (ast_role(t)=ast_role(s)) ∧ (ast_profile(t)=ast_profile(s)) ∧ (ast_size(t)=ast_size(s)) ∧ (ast_image(t)=ast_image(s)) ∧ (ast_metadata(t)=ast_metadata(s)) ∧ (ast_dependencies(t)=ast_dependencies(s)) ∧ (ast_provenance(t)=ast_provenance(s)) ∧ (ast_phase(t)=bvconst(3,64)) ∧ (ast_revision(t)=bvadd(ast_revision(s),a109_one())) ∧ (ast_selected(t)=ast_artifact(s)) ∧ (ast_selected_gen(t)=ast_generation(s)) ∧ (ast_request(t)=request) ∧ (ast_expected(t)=ast_revision(s))
    else as110_same(s,t)

define as110_reply(s : AS110State,a : AS110Access,ticket : BitVec64,request : BitVec64,expected : BitVec64) =
    (ast_phase(s)=bvconst(3,64)) ∧ as110_owned(s,a,ticket,bvconst(2,64)) ∧
    (ast_selected(s)=ast_artifact(s)) ∧ (ast_selected_gen(s)=ast_generation(s)) ∧
    (request=ast_request(s)) ∧ (expected=ast_expected(s))
// a is the pre-crash admission snapshot. Recovery does not mint caller authority;
// reply still checks CURRENT evidence. Revocation does not undo a durable commit.
define as110_recover_publication(s : AS110State,t : AS110State,a : AS110Access,ticket : BitVec64,request : BitVec64,expected : BitVec64,phase : BitVec8,new : Bool,valid : Bool) =
    as110_can_publish(s,a,ticket,request,expected) ∧ valid ∧ d110_choice(phase,new) ∧
    (if new then as110_commit_image(s,t,request) else as110_same(s,t))
define as110_private(s : AS110State) = (ast_phase(s)=a109_one()) ∨ (ast_phase(s)=bvconst(2,64))
define as110_can_discard(s : AS110State,a : AS110Access,ticket : BitVec64,active : BitVec64,deleted : Bool) =
    as110_private(s) ∧ as110_owned(s,a,ticket,a109_one()) ∧ (active=a109_z()) ∧ deleted

define as110_discard(s : AS110State,t : AS110State,a : AS110Access,ticket : BitVec64,active : BitVec64,deleted : Bool) =
    if as110_can_discard(s,a,ticket,active,deleted) then
    (ast_high(t)=ast_high(s)) ∧ (ast_boot(t)=ast_boot(s)) ∧ (ast_other_bytes(t)=ast_other_bytes(s)) ∧ (ast_peer(t)=ast_peer(s)) ∧ (ast_revision(t)=ast_revision(s)) ∧ (ast_selected(t)=ast_selected(s)) ∧ (ast_selected_gen(t)=ast_selected_gen(s)) ∧ (ast_request(t)=ast_request(s)) ∧ (ast_expected(t)=ast_expected(s)) ∧ (ast_anchor(t)=ast_anchor(s)) ∧ (ast_installation(t)=ast_installation(s)) ∧ (ast_artifact(t)=ast_artifact(s)) ∧ (ast_generation(t)=ast_generation(s)) ∧ (ast_role(t)=ast_role(s)) ∧ (ast_profile(t)=ast_profile(s)) ∧ (ast_size(t)=ast_size(s)) ∧ (ast_image(t)=ast_image(s)) ∧ (ast_metadata(t)=ast_metadata(s)) ∧ (ast_dependencies(t)=ast_dependencies(s)) ∧ (ast_provenance(t)=ast_provenance(s)) ∧ (ast_phase(t)=bvconst(0,64)) ∧ (ast_ticket(t)=bvconst(0,64)) ∧ (ast_owner(t)=bvconst(0,64)) ∧ (ast_inc(t)=bvconst(0,64)) ∧ (ast_cursor(t)=bvconst(0,64)) ∧ (ast_charge(t)=bvconst(0,64)) ∧ (ast_work(t)=bvconst(0,64)) ∧ (ast_last_off(t)=bvconst(0,64)) ∧ (ast_last_n(t)=bvconst(0,64)) ∧ (ast_last_data(t)=bvconst(0,64))
    else as110_same(s,t)

// Trusted supervisor retirement observation allows cleanup after owner death or
// grant revocation; an untrusted caller cannot assert retirement/deletion.
define as110_can_reap(s : AS110State,ticket : BitVec64,owner : BitVec64,inc : BitVec64,boot : BitVec64,retired : A109Verdict,active : BitVec64,deleted : Bool) =
    as110_private(s) ∧ (ticket=ast_ticket(s)) ∧ (ticket=ast_high(s)) ∧ a109_nonzero(ticket) ∧
    (owner=ast_owner(s)) ∧ (inc=ast_inc(s)) ∧ (boot=ast_boot(s)) ∧
    (retired=A109Valid) ∧ (active=a109_z()) ∧ deleted

define as110_reap(s : AS110State,t : AS110State,ticket : BitVec64,owner : BitVec64,inc : BitVec64,boot : BitVec64,retired : A109Verdict,active : BitVec64,deleted : Bool) =
    if as110_can_reap(s,ticket,owner,inc,boot,retired,active,deleted) then
    (ast_high(t)=ast_high(s)) ∧ (ast_boot(t)=ast_boot(s)) ∧ (ast_other_bytes(t)=ast_other_bytes(s)) ∧ (ast_peer(t)=ast_peer(s)) ∧ (ast_revision(t)=ast_revision(s)) ∧ (ast_selected(t)=ast_selected(s)) ∧ (ast_selected_gen(t)=ast_selected_gen(s)) ∧ (ast_request(t)=ast_request(s)) ∧ (ast_expected(t)=ast_expected(s)) ∧ (ast_anchor(t)=ast_anchor(s)) ∧ (ast_installation(t)=ast_installation(s)) ∧ (ast_artifact(t)=ast_artifact(s)) ∧ (ast_generation(t)=ast_generation(s)) ∧ (ast_role(t)=ast_role(s)) ∧ (ast_profile(t)=ast_profile(s)) ∧ (ast_size(t)=ast_size(s)) ∧ (ast_image(t)=ast_image(s)) ∧ (ast_metadata(t)=ast_metadata(s)) ∧ (ast_dependencies(t)=ast_dependencies(s)) ∧ (ast_provenance(t)=ast_provenance(s)) ∧ (ast_phase(t)=bvconst(0,64)) ∧ (ast_ticket(t)=bvconst(0,64)) ∧ (ast_owner(t)=bvconst(0,64)) ∧ (ast_inc(t)=bvconst(0,64)) ∧ (ast_cursor(t)=bvconst(0,64)) ∧ (ast_charge(t)=bvconst(0,64)) ∧ (ast_work(t)=bvconst(0,64)) ∧ (ast_last_off(t)=bvconst(0,64)) ∧ (ast_last_n(t)=bvconst(0,64)) ∧ (ast_last_data(t)=bvconst(0,64))
    else as110_same(s,t)

// Read grant may belong to a different principal. Never confers execute rights.
define as110_read(s : AS110State,a : AS110Access,actual : SL110Artifact,verified : A109Verdict,off : BitVec64,n : BitVec64,window : BitVec64) =
    (ast_phase(s)=bvconst(3,64)) ∧ as110_auth(s,a,bvconst(3,64)) ∧
    (ast_selected(s)=ast_artifact(s)) ∧ (ast_selected_gen(s)=ast_generation(s)) ∧
    (verified=A109Valid) ∧ as110_bound(s,actual) ∧ a109_nonzero(n) ∧ bvule(n,window) ∧
    bvule(off,ast_size(s)) ∧ bvule(n,bvsub(ast_size(s),off))


