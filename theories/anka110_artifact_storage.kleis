// AS110 file refinement: private fixed envelope, not a network wire ABI.
// 8-byte magic + forty little-endian u64 words + CRC64 = 336 bytes.
// CRC is corruption detection under the honest-host assumption, not authenticity.
define as110_record_shape(n : BitVec64,version : BitVec64,phase : BitVec64,magic : Bool,crc : Bool,reserved : Bool,namespace : Bool) =
    (n=bvconst(336,64)) ∧ (version=a109_one()) ∧ bvule(phase,bvconst(4,64)) ∧ magic ∧ crc ∧ reserved ∧ namespace
// Cleanup journal states: 0 private; 1 deletion intent durably recorded;
// 2 payload removal durably settled; 3 refund committed. Backend phase 4
// (Deleting) refines a still-charged private candidate until state 3.
define as110_cleanup_advance(p : BitVec64,event : BitVec64,private : Bool,authorized : Bool,drained : Bool,durable : Bool) =
    if bvult(p,bvconst(3,64)) ∧ (event=bvadd(p,a109_one())) ∧ drained ∧ durable ∧
       (if p=a109_z() then private ∧ authorized else as110_true()) then event else p
define as110_cleanup_refund(p : BitVec64) = (p=bvconst(3,64))
