// Compositional arithmetic lemmas avoid a five-variable bit-blast without
// weakening admission: as110_charge supplies both premises below.
example "law payload plus metadata cannot wrap" { assert(∀ size : BitVec64 . ∀ meta : BitVec64 . bvule(meta,bvsub(a109_max(),size)) ⟹ bvuge(bvadd(size,meta),size)) }
example "law admitted total fits global budget" { assert(∀ other : BitVec64 . ∀ total : BitVec64 . ∀ limit : BitVec64 . sl110_room(other,total,limit) ⟹ bvule(bvadd(other,total),limit)) }
example "law charge supplies both arithmetic premises" { assert(∀ size : BitVec64 . ∀ meta : BitVec64 . ∀ own : BitVec64 . ∀ other : BitVec64 . ∀ limit : BitVec64 . as110_charge(size,meta,own,other,limit) ⟹ (bvule(meta,bvsub(a109_max(),size)) ∧ sl110_room(other,bvadd(size,meta),limit))) }
