    assert(¬(ut108_new_lifetime(ut108_false(),ut108_true(),ut108_true(),ut108_true(),bvconst(17,64),bvconst(4096,64),bvconst(4096,64))))
}

example "ut108_new_lifetime rejects old receipt as new reservation" {
    assert(¬(ut108_new_lifetime(ut108_true(),ut108_false(),ut108_true(),ut108_true(),bvconst(17,64),bvconst(4096,64),bvconst(4096,64))))
}

example "ut108_new_lifetime rejects dirty suballocation" {
    assert(¬(ut108_new_lifetime(ut108_true(),ut108_true(),ut108_false(),ut108_true(),bvconst(17,64),bvconst(4096,64),bvconst(4096,64))))
}

example "ut108_new_lifetime rejects zeroing creates authority" {
    assert(¬(ut108_new_lifetime(ut108_true(),ut108_true(),ut108_true(),ut108_false(),bvconst(17,64),bvconst(4096,64),bvconst(4096,64))))
}

example "ut108_new_lifetime rejects only logical bytes initialized" {
    assert(¬(ut108_new_lifetime(ut108_true(),ut108_true(),ut108_true(),ut108_true(),bvconst(17,64),bvconst(4096,64),bvconst(17,64))))
}

example "queue reservation preserves bound" {
    assert(∀(cap : BitVec64). ∀(a : BitVec64). ∀(p : BitVec64). ∀(j : BitVec64). ∀(r : BitVec64). ut108_reserve(cap,a,p,j,r,r,bvconst(1,8)) → ut108_queue(cap,bvadd(a,ut108_o()),p))
}

example "death transfers credits without increasing occupied records" {
    assert(∀(cap : BitVec64). ∀(a : BitVec64). ∀(p : BitVec64). ∀(n : BitVec64). (ut108_queue(cap,a,p) ∧ bvule(n,a)) → (bvadd(ut108_armed_after(ut108_true(),a,n),ut108_pending_after(ut108_true(),p,n))=bvadd(a,p)))
}

example "death at capacity preserves queue bound" {
    assert(∀(cap : BitVec64). ∀(a : BitVec64). ∀(p : BitVec64). ∀(n : BitVec64). (ut108_queue(cap,a,p) ∧ bvule(n,a)) → ut108_queue(cap,ut108_armed_after(ut108_true(),a,n),ut108_pending_after(ut108_true(),p,n)))
}

example "census induction preserves bounded selected count" {
    assert(∀(cap : BitVec64). ∀(scanned : BitVec64). ∀(hits : BitVec64). ∀(matches : Bool). ut108_scan(cap,scanned,hits) → ut108_census(cap,bvadd(scanned,ut108_o()),ut108_hits(hits,matches)))
}

example "committed owner closure blocks every record admission" {
    assert(∀(s : BitVec8). ¬(ut108_admit(ut108_closed(ut108_true(),bvconst(1,8)),s)))
}

example "atomic death registers every selected owner allocation" {
    assert(∀(owner : BitVec64). ut108_pending(ut108_stage_after_close(ut108_true(),owner,owner,bvconst(0,8))))
}

example "foreign owner records are preserved" {
    assert(∀(owner : BitVec64). ∀(other : BitVec64). ∀(s : BitVec8). (owner≠other) → (ut108_stage_after_close(ut108_true(),owner,other,s)=s))
}

example "death registration is idempotent pointwise" {
    assert(∀(owner : BitVec64). ∀(other : BitVec64). ∀(s : BitVec8). (ut108_stage_after_close(ut108_true(),owner,other,ut108_stage_after_close(ut108_true(),owner,other,s))=ut108_stage_after_close(ut108_true(),owner,other,s)))
}

example "failed death preserves every record" {
    assert(∀(owner : BitVec64). ∀(other : BitVec64). ∀(s : BitVec8). (ut108_stage_after_close(ut108_false(),owner,other,s)=s))
}

example "failed registration preserves owner admission" {
    assert(∀(s : BitVec8). (ut108_closed(ut108_false(),s)=s))
}

example "death refines A1 close without changing counts or generation" {
    assert(∀(owner : BitVec64). ∀(c : BitVec64). ∀(d : BitVec64). ∀(g : BitVec64). conc107_close(bvconst(1,8),ut108_lifetime(ut108_stage_after_close(ut108_true(),owner,owner,bvconst(0,8))),c,c,d,d,g,g,bvconst(1,8),bvconst(1,8)))
}

example "retired authority still retains cleanup charges" {
    assert(∀(s : BitVec8). (bvuge(s,bvconst(2,8)) ∧ bvule(s,bvconst(4,8))) → ((ut108_lifetime(s)=bvconst(3,8)) ∧ ut108_charge_held(s)))
}

example "recovery preserves retired authority" {
    assert(∀(s : BitVec8). (bvuge(s,bvconst(2,8)) ∧ bvule(s,bvconst(4,8))) → (ut108_lifetime(ut108_recovered_stage(ut108_true(),s))=bvconst(3,8)))
}

example "failed registration preserves both queue counts" {
    assert(∀(a : BitVec64). ∀(p : BitVec64). ∀(n : BitVec64). (ut108_armed_after(ut108_false(),a,n)=a) ∧ (ut108_pending_after(ut108_false(),p,n)=p))
}

example "all pending stages retain their charges" {
    assert(∀(s : BitVec8). ut108_pending(s) → ut108_charge_held(s))
}

example "pending stage cannot be rearmed by duplicate delivery" {
    assert(∀(owner : BitVec64). ∀(s : BitVec8). ut108_pending(s) → (ut108_stage_after_close(ut108_true(),owner,owner,s)=s))
}

example "failed release retains full payload" {
    assert(∀(p : BitVec64). ∀(n : BitVec64). (ut108_payload(ut108_false(),p,n)=p))
}

example "failed release retains pending census" {
    assert(∀(p : BitVec64). (ut108_after_release(ut108_false(),p)=p))
}

example "one release preserves queue bound" {
    assert(∀(cap : BitVec64). ∀(a : BitVec64). ∀(p : BitVec64). (ut108_queue(cap,a,p) ∧ bvugt(p,ut108_z())) → ut108_queue(cap,a,ut108_after_release(ut108_true(),p)))
}

example "exact release refund has no underflow" {
    assert(∀(p : BitVec64). ∀(n : BitVec64). bvule(n,p) → (bvadd(ut108_payload(ut108_true(),p,n),n)=p))
}

example "unselected account is unchanged by release" {
    assert(∀(owner : BitVec64). ∀(other : BitVec64). ∀(p : BitVec64). ∀(n : BitVec64). (owner≠other) → (heap108_account(ut108_true(),owner,other,p,n)=p))
}

example "recovery retains durable pending status" {
    assert(∀(s : BitVec8). ut108_pending(s) → ut108_pending(ut108_recovered_stage(ut108_true(),s)))
}

example "recovery never trusts an old completed prefix" {
    assert(∀(done : BitVec64). (ut108_recovered_done(ut108_true(),done)=ut108_z()))
}

example "blocked recovery preserves completed prefix" {
    assert(∀(done : BitVec64). (ut108_recovered_done(ut108_false(),done)=done))
}

example "recovery and mutation invalidate the old receipt version" {
    assert(∀(v : BitVec64). bvult(v,ptr107_max()) → (init108_version(ut108_true(),v)≠v))
}

example "nonwrapping lease epoch defeats stale completions" {
    assert(∀(e : BitVec64). ∀(w : BitVec64). (bvult(e,ptr107_max()) ∧ bvugt(w,ut108_z())) → ¬(ut108_lease(bvconst(1,8),bvadd(e,ut108_o()),w,e,w)))
}

example "completed chunk strictly decreases remaining storage" {
    assert(∀(done : BitVec64). ∀(amount : BitVec64). ∀(span : BitVec64). ∀(v : BitVec64). init108_chunk(bvconst(1,8),done,amount,span,v,v,bvconst(1,8),bvconst(1,8)) → bvult(bvsub(span,init108_done(ut108_true(),done,amount)),bvsub(span,done)))
}

example "completed chunk preserves scrubbed byte prefix" {
    assert(∀(done : BitVec64). ∀(amount : BitVec64). ∀(span : BitVec64). ∀(v : BitVec64). ∀(q : BitVec64). ∀(old : BitVec8). (init108_chunk(bvconst(1,8),done,amount,span,v,v,bvconst(1,8),bvconst(1,8)) ∧ bvult(q,bvadd(done,amount))) → (init108_byte(ut108_true(),done,amount,q,if bvult(q,done) then bvconst(0,8) else old)=bvconst(0,8)))
}

example "failed chunk neither advances cursor nor alters abstract bytes" {
    assert(∀(done : BitVec64). ∀(amount : BitVec64). ∀(q : BitVec64). ∀(old : BitVec8). (init108_done(ut108_false(),done,amount)=done) ∧ (init108_byte(ut108_false(),done,amount,q,old)=old))
}

example "CPU terminal progress decreases lexicographic rank" {
    assert(∀(c : BitVec64). ∀(d : BitVec64). ∀(r : BitVec64). bvugt(c,ut108_z()) → ut108_less(bvconst(1,8),bvconst(1,8),c,bvsub(c,ut108_o()),d,d,r,r))
}

example "DMA terminal progress decreases lexicographic rank" {
    assert(∀(c : BitVec64). ∀(d : BitVec64). ∀(r : BitVec64). bvugt(d,ut108_z()) → ut108_less(bvconst(1,8),bvconst(1,8),c,c,d,bvsub(d,ut108_o()),r,r))
}

example "idle stutter cannot establish progress" {
    assert(∀(s : BitVec8). ∀(c : BitVec64). ∀(d : BitVec64). ∀(r : BitVec64). ¬(ut108_less(s,s,c,c,d,d,r,r)))
}

example "scrub submission numbers never repeat within an epoch" {
    assert(∀(seq : BitVec64). bvult(seq,ptr107_max()) → (ut108_sequence(ut108_true(),seq)≠seq))
}

example "cancelled range retry needs a distinct operation" {
    assert(¬(ut108_ticket(ut108_true(),bvconst(8,64),bvconst(40,64),bvconst(2,64),bvconst(10,64),bvconst(0,64),bvconst(2048,64),bvconst(8,64),bvconst(40,64),bvconst(1,64),bvconst(10,64),bvconst(0,64),bvconst(2048,64))))
}

example "phase progress 1 to 2 dominates residual counts" {
    assert(∀(c : BitVec64). ∀(nc : BitVec64). ∀(d : BitVec64). ∀(nd : BitVec64). ∀(r : BitVec64). ∀(nr : BitVec64). ut108_less(bvconst(1,8),bvconst(2,8),c,nc,d,nd,r,nr))
}

example "phase progress 2 to 3 dominates residual counts" {
    assert(∀(c : BitVec64). ∀(nc : BitVec64). ∀(d : BitVec64). ∀(nd : BitVec64). ∀(r : BitVec64). ∀(nr : BitVec64). ut108_less(bvconst(2,8),bvconst(3,8),c,nc,d,nd,r,nr))
}

example "phase progress 3 to 4 dominates residual counts" {
    assert(∀(c : BitVec64). ∀(nc : BitVec64). ∀(d : BitVec64). ∀(nd : BitVec64). ∀(r : BitVec64). ∀(nr : BitVec64). ut108_less(bvconst(3,8),bvconst(4,8),c,nc,d,nd,r,nr))
}

example "phase progress 4 to 5 dominates residual counts" {
    assert(∀(c : BitVec64). ∀(nc : BitVec64). ∀(d : BitVec64). ∀(nd : BitVec64). ∀(r : BitVec64). ∀(nr : BitVec64). ut108_less(bvconst(4,8),bvconst(5,8),c,nc,d,nd,r,nr))
}

