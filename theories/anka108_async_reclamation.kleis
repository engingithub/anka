example "ut108_queue accepts" {
    assert(ut108_queue(bvconst(4,64),bvconst(2,64),bvconst(2,64)))
}

example "ut108_queue rejects armed over capacity" {
    assert(¬(ut108_queue(bvconst(4,64),bvconst(5,64),bvconst(2,64))))
}

example "ut108_queue rejects pending over capacity" {
    assert(¬(ut108_queue(bvconst(4,64),bvconst(2,64),bvconst(3,64))))
}

example "ut108_queue rejects zero capacity" {
    assert(¬(ut108_queue(bvconst(0,64),bvconst(2,64),bvconst(2,64))))
}

example "ut108_queue rejects wrapped count" {
    assert(¬(ut108_queue(bvconst(4,64),ptr107_max(),bvconst(1,64))))
}

example "ut108_queue_bytes accepts" {
    assert(ut108_queue_bytes(bvconst(4,64),bvconst(256,64),bvconst(1024,64)))
}

example "ut108_queue_bytes rejects uncharged directory" {
    assert(¬(ut108_queue_bytes(bvconst(4,64),bvconst(256,64),bvconst(0,64))))
}

example "ut108_queue_bytes rejects zero stride" {
    assert(¬(ut108_queue_bytes(bvconst(4,64),bvconst(0,64),bvconst(1024,64))))
}

example "ut108_queue_bytes rejects wrapping multiplication" {
    assert(¬(ut108_queue_bytes(ptr107_max(),bvconst(2,64),bvsub(ptr107_max(),bvconst(1,64)))))
}

example "ut108_reserve accepts" {
    assert(ut108_reserve(bvconst(4,64),bvconst(2,64),bvconst(1,64),bvconst(50,64),bvconst(7,64),bvconst(7,64),bvconst(1,8)))
}

