example "composed trace cannot recover while old scrub remains" {
    assert(ut108_trace_check(bvconst(17,64)))
}

example "old worker cannot complete after new lease" {
    assert(¬(ut108_lease(bvconst(1,8),bvconst(9,64),bvconst(41,64),bvconst(8,64),bvconst(40,64))))
}

example "new worker cannot reuse old completed prefix" {
    assert(ut108_trace_check(bvconst(18,64)))
}

example "composed trace completes entire backing" {
    assert(ut108_trace_check(bvconst(19,64)))
}

example "clean storage still rejects application access" {
    assert(ut108_trace_check(bvconst(20,64)))
}

example "one completed job leaves two obligations" {
    assert(ut108_trace_check(bvconst(21,64)))
}

example "one completed job refunds only its backing" {
    assert(ut108_trace_check(bvconst(22,64)))
}

example "composed restarted scrub removes every prior secret" {
    assert(∀(q : BitVec64). ∀(secret : BitVec8). bvult(q,bvconst(4096,64)) → (ut108_trace_byte(secret,q)=bvconst(0,8)))
}

example "two prior executions have identical scrubbed bytes" {
    assert(∀(q : BitVec64). ∀(a : BitVec8). ∀(b : BitVec8). bvult(q,bvconst(4096,64)) → (ut108_trace_byte(a,q)=ut108_trace_byte(b,q)))
}

example "scrub preserves bytes outside exact reservation" {
    assert(∀(q : BitVec64). ∀(secret : BitVec8). bvuge(q,bvconst(4096,64)) → (ut108_trace_byte(secret,q)=secret))
}

example "composed restarted scrub removes every old pointer kind" {
    assert(∀(q : BitVec64). ∀(kind : BitVec8). (init108_aligned(q) ∧ bvult(q,bvconst(4096,64))) → (ut108_trace_tag(kind,bvadd(bvconst(8192,64),q))=bvconst(0,8)))
}

example "scrub preserves neighboring physical pointer cells" {
    assert(∀(cell : BitVec64). ∀(kind : BitVec8). (init108_aligned(cell) ∧ ((bvult(cell,bvconst(8192,64))) ∨ bvuge(cell,bvconst(12288,64)))) → (ut108_trace_tag(kind,cell)=kind))
}

example "semantic probe idle service always advances" {
    assert(¬(ut108_less(bvconst(1,8),bvconst(1,8),ut108_o(),ut108_o(),ut108_o(),ut108_o(),bvconst(4096,64),bvconst(4096,64))))
}

example "recovery does not guarantee monotone progress" {
    assert(¬(ut108_less(bvconst(3,8),ut108_recovered_stage(ut108_true(),bvconst(3,8)),ut108_z(),ut108_z(),ut108_z(),ut108_z(),bvconst(2048,64),bvconst(4096,64))))
}

example "semantic probe scrub may preserve old secret" {
    assert(¬(ut108_trace_byte(bvconst(173,8),bvconst(4095,64))=bvconst(173,8)))
}

example "semantic probe scrub may preserve pointer kind" {
    assert(¬(ut108_trace_tag(bvconst(1,8),bvconst(12272,64))=bvconst(1,8)))
}

example "semantic probe another client may lose bytes" {
    assert(¬(ut108_trace_byte(bvconst(173,8),bvconst(4096,64))=bvconst(0,8)))
}

example "semantic probe only logical bytes need clearing" {
    assert(¬(ut108_trace_byte(bvconst(173,8),bvconst(17,64))=bvconst(173,8)))
}

example "semantic probe clean already means uncharged" {
    assert(¬(ut108_charge_held(bvconst(4,8))=ut108_false()))
}

example "semantic probe process death refunds backing" {
    assert(¬(ut108_payload(ut108_false(),bvconst(12288,64),bvconst(4096,64))=bvconst(8192,64)))
}
