// Phase 10.8 DN-71: Undertaker asynchronous reclamation refinement.
// SPECIFICATION ONLY: no new axioms, Rust allocator, hardware erasure, temporal
// liveness theorem, or power-loss persistence claim. "Durable" here means the
// trusted owner/cleanup directory survives a worker crash/restart. Host/kernel
// reset needs its own recovery refinement. All state comes from that directory,
// never notification payloads or application-supplied completion flags.
//
// One cleanup slot is RESERVED before each allocation becomes visible. The
// bounded directory is the work queue; a worker holding a record does not remove
// it from the pending census. An owner record is also reserved before process
// admission. Process death closes the owner AND queues every still-armed record
// under ONE serialization boundary, using an exact current directory census.
// No allocation, fallible queue insertion, or fresh identity is needed at death.
//
// This first cleanup profile returns whole page-backed reservations. Local-frame
// subregions still require their separate initialization refinement.
// Job stages: armed=0, queued/draining=1, authority-retired=2, scrubbing=3,
// clean/quarantined=4, released=5. Lease: unowned=0, held=1, revoking=2.
// Every unreleased stage retains physical/virtual custody, the owner-account
// tombstone and charges. CLEAN does not mean free or newly authorized.
// The worker may fail at any stage. Its exact operations must be terminal and
// fenced before reassignment; a new epoch alone cannot stop an old writer.
//
// Local laws/pointwise frame rules compose over EVERY directory entry. A2 must
// implement exact census, unique record keys, disjoint custody, actual memory
// effects, terminal ticket accounting, barriers and atomic multi-record commit.
import "anka108_allocation_reclamation.kleis"

define ut108_z() = bvconst(0,64)
define ut108_o() = bvconst(1,64)
define ut108_true() = bvconst(1,8)=bvconst(1,8)
define ut108_false() = bvconst(0,8)=bvconst(1,8)
define ut108_pending(stage : BitVec8) =
    bvuge(stage,bvconst(1,8)) ∧ bvule(stage,bvconst(4,8))
define ut108_charge_held(stage : BitVec8) = bvule(stage,bvconst(4,8))
// Projection onto the accepted A1 lifetime states. Retired authority is distinct
// from returned storage: stages 2, 3 and 4 still own the backing reservation.
define ut108_lifetime(stage : BitVec8) =
    if stage=bvconst(0,8) then bvconst(1,8) else
    if stage=bvconst(1,8) then bvconst(2,8) else bvconst(3,8)
define ut108_serial(revision : BitVec64, expected : BitVec64, serial : BitVec8) =
    reclaim108_serial(revision,expected,serial)

// All held records, including clean or leased records, consume a slot. Fixed
// queue bytes are charged ONCE as infrastructure, not per enqueue/dequeue.
define ut108_queue(cap : BitVec64, armed : BitVec64, pending : BitVec64) =
    bvugt(cap,ut108_z()) ∧ bvule(armed,cap) ∧ bvule(pending,bvsub(cap,armed))
define ut108_queue_bytes(cap : BitVec64, stride : BitVec64, bytes : BitVec64) =
    bvugt(cap,ut108_z()) ∧ bvugt(stride,ut108_z()) ∧
    bvule(cap,bvudiv(ptr107_max(),stride)) ∧ (bytes=bvmul(cap,stride))
define ut108_reserve(cap : BitVec64, armed : BitVec64, pending : BitVec64,
    next_job : BitVec64, revision : BitVec64, expected : BitVec64, serial : BitVec8) =
    ut108_queue(cap,armed,pending) ∧ bvult(bvadd(armed,pending),cap) ∧
    bvugt(next_job,ut108_z()) ∧ bvult(next_job,ptr107_max()) ∧
    ut108_serial(revision,expected,serial)

// owner is a trusted nonreused process-incarnation/context/domain key. The
// handle includes the stable slot and 32-bit generation. reservation names the
// exclusive physical custody instance, independently of its numerical base.
define ut108_key(job : BitVec64, owner : BitVec64, handle : BitVec64,
    object : BitVec64, reservation : BitVec64, base : BitVec64, span : BitVec64) =
    bvugt(job,ut108_z()) ∧ bvugt(owner,ut108_z()) ∧
    repr107_components(repr107_slot(handle),repr107_epoch(handle)) ∧
    bvugt(reservation,ut108_z()) ∧ init108_range(base,span) ∧
    pm93g_extent_well_formed(base,span)
define ut108_binding(job : BitVec64, owner : BitVec64, handle : BitVec64,
    object : BitVec64, reservation : BitVec64, base : BitVec64, span : BitVec64,
    rjob : BitVec64, rowner : BitVec64, rhandle : BitVec64,
    robject : BitVec64, rreservation : BitVec64, rbase : BitVec64, rspan : BitVec64) =
    ut108_key(job,owner,handle,object,reservation,base,span) ∧
    (job=rjob) ∧ (owner=rowner) ∧ (handle=rhandle) ∧ (object=robject) ∧
    (reservation=rreservation) ∧ (base=rbase) ∧ (span=rspan)

// Prefix scan invariant for the exact owner/armed census. The implementation
// folds the selected predicate over the complete stable directory while locked.
define ut108_census(cap : BitVec64, scanned : BitVec64, selected : BitVec64) =
    bvule(selected,scanned) ∧ bvule(scanned,cap)
define ut108_scan(cap : BitVec64, scanned : BitVec64, selected : BitVec64) =
    ut108_census(cap,scanned,selected) ∧ bvult(scanned,cap)
define ut108_hits(selected : BitVec64, matches : Bool) =
    if matches then bvadd(selected,ut108_o()) else selected
define ut108_selected(owner : BitVec64, row_owner : BitVec64, stage : BitVec8) =
    (owner=row_owner) ∧ (stage=bvconst(0,8))

// n is the exact census of THIS owner's armed records, not a request count.
// Existing pending jobs remain pending; a zero-allocation process may die too.
define ut108_close(owner : BitVec64, request_owner : BitVec64, owner_open : BitVec8,
    owner_record : BitVec8, authenticated_supervisor : BitVec8,
    cap : BitVec64, armed : BitVec64, pending : BitVec64, n : BitVec64,
    revision : BitVec64, expected : BitVec64, serial : BitVec8) =
    bvugt(owner,ut108_z()) ∧ (owner=request_owner) ∧ heap108_yes(owner_open) ∧
    heap108_yes(owner_record) ∧ heap108_yes(authenticated_supervisor) ∧
    ut108_queue(cap,armed,pending) ∧ bvule(n,armed) ∧
    ut108_serial(revision,expected,serial)
define ut108_closed(commit : Bool, before : BitVec8) =
    if commit then bvconst(0,8) else before
define ut108_armed_after(commit : Bool, armed : BitVec64, n : BitVec64) =
    if commit then bvsub(armed,n) else armed
define ut108_pending_after(commit : Bool, pending : BitVec64, n : BitVec64) =
    if commit then bvadd(pending,n) else pending
define ut108_stage_after_close(commit : Bool, owner : BitVec64,
    row_owner : BitVec64, stage : BitVec8) =
    if commit ∧ ut108_selected(owner,row_owner,stage) then bvconst(1,8) else stage
// Trusted process fence is checked even before a worker visits the row.
define ut108_admit(owner_open : BitVec8, stage : BitVec8) =
    heap108_yes(owner_open) ∧ (stage=bvconst(0,8))
// Repeated delivery acknowledges an existing obligation; it does not enqueue,
// reset its cursor, allocate an ID, or refund anything.
define ut108_duplicate(bound : Bool, owner_open : BitVec8, stage : BitVec8) =
    bound ∧ (owner_open=bvconst(0,8)) ∧ ut108_pending(stage)

// Claim never pops the durable work record. Fenced recovery is required before
// an unowned lease can be claimed again. Finite epochs/IDs never wrap.
define ut108_claim(bound : Bool, stage : BitVec8, lease : BitVec8,
    epoch : BitVec64, inflight : BitVec8, worker : BitVec64,
    revision : BitVec64, expected : BitVec64, serial : BitVec8) =
    bound ∧ ut108_pending(stage) ∧ (lease=bvconst(0,8)) ∧
    (inflight=bvconst(0,8)) ∧ bvult(epoch,ptr107_max()) ∧
    bvugt(worker,ut108_z()) ∧ ut108_serial(revision,expected,serial)
define ut108_lease(lease : BitVec8, epoch : BitVec64, worker : BitVec64,
    request_epoch : BitVec64, request_worker : BitVec64) =
    (lease=bvconst(1,8)) ∧ bvugt(epoch,ut108_z()) ∧ bvugt(worker,ut108_z()) ∧
    (epoch=request_epoch) ∧ (worker=request_worker)

// A completion/cancellation authenticates the entire stored ticket, not just
// the job. The same predicate authenticates old-epoch terminal cancellation
// while revoking; normal successful completion additionally needs a live lease.
define ut108_ticket(job_bound : Bool, epoch : BitVec64, worker : BitVec64,
    operation : BitVec64, version : BitVec64, start : BitVec64, amount : BitVec64,
    tepoch : BitVec64, tworker : BitVec64, toperation : BitVec64, tversion : BitVec64,
    tstart : BitVec64, tamount : BitVec64) =
    job_bound ∧ bvugt(epoch,ut108_z()) ∧ bvugt(worker,ut108_z()) ∧
    bvugt(operation,ut108_z()) ∧ (operation=toperation) ∧
    bvugt(amount,ut108_z()) ∧ (epoch=tepoch) ∧ (worker=tworker) ∧
    (version=tversion) ∧ (start=tstart) ∧ (amount=tamount)

// Terminal old CPU/DMA tickets use the previously accepted exact ticket gate.
// Completion can occur while the worker is absent. Authority retirement is
// separate from storage release in this refinement; custody and charges remain.
define ut108_finish_old(bound : Bool, stage : BitVec8, slot : BitVec64, gen : BitVec64,
    tslot : BitVec64, tgen : BitVec64, op : BitVec64, top : BitVec64,
    count : BitVec64, next : BitVec64, active : BitVec8,
    terminal : BitVec8, serial : BitVec8) =
    bound ∧ (stage=bvconst(1,8)) ∧
    heap108_finish(slot,gen,tslot,tgen,op,top,count,next,active,terminal,serial)
define ut108_retire(bound : Bool, leased : Bool, stage : BitVec8,
    old_phase : BitVec8, cpu : BitVec64, dma : BitVec64,
    grants : BitVec64, maps : BitVec64, paths_closed : BitVec8,
    custody : BitVec8, visibility : BitVec8, serial : BitVec8) =
    bound ∧ leased ∧ (stage=bvconst(1,8)) ∧
    conc107_retire(old_phase,bvconst(3,8),cpu,dma,serial) ∧
    (grants=ut108_z()) ∧ (maps=ut108_z()) ∧ heap108_yes(paths_closed) ∧
    heap108_yes(custody) ∧ heap108_yes(visibility)

// Grants/maps are gone; storage remains reserved exclusively for this job.
// Physical pointer tags may still contain old kind and are cleared by chunks.
define ut108_begin(bound : Bool, leased : Bool, stage : BitVec8, old_phase : BitVec8,
    cpu : BitVec64, dma : BitVec64, readers : BitVec64, writers : BitVec64,
    base : BitVec64, span : BitVec64, custody : BitVec8,
    terminal_visibility : BitVec8, serial : BitVec8) =
    bound ∧ leased ∧ (stage=bvconst(2,8)) ∧ (old_phase=bvconst(3,8)) ∧
    (cpu=ut108_z()) ∧ (dma=ut108_z()) ∧ (readers=ut108_z()) ∧ (writers=ut108_z()) ∧
    init108_range(base,span) ∧ heap108_yes(custody) ∧
    heap108_yes(terminal_visibility) ∧ heap108_yes(serial)

// At most one scrub ticket per job. Submission changes the active ticket and
// issuance sequence, never the completed cursor/bytes/receipt. A terminal chunk uses
// init108_byte AND init108_tag and advances done/version with the SAME decision.
// Failed partial device writes are confined to the submitted uncompleted range;
// they establish no clean prefix or receipt. Terminal failure can retry that
// range; worker recovery conservatively restarts the whole prefix.
// Every submission consumes a nonwrapping sequence, even if later cancelled.
// Version/range alone would allow a cancelled completion to match its retry.
define ut108_submit(bound : Bool, leased : Bool, stage : BitVec8,
    inflight : BitVec8, done : BitVec64, amount : BitVec64, span : BitVec64,
    version : BitVec64, sequence : BitVec64, custody : BitVec8, serial : BitVec8) =
    bound ∧ leased ∧ (stage=bvconst(3,8)) ∧ (inflight=bvconst(0,8)) ∧
    bvult(sequence,ptr107_max()) ∧
    init108_chunk(bvconst(1,8),done,amount,span,version,version,custody,serial)
define ut108_sequence(submitted : Bool, before : BitVec64) =
    if submitted then bvadd(before,ut108_o()) else before
define ut108_complete(bound : Bool, leased : Bool, stage : BitVec8,
    inflight : BitVec8, done : BitVec64, start : BitVec64, amount : BitVec64,
    span : BitVec64, version : BitVec64, ticket_version : BitVec64,
    terminal : BitVec8, success : BitVec8, visible : BitVec8,
    custody : BitVec8, serial : BitVec8) =
    bound ∧ leased ∧ (stage=bvconst(3,8)) ∧ heap108_yes(inflight) ∧ (done=start) ∧
    heap108_yes(terminal) ∧ heap108_yes(success) ∧ heap108_yes(visible) ∧
    init108_chunk(bvconst(1,8),done,amount,span,version,ticket_version,custody,serial)
// Draining a failed/cancelled scrub ticket is not a successful chunk. Ticket
// identity (including stored start/amount/version) must be matched before this
// guard, under the original lease epoch, including while revoking it.
define ut108_cancel_ticket(bound_ticket : Bool, lease : BitVec8, inflight : BitVec8,
    terminal : BitVec8, fence_visible : BitVec8, serial : BitVec8) =
    bound_ticket ∧ ((lease=bvconst(1,8)) ∨ (lease=bvconst(2,8))) ∧
    heap108_yes(inflight) ∧ heap108_yes(terminal) ∧
    heap108_yes(fence_visible) ∧ heap108_yes(serial)

// init108_publish is used only for its complete-prefix/visibility conditions.
// This stage makes NO application authority. The cleanup receipt is bound to
// the exact job key, lease epoch/worker and current mutation version.
define ut108_clean(bound : Bool, leased : Bool, stage : BitVec8, inflight : BitVec8,
    done : BitVec64, span : BitVec64, version : BitVec64, receipt_version : BitVec64,
    readers : BitVec64, writers : BitVec64, custody : BitVec8,
    visible : BitVec8, serial : BitVec8) =
    leased ∧ (stage=bvconst(3,8)) ∧ (inflight=bvconst(0,8)) ∧
    init108_publish(bound,bvconst(1,8),done,span,version,receipt_version,
        custody,readers,writers,visible,serial)

// Failure revokes admission of further scrub operations immediately but cannot
// revoke writes already submitted. Durable stage, key, counters and charge stay.
define ut108_fail(bound : Bool, stage : BitVec8, lease : BitVec8,
    serial : BitVec8) =
    bound ∧ ut108_pending(stage) ∧ (lease=bvconst(1,8)) ∧ heap108_yes(serial)
define ut108_recover(bound : Bool, stage : BitVec8, lease : BitVec8,
    inflight : BitVec8, worker_fenced : BitVec8, visibility : BitVec8,
    version : BitVec64, serial : BitVec8) =
    bound ∧ ut108_pending(stage) ∧ (lease=bvconst(2,8)) ∧
    (inflight=bvconst(0,8)) ∧ heap108_yes(worker_fenced) ∧ heap108_yes(visibility) ∧
    bvult(version,ptr107_max()) ∧ heap108_yes(serial)
define ut108_recovered_stage(recovered : Bool, stage : BitVec8) =
    if recovered ∧ bvuge(stage,bvconst(3,8)) then bvconst(2,8) else stage
define ut108_recovered_done(recovered : Bool, done : BitVec64) =
    if recovered then ut108_z() else done
// ANY intervening non-scrub mutation invalidates a clean prefix atomically.
// The first implementation should prohibit such writers; this is fail-closed
// invalidation if trusted maintenance is later permitted under serialization.
define ut108_mutate(bound : Bool, stage : BitVec8, inflight : BitVec8,
    version : BitVec64, custody : BitVec8, serial : BitVec8) =
    bound ∧ ((stage=bvconst(3,8)) ∨ (stage=bvconst(4,8))) ∧
    (inflight=bvconst(0,8)) ∧ bvult(version,ptr107_max()) ∧
    heap108_yes(custody) ∧ heap108_yes(serial)

// Final return is one atomic removal/extent return/refund/slot-release commit.
// Unlike reclaim108_release's synchronous path this is ALREADY retired; do not
// call retirement twice or refund at the earlier authority-retirement step.
// Tags/counts/placement and byte charges are from exact current storage state.
define ut108_release(bound : Bool, leased : Bool, stage : BitVec8, old_phase : BitVec8,
    inflight : BitVec8, done : BitVec64, span : BitVec64,
    version : BitVec64, receipt_version : BitVec64,
    cpu : BitVec64, dma : BitVec64, grants : BitVec64, maps : BitVec64, tags : BitVec64,
    placed : BitVec8, custody : BitVec8, visibility : BitVec8,
    cap : BitVec64, armed : BitVec64, pending : BitVec64,
    payload : BitVec64, actual : BitVec64,
    revision : BitVec64, expected : BitVec64, serial : BitVec8) =
    bound ∧ leased ∧ (stage=bvconst(4,8)) ∧ (old_phase=bvconst(3,8)) ∧
    (inflight=bvconst(0,8)) ∧ init108_aligned(span) ∧ bvugt(span,ut108_z()) ∧
    (done=span) ∧ (version=receipt_version) ∧
    (cpu=ut108_z()) ∧ (dma=ut108_z()) ∧ (grants=ut108_z()) ∧
    (maps=ut108_z()) ∧ (tags=ut108_z()) ∧ (placed=bvconst(0,8)) ∧
    heap108_yes(custody) ∧ heap108_yes(visibility) ∧
    ut108_queue(cap,armed,pending) ∧ bvugt(pending,ut108_z()) ∧
    (actual=span) ∧ bvule(actual,payload) ∧ ut108_serial(revision,expected,serial)
define ut108_after_release(released : Bool, pending : BitVec64) =
    if released then bvsub(pending,ut108_o()) else pending
// Exact returned payload is refundable; resident metadata/fixed queue/retained
// clean pools remain charged in their separate categories of reclaim108_ledger.
define ut108_payload(released : Bool, payload : BitVec64, span : BitVec64) =
    reclaim108_refund(released,payload,span)

// New publication still needs its OWN reservation/new-lifetime binding and
// complete initialization gate. An old Undertaker receipt cannot be replayed as
// an init108_binding. Clean-pool ownership transfer is not silently assumed.
define ut108_new_lifetime(released : Bool, new_binding : Bool, new_clean : Bool,
    prepared : Bool, logical : BitVec64, rounded : BitVec64, initialized : BitVec64) =
    released ∧ new_binding ∧ init108_heap_gate(new_clean,prepared,logical,rounded,initialized)

// Fault-free progress measure is lexicographic, avoiding overflow in cpu+dma+
// bytes. Claim/submission/idle steps stutter. Terminal old work decreases cpu or
// dma; retirement/begin/clean/release decrease phase; committed chunks decrease
// remaining bytes. Recovery can INCREASE rank. Eventual release additionally
// requires eventual fault-free service, terminal devices, successful scrubs,
// adequate nonwrapping epoch/version/operation headroom and fair scheduling/
// completion delivery. Permanent device errors retain quarantine. No assumption
// is installed as an axiom, no idle-only liveness or permanent clean-pool claim.
define ut108_rank(stage : BitVec8) =
    if stage=bvconst(1,8) then bvconst(5,64) else
    if stage=bvconst(2,8) then bvconst(4,64) else
    if stage=bvconst(3,8) then bvconst(3,64) else
    if stage=bvconst(4,8) then bvconst(2,64) else ut108_z()
define ut108_less(s : BitVec8, ns : BitVec8, c : BitVec64, nc : BitVec64,
    d : BitVec64, nd : BitVec64, r : BitVec64, nr : BitVec64) =
    bvult(ut108_rank(ns),ut108_rank(s)) ∨
    ((ut108_rank(ns)=ut108_rank(s)) ∧
        (bvult(nc,c) ∨ ((nc=c) ∧ (bvult(nd,d) ∨ ((nd=d) ∧ bvult(nr,r))))))





// UNDERTAKER WITNESSES: constructive trace and quantified/hostile boundaries.

// One linear let trace computes each transition once; no checkpoint is assumed.
define ut108_trace_check(choice : BitVec64) =
    let v_ut108_trace_bound = ut108_binding(bvconst(50,64),bvconst(101,64),repr107_handle(bvconst(3,64),bvconst(7,64)),bvconst(12,64),bvconst(90,64),bvconst(8192,64),bvconst(4096,64),bvconst(50,64),bvconst(101,64),repr107_handle(bvconst(3,64),bvconst(7,64)),bvconst(12,64),bvconst(90,64),bvconst(8192,64),bvconst(4096,64)) in
    let v_ut108_trace_close = ut108_close(bvconst(101,64),bvconst(101,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(3,64),bvconst(2,64),bvconst(1,64),bvconst(2,64),bvconst(7,64),bvconst(7,64),bvconst(1,8)) in
    let v_ut108_trace_queue = ut108_stage_after_close(v_ut108_trace_close,bvconst(101,64),bvconst(101,64),bvconst(0,8)) in
    let v_ut108_trace_claim = ut108_claim(v_ut108_trace_bound,v_ut108_trace_queue,bvconst(0,8),bvconst(7,64),bvconst(0,8),bvconst(40,64),bvconst(8,64),bvconst(8,64),bvconst(1,8)) in
    let v_ut108_trace_lease = ut108_lease(heap108_phase_after(v_ut108_trace_claim,bvconst(0,8),bvconst(1,8)),init108_version(v_ut108_trace_claim,bvconst(7,64)),bvconst(40,64),bvconst(8,64),bvconst(40,64)) in
    let v_ut108_trace_cpu = ut108_finish_old(v_ut108_trace_bound,v_ut108_trace_queue,bvconst(3,64),bvconst(7,64),bvconst(3,64),bvconst(7,64),bvconst(400,64),bvconst(400,64),bvconst(1,64),bvconst(0,64),bvconst(1,8),bvconst(1,8),bvconst(1,8)) in
    let v_ut108_trace_cpu_left = if v_ut108_trace_cpu then ut108_z() else ut108_o() in
    let v_ut108_trace_dma = ut108_finish_old(v_ut108_trace_bound,v_ut108_trace_queue,bvconst(3,64),bvconst(7,64),bvconst(3,64),bvconst(7,64),bvconst(401,64),bvconst(401,64),bvconst(1,64),bvconst(0,64),bvconst(1,8),bvconst(1,8),bvconst(1,8)) in
    let v_ut108_trace_dma_left = if v_ut108_trace_dma then ut108_z() else ut108_o() in
    let v_ut108_trace_retire = ut108_retire(v_ut108_trace_bound,v_ut108_trace_lease,v_ut108_trace_queue,ut108_lifetime(v_ut108_trace_queue),v_ut108_trace_cpu_left,v_ut108_trace_dma_left,bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)) in
    let v_ut108_trace_retired = heap108_phase_after(v_ut108_trace_retire,v_ut108_trace_queue,bvconst(2,8)) in
    let v_ut108_trace_oldphase = ut108_lifetime(v_ut108_trace_retired) in
    let v_ut108_trace_begin = ut108_begin(v_ut108_trace_bound,v_ut108_trace_lease,v_ut108_trace_retired,v_ut108_trace_oldphase,v_ut108_trace_cpu_left,v_ut108_trace_dma_left,bvconst(0,64),bvconst(0,64),bvconst(8192,64),bvconst(4096,64),bvconst(1,8),bvconst(1,8),bvconst(1,8)) in
    let v_ut108_trace_scrub = heap108_phase_after(v_ut108_trace_begin,v_ut108_trace_retired,bvconst(3,8)) in
    let v_ut108_trace_submit = ut108_submit(v_ut108_trace_bound,v_ut108_trace_lease,v_ut108_trace_scrub,bvconst(0,8),bvconst(0,64),bvconst(2048,64),bvconst(4096,64),bvconst(10,64),bvconst(0,64),bvconst(1,8),bvconst(1,8)) in
    let v_ut108_trace_seq1 = ut108_sequence(v_ut108_trace_submit,ut108_z()) in
    let v_ut108_trace_ticket = ut108_ticket(v_ut108_trace_bound,bvconst(8,64),bvconst(40,64),v_ut108_trace_seq1,bvconst(10,64),bvconst(0,64),bvconst(2048,64),bvconst(8,64),bvconst(40,64),bvconst(1,64),bvconst(10,64),bvconst(0,64),bvconst(2048,64)) in
    let v_ut108_trace_first = ut108_complete(v_ut108_trace_ticket,v_ut108_trace_lease,v_ut108_trace_scrub,heap108_phase_after(v_ut108_trace_submit,bvconst(0,8),bvconst(1,8)),bvconst(0,64),bvconst(0,64),bvconst(2048,64),bvconst(4096,64),bvconst(10,64),bvconst(10,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)) in
    let v_ut108_trace_done1 = init108_done(v_ut108_trace_first,ut108_z(),bvconst(2048,64)) in
    let v_ut108_trace_v1 = init108_version(v_ut108_trace_first,bvconst(10,64)) in
    let v_ut108_trace_submit2 = ut108_submit(v_ut108_trace_bound,v_ut108_trace_lease,v_ut108_trace_scrub,bvconst(0,8),v_ut108_trace_done1,bvconst(2048,64),bvconst(4096,64),v_ut108_trace_v1,v_ut108_trace_seq1,bvconst(1,8),bvconst(1,8)) in
