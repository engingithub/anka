// E3: bounded verified-evidence registry and serialized provider-use contract.
// No axioms. This refines E1's trusted provider boundary, NOT cryptography.
// All transitions below are ATOMIC in one trusted authority lane. The embedding
// must implement that exclusion; these predicates do not prove a Rust mutex.
// Context time, freshness/fencing verdicts and validated evidence are trusted
// inputs. Network fields/addresses cannot mint them. The registry is volatile;
// replay-resistant restart freshness requires an external trusted source.
// Safety only: finite work/deadlines do not prove scheduling or I/O liveness.
import "anka110_evidence_admission.kleis"

data V110Lane = V110Lane(anchor : BitVec64, installation : BitVec64, policy : BitVec64, runtime : BitVec64, serial : BitVec64, challenge : BitVec64, slot_limit : BitVec64, counter : BitVec64, holder : BitVec64, remaining : BitVec64, deadline : BitVec64, live : Bool)
define vl_anchor(v : V110Lane) = match v { V110Lane(anchor,installation,policy,runtime,serial,challenge,slot_limit,counter,holder,remaining,deadline,live) => anchor }
define vl_installation(v : V110Lane) = match v { V110Lane(anchor,installation,policy,runtime,serial,challenge,slot_limit,counter,holder,remaining,deadline,live) => installation }
define vl_policy(v : V110Lane) = match v { V110Lane(anchor,installation,policy,runtime,serial,challenge,slot_limit,counter,holder,remaining,deadline,live) => policy }
define vl_runtime(v : V110Lane) = match v { V110Lane(anchor,installation,policy,runtime,serial,challenge,slot_limit,counter,holder,remaining,deadline,live) => runtime }
define vl_serial(v : V110Lane) = match v { V110Lane(anchor,installation,policy,runtime,serial,challenge,slot_limit,counter,holder,remaining,deadline,live) => serial }
define vl_challenge(v : V110Lane) = match v { V110Lane(anchor,installation,policy,runtime,serial,challenge,slot_limit,counter,holder,remaining,deadline,live) => challenge }
define vl_slot_limit(v : V110Lane) = match v { V110Lane(anchor,installation,policy,runtime,serial,challenge,slot_limit,counter,holder,remaining,deadline,live) => slot_limit }
define vl_counter(v : V110Lane) = match v { V110Lane(anchor,installation,policy,runtime,serial,challenge,slot_limit,counter,holder,remaining,deadline,live) => counter }
define vl_holder(v : V110Lane) = match v { V110Lane(anchor,installation,policy,runtime,serial,challenge,slot_limit,counter,holder,remaining,deadline,live) => holder }
define vl_remaining(v : V110Lane) = match v { V110Lane(anchor,installation,policy,runtime,serial,challenge,slot_limit,counter,holder,remaining,deadline,live) => remaining }
define vl_deadline(v : V110Lane) = match v { V110Lane(anchor,installation,policy,runtime,serial,challenge,slot_limit,counter,holder,remaining,deadline,live) => deadline }
define vl_live(v : V110Lane) = match v { V110Lane(anchor,installation,policy,runtime,serial,challenge,slot_limit,counter,holder,remaining,deadline,live) => live }
data V110Slot = V110Slot(index : BitVec64, generation : BitVec64, runtime : BitVec64, serial : BitVec64, connection : BitVec64, binding : BitVec64, live : Bool)
define vs_index(v : V110Slot) = match v { V110Slot(index,generation,runtime,serial,connection,binding,live) => index }
define vs_generation(v : V110Slot) = match v { V110Slot(index,generation,runtime,serial,connection,binding,live) => generation }
define vs_runtime(v : V110Slot) = match v { V110Slot(index,generation,runtime,serial,connection,binding,live) => runtime }
define vs_serial(v : V110Slot) = match v { V110Slot(index,generation,runtime,serial,connection,binding,live) => serial }
define vs_connection(v : V110Slot) = match v { V110Slot(index,generation,runtime,serial,connection,binding,live) => connection }
define vs_binding(v : V110Slot) = match v { V110Slot(index,generation,runtime,serial,connection,binding,live) => binding }
define vs_live(v : V110Slot) = match v { V110Slot(index,generation,runtime,serial,connection,binding,live) => live }
data V110Handle = V110Handle(index : BitVec64, generation : BitVec64, runtime : BitVec64, serial : BitVec64, connection : BitVec64, binding : BitVec64)
define vh_index(v : V110Handle) = match v { V110Handle(index,generation,runtime,serial,connection,binding) => index }
define vh_generation(v : V110Handle) = match v { V110Handle(index,generation,runtime,serial,connection,binding) => generation }
define vh_runtime(v : V110Handle) = match v { V110Handle(index,generation,runtime,serial,connection,binding) => runtime }
define vh_serial(v : V110Handle) = match v { V110Handle(index,generation,runtime,serial,connection,binding) => serial }
define vh_connection(v : V110Handle) = match v { V110Handle(index,generation,runtime,serial,connection,binding) => connection }
define vh_binding(v : V110Handle) = match v { V110Handle(index,generation,runtime,serial,connection,binding) => binding }
data V110Lease = V110Lease(runtime : BitVec64, serial : BitVec64, challenge : BitVec64, ticket : BitVec64, index : BitVec64, generation : BitVec64, connection : BitVec64, binding : BitVec64, req_anchor : BitVec64, req_installation : BitVec64, req_policy : BitVec64, req_caller : BitVec64, req_incarnation : BitVec64, req_sequence : BitVec64, req_expected : BitVec64, req_kind : BitVec64, req_argument : BitVec64, req_attempt : BitVec64)
define vj_runtime(v : V110Lease) = match v { V110Lease(runtime,serial,challenge,ticket,index,generation,connection,binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt) => runtime }
define vj_serial(v : V110Lease) = match v { V110Lease(runtime,serial,challenge,ticket,index,generation,connection,binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt) => serial }
define vj_challenge(v : V110Lease) = match v { V110Lease(runtime,serial,challenge,ticket,index,generation,connection,binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt) => challenge }
define vj_ticket(v : V110Lease) = match v { V110Lease(runtime,serial,challenge,ticket,index,generation,connection,binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt) => ticket }
define vj_index(v : V110Lease) = match v { V110Lease(runtime,serial,challenge,ticket,index,generation,connection,binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt) => index }
define vj_generation(v : V110Lease) = match v { V110Lease(runtime,serial,challenge,ticket,index,generation,connection,binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt) => generation }
define vj_connection(v : V110Lease) = match v { V110Lease(runtime,serial,challenge,ticket,index,generation,connection,binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt) => connection }
define vj_binding(v : V110Lease) = match v { V110Lease(runtime,serial,challenge,ticket,index,generation,connection,binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt) => binding }
define vj_req_anchor(v : V110Lease) = match v { V110Lease(runtime,serial,challenge,ticket,index,generation,connection,binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt) => req_anchor }
define vj_req_installation(v : V110Lease) = match v { V110Lease(runtime,serial,challenge,ticket,index,generation,connection,binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt) => req_installation }
define vj_req_policy(v : V110Lease) = match v { V110Lease(runtime,serial,challenge,ticket,index,generation,connection,binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt) => req_policy }
define vj_req_caller(v : V110Lease) = match v { V110Lease(runtime,serial,challenge,ticket,index,generation,connection,binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt) => req_caller }
define vj_req_incarnation(v : V110Lease) = match v { V110Lease(runtime,serial,challenge,ticket,index,generation,connection,binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt) => req_incarnation }
define vj_req_sequence(v : V110Lease) = match v { V110Lease(runtime,serial,challenge,ticket,index,generation,connection,binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt) => req_sequence }
define vj_req_expected(v : V110Lease) = match v { V110Lease(runtime,serial,challenge,ticket,index,generation,connection,binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt) => req_expected }
define vj_req_kind(v : V110Lease) = match v { V110Lease(runtime,serial,challenge,ticket,index,generation,connection,binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt) => req_kind }
define vj_req_argument(v : V110Lease) = match v { V110Lease(runtime,serial,challenge,ticket,index,generation,connection,binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt) => req_argument }
define vj_req_attempt(v : V110Lease) = match v { V110Lease(runtime,serial,challenge,ticket,index,generation,connection,binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt) => req_attempt }

define v110_lane(l : V110Lane) = vl_live(l) ∧
    a109_nonzero(vl_anchor(l)) ∧ a109_nonzero(vl_installation(l)) ∧ a109_nonzero(vl_policy(l)) ∧
    a109_nonzero(vl_runtime(l)) ∧ a109_nonzero(vl_serial(l)) ∧ a109_nonzero(vl_challenge(l)) ∧
    a109_nonzero(vl_slot_limit(l)) ∧ bvule(vl_slot_limit(l),bvconst(64,64))
define v110_idle(l : V110Lane) = v110_lane(l) ∧ (vl_holder(l)=a109_z()) ∧
    (vl_remaining(l)=a109_z()) ∧ (vl_deadline(l)=a109_z())
define v110_lookup(l : V110Lane,s : V110Slot,h : V110Handle) =
    v110_lane(l) ∧ vs_live(s) ∧ a109_nonzero(vs_index(s)) ∧ bvule(vs_index(s),vl_slot_limit(l)) ∧
    a109_nonzero(vs_generation(s)) ∧ a109_nonzero(vs_connection(s)) ∧ a109_nonzero(vs_binding(s)) ∧
    (vs_runtime(s)=vl_runtime(l)) ∧ (vs_serial(s)=vl_serial(l)) ∧
    (vs_index(s)=vh_index(h)) ∧ (vs_generation(s)=vh_generation(h)) ∧ (vs_runtime(s)=vh_runtime(h)) ∧ (vs_serial(s)=vh_serial(h)) ∧ (vs_connection(s)=vh_connection(h)) ∧ (vs_binding(s)=vh_binding(h))
define v110_held(l : V110Lane,j : V110Lease) = v110_lane(l) ∧ a109_nonzero(vl_holder(l)) ∧
    (vl_holder(l)=vj_ticket(j)) ∧ (vl_counter(l)=vj_ticket(j)) ∧
    (vl_runtime(l)=vj_runtime(j)) ∧ (vl_serial(l)=vj_serial(j)) ∧ (vl_challenge(l)=vj_challenge(j))
define v110_slot_lease(s : V110Slot,j : V110Lease) =
    (vs_index(s)=vj_index(j)) ∧ (vs_generation(s)=vj_generation(j)) ∧ (vs_runtime(s)=vj_runtime(j)) ∧ (vs_serial(s)=vj_serial(j)) ∧ (vs_connection(s)=vj_connection(j)) ∧ (vs_binding(s)=vj_binding(j))
// Acquiring a reservation is not permission to perform a storage effect.
// The exact request and immutable E1 evidence must be retained by the guard.
define v110_acquire(b : V110Lane,a : V110Lane,s : V110Slot,h : V110Handle,j : V110Lease,now : BitVec64,deadline : BitVec64,work : BitVec64,r : P109Request) =
    n110_shape(r) ∧ v110_lease_request(j,r) ∧ v110_idle(b) ∧ v110_lookup(b,s,h) ∧ bvult(vl_counter(b),a109_max()) ∧
    a109_nonzero(work) ∧ bvule(work,bvconst(512,64)) ∧ bvult(now,deadline) ∧
    (vl_anchor(b)=vl_anchor(a)) ∧ (vl_installation(b)=vl_installation(a)) ∧ (vl_policy(b)=vl_policy(a)) ∧ (vl_runtime(b)=vl_runtime(a)) ∧ (vl_serial(b)=vl_serial(a)) ∧ (vl_challenge(b)=vl_challenge(a)) ∧ (vl_slot_limit(b)=vl_slot_limit(a)) ∧ (vl_live(b)=vl_live(a)) ∧
    (vl_counter(a)=bvadd(vl_counter(b),bvconst(1,64))) ∧ (vl_holder(a)=vl_counter(a)) ∧
    (vl_remaining(a)=work) ∧ (vl_deadline(a)=deadline) ∧ v110_held(a,j) ∧ v110_slot_lease(s,j)
define v110_request_same(a : P109Request,b : P109Request) =
    (pr_anchor(a)=pr_anchor(b)) ∧ (pr_installation(a)=pr_installation(b)) ∧ (pr_policy(a)=pr_policy(b)) ∧ (pr_caller(a)=pr_caller(b)) ∧ (pr_incarnation(a)=pr_incarnation(b)) ∧ (pr_sequence(a)=pr_sequence(b)) ∧ (pr_expected(a)=pr_expected(b)) ∧ (pr_kind(a)=pr_kind(b)) ∧ (pr_argument(a)=pr_argument(b)) ∧ (pr_attempt(a)=pr_attempt(b))
define v110_lease_request(j : V110Lease,r : P109Request) =
    (vj_req_anchor(j)=pr_anchor(r)) ∧ (vj_req_installation(j)=pr_installation(r)) ∧ (vj_req_policy(j)=pr_policy(r)) ∧ (vj_req_caller(j)=pr_caller(r)) ∧ (vj_req_incarnation(j)=pr_incarnation(r)) ∧ (vj_req_sequence(j)=pr_sequence(r)) ∧ (vj_req_expected(j)=pr_expected(r)) ∧ (vj_req_kind(j)=pr_kind(r)) ∧ (vj_req_argument(j)=pr_argument(r)) ∧ (vj_req_attempt(j)=pr_attempt(r))
define v110_current(l : V110Lane,s : V110Slot,h : V110Handle,j : V110Lease,c : A109Context,o : E110Observation) =
    v110_held(l,j) ∧ v110_lookup(l,s,h) ∧ v110_slot_lease(s,j) ∧
    a109_nonzero(vl_remaining(l)) ∧ bvule(vl_remaining(l),bvconst(512,64)) ∧ bvult(ctx_now(c),vl_deadline(l)) ∧
    (ctx_anchor(c)=vl_anchor(l)) ∧ (ctx_installation(c)=vl_installation(l)) ∧ (ctx_epoch(c)=vl_policy(l)) ∧
    (ctx_challenge(c)=vl_challenge(l)) ∧ (eo_runtime(o)=vl_runtime(l)) ∧ (eo_serial(o)=vl_serial(l)) ∧
    (eo_connection(o)=vs_connection(s)) ∧ (eo_binding(o)=vs_binding(s))
// Only this composed gate can authorize a caller operation/disclosure. The
// same lane remains held until completion or abort. T2 still decides commit,
// conflict/replay, artifact validity and boot admission; this gate adds none.
define v110_caller(l : V110Lane,s : V110Slot,h : V110Handle,j : V110Lease,c : A109Context,i : A109Identity,p : E110Permit,b : E110Binding,o : E110Observation,frozen : P109Request,r : P109Request,a : P109Access) =
    v110_current(l,s,h,j,c,o) ∧ v110_lease_request(j,frozen) ∧ v110_request_same(frozen,r) ∧
    e110_client_access(c,i,p,b,o,vl_serial(l),r,a)
define v110_server(l : V110Lane,s : V110Slot,h : V110Handle,j : V110Lease,c : A109Context,i : A109Identity,p : E110Permit,b : E110Binding,o : E110Observation,frozen : P109Request,r : P109Request,expected : BitVec64) =
    v110_current(l,s,h,j,c,o) ∧ v110_lease_request(j,frozen) ∧ v110_request_same(frozen,r) ∧
    e110_server(c,i,p,b,o,vl_serial(l),expected,r)
// A single authorized effect consumes one work unit; no authority field or
// absolute deadline can change. Completion is not inferred from a grant.
define v110_consume(b : V110Lane,a : V110Lane,j : V110Lease) =
    v110_held(b,j) ∧ a109_nonzero(vl_remaining(b)) ∧
    (vl_anchor(b)=vl_anchor(a)) ∧ (vl_installation(b)=vl_installation(a)) ∧ (vl_policy(b)=vl_policy(a)) ∧ (vl_runtime(b)=vl_runtime(a)) ∧ (vl_serial(b)=vl_serial(a)) ∧ (vl_challenge(b)=vl_challenge(a)) ∧ (vl_slot_limit(b)=vl_slot_limit(a)) ∧ (vl_counter(b)=vl_counter(a)) ∧ (vl_holder(b)=vl_holder(a)) ∧ (vl_deadline(b)=vl_deadline(a)) ∧ (vl_live(b)=vl_live(a)) ∧
    (vl_remaining(a)=bvsub(vl_remaining(b),bvconst(1,64)))
// Cleanup must remain possible after expiry or budget exhaustion. It never
// authorizes another effect, refunds consumed work, or rolls back a commit.
define v110_release(b : V110Lane,a : V110Lane,j : V110Lease) =
    v110_held(b,j) ∧ (vl_anchor(b)=vl_anchor(a)) ∧ (vl_installation(b)=vl_installation(a)) ∧ (vl_policy(b)=vl_policy(a)) ∧ (vl_runtime(b)=vl_runtime(a)) ∧ (vl_serial(b)=vl_serial(a)) ∧ (vl_challenge(b)=vl_challenge(a)) ∧ (vl_slot_limit(b)=vl_slot_limit(a)) ∧ (vl_counter(b)=vl_counter(a)) ∧ (vl_live(b)=vl_live(a)) ∧
    (vl_holder(a)=a109_z()) ∧ (vl_remaining(a)=a109_z()) ∧ (vl_deadline(a)=a109_z())
// Current authority can change only outside a held effect. Every change bumps
// serial, even when policy number is unchanged (e.g. revocation). Older entries
// become unusable; fresh validation and slot generation are needed to republish.
define v110_update(b : V110Lane,a : V110Lane) =
    v110_idle(b) ∧ v110_idle(a) ∧ bvult(vl_serial(b),a109_max()) ∧
    (vl_serial(a)=bvadd(vl_serial(b),bvconst(1,64))) ∧
    (vl_anchor(b)=vl_anchor(a)) ∧ (vl_installation(b)=vl_installation(a)) ∧ (vl_runtime(b)=vl_runtime(a)) ∧ (vl_slot_limit(b)=vl_slot_limit(a)) ∧ (vl_counter(b)=vl_counter(a))
// Retire/rebind operate under the same exclusion as authority updates.
define v110_retire(l : V110Lane,b : V110Slot,a : V110Slot) =
    v110_idle(l) ∧ vs_live(b) ∧ a109_nonzero(vs_index(b)) ∧ bvule(vs_index(b),vl_slot_limit(l)) ∧
    (vs_index(b)=vs_index(a)) ∧ (vs_generation(b)=vs_generation(a)) ∧ (vs_runtime(b)=vs_runtime(a)) ∧ (vs_serial(b)=vs_serial(a)) ∧ (vs_connection(b)=vs_connection(a)) ∧ (vs_binding(b)=vs_binding(a)) ∧ ¬vs_live(a)
define v110_rebind(l : V110Lane,b : V110Slot,a : V110Slot) =
    v110_idle(l) ∧ ¬vs_live(b) ∧ vs_live(a) ∧ a109_nonzero(vs_index(b)) ∧
    bvule(vs_index(b),vl_slot_limit(l)) ∧ (vs_index(a)=vs_index(b)) ∧
    bvult(vs_generation(b),a109_max()) ∧ (vs_generation(a)=bvadd(vs_generation(b),bvconst(1,64))) ∧
    (vs_runtime(a)=vl_runtime(l)) ∧ (vs_serial(a)=vl_serial(l)) ∧
    a109_nonzero(vs_connection(a)) ∧ a109_nonzero(vs_binding(a))
// Restart recovery is allowed only with trusted fencing/drainage and fresh
// runtime+challenge. Differing integers alone are NOT proof of freshness.
define v110_restart(b : V110Lane,a : V110Lane,fenced : A109Verdict,fresh : A109Verdict,drained : Bool) =
    v110_lane(b) ∧ v110_idle(a) ∧ (fenced=A109Valid) ∧ (fresh=A109Valid) ∧ drained ∧
    bvult(vl_serial(b),a109_max()) ∧ (vl_serial(a)=bvadd(vl_serial(b),bvconst(1,64))) ∧
    ¬(vl_runtime(a)=vl_runtime(b)) ∧ ¬(vl_challenge(a)=vl_challenge(b)) ∧
    (vl_anchor(b)=vl_anchor(a)) ∧ (vl_installation(b)=vl_installation(a)) ∧ (vl_policy(b)=vl_policy(a)) ∧ (vl_slot_limit(b)=vl_slot_limit(a)) ∧ (vl_counter(b)=vl_counter(a))

define v110_effect(l : V110Lane,next : V110Lane,s : V110Slot,h : V110Handle,j : V110Lease,c : A109Context,i : A109Identity,p : E110Permit,b : E110Binding,o : E110Observation,frozen : P109Request,r : P109Request,a : P109Access) =
    v110_caller(l,s,h,j,c,i,p,b,o,frozen,r,a) ∧ v110_consume(l,next,j)
// This authorizes an ATTEMPT, not backend success. Failure still consumes work.
// No call to consume alone may authorize an effect or disclose an outcome.


example "bounded live registry lookup" { assert(v110_lookup(V110Lane(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(5,64),bvconst(9,64),bvconst(71,64),bvconst(4,64),bvconst(10,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),(bvconst(1,8)=bvconst(1,8))),V110Slot(bvconst(1,64),bvconst(2,64),bvconst(5,64),bvconst(9,64),bvconst(6,64),bvconst(7,64),(bvconst(1,8)=bvconst(1,8))),V110Handle(bvconst(1,64),bvconst(2,64),bvconst(5,64),bvconst(9,64),bvconst(6,64),bvconst(7,64)))) }
