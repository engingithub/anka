// Phase 10.8 first gate: synchronous protected console output, specification only.
// No new axioms. Import the implemented 10.7 pointer/event proof vocabulary.
// SYS_WRITE remains number 1, but protected mode selects a DISTINCT trap ABI:
// R0=1, R1=0, R2/R3=protected (handle, byte position), R4=byte length,
// R5=0. R0/R1 and R4/R5 MUST have scalar kind. R0 is the only result lane.
// Arguments and kind are obtained from the owned protected event image, not
// handler registers (whose tags are cleared on entry). Legacy raw ABI unchanged.
// Zero length still requires an authentic live pointer and READ authority;
// a valid one-past pointer is permitted. Null/forged zero-length calls fail.
// One descriptor/allocation and ONE Fabric READ grant cover the entire range.
// No address-map stitching, implicit rights amplification, async retention, DMA,
// input syscall, malloc, or new application syscall numbers in this first gate.
// trusted fabric_current means one generation-current grant, checked under the
// same serialized authority boundary as use. It is not a user-supplied flag.
import "anka107_pointer_events.kleis"

define io108_limit() = bvconst(65536,64)
define io108_abi(number : BitVec64, reserved : BitVec64, flags : BitVec64,
    kind01 : BitVec8, kind45 : BitVec8) =
    (number=bvconst(1,64)) ∧ (reserved=bvconst(0,64)) ∧
    (flags=bvconst(0,64)) ∧ (kind01=bvconst(0,8)) ∧ (kind45=bvconst(0,8))

// Subtraction-based half-open bounds avoid pos+length overflow.
define io108_range(lo : BitVec64, hi : BitVec64, pos : BitVec64,
    extent : BitVec64, length : BitVec64) =
    ptr107_view(lo,hi,pos,extent) ∧ bvule(length,io108_limit()) ∧
    bvule(length,bvsub(hi,pos))

// Range grant is allocation-relative; cap_object binds the same allocation.
// fabric_current includes actual Fabric object generation/permission admission.
define io108_buffer(h : BitVec64, pos : BitVec64, tag : BitVec8,
    slot : BitVec64, epoch : BitVec64, descriptor_live : BitVec8,
    caller_domain : BitVec64, descriptor_domain : BitVec64,
    caller_context : BitVec64, owner_context : BitVec64,
    descriptor_id : BitVec64, descriptor_gen : BitVec64,
    lo : BitVec64, hi : BitVec64, rights : BitVec64,
    allocation_id : BitVec64, allocation_gen : BitVec64, allocation_live : BitVec8,
    base : BitVec64, extent : BitVec64, length : BitVec64,
    cap_object : BitVec64, cap_lo : BitVec64, cap_hi : BitVec64,
    cap_rights : BitVec64, fabric_current : BitVec8) =
    repr107_lookup(h,tag,slot,epoch,descriptor_live,caller_domain,descriptor_domain) ∧
    (caller_context=owner_context) ∧
    ptr107_current(descriptor_id,descriptor_gen,allocation_id,allocation_gen,
        allocation_live,tag) ∧
    ptr107_record_valid(allocation_id,allocation_gen,base,extent) ∧
    io108_range(lo,hi,pos,extent,length) ∧
    bvule(rights,bvconst(3,64)) ∧ (bvand(rights,bvconst(1,64))=bvconst(1,64)) ∧
    (cap_object=allocation_id) ∧ bvule(cap_lo,pos) ∧ bvule(pos,cap_hi) ∧
    bvule(cap_hi,extent) ∧ bvule(length,bvsub(cap_hi,pos)) ∧
    bvule(cap_rights,bvconst(3,64)) ∧
    (bvand(cap_rights,bvconst(1,64))=bvconst(1,64)) ∧
    (fabric_current=bvconst(1,8))

// Admission certificates below stand for the complete predicates above and
// event107_admit. An implementation must derive them from trusted state.
// Checking + acquiring the CPU lease linearize together; no unchecked TOCTOU.
define io108_begin(abi_ok : BitVec8, buffer_ok : BitVec8, event_ok : BitVec8,
    phase : BitVec8, count : BitVec64, next : BitVec64,
    fresh_ticket : BitVec8, serialized : BitVec8) =
    (abi_ok=bvconst(1,8)) ∧ (event_ok=bvconst(1,8)) ∧
    conc107_admit(phase,count,next,buffer_ok,fresh_ticket,serialized)

// Per-byte use still rechecks current authority; a lease pins backing, not rights.
// index is relative to the requested interval, never to the whole allocation.
define io108_read(length : BitVec64, index : BitVec64,
    phase : BitVec8, active : BitVec8, bound : BitVec8,
    fabric_current : BitVec8, serialized : BitVec8) =
    bvule(length,io108_limit()) ∧ bvult(index,length) ∧
    conc107_commit(phase,active,bound,fabric_current,serialized)

// All bytes stage privately. No externally visible output before full copy and
// final authorization. Sink reserve/append is serialized and capacity-checked.
// Reads observe a sequence, not an atomic snapshot of concurrently mutable data.
define io108_commit(ready : BitVec8, copied : BitVec64, length : BitVec64,
    current_authority : BitVec8, sink_used : BitVec64, sink_capacity : BitVec64,
    serialized : BitVec8) =
    (ready=bvconst(1,8)) ∧ (copied=length) ∧ bvule(length,io108_limit()) ∧
    (current_authority=bvconst(1,8)) ∧ (serialized=bvconst(1,8)) ∧
    bvule(sink_used,sink_capacity) ∧ bvule(length,bvsub(sink_capacity,sink_used))
define io108_result(committed : BitVec8, length : BitVec64) =
    if committed=bvconst(1,8) then length else ptr107_max()
define io108_sink_size(committed : BitVec8, used : BitVec64, length : BitVec64) =
    if committed=bvconst(1,8) then bvadd(used,length) else used
// Pointwise append frame: byte is from the staged observation at query-used.
// This specifies the append effect; it does not prove a runtime buffer loop.
define io108_sink_byte(committed : BitVec8, used : BitVec64, length : BitVec64,
    query : BitVec64, staged : BitVec8, old : BitVec8) =
    if committed=bvconst(1,8) ∧ bvuge(query,used) ∧
        bvult(bvsub(query,used),length) then staged else old

// Success OR rejection after admission consumes the ticket once; a pre-admission
// failure has no ticket. Terminal confirmed means no future reads/callbacks.
define io108_finish(count : BitVec64, next : BitVec64, active : BitVec8,
    next_active : BitVec8, bound : BitVec8, terminal : BitVec8, serialized : BitVec8) =
    conc107_finish(count,next,active,next_active,bound,terminal,serialized)
// No retained borrow/callback/DMA authority may survive return in this subset.
define io108_return(active : BitVec8, retained : BitVec8,
    pending_reads : BitVec64, pending_dma : BitVec64) =
    (active=bvconst(0,8)) ∧ (retained=bvconst(0,8)) ∧
    (pending_reads=bvconst(0,64)) ∧ (pending_dma=bvconst(0,64))

example "protected trap scalar lanes" {
    assert(io108_abi(bvconst(1,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8)))
}

example "reject exit is not write ABI" {
    assert(¬(io108_abi(bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8))))
}

example "reject unapproved syscall" {
    assert(¬(io108_abi(bvconst(2,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8))))
}

example "reject reserved lane" {
    assert(¬(io108_abi(bvconst(1,64),bvconst(1,64),bvconst(0,64),bvconst(0,8),bvconst(0,8))))
}

example "reject flags" {
    assert(¬(io108_abi(bvconst(1,64),bvconst(0,64),bvconst(1,64),bvconst(0,8),bvconst(0,8))))
}

example "reject tagged number pair" {
    assert(¬(io108_abi(bvconst(1,64),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(0,8))))
}

example "reject tagged length pair" {
    assert(¬(io108_abi(bvconst(1,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(1,8))))
}

example "live narrowed unaligned byte buffer" {
    assert(io108_buffer(bvconst(4294967303,64),bvconst(3,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(11,64),bvconst(4,64),bvconst(2,64),bvconst(14,64),bvconst(1,64),bvconst(11,64),bvconst(4,64),bvconst(1,8),bvconst(4096,64),bvconst(16,64),bvconst(5,64),bvconst(11,64),bvconst(2,64),bvconst(14,64),bvconst(1,64),bvconst(1,8)))
}

