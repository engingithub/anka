example "reject whole request raw pointer bypass" {
    assert(¬(io108_request(bvconst(1,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8),bvconst(4294967303,64),bvconst(3,64),bvconst(0,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(11,64),bvconst(4,64),bvconst(2,64),bvconst(14,64),bvconst(1,64),bvconst(11,64),bvconst(4,64),bvconst(1,8),bvconst(4096,64),bvconst(16,64),bvconst(5,64),bvconst(11,64),bvconst(2,64),bvconst(14,64),bvconst(1,64),bvconst(1,8),bvconst(9,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(1,8))))
}

example "reject whole request closing allocation" {
    assert(¬(io108_request(bvconst(1,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8),bvconst(4294967303,64),bvconst(3,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(11,64),bvconst(4,64),bvconst(2,64),bvconst(14,64),bvconst(1,64),bvconst(11,64),bvconst(4,64),bvconst(1,8),bvconst(4096,64),bvconst(16,64),bvconst(5,64),bvconst(11,64),bvconst(2,64),bvconst(14,64),bvconst(1,64),bvconst(1,8),bvconst(9,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(2,8),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(1,8))))
}

example "reject whole request revoked grant" {
    assert(¬(io108_request(bvconst(1,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8),bvconst(4294967303,64),bvconst(3,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(11,64),bvconst(4,64),bvconst(2,64),bvconst(14,64),bvconst(1,64),bvconst(11,64),bvconst(4,64),bvconst(1,8),bvconst(4096,64),bvconst(16,64),bvconst(5,64),bvconst(11,64),bvconst(2,64),bvconst(14,64),bvconst(1,64),bvconst(0,8),bvconst(9,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(1,8))))
}

example "whole buffer authorization refines each protected byte" {
    assert(∀(h : BitVec64). ∀(pos : BitVec64). ∀(tag : BitVec8). ∀(slot : BitVec64). ∀(epoch : BitVec64). ∀(descriptor_live : BitVec8). ∀(caller_domain : BitVec64). ∀(descriptor_domain : BitVec64). ∀(caller_context : BitVec64). ∀(owner_context : BitVec64). ∀(descriptor_id : BitVec64). ∀(descriptor_gen : BitVec64). ∀(lo : BitVec64). ∀(hi : BitVec64). ∀(rights : BitVec64). ∀(allocation_id : BitVec64). ∀(allocation_gen : BitVec64). ∀(allocation_live : BitVec8). ∀(base : BitVec64). ∀(extent : BitVec64). ∀(length : BitVec64). ∀(cap_object : BitVec64). ∀(cap_lo : BitVec64). ∀(cap_hi : BitVec64). ∀(cap_rights : BitVec64). ∀(fabric_current : BitVec8). ∀(i : BitVec64).
    (io108_buffer(h,pos,tag,slot,epoch,descriptor_live,caller_domain,descriptor_domain,caller_context,owner_context,descriptor_id,descriptor_gen,lo,hi,rights,allocation_id,allocation_gen,allocation_live,base,extent,length,cap_object,cap_lo,cap_hi,cap_rights,fabric_current) ∧ bvult(i,length)) → repr107_access(h,bvadd(pos,i),tag,slot,epoch,descriptor_live,caller_domain,descriptor_domain,descriptor_id,descriptor_gen,lo,hi,rights,allocation_id,allocation_gen,allocation_live,base,extent,bvconst(1,64),bvconst(1,64),fabric_current,bvconst(1,8)))
}

example "every effective byte address is nonwrapping" {
    assert(∀(h : BitVec64). ∀(pos : BitVec64). ∀(tag : BitVec8). ∀(slot : BitVec64). ∀(epoch : BitVec64). ∀(descriptor_live : BitVec8). ∀(caller_domain : BitVec64). ∀(descriptor_domain : BitVec64). ∀(caller_context : BitVec64). ∀(owner_context : BitVec64). ∀(descriptor_id : BitVec64). ∀(descriptor_gen : BitVec64). ∀(lo : BitVec64). ∀(hi : BitVec64). ∀(rights : BitVec64). ∀(allocation_id : BitVec64). ∀(allocation_gen : BitVec64). ∀(allocation_live : BitVec8). ∀(base : BitVec64). ∀(extent : BitVec64). ∀(length : BitVec64). ∀(cap_object : BitVec64). ∀(cap_lo : BitVec64). ∀(cap_hi : BitVec64). ∀(cap_rights : BitVec64). ∀(fabric_current : BitVec8). ∀(i : BitVec64).
    (io108_buffer(h,pos,tag,slot,epoch,descriptor_live,caller_domain,descriptor_domain,caller_context,owner_context,descriptor_id,descriptor_gen,lo,hi,rights,allocation_id,allocation_gen,allocation_live,base,extent,length,cap_object,cap_lo,cap_hi,cap_rights,fabric_current) ∧ bvult(i,length)) →
    (bvuge(bvadd(base,bvadd(pos,i)),base) ∧ bvult(bvadd(pos,i),extent)))
}


// Final publication composes sink/copy checks with CURRENT lease and Fabric
// admission. The captured ready certificate is insufficient after lease release.
define io108_publish(ready : BitVec8, copied : BitVec64, length : BitVec64,
    phase : BitVec8, active : BitVec8, bound : BitVec8, current_fabric : BitVec8,
    sink_used : BitVec64, sink_capacity : BitVec64, serialized : BitVec8) =
    io108_commit(ready,copied,length,current_fabric,sink_used,sink_capacity,serialized) ∧
    conc107_commit(phase,active,bound,current_fabric,serialized)
define io108_publish_flag(ready : BitVec8, copied : BitVec64, length : BitVec64,
    phase : BitVec8, active : BitVec8, bound : BitVec8, current_fabric : BitVec8,
    sink_used : BitVec64, sink_capacity : BitVec64, serialized : BitVec8) =
    if io108_publish(ready,copied,length,phase,active,bound,current_fabric,
        sink_used,sink_capacity,serialized) then bvconst(1,8) else bvconst(0,8)

example "complete authorized publication" {
    assert(io108_publish(bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(10,64),bvconst(100,64),bvconst(1,8)))
}

example "reject retired publication" {
    assert(¬(io108_publish(bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(3,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(10,64),bvconst(100,64),bvconst(1,8))))
}

example "reject publication after lease release" {
    assert(¬(io108_publish(bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(10,64),bvconst(100,64),bvconst(1,8))))
}

example "reject publication with foreign ticket" {
    assert(¬(io108_publish(bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(10,64),bvconst(100,64),bvconst(1,8))))
}

example "reject publication after revocation" {
    assert(¬(io108_publish(bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(10,64),bvconst(100,64),bvconst(1,8))))
}

example "reject publication of partial copy" {
    assert(¬(io108_publish(bvconst(1,8),bvconst(4,64),bvconst(5,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(10,64),bvconst(100,64),bvconst(1,8))))
}

example "closing publication drains existing lease" {
    assert(io108_publish(bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(2,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(10,64),bvconst(100,64),bvconst(1,8)))
}

example "rejected publication preserves complete sink size" {
    assert(∀(ready : BitVec8). ∀(copied : BitVec64). ∀(n : BitVec64).
    ∀(phase : BitVec8). ∀(active : BitVec8). ∀(bound : BitVec8).
    ∀(fabric : BitVec8). ∀(used : BitVec64). ∀(capacity : BitVec64). ∀(serialized : BitVec8).
    ¬(io108_publish(ready,copied,n,phase,active,bound,fabric,used,capacity,serialized)) → io108_sink_size(io108_publish_flag(ready,copied,n,phase,active,bound,fabric,used,capacity,serialized),used,n)=used)
}

example "released ticket cannot publish any output" {
    assert(∀(ready : BitVec8). ∀(copied : BitVec64). ∀(n : BitVec64).
    ∀(phase : BitVec8). ∀(active : BitVec8). ∀(bound : BitVec8).
    ∀(fabric : BitVec8). ∀(used : BitVec64). ∀(capacity : BitVec64). ∀(serialized : BitVec8).
    (active=bvconst(0,8)) → io108_sink_size(io108_publish_flag(ready,copied,n,phase,active,bound,fabric,used,capacity,serialized),used,n)=used)
}

example "successful publication count is bounded" {
    assert(∀(ready : BitVec8). ∀(copied : BitVec64). ∀(n : BitVec64).
    ∀(phase : BitVec8). ∀(active : BitVec8). ∀(bound : BitVec8).
    ∀(fabric : BitVec8). ∀(used : BitVec64). ∀(capacity : BitVec64). ∀(serialized : BitVec8).
    io108_publish(ready,copied,n,phase,active,bound,fabric,used,capacity,serialized) → bvule(io108_result(io108_publish_flag(ready,copied,n,phase,active,bound,fabric,used,capacity,serialized),n),io108_limit()))
}
