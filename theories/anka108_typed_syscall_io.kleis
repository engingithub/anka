example "read write rights may output" {
    assert(io108_buffer(bvconst(4294967303,64),bvconst(3,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(11,64),bvconst(4,64),bvconst(2,64),bvconst(14,64),bvconst(3,64),bvconst(11,64),bvconst(4,64),bvconst(1,8),bvconst(4096,64),bvconst(16,64),bvconst(5,64),bvconst(11,64),bvconst(2,64),bvconst(14,64),bvconst(3,64),bvconst(1,8)))
}

example "exact narrowed interval" {
    assert(io108_buffer(bvconst(4294967303,64),bvconst(2,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(11,64),bvconst(4,64),bvconst(2,64),bvconst(14,64),bvconst(1,64),bvconst(11,64),bvconst(4,64),bvconst(1,8),bvconst(4096,64),bvconst(16,64),bvconst(12,64),bvconst(11,64),bvconst(2,64),bvconst(14,64),bvconst(1,64),bvconst(1,8)))
}

example "maximum 64 KiB output" {
    assert(io108_buffer(bvconst(4294967303,64),bvconst(0,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(11,64),bvconst(4,64),bvconst(0,64),bvconst(65536,64),bvconst(1,64),bvconst(11,64),bvconst(4,64),bvconst(1,8),bvconst(4096,64),bvconst(65536,64),bvconst(65536,64),bvconst(11,64),bvconst(0,64),bvconst(65536,64),bvconst(1,64),bvconst(1,8)))
}

example "admit and acquire lease" {
    assert(io108_begin(bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(1,8)))
}

example "reject ABI failure" {
    assert(¬(io108_begin(bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(1,8))))
}

example "reject buffer failure" {
    assert(¬(io108_begin(bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(1,8))))
}

example "reject unowned event image" {
    assert(¬(io108_begin(bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(1,8))))
}

example "reject closing allocation admission" {
    assert(¬(io108_begin(bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(2,8),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(1,8))))
}

example "reject retired allocation admission" {
    assert(¬(io108_begin(bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(3,8),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(1,8))))
}

example "reject incorrect lease increment" {
    assert(¬(io108_begin(bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,64),bvconst(2,64),bvconst(1,8),bvconst(1,8))))
}

example "reject reused ticket" {
    assert(¬(io108_begin(bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,64),bvconst(1,64),bvconst(0,8),bvconst(1,8))))
}

example "reject unserialized admission" {
    assert(¬(io108_begin(bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(0,8))))
}

example "reject lease counter wrap" {
    assert(¬(io108_begin(bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),ptr107_max(),bvconst(0,64),bvconst(1,8),bvconst(1,8))))
}

example "last exact byte" {
    assert(io108_read(bvconst(5,64),bvconst(4,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))
}

example "closing allocation pinned in flight" {
    assert(io108_read(bvconst(5,64),bvconst(4,64),bvconst(2,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))
}

example "reject overread" {
    assert(¬(io108_read(bvconst(5,64),bvconst(5,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8))))
}

example "reject read after ticket consumed" {
    assert(¬(io108_read(bvconst(5,64),bvconst(4,64),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8))))
}

example "reject foreign ticket" {
    assert(¬(io108_read(bvconst(5,64),bvconst(4,64),bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8))))
}

example "reject revocation during copy" {
    assert(¬(io108_read(bvconst(5,64),bvconst(4,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(1,8))))
}

example "reject unserialized copy" {
    assert(¬(io108_read(bvconst(5,64),bvconst(4,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,8))))
}

example "reject zero length operand transaction" {
    assert(¬(io108_read(bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8))))
}

example "atomic append complete copy" {
    assert(io108_commit(bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8),bvconst(10,64),bvconst(100,64),bvconst(1,8)))
}

example "reject failed preflight commit" {
    assert(¬(io108_commit(bvconst(0,8),bvconst(5,64),bvconst(5,64),bvconst(1,8),bvconst(10,64),bvconst(100,64),bvconst(1,8))))
}

example "reject partial copy commit" {
    assert(¬(io108_commit(bvconst(1,8),bvconst(4,64),bvconst(5,64),bvconst(1,8),bvconst(10,64),bvconst(100,64),bvconst(1,8))))
}

example "reject excess copy count" {
    assert(¬(io108_commit(bvconst(1,8),bvconst(6,64),bvconst(5,64),bvconst(1,8),bvconst(10,64),bvconst(100,64),bvconst(1,8))))
}

example "reject revocation before append" {
    assert(¬(io108_commit(bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(0,8),bvconst(10,64),bvconst(100,64),bvconst(1,8))))
}

example "reject invalid sink occupancy" {
    assert(¬(io108_commit(bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8),bvconst(101,64),bvconst(100,64),bvconst(1,8))))
}

example "reject insufficient sink capacity" {
    assert(¬(io108_commit(bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8),bvconst(10,64),bvconst(14,64),bvconst(1,8))))
}

example "reject unserialized append" {
    assert(¬(io108_commit(bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8),bvconst(10,64),bvconst(100,64),bvconst(0,8))))
}

example "reject wrapping sink append" {
    assert(¬(io108_commit(bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8),ptr107_max(),ptr107_max(),bvconst(1,8))))
}

example "zero length complete no-op" {
    assert(io108_commit(bvconst(1,8),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(10,64),bvconst(100,64),bvconst(1,8)))
}

example "terminal release once" {
    assert(io108_finish(bvconst(1,64),bvconst(0,64),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))
}

example "reject double completion" {
    assert(¬(io108_finish(bvconst(1,64),bvconst(0,64),bvconst(0,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8))))
}

example "reject ticket kept active" {
    assert(¬(io108_finish(bvconst(1,64),bvconst(0,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8))))
}

example "reject foreign completion" {
    assert(¬(io108_finish(bvconst(1,64),bvconst(0,64),bvconst(1,8),bvconst(0,8),bvconst(0,8),bvconst(1,8),bvconst(1,8))))
}

example "reject release before last read" {
    assert(¬(io108_finish(bvconst(1,64),bvconst(0,64),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(0,8),bvconst(1,8))))
}

example "return with no retained authority" {
    assert(io108_return(bvconst(0,8),bvconst(0,8),bvconst(0,64),bvconst(0,64)))
}

example "reject return with live ticket" {
    assert(¬(io108_return(bvconst(1,8),bvconst(0,8),bvconst(0,64),bvconst(0,64))))
}

example "reject retained borrow" {
    assert(¬(io108_return(bvconst(0,8),bvconst(1,8),bvconst(0,64),bvconst(0,64))))
}

example "reject pending callback" {
    assert(¬(io108_return(bvconst(0,8),bvconst(0,8),bvconst(1,64),bvconst(0,64))))
}

example "reject DMA export" {
    assert(¬(io108_return(bvconst(0,8),bvconst(0,8),bvconst(0,64),bvconst(1,64))))
}

example "only R0 result overwrites saved words" {
    assert(event107_word(bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,64),bvconst(2,64),bvconst(4294967303,64),bvconst(5,64),bvconst(0,64))=bvconst(4294967303,64))
}

example "buffer pair tag survives syscall" {
    assert(event107_tag(bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,64),bvconst(2,64),bvconst(1,8),bvconst(0,8))=bvconst(1,8))
}

example "scalar result cannot mint pointer" {
    assert(event107_tag(bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,64),bvconst(0,64),bvconst(1,8),bvconst(1,8))=bvconst(0,8))
}

example "pinned scope cannot retire" {
    assert(¬(conc107_retire(bvconst(2,8),bvconst(3,8),bvconst(1,64),bvconst(0,64),bvconst(1,8))))
}

example "drained scope may retire" {
    assert(conc107_retire(bvconst(2,8),bvconst(3,8),bvconst(0,64),bvconst(0,64),bvconst(1,8)))
}

example "every requested byte stays in narrowed range" {
    assert(∀(lo : BitVec64). ∀(hi : BitVec64). ∀(pos : BitVec64). ∀(extent : BitVec64). ∀(length : BitVec64). ∀(i : BitVec64).
    (io108_range(lo,hi,pos,extent,length) ∧ bvult(i,length)) →
    (bvuge(bvadd(pos,i),pos) ∧ bvuge(bvadd(pos,i),lo) ∧ bvult(bvadd(pos,i),hi)))
}

example "range refines existing exact byte bounds" {
    assert(∀(lo : BitVec64). ∀(hi : BitVec64). ∀(pos : BitVec64). ∀(extent : BitVec64). ∀(length : BitVec64). ∀(i : BitVec64).
    (io108_range(lo,hi,pos,extent,length) ∧ bvult(i,length)) →
    (ptr107_view(lo,hi,bvadd(pos,i),extent) ∧ app107_range_valid(bvadd(pos,i),hi,bvconst(1,64))))
}

example "accepted append cannot overflow" {
    assert(∀(n : BitVec64). ∀(used : BitVec64). ∀(capacity : BitVec64).
    io108_commit(bvconst(1,8),n,n,bvconst(1,8),used,capacity,bvconst(1,8)) →
    (bvuge(bvadd(used,n),used) ∧ bvule(bvadd(used,n),capacity)))
}

example "failed output leaves every sink byte unchanged" {
    assert(∀(used : BitVec64). ∀(n : BitVec64). ∀(q : BitVec64). ∀(b : BitVec8). ∀(old : BitVec8).
    io108_sink_byte(bvconst(0,8),used,n,q,b,old)=old)
}

example "append preserves existing prefix" {
    assert(∀(used : BitVec64). ∀(n : BitVec64). ∀(q : BitVec64). ∀(b : BitVec8). ∀(old : BitVec8).
    bvult(q,used) → io108_sink_byte(bvconst(1,8),used,n,q,b,old)=old)
}

example "empty append changes no bytes" {
    assert(∀(used : BitVec64). ∀(q : BitVec64). ∀(b : BitVec8). ∀(old : BitVec8).
    io108_sink_byte(bvconst(1,8),used,bvconst(0,64),q,b,old)=old)
}

example "failure has sentinel" {
    assert(io108_result(bvconst(0,8),bvconst(5,64))=ptr107_max())
}

example "success has full count" {
    assert(io108_result(bvconst(1,8),bvconst(5,64))=bvconst(5,64))
}

example "failure preserves sink size" {
    assert(io108_sink_size(bvconst(0,8),bvconst(10,64),bvconst(5,64))=bvconst(10,64))
}

example "append has exact size" {
    assert(io108_sink_size(bvconst(1,8),bvconst(10,64),bvconst(5,64))=bvconst(15,64))
}

example "append writes observed byte" {
    assert(io108_sink_byte(bvconst(1,8),bvconst(10,64),bvconst(5,64),bvconst(14,64),bvconst(65,8),bvconst(0,8))=bvconst(65,8))
}

example "append excludes end byte" {
    assert(io108_sink_byte(bvconst(1,8),bvconst(10,64),bvconst(5,64),bvconst(15,64),bvconst(65,8),bvconst(0,8))=bvconst(0,8))
}

// Whole-request composition. All arguments come from one protected saved
// request and the authoritative descriptor/allocation/Fabric records at admission.
// No guest-provided validation booleans substitute for these predicates.
define io108_request(number : BitVec64,
    reserved : BitVec64,
    flags : BitVec64,
    kind01 : BitVec8,
    kind45 : BitVec8,
    h : BitVec64,
    pos : BitVec64,
    tag : BitVec8,
    slot : BitVec64,
    epoch : BitVec64,
    descriptor_live : BitVec8,
    caller_domain : BitVec64,
    descriptor_domain : BitVec64,
    caller_context : BitVec64,
    owner_context : BitVec64,
    descriptor_id : BitVec64,
    descriptor_gen : BitVec64,
    lo : BitVec64,
    hi : BitVec64,
    rights : BitVec64,
    allocation_id : BitVec64,
    allocation_gen : BitVec64,
    allocation_live : BitVec8,
    base : BitVec64,
    extent : BitVec64,
    length : BitVec64,
    cap_object : BitVec64,
    cap_lo : BitVec64,
    cap_hi : BitVec64,
    cap_rights : BitVec64,
    fabric_current : BitVec8,
    saved_context : BitVec64,
    saved_domain : BitVec64,
    public_depth : BitVec64,
    protected_depth : BitVec64,
    header_exact : BitVec8,
    saved_mode : BitVec8,
    phase : BitVec8,
    cpu_count : BitVec64,
    next_cpu_count : BitVec64,
    fresh_ticket : BitVec8,
    serialized : BitVec8) =
    io108_abi(number,reserved,flags,kind01,kind45) ∧
    io108_buffer(h,pos,tag,slot,epoch,descriptor_live,caller_domain,descriptor_domain,caller_context,owner_context,descriptor_id,descriptor_gen,lo,hi,rights,allocation_id,allocation_gen,allocation_live,base,extent,length,cap_object,cap_lo,cap_hi,cap_rights,fabric_current) ∧
    event107_admit(saved_context,caller_context,saved_domain,caller_domain,public_depth,protected_depth,header_exact,bvconst(1,8),saved_mode) ∧
    conc107_admit(phase,cpu_count,next_cpu_count,bvconst(1,8),fresh_ticket,serialized)

example "whole protected request admits" {
    assert(io108_request(bvconst(1,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8),bvconst(4294967303,64),bvconst(3,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(11,64),bvconst(4,64),bvconst(2,64),bvconst(14,64),bvconst(1,64),bvconst(11,64),bvconst(4,64),bvconst(1,8),bvconst(4096,64),bvconst(16,64),bvconst(5,64),bvconst(11,64),bvconst(2,64),bvconst(14,64),bvconst(1,64),bvconst(1,8),bvconst(9,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(1,8)))
}

