// E7: server-side admission before the first durable read. No credential format.
// Values below are authenticated validator outputs, never decoded wire assertions.
// Issuance binds the identity to its holder key as ONE authenticated statement.
// Proof verification binds the signing key to ALL fields of the E1 binding as
// ONE statement. Key references are canonical, nonzero, local verifier handles.
// The transport independently supplies the actual live stream observation;
// its runtime/session/binding identity must be fresh on reconnect and restart.
import "anka110_evidence_admission.kleis"

// Verified credential-key association and verified signer of a specific
// channel transcript. Transcript references must identify the whole verified
// binding within the runtime; they are not caller-selected correlation IDs.
data K110Key = K110Key(issuer : BitVec64, subject : BitVec64, kind : BitVec64, holder : BitVec64, verified : A109Verdict)
data K110Signer = K110Signer(runtime : BitVec64, connection : BitVec64, transcript : BitVec64, holder : BitVec64, verified : A109Verdict)
define k110_key_ok(k : K110Key, i : A109Identity, c : A109Context) = match k {
    K110Key(issuer,subject,kind,holder,verified) => (verified=A109Valid) ∧ (issuer=ctx_anchor(c)) ∧ (subject=ident_subject(i)) ∧ (kind=ident_kind(i)) ∧ a109_nonzero(holder)
}
define k110_key_value(k : K110Key) = match k { K110Key(issuer,subject,kind,holder,verified) => holder }
define k110_signer_ok(s : K110Signer, k : K110Key, b : E110Binding) = match s {
    K110Signer(runtime,connection,transcript,holder,verified) => (verified=A109Valid) ∧ (runtime=eb_runtime(b)) ∧ (connection=eb_connection(b)) ∧ (transcript=eb_binding(b)) ∧ (holder=k110_key_value(k))
}

// Identity and live proof can succeed even when the subject has no grant.
define k110_peer(c : A109Context, id : A109Identity, key : K110Key, proof : E110Binding, signer : K110Signer, o : E110Observation) =
    a109_recognize(c,id,eo_peer(o),eo_kind(o)) ∧
    e110_observation(c,o) ∧ e110_bound(o,proof) ∧
    k110_key_ok(key,id,c) ∧ k110_signer_ok(signer,key,proof)

// grant_present is trusted lookup presence, not a bit a caller may assert.
// Missing lookup must deny even if a previously valid permit remains in memory.
define k110_admit(c : A109Context, id : A109Identity, key : K110Key, proof : E110Binding, signer : K110Signer, o : E110Observation,
                  grant_present : Bool, permit : E110Permit, serial : BitVec64, r : P109Request, a : P109Access) =
    k110_peer(c,id,key,proof,signer,o) ∧ grant_present ∧
    e110_client_access(c,id,permit,proof,o,serial,r,a)

// Trace of one attempted first read: the gate can refuse a read after admission
// (for example, no budget). It cannot emit a read event on denial.
define k110_step(c : A109Context, id : A109Identity, key : K110Key, proof : E110Binding, signer : K110Signer, o : E110Observation,
                 grant_present : Bool, permit : E110Permit, serial : BitVec64, r : P109Request, a : P109Access,
                 funded : Bool, read_event : Bool) =
    read_event = (funded ∧ k110_admit(c,id,key,proof,signer,o,grant_present,permit,serial,r,a))

// Witness fixtures: concrete constructor terms for Kleis 1.0.
example "recognized A with own key and exact grant can reach first read" {
    assert(k110_step(A109Context(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(71,64),bvconst(100,64),(bvconst(1,8)=bvconst(1,8))),A109Identity(bvconst(10,64),bvconst(30,64),bvconst(1,64),bvconst(20,64),bvconst(3,64),bvconst(71,64),bvconst(90,64),bvconst(110,64),A109Valid,A109Valid,A109Valid),K110Key(bvconst(10,64),bvconst(30,64),bvconst(1,64),bvconst(88,64),A109Valid),E110Binding(bvconst(5,64),bvconst(6,64),bvconst(7,64),bvconst(40,64),bvconst(30,64),bvconst(1,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(9,64),bvconst(71,64),A109Valid),K110Signer(bvconst(5,64),bvconst(6,64),bvconst(7,64),bvconst(88,64),A109Valid),E110Observation(bvconst(5,64),bvconst(6,64),bvconst(7,64),bvconst(40,64),bvconst(30,64),bvconst(1,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(9,64),bvconst(71,64),(bvconst(1,8)=bvconst(1,8)),A109Valid),(bvconst(1,8)=bvconst(1,8)),E110Permit(bvconst(10,64),bvconst(30,64),bvconst(1,64),bvconst(20,64),bvconst(3,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(95,64),bvconst(108,64),A109Valid,A109Valid),bvconst(9,64),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),P109Access(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(95,64),bvconst(108,64),A109Valid,A109Valid),(bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8))))
}
