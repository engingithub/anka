    assert(rb108_publish(bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(8,64),bvconst(6,64),bvconst(8,64),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))
}

example "FALSE rb108_publish rejects overwrite compiler" {
    assert(rb108_publish(bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(7,64),bvconst(6,64),bvconst(8,64),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))
}

example "FALSE rb108_publish rejects writable publication" {
    assert(rb108_publish(bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(11,64),bvconst(6,64),bvconst(8,64),bvconst(7,64),bvconst(3,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))
}

example "FALSE rb108_publish rejects executable publication" {
    assert(rb108_publish(bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(11,64),bvconst(6,64),bvconst(8,64),bvconst(7,64),bvconst(5,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))
}

example "FALSE rb108_publish rejects wrong owner" {
    assert(rb108_publish(bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(11,64),bvconst(6,64),bvconst(8,64),bvconst(7,64),bvconst(1,64),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))
}

example "FALSE rb108_publish rejects stale source or compiler" {
    assert(rb108_publish(bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(11,64),bvconst(6,64),bvconst(8,64),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))
}

example "FALSE rb108_publish rejects no publish authority" {
    assert(rb108_publish(bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(11,64),bvconst(6,64),bvconst(8,64),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))
}

example "FALSE rb108_publish rejects stale reservation" {
    assert(rb108_publish(bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(11,64),bvconst(6,64),bvconst(8,64),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))
}

example "FALSE rb108_publish rejects output changed after validation" {
    assert(rb108_publish(bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(11,64),bvconst(6,64),bvconst(8,64),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))
}

example "FALSE rb108_publish rejects invalid receipt" {
    assert(rb108_publish(bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(11,64),bvconst(6,64),bvconst(8,64),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))
}

example "FALSE rb108_publish rejects nonatomic artifact receipt pair" {
    assert(rb108_publish(bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(11,64),bvconst(6,64),bvconst(8,64),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8)))
}

example "FALSE rb108_publish rejects race at publication" {
    assert(rb108_publish(bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(11,64),bvconst(6,64),bvconst(8,64),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(1,8)))
}

example "FALSE rb108_publish rejects pending producer access" {
    assert(rb108_publish(bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(11,64),bvconst(6,64),bvconst(8,64),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,8)))
}

example "FALSE equal maximum epochs cannot wrap" {
    assert(rb108_publish(bvconst(1,8),ptr107_max(),ptr107_max(),bvconst(11,64),bvconst(6,64),bvconst(8,64),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))
}

example "FALSE rb108_abort rejects published rollback" {
    assert(rb108_abort(bvconst(2,8),bvconst(1,8)))
}

example "FALSE rb108_abort rejects already terminal" {
    assert(rb108_abort(bvconst(3,8),bvconst(1,8)))
}

example "FALSE rb108_abort rejects undrained reclaim" {
    assert(rb108_abort(bvconst(0,8),bvconst(0,8)))
}

example "FALSE logical names never authorize" {
    assert(rb108_names_grant_authority())
}

example "FALSE object publication never grants execution" {
    assert(rb108_object_grants_execution())
}

example "FALSE failed append may advance" {
    assert(∀(u : BitVec64). rb108_used(bvconst(0,8),u,bvconst(1,64))=bvadd(u,bvconst(1,64)))
}

example "FALSE failed publication exposes new output" {
    assert(rb108_visible(bvconst(0,8),bvconst(11,64),bvconst(10,64))=bvconst(11,64))
}

example "FALSE failed publication exposes receipt" {
    assert(rb108_visible(bvconst(0,8),bvconst(21,64),bvconst(20,64))=bvconst(21,64))
}

example "FALSE successful append may modify prefix" {
    assert(rb108_byte(bvconst(1,8),bvconst(16,64),bvconst(32,64),bvconst(15,64),bvconst(255,8),bvconst(0,8))=bvconst(255,8))
}

example "FALSE accept collecting storage reclaim" {
    assert(rb108_reclaim(bvconst(0,8),bvconst(1,8),bvconst(0,64),bvconst(0,64)))
}

example "FALSE accept frozen storage reclaim" {
    assert(rb108_reclaim(bvconst(1,8),bvconst(1,8),bvconst(0,64),bvconst(0,64)))
}

example "FALSE accept aborted undrained storage reclaim" {
    assert(rb108_reclaim(bvconst(3,8),bvconst(0,8),bvconst(0,64),bvconst(0,64)))
}

example "FALSE revive aborted session" {
    assert(rb108_step(bvconst(3,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8))=bvconst(1,8))
}

example "FALSE direct collecting publication" {
    assert(rb108_step(bvconst(0,8),bvconst(2,8),bvconst(1,8),bvconst(1,8),bvconst(1,8))=bvconst(2,8))
}
