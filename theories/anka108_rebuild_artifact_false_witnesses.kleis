    assert(rb108_publish(bvconst(1,8),bvconst(4,64),ptr107_max(),bvconst(11,64),bvconst(6,64),bvconst(8,64),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))
}

example "FALSE rb108_publish rejects unversioned output" {
    assert(rb108_publish(bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(11,64),bvconst(0,64),bvconst(8,64),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))
}

