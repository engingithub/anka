// E5: one reserved transport slot in one trusted registry instance.
// Phases: 0 = framed request ready; 1 = immutable 144-byte reply; 2 = released.
// Freeze after the existing N110 charge + canonical EOF/frame check. Registry,
// correlation and fixed reply bytes belong to this slot, never to wire credentials.
// rev is the durable revision observed at dispatch (a snapshot, not a global lock).
import "anka110_evidence_provider.kleis"
data G110Slot = G110Slot(peer_index : BitVec64,peer_generation : BitVec64,peer_runtime : BitVec64,peer_serial : BitVec64,peer_connection : BitVec64,peer_binding : BitVec64,req_anchor : BitVec64,req_installation : BitVec64,req_policy : BitVec64,req_caller : BitVec64,req_incarnation : BitVec64,req_sequence : BitVec64,req_expected : BitVec64,req_kind : BitVec64,req_argument : BitVec64,req_attempt : BitVec64,corr : BitVec64,deadline : BitVec64,work : BitVec64,phase : BitVec64,sent : BitVec64,rev : BitVec64)
define gt_peer_index(x : G110Slot) = match x { G110Slot(peer_index,peer_generation,peer_runtime,peer_serial,peer_connection,peer_binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt,corr,deadline,work,phase,sent,rev) => peer_index }
define gt_peer_generation(x : G110Slot) = match x { G110Slot(peer_index,peer_generation,peer_runtime,peer_serial,peer_connection,peer_binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt,corr,deadline,work,phase,sent,rev) => peer_generation }
define gt_peer_runtime(x : G110Slot) = match x { G110Slot(peer_index,peer_generation,peer_runtime,peer_serial,peer_connection,peer_binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt,corr,deadline,work,phase,sent,rev) => peer_runtime }
define gt_peer_serial(x : G110Slot) = match x { G110Slot(peer_index,peer_generation,peer_runtime,peer_serial,peer_connection,peer_binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt,corr,deadline,work,phase,sent,rev) => peer_serial }
define gt_peer_connection(x : G110Slot) = match x { G110Slot(peer_index,peer_generation,peer_runtime,peer_serial,peer_connection,peer_binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt,corr,deadline,work,phase,sent,rev) => peer_connection }
define gt_peer_binding(x : G110Slot) = match x { G110Slot(peer_index,peer_generation,peer_runtime,peer_serial,peer_connection,peer_binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt,corr,deadline,work,phase,sent,rev) => peer_binding }
define gt_req_anchor(x : G110Slot) = match x { G110Slot(peer_index,peer_generation,peer_runtime,peer_serial,peer_connection,peer_binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt,corr,deadline,work,phase,sent,rev) => req_anchor }
define gt_req_installation(x : G110Slot) = match x { G110Slot(peer_index,peer_generation,peer_runtime,peer_serial,peer_connection,peer_binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt,corr,deadline,work,phase,sent,rev) => req_installation }
define gt_req_policy(x : G110Slot) = match x { G110Slot(peer_index,peer_generation,peer_runtime,peer_serial,peer_connection,peer_binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt,corr,deadline,work,phase,sent,rev) => req_policy }
define gt_req_caller(x : G110Slot) = match x { G110Slot(peer_index,peer_generation,peer_runtime,peer_serial,peer_connection,peer_binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt,corr,deadline,work,phase,sent,rev) => req_caller }
define gt_req_incarnation(x : G110Slot) = match x { G110Slot(peer_index,peer_generation,peer_runtime,peer_serial,peer_connection,peer_binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt,corr,deadline,work,phase,sent,rev) => req_incarnation }
define gt_req_sequence(x : G110Slot) = match x { G110Slot(peer_index,peer_generation,peer_runtime,peer_serial,peer_connection,peer_binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt,corr,deadline,work,phase,sent,rev) => req_sequence }
define gt_req_expected(x : G110Slot) = match x { G110Slot(peer_index,peer_generation,peer_runtime,peer_serial,peer_connection,peer_binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt,corr,deadline,work,phase,sent,rev) => req_expected }
define gt_req_kind(x : G110Slot) = match x { G110Slot(peer_index,peer_generation,peer_runtime,peer_serial,peer_connection,peer_binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt,corr,deadline,work,phase,sent,rev) => req_kind }
define gt_req_argument(x : G110Slot) = match x { G110Slot(peer_index,peer_generation,peer_runtime,peer_serial,peer_connection,peer_binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt,corr,deadline,work,phase,sent,rev) => req_argument }
define gt_req_attempt(x : G110Slot) = match x { G110Slot(peer_index,peer_generation,peer_runtime,peer_serial,peer_connection,peer_binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt,corr,deadline,work,phase,sent,rev) => req_attempt }
define gt_corr(x : G110Slot) = match x { G110Slot(peer_index,peer_generation,peer_runtime,peer_serial,peer_connection,peer_binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt,corr,deadline,work,phase,sent,rev) => corr }
define gt_deadline(x : G110Slot) = match x { G110Slot(peer_index,peer_generation,peer_runtime,peer_serial,peer_connection,peer_binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt,corr,deadline,work,phase,sent,rev) => deadline }
define gt_work(x : G110Slot) = match x { G110Slot(peer_index,peer_generation,peer_runtime,peer_serial,peer_connection,peer_binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt,corr,deadline,work,phase,sent,rev) => work }
define gt_phase(x : G110Slot) = match x { G110Slot(peer_index,peer_generation,peer_runtime,peer_serial,peer_connection,peer_binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt,corr,deadline,work,phase,sent,rev) => phase }
define gt_sent(x : G110Slot) = match x { G110Slot(peer_index,peer_generation,peer_runtime,peer_serial,peer_connection,peer_binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt,corr,deadline,work,phase,sent,rev) => sent }
define gt_rev(x : G110Slot) = match x { G110Slot(peer_index,peer_generation,peer_runtime,peer_serial,peer_connection,peer_binding,req_anchor,req_installation,req_policy,req_caller,req_incarnation,req_sequence,req_expected,req_kind,req_argument,req_attempt,corr,deadline,work,phase,sent,rev) => rev }
// A sink is resolved by the transport in the SAME registry. Reject aliases
// from another slot generation, session, binding, authority serial or runtime.
define gt_peer(a : V110Handle,b : V110Handle) =
    (vh_index(a)=vh_index(b)) ∧ (vh_generation(a)=vh_generation(b)) ∧
    (vh_serial(a)=vh_serial(b)) ∧ (vh_runtime(a)=vh_runtime(b)) ∧
    (vh_connection(a)=vh_connection(b)) ∧ (vh_binding(a)=vh_binding(b))
define gt_fixed(x : G110Slot,y : G110Slot) =
    (gt_peer_index(x)=gt_peer_index(y)) ∧
    (gt_peer_generation(x)=gt_peer_generation(y)) ∧
    (gt_peer_runtime(x)=gt_peer_runtime(y)) ∧
    (gt_peer_serial(x)=gt_peer_serial(y)) ∧
    (gt_peer_connection(x)=gt_peer_connection(y)) ∧
    (gt_peer_binding(x)=gt_peer_binding(y)) ∧
    (gt_req_anchor(x)=gt_req_anchor(y)) ∧
    (gt_req_installation(x)=gt_req_installation(y)) ∧
    (gt_req_policy(x)=gt_req_policy(y)) ∧
    (gt_req_caller(x)=gt_req_caller(y)) ∧
    (gt_req_incarnation(x)=gt_req_incarnation(y)) ∧
    (gt_req_sequence(x)=gt_req_sequence(y)) ∧
    (gt_req_expected(x)=gt_req_expected(y)) ∧
    (gt_req_kind(x)=gt_req_kind(y)) ∧
    (gt_req_argument(x)=gt_req_argument(y)) ∧
    (gt_req_attempt(x)=gt_req_attempt(y)) ∧
    a109_nonzero(gt_corr(x)) ∧ (gt_corr(x)=gt_corr(y)) ∧ (gt_deadline(x)=gt_deadline(y))
// This is the E4 obligation at each actual use, not a saved 'authorized' bit.
define gt_guard(x : G110Slot,y : G110Slot,l : V110Lane,k : V110Lane,s : V110Slot,h : V110Handle,j : V110Lease,c : A109Context,i : A109Identity,p : E110Permit,b : E110Binding,o : E110Observation,r : P109Request,a : P109Access) =
    gt_fixed(x,y) ∧ (gt_peer_index(x)=vh_index(h)) ∧ (gt_peer_generation(x)=vh_generation(h)) ∧ (gt_peer_runtime(x)=vh_runtime(h)) ∧ (gt_peer_serial(x)=vh_serial(h)) ∧ (gt_peer_connection(x)=vh_connection(h)) ∧ (gt_peer_binding(x)=vh_binding(h)) ∧ (vl_deadline(l)=gt_deadline(x)) ∧
    (gt_work(x)=vl_remaining(l)) ∧ (gt_work(y)=vl_remaining(k)) ∧
    v110_effect(l,k,s,h,j,c,i,p,b,o,P109Request(gt_req_anchor(x),gt_req_installation(x),gt_req_policy(x),gt_req_caller(x),gt_req_incarnation(x),gt_req_sequence(x),gt_req_expected(x),gt_req_kind(x),gt_req_argument(x),gt_req_attempt(x)),r,a)
// Only a guarded backend return supplies result_rev. This tracks transport
// custody of the reply; T2 determines outcome, exact retries and actual CAS.
define gt_dispatch_shape(x : G110Slot,y : G110Slot,result_rev : BitVec64) =
    (gt_phase(x)=bvconst(0,64)) ∧ (gt_sent(x)=bvconst(0,64)) ∧
    (gt_phase(y)=bvconst(1,64)) ∧ (gt_sent(y)=bvconst(0,64)) ∧ (gt_rev(y)=result_rev)
// A single nonblocking write of bytes [start,start+n); n=0 here models only
// WouldBlock/Interrupted. A real zero write or fatal I/O cancels the slot.
define gt_write_shape(x : G110Slot,y : G110Slot,start : BitVec64,n : BitVec64) =
    (gt_phase(x)=bvconst(1,64)) ∧ (gt_phase(y)=gt_phase(x)) ∧
    (start=gt_sent(x)) ∧ bvult(start,bvconst(144,64)) ∧
    bvule(n,bvsub(bvconst(144,64),start)) ∧ (gt_sent(y)=bvadd(start,n)) ∧ (gt_rev(y)=gt_rev(x))
define gt_dispatch(x : G110Slot,y : G110Slot,result_rev : BitVec64,l : V110Lane,k : V110Lane,s : V110Slot,h : V110Handle,j : V110Lease,c : A109Context,i : A109Identity,p : E110Permit,b : E110Binding,o : E110Observation,r : P109Request,a : P109Access) =
    gt_guard(x,y,l,k,s,h,j,c,i,p,b,o,r,a) ∧ gt_dispatch_shape(x,y,result_rev)
define gt_write(x : G110Slot,y : G110Slot,start : BitVec64,n : BitVec64,l : V110Lane,k : V110Lane,s : V110Slot,h : V110Handle,j : V110Lease,c : A109Context,i : A109Identity,p : E110Permit,b : E110Binding,o : E110Observation,r : P109Request,a : P109Access) =
    gt_guard(x,y,l,k,s,h,j,c,i,p,b,o,r,a) ∧ gt_write_shape(x,y,start,n)

// Release/cancel is local cleanup; it needs the owning ticket, not live
// caller authority. No write or backend operation occurs. Exact-once debit.
define gt_close(x : G110Slot,y : G110Slot,owner : V110Handle,slots : BitVec64,bytes : BitVec64,ns : BitVec64,nb : BitVec64) =
    (gt_peer_index(x)=vh_index(owner)) ∧ (gt_peer_generation(x)=vh_generation(owner)) ∧ (gt_peer_runtime(x)=vh_runtime(owner)) ∧ (gt_peer_serial(x)=vh_serial(owner)) ∧ (gt_peer_connection(x)=vh_connection(owner)) ∧ (gt_peer_binding(x)=vh_binding(owner)) ∧ gt_fixed(x,y) ∧ bvule(gt_phase(x),bvconst(1,64)) ∧
    (gt_phase(y)=bvconst(2,64)) ∧ (gt_rev(y)=gt_rev(x)) ∧ (gt_work(y)=gt_work(x)) ∧
    (gt_sent(y)=gt_sent(x)) ∧ a109_nonzero(slots) ∧ bvule(bvconst(384,64),bytes) ∧
    n110_release(slots,bytes,(bvconst(1,64)=bvconst(1,64)),ns,nb)
// On Busy no authority change or transfer succeeded. The owner retains its
// reservation, position and frozen reply; the outer poll budget still ticks.
define gt_busy(x : G110Slot,y : G110Slot,now : BitVec64) =
    gt_fixed(x,y) ∧ bvule(gt_phase(x),bvconst(1,64)) ∧ (gt_phase(y)=gt_phase(x)) ∧
    (gt_rev(y)=gt_rev(x)) ∧ (gt_sent(y)=gt_sent(x)) ∧
    n110_tick(gt_work(x),now,gt_deadline(x),gt_work(y))

