// ================================================================
// ANKA PROTECTION — EXECUTABLE FORMAL THEORY
// ================================================================
// Security properties are proof obligations (example/assert), not axioms.
// Address model: 24-bit (current 68000 experiment).
// Permissions: R=001, W=010, X=100.
// ================================================================

import "stdlib/prelude.kleis"

// ---- Permission encoding -------------------------------------------------
define perm_R    = bvconst(1, 3)
define perm_W    = bvconst(2, 3)
define perm_X    = bvconst(4, 3)
define perm_RW   = bvor(perm_R, perm_W)
define perm_RX   = bvor(perm_R, perm_X)
define perm_RWX  = bvor(perm_RW, perm_X)
define perm_NONE = bvconst(0, 3)

// A transaction must represent a real access.
define real_request(size : BitVec24, op : BitVec3) =
    bvugt(size, bvconst(0, 24)) ∧ ¬(op = perm_NONE)

// Whole-transaction authority check.
// Subtractive bound check avoids endpoint-addition overflow:
//   addr >= base, size <= len, addr-base <= len-size.
define cap_permits(
    cap_base : BitVec24,
    cap_len  : BitVec24,
    cap_perm : BitVec3,
    addr     : BitVec24,
    size     : BitVec24,
    op       : BitVec3
) =
    real_request(size, op)
    ∧ bvand(cap_perm, op) = op
    ∧ bvuge(addr, cap_base)
    ∧ bvule(size, cap_len)
    ∧ bvule(bvsub(addr, cap_base), bvsub(cap_len, size))

define generation_valid(cap_gen : BitVec16, obj_gen : BitVec16) =
    cap_gen = obj_gen

// Current 68000 protection-controller control plane: 0xF00020..0xF00027.
define in_control_plane(addr : BitVec24) =
    bvuge(addr, bvconst(15728672, 24))
    ∧ bvult(addr, bvconst(15728680, 24))

// Total authorization decision for one transaction.
// Supervisor bypasses ordinary capability checks.
// User mode can never authorize a transaction whose starting address is
// in the protection-controller control plane.
define authorize(
    supervisor : BitVec1,
    cap_base   : BitVec24,
    cap_len    : BitVec24,
    cap_perm   : BitVec3,
    cap_gen    : BitVec16,
    obj_gen    : BitVec16,
    addr       : BitVec24,
    size       : BitVec24,
    op         : BitVec3
) =
    supervisor = bvconst(1, 1)
    ∨ (
        supervisor = bvconst(0, 1)
        ∧ ¬in_control_plane(addr)
        ∧ generation_valid(cap_gen, obj_gen)
        ∧ cap_permits(cap_base, cap_len, cap_perm, addr, size, op)
      )

// ---- Minimal transaction transition model --------------------------------
// We model four observable state components plus fault metadata.
// Authorized transactions may replace state by supplied effect values.
// Denied transactions must preserve all non-fault state.

define next_mem(allowed : BitVec1, before : BitVec32, effect : BitVec32) =
    if allowed = bvconst(1,1) then effect else before

define next_dev(allowed : BitVec1, before : BitVec32, effect : BitVec32) =
    if allowed = bvconst(1,1) then effect else before

define next_obj(allowed : BitVec1, before : BitVec32, effect : BitVec32) =
    if allowed = bvconst(1,1) then effect else before

define next_ctrl(allowed : BitVec1, before : BitVec32, effect : BitVec32) =
    if allowed = bvconst(1,1) then effect else before

define next_fault_count(allowed : BitVec1, before : BitVec32) =
    if allowed = bvconst(1,1) then before else bvadd(before, bvconst(1, 32))

define next_fault_addr(allowed : BitVec1, old_addr : BitVec24, req_addr : BitVec24) =
    if allowed = bvconst(1,1) then old_addr else req_addr

// ===========================================================================
// CORE AUTHORITY PROOFS
// ===========================================================================

example "P1 no authority from an empty capability" {
    assert(
        ∀ addr : BitVec24 . ∀ size : BitVec24 . ∀ op : BitVec3 .
        real_request(size, op)
        → ¬authorize(
            bvconst(0,1),
            bvconst(0,24), bvconst(0,24), perm_NONE,
            bvconst(0,16), bvconst(0,16),
            addr, size, op)
    )
}

example "P2 read authority does not grant write" {
    assert(
        ∀ base : BitVec24 . ∀ len : BitVec24 .
        ∀ addr : BitVec24 . ∀ size : BitVec24 .
        cap_permits(base, len, perm_R, addr, size, perm_R)
        → ¬cap_permits(base, len, perm_R, addr, size, perm_W)
    )
}

example "P3 write authority does not grant execute" {
    assert(
        ∀ base : BitVec24 . ∀ len : BitVec24 .
        ∀ addr : BitVec24 . ∀ size : BitVec24 .
        cap_permits(base, len, perm_W, addr, size, perm_W)
        → ¬cap_permits(base, len, perm_W, addr, size, perm_X)
    )
}

example "P4 stale generation is denied in user mode" {
    assert(
        ∀ base : BitVec24 . ∀ len : BitVec24 . ∀ perms : BitVec3 .
        ∀ addr : BitVec24 . ∀ size : BitVec24 . ∀ op : BitVec3 .
        real_request(size, op)
        → ¬authorize(
            bvconst(0,1), base, len, perms,
            bvconst(0,16), bvconst(1,16),
            addr, size, op)
    )
}

example "P5 supervisor bypasses ordinary authority checks" {
    assert(
        ∀ base : BitVec24 . ∀ len : BitVec24 . ∀ perms : BitVec3 .
        ∀ cg : BitVec16 . ∀ og : BitVec16 .
        ∀ addr : BitVec24 . ∀ size : BitVec24 . ∀ op : BitVec3 .
        authorize(bvconst(1,1), base, len, perms, cg, og, addr, size, op)
    )
}

example "P6 user cannot access protection controller even with RWX capability" {
    assert(
        ∀ addr : BitVec24 . ∀ size : BitVec24 . ∀ op : BitVec3 .
        ∀ base : BitVec24 . ∀ len : BitVec24 .
        ∀ cg : BitVec16 . ∀ og : BitVec16 .
        (in_control_plane(addr) ∧ real_request(size, op))
        → ¬authorize(
            bvconst(0,1), base, len, perm_RWX, cg, og,
            addr, size, op)
    )
}

example "P7 adjacent capabilities cannot stitch a longword" {
    assert(
        ¬cap_permits(
            bvconst(4096,24), bvconst(2,24), perm_RW,
            bvconst(4096,24), bvconst(4,24), perm_R)
        ∧
        ¬cap_permits(
            bvconst(4098,24), bvconst(2,24), perm_RW,
            bvconst(4096,24), bvconst(4,24), perm_R)
    )
}

example "P8 one-past-end byte is denied" {
    assert(
        ∀ base : BitVec24 . ∀ len : BitVec24 . ∀ perms : BitVec3 .
        bvugt(len, bvconst(0,24))
        → ¬cap_permits(
            base, len, perms,
            bvadd(base, len), bvconst(1,24), perm_R)
    )
}

// Permission attenuation: a read-only capability's allowed operations are a
// subset of those allowed by an otherwise identical RW capability.
example "P9 adding permissions cannot remove an allowed read" {
    assert(
        ∀ base : BitVec24 . ∀ len : BitVec24 .
        ∀ addr : BitVec24 . ∀ size : BitVec24 .
        cap_permits(base, len, perm_R, addr, size, perm_R)
        → cap_permits(base, len, perm_RW, addr, size, perm_R)
    )
}

// Spatial attenuation: shrinking a capability to the exact authorized request
// preserves that request, provided the original capability authorized it.
example "P10 exact sub-capability preserves an authorized request" {
    assert(
        ∀ base : BitVec24 . ∀ len : BitVec24 . ∀ perms : BitVec3 .
        ∀ addr : BitVec24 . ∀ size : BitVec24 . ∀ op : BitVec3 .
        cap_permits(base, len, perms, addr, size, op)
        → cap_permits(addr, size, perms, addr, size, op)
    )
}

// ===========================================================================
// REACHABILITY / NON-VACUITY
// ===========================================================================

example "R1 valid user read is reachable" {
    assert(
        authorize(
            bvconst(0,1),
            bvconst(4096,24), bvconst(4096,24), perm_R,
            bvconst(7,16), bvconst(7,16),
            bvconst(4096,24), bvconst(4,24), perm_R)
    )
}

example "R2 valid user write is reachable" {
    assert(
        authorize(
            bvconst(0,1),
            bvconst(8192,24), bvconst(4096,24), perm_RW,
            bvconst(9,16), bvconst(9,16),
            bvconst(8200,24), bvconst(4,24), perm_W)
    )
}

// ===========================================================================
// DENIED-TRANSACTION NONINTERFERENCE
// ===========================================================================

example "N1 denied transaction leaves memory unchanged" {
    assert(
        ∀ mem_before : BitVec32 . ∀ mem_effect : BitVec32 .
        next_mem(bvconst(0,1), mem_before, mem_effect) = mem_before
    )
}

example "N2 denied transaction leaves device state unchanged" {
    assert(
        ∀ dev_before : BitVec32 . ∀ dev_effect : BitVec32 .
        next_dev(bvconst(0,1), dev_before, dev_effect) = dev_before
    )
}

example "N3 denied transaction leaves object table unchanged" {
    assert(
        ∀ obj_before : BitVec32 . ∀ obj_effect : BitVec32 .
        next_obj(bvconst(0,1), obj_before, obj_effect) = obj_before
    )
}

example "N4 denied transaction leaves control state unchanged" {
    assert(
        ∀ ctrl_before : BitVec32 . ∀ ctrl_effect : BitVec32 .
        next_ctrl(bvconst(0,1), ctrl_before, ctrl_effect) = ctrl_before
    )
}

example "N5 denied transaction records exactly one fault" {
    assert(
        ∀ count : BitVec32 .
        next_fault_count(bvconst(0,1), count) = bvadd(count, bvconst(1,32))
    )
}

example "N6 denied transaction records faulting address" {
    assert(
        ∀ old_addr : BitVec24 . ∀ req_addr : BitVec24 .
        next_fault_addr(bvconst(0,1), old_addr, req_addr) = req_addr
    )
}

example "N7 authorized transaction does not create a fault record" {
    assert(
        ∀ count : BitVec32 . ∀ old_addr : BitVec24 . ∀ req_addr : BitVec24 .
        next_fault_count(bvconst(1,1), count) = count
        ∧ next_fault_addr(bvconst(1,1), old_addr, req_addr) = old_addr
    )
}

// End-to-end denied-request theorem: for an actually denied authorization
// decision, all ordinary state is observationally unchanged and only fault
// metadata changes.
example "N8 unauthorized request is observationally inert except fault metadata" {
    assert(
        ∀ supervisor : BitVec1 .
        ∀ base : BitVec24 . ∀ len : BitVec24 . ∀ perms : BitVec3 .
        ∀ cg : BitVec16 . ∀ og : BitVec16 .
        ∀ addr : BitVec24 . ∀ size : BitVec24 . ∀ op : BitVec3 .
        ∀ mem0 : BitVec32 . ∀ mem1 : BitVec32 .
        ∀ dev0 : BitVec32 . ∀ dev1 : BitVec32 .
        ∀ obj0 : BitVec32 . ∀ obj1 : BitVec32 .
        ∀ ctl0 : BitVec32 . ∀ ctl1 : BitVec32 .
        ∀ faults : BitVec32 . ∀ old_fault_addr : BitVec24 .
        (
          ¬authorize(supervisor, base, len, perms, cg, og, addr, size, op)
          →
          (
            next_mem(bvconst(0,1), mem0, mem1) = mem0
            ∧ next_dev(bvconst(0,1), dev0, dev1) = dev0
            ∧ next_obj(bvconst(0,1), obj0, obj1) = obj0
            ∧ next_ctrl(bvconst(0,1), ctl0, ctl1) = ctl0
            ∧ next_fault_count(bvconst(0,1), faults) = bvadd(faults, bvconst(1,32))
            ∧ next_fault_addr(bvconst(0,1), old_fault_addr, addr) = addr
          )
        )
    )
}
