// Complete software cleanup/reuse refinement of the accepted Undertaker.
// Stage 1 queued, 2 retired, 3 scrubbing, 4 clean. Storage remains charged
// through all four stages. No heap DMA, asynchronous scrub engine or guest ABI.
// Each scrub call linearizes submit + terminal completion under ONE exclusive
// Fabric borrow. No callback or effect survives it. If that backend changes,
// explicit pinned scrub requests, drainage and barriers must be refined first.
import "anka108_cleanup_workers.kleis"

// Preserve the queued-only cw108_claim theorem. This new profile additionally
// claims a recovered RETIRED job; recovery resets stages 3/4 to 2 first.
define cr108_claim(bound : Bool, current_worker : Bool, stage : BitVec8,
    attached : BitVec8, queued : BitVec8, lease : BitVec8, epoch : BitVec64,
    worker : BitVec64, revision : BitVec64, expected : BitVec64, locked : BitVec8) =
    current_worker ∧ (attached=bvconst(1,8)) ∧ (queued=bvconst(1,8)) ∧
    ((stage=bvconst(1,8)) ∨ (stage=bvconst(2,8))) ∧
    ut108_claim(bound,stage,lease,epoch,bvconst(0,8),worker,revision,expected,locked)

define cr108_begin(bound : Bool, leased : Bool, stage : BitVec8,
    cpu : BitVec64, dma : BitVec64, maps : BitVec64, grants : BitVec64,
    base : BitVec64, span : BitVec64, custody : BitVec8, visible : BitVec8, locked : BitVec8) =
    (maps=ut108_z()) ∧ (grants=ut108_z()) ∧
    ut108_begin(bound,leased,stage,bvconst(3,8),cpu,dma,ut108_z(),ut108_z(),base,span,custody,visible,locked)

// current means the exact job/lease/version/sequence/progress AND private row
// snapshot match. quiet is derived from full actual source and exclusion scans.
define cr108_chunk(bound : Bool, leased : Bool, current : Bool, stage : BitVec8,
    done : BitVec64, amount : BitVec64, span : BitVec64, version : BitVec64,
    sequence : BitVec64, quiet : Bool, locked : BitVec8) =
    current ∧ quiet ∧ bvule(amount,bvconst(4096,64)) ∧
    ut108_submit(bound,leased,stage,bvconst(0,8),done,amount,span,version,sequence,bvconst(1,8),locked)
define cr108_stage(commit : Bool, done : BitVec64, amount : BitVec64,
    span : BitVec64, old : BitVec8) =
    if commit then (if bvadd(done,amount)=span then bvconst(4,8) else bvconst(3,8)) else old

// No worker effects exist outside the software call. For retired jobs, quiet
// additionally requires zero old CPU work; queued recovery may retain it.
define cr108_recover(bound : Bool, stage : BitVec8, lease : BitVec8,
    fenced : BitVec8, version : BitVec64, quiet : Bool, visible : BitVec8, locked : BitVec8) =
    quiet ∧ ut108_recover(bound,stage,lease,bvconst(0,8),fenced,visible,version,locked)

// Project the exact selected durable obligation to a one-row queue. Global
// directory/charge invariants are inherited, not inferred from caller counts.
// placed means an externally accessible mapping, not reserved private custody.
// tags=0 follows the full contiguous byte/tag prefix and exclusion of writers.
// returns means BOTH exact extent returns prepared before any mutation.
define cr108_release(bound : Bool, leased : Bool, current : Bool, stage : BitVec8,
    done : BitVec64, span : BitVec64, version : BitVec64, receipt : BitVec64,
    quiet : Bool, tags : BitVec64, placed : BitVec8, custody : BitVec8,
    returns : Bool, held : BitVec64, revision : BitVec64, expected : BitVec64, locked : BitVec8) =
    bound ∧ leased ∧ current ∧ quiet ∧ returns ∧ (stage=bvconst(4,8)) ∧
    init108_aligned(span) ∧ bvugt(span,ut108_z()) ∧ (done=span) ∧ (version=receipt) ∧
    (tags=ut108_z()) ∧ (placed=bvconst(0,8)) ∧ heap108_yes(custody) ∧ bvule(span,held) ∧
    (revision=expected) ∧ heap108_yes(locked)
// Cleanup consumes no identity at release. Unlike new admission, it may run at
// saturated common revision, provided all checks/commit share one exclusive
// operation and the complete snapshot is current. This extends ut108_release's
// revision precondition; it does NOT reset revision or accept a cached permit.

example "claim: valid" {
    assert(cr108_claim(ut108_true(),ut108_true(),bvconst(2,8),bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(7,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(1,8)))
}

example "claim: queued compatibility" {
    assert(cr108_claim(ut108_true(),ut108_true(),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(7,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(1,8)))
}

example "claim: last epoch" {
    assert(cr108_claim(ut108_true(),ut108_true(),bvconst(2,8),bvconst(1,8),bvconst(1,8),bvconst(0,8),bvsub(ptr107_max(),bvconst(1,64)),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(1,8)))
}

example "claim: rejects unbound" {
    assert(¬(cr108_claim(ut108_false(),ut108_true(),bvconst(2,8),bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(7,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(1,8))))
}

example "claim: rejects stale worker" {
