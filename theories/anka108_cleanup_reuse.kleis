}

example "release: rejects partial prefix" {
    assert(¬(cr108_release(ut108_true(),ut108_true(),ut108_true(),bvconst(4,8),bvconst(4096,64),bvconst(8192,64),bvconst(9,64),bvconst(9,64),ut108_true(),bvconst(0,64),bvconst(0,8),bvconst(1,8),ut108_true(),bvconst(16384,64),bvconst(9,64),bvconst(9,64),bvconst(1,8))))
}

example "release: rejects stale version" {
    assert(¬(cr108_release(ut108_true(),ut108_true(),ut108_true(),bvconst(4,8),bvconst(8192,64),bvconst(8192,64),bvconst(9,64),bvconst(8,64),ut108_true(),bvconst(0,64),bvconst(0,8),bvconst(1,8),ut108_true(),bvconst(16384,64),bvconst(9,64),bvconst(9,64),bvconst(1,8))))
}

example "release: rejects conflicting work" {
    assert(¬(cr108_release(ut108_true(),ut108_true(),ut108_true(),bvconst(4,8),bvconst(8192,64),bvconst(8192,64),bvconst(9,64),bvconst(9,64),ut108_false(),bvconst(0,64),bvconst(0,8),bvconst(1,8),ut108_true(),bvconst(16384,64),bvconst(9,64),bvconst(9,64),bvconst(1,8))))
}

example "release: rejects old tag" {
    assert(¬(cr108_release(ut108_true(),ut108_true(),ut108_true(),bvconst(4,8),bvconst(8192,64),bvconst(8192,64),bvconst(9,64),bvconst(9,64),ut108_true(),bvconst(1,64),bvconst(0,8),bvconst(1,8),ut108_true(),bvconst(16384,64),bvconst(9,64),bvconst(9,64),bvconst(1,8))))
}

example "release: rejects legacy placement" {
    assert(¬(cr108_release(ut108_true(),ut108_true(),ut108_true(),bvconst(4,8),bvconst(8192,64),bvconst(8192,64),bvconst(9,64),bvconst(9,64),ut108_true(),bvconst(0,64),bvconst(1,8),bvconst(1,8),ut108_true(),bvconst(16384,64),bvconst(9,64),bvconst(9,64),bvconst(1,8))))
}

example "release: rejects lost custody" {
    assert(¬(cr108_release(ut108_true(),ut108_true(),ut108_true(),bvconst(4,8),bvconst(8192,64),bvconst(8192,64),bvconst(9,64),bvconst(9,64),ut108_true(),bvconst(0,64),bvconst(0,8),bvconst(0,8),ut108_true(),bvconst(16384,64),bvconst(9,64),bvconst(9,64),bvconst(1,8))))
}

example "release: rejects unprepared return" {
    assert(¬(cr108_release(ut108_true(),ut108_true(),ut108_true(),bvconst(4,8),bvconst(8192,64),bvconst(8192,64),bvconst(9,64),bvconst(9,64),ut108_true(),bvconst(0,64),bvconst(0,8),bvconst(1,8),ut108_false(),bvconst(16384,64),bvconst(9,64),bvconst(9,64),bvconst(1,8))))
}

example "release: rejects refund underflow" {
    assert(¬(cr108_release(ut108_true(),ut108_true(),ut108_true(),bvconst(4,8),bvconst(8192,64),bvconst(8192,64),bvconst(9,64),bvconst(9,64),ut108_true(),bvconst(0,64),bvconst(0,8),bvconst(1,8),ut108_true(),bvconst(4096,64),bvconst(9,64),bvconst(9,64),bvconst(1,8))))
}

example "release: rejects wrong revision" {
    assert(¬(cr108_release(ut108_true(),ut108_true(),ut108_true(),bvconst(4,8),bvconst(8192,64),bvconst(8192,64),bvconst(9,64),bvconst(9,64),ut108_true(),bvconst(0,64),bvconst(0,8),bvconst(1,8),ut108_true(),bvconst(16384,64),bvconst(9,64),bvconst(8,64),bvconst(1,8))))
}

example "release: rejects empty span" {
    assert(¬(cr108_release(ut108_true(),ut108_true(),ut108_true(),bvconst(4,8),bvconst(0,64),bvconst(0,64),bvconst(9,64),bvconst(9,64),ut108_true(),bvconst(0,64),bvconst(0,8),bvconst(1,8),ut108_true(),bvconst(16384,64),bvconst(9,64),bvconst(9,64),bvconst(1,8))))
}

example "release: rejects unlocked" {
    assert(¬(cr108_release(ut108_true(),ut108_true(),ut108_true(),bvconst(4,8),bvconst(8192,64),bvconst(8192,64),bvconst(9,64),bvconst(9,64),ut108_true(),bvconst(0,64),bvconst(0,8),bvconst(1,8),ut108_true(),bvconst(16384,64),bvconst(9,64),bvconst(9,64),bvconst(0,8))))
}

example "law: release below saturation refines Undertaker" {
    assert(∀(r : BitVec64). (cr108_release(ut108_true(),ut108_true(),ut108_true(),bvconst(4,8),bvconst(8192,64),bvconst(8192,64),bvconst(9,64),bvconst(9,64),ut108_true(),bvconst(0,64),bvconst(0,8),bvconst(1,8),ut108_true(),bvconst(16384,64),r,r,bvconst(1,8)) ∧ bvult(r,ptr107_max()) → ut108_release(ut108_true(),ut108_true(),bvconst(4,8),bvconst(3,8),bvconst(0,8),bvconst(8192,64),bvconst(8192,64),bvconst(9,64),bvconst(9,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,64),bvconst(0,64),bvconst(1,64),bvconst(16384,64),bvconst(8192,64),r,r,bvconst(1,8))))
}

example "law: claim refines accepted Undertaker" {
    assert(∀(s : BitVec8). ∀(e : BitVec64). (cr108_claim(ut108_true(),ut108_true(),s,bvconst(1,8),bvconst(1,8),bvconst(0,8),e,bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(1,8)) → ut108_claim(ut108_true(),s,bvconst(0,8),e,bvconst(0,8),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(1,8))))
}

example "law: chunk admits real terminal completion" {
    assert(∀(d : BitVec64). ∀(n : BitVec64). ∀(v : BitVec64). (cr108_chunk(ut108_true(),ut108_true(),ut108_true(),bvconst(3,8),d,n,bvconst(8192,64),v,bvconst(3,64),ut108_true(),bvconst(1,8)) → ut108_complete(ut108_true(),ut108_true(),bvconst(3,8),bvconst(1,8),d,d,n,bvconst(8192,64),v,v,bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8))))
}

example "law: cursor cannot overflow or leave custody" {
    assert(∀(d : BitVec64). ∀(n : BitVec64). ∀(s : BitVec64). (cr108_chunk(ut108_true(),ut108_true(),ut108_true(),bvconst(3,8),d,n,s,bvconst(1,64),bvconst(1,64),ut108_true(),bvconst(1,8)) → (bvugt(bvadd(d,n),d) ∧ bvule(bvadd(d,n),s))))
}

example "law: final chunk establishes clean gate" {
    assert(∀(d : BitVec64). ∀(n : BitVec64). (cr108_chunk(ut108_true(),ut108_true(),ut108_true(),bvconst(3,8),d,n,bvconst(8192,64),bvconst(7,64),bvconst(3,64),ut108_true(),bvconst(1,8)) ∧ (bvadd(d,n)=bvconst(8192,64)) → ut108_clean(ut108_true(),ut108_true(),bvconst(3,8),bvconst(0,8),bvadd(d,n),bvconst(8192,64),bvconst(8,64),bvconst(8,64),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8),bvconst(1,8))))
}

example "law: committed bytes zero within chunk" {
    assert(∀(q : BitVec64). ∀(old : BitVec8). ((bvuge(q,bvconst(4096,64)) ∧ bvult(q,bvconst(8192,64))) → (init108_byte(ut108_true(),bvconst(4096,64),bvconst(4096,64),q,old)=bvconst(0,8))))
}

example "law: other allocation bytes unchanged" {
    assert(∀(q : BitVec64). ∀(old : BitVec8). (bvuge(q,bvconst(8192,64)) → (init108_byte(ut108_true(),bvconst(4096,64),bvconst(4096,64),q,old)=old)))
}

example "law: tag cleared by exact overlapping chunk" {
    assert(∀(old : BitVec8). (init108_tag(ut108_true(),bvconst(8192,64),bvconst(4096,64),bvconst(4096,64),bvconst(12288,64),old)=bvconst(0,8)))
}

example "law: failure preserves bytes cursor stage" {
    assert(∀(q : BitVec64). ∀(old : BitVec8). ∀(d : BitVec64). ((init108_byte(ut108_false(),d,bvconst(4096,64),q,old)=old) ∧ (init108_done(ut108_false(),d,bvconst(4096,64))=d) ∧ (cr108_stage(ut108_false(),d,bvconst(4096,64),bvconst(8192,64),bvconst(3,8))=bvconst(3,8))))
}

example "law: scrub and clean recovery restart retired at zero" {
    assert(∀(s : BitVec8). ∀(d : BitVec64). (((s=bvconst(3,8)) ∨ (s=bvconst(4,8))) → ((ut108_recovered_stage(ut108_true(),s)=bvconst(2,8)) ∧ (ut108_recovered_done(ut108_true(),d)=bvconst(0,64)))))
}

example "law: exact refund leaves other charge" {
    assert(∀(other : BitVec64). (bvule(other,bvsub(ptr107_max(),bvconst(8192,64))) → (ut108_payload(ut108_true(),bvadd(other,bvconst(8192,64)),bvconst(8192,64))=other)))
}

example "law: failed release refunds nothing" {
    assert(∀(p : BitVec64). (ut108_payload(ut108_false(),p,bvconst(8192,64))=p))
}

example "law: returned storage needs fresh lifetime initialization" {
    assert(¬ut108_new_lifetime(ut108_true(),ut108_false(),ut108_true(),ut108_true(),bvconst(31,64),bvconst(4096,64),bvconst(4096,64)))
}

