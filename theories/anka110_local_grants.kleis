define lg110_integrity(x : LG110State, wall : BitVec64, tick : BitVec64) =
    (((((((((kc110_nz(lgs_domain(x)) ∧ kc110_nz(lgs_incarnation(x))) ∧ kc110_nz(lgs_grant_id(x))) ∧ kc110_nz(lgs_revision(x))) ∧ kc110_nz(lgs_sequence(x))) ∧ bvult(lgs_sequence(x),a109_max())) ∧ bvule(lgs_remaining(x),bvconst(512,64))) ∧ bvule(lgs_mode(x),bvconst(3,64))) ∧ bvule(lgs_last_wall(x),wall)) ∧ bvule(lgs_last_tick(x),tick))


define lg110_usable(x : LG110State, wall : BitVec64, tick : BitVec64) =
    (((lg110_integrity(x,wall,tick) ∧ lg110_live_mode(x)) ∧ kc110_nz(lgs_remaining(x))) ∧ bvult(tick,lgs_deadline(x)))


