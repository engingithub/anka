// LG110: external identity observations support locally controlled grants.
// No new axioms. No Keycloak administration, policy inspection or remote fencing.
// This is an explicit alternative to KC110 ready/SA110 all-writers control, not
// an implementation of those predicates. Reuse KC110 identity/scope checks only.
// Trusted verdicts authenticate entire records and actual channel/holder binding;
// they are never supplied by an untrusted peer. Opaque IDs are collision-free
// equality handles, NOT truncated hashes, nonces or a cryptography proof.
// State is uniquely owned local state. Every transition and guarded submission
// is atomic locally. Remote IO happens between begin and complete, outside guard.
// One grant/token per bounded operation; token replacement requires a separate
// explicit admission contract. Revoked/poisoned grants NEVER reopen here.
// Wall seconds and monotonic ticks are independently trusted, sampled together;
// no conversion or skew allowance. Expiry checks use wall time; evidence age and
// operation deadline use ticks. Backwards samples poison; equal samples are OK.
// Modes: 0 unissued, 1 issued, 2 revoked, 3 poisoned. Boot is always framed.
import "anka110_keycloak_adapter.kleis"


// Product records are flattened for the Kleis/Z3 boundary. Prefixes retain the
// original token/status/mapping/config/scope names; no identity or scope field is omitted.

data LG110Evidence = LG110Evidence(token_reference : BitVec64, token_issuer : BitVec64, token_audience : BitVec64, token_client : BitVec64, token_subject : BitVec64, token_holder : BitVec64, token_keyset : BitVec64, token_profile : BitVec64, token_issued : BitVec64, token_first : BitVec64, token_until : BitVec64, token_syntax : A109Verdict, token_signature : A109Verdict, status_token : BitVec64, status_issuer : BitVec64, status_query : BitVec64, status_started : BitVec64, status_observed : BitVec64, status_checked : A109Verdict, status_active : A109Verdict, mapping_issuer : BitVec64, mapping_subject : BitVec64, mapping_client : BitVec64, mapping_installation : BitVec64, mapping_peer : BitVec64, mapping_kind : BitVec64, mapping_policy : BitVec64, mapping_enabled : A109Verdict, bytes : BitVec64)

