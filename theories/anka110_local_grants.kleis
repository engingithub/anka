// Atomic local before/after relation; neither record is a caller-restorable snapshot.
define lg110_attempt(x : LG110State, u : LG110Use, wall : BitVec64, tick : BitVec64, channel : A109Verdict, existing_gate : Bool, after : LG110State) =
    ((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((lgs_domain(after) = lgs_domain(x)) ∧ (lgs_incarnation(after) = lgs_incarnation(x))) ∧ (lgs_grant_id(after) = lgs_grant_id(x))) ∧ (lgs_revision(after) = lgs_revision(x))) ∧ (lgs_deadline(after) = lgs_deadline(x))) ∧ (lgs_boot(after) = lgs_boot(x))) ∧ (lgs_config_issuer(after) = lgs_config_issuer(x))) ∧ (lgs_config_audience(after) = lgs_config_audience(x))) ∧ (lgs_config_client(after) = lgs_config_client(x))) ∧ (lgs_config_installation(after) = lgs_config_installation(x))) ∧ (lgs_config_policy(after) = lgs_config_policy(x))) ∧ (lgs_config_keyset(after) = lgs_config_keyset(x))) ∧ (lgs_config_profile(after) = lgs_config_profile(x))) ∧ (lgs_config_max_age(after) = lgs_config_max_age(x))) ∧ (lgs_config_max_bytes(after) = lgs_config_max_bytes(x))) ∧ (lgs_config_selected(after) = lgs_config_selected(x))) ∧ (lgs_scope_installation(after) = lgs_scope_installation(x))) ∧ (lgs_scope_policy(after) = lgs_scope_policy(x))) ∧ (lgs_scope_peer(after) = lgs_scope_peer(x))) ∧ (lgs_scope_kind(after) = lgs_scope_kind(x))) ∧ (lgs_scope_artifact(after) = lgs_scope_artifact(x))) ∧ (lgs_scope_generation(after) = lgs_scope_generation(x))) ∧ (lgs_scope_request(after) = lgs_scope_request(x))) ∧ (lgs_scope_operation(after) = lgs_scope_operation(x))) ∧ (lgs_scope_role(after) = lgs_scope_role(x))) ∧ (lgs_scope_runtime(after) = lgs_scope_runtime(x))) ∧ (lgs_scope_connection(after) = lgs_scope_connection(x))) ∧ (lgs_scope_binding(after) = lgs_scope_binding(x))) ∧ (lgs_scope_local(after) = lgs_scope_local(x))) ∧ (lgs_scope_incarnation(after) = lgs_scope_incarnation(x))) ∧ (lgs_scope_serial(after) = lgs_scope_serial(x))) ∧ (lgs_scope_challenge(after) = lgs_scope_challenge(x))) ∧ (lgs_grant_token(after) = lgs_grant_token(x))) ∧ (lgs_grant_scope_installation(after) = lgs_grant_scope_installation(x))) ∧ (lgs_grant_scope_policy(after) = lgs_grant_scope_policy(x))) ∧ (lgs_grant_scope_peer(after) = lgs_grant_scope_peer(x))) ∧ (lgs_grant_scope_kind(after) = lgs_grant_scope_kind(x))) ∧ (lgs_grant_scope_artifact(after) = lgs_grant_scope_artifact(x))) ∧ (lgs_grant_scope_generation(after) = lgs_grant_scope_generation(x))) ∧ (lgs_grant_scope_request(after) = lgs_grant_scope_request(x))) ∧ (lgs_grant_scope_operation(after) = lgs_grant_scope_operation(x))) ∧ (lgs_grant_scope_role(after) = lgs_grant_scope_role(x))) ∧ (lgs_grant_scope_runtime(after) = lgs_grant_scope_runtime(x))) ∧ (lgs_grant_scope_connection(after) = lgs_grant_scope_connection(x))) ∧ (lgs_grant_scope_binding(after) = lgs_grant_scope_binding(x))) ∧ (lgs_grant_scope_local(after) = lgs_grant_scope_local(x))) ∧ (lgs_grant_scope_incarnation(after) = lgs_grant_scope_incarnation(x))) ∧ (lgs_grant_scope_serial(after) = lgs_grant_scope_serial(x))) ∧ (lgs_grant_scope_challenge(after) = lgs_grant_scope_challenge(x))) ∧ (lgs_grant_first(after) = lgs_grant_first(x))) ∧ (lgs_grant_until(after) = lgs_grant_until(x))) ∧ (lgs_grant_permission(after) = lgs_grant_permission(x))) ∧ (lgs_evidence_token_reference(after) = lgs_evidence_token_reference(x))) ∧ (lgs_evidence_token_issuer(after) = lgs_evidence_token_issuer(x))) ∧ (lgs_evidence_token_audience(after) = lgs_evidence_token_audience(x))) ∧ (lgs_evidence_token_client(after) = lgs_evidence_token_client(x))) ∧ (lgs_evidence_token_subject(after) = lgs_evidence_token_subject(x))) ∧ (lgs_evidence_token_holder(after) = lgs_evidence_token_holder(x))) ∧ (lgs_evidence_token_keyset(after) = lgs_evidence_token_keyset(x))) ∧ (lgs_evidence_token_profile(after) = lgs_evidence_token_profile(x))) ∧ (lgs_evidence_token_issued(after) = lgs_evidence_token_issued(x))) ∧ (lgs_evidence_token_first(after) = lgs_evidence_token_first(x))) ∧ (lgs_evidence_token_until(after) = lgs_evidence_token_until(x))) ∧ (lgs_evidence_token_syntax(after) = lgs_evidence_token_syntax(x))) ∧ (lgs_evidence_token_signature(after) = lgs_evidence_token_signature(x))) ∧ (lgs_evidence_status_token(after) = lgs_evidence_status_token(x))) ∧ (lgs_evidence_status_issuer(after) = lgs_evidence_status_issuer(x))) ∧ (lgs_evidence_status_query(after) = lgs_evidence_status_query(x))) ∧ (lgs_evidence_status_started(after) = lgs_evidence_status_started(x))) ∧ (lgs_evidence_status_observed(after) = lgs_evidence_status_observed(x))) ∧ (lgs_evidence_status_checked(after) = lgs_evidence_status_checked(x))) ∧ (lgs_evidence_status_active(after) = lgs_evidence_status_active(x))) ∧ (lgs_evidence_mapping_issuer(after) = lgs_evidence_mapping_issuer(x))) ∧ (lgs_evidence_mapping_subject(after) = lgs_evidence_mapping_subject(x))) ∧ (lgs_evidence_mapping_client(after) = lgs_evidence_mapping_client(x))) ∧ (lgs_evidence_mapping_installation(after) = lgs_evidence_mapping_installation(x))) ∧ (lgs_evidence_mapping_peer(after) = lgs_evidence_mapping_peer(x))) ∧ (lgs_evidence_mapping_kind(after) = lgs_evidence_mapping_kind(x))) ∧ (lgs_evidence_mapping_policy(after) = lgs_evidence_mapping_policy(x))) ∧ (lgs_evidence_mapping_enabled(after) = lgs_evidence_mapping_enabled(x))) ∧ (lgs_evidence_bytes(after) = lgs_evidence_bytes(x))) ∧ (lgs_pending(after) = lgs_pending(x))) ∧ (lgs_started(after) = lgs_started(x))) ∧ (lgs_pending_revision(after) = lgs_pending_revision(x))) ∧ (if (kc110_nz(lgs_sequence(x)) ∧ bvult(lgs_sequence(x),a109_max())) then (lgs_sequence(after) = bvadd(lgs_sequence(x),bvconst(1,64))) else (lgs_sequence(after) = lgs_sequence(x)))) ∧ (if kc110_nz(lgs_remaining(x)) then (lgs_remaining(after) = bvsub(lgs_remaining(x),bvconst(1,64))) else (lgs_remaining(after) = bvconst(0,64)))) ∧ (if bvule(lgs_last_tick(x),tick) then (lgs_last_tick(after) = tick) else (lgs_last_tick(after) = lgs_last_tick(x)))) ∧ (if bvule(lgs_last_wall(x),wall) then (lgs_last_wall(after) = wall) else (lgs_last_wall(after) = lgs_last_wall(x)))) ∧ (if lg110_allow(x,u,wall,tick,channel,existing_gate) then (lgs_effects(after) = bvadd(lgs_effects(x),bvconst(1,64))) else (lgs_effects(after) = lgs_effects(x)))) ∧ (if (lgs_effects(x) = a109_max()) then (lgs_mode(after) = bvconst(3,64)) else (if lg110_integrity(x,wall,tick) then (lgs_mode(after) = lgs_mode(x)) else (lgs_mode(after) = bvconst(3,64)))))


define lg110_can_begin(x : LG110State, wall : BitVec64, tick : BitVec64) =
    ((lg110_usable(x,wall,tick) ∧ (lgs_pending(x) = bvconst(0,64))) ∧ kc110_config(KC110Config(lgs_config_issuer(x),lgs_config_audience(x),lgs_config_client(x),lgs_config_installation(x),lgs_config_policy(x),lgs_config_keyset(x),lgs_config_profile(x),lgs_config_max_age(x),lgs_config_max_bytes(x),lgs_config_selected(x))))


// Atomic local before/after relation; neither record is a caller-restorable snapshot.
define lg110_begin(x : LG110State, wall : BitVec64, tick : BitVec64, after : LG110State) =
    ((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((lgs_domain(after) = lgs_domain(x)) ∧ (lgs_incarnation(after) = lgs_incarnation(x))) ∧ (lgs_grant_id(after) = lgs_grant_id(x))) ∧ (lgs_revision(after) = lgs_revision(x))) ∧ (lgs_deadline(after) = lgs_deadline(x))) ∧ (lgs_effects(after) = lgs_effects(x))) ∧ (lgs_boot(after) = lgs_boot(x))) ∧ (lgs_config_issuer(after) = lgs_config_issuer(x))) ∧ (lgs_config_audience(after) = lgs_config_audience(x))) ∧ (lgs_config_client(after) = lgs_config_client(x))) ∧ (lgs_config_installation(after) = lgs_config_installation(x))) ∧ (lgs_config_policy(after) = lgs_config_policy(x))) ∧ (lgs_config_keyset(after) = lgs_config_keyset(x))) ∧ (lgs_config_profile(after) = lgs_config_profile(x))) ∧ (lgs_config_max_age(after) = lgs_config_max_age(x))) ∧ (lgs_config_max_bytes(after) = lgs_config_max_bytes(x))) ∧ (lgs_config_selected(after) = lgs_config_selected(x))) ∧ (lgs_scope_installation(after) = lgs_scope_installation(x))) ∧ (lgs_scope_policy(after) = lgs_scope_policy(x))) ∧ (lgs_scope_peer(after) = lgs_scope_peer(x))) ∧ (lgs_scope_kind(after) = lgs_scope_kind(x))) ∧ (lgs_scope_artifact(after) = lgs_scope_artifact(x))) ∧ (lgs_scope_generation(after) = lgs_scope_generation(x))) ∧ (lgs_scope_request(after) = lgs_scope_request(x))) ∧ (lgs_scope_operation(after) = lgs_scope_operation(x))) ∧ (lgs_scope_role(after) = lgs_scope_role(x))) ∧ (lgs_scope_runtime(after) = lgs_scope_runtime(x))) ∧ (lgs_scope_connection(after) = lgs_scope_connection(x))) ∧ (lgs_scope_binding(after) = lgs_scope_binding(x))) ∧ (lgs_scope_local(after) = lgs_scope_local(x))) ∧ (lgs_scope_incarnation(after) = lgs_scope_incarnation(x))) ∧ (lgs_scope_serial(after) = lgs_scope_serial(x))) ∧ (lgs_scope_challenge(after) = lgs_scope_challenge(x))) ∧ (lgs_grant_token(after) = lgs_grant_token(x))) ∧ (lgs_grant_scope_installation(after) = lgs_grant_scope_installation(x))) ∧ (lgs_grant_scope_policy(after) = lgs_grant_scope_policy(x))) ∧ (lgs_grant_scope_peer(after) = lgs_grant_scope_peer(x))) ∧ (lgs_grant_scope_kind(after) = lgs_grant_scope_kind(x))) ∧ (lgs_grant_scope_artifact(after) = lgs_grant_scope_artifact(x))) ∧ (lgs_grant_scope_generation(after) = lgs_grant_scope_generation(x))) ∧ (lgs_grant_scope_request(after) = lgs_grant_scope_request(x))) ∧ (lgs_grant_scope_operation(after) = lgs_grant_scope_operation(x))) ∧ (lgs_grant_scope_role(after) = lgs_grant_scope_role(x))) ∧ (lgs_grant_scope_runtime(after) = lgs_grant_scope_runtime(x))) ∧ (lgs_grant_scope_connection(after) = lgs_grant_scope_connection(x))) ∧ (lgs_grant_scope_binding(after) = lgs_grant_scope_binding(x))) ∧ (lgs_grant_scope_local(after) = lgs_grant_scope_local(x))) ∧ (lgs_grant_scope_incarnation(after) = lgs_grant_scope_incarnation(x))) ∧ (lgs_grant_scope_serial(after) = lgs_grant_scope_serial(x))) ∧ (lgs_grant_scope_challenge(after) = lgs_grant_scope_challenge(x))) ∧ (lgs_grant_first(after) = lgs_grant_first(x))) ∧ (lgs_grant_until(after) = lgs_grant_until(x))) ∧ (lgs_grant_permission(after) = lgs_grant_permission(x))) ∧ (lgs_evidence_token_reference(after) = lgs_evidence_token_reference(x))) ∧ (lgs_evidence_token_issuer(after) = lgs_evidence_token_issuer(x))) ∧ (lgs_evidence_token_audience(after) = lgs_evidence_token_audience(x))) ∧ (lgs_evidence_token_client(after) = lgs_evidence_token_client(x))) ∧ (lgs_evidence_token_subject(after) = lgs_evidence_token_subject(x))) ∧ (lgs_evidence_token_holder(after) = lgs_evidence_token_holder(x))) ∧ (lgs_evidence_token_keyset(after) = lgs_evidence_token_keyset(x))) ∧ (lgs_evidence_token_profile(after) = lgs_evidence_token_profile(x))) ∧ (lgs_evidence_token_issued(after) = lgs_evidence_token_issued(x))) ∧ (lgs_evidence_token_first(after) = lgs_evidence_token_first(x))) ∧ (lgs_evidence_token_until(after) = lgs_evidence_token_until(x))) ∧ (lgs_evidence_token_syntax(after) = lgs_evidence_token_syntax(x))) ∧ (lgs_evidence_token_signature(after) = lgs_evidence_token_signature(x))) ∧ (lgs_evidence_status_token(after) = lgs_evidence_status_token(x))) ∧ (lgs_evidence_status_issuer(after) = lgs_evidence_status_issuer(x))) ∧ (lgs_evidence_status_query(after) = lgs_evidence_status_query(x))) ∧ (lgs_evidence_status_started(after) = lgs_evidence_status_started(x))) ∧ (lgs_evidence_status_observed(after) = lgs_evidence_status_observed(x))) ∧ (lgs_evidence_status_checked(after) = lgs_evidence_status_checked(x))) ∧ (lgs_evidence_status_active(after) = lgs_evidence_status_active(x))) ∧ (lgs_evidence_mapping_issuer(after) = lgs_evidence_mapping_issuer(x))) ∧ (lgs_evidence_mapping_subject(after) = lgs_evidence_mapping_subject(x))) ∧ (lgs_evidence_mapping_client(after) = lgs_evidence_mapping_client(x))) ∧ (lgs_evidence_mapping_installation(after) = lgs_evidence_mapping_installation(x))) ∧ (lgs_evidence_mapping_peer(after) = lgs_evidence_mapping_peer(x))) ∧ (lgs_evidence_mapping_kind(after) = lgs_evidence_mapping_kind(x))) ∧ (lgs_evidence_mapping_policy(after) = lgs_evidence_mapping_policy(x))) ∧ (lgs_evidence_mapping_enabled(after) = lgs_evidence_mapping_enabled(x))) ∧ (lgs_evidence_bytes(after) = lgs_evidence_bytes(x))) ∧ (if (kc110_nz(lgs_sequence(x)) ∧ bvult(lgs_sequence(x),a109_max())) then (lgs_sequence(after) = bvadd(lgs_sequence(x),bvconst(1,64))) else (lgs_sequence(after) = lgs_sequence(x)))) ∧ (if kc110_nz(lgs_remaining(x)) then (lgs_remaining(after) = bvsub(lgs_remaining(x),bvconst(1,64))) else (lgs_remaining(after) = bvconst(0,64)))) ∧ (if bvule(lgs_last_tick(x),tick) then (lgs_last_tick(after) = tick) else (lgs_last_tick(after) = lgs_last_tick(x)))) ∧ (if bvule(lgs_last_wall(x),wall) then (lgs_last_wall(after) = wall) else (lgs_last_wall(after) = lgs_last_wall(x)))) ∧ (if lg110_integrity(x,wall,tick) then (lgs_mode(after) = lgs_mode(x)) else (lgs_mode(after) = bvconst(3,64)))) ∧ (if lg110_can_begin(x,wall,tick) then (((lgs_pending(after) = lgs_sequence(x)) ∧ (lgs_started(after) = tick)) ∧ (lgs_pending_revision(after) = lgs_revision(x))) else (((lgs_pending(after) = lgs_pending(x)) ∧ (lgs_started(after) = lgs_started(x))) ∧ (lgs_pending_revision(after) = lgs_pending_revision(x)))))


define lg110_reply_bound(x : LG110State, r : LG110Reply) =
    (((((((((((lgr_checked(r) = A109Valid) ∧ kc110_nz(lgs_pending(x))) ∧ (lgr_domain(r) = lgs_domain(x))) ∧ (lgr_incarnation(r) = lgs_incarnation(x))) ∧ (lgr_grant_id(r) = lgs_grant_id(x))) ∧ (lgr_revision(r) = lgs_revision(x))) ∧ (lgr_revision(r) = lgs_pending_revision(x))) ∧ (lgr_query(r) = lgs_pending(x))) ∧ (lgr_started(r) = lgs_started(x))) ∧ (lgr_token(r) = lgs_grant_token(x))) ∧ (lgr_issuer(r) = lgs_config_issuer(x)))


define lg110_accept(x : LG110State, r : LG110Reply, wall : BitVec64, tick : BitVec64) =
    ((((lg110_usable(x,wall,tick) ∧ lg110_reply_bound(x,r)) ∧ (lgr_result(r) = A109Valid)) ∧ (lgr_evidence_status_started(r) = lgs_started(x))) ∧ lg110_identity(x,LG110Evidence(lgr_evidence_token_reference(r),lgr_evidence_token_issuer(r),lgr_evidence_token_audience(r),lgr_evidence_token_client(r),lgr_evidence_token_subject(r),lgr_evidence_token_holder(r),lgr_evidence_token_keyset(r),lgr_evidence_token_profile(r),lgr_evidence_token_issued(r),lgr_evidence_token_first(r),lgr_evidence_token_until(r),lgr_evidence_token_syntax(r),lgr_evidence_token_signature(r),lgr_evidence_status_token(r),lgr_evidence_status_issuer(r),lgr_evidence_status_query(r),lgr_evidence_status_started(r),lgr_evidence_status_observed(r),lgr_evidence_status_checked(r),lgr_evidence_status_active(r),lgr_evidence_mapping_issuer(r),lgr_evidence_mapping_subject(r),lgr_evidence_mapping_client(r),lgr_evidence_mapping_installation(r),lgr_evidence_mapping_peer(r),lgr_evidence_mapping_kind(r),lgr_evidence_mapping_policy(r),lgr_evidence_mapping_enabled(r),lgr_evidence_bytes(r)),lgs_pending(x),wall,tick))


define lg110_negative(x : LG110State, r : LG110Reply) =
    (lg110_reply_bound(x,r) ∧ (lgr_result(r) = A109Invalid))


// Atomic local before/after relation; neither record is a caller-restorable snapshot.
define lg110_complete(x : LG110State, r : LG110Reply, wall : BitVec64, tick : BitVec64, after : LG110State) =
