example "META107-33 metadata exact transport" {
    assert(ptr107_transport(bvconst(7,64),bvconst(2,64),bvconst(0,64),bvconst(16,64),bvconst(8,64),bvconst(1,64),bvconst(7,64),bvconst(2,64),bvconst(0,64),bvconst(16,64),bvconst(8,64),bvconst(1,64)))
