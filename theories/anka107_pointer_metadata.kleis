example "META107-28 wrapped product" {
    assert(¬(ptr107_step(bvconst(0,64),bvconst(16,64),bvconst(0,64),bvconst(32,64),bvconst(2305843009213693952,64),bvconst(8,64),bvconst(0,64))))
