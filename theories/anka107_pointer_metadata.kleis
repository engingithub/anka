example "META107-54 write only byte store" {
    assert(ptr107_access(bvconst(7,64),bvconst(2,64),bvconst(7,64),bvconst(2,64),bvconst(1,8),bvconst(1,8),bvconst(4096,64),bvconst(32,64),bvconst(0,64),bvconst(16,64),bvconst(15,64),bvconst(1,64),bvconst(2,64),bvconst(2,64),bvconst(1,8),bvconst(1,8)))
}

example "META107-55 unrelated record preserved" {
    assert(ptr107_live_cell(bvconst(7,64),bvconst(8,64),bvconst(0,8),bvconst(1,8))=bvconst(1,8))
}

example "META107-56 released record dead" {
    assert(ptr107_live_cell(bvconst(7,64),bvconst(7,64),bvconst(0,8),bvconst(1,8))=bvconst(0,8))
}

example "META107 universal unrelated release frame" {
    assert(∀(t : BitVec64). ∀(q : BitVec64). 
        (¬(t=q)) → (ptr107_live_cell(t,q,bvconst(0,8),bvconst(1,8))=bvconst(1,8)))
}
example "META107 universal rejected access has no operand transaction" {
    assert(ptr107_operand_transactions(bvconst(0,8))=bvconst(0,64))
}
example "META107 universal expired references fail" {
    assert(∀(p : BitVec64). ∀(pg : BitVec64). ∀(id : BitVec64). ∀(g : BitVec64).
        ¬ptr107_current(p,pg,id,g,bvconst(0,8),bvconst(1,8)))
}
example "META107 universal reused generation cannot match old pointer" {
    assert(∀(id : BitVec64). ∀(old : BitVec64). ∀(fresh : BitVec64).
        (¬(old=fresh)) → ¬ptr107_current(id,old,id,fresh,bvconst(1,8),bvconst(1,8)))
}

example "META107 advance preserves metadata" {
    assert(ptr107_advance(bvconst(7,64),bvconst(2,64),bvconst(0,64),bvconst(16,64),bvconst(0,64),bvconst(3,64),bvconst(32,64),bvconst(2,64),bvconst(8,64),bvconst(7,64),bvconst(2,64),bvconst(0,64),bvconst(16,64),bvconst(16,64),bvconst(3,64)))
}

example "META107 advance cannot rebind allocation" {
    assert(¬(ptr107_advance(bvconst(7,64),bvconst(2,64),bvconst(0,64),bvconst(16,64),bvconst(0,64),bvconst(3,64),bvconst(32,64),bvconst(2,64),bvconst(8,64),bvconst(8,64),bvconst(2,64),bvconst(0,64),bvconst(16,64),bvconst(16,64),bvconst(3,64))))
}

example "META107 advance cannot change lifetime" {
    assert(¬(ptr107_advance(bvconst(7,64),bvconst(2,64),bvconst(0,64),bvconst(16,64),bvconst(0,64),bvconst(3,64),bvconst(32,64),bvconst(2,64),bvconst(8,64),bvconst(7,64),bvconst(3,64),bvconst(0,64),bvconst(16,64),bvconst(16,64),bvconst(3,64))))
}

example "META107 advance cannot widen bounds" {
    assert(¬(ptr107_advance(bvconst(7,64),bvconst(2,64),bvconst(0,64),bvconst(16,64),bvconst(0,64),bvconst(3,64),bvconst(32,64),bvconst(2,64),bvconst(8,64),bvconst(7,64),bvconst(2,64),bvconst(0,64),bvconst(17,64),bvconst(16,64),bvconst(3,64))))
}

example "META107 advance cannot change rights" {
    assert(¬(ptr107_advance(bvconst(7,64),bvconst(2,64),bvconst(0,64),bvconst(16,64),bvconst(0,64),bvconst(3,64),bvconst(32,64),bvconst(2,64),bvconst(8,64),bvconst(7,64),bvconst(2,64),bvconst(0,64),bvconst(16,64),bvconst(16,64),bvconst(4,64))))
}
