example "KC110 194 all retry transitions preserve original deadline" {
    assert(∀ work : BitVec64 . ∀ deadline : BitVec64 . ∀ last : BitVec64 . ∀ after_work : BitVec64 . ∀ after_deadline : BitVec64 . ∀ after_last : BitVec64 . ∀ tick : BitVec64 . kc110_retry(KC110Budget(work,deadline,last),KC110Budget(after_work,after_deadline,after_last),tick) ⇒ (deadline=after_deadline))
}

example "KC110 195 all positive use sequence transitions strictly advance" {
    assert(∀ before : BitVec64 . ∀ after : BitVec64 . kc110_use_step(before,after) ⇒ bvult(before,after))
}

