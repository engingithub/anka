// KC110: Keycloak adapter observation versus strict Anka authority use.
// Zero new axioms. No JWT/TLS/JSON implementation or cryptography proof.
// Trusted primitive verdicts cover the ENTIRE record, never peer-supplied flags.
// All 64-bit identities are collision-free opaque equality handles in this model,
// not truncations of strings, certificate hashes, artifact digests or JWT bytes.
// Wall seconds and monotonic ticks are separate domains. No clock-skew allowance.
// Profile 1: configured signed access-token profile with certificate holder binding.
// An introspection observation is NOT E9 Current. Strict use needs an independent
// serialized authority receipt; the first CLI preflight MUST leave it Unknown.
import "anka110_storage_verifier.kleis"

define kc110_true() = bvconst(1,8)=bvconst(1,8)
define kc110_false() = ¬kc110_true()
define kc110_nz(n : BitVec64) = a109_nonzero(n)


data KC110Config = KC110Config(issuer : BitVec64, audience : BitVec64, client : BitVec64, installation : BitVec64, policy : BitVec64, keyset : BitVec64, profile : BitVec64, max_age : BitVec64, max_bytes : BitVec64, selected : A109Verdict)

define kcc_issuer(v : KC110Config) = match v { KC110Config(issuer,audience,client,installation,policy,keyset,profile,max_age,max_bytes,selected) => issuer }

define kcc_audience(v : KC110Config) = match v { KC110Config(issuer,audience,client,installation,policy,keyset,profile,max_age,max_bytes,selected) => audience }

define kcc_client(v : KC110Config) = match v { KC110Config(issuer,audience,client,installation,policy,keyset,profile,max_age,max_bytes,selected) => client }

define kcc_installation(v : KC110Config) = match v { KC110Config(issuer,audience,client,installation,policy,keyset,profile,max_age,max_bytes,selected) => installation }

define kcc_policy(v : KC110Config) = match v { KC110Config(issuer,audience,client,installation,policy,keyset,profile,max_age,max_bytes,selected) => policy }

define kcc_keyset(v : KC110Config) = match v { KC110Config(issuer,audience,client,installation,policy,keyset,profile,max_age,max_bytes,selected) => keyset }

define kcc_profile(v : KC110Config) = match v { KC110Config(issuer,audience,client,installation,policy,keyset,profile,max_age,max_bytes,selected) => profile }

define kcc_max_age(v : KC110Config) = match v { KC110Config(issuer,audience,client,installation,policy,keyset,profile,max_age,max_bytes,selected) => max_age }

define kcc_max_bytes(v : KC110Config) = match v { KC110Config(issuer,audience,client,installation,policy,keyset,profile,max_age,max_bytes,selected) => max_bytes }

define kcc_selected(v : KC110Config) = match v { KC110Config(issuer,audience,client,installation,policy,keyset,profile,max_age,max_bytes,selected) => selected }

data KC110Token = KC110Token(reference : BitVec64, issuer : BitVec64, audience : BitVec64, client : BitVec64, subject : BitVec64, holder : BitVec64, keyset : BitVec64, profile : BitVec64, issued : BitVec64, first : BitVec64, until : BitVec64, syntax : A109Verdict, signature : A109Verdict)

define kct_reference(v : KC110Token) = match v { KC110Token(reference,issuer,audience,client,subject,holder,keyset,profile,issued,first,until,syntax,signature) => reference }

