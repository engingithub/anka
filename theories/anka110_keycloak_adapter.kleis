example "KC110 179 boot consumption A109Unknown denies" {
    assert(¬kc110_boot_admit(kc110_true(),A109Valid,A109Unknown,kc110_true()))
}

example "KC110 180 boot grant A109Unknown denies" {
    assert(¬kc110_boot_admit(kc110_true(),A109Unknown,A109Valid,kc110_true()))
}

example "KC110 181 boot consumption A109Invalid denies" {
    assert(¬kc110_boot_admit(kc110_true(),A109Valid,A109Invalid,kc110_true()))
}

example "KC110 182 boot grant A109Invalid denies" {
    assert(¬kc110_boot_admit(kc110_true(),A109Invalid,A109Valid,kc110_true()))
}

example "KC110 183 separate boot evidence composes" {
    assert(kc110_boot_admit(kc110_true(),A109Valid,A109Valid,kc110_true()))
}

example "KC110 184 ordinary operation preserves boot state" {
    assert(kc110_boot_frame(bvconst(88,64),bvconst(88,64)))
}

example "KC110 185 ordinary operation cannot consume boot state" {
    assert(¬kc110_boot_frame(bvconst(88,64),bvconst(89,64)))
}

example "KC110 186 all deadlines are exclusive" {
    assert(∀ n : BitVec64 . ∀ w : BitVec64 . ∀ last : BitVec64 . ¬kc110_budget(KC110Budget(w,n,last),n))
}

example "KC110 187 all exhausted budgets deny" {
    assert(∀ n : BitVec64 . ∀ d : BitVec64 . ∀ last : BitVec64 . ¬kc110_budget(KC110Budget(bvconst(0,64),d,last),n))
}

example "KC110 188 all denial effects preserve history" {
    assert(∀ a : BitVec64 . ∀ b : BitVec64 . ∀ e : BitVec64 . kc110_effect(kc110_false(),kc110_true(),a,b,e) ⇒ ((a=b) ∧ (e=bvconst(0,64))))
}

example "KC110 189 all token expiration boundaries deny" {
    assert(∀ now : BitVec64 . ∀ first : BitVec64 . ¬a109_window(now,first,now))
}

example "KC110 190 all spends are nonincreasing" {
    assert(∀ work : BitVec64 . ∀ after : BitVec64 . kc110_spend(KC110Budget(work,bvconst(200,64),bvconst(100,64)),after) ⇒ bvule(after,work))
}

example "KC110 191 all ordinary boot frames preserve selection" {
    assert(∀ before : BitVec64 . ∀ after : BitVec64 . kc110_boot_frame(before,after) ⇒ (before=after))
}

