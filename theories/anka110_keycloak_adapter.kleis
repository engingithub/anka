define kct_profile(v : KC110Token) = match v { KC110Token(reference,issuer,audience,client,subject,holder,keyset,profile,issued,first,until,syntax,signature) => profile }

define kct_issued(v : KC110Token) = match v { KC110Token(reference,issuer,audience,client,subject,holder,keyset,profile,issued,first,until,syntax,signature) => issued }

define kct_first(v : KC110Token) = match v { KC110Token(reference,issuer,audience,client,subject,holder,keyset,profile,issued,first,until,syntax,signature) => first }

