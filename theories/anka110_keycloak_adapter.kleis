data KC110Fence = KC110Fence(token : BitVec64, scope_installation : BitVec64, scope_policy : BitVec64, scope_peer : BitVec64, scope_kind : BitVec64, scope_artifact : BitVec64, scope_generation : BitVec64, scope_request : BitVec64, scope_operation : BitVec64, scope_role : BitVec64, scope_runtime : BitVec64, scope_connection : BitVec64, scope_binding : BitVec64, scope_local : BitVec64, scope_incarnation : BitVec64, scope_serial : BitVec64, scope_challenge : BitVec64, keyset : BitVec64, use_seq : BitVec64, at_tick : BitVec64, current : A109Verdict)

define kcf_token(v : KC110Fence) = match v { KC110Fence(token,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge,keyset,use_seq,at_tick,current) => token }

define kcf_scope_installation(v : KC110Fence) = match v { KC110Fence(token,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge,keyset,use_seq,at_tick,current) => scope_installation }

define kcf_scope_policy(v : KC110Fence) = match v { KC110Fence(token,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge,keyset,use_seq,at_tick,current) => scope_policy }

define kcf_scope_peer(v : KC110Fence) = match v { KC110Fence(token,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge,keyset,use_seq,at_tick,current) => scope_peer }

define kcf_scope_kind(v : KC110Fence) = match v { KC110Fence(token,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge,keyset,use_seq,at_tick,current) => scope_kind }

define kcf_scope_artifact(v : KC110Fence) = match v { KC110Fence(token,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge,keyset,use_seq,at_tick,current) => scope_artifact }

define kcf_scope_generation(v : KC110Fence) = match v { KC110Fence(token,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge,keyset,use_seq,at_tick,current) => scope_generation }

define kcf_scope_request(v : KC110Fence) = match v { KC110Fence(token,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge,keyset,use_seq,at_tick,current) => scope_request }

define kcf_scope_operation(v : KC110Fence) = match v { KC110Fence(token,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge,keyset,use_seq,at_tick,current) => scope_operation }

define kcf_scope_role(v : KC110Fence) = match v { KC110Fence(token,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge,keyset,use_seq,at_tick,current) => scope_role }

define kcf_scope_runtime(v : KC110Fence) = match v { KC110Fence(token,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge,keyset,use_seq,at_tick,current) => scope_runtime }

define kcf_scope_connection(v : KC110Fence) = match v { KC110Fence(token,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge,keyset,use_seq,at_tick,current) => scope_connection }

define kcf_scope_binding(v : KC110Fence) = match v { KC110Fence(token,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge,keyset,use_seq,at_tick,current) => scope_binding }

define kcf_scope_local(v : KC110Fence) = match v { KC110Fence(token,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge,keyset,use_seq,at_tick,current) => scope_local }

define kcf_scope_incarnation(v : KC110Fence) = match v { KC110Fence(token,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge,keyset,use_seq,at_tick,current) => scope_incarnation }

define kcf_scope_serial(v : KC110Fence) = match v { KC110Fence(token,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge,keyset,use_seq,at_tick,current) => scope_serial }

define kcf_scope_challenge(v : KC110Fence) = match v { KC110Fence(token,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge,keyset,use_seq,at_tick,current) => scope_challenge }

define kcf_keyset(v : KC110Fence) = match v { KC110Fence(token,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge,keyset,use_seq,at_tick,current) => keyset }

define kcf_use_seq(v : KC110Fence) = match v { KC110Fence(token,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge,keyset,use_seq,at_tick,current) => use_seq }

define kcf_at_tick(v : KC110Fence) = match v { KC110Fence(token,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge,keyset,use_seq,at_tick,current) => at_tick }

define kcf_current(v : KC110Fence) = match v { KC110Fence(token,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge,keyset,use_seq,at_tick,current) => current }

data KC110Budget = KC110Budget(remaining : BitVec64, deadline : BitVec64, last_tick : BitVec64)

define kcb_remaining(v : KC110Budget) = match v { KC110Budget(remaining,deadline,last_tick) => remaining }

define kcb_deadline(v : KC110Budget) = match v { KC110Budget(remaining,deadline,last_tick) => deadline }

define kcb_last_tick(v : KC110Budget) = match v { KC110Budget(remaining,deadline,last_tick) => last_tick }

define kc110_scope_equal(a : KC110Scope,b : KC110Scope) =
    (kcs_installation(a)=kcs_installation(b)) ∧ (kcs_policy(a)=kcs_policy(b)) ∧ (kcs_peer(a)=kcs_peer(b)) ∧ (kcs_kind(a)=kcs_kind(b)) ∧ (kcs_artifact(a)=kcs_artifact(b)) ∧ (kcs_generation(a)=kcs_generation(b)) ∧ (kcs_request(a)=kcs_request(b)) ∧ (kcs_operation(a)=kcs_operation(b)) ∧ (kcs_role(a)=kcs_role(b)) ∧ (kcs_runtime(a)=kcs_runtime(b)) ∧ (kcs_connection(a)=kcs_connection(b)) ∧ (kcs_binding(a)=kcs_binding(b)) ∧ (kcs_local(a)=kcs_local(b)) ∧ (kcs_incarnation(a)=kcs_incarnation(b)) ∧ (kcs_serial(a)=kcs_serial(b)) ∧ (kcs_challenge(a)=kcs_challenge(b))

define kc110_p_scope(p : KC110Proof,s : KC110Scope) =
    (kcp_scope_installation(p)=kcs_installation(s)) ∧ (kcp_scope_policy(p)=kcs_policy(s)) ∧ (kcp_scope_peer(p)=kcs_peer(s)) ∧ (kcp_scope_kind(p)=kcs_kind(s)) ∧ (kcp_scope_artifact(p)=kcs_artifact(s)) ∧ (kcp_scope_generation(p)=kcs_generation(s)) ∧ (kcp_scope_request(p)=kcs_request(s)) ∧ (kcp_scope_operation(p)=kcs_operation(s)) ∧ (kcp_scope_role(p)=kcs_role(s)) ∧ (kcp_scope_runtime(p)=kcs_runtime(s)) ∧ (kcp_scope_connection(p)=kcs_connection(s)) ∧ (kcp_scope_binding(p)=kcs_binding(s)) ∧ (kcp_scope_local(p)=kcs_local(s)) ∧ (kcp_scope_incarnation(p)=kcs_incarnation(s)) ∧ (kcp_scope_serial(p)=kcs_serial(s)) ∧ (kcp_scope_challenge(p)=kcs_challenge(s))

define kc110_g_scope(g : KC110Grant,s : KC110Scope) =
    (kcg_scope_installation(g)=kcs_installation(s)) ∧ (kcg_scope_policy(g)=kcs_policy(s)) ∧ (kcg_scope_peer(g)=kcs_peer(s)) ∧ (kcg_scope_kind(g)=kcs_kind(s)) ∧ (kcg_scope_artifact(g)=kcs_artifact(s)) ∧ (kcg_scope_generation(g)=kcs_generation(s)) ∧ (kcg_scope_request(g)=kcs_request(s)) ∧ (kcg_scope_operation(g)=kcs_operation(s)) ∧ (kcg_scope_role(g)=kcs_role(s)) ∧ (kcg_scope_runtime(g)=kcs_runtime(s)) ∧ (kcg_scope_connection(g)=kcs_connection(s)) ∧ (kcg_scope_binding(g)=kcs_binding(s)) ∧ (kcg_scope_local(g)=kcs_local(s)) ∧ (kcg_scope_incarnation(g)=kcs_incarnation(s)) ∧ (kcg_scope_serial(g)=kcs_serial(s)) ∧ (kcg_scope_challenge(g)=kcs_challenge(s))

define kc110_f_scope(f : KC110Fence,s : KC110Scope) =
    (kcf_scope_installation(f)=kcs_installation(s)) ∧ (kcf_scope_policy(f)=kcs_policy(s)) ∧ (kcf_scope_peer(f)=kcs_peer(s)) ∧ (kcf_scope_kind(f)=kcs_kind(s)) ∧ (kcf_scope_artifact(f)=kcs_artifact(s)) ∧ (kcf_scope_generation(f)=kcs_generation(s)) ∧ (kcf_scope_request(f)=kcs_request(s)) ∧ (kcf_scope_operation(f)=kcs_operation(s)) ∧ (kcf_scope_role(f)=kcs_role(s)) ∧ (kcf_scope_runtime(f)=kcs_runtime(s)) ∧ (kcf_scope_connection(f)=kcs_connection(s)) ∧ (kcf_scope_binding(f)=kcs_binding(s)) ∧ (kcf_scope_local(f)=kcs_local(s)) ∧ (kcf_scope_incarnation(f)=kcs_incarnation(s)) ∧ (kcf_scope_serial(f)=kcs_serial(s)) ∧ (kcf_scope_challenge(f)=kcs_challenge(s))


// Limits are adapter policy: finite token bytes and observation age, selected
// independently of incoming claims. These do not change any Kernel quota.
define kc110_config(c : KC110Config) =
    (kcc_selected(c)=A109Valid) ∧ kc110_nz(kcc_issuer(c)) ∧ kc110_nz(kcc_audience(c)) ∧
    kc110_nz(kcc_client(c)) ∧ kc110_nz(kcc_installation(c)) ∧ kc110_nz(kcc_policy(c)) ∧
    kc110_nz(kcc_keyset(c)) ∧ (kcc_profile(c)=bvconst(1,64)) ∧ kc110_nz(kcc_max_age(c)) ∧
    kc110_nz(kcc_max_bytes(c)) ∧ bvule(kcc_max_bytes(c),bvconst(16384,64))
define kc110_token(c : KC110Config,t : KC110Token,wall : BitVec64,bytes : BitVec64) =
    kc110_config(c) ∧ kc110_nz(bytes) ∧ bvule(bytes,kcc_max_bytes(c)) ∧
    (kct_syntax(t)=A109Valid) ∧ (kct_signature(t)=A109Valid) ∧
    kc110_nz(kct_reference(t)) ∧ kc110_nz(kct_subject(t)) ∧ kc110_nz(kct_holder(t)) ∧
    (kct_issuer(t)=kcc_issuer(c)) ∧ (kct_audience(t)=kcc_audience(c)) ∧
    (kct_client(t)=kcc_client(c)) ∧ (kct_keyset(t)=kcc_keyset(c)) ∧ (kct_profile(t)=kcc_profile(c)) ∧
    bvule(kct_issued(t),wall) ∧ bvult(kct_issued(t),kct_until(t)) ∧
    a109_window(wall,kct_first(t),kct_until(t))
// Age starts before the outbound query, not on response arrival: slow requests
// cannot renew the observation. Subtraction is guarded; wrap/backwards time denies.
define kc110_observation(c : KC110Config,t : KC110Token,s : KC110Status,
    query : BitVec64,tick : BitVec64) =
    kc110_nz(query) ∧ (kci_query(s)=query) ∧ (kci_token(s)=kct_reference(t)) ∧
    (kci_issuer(s)=kcc_issuer(c)) ∧ (kci_checked(s)=A109Valid) ∧ (kci_active(s)=A109Valid) ∧
    bvule(kci_started(s),kci_observed(s)) ∧ bvule(kci_observed(s),tick) ∧
    bvult(bvsub(tick,kci_started(s)),kcc_max_age(c))
define kc110_mapping(c : KC110Config,t : KC110Token,m : KC110Mapping,s : KC110Scope) =
    (kcm_enabled(m)=A109Valid) ∧ (kcm_issuer(m)=kcc_issuer(c)) ∧
    (kcm_subject(m)=kct_subject(t)) ∧ (kcm_client(m)=kct_client(t)) ∧
    (kcm_installation(m)=kcc_installation(c)) ∧ (kcm_installation(m)=kcs_installation(s)) ∧
    (kcm_policy(m)=kcc_policy(c)) ∧ (kcm_policy(m)=kcs_policy(s)) ∧
    (kcm_peer(m)=kcs_peer(s)) ∧ (kcm_kind(m)=kcs_kind(s))
// E9/E11 operation tags 1/2 are retained. Artifact identity and generation are
// additional exact scope, not inferred from OAuth role/scope names.
define kc110_scope(s : KC110Scope) =
    kc110_nz(kcs_installation(s)) ∧ kc110_nz(kcs_policy(s)) ∧ kc110_nz(kcs_peer(s)) ∧
    a109_kind(kcs_kind(s)) ∧ kc110_nz(kcs_artifact(s)) ∧ kc110_nz(kcs_generation(s)) ∧ kc110_nz(kcs_request(s)) ∧
    ((kcs_operation(s)=bvconst(1,64)) ∨ (kcs_operation(s)=bvconst(2,64))) ∧
    ((kcs_role(s)=bvconst(1,64)) ∨ (kcs_role(s)=bvconst(2,64))) ∧
    kc110_nz(kcs_runtime(s)) ∧ kc110_nz(kcs_connection(s)) ∧ kc110_nz(kcs_binding(s)) ∧
    kc110_nz(kcs_local(s)) ∧ kc110_nz(kcs_incarnation(s)) ∧ kc110_nz(kcs_serial(s)) ∧ kc110_nz(kcs_challenge(s))
define kc110_proof(c : KC110Config,t : KC110Token,p : KC110Proof,s : KC110Scope) =
    (kcp_signature(p)=A109Valid) ∧ (kcp_token(p)=kct_reference(t)) ∧
    (kcp_issuer(p)=kcc_issuer(c)) ∧ (kcp_signer(p)=kct_holder(t)) ∧ kc110_p_scope(p,s)
define kc110_grant(t : KC110Token,g : KC110Grant,s : KC110Scope,wall : BitVec64) =
    (kcg_permission(g)=A109Valid) ∧ (kcg_token(g)=kct_reference(t)) ∧
    kc110_g_scope(g,s) ∧ a109_window(wall,kcg_first(g),kcg_until(g))
// Diagnostic identity preflight only. It mints no permit or reusable capability.
define kc110_preflight(c : KC110Config,t : KC110Token,i : KC110Status,
    wall : BitVec64,tick : BitVec64,query : BitVec64,bytes : BitVec64) =
    kc110_token(c,t,wall,bytes) ∧ kc110_observation(c,t,i,query,tick)
// A candidate additionally binds locally selected mapping, grant and the actual
// live channel/holder proof. It still supplies NO current authority by itself.
define kc110_candidate(c : KC110Config,t : KC110Token,i : KC110Status,m : KC110Mapping,
    s : KC110Scope,p : KC110Proof,g : KC110Grant,wall : BitVec64,tick : BitVec64,
    query : BitVec64,bytes : BitVec64,channel : A109Verdict) =
    kc110_preflight(c,t,i,wall,tick,query,bytes) ∧ kc110_mapping(c,t,m,s) ∧ kc110_scope(s) ∧
    (channel=A109Valid) ∧ kc110_proof(c,t,p,s) ∧ kc110_grant(t,g,s,wall)
// This separate receipt is NOT derived from active=true, token lifetime, a local
// mutex around an HTTP call, or a copied version number. Its producer must fence
// relevant authority changes through the local effect. No producer is delivered.
define kc110_fence(c : KC110Config,t : KC110Token,s : KC110Scope,f : KC110Fence,
    use_seq : BitVec64,tick : BitVec64) =
    (kcf_current(f)=A109Valid) ∧ kc110_nz(use_seq) ∧ (kcf_use_seq(f)=use_seq) ∧
    (kcf_at_tick(f)=tick) ∧ (kcf_token(f)=kct_reference(t)) ∧ (kcf_keyset(f)=kcc_keyset(c)) ∧
    kc110_f_scope(f,s)
define kc110_budget(b : KC110Budget,tick : BitVec64) =
    kc110_nz(kcb_remaining(b)) ∧ bvule(kcb_remaining(b),bvconst(512,64)) ∧
    bvule(kcb_last_tick(b),tick) ∧ bvult(tick,kcb_deadline(b))
// Every attempted poll spends one remaining unit, even on malformed/denied/late
// input. At zero it stays zero. Reconnect/token refresh cannot refill this budget.
define kc110_spend(b : KC110Budget,after : BitVec64) =
    after=(if kc110_nz(kcb_remaining(b)) then bvsub(kcb_remaining(b),bvconst(1,64)) else bvconst(0,64))
define kc110_retry(before : KC110Budget,after : KC110Budget,tick : BitVec64) =
    kc110_spend(before,kcb_remaining(after)) ∧ (kcb_deadline(before)=kcb_deadline(after)) ∧
    (kcb_last_tick(after)=(if bvule(kcb_last_tick(before),tick) then tick else kcb_last_tick(before)))
// Every attempt owns a fresh non-recycled local use sequence, even if denied.
// The producer/fence consumer uses this transition under the same local guard.
define kc110_use_step(before : BitVec64,after : BitVec64) =
    kc110_nz(before) ∧ bvult(before,a109_max()) ∧ (after=bvadd(before,bvconst(1,64)))
define kc110_ready(c : KC110Config,t : KC110Token,i : KC110Status,m : KC110Mapping,
    s : KC110Scope,p : KC110Proof,g : KC110Grant,f : KC110Fence,b : KC110Budget,
    wall : BitVec64,tick : BitVec64,query : BitVec64,bytes : BitVec64,channel : A109Verdict,use_seq : BitVec64) =
    kc110_candidate(c,t,i,m,s,p,g,wall,tick,query,bytes,channel) ∧
    kc110_fence(c,t,s,f,use_seq,tick) ∧ kc110_budget(b,tick)
// Effect permission is an additional existing-operation gate, never inferred
// from identity. Re-evaluate ready at each use, fragment and final delivery.
define kc110_effect(ready : Bool,existing_gate : Bool,before : BitVec64,after : BitVec64,emitted : BitVec64) =
    if ready ∧ existing_gate ∧ bvult(before,a109_max())
    then (after=bvadd(before,bvconst(1,64))) ∧ (emitted=bvconst(1,64))
    else (after=before) ∧ (emitted=bvconst(0,64))
// One owned adapter attempt composes accounting, fresh use sequence and effect.
// ready is recomputed by kc110_ready for seq_before, never a cached approval.
define kc110_attempt(ready : Bool,existing_gate : Bool,b : KC110Budget,next : KC110Budget,
    seq_before : BitVec64,seq_after : BitVec64,tick : BitVec64,
    history_before : BitVec64,history_after : BitVec64,emitted : BitVec64) =
    kc110_retry(b,next,tick) ∧
    (if kc110_nz(seq_before) ∧ bvult(seq_before,a109_max())
     then kc110_use_step(seq_before,seq_after)
     else seq_after=seq_before) ∧
    kc110_effect(ready ∧ kc110_budget(b,tick) ∧ kc110_nz(seq_before) ∧ bvult(seq_before,a109_max()),
        existing_gate,history_before,history_after,emitted)
// Ordinary evidence use does not consume boot attempts or modify selected boot
// artifacts. Model a pointwise frame, not a durable store implementation.
define kc110_boot_frame(before : BitVec64,after : BitVec64) = before=after
define kc110_boot_admit(identity_ready : Bool,boot_grant : A109Verdict,
    external_consumption : A109Verdict,existing_boot_gate : Bool) =
    identity_ready ∧ (boot_grant=A109Valid) ∧ (external_consumption=A109Valid) ∧ existing_boot_gate

// Explicit projection into existing E9/E11 predicates. OAuth audience is the
// resource server; V110 audience is the installation from the trusted mapping.
// Never fill this projection from preflight alone: kc110_ready guards publication.
define kc110_context(c : KC110Config,s : KC110Scope,wall : BitVec64) =
    A109Context(kcc_issuer(c),kcs_installation(s),kcs_policy(s),kcs_challenge(s),wall,kc110_true())
define kc110_live(s : KC110Scope) =
    E110Observation(kcs_runtime(s),kcs_connection(s),kcs_binding(s),kcs_local(s),kcs_peer(s),kcs_kind(s),kcs_incarnation(s),kcs_role(s),kcs_operation(s),kcs_serial(s),kcs_challenge(s),kc110_true(),A109Valid)
define kc110_credential(c : KC110Config,t : KC110Token,s : KC110Scope) =
    V110Credential(kct_reference(t),kcc_issuer(c),kcs_peer(s),kcs_kind(s),kcs_installation(s),kcs_policy(s),kct_holder(t),kct_first(t),kct_until(t),A109Valid)
define kc110_current(c : KC110Config,t : KC110Token,s : KC110Scope,g : KC110Grant) =
    V110Status(kct_reference(t),kcc_issuer(c),kcs_policy(s),kcs_serial(s),kcg_first(g),kcg_until(g),A109Valid)
define kc110_caller(c : KC110Config,t : KC110Token,s : KC110Scope) =
    V110Possession(kcc_issuer(c),kct_reference(t),kct_holder(t),kcs_runtime(s),kcs_connection(s),kcs_binding(s),kcs_local(s),kcs_peer(s),kcs_kind(s),kcs_incarnation(s),kcs_role(s),kcs_operation(s),kcs_serial(s),kcs_challenge(s),A109Valid)
define kc110_server(c : KC110Config,t : KC110Token,s : KC110Scope) =
