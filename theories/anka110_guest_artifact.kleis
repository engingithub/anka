// GA110 guest upload: distinct artifact request, same typed socket ownership.
// Provider verdicts and compiler receipt/identity mapping remain trusted inputs.
import "anka110_artifact_transport.kleis"
define ga110_mode(mode : BitVec64,request : BitVec64,reply : BitVec64,canonical : Bool) =
    canonical ∧ (((mode=a109_one()) ∧ (request=bvconst(112,64)) ∧ (reply=bvconst(144,64))) ∨
    ((mode=bvconst(2,64)) ∧ bvule(bvconst(168,64),request) ∧ bvule(request,bvconst(4264,64)) ∧ (reply=bvadd(request,bvconst(72,64)))))
define ga110_input(mode : BitVec64,authority : A109Verdict,exact : Bool,owner : Bool,charged : Bool,length : BitVec64) =
    (mode=bvconst(2,64)) ∧ (authority=A109Valid) ∧ exact ∧ owner ∧ charged ∧ bvule(bvconst(176,64),length) ∧ bvule(length,bvconst(4272,64))
define ga110_emit(mode : BitVec64,verifier_mode : BitVec64,current : A109Verdict,owner : Bool,exact_prefix : Bool,typed : Bool,lane : Bool) =
    (mode=verifier_mode) ∧ (current=A109Valid) ∧ owner ∧ exact_prefix ∧ typed ∧ lane
define ga110_fin(accepted : BitVec64,sent : BitVec64,total : BitVec64,current : A109Verdict) =
    a109_nonzero(total) ∧ (accepted=total) ∧ (sent=total) ∧ (current=A109Valid)
define ga110_deliver(actual : BitVec64,expected : BitVec64,fin : Bool,exact_echo : Bool,current : A109Verdict,owner : Bool) =
    (actual=expected) ∧ fin ∧ exact_echo ∧ (current=A109Valid) ∧ owner
define ga110_loss(before : BitVec64,after : BitVec64,publication : BitVec64,retry_publication : BitVec64,old_dead : Bool,new_bound : Bool) =
    (before=after) ∧ (publication=retry_publication) ∧ old_dead ∧ new_bound
example "ga110_mode valid" { assert(ga110_mode(bvconst(2,64),bvconst(4264,64),bvconst(4336,64),as110_true())) }
example "legacy profile cannot admit artifact" { assert(¬(ga110_mode(bvconst(1,64),bvconst(4264,64),bvconst(4336,64),as110_true()))) }
example "unknown mode" { assert(¬(ga110_mode(bvconst(3,64),bvconst(4264,64),bvconst(4336,64),as110_true()))) }
example "request oversized" { assert(¬(ga110_mode(bvconst(2,64),bvconst(4265,64),bvconst(4336,64),as110_true()))) }
example "reply tail" { assert(¬(ga110_mode(bvconst(2,64),bvconst(4264,64),bvconst(4337,64),as110_true()))) }
example "bad canonical" { assert(¬(ga110_mode(bvconst(2,64),bvconst(4264,64),bvconst(4336,64),as110_false()))) }
example "legacy unchanged" { assert(ga110_mode(bvconst(1,64),bvconst(112,64),bvconst(144,64),as110_true())) }
example "ga110_input valid" { assert(ga110_input(bvconst(2,64),A109Valid,as110_true(),as110_true(),as110_true(),bvconst(4272,64))) }
example "input forbidden in Select" { assert(¬(ga110_input(bvconst(1,64),A109Valid,as110_true(),as110_true(),as110_true(),bvconst(4272,64)))) }
example "unknown input authority" { assert(¬(ga110_input(bvconst(2,64),A109Unknown,as110_true(),as110_true(),as110_true(),bvconst(4272,64)))) }
example "different input" { assert(¬(ga110_input(bvconst(2,64),A109Valid,as110_false(),as110_true(),as110_true(),bvconst(4272,64)))) }
example "stale child" { assert(¬(ga110_input(bvconst(2,64),A109Valid,as110_true(),as110_false(),as110_true(),bvconst(4272,64)))) }
example "unfunded input" { assert(¬(ga110_input(bvconst(2,64),A109Valid,as110_true(),as110_true(),as110_false(),bvconst(4272,64)))) }
example "oversized input" { assert(¬(ga110_input(bvconst(2,64),A109Valid,as110_true(),as110_true(),as110_true(),bvconst(4273,64)))) }
example "ga110_emit valid" { assert(ga110_emit(bvconst(2,64),bvconst(2,64),A109Valid,as110_true(),as110_true(),as110_true(),as110_true())) }
example "wrong verifier" { assert(¬(ga110_emit(bvconst(2,64),bvconst(1,64),A109Valid,as110_true(),as110_true(),as110_true(),as110_true()))) }
example "revoked server" { assert(¬(ga110_emit(bvconst(2,64),bvconst(2,64),A109Invalid,as110_true(),as110_true(),as110_true(),as110_true()))) }
example "foreign socket" { assert(¬(ga110_emit(bvconst(2,64),bvconst(2,64),A109Valid,as110_false(),as110_true(),as110_true(),as110_true()))) }
example "guest changes request" { assert(¬(ga110_emit(bvconst(2,64),bvconst(2,64),A109Valid,as110_true(),as110_false(),as110_true(),as110_true()))) }
example "scalar pointer" { assert(¬(ga110_emit(bvconst(2,64),bvconst(2,64),A109Valid,as110_true(),as110_true(),as110_false(),as110_true()))) }
example "no guarded write" { assert(¬(ga110_emit(bvconst(2,64),bvconst(2,64),A109Valid,as110_true(),as110_true(),as110_true(),as110_false()))) }
example "ga110_fin valid" { assert(ga110_fin(bvconst(4264,64),bvconst(4264,64),bvconst(4264,64),A109Valid)) }
example "early accepted FIN" { assert(¬(ga110_fin(bvconst(4263,64),bvconst(4264,64),bvconst(4264,64),A109Valid))) }
example "early wire FIN" { assert(¬(ga110_fin(bvconst(4264,64),bvconst(4263,64),bvconst(4264,64),A109Valid))) }
example "revoked FIN" { assert(¬(ga110_fin(bvconst(4264,64),bvconst(4264,64),bvconst(4264,64),A109Invalid))) }
example "ga110_deliver valid" { assert(ga110_deliver(bvconst(4336,64),bvconst(4336,64),as110_true(),as110_true(),A109Valid,as110_true())) }
example "partial reply" { assert(¬(ga110_deliver(bvconst(4335,64),bvconst(4336,64),as110_true(),as110_true(),A109Valid,as110_true()))) }
example "missing FIN" { assert(¬(ga110_deliver(bvconst(4336,64),bvconst(4336,64),as110_false(),as110_true(),A109Valid,as110_true()))) }
example "echo mismatch" { assert(¬(ga110_deliver(bvconst(4336,64),bvconst(4336,64),as110_true(),as110_false(),A109Valid,as110_true()))) }
example "revoked final reply" { assert(¬(ga110_deliver(bvconst(4336,64),bvconst(4336,64),as110_true(),as110_true(),A109Invalid,as110_true()))) }
example "other guest" { assert(¬(ga110_deliver(bvconst(4336,64),bvconst(4336,64),as110_true(),as110_true(),A109Valid,as110_false()))) }
example "ga110_loss valid" { assert(ga110_loss(bvconst(9000,64),bvconst(9000,64),bvconst(8,64),bvconst(8,64),as110_true(),as110_true())) }
example "source refunded" { assert(¬(ga110_loss(bvconst(9000,64),bvconst(0,64),bvconst(8,64),bvconst(8,64),as110_true(),as110_true()))) }
example "retry duplicated publication" { assert(¬(ga110_loss(bvconst(9000,64),bvconst(9000,64),bvconst(8,64),bvconst(9,64),as110_true(),as110_true()))) }
example "old socket live" { assert(¬(ga110_loss(bvconst(9000,64),bvconst(9000,64),bvconst(8,64),bvconst(8,64),as110_false(),as110_true()))) }
example "retry not bound" { assert(¬(ga110_loss(bvconst(9000,64),bvconst(9000,64),bvconst(8,64),bvconst(8,64),as110_true(),as110_false()))) }

// Trace indices may be reclaimed only after the exclusive NIC is fully drained.
// Collection preserves the next transaction identity and finite session budget.
define ga110_trace_collect(parked : Bool,drained : Bool,terminal : Bool,clean : Bool,bounded : Bool,identity_before : BitVec64,identity_after : BitVec64,work_before : BitVec64,work_after : BitVec64) =
    parked ∧ drained ∧ terminal ∧ clean ∧ bounded ∧ (identity_before=identity_after) ∧ (work_before=work_after)
example "trace collection at drained command boundary" { assert(ga110_trace_collect(as110_true(),as110_true(),as110_true(),as110_true(),as110_true(),bvconst(77,64),bvconst(77,64),bvconst(12,64),bvconst(12,64))) }
example "trace refuses running driver" { assert(¬(ga110_trace_collect(as110_false(),as110_true(),as110_true(),as110_true(),as110_true(),bvconst(77,64),bvconst(77,64),bvconst(12,64),bvconst(12,64)))) }
example "trace refuses pending DMA or completion or frame" { assert(¬(ga110_trace_collect(as110_true(),as110_false(),as110_true(),as110_true(),as110_true(),bvconst(77,64),bvconst(77,64),bvconst(12,64),bvconst(12,64)))) }
example "trace refuses nonterminal Fabric transaction" { assert(¬(ga110_trace_collect(as110_true(),as110_true(),as110_false(),as110_true(),as110_true(),bvconst(77,64),bvconst(77,64),bvconst(12,64),bvconst(12,64)))) }
example "trace refuses recorded fault" { assert(¬(ga110_trace_collect(as110_true(),as110_true(),as110_true(),as110_false(),as110_true(),bvconst(77,64),bvconst(77,64),bvconst(12,64),bvconst(12,64)))) }
example "trace refuses overflowed trace" { assert(¬(ga110_trace_collect(as110_true(),as110_true(),as110_true(),as110_true(),as110_false(),bvconst(77,64),bvconst(77,64),bvconst(12,64),bvconst(12,64)))) }
example "trace refuses transaction identity reset" { assert(¬(ga110_trace_collect(as110_true(),as110_true(),as110_true(),as110_true(),as110_true(),bvconst(77,64),bvconst(1,64),bvconst(12,64),bvconst(12,64)))) }
example "trace refuses session work refill" { assert(¬(ga110_trace_collect(as110_true(),as110_true(),as110_true(),as110_true(),as110_true(),bvconst(77,64),bvconst(77,64),bvconst(12,64),bvconst(13,64)))) }
