// Phase 10.7 userspace rebuild acceptance contract. No new axioms.
// Abstract conditional obligations, not a proof of compiler C semantics or a
// Rust implementation correspondence. Fixed-point evidence must come from the
// concrete 10.6 witness; no Boolean evidence is manufactured by source names.
// Host transport/observation is permitted, host language/toolchain semantics
// are excluded. Existing permissions, linker and preprocessing gates remain
// authoritative. This phase rebuilds applications under the typed profile.

import "anka106_cc2_self_host_closure.kleis"
import "anka107_application_pointers.kleis"
import "anka94g_http_contract.kleis"

// Select the exact sealed/current CC2_1 publication from the verified lineage.
// Same bytes alone do not authorize a stale or unrelated object generation.
define rebuild107_producer_valid(fixed_point_verified : Bool,
    expected_object : BitVec64, presented_object : BitVec64,
    expected_generation : BitVec64, presented_generation : BitVec64,
    sealed : Bool, current : Bool, explicit_compiler_execution : Bool) =
    if fixed_point_verified then
        if expected_object=presented_object then
            if expected_generation=presented_generation then
                if sealed then
                    if current then
                        if explicit_compiler_execution then true else false
                    else false
                else false
            else false
        else false
    else false

define rebuild107_host_boundary_valid(host_compile : Bool, host_preprocess : Bool,
    host_link : Bool, host_symbol_resolve : Bool, host_mutates_artifact : Bool) =
    if host_compile then false
    else if host_preprocess then false
    else if host_link then false
    else if host_symbol_resolve then false
    else if host_mutates_artifact then false
    else true

define rebuild107_sources_valid(
    bundle105_admitted : Bool,
    exact_member_bytes : Bool,
    exact_root : Bool,
    exact_include_profile : Bool,
    source_generation_current : Bool,
    preprocessor_artifact_exact_current : Bool,
    guest_preprocessing_admitted : Bool,
    effective_source_exact : Bool
) =
    if bundle105_admitted then
        if exact_member_bytes then
            if exact_root then
                if exact_include_profile then
                    if source_generation_current then
                        if preprocessor_artifact_exact_current then
                            if guest_preprocessing_admitted then
                                if effective_source_exact then
                                    true
                                else false
                            else false
                        else false
                    else false
                else false
            else false
        else false
    else false

define rebuild107_output_valid(
    exact_producer_admitted : Bool,
    sources_admitted : Bool,
    typed_application_profile_admitted : Bool,
    aom103_valid : Bool,
    linker_artifact_exact_current : Bool,
    guest_link104_publishable : Bool,
    linked_bytes_complete : Bool,
    linked_geometry_valid : Bool,
    output_sealed : Bool,
    output_generation_current : Bool,
    permissions_nonamplifying : Bool,
    host_boundary_admitted : Bool
) =
    if exact_producer_admitted then
        if sources_admitted then
            if typed_application_profile_admitted then
                if aom103_valid then
                    if linker_artifact_exact_current then
                        if guest_link104_publishable then
                            if linked_bytes_complete then
                                if linked_geometry_valid then
                                    if output_sealed then
                                        if output_generation_current then
                                            if permissions_nonamplifying then
                                                if host_boundary_admitted then
                                                    true
                                                else false
                                            else false
                                        else false
                                    else false
                                else false
                            else false
                        else false
                    else false
                else false
            else false
        else false
    else false

define rebuild107_run_valid(
    rebuild_output_admitted : Bool,
    exact_artifact_key : Bool,
    explicit_application_execution : Bool,
    ordinary_execution_admitted : Bool,
    physical_placement_admitted : Bool,
    virtual_layout_admitted : Bool
) =
    if rebuild_output_admitted then
        if exact_artifact_key then
            if explicit_application_execution then
                if ordinary_execution_admitted then
                    if physical_placement_admitted then
                        if virtual_layout_admitted then
                            true
                        else false
                    else false
                else false
            else false
        else false
    else false

define rebuild107_http_integration_valid(
    rebuilt_socket_service_admitted : Bool,
    rebuilt_http_service_admitted : Bool,
    exact_rebuilt_artifacts_booted : Bool,
    socket_contract_preserved : Bool,
    http_contract_preserved : Bool,
    http_has_no_nic_authority : Bool,
    exact_alive_request : Bool,
    exact_alive_response : Bool
) =
    if rebuilt_socket_service_admitted then
        if rebuilt_http_service_admitted then
            if exact_rebuilt_artifacts_booted then
                if socket_contract_preserved then
                    if http_contract_preserved then
                        if http_has_no_nic_authority then
                            if exact_alive_request then
                                if exact_alive_response then
                                    true
                                else false
                            else false
                        else false
                    else false
                else false
            else false
        else false
    else false

// Failure is pre-publication of the NEXT output; existing successfully built
// inputs/other units may remain. No success implication is made without failure.
define rebuild107_failed_build_safe(failed_stage : Bool,
    next_output_published : Bool, failed_output_executed : Bool) =
    if failed_stage then
        if next_output_published then false
        else if failed_output_executed then false
        else true
    else false

define rebuild107_names_create_execution_authority() = false
define rebuild107_pointer_profile_grants_nic_authority() = false

example "P107-1 exact CC2 publication" {
    assert(rebuild107_producer_valid(true,bvconst(7,64),bvconst(7,64),bvconst(3,64),bvconst(3,64),true,true,true)=true)
}

example "P107-2 reject unverified fixed point" {
    assert(rebuild107_producer_valid(false,bvconst(7,64),bvconst(7,64),bvconst(3,64),bvconst(3,64),true,true,true)=false)
}

example "P107-3 reject different compiler object" {
    assert(rebuild107_producer_valid(true,bvconst(7,64),bvconst(8,64),bvconst(3,64),bvconst(3,64),true,true,true)=false)
}

example "P107-4 reject stale compiler generation" {
    assert(rebuild107_producer_valid(true,bvconst(7,64),bvconst(7,64),bvconst(3,64),bvconst(2,64),true,true,true)=false)
}

example "P107-5 reject unsealed compiler" {
    assert(rebuild107_producer_valid(true,bvconst(7,64),bvconst(7,64),bvconst(3,64),bvconst(3,64),false,true,true)=false)
}

example "P107-6 reject noncurrent compiler" {
    assert(rebuild107_producer_valid(true,bvconst(7,64),bvconst(7,64),bvconst(3,64),bvconst(3,64),true,false,true)=false)
}

