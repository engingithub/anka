// Phase 10.8 A1 concrete proposed syscall/C refinement. SPECIFICATION ONLY.
// Current runtime ends at syscall 20 and exports scalar event results only.
// Reserve 21=SYS_MALLOC, 22=SYS_FREE. No new instruction or payload format.
// AC2 surface: void *malloc(int bytes); void free(void *pointer).
// int is the existing 64-bit scalar; this is not a full ISO C libc claim.
// malloc trap: R0=21, R1=bytes, R2..R5=0, pairs 0/2/4 scalar.
// malloc reply: R0/R1 protected pointer or canonical untagged NULL;
// R2 status (0 success incl. size-zero, 1 capacity, 2 invalid size), R3=0.
// free trap: R0=22,R1=0; R2/R3 exact typed argument; R4=R5=0.
// free reply: scalar R0=R1=0 only AFTER retirement, or immediate free(NULL).
// Invalid free/forged request is ProtectionFault with no allocator mutation.
// Other saved registers, kinds, controls and return authority are preserved.
// malloc results require NEW trusted event-result machinery; generic scalar
// results and handler scratch can never mint pointer kind. One event, one result.
import "anka108_allocation.kleis"
import "anka107_pointer_events.kleis"

define ha108_malloc_abi(number : BitVec64, reserved2 : BitVec64,
    reserved3 : BitVec64, reserved4 : BitVec64, reserved5 : BitVec64,
    kind01 : BitVec8, kind23 : BitVec8, kind45 : BitVec8) =
    (number=bvconst(21,64)) ∧ (reserved2=heap108_zero()) ∧
    (reserved3=heap108_zero()) ∧ (reserved4=heap108_zero()) ∧
    (reserved5=heap108_zero()) ∧ (kind01=bvconst(0,8)) ∧
    (kind23=bvconst(0,8)) ∧ (kind45=bvconst(0,8))
define ha108_free_abi(number : BitVec64, reserved1 : BitVec64,
    reserved4 : BitVec64, reserved5 : BitVec64,
    kind01 : BitVec8, kind45 : BitVec8) =
    (number=bvconst(22,64)) ∧ (reserved1=heap108_zero()) ∧
    (reserved4=heap108_zero()) ∧ (reserved5=heap108_zero()) ∧
    (kind01=bvconst(0,8)) ∧ (kind45=bvconst(0,8))
define ha108_null(h : BitVec64, pos : BitVec64, tag : BitVec8) =
    (h=heap108_zero()) ∧ (pos=heap108_zero()) ∧ (tag=bvconst(0,8))

// Saved syscall image is owned and intact. pid/incarnation are kernel-selected;
// event ID is a protected nonreused identity, not public depth or current CPU.
define ha108_event(saved_context : BitVec64, context : BitVec64,
    saved_domain : BitVec64, domain : BitVec64,
    public_depth : BitVec64, private_depth : BitVec64,
    header_exact : BitVec8, cause_syscall : BitVec8, supervisor : BitVec8,
    pid : BitVec64, saved_pid : BitVec64, incarnation : BitVec64,
    saved_incarnation : BitVec64, event : BitVec64, saved_event : BitVec64,
    pending : BitVec8, handler_frames_empty : BitVec8) =
    event107_admit(saved_context,context,saved_domain,domain,public_depth,
        private_depth,header_exact,bvconst(1,8),bvconst(1,8)) ∧
    bvugt(context,heap108_zero()) ∧ bvugt(incarnation,heap108_zero()) ∧
    (pid=saved_pid) ∧ (incarnation=saved_incarnation) ∧
    bvugt(event,heap108_zero()) ∧ (event=saved_event) ∧
    heap108_yes(cause_syscall) ∧ heap108_yes(supervisor) ∧
    heap108_yes(pending) ∧ heap108_yes(handler_frames_empty)

// The checked publication and reply are one serialized decision. If result
// delivery cannot be prepared, no allocation is published. A delayed reply
// must revalidate record liveness/owner before installing kind into the image.
define ha108_pointer_reply(event_ok : Bool, abi_ok : Bool, publication : Bool,
    phase : BitVec8, owner : Bool, number : BitVec64, slot : BitVec64, gen : BitVec64,
    published_slot : BitVec64, published_gen : BitVec64,
    h : BitVec64, pos : BitVec64, tag : BitVec8, status : BitVec64,
    scalar_mask : BitVec64, result_event : BitVec64, active_event : BitVec64,
    result_pending : BitVec8, serialized : BitVec8) =
    event_ok ∧ abi_ok ∧ publication ∧
    heap108_current(h,tag,slot,gen,phase,bvconst(2,8),owner) ∧
    (slot=published_slot) ∧ (gen=published_gen) ∧
    (number=bvconst(21,64)) ∧ repr107_components(slot,gen) ∧
    (h=repr107_handle(slot,gen)) ∧ (pos=heap108_zero()) ∧
    heap108_yes(tag) ∧ (status=heap108_zero()) ∧
    (scalar_mask=bvconst(12,64)) ∧ bvugt(active_event,heap108_zero()) ∧
    (result_event=active_event) ∧ heap108_yes(result_pending) ∧ heap108_yes(serialized)

// Nonallocation results have no grant, registry publication or charge. A1
// distinguishes zero size, a well-formed but unadmitted positive request, and
// negative/unrepresentable signed input. Neither word may retain old bits.
define ha108_null_reply(event_ok : Bool, abi_ok : Bool, n : BitVec64,
    capacity_failed : BitVec8, h : BitVec64, pos : BitVec64, tag : BitVec8,
    status : BitVec64, allocation_published : BitVec8) =
    event_ok ∧ abi_ok ∧ ha108_null(h,pos,tag) ∧
    (allocation_published=bvconst(0,8)) ∧
    (((n=heap108_zero()) ∧ (status=heap108_zero()) ∧ (capacity_failed=bvconst(0,8))) ∨
     (heap108_size(n) ∧ (status=bvconst(1,64)) ∧ heap108_yes(capacity_failed)) ∨
     (bvugt(n,heap108_signed_max()) ∧ (status=bvconst(2,64)) ∧ (capacity_failed=bvconst(0,8))))

define ha108_free_begin(event_ok : Bool, abi_ok : Bool,
    h : BitVec64, pos : BitVec64, tag : BitVec8, exact_free : Bool) =
    event_ok ∧ abi_ok ∧ (ha108_null(h,pos,tag) ∨
        (bvugt(h,heap108_zero()) ∧ heap108_yes(tag) ∧ exact_free))
define ha108_free_reply(event_ok : Bool, abi_ok : Bool, null_argument : Bool,
    close_committed : Bool, retire_committed : Bool, scalar0 : BitVec64,
    scalar1 : BitVec64, tag01 : BitVec8) =
    event_ok ∧ abi_ok ∧ (null_argument ∨ (close_committed ∧ retire_committed)) ∧
    (scalar0=heap108_zero()) ∧ (scalar1=heap108_zero()) ∧ (tag01=bvconst(0,8))

// Apply a validated malloc reply to the SAME saved image atomically; status is
// outside the pointer pair. No generic scalar overlay may then destroy/mint it.
// Full frame control/flags/return authority use the existing owned restore rule.
define ha108_malloc_word(accepted : Bool, lane : BitVec64, saved : BitVec64,
    h : BitVec64, pos : BitVec64, status : BitVec64) =
    if accepted then
        if lane=bvconst(0,64) then h else
        if lane=bvconst(1,64) then pos else
        if lane=bvconst(2,64) then status else
        if lane=bvconst(3,64) then heap108_zero() else saved
    else saved
define ha108_malloc_kind(accepted : Bool, pair : BitVec64,
    saved : BitVec8, result_tag : BitVec8) =
    if accepted then
        if pair=bvconst(0,64) then result_tag else
        if pair=bvconst(2,64) then bvconst(0,8) else saved
    else saved
define ha108_pending_after(accepted : Bool, before : BitVec8) =
    if accepted then bvconst(0,8) else before

// CC2 uses existing ABI v2 lanes: scalar malloc arg R0, free pointer arg R0/R1,
// malloc pointer return R0/R1. Move free argument to R2/R3 with PMOV BEFORE
// writing syscall 22 into R0; numeric MOV would destroy authenticity.
define ha108_lower_malloc(parameter : BitVec64, return_first : BitVec64,
    return_second : BitVec64, result_checked : BitVec8) =
    (parameter=bvconst(0,64)) ∧
    kind107_return(bvconst(1,8),return_first,return_second,result_checked)
define ha108_lower_free(source : BitVec64, destination : BitVec64,
    typed_move : BitVec8, before_number : BitVec8) =
    (source=bvconst(0,64)) ∧ (destination=bvconst(2,64)) ∧
    heap108_yes(typed_move) ∧ heap108_yes(before_number)
// A supported void*/T* conversion preserves all words, kind and view. Casts
// cannot create integer provenance, enlarge bounds or alter the allocator class.
define ha108_pointer_conversion(h : BitVec64, pos : BitVec64, tag : BitVec8,
    result_h : BitVec64, result_pos : BitVec64, result_tag : BitVec8,
    object_pointer_types : BitVec8) =
    (h=result_h) ∧ (pos=result_pos) ∧ (tag=result_tag) ∧
    ((tag=bvconst(0,8)) ∨ (tag=bvconst(1,8))) ∧ heap108_yes(object_pointer_types)



// A1 executable witnesses: ordinary cases, hostile boundaries, and general laws.

example "ha108_malloc_abi accepts" {
    assert(ha108_malloc_abi(bvconst(21,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8),bvconst(0,8)))
}

example "ha108_malloc_abi rejects wrong syscall" {
    assert(¬(ha108_malloc_abi(bvconst(20,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8),bvconst(0,8))))
}

example "ha108_malloc_abi rejects reserved R2" {
    assert(¬(ha108_malloc_abi(bvconst(21,64),bvconst(1,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8),bvconst(0,8))))
}

example "ha108_malloc_abi rejects reserved R3" {
    assert(¬(ha108_malloc_abi(bvconst(21,64),bvconst(0,64),bvconst(1,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8),bvconst(0,8))))
}

example "ha108_malloc_abi rejects reserved R4" {
    assert(¬(ha108_malloc_abi(bvconst(21,64),bvconst(0,64),bvconst(0,64),bvconst(1,64),bvconst(0,64),bvconst(0,8),bvconst(0,8),bvconst(0,8))))
}

example "ha108_malloc_abi rejects reserved R5" {
    assert(¬(ha108_malloc_abi(bvconst(21,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(1,64),bvconst(0,8),bvconst(0,8),bvconst(0,8))))
}

example "ha108_malloc_abi rejects pointer as size" {
    assert(¬(ha108_malloc_abi(bvconst(21,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(0,8),bvconst(0,8))))
}

example "ha108_malloc_abi rejects unexpected R2 pointer" {
    assert(¬(ha108_malloc_abi(bvconst(21,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(1,8),bvconst(0,8))))
}

example "ha108_malloc_abi rejects unexpected R4 pointer" {
    assert(¬(ha108_malloc_abi(bvconst(21,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8),bvconst(1,8))))
}

example "ha108_free_abi accepts" {
    assert(ha108_free_abi(bvconst(22,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8)))
}

example "ha108_free_abi rejects wrong syscall" {
    assert(¬(ha108_free_abi(bvconst(21,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8))))
}

example "ha108_free_abi rejects reserved R1" {
    assert(¬(ha108_free_abi(bvconst(22,64),bvconst(1,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8))))
}

example "ha108_free_abi rejects reserved R4" {
    assert(¬(ha108_free_abi(bvconst(22,64),bvconst(0,64),bvconst(1,64),bvconst(0,64),bvconst(0,8),bvconst(0,8))))
}

example "ha108_free_abi rejects reserved R5" {
