// Phase 10.9 T1: direct-anchor recognition and authority vocabulary.
// Zero new axioms. ADT records are a semantic model, not a wire/storage ABI.
// Evidence verdicts are outputs of a trusted validator over ALL record fields,
// including presenter possession bound to the current challenge. Untrusted
// programs must never be allowed to construct A109Valid evidence records.
// Cryptography, trustworthy time/revocation observation, durable enrollment and
// exclusive current-state observation are explicit refinement obligations.
// 64-bit identifiers denote opaque equality handles, not human names/hashes.
// Zero is reserved for absent identity; counters fail closed before wrapping.
// Epoch is the trusted CURRENT authority-policy revision; a matching number
// alone is insufficient without A109Valid current-status evidence.
import "stdlib/prelude.kleis"
data A109Verdict = A109Unknown | A109Invalid | A109Valid
define a109_z() = bvconst(0,64)
define a109_one() = bvconst(1,64)
define a109_max() = bvsub(bvconst(0,64),bvconst(1,64))
define a109_nonzero(n : BitVec64) = bvugt(n,a109_z())
define a109_next(n : BitVec64) = if bvult(n,a109_max()) then bvadd(n,a109_one()) else n
define a109_kind(k : BitVec64) = (k=bvconst(1,64)) ∨ (k=bvconst(2,64)) ∨ (k=bvconst(3,64))
// Principal kinds: person=1, installation=2, workload=3. All are anchor-scoped.
define a109_window(now : BitVec64, first : BitVec64, until : BitVec64) =
    bvult(first,until) ∧ bvule(first,now) ∧ bvult(now,until)
// Exactly the existing I7 permission-subset and subtractive span predicates.
// T1 rechecks each grant/request directly; it assumes no 8-bit range lifting.
define a109_rights(parent : BitVec8, child : BitVec8) = bvand(parent,child)=child
define a109_span(off : BitVec64, len : BitVec64, size : BitVec64) =
    a109_nonzero(len) ∧ bvule(len,size) ∧ bvule(off,bvsub(size,len))
define a109_within(off : BitVec64, len : BitVec64, base : BitVec64, extent : BitVec64) =
    a109_nonzero(len) ∧ bvule(base,off) ∧ bvule(len,extent) ∧ bvule(bvsub(off,base),bvsub(extent,len))
data A109Context = A109Context(anchor : BitVec64, installation : BitVec64, epoch : BitVec64, challenge : BitVec64, now : BitVec64, selected : Bool)
define ctx_anchor(v : A109Context) = match v { A109Context(anchor, installation, epoch, challenge, now, selected) => anchor }
define ctx_installation(v : A109Context) = match v { A109Context(anchor, installation, epoch, challenge, now, selected) => installation }
define ctx_epoch(v : A109Context) = match v { A109Context(anchor, installation, epoch, challenge, now, selected) => epoch }
define ctx_challenge(v : A109Context) = match v { A109Context(anchor, installation, epoch, challenge, now, selected) => challenge }
define ctx_now(v : A109Context) = match v { A109Context(anchor, installation, epoch, challenge, now, selected) => now }
define ctx_selected(v : A109Context) = match v { A109Context(anchor, installation, epoch, challenge, now, selected) => selected }
data A109Identity = A109Identity(issuer : BitVec64, subject : BitVec64, kind : BitVec64, audience : BitVec64, epoch : BitVec64, challenge : BitVec64, first : BitVec64, until : BitVec64, authentic : A109Verdict, possession : A109Verdict, status : A109Verdict)
define ident_issuer(v : A109Identity) = match v { A109Identity(issuer, subject, kind, audience, epoch, challenge, first, until, authentic, possession, status) => issuer }
define ident_subject(v : A109Identity) = match v { A109Identity(issuer, subject, kind, audience, epoch, challenge, first, until, authentic, possession, status) => subject }
define ident_kind(v : A109Identity) = match v { A109Identity(issuer, subject, kind, audience, epoch, challenge, first, until, authentic, possession, status) => kind }
define ident_audience(v : A109Identity) = match v { A109Identity(issuer, subject, kind, audience, epoch, challenge, first, until, authentic, possession, status) => audience }
define ident_epoch(v : A109Identity) = match v { A109Identity(issuer, subject, kind, audience, epoch, challenge, first, until, authentic, possession, status) => epoch }
define ident_challenge(v : A109Identity) = match v { A109Identity(issuer, subject, kind, audience, epoch, challenge, first, until, authentic, possession, status) => challenge }
define ident_first(v : A109Identity) = match v { A109Identity(issuer, subject, kind, audience, epoch, challenge, first, until, authentic, possession, status) => first }
define ident_until(v : A109Identity) = match v { A109Identity(issuer, subject, kind, audience, epoch, challenge, first, until, authentic, possession, status) => until }
define ident_authentic(v : A109Identity) = match v { A109Identity(issuer, subject, kind, audience, epoch, challenge, first, until, authentic, possession, status) => authentic }
define ident_possession(v : A109Identity) = match v { A109Identity(issuer, subject, kind, audience, epoch, challenge, first, until, authentic, possession, status) => possession }
define ident_status(v : A109Identity) = match v { A109Identity(issuer, subject, kind, audience, epoch, challenge, first, until, authentic, possession, status) => status }
define a109_context(c : A109Context) = ctx_selected(c) ∧ a109_nonzero(ctx_anchor(c)) ∧ a109_nonzero(ctx_installation(c)) ∧ a109_nonzero(ctx_epoch(c)) ∧ a109_nonzero(ctx_challenge(c))
define a109_recognize(c : A109Context, e : A109Identity, subject : BitVec64, kind : BitVec64) =
    a109_context(c) ∧ a109_nonzero(subject) ∧ a109_kind(kind) ∧
    (ident_issuer(e)=ctx_anchor(c)) ∧ (ident_subject(e)=subject) ∧ (ident_kind(e)=kind) ∧
    (ident_audience(e)=ctx_installation(c)) ∧ (ident_epoch(e)=ctx_epoch(c)) ∧
    (ident_challenge(e)=ctx_challenge(c)) ∧ a109_window(ctx_now(c),ident_first(e),ident_until(e)) ∧
    (ident_authentic(e)=A109Valid) ∧ (ident_possession(e)=A109Valid) ∧ (ident_status(e)=A109Valid)

example "selected anchor recognizes person" { assert(a109_recognize(A109Context(bvconst(10,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(100,64), (bvconst(1,8)=bvconst(1,8))),A109Identity(bvconst(10,64), bvconst(30,64), bvconst(1,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(90,64), bvconst(110,64), A109Valid, A109Valid, A109Valid),bvconst(30,64),bvconst(1,64))) }
example "principal kind 2" { assert(a109_recognize(A109Context(bvconst(10,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(100,64), (bvconst(1,8)=bvconst(1,8))),A109Identity(bvconst(10,64), bvconst(30,64), bvconst(2,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(90,64), bvconst(110,64), A109Valid, A109Valid, A109Valid),bvconst(30,64),bvconst(2,64))) }
example "principal kind 3" { assert(a109_recognize(A109Context(bvconst(10,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(100,64), (bvconst(1,8)=bvconst(1,8))),A109Identity(bvconst(10,64), bvconst(30,64), bvconst(3,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(90,64), bvconst(110,64), A109Valid, A109Valid, A109Valid),bvconst(30,64),bvconst(3,64))) }
example "identity rejected: issuer 1" { assert(¬(a109_recognize(A109Context(bvconst(10,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(100,64), (bvconst(1,8)=bvconst(1,8))),A109Identity(bvconst(11,64), bvconst(30,64), bvconst(1,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(90,64), bvconst(110,64), A109Valid, A109Valid, A109Valid),bvconst(30,64),bvconst(1,64)))) }
example "identity rejected: subject 1" { assert(¬(a109_recognize(A109Context(bvconst(10,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(100,64), (bvconst(1,8)=bvconst(1,8))),A109Identity(bvconst(10,64), bvconst(31,64), bvconst(1,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(90,64), bvconst(110,64), A109Valid, A109Valid, A109Valid),bvconst(30,64),bvconst(1,64)))) }
example "identity rejected: subject 2" { assert(¬(a109_recognize(A109Context(bvconst(10,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(100,64), (bvconst(1,8)=bvconst(1,8))),A109Identity(bvconst(10,64), bvconst(0,64), bvconst(1,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(90,64), bvconst(110,64), A109Valid, A109Valid, A109Valid),bvconst(30,64),bvconst(1,64)))) }
example "identity rejected: kind 1" { assert(¬(a109_recognize(A109Context(bvconst(10,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(100,64), (bvconst(1,8)=bvconst(1,8))),A109Identity(bvconst(10,64), bvconst(30,64), bvconst(2,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(90,64), bvconst(110,64), A109Valid, A109Valid, A109Valid),bvconst(30,64),bvconst(1,64)))) }
example "identity rejected: kind 2" { assert(¬(a109_recognize(A109Context(bvconst(10,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(100,64), (bvconst(1,8)=bvconst(1,8))),A109Identity(bvconst(10,64), bvconst(30,64), bvconst(0,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(90,64), bvconst(110,64), A109Valid, A109Valid, A109Valid),bvconst(30,64),bvconst(1,64)))) }
example "identity rejected: kind 3" { assert(¬(a109_recognize(A109Context(bvconst(10,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(100,64), (bvconst(1,8)=bvconst(1,8))),A109Identity(bvconst(10,64), bvconst(30,64), bvconst(4,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(90,64), bvconst(110,64), A109Valid, A109Valid, A109Valid),bvconst(30,64),bvconst(1,64)))) }
example "identity rejected: audience 1" { assert(¬(a109_recognize(A109Context(bvconst(10,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(100,64), (bvconst(1,8)=bvconst(1,8))),A109Identity(bvconst(10,64), bvconst(30,64), bvconst(1,64), bvconst(21,64), bvconst(3,64), bvconst(7,64), bvconst(90,64), bvconst(110,64), A109Valid, A109Valid, A109Valid),bvconst(30,64),bvconst(1,64)))) }
