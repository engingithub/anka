example "law: recognition binds root subject kind audience and challenge" { assert(∀ c_anchor : BitVec64 . ∀ c_installation : BitVec64 . ∀ c_epoch : BitVec64 . ∀ c_challenge : BitVec64 . ∀ c_now : BitVec64 . ∀ c_selected : Bool .  ∀ e_issuer : BitVec64 . ∀ e_subject : BitVec64 . ∀ e_kind : BitVec64 . ∀ e_audience : BitVec64 . ∀ e_epoch : BitVec64 . ∀ e_challenge : BitVec64 . ∀ e_first : BitVec64 . ∀ e_until : BitVec64 . ∀ e_authentic : A109Verdict . ∀ e_possession : A109Verdict . ∀ e_status : A109Verdict .  ∀ s : BitVec64 . ∀ k : BitVec64 . a109_recognize(A109Context(c_anchor,c_installation,c_epoch,c_challenge,c_now,c_selected),A109Identity(e_issuer,e_subject,e_kind,e_audience,e_epoch,e_challenge,e_first,e_until,e_authentic,e_possession,e_status),s,k) ⟹ ((ident_issuer(A109Identity(e_issuer,e_subject,e_kind,e_audience,e_epoch,e_challenge,e_first,e_until,e_authentic,e_possession,e_status))=ctx_anchor(A109Context(c_anchor,c_installation,c_epoch,c_challenge,c_now,c_selected))) ∧ (ident_subject(A109Identity(e_issuer,e_subject,e_kind,e_audience,e_epoch,e_challenge,e_first,e_until,e_authentic,e_possession,e_status))=s) ∧ (ident_kind(A109Identity(e_issuer,e_subject,e_kind,e_audience,e_epoch,e_challenge,e_first,e_until,e_authentic,e_possession,e_status))=k) ∧ (ident_audience(A109Identity(e_issuer,e_subject,e_kind,e_audience,e_epoch,e_challenge,e_first,e_until,e_authentic,e_possession,e_status))=ctx_installation(A109Context(c_anchor,c_installation,c_epoch,c_challenge,c_now,c_selected))) ∧ (ident_challenge(A109Identity(e_issuer,e_subject,e_kind,e_audience,e_epoch,e_challenge,e_first,e_until,e_authentic,e_possession,e_status))=ctx_challenge(A109Context(c_anchor,c_installation,c_epoch,c_challenge,c_now,c_selected))))) }
example "law: unknown revocation evidence cannot recognize" { assert(∀ c_anchor : BitVec64 . ∀ c_installation : BitVec64 . ∀ c_epoch : BitVec64 . ∀ c_challenge : BitVec64 . ∀ c_now : BitVec64 . ∀ c_selected : Bool .  ∀ e_issuer : BitVec64 . ∀ e_subject : BitVec64 . ∀ e_kind : BitVec64 . ∀ e_audience : BitVec64 . ∀ e_epoch : BitVec64 . ∀ e_challenge : BitVec64 . ∀ e_first : BitVec64 . ∀ e_until : BitVec64 . ∀ e_authentic : A109Verdict . ∀ e_possession : A109Verdict . ∀ e_status : A109Verdict .  ∀ s : BitVec64 . ∀ k : BitVec64 . (ident_status(A109Identity(e_issuer,e_subject,e_kind,e_audience,e_epoch,e_challenge,e_first,e_until,e_authentic,e_possession,e_status))=A109Unknown) ⟹ ¬a109_recognize(A109Context(c_anchor,c_installation,c_epoch,c_challenge,c_now,c_selected),A109Identity(e_issuer,e_subject,e_kind,e_audience,e_epoch,e_challenge,e_first,e_until,e_authentic,e_possession,e_status),s,k)) }
example "law: validity excludes expiry boundary" { assert(∀ n : BitVec64 . ∀ f : BitVec64 . ¬a109_window(n,f,n)) }
example "law: permission attenuation transitive" { assert(∀ a : BitVec8 . ∀ b : BitVec8 . ∀ c : BitVec8 . (a109_rights(a,b) ∧ a109_rights(b,c)) ⟹ a109_rights(a,c)) }
example "law: checked next never wraps" { assert(∀ n : BitVec64 . bvuge(a109_next(n),n)) }
example "law: checked next advances below max" { assert(∀ n : BitVec64 . bvult(n,a109_max()) ⟹ bvugt(a109_next(n),n)) }
example "range ending at maximum is representable" { assert(a109_span(bvsub(bvconst(0,64),bvconst(17,64)),bvconst(16,64),a109_max())) }
example "overflowing range denied" { assert(¬a109_span(bvsub(bvconst(0,64),bvconst(9,64)),bvconst(16,64),a109_max())) }
example "one past nonempty request denied" { assert(¬a109_within(bvconst(128,64),bvconst(1,64),bvconst(0,64),bvconst(128,64))) }
