example "identity rejected: authentic 1" { assert(¬(a109_recognize(A109Context(bvconst(10,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(100,64), (bvconst(1,8)=bvconst(1,8))),A109Identity(bvconst(10,64), bvconst(30,64), bvconst(1,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(90,64), bvconst(110,64), A109Invalid, A109Valid, A109Valid),bvconst(30,64),bvconst(1,64)))) }
