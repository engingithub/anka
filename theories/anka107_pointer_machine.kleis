// Proposed Core/Fabric transition refinement, no implementation or new axioms.
// Pointwise next-state functions model actual payload/tag effects, not just
// acceptance flags. Source operands are captured from PRE-state before mutation.
// Semantic classes PMOV/PADD/PLOAD/PSTORE/PREAD/PWRITE are not assigned opcodes.
// Fabric tag+payload commit is serialized; precommit rejection is a data no-op.
// Control/fault metadata may change on rejection, operand state may not.
import "anka107_pointer_kind_abi.kleis"

// Only terminal COMMITTED=3 may expose operand effects. Prepared=2 is not commit.
define machine107_committed(stage : BitVec8) = stage=bvconst(3,8)
define machine107_precommit(stage : BitVec8, live_ticket : BitVec8,
    fabric_current : BitVec8, checked_span : BitVec8, payload_exact : BitVec8,
    protected_key : BitVec8, serialized : BitVec8) =
    (stage=bvconst(2,8)) ∧ (live_ticket=bvconst(1,8)) ∧
    (fabric_current=bvconst(1,8)) ∧ (checked_span=bvconst(1,8)) ∧
    (payload_exact=bvconst(1,8)) ∧ (protected_key=bvconst(1,8)) ∧
    (serialized=bvconst(1,8))
define machine107_terminal(precommit_ok : BitVec8) =
    if precommit_ok=bvconst(1,8) then bvconst(3,8) else bvconst(4,8)

// PMOV/PLOAD/PADD destination data: replace both words at ONE transition.
// Captured handle/position are PRE-state source or checked PADD result.
define machine107_pair_word(stage : BitVec8, dst : BitVec64, queried : BitVec64,
    captured_handle : BitVec64, captured_pos : BitVec64, old : BitVec64) =
    if machine107_committed(stage) then
        if queried=dst then captured_handle else
        if queried=bvadd(dst,bvconst(1,64)) then captured_pos else old
    else old
define machine107_pair_tag(stage : BitVec8, dst : BitVec64, queried_pair : BitVec64,
    captured_tag : BitVec8, oldtag : BitVec8) =
    if machine107_committed(stage) then
        if queried_pair=dst then captured_tag else oldtag
    else oldtag

// Pair effects can be selected only after validating operand pair identities,
// actual metadata transport, and serialized source snapshot.
define machine107_pair_transition(dst : BitVec64, src : BitVec64,
    h : BitVec64, pos : BitVec64, tag : BitVec8,
    outh : BitVec64, outpos : BitVec64, outtag : BitVec8,
    source_snapshot : BitVec8, source_authenticated : BitVec8) =
    kind107_pair(dst) ∧ kind107_pair(src) ∧
    kind107_transport(h,pos,tag,outh,outpos,outtag,source_snapshot) ∧
    (source_authenticated=bvconst(1,8))

// Ordinary Core/OS register writes use a common barrier, including loads,
// syscall results, event completions and atomic-exchange results. CMP has no
// destination write and must not call this barrier.
define machine107_raw_reg_word(stage : BitVec8, dst : BitVec64, query : BitVec64,
    value : BitVec64, old : BitVec64) =
    if machine107_committed(stage) then if dst=query then value else old else old
define machine107_raw_reg_tag(stage : BitVec8, dst : BitVec64,
    pair : BitVec64, oldtag : BitVec8) =
    if machine107_committed(stage) then kind107_raw_register(pair,dst,oldtag) else oldtag

// PSTORE exact payload order is little endian: handle bytes 0..7, pos 8..15.
// Typed READ/WRITE admission requires one contiguous object span of length 16;
// two separately committed eight-byte transactions are NOT equivalent.
define machine107_pointer_request(object : BitVec64, expected_object : BitVec64,
    gen : BitVec64, expected_gen : BitVec64,
    offset : BitVec64, expected_offset : BitVec64, extent : BitVec64,
    length : BitVec64, typed_kind : BitVec8) =
    (object=expected_object) ∧ (gen=expected_gen) ∧ (offset=expected_offset) ∧
    kind107_cell(offset,extent) ∧ (length=bvconst(16,64)) ∧
    (typed_kind=bvconst(1,8))
define machine107_payload_byte(h : BitVec64, pos : BitVec64, index : BitVec64) =
    if bvult(index,bvconst(8,64))
    then bvand(bvlshr(h,bvmul(index,bvconst(8,64))),bvconst(255,64))
    else bvand(bvlshr(pos,bvmul(bvsub(index,bvconst(8,64)),bvconst(8,64))),bvconst(255,64))
define machine107_typed_byte(stage : BitVec8, offset : BitVec64, query : BitVec64,
    h : BitVec64, pos : BitVec64, old : BitVec64) =
    if machine107_committed(stage) then
        if bvuge(query,offset) ∧ bvult(bvsub(query,offset),bvconst(16,64))
        then machine107_payload_byte(h,pos,bvsub(query,offset)) else old
    else old
define machine107_typed_tag(stage : BitVec8, cell : BitVec64, querycell : BitVec64,
    source_tag : BitVec8, oldtag : BitVec8) =
    if machine107_committed(stage) then if cell=querycell then source_tag else oldtag else oldtag

// Generic Store/StoreByte/Atomic/DMA paths clear all overlapping tag cells in
// the SAME serialized mutation; failed precommit changes neither tags nor bytes.
define machine107_raw_mem_tag(stage : BitVec8, offset : BitVec64, length : BitVec64,
    querycell : BitVec64, oldtag : BitVec8) =
    if machine107_committed(stage)
    then kind107_raw_memory(offset,length,querycell,oldtag) else oldtag

// V2 application cannot bypass pointer checks with legacy raw-address operands.
// Kernel/bootstrap policy is separate and still requires Fabric admission.
define machine107_raw_address_allowed(application_v2 : BitVec8, fabric : BitVec8) =
    (application_v2=bvconst(0,8)) ∧ (fabric=bvconst(1,8))

// Protected context image must have current thread/domain binding and coherent
// payload+tags before any return-state effects. Failure preserves prior state.
define machine107_restore_tag(stage : BitVec8, image_tag : BitVec8, oldtag : BitVec8) =
    if machine107_committed(stage) then image_tag else oldtag
// Trap entry captures user pair state then clears handler-visible tags; resume
// uses protected saved image, not user-writable event-frame payload.
define machine107_handler_tag(stage : BitVec8, oldtag : BitVec8) =
    if machine107_committed(stage) then bvconst(0,8) else oldtag
// The complete payload+tag image remains inaccessible to user or DMA memory.
define machine107_context_admit(saved_thread : BitVec64, thread : BitVec64,
    saved_domain : BitVec64, domain : BitVec64,
    protected_image : BitVec8, coherent : BitVec8, return_frame_current : BitVec8) =
    kind107_context(saved_thread,thread,saved_domain,domain,protected_image,coherent) ∧
    (return_frame_current=bvconst(1,8))

example "MACHINE107-1 prepared precommit all checks" { assert(machine107_precommit(bvconst(2,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8))) }

example "MACHINE107-2 authorized not prepared" { assert(¬(machine107_precommit(bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))) }

example "MACHINE107-3 missing active lease" { assert(¬(machine107_precommit(bvconst(2,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))) }

example "MACHINE107-4 revoked before commit" { assert(¬(machine107_precommit(bvconst(2,8),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))) }

example "MACHINE107-5 unchecked physical span" { assert(¬(machine107_precommit(bvconst(2,8),bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))) }

example "MACHINE107-6 short typed payload" { assert(¬(machine107_precommit(bvconst(2,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8)))) }

example "MACHINE107-7 wrong protected key" { assert(¬(machine107_precommit(bvconst(2,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(1,8)))) }

example "MACHINE107-8 unsynchronized commit" { assert(¬(machine107_precommit(bvconst(2,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,8)))) }

example "MACHINE107-9 PMOV from prestate pair" { assert(machine107_pair_transition(bvconst(4,64),bvconst(0,64),bvconst(4294967303,64),bvconst(8,64),bvconst(1,8),bvconst(4294967303,64),bvconst(8,64),bvconst(1,8),bvconst(1,8),bvconst(1,8))) }

example "MACHINE107-10 unaligned destination pair" { assert(¬(machine107_pair_transition(bvconst(5,64),bvconst(0,64),bvconst(4294967303,64),bvconst(8,64),bvconst(1,8),bvconst(4294967303,64),bvconst(8,64),bvconst(1,8),bvconst(1,8),bvconst(1,8)))) }

example "MACHINE107-11 reserved source registers" { assert(¬(machine107_pair_transition(bvconst(4,64),bvconst(13,64),bvconst(4294967303,64),bvconst(8,64),bvconst(1,8),bvconst(4294967303,64),bvconst(8,64),bvconst(1,8),bvconst(1,8),bvconst(1,8)))) }

example "MACHINE107-12 PMOV changes allocation descriptor" { assert(¬(machine107_pair_transition(bvconst(4,64),bvconst(0,64),bvconst(4294967303,64),bvconst(8,64),bvconst(1,8),bvconst(4294967304,64),bvconst(8,64),bvconst(1,8),bvconst(1,8),bvconst(1,8)))) }

example "MACHINE107-13 PMOV changes position" { assert(¬(machine107_pair_transition(bvconst(4,64),bvconst(0,64),bvconst(4294967303,64),bvconst(8,64),bvconst(1,8),bvconst(4294967303,64),bvconst(9,64),bvconst(1,8),bvconst(1,8),bvconst(1,8)))) }

example "MACHINE107-14 PMOV drops kind" { assert(¬(machine107_pair_transition(bvconst(4,64),bvconst(0,64),bvconst(4294967303,64),bvconst(8,64),bvconst(1,8),bvconst(4294967303,64),bvconst(8,64),bvconst(0,8),bvconst(1,8),bvconst(1,8)))) }

example "MACHINE107-15 source snapshot torn" { assert(¬(machine107_pair_transition(bvconst(4,64),bvconst(0,64),bvconst(4294967303,64),bvconst(8,64),bvconst(1,8),bvconst(4294967303,64),bvconst(8,64),bvconst(1,8),bvconst(0,8),bvconst(1,8)))) }

example "MACHINE107-16 forged source pair" { assert(¬(machine107_pair_transition(bvconst(4,64),bvconst(0,64),bvconst(4294967303,64),bvconst(8,64),bvconst(1,8),bvconst(4294967303,64),bvconst(8,64),bvconst(1,8),bvconst(1,8),bvconst(0,8)))) }

example "MACHINE107-17 exact typed Fabric pointer request" { assert(machine107_pointer_request(bvconst(7,64),bvconst(7,64),bvconst(2,64),bvconst(2,64),bvconst(16,64),bvconst(16,64),bvconst(64,64),bvconst(16,64),bvconst(1,8))) }

example "MACHINE107-18 request object mismatch" { assert(¬(machine107_pointer_request(bvconst(7,64),bvconst(8,64),bvconst(2,64),bvconst(2,64),bvconst(16,64),bvconst(16,64),bvconst(64,64),bvconst(16,64),bvconst(1,8)))) }

example "MACHINE107-19 request generation mismatch" { assert(¬(machine107_pointer_request(bvconst(7,64),bvconst(7,64),bvconst(2,64),bvconst(3,64),bvconst(16,64),bvconst(16,64),bvconst(64,64),bvconst(16,64),bvconst(1,8)))) }

example "MACHINE107-20 request offset mismatch" { assert(¬(machine107_pointer_request(bvconst(7,64),bvconst(7,64),bvconst(2,64),bvconst(2,64),bvconst(16,64),bvconst(32,64),bvconst(64,64),bvconst(16,64),bvconst(1,8)))) }

example "MACHINE107-21 request cell unaligned" { assert(¬(machine107_pointer_request(bvconst(7,64),bvconst(7,64),bvconst(2,64),bvconst(2,64),bvconst(8,64),bvconst(16,64),bvconst(64,64),bvconst(16,64),bvconst(1,8)))) }

example "MACHINE107-22 split word pointer transaction" { assert(¬(machine107_pointer_request(bvconst(7,64),bvconst(7,64),bvconst(2,64),bvconst(2,64),bvconst(16,64),bvconst(16,64),bvconst(64,64),bvconst(8,64),bvconst(1,8)))) }

example "MACHINE107-23 widened pointer transaction" { assert(¬(machine107_pointer_request(bvconst(7,64),bvconst(7,64),bvconst(2,64),bvconst(2,64),bvconst(16,64),bvconst(16,64),bvconst(64,64),bvconst(24,64),bvconst(1,8)))) }

example "MACHINE107-24 ordinary bytes pretend typed request" { assert(¬(machine107_pointer_request(bvconst(7,64),bvconst(7,64),bvconst(2,64),bvconst(2,64),bvconst(16,64),bvconst(16,64),bvconst(64,64),bvconst(16,64),bvconst(0,8)))) }

