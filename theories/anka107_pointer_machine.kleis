example "MACHINE107 prepared pair has no effects" { assert(machine107_pair_word(bvconst(2,8),bvconst(4,64),bvconst(4,64),bvconst(4294967303,64),bvconst(8,64),bvconst(99,64))=bvconst(99,64)) }

example "MACHINE107 PMOV commits kind" { assert(machine107_pair_tag(bvconst(3,8),bvconst(4,64),bvconst(4,64),bvconst(1,8),bvconst(0,8))=bvconst(1,8)) }

example "MACHINE107 fault preserves pair kind" { assert(machine107_pair_tag(bvconst(4,8),bvconst(4,64),bvconst(4,64),bvconst(0,8),bvconst(1,8))=bvconst(1,8)) }

example "MACHINE107 ordinary reg write clears kind" { assert(machine107_raw_reg_tag(bvconst(3,8),bvconst(5,64),bvconst(4,64),bvconst(1,8))=bvconst(0,8)) }

example "MACHINE107 faulting load preserves kind" { assert(machine107_raw_reg_tag(bvconst(4,8),bvconst(5,64),bvconst(4,64),bvconst(1,8))=bvconst(1,8)) }

example "MACHINE107 raw store invalidates tag" { assert(machine107_raw_mem_tag(bvconst(3,8),bvconst(31,64),bvconst(1,64),bvconst(16,64),bvconst(1,8))=bvconst(0,8)) }

example "MACHINE107 fault store preserves tag" { assert(machine107_raw_mem_tag(bvconst(4,8),bvconst(31,64),bvconst(1,64),bvconst(16,64),bvconst(1,8))=bvconst(1,8)) }

example "MACHINE107 typed store commits kind" { assert(machine107_typed_tag(bvconst(3,8),bvconst(16,64),bvconst(16,64),bvconst(1,8),bvconst(0,8))=bvconst(1,8)) }

example "MACHINE107 typed null clears kind" { assert(machine107_typed_tag(bvconst(3,8),bvconst(16,64),bvconst(16,64),bvconst(0,8),bvconst(1,8))=bvconst(0,8)) }

example "MACHINE107 failed typed store keeps kind" { assert(machine107_typed_tag(bvconst(4,8),bvconst(16,64),bvconst(16,64),bvconst(0,8),bvconst(1,8))=bvconst(1,8)) }

example "MACHINE107 PSTORE handle low byte first" { assert(machine107_typed_byte(bvconst(3,8),bvconst(16,64),bvconst(16,64),bvconst(258,64),bvconst(772,64),bvconst(99,64))=bvconst(2,64)) }

example "MACHINE107 PSTORE handle second byte" { assert(machine107_typed_byte(bvconst(3,8),bvconst(16,64),bvconst(17,64),bvconst(258,64),bvconst(772,64),bvconst(99,64))=bvconst(1,64)) }

example "MACHINE107 PSTORE position low byte at eight" { assert(machine107_typed_byte(bvconst(3,8),bvconst(16,64),bvconst(24,64),bvconst(258,64),bvconst(772,64),bvconst(99,64))=bvconst(4,64)) }

example "MACHINE107 PSTORE position second byte" { assert(machine107_typed_byte(bvconst(3,8),bvconst(16,64),bvconst(25,64),bvconst(258,64),bvconst(772,64),bvconst(99,64))=bvconst(3,64)) }

example "MACHINE107 PSTORE fault preserves byte" { assert(machine107_typed_byte(bvconst(4,8),bvconst(16,64),bvconst(24,64),bvconst(258,64),bvconst(772,64),bvconst(99,64))=bvconst(99,64)) }

example "MACHINE107 PSTORE neighbor unchanged" { assert(machine107_typed_byte(bvconst(3,8),bvconst(16,64),bvconst(32,64),bvconst(258,64),bvconst(772,64),bvconst(99,64))=bvconst(99,64)) }

example "MACHINE107 trap clears handler kind" { assert(machine107_handler_tag(bvconst(3,8),bvconst(1,8))=bvconst(0,8)) }

example "MACHINE107 resume restores protected kind" { assert(machine107_restore_tag(bvconst(3,8),bvconst(1,8),bvconst(0,8))=bvconst(1,8)) }

example "MACHINE107 failed resume preserves kind" { assert(machine107_restore_tag(bvconst(4,8),bvconst(0,8),bvconst(1,8))=bvconst(1,8)) }

example "MACHINE107 precommit rejection selects fault" { assert(machine107_terminal(bvconst(0,8))=bvconst(4,8)) }

example "MACHINE107 universal failed pair transition is data no op" {
    assert(∀(dst : BitVec64). ∀(q : BitVec64). ∀(h : BitVec64). ∀(p : BitVec64). ∀(old : BitVec64).
        machine107_pair_word(bvconst(4,8),dst,q,h,p,old)=old)
}
example "MACHINE107 universal failed typed store preserves tags" {
    assert(∀(cell : BitVec64). ∀(q : BitVec64). ∀(t : BitVec8). ∀(old : BitVec8).
        machine107_typed_tag(bvconst(4,8),cell,q,t,old)=old)
}
example "MACHINE107 universal failed raw store preserves tags" {
    assert(∀(offset : BitVec64). ∀(len : BitVec64). ∀(q : BitVec64). ∀(old : BitVec8).
        machine107_raw_mem_tag(bvconst(4,8),offset,len,q,old)=old)
}
example "MACHINE107 universal failed typed store preserves all bytes" {
    assert(∀(offset : BitVec64). ∀(q : BitVec64). ∀(h : BitVec64). ∀(p : BitVec64). ∀(old : BitVec64).
        machine107_typed_byte(bvconst(4,8),offset,q,h,p,old)=old)
}
example "MACHINE107 universal self copy snapshots both source words" {
    assert(∀(dst : BitVec64). ∀(h : BitVec64). ∀(pos : BitVec64).
        kind107_pair(dst) →
        ((machine107_pair_word(bvconst(3,8),dst,dst,h,pos,h)=h) ∧
         (machine107_pair_word(bvconst(3,8),dst,bvadd(dst,bvconst(1,64)),h,pos,pos)=pos)))
}
example "MACHINE107 universal scalar commit cannot mint kind" {
    assert(∀(dst : BitVec64). ∀(pair : BitVec64).
        machine107_raw_reg_tag(bvconst(3,8),dst,pair,bvconst(0,8))=bvconst(0,8))
}
example "MACHINE107 universal pair admission refines ABI transport" {
    assert(∀(dst : BitVec64). ∀(src : BitVec64). ∀(h : BitVec64). ∀(p : BitVec64).
        ∀(oh : BitVec64). ∀(op : BitVec64). ∀(ot : BitVec8).
        machine107_pair_transition(dst,src,h,p,bvconst(1,8),oh,op,ot,bvconst(1,8),bvconst(1,8)) →
        repr107_transport(h,p,bvconst(1,8),oh,op,ot,bvconst(1,8)))
}

// Guarded transition computes status from checks; callers cannot choose COMMITTED.
// stage-only effect functions above are private next-state helpers in the model.
define machine107_checked_stage(stage : BitVec8, ticket : BitVec8,
    fabric : BitVec8, span : BitVec8, exact : BitVec8, key : BitVec8, serial : BitVec8) =
    if machine107_precommit(stage,ticket,fabric,span,exact,key,serial)
    then bvconst(3,8) else bvconst(4,8)
define machine107_guarded_raw_tag(stage : BitVec8, ticket : BitVec8,
    fabric : BitVec8, span : BitVec8, exact : BitVec8, key : BitVec8, serial : BitVec8,
    offset : BitVec64, length : BitVec64, cell : BitVec64, oldtag : BitVec8) =
    machine107_raw_mem_tag(machine107_checked_stage(stage,ticket,fabric,span,exact,key,serial),
        offset,length,cell,oldtag)
define machine107_guarded_typed_byte(stage : BitVec8, ticket : BitVec8,
    fabric : BitVec8, span : BitVec8, exact : BitVec8, key : BitVec8, serial : BitVec8,
    offset : BitVec64, query : BitVec64, h : BitVec64, pos : BitVec64, old : BitVec64) =
    machine107_typed_byte(machine107_checked_stage(stage,ticket,fabric,span,exact,key,serial),
        offset,query,h,pos,old)

// PADD validates real descriptor provenance and bounds; captures original handle
// and checked position before applying atomic pair effects. Does not use PMOV's
// equal-position admission predicate.
define machine107_padd(dst : BitVec64, src : BitVec64,
    h : BitVec64, pos : BitVec64, tag : BitVec8,
    slot : BitVec64, epoch : BitVec64, live : BitVec8,
    caller : BitVec64, domain : BitVec64,
    lo : BitVec64, hi : BitVec64, extent : BitVec64,
    count : BitVec64, size : BitVec64,
    outh : BitVec64, outpos : BitVec64, outtag : BitVec8) =
    kind107_pair(dst) ∧ kind107_pair(src) ∧
    repr107_advance(h,pos,tag,slot,epoch,live,caller,domain,
        lo,hi,extent,count,size,outh,outpos,outtag)

// Issuance is a privileged operation, never an ordinary set-tag instruction.
// Registry publication must already have succeeded, and the issued position
// must lie in the descriptor view. Null is separately constructed untagged.
define machine107_issue(dst : BitVec64, h : BitVec64,
    slot : BitVec64, epoch : BitVec64, descriptor_live : BitVec8,
    caller : BitVec64, domain : BitVec64, pos : BitVec64,
    lo : BitVec64, hi : BitVec64, extent : BitVec64,
    trusted_issuer : BitVec8, entry_published : BitVec8) =
    kind107_pair(dst) ∧ (trusted_issuer=bvconst(1,8)) ∧
    (entry_published=bvconst(1,8)) ∧
    repr107_lookup(h,bvconst(1,8),slot,epoch,descriptor_live,caller,domain) ∧
    ptr107_view(lo,hi,pos,extent)

// Protected snapshot + trusted return frame decide restoration atomically.
define machine107_checked_restore(saved_thread : BitVec64, thread : BitVec64,
    saved_domain : BitVec64, domain : BitVec64,
    image_protected : BitVec8, coherent : BitVec8, frame_current : BitVec8,
    image_tag : BitVec8, oldtag : BitVec8) =
    if machine107_context_admit(saved_thread,thread,saved_domain,domain,
        image_protected,coherent,frame_current) then image_tag else oldtag

example "MACHINE107 in place PADD checked one past" { assert(machine107_padd(bvconst(4,64),bvconst(4,64),bvconst(4294967303,64),bvconst(0,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(0,64),bvconst(16,64),bvconst(32,64),bvconst(2,64),bvconst(8,64),bvconst(4294967303,64),bvconst(16,64),bvconst(1,8))) }

example "MACHINE107 PADD rebind handle" { assert(¬(machine107_padd(bvconst(4,64),bvconst(4,64),bvconst(4294967303,64),bvconst(0,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(0,64),bvconst(16,64),bvconst(32,64),bvconst(2,64),bvconst(8,64),bvconst(4294967304,64),bvconst(16,64),bvconst(1,8)))) }

example "MACHINE107 PADD wrong scaling" { assert(¬(machine107_padd(bvconst(4,64),bvconst(4,64),bvconst(4294967303,64),bvconst(0,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(0,64),bvconst(16,64),bvconst(32,64),bvconst(2,64),bvconst(8,64),bvconst(4294967303,64),bvconst(2,64),bvconst(1,8)))) }

example "MACHINE107 PADD out of view" { assert(¬(machine107_padd(bvconst(4,64),bvconst(4,64),bvconst(4294967303,64),bvconst(0,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(0,64),bvconst(16,64),bvconst(32,64),bvconst(3,64),bvconst(8,64),bvconst(4294967303,64),bvconst(16,64),bvconst(1,8)))) }

example "MACHINE107 PADD descriptor stale" { assert(¬(machine107_padd(bvconst(4,64),bvconst(4,64),bvconst(4294967303,64),bvconst(0,64),bvconst(1,8),bvconst(7,64),bvconst(2,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(0,64),bvconst(16,64),bvconst(32,64),bvconst(2,64),bvconst(8,64),bvconst(4294967303,64),bvconst(16,64),bvconst(1,8)))) }

example "MACHINE107 trusted issue from published registry" { assert(machine107_issue(bvconst(4,64),bvconst(4294967303,64),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(0,64),bvconst(0,64),bvconst(16,64),bvconst(32,64),bvconst(1,8),bvconst(1,8))) }

