example "MACHINE107-30 stale event frame" { assert(¬(machine107_context_admit(bvconst(1,64),bvconst(1,64),bvconst(4,64),bvconst(4,64),bvconst(1,8),bvconst(1,8),bvconst(0,8)))) }

