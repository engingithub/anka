example "MACHINE107 universal stale Fabric guarded tag no op" {
    assert(∀(o : BitVec64). ∀(len : BitVec64). ∀(cell : BitVec64). ∀(old : BitVec8).
        machine107_guarded_raw_tag(bvconst(2,8),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),o,len,cell,old)=old)
}
example "MACHINE107 universal stale Fabric guarded typed byte no op" {
    assert(∀(o : BitVec64). ∀(q : BitVec64). ∀(h : BitVec64). ∀(pos : BitVec64). ∀(old : BitVec64).
        machine107_guarded_typed_byte(bvconst(2,8),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),o,q,h,pos,old)=old)
}
example "MACHINE107 universal wrong thread restore cannot change kind" {
    assert(∀(saved : BitVec64). ∀(thread : BitVec64). ∀(image : BitVec8). ∀(old : BitVec8).
        ¬(saved=thread) →
        (machine107_checked_restore(saved,thread,bvconst(4,64),bvconst(4,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),image,old)=old))
}

// PLOAD captures payload and protected kind from one committed Fabric snapshot.
// Nonzero untagged bytes are never reconstructed into an authenticated pointer.
define machine107_pload(dst : BitVec64, h : BitVec64, pos : BitVec64, tag : BitVec8,
    object : BitVec64, gen : BitVec64, offset : BitVec64, extent : BitVec64,
    tag_object : BitVec64, tag_gen : BitVec64, tag_offset : BitVec64,
    read_permission : BitVec8, snapshot : BitVec8, descriptor_valid : BitVec8) =
    kind107_pair(dst) ∧ kind107_cell(offset,extent) ∧
    kind107_storage_key(object,gen,offset,tag_object,tag_gen,tag_offset) ∧
    kind107_transport(h,pos,tag,h,pos,tag,snapshot) ∧
    (read_permission=bvconst(1,8)) ∧ (descriptor_valid=bvconst(1,8))

example "MACHINE107 PLOAD committed object snapshot" { assert(machine107_pload(bvconst(4,64),bvconst(4294967303,64),bvconst(8,64),bvconst(1,8),bvconst(7,64),bvconst(2,64),bvconst(16,64),bvconst(64,64),bvconst(7,64),bvconst(2,64),bvconst(16,64),bvconst(1,8),bvconst(1,8),bvconst(1,8))) }

example "MACHINE107 PLOAD raw bytes cannot create kind" { assert(¬(machine107_pload(bvconst(4,64),bvconst(4294967303,64),bvconst(8,64),bvconst(0,8),bvconst(7,64),bvconst(2,64),bvconst(16,64),bvconst(64,64),bvconst(7,64),bvconst(2,64),bvconst(16,64),bvconst(1,8),bvconst(1,8),bvconst(1,8)))) }

