example "MACHINE107-27 restore wrong domain" { assert(¬(machine107_context_admit(bvconst(1,64),bvconst(1,64),bvconst(4,64),bvconst(5,64),bvconst(1,8),bvconst(1,8),bvconst(1,8)))) }

