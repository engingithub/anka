example "hostile not EOF" { assert(at110_frame(bvconst(1,64),bvconst(2,64),bvconst(9,64),bvconst(64,64),bvconst(232,64),as110_false(),bvconst(0,64))) }
example "hostile reserved" { assert(at110_frame(bvconst(1,64),bvconst(2,64),bvconst(9,64),bvconst(64,64),bvconst(232,64),as110_true(),bvconst(1,64))) }
