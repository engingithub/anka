import "anka110_artifact_transfer.kleis"
example "hostile wrong version" { assert(at110_frame(bvconst(2,64),bvconst(2,64),bvconst(9,64),bvconst(64,64),bvconst(232,64),as110_true(),bvconst(0,64))) }
example "hostile zero operation" { assert(at110_frame(bvconst(1,64),bvconst(0,64),bvconst(9,64),bvconst(64,64),bvconst(232,64),as110_true(),bvconst(0,64))) }
example "hostile unknown operation" { assert(at110_frame(bvconst(1,64),bvconst(7,64),bvconst(9,64),bvconst(64,64),bvconst(232,64),as110_true(),bvconst(0,64))) }
example "hostile zero correlation" { assert(at110_frame(bvconst(1,64),bvconst(2,64),bvconst(0,64),bvconst(64,64),bvconst(232,64),as110_true(),bvconst(0,64))) }
