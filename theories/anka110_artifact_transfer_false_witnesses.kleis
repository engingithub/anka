example "hostile op 6 zero size" { assert(at110_shape(bvconst(6,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(91,64),bvconst(7,64),bvconst(0,64))) }
example "hostile op 6 bad count" { assert(at110_shape(bvconst(6,64),bvconst(0,64),bvconst(0,64),bvconst(4097,64),bvconst(91,64),bvconst(7,64),bvconst(10000,64))) }
example "hostile append gap beyond end" { assert(at110_shape(bvconst(2,64),bvconst(5,64),bvconst(10001,64),bvconst(1,64),bvconst(0,64),bvconst(0,64),bvconst(10000,64))) }
