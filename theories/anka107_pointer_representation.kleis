example "REPR107-38 word straddles view" {
    assert(¬(repr107_access(bvconst(4294967303,64),bvconst(15,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(2,64),bvconst(0,64),bvconst(16,64),bvconst(3,64),bvconst(9,64),bvconst(2,64),bvconst(1,8),bvconst(4096,64),bvconst(32,64),bvconst(8,64),bvconst(1,64),bvconst(1,8),bvconst(1,8))))
}

example "REPR107-39 Fabric rejected" {
    assert(¬(repr107_access(bvconst(4294967303,64),bvconst(15,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(2,64),bvconst(0,64),bvconst(16,64),bvconst(3,64),bvconst(9,64),bvconst(2,64),bvconst(1,8),bvconst(4096,64),bvconst(32,64),bvconst(1,64),bvconst(1,64),bvconst(0,8),bvconst(1,8))))
}

example "REPR107-40 untagged access" {
    assert(¬(repr107_access(bvconst(4294967303,64),bvconst(15,64),bvconst(0,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(2,64),bvconst(0,64),bvconst(16,64),bvconst(3,64),bvconst(9,64),bvconst(2,64),bvconst(1,8),bvconst(4096,64),bvconst(32,64),bvconst(1,64),bvconst(1,64),bvconst(1,8),bvconst(1,8))))
}

example "REPR107-41 domain mismatch" {
    assert(¬(repr107_access(bvconst(4294967303,64),bvconst(15,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(5,64),bvconst(9,64),bvconst(2,64),bvconst(0,64),bvconst(16,64),bvconst(3,64),bvconst(9,64),bvconst(2,64),bvconst(1,8),bvconst(4096,64),bvconst(32,64),bvconst(1,64),bvconst(1,64),bvconst(1,8),bvconst(1,8))))
}

example "REPR107-42 neighbor allocation" {
    assert(¬(repr107_access(bvconst(4294967303,64),bvconst(15,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(2,64),bvconst(0,64),bvconst(16,64),bvconst(3,64),bvconst(10,64),bvconst(2,64),bvconst(1,8),bvconst(4096,64),bvconst(32,64),bvconst(1,64),bvconst(1,64),bvconst(1,8),bvconst(1,8))))
}

example "REPR107-43 read with write only" {
    assert(¬(repr107_access(bvconst(4294967303,64),bvconst(15,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(2,64),bvconst(0,64),bvconst(16,64),bvconst(2,64),bvconst(9,64),bvconst(2,64),bvconst(1,8),bvconst(4096,64),bvconst(32,64),bvconst(1,64),bvconst(1,64),bvconst(1,8),bvconst(1,8))))
}

example "REPR107 universal slot roundtrip" {
    assert(∀(s : BitVec64). ∀(e : BitVec64).
        repr107_components(s,e) → (repr107_slot(repr107_handle(s,e))=s))
}
example "REPR107 universal epoch roundtrip" {
    assert(∀(s : BitVec64). ∀(e : BitVec64).
        repr107_components(s,e) → (repr107_epoch(repr107_handle(s,e))=e))
}
example "REPR107 universal integers cannot pass lookup" {
    assert(∀(h : BitVec64). ∀(s : BitVec64). ∀(e : BitVec64).
        ¬repr107_lookup(h,bvconst(0,8),s,e,bvconst(1,8),bvconst(4,64),bvconst(4,64)))
}
example "REPR107 ordinary write invalidates pointer kind" {
    assert(repr107_after_raw_write()=bvconst(0,8))
}

// Newly issued narrowed descriptors keep original allocation provenance.
// Source lookup, target publication and same-domain binding must separately pass.
define repr107_narrow_entry(id : BitVec64, gen : BitVec64, lo : BitVec64,
    hi : BitVec64, rights : BitVec64, newid : BitVec64, newgen : BitVec64,
    newlo : BitVec64, newhi : BitVec64, newpos : BitVec64, newrights : BitVec64) =
    (id=newid) ∧ (gen=newgen) ∧
    ptr107_narrow(lo,hi,rights,newlo,newhi,newpos,newrights)

// Null carries no descriptor authority and cannot pass ordinary lookup.
define repr107_null(h : BitVec64, pos : BitVec64, tag : BitVec8) =
    (h=bvconst(0,64)) ∧ (pos=bvconst(0,64)) ∧ (tag=bvconst(0,8))

example "REPR107 narrow entry retains provenance" { assert(repr107_narrow_entry(bvconst(9,64),bvconst(2,64),bvconst(0,64),bvconst(32,64),bvconst(3,64),bvconst(9,64),bvconst(2,64),bvconst(8,64),bvconst(16,64),bvconst(8,64),bvconst(1,64))) }

example "REPR107 narrow cannot change allocation" { assert(¬(repr107_narrow_entry(bvconst(9,64),bvconst(2,64),bvconst(0,64),bvconst(32,64),bvconst(3,64),bvconst(10,64),bvconst(2,64),bvconst(8,64),bvconst(16,64),bvconst(8,64),bvconst(1,64)))) }

example "REPR107 narrow cannot change lifetime" { assert(¬(repr107_narrow_entry(bvconst(9,64),bvconst(2,64),bvconst(0,64),bvconst(32,64),bvconst(3,64),bvconst(9,64),bvconst(3,64),bvconst(8,64),bvconst(16,64),bvconst(8,64),bvconst(1,64)))) }

example "REPR107 narrow cannot widen bound" { assert(¬(repr107_narrow_entry(bvconst(9,64),bvconst(2,64),bvconst(0,64),bvconst(32,64),bvconst(3,64),bvconst(9,64),bvconst(2,64),bvconst(8,64),bvconst(33,64),bvconst(8,64),bvconst(1,64)))) }

example "REPR107 narrow cannot amplify rights" { assert(¬(repr107_narrow_entry(bvconst(9,64),bvconst(2,64),bvconst(0,64),bvconst(32,64),bvconst(3,64),bvconst(9,64),bvconst(2,64),bvconst(8,64),bvconst(16,64),bvconst(8,64),bvconst(7,64)))) }

example "REPR107 canonical null" {
    assert(repr107_null(bvconst(0,64),bvconst(0,64),bvconst(0,8)))
}
example "REPR107 null dereference denied" {
    assert(¬repr107_lookup(bvconst(0,64),bvconst(0,8),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(4,64),bvconst(4,64)))
}
example "REPR107 universal checked address cannot wrap" {
    assert(∀(base : BitVec64). ∀(extent : BitVec64). ∀(pos : BitVec64).
        (ptr107_record_valid(bvconst(1,64),bvconst(1,64),base,extent) ∧ bvule(pos,extent)) →
        bvuge(repr107_address(base,pos),base))
}

example "REPR107 universal concrete admission implies abstract admission" {
    assert(∀(h : BitVec64). ∀(pos : BitVec64). ∀(tag : BitVec8). ∀(slot : BitVec64). ∀(epoch : BitVec64). ∀(dlive : BitVec8). ∀(caller : BitVec64). ∀(domain : BitVec64). ∀(did : BitVec64). ∀(dgen : BitVec64). ∀(lo : BitVec64). ∀(hi : BitVec64). ∀(rights : BitVec64). ∀(aid : BitVec64). ∀(agen : BitVec64). ∀(alive : BitVec8). ∀(base : BitVec64). ∀(extent : BitVec64). ∀(width : BitVec64). ∀(need : BitVec64). ∀(fabric : BitVec8). ∀(aligned : BitVec8).
        repr107_access(h,pos,tag,slot,epoch,dlive,caller,domain,did,dgen,lo,hi,rights,aid,agen,alive,base,extent,width,need,fabric,aligned) → ptr107_access(did,dgen,aid,agen,alive,tag,base,extent,lo,hi,pos,width,rights,need,fabric,aligned))
}
