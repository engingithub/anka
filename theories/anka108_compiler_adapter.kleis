}

example "entry not aligned" {
    assert(¬(ad108_entry(bvconst(335872,64),bvconst(168032,64),bvconst(168032,64),bvconst(165345,64),bvconst(0,64),bvconst(501216,64),bvconst(1,8),bvconst(1,8),bvconst(1,8))))
}

example "overlapping compiler mapping" {
    assert(¬(ad108_entry(bvconst(73728,64),bvconst(168032,64),bvconst(168032,64),bvconst(165344,64),bvconst(0,64),bvconst(501216,64),bvconst(1,8),bvconst(1,8),bvconst(1,8))))
}

example "missing layout proof" {
    assert(¬(ad108_entry(bvconst(335872,64),bvconst(168032,64),bvconst(168032,64),bvconst(165344,64),bvconst(0,64),bvconst(501216,64),bvconst(0,8),bvconst(1,8),bvconst(1,8))))
}

example "substituted compiler geometry" {
    assert(¬(ad108_entry(bvconst(335872,64),bvconst(168032,64),bvconst(168032,64),bvconst(165344,64),bvconst(0,64),bvconst(501216,64),bvconst(1,8),bvconst(0,8),bvconst(1,8))))
}

example "jump without return authority" {
    assert(¬(ad108_entry(bvconst(335872,64),bvconst(168032,64),bvconst(168032,64),bvconst(165344,64),bvconst(0,64),bvconst(501216,64),bvconst(1,8),bvconst(1,8),bvconst(0,8))))
}

example "CALL displacement out of range" {
    assert(¬(ad108_entry(bvconst(2097152,64),bvconst(168032,64),bvconst(168032,64),bvconst(165344,64),bvconst(0,64),bvconst(2262496,64),bvconst(1,8),bvconst(1,8),bvconst(1,8))))
}

example "return preserves compiler result" {
    assert(ad108_return(bvconst(9,64),bvconst(9,64),bvconst(0,64),bvconst(0,64),bvconst(1,8)))
}

example "launcher cannot erase nonzero result" {
    assert(¬(ad108_return(bvconst(9,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(1,8))))
}

example "launcher cannot spawn output" {
    assert(¬(ad108_return(bvconst(0,64),bvconst(0,64),bvconst(7,64),bvconst(0,64),bvconst(1,8))))
}

example "fault is not a normal return" {
    assert(¬(ad108_return(bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,8))))
}

example "fresh generation zero seals to one" {
    assert(ad108_seal(bvconst(0,64),bvconst(1,64),bvconst(1,8)))
}
