example "source envelope fits payload and padding" {
    assert(∀(n : BitVec64). bvule(n,ad108_source_limit()) → (bvuge(ad108_source_extent(n),bvadd(n,bvconst(8,64))) ∧ bvule(ad108_source_extent(n),bvconst(65536,64)) ∧ (bvand(ad108_source_extent(n),bvconst(4095,64))=bvconst(0,64))))
}

example "word lexer never crosses private source envelope" {
    assert(∀(n : BitVec64). ∀(i : BitVec64). (bvule(n,ad108_source_limit()) ∧ bvult(i,n)) → bvule(bvadd(bvand(i,bvsub(bvconst(0,64),bvconst(8,64))),bvconst(16,64)),ad108_source_extent(n)))
}

example "chunk is positive and fits remaining bytes" {
    assert(∀(t : BitVec64). ∀(u : BitVec64). (bvule(t,ad108_arena()) ∧ bvult(u,t)) → (bvugt(ad108_chunk(t,u),bvconst(0,64)) ∧ bvule(ad108_chunk(t,u),io108_limit()) ∧ bvule(ad108_chunk(t,u),bvsub(t,u))))
}

example "one chunk advances without wrapping" {
    assert(∀(t : BitVec64). ∀(u : BitVec64). (bvule(t,ad108_arena()) ∧ bvult(u,t)) → (bvugt(bvadd(u,ad108_chunk(t,u)),u) ∧ bvule(bvadd(u,ad108_chunk(t,u)),t)))
}

example "exact arena capacity refines generic bound" {
    assert(∀(n : BitVec64). (bvugt(n,bvconst(0,64)) ∧ bvule(n,ad108_arena())) → rb108_capacity(n))
}

