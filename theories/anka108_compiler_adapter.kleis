    assert(∀(p : BitVec8). ∀(s : BitVec64). ∀(n : BitVec64). ∀(c : BitVec64). ∀(l : BitVec64). ad108_prepare(p,s,n,c,l,bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)) → rb108_prepare(p,s,n,n,c,l,bvconst(0,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))
}

example "adapter prepare implies exact output and source counts" {
    assert(∀(s : BitVec64). ∀(n : BitVec64). ∀(c : BitVec64). ∀(l : BitVec64). ad108_prepare(bvconst(0,8),s,n,c,l,bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)) → ((s=n) ∧ (c=l)))
}

