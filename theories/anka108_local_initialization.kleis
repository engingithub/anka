}

example "local108_capacity rejects too many manifest entries" {
    assert(¬(local108_capacity(bvconst(4097,64),bvconst(4097,64),bvconst(1,64),bvconst(4097,64),bvconst(1,64),bvconst(9,64),bvconst(20,64))))
}

example "local108_capacity rejects count arithmetic wrap" {
    assert(¬(local108_capacity(ptr107_max(),ptr107_max(),bvconst(1,64),ptr107_max(),bvconst(1,64),bvconst(9,64),bvconst(20,64))))
}

example "empty-local frame still reserves its scope" {
