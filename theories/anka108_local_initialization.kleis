}

example "law checked virtual frame ends at cursor" {
    assert(∀(c : BitVec64). ∀(l : BitVec64). ∀(h : BitVec64). ∀(n : BitVec64). ∀(p : BitVec64). ∀(r : BitVec64). local108_geometry(c,l,h,n,p,r) → ((bvadd(frame107_base(c,n),n)=c) ∧ bvuge(frame107_base(c,n),l)))
}

example "law geometry checks physical projection" {
    assert(∀(c : BitVec64). ∀(l : BitVec64). ∀(h : BitVec64). ∀(n : BitVec64). ∀(p : BitVec64). ∀(r : BitVec64). local108_geometry(c,l,h,n,p,r) → local108_projection(p,bvsub(frame107_base(c,n),l),n,r))
}

example "law physical projection starts inside stack" {
    assert(∀(p : BitVec64). ∀(o : BitVec64). ∀(n : BitVec64). ∀(r : BitVec64). local108_projection(p,o,n,r) → bvuge(bvadd(p,o),p))
}

example "law physical projection base stays below RAM limit" {
    assert(∀(p : BitVec64). ∀(o : BitVec64). ∀(n : BitVec64). ∀(r : BitVec64). local108_projection(p,o,n,r) → bvule(bvadd(p,o),r))
}

example "law physical projection leaves room for frame" {
    assert(∀(p : BitVec64). ∀(o : BitVec64). ∀(n : BitVec64). ∀(r : BitVec64). local108_projection(p,o,n,r) → bvule(n,bvsub(r,bvadd(p,o))))
}

example "law checked physical end stays below RAM limit" {
    assert(∀(b : BitVec64). ∀(n : BitVec64). ∀(r : BitVec64). (bvule(b,r) ∧ bvule(n,bvsub(r,b))) → bvule(bvadd(b,n),r))
}

example "law physical projection is nonwrapping and aligned" {
    assert(∀(p : BitVec64). ∀(o : BitVec64). ∀(n : BitVec64). ∀(r : BitVec64). local108_projection(p,o,n,r) → init108_range(bvadd(p,o),n))
}

example "law every clean frame byte is zero" {
    assert(∀(b : BitVec64). ∀(n : BitVec64). ∀(q : BitVec64). ∀(old : BitVec8). (init108_range(b,n) ∧ local108_in(b,n,q)) → (local108_byte(local108_true(),b,n,q,old)=bvconst(0,8)))
}

example "law outside bytes are preserved" {
    assert(∀(b : BitVec64). ∀(n : BitVec64). ∀(q : BitVec64). ∀(old : BitVec8). ¬(local108_in(b,n,q)) → (local108_byte(local108_true(),b,n,q,old)=old))
}

example "law all overlapping tags are cleared" {
    assert(∀(b : BitVec64). ∀(n : BitVec64). ∀(cell : BitVec64). ∀(old : BitVec8). kind107_overlap(b,n,cell) → (local108_tag(local108_true(),b,n,cell,old)=bvconst(0,8)))
}

example "law nonoverlapping tags are preserved" {
    assert(∀(b : BitVec64). ∀(n : BitVec64). ∀(cell : BitVec64). ∀(old : BitVec8). ¬(kind107_overlap(b,n,cell)) → (local108_tag(local108_true(),b,n,cell,old)=old))
}

example "law failed preflight preserves every byte" {
    assert(∀(b : BitVec64). ∀(n : BitVec64). ∀(q : BitVec64). ∀(old : BitVec8). local108_byte(local108_scrub(local108_false(),bvconst(1,8)),b,n,q,old)=old)
}

example "law failed preflight preserves every tag" {
    assert(∀(b : BitVec64). ∀(n : BitVec64). ∀(cell : BitVec64). ∀(old : BitVec8). local108_tag(local108_scrub(local108_false(),bvconst(1,8)),b,n,cell,old)=old)
}

example "law failed preflight preserves cursor and live count" {
    assert(∀(c : BitVec64). ∀(n : BitVec64). ∀(old : BitVec64). (local108_cursor(local108_false(),c,n)=c) ∧ (local108_live(local108_false(),old,n)=old))
}

example "law invalid manifest member poisons fold" {
    assert(∀(prior : Bool). ¬(local108_fold(prior,local108_false())))
}

example "law cannot resurrect earlier failed member" {
    assert(∀(next : Bool). ¬(local108_fold(local108_false(),next)))
}

example "law publication needs complete bytes and tags" {
    assert(∀(p : Bool). ∀(n : BitVec64). ∀(b : BitVec64). ∀(t : BitVec64). ∀(v : Bool). local108_publish(p,n,b,t,v) → ((b=n) ∧ (t=n) ∧ v))
}

example "law capacity reserves nonwrapping registry mutations" {
    assert(∀(n : BitVec64). ∀(r : BitVec64). local108_capacity(n,n,bvconst(1,64),n,bvconst(1,64),bvconst(9,64),r) → (bvuge(bvadd(r,bvadd(n,bvconst(1,64))),r) ∧ bvugt(bvadd(n,bvconst(1,64)),n)))
}

example "law incoming words and LR survive PFRAME" {
    assert(∀(reg : BitVec64). ∀(base : BitVec64). ∀(old : BitVec64). (bvule(reg,bvconst(12,64)) ∨ (reg=bvconst(14,64))) → (local108_register(local108_true(),reg,base,old)=old))
}

example "law incoming kinds survive PFRAME" {
    assert(∀(old : BitVec8). local108_register_kind(old)=old)
}

example "law no scrub on event restore for any payload" {
    assert(∀(b : BitVec64). ∀(n : BitVec64). ∀(q : BitVec64). ∀(old : BitVec8). local108_byte(local108_scrub(local108_true(),bvconst(2,8)),b,n,q,old)=old)
}

example "law trace is independent of former occupant" {
    assert(∀(a : BitVec8). ∀(b : BitVec8). ∀(q : BitVec64). local108_in(bvconst(18368,64),bvconst(64,64),q) → (local108_trace_byte(a,q)=local108_trace_byte(b,q)))
}

example "law parent bytes above child are preserved" {
    assert(∀(q : BitVec64). ∀(old : BitVec8). local108_in(bvconst(18432,64),bvconst(2048,64),q) → (local108_trace_byte(old,q)=old))
}

example "law fresh local reads every in-bounds byte as zero" {
    assert(∀(pos : BitVec64). ∀(old : BitVec8). local108_read(local108_trace_issued(),repr107_handle(bvconst(3,64),bvconst(8,64)),bvconst(3,64),bvconst(8,64),bvconst(1,8),bvconst(3,64),bvconst(3,64),bvconst(8,64),pos,bvconst(1,64)) → (local108_trace_byte(old,bvadd(bvconst(18368,64),pos))=bvconst(0,8)))
}

example "law same new initializer is independent of old bytes" {
    assert(∀(a : BitVec8). ∀(b : BitVec8). ∀(input : BitVec8). ∀(q : BitVec64). bvult(q,bvconst(64,64)) → (init108_overlay(local108_true(),bvconst(8,64),q,input,local108_trace_byte(a,bvadd(bvconst(18368,64),q)))=init108_overlay(local108_true(),bvconst(8,64),q,input,local108_trace_byte(b,bvadd(bvconst(18368,64),q)))))
}

example "law local interval cannot expose frame padding" {
    assert(∀(off : BitVec64). ∀(len : BitVec64). ∀(n : BitVec64). ∀(pos : BitVec64). (frame107_local(off,len,n,bvconst(1,64)) ∧ bvult(pos,len)) → bvult(bvadd(off,pos),n))
}
