}

example "local108_capacity rejects insufficient slots" {
    assert(¬(local108_capacity(bvconst(2,64),bvconst(1,64),bvconst(1,64),bvconst(2,64),bvconst(1,64),bvconst(9,64),bvconst(20,64))))
}

example "local108_capacity rejects no scope row" {
    assert(¬(local108_capacity(bvconst(2,64),bvconst(2,64),bvconst(0,64),bvconst(2,64),bvconst(1,64),bvconst(9,64),bvconst(20,64))))
}

example "local108_capacity rejects output vector too small" {
    assert(¬(local108_capacity(bvconst(2,64),bvconst(2,64),bvconst(1,64),bvconst(1,64),bvconst(1,64),bvconst(9,64),bvconst(20,64))))
