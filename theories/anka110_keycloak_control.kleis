    assert(¬(ac110_reply(AC110Request(bvconst(1,64),bvconst(2,64),bvconst(3,64),bvconst(4,64),bvconst(5,64),bvconst(6,64),bvconst(7,64),bvconst(8,64),bvconst(9,64)),AC110Reply(bvconst(2,64),bvconst(2,64),bvconst(3,64),bvconst(4,64),bvconst(5,64),bvconst(6,64),bvconst(7,64),bvconst(8,64),bvconst(9,64),bvconst(1,64),bvconst(0,64),bvconst(101,64),bvconst(0,64),bvconst(31,64)),bvconst(120,64),kc110_true(),bvconst(0,64))))
}

