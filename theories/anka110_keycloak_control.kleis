// AC110: bounded administration probe, not exclusive mediation or live authority.
// Fixed private worker replies are trusted observations only after exact framing,
// process success, full correlation and an owned pending SA110 barrier.
// No new axioms. Journal read-before-write is NOT atomic compare-and-swap.
import "anka110_serialized_authority.kleis"

data AC110Request = AC110Request(action : BitVec64, domain : BitVec64, incarnation : BitVec64, revision : BitVec64, command : BitVec64, nonce0 : BitVec64, nonce1 : BitVec64, nonce2 : BitVec64, nonce3 : BitVec64)
define acq_action(v : AC110Request) = match v { AC110Request(action,domain,incarnation,revision,command,nonce0,nonce1,nonce2,nonce3) => action }
define acq_domain(v : AC110Request) = match v { AC110Request(action,domain,incarnation,revision,command,nonce0,nonce1,nonce2,nonce3) => domain }
define acq_incarnation(v : AC110Request) = match v { AC110Request(action,domain,incarnation,revision,command,nonce0,nonce1,nonce2,nonce3) => incarnation }
define acq_revision(v : AC110Request) = match v { AC110Request(action,domain,incarnation,revision,command,nonce0,nonce1,nonce2,nonce3) => revision }
define acq_command(v : AC110Request) = match v { AC110Request(action,domain,incarnation,revision,command,nonce0,nonce1,nonce2,nonce3) => command }
define acq_nonce0(v : AC110Request) = match v { AC110Request(action,domain,incarnation,revision,command,nonce0,nonce1,nonce2,nonce3) => nonce0 }
define acq_nonce1(v : AC110Request) = match v { AC110Request(action,domain,incarnation,revision,command,nonce0,nonce1,nonce2,nonce3) => nonce1 }
define acq_nonce2(v : AC110Request) = match v { AC110Request(action,domain,incarnation,revision,command,nonce0,nonce1,nonce2,nonce3) => nonce2 }
define acq_nonce3(v : AC110Request) = match v { AC110Request(action,domain,incarnation,revision,command,nonce0,nonce1,nonce2,nonce3) => nonce3 }

data AC110Reply = AC110Reply(action : BitVec64, domain : BitVec64, incarnation : BitVec64, revision : BitVec64, command : BitVec64, nonce0 : BitVec64, nonce1 : BitVec64, nonce2 : BitVec64, nonce3 : BitVec64, status : BitVec64, original : BitVec64, target : BitVec64, restored : BitVec64, flags : BitVec64)
define acr_action(v : AC110Reply) = match v { AC110Reply(action,domain,incarnation,revision,command,nonce0,nonce1,nonce2,nonce3,status,original,target,restored,flags) => action }
define acr_domain(v : AC110Reply) = match v { AC110Reply(action,domain,incarnation,revision,command,nonce0,nonce1,nonce2,nonce3,status,original,target,restored,flags) => domain }
define acr_incarnation(v : AC110Reply) = match v { AC110Reply(action,domain,incarnation,revision,command,nonce0,nonce1,nonce2,nonce3,status,original,target,restored,flags) => incarnation }
define acr_revision(v : AC110Reply) = match v { AC110Reply(action,domain,incarnation,revision,command,nonce0,nonce1,nonce2,nonce3,status,original,target,restored,flags) => revision }
define acr_command(v : AC110Reply) = match v { AC110Reply(action,domain,incarnation,revision,command,nonce0,nonce1,nonce2,nonce3,status,original,target,restored,flags) => command }
define acr_nonce0(v : AC110Reply) = match v { AC110Reply(action,domain,incarnation,revision,command,nonce0,nonce1,nonce2,nonce3,status,original,target,restored,flags) => nonce0 }
define acr_nonce1(v : AC110Reply) = match v { AC110Reply(action,domain,incarnation,revision,command,nonce0,nonce1,nonce2,nonce3,status,original,target,restored,flags) => nonce1 }
define acr_nonce2(v : AC110Reply) = match v { AC110Reply(action,domain,incarnation,revision,command,nonce0,nonce1,nonce2,nonce3,status,original,target,restored,flags) => nonce2 }
define acr_nonce3(v : AC110Reply) = match v { AC110Reply(action,domain,incarnation,revision,command,nonce0,nonce1,nonce2,nonce3,status,original,target,restored,flags) => nonce3 }
define acr_status(v : AC110Reply) = match v { AC110Reply(action,domain,incarnation,revision,command,nonce0,nonce1,nonce2,nonce3,status,original,target,restored,flags) => status }
define acr_original(v : AC110Reply) = match v { AC110Reply(action,domain,incarnation,revision,command,nonce0,nonce1,nonce2,nonce3,status,original,target,restored,flags) => original }
define acr_target(v : AC110Reply) = match v { AC110Reply(action,domain,incarnation,revision,command,nonce0,nonce1,nonce2,nonce3,status,original,target,restored,flags) => target }
define acr_restored(v : AC110Reply) = match v { AC110Reply(action,domain,incarnation,revision,command,nonce0,nonce1,nonce2,nonce3,status,original,target,restored,flags) => restored }
define acr_flags(v : AC110Reply) = match v { AC110Reply(action,domain,incarnation,revision,command,nonce0,nonce1,nonce2,nonce3,status,original,target,restored,flags) => flags }

define ac110_request(q : AC110Request) =
    ((acq_action(q)=bvconst(1,64)) ∨ (acq_action(q)=bvconst(2,64))) ∧
    kc110_nz(acq_domain(q)) ∧ kc110_nz(acq_incarnation(q)) ∧ kc110_nz(acq_revision(q)) ∧ kc110_nz(acq_command(q)) ∧
    (kc110_nz(acq_nonce0(q)) ∨ kc110_nz(acq_nonce1(q)) ∨ kc110_nz(acq_nonce2(q)) ∨ kc110_nz(acq_nonce3(q)))
define ac110_echo(q : AC110Request,r : AC110Reply) =
    acq_action(q)=acr_action(r) ∧ acq_domain(q)=acr_domain(r) ∧ acq_incarnation(q)=acr_incarnation(r) ∧ acq_revision(q)=acr_revision(r) ∧ acq_command(q)=acr_command(r) ∧ acq_nonce0(q)=acr_nonce0(r) ∧ acq_nonce1(q)=acr_nonce1(r) ∧ acq_nonce2(q)=acr_nonce2(r) ∧ acq_nonce3(q)=acr_nonce3(r)
define ac110_reply(q : AC110Request,r : AC110Reply,size : BitVec64,eof : Bool,exit : BitVec64) =
    ac110_request(q) ∧ ac110_echo(q,r) ∧ (size=bvconst(120,64)) ∧ eof ∧ (exit=bvconst(0,64)) ∧
    (acr_status(r)=acq_action(q)) ∧ bvult(acr_original(r),acr_target(r)) ∧
    bvule(acr_target(r),bvconst(2147483647,64)) ∧ (acr_restored(r)=acr_original(r)) ∧
    (acr_flags(r)=(if acq_action(q)=bvconst(1,64) then bvconst(31,64) else bvconst(8,64)))
define ac110_consume(q : AC110Request,r : AC110Reply,size : BitVec64,eof : Bool,exit : BitVec64,
    mode : BitVec64,controlled : A109Verdict,pending : BitVec64,work : BitVec64,tick : BitVec64,deadline : BitVec64) =
    ac110_reply(q,r,size,eof,exit) ∧ (mode=bvconst(0,64)) ∧ (controlled=A109Unknown) ∧
    (pending=acq_command(q)) ∧ kc110_nz(work) ∧ bvule(work,bvconst(512,64)) ∧ bvult(tick,deadline)
define ac110_live(mode : BitVec64,controlled : A109Verdict) = (mode=bvconst(1,64)) ∧ (controlled=A109Valid)
// Necessary recovery checks only. Concurrent bypass writers remain outside the
// laboratory contract, so this observation NEVER attests exclusive control.
define ac110_restore(original : BitVec64,target : BitVec64,current : BitVec64,same_realm : Bool,private_record : Bool,bound_inputs : Bool) =
    bvult(original,target) ∧ bvule(target,bvconst(2147483647,64)) ∧ same_realm ∧ private_record ∧ bound_inputs ∧
    ((current=original) ∨ (current=target))

example "AC110 001 exact probe reply" {
    assert(ac110_reply(AC110Request(bvconst(1,64),bvconst(2,64),bvconst(3,64),bvconst(4,64),bvconst(5,64),bvconst(6,64),bvconst(7,64),bvconst(8,64),bvconst(9,64)),AC110Reply(bvconst(1,64),bvconst(2,64),bvconst(3,64),bvconst(4,64),bvconst(5,64),bvconst(6,64),bvconst(7,64),bvconst(8,64),bvconst(9,64),bvconst(1,64),bvconst(0,64),bvconst(101,64),bvconst(0,64),bvconst(31,64)),bvconst(120,64),kc110_true(),bvconst(0,64)))
}

example "AC110 002 exact recovery reply" {
    assert(ac110_reply(AC110Request(bvconst(2,64),bvconst(2,64),bvconst(3,64),bvconst(4,64),bvconst(5,64),bvconst(6,64),bvconst(7,64),bvconst(8,64),bvconst(9,64)),AC110Reply(bvconst(2,64),bvconst(2,64),bvconst(3,64),bvconst(4,64),bvconst(5,64),bvconst(6,64),bvconst(7,64),bvconst(8,64),bvconst(9,64),bvconst(2,64),bvconst(0,64),bvconst(101,64),bvconst(0,64),bvconst(8,64)),bvconst(120,64),kc110_true(),bvconst(0,64)))
}

