    assert(¬(in108_request(bvconst(20,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8),bvconst(4294967303,64),bvconst(3,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(11,64),bvconst(4,64),bvconst(2,64),bvconst(14,64),bvconst(2,64),bvconst(11,64),bvconst(4,64),bvconst(1,8),bvconst(4096,64),bvconst(16,64),bvconst(5,64),bvconst(11,64),bvconst(2,64),bvconst(14,64),bvconst(2,64),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(2,64),bvconst(2,64),bvconst(9,64),bvconst(4,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8),bvconst(3,64),bvconst(10,64),bvconst(9,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),ptr107_max(),bvconst(0,64),bvconst(1,8),bvconst(1,8))))
}

example "reject reused admission ticket" {
    assert(¬(in108_request(bvconst(20,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8),bvconst(4294967303,64),bvconst(3,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(11,64),bvconst(4,64),bvconst(2,64),bvconst(14,64),bvconst(2,64),bvconst(11,64),bvconst(4,64),bvconst(1,8),bvconst(4096,64),bvconst(16,64),bvconst(5,64),bvconst(11,64),bvconst(2,64),bvconst(14,64),bvconst(2,64),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(2,64),bvconst(2,64),bvconst(9,64),bvconst(4,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8),bvconst(3,64),bvconst(10,64),bvconst(9,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,64),bvconst(1,64),bvconst(0,8),bvconst(1,8))))
}

example "reject whole detached-source request" {
    assert(¬(in108_request(bvconst(20,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8),bvconst(4294967303,64),bvconst(3,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(11,64),bvconst(4,64),bvconst(2,64),bvconst(14,64),bvconst(2,64),bvconst(11,64),bvconst(4,64),bvconst(1,8),bvconst(4096,64),bvconst(16,64),bvconst(5,64),bvconst(11,64),bvconst(2,64),bvconst(14,64),bvconst(2,64),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(2,64),bvconst(2,64),bvconst(9,64),bvconst(4,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(1,8),bvconst(3,64),bvconst(10,64),bvconst(9,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(1,8))))
}

example "reject whole raw-destination request" {
    assert(¬(in108_request(bvconst(20,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8),bvconst(4294967303,64),bvconst(3,64),bvconst(0,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(11,64),bvconst(4,64),bvconst(2,64),bvconst(14,64),bvconst(2,64),bvconst(11,64),bvconst(4,64),bvconst(1,8),bvconst(4096,64),bvconst(16,64),bvconst(5,64),bvconst(11,64),bvconst(2,64),bvconst(14,64),bvconst(2,64),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(2,64),bvconst(2,64),bvconst(9,64),bvconst(4,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8),bvconst(3,64),bvconst(10,64),bvconst(9,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(1,8))))
}

example "interior byte clears tag" {
    assert(in108_tag(bvconst(1,8),bvconst(17,64),bvconst(1,64),bvconst(16,64),bvconst(1,8))=bvconst(0,8))
}

example "last cell byte clears tag" {
    assert(in108_tag(bvconst(1,8),bvconst(31,64),bvconst(1,64),bvconst(16,64),bvconst(1,8))=bvconst(0,8))
}

example "cross-cell prefix clears tag" {
    assert(in108_tag(bvconst(1,8),bvconst(15,64),bvconst(2,64),bvconst(16,64),bvconst(1,8))=bvconst(0,8))
}

example "adjacent cell tag survives" {
    assert(in108_tag(bvconst(1,8),bvconst(16,64),bvconst(16,64),bvconst(32,64),bvconst(1,8))=bvconst(1,8))
}

example "zero count preserves tag" {
    assert(in108_tag(bvconst(1,8),bvconst(16,64),bvconst(0,64),bvconst(16,64),bvconst(1,8))=bvconst(1,8))
}

example "input cannot mint pointer kind" {
    assert(in108_tag(bvconst(1,8),bvconst(16,64),bvconst(1,64),bvconst(16,64),bvconst(0,8))=bvconst(0,8))
}

example "count bounded by capacity and remaining" {
    assert(∀(c : BitVec64). ∀(p : BitVec64). ∀(t : BitVec64).
    (bvule(p,t) ∧ bvule(c,io108_limit())) →
    (bvule(in108_count(c,p,t),c) ∧ bvule(in108_count(c,p,t),bvsub(t,p))))
}

example "successful cursor does not wrap or exceed input" {
    assert(∀(c : BitVec64). ∀(p : BitVec64). ∀(t : BitVec64).
    (bvule(p,t) ∧ bvule(c,io108_limit())) →
    (bvuge(in108_cursor(bvconst(1,8),p,in108_count(c,p,t)),p) ∧
     bvule(in108_cursor(bvconst(1,8),p,in108_count(c,p,t)),t)))
}

example "failure consumes no source bytes" {
    assert(∀(p : BitVec64). ∀(n : BitVec64).
    in108_cursor(bvconst(0,8),p,n)=p)
}

example "failure changes no destination byte" {
    assert(∀(p : BitVec64). ∀(n : BitVec64). ∀(q : BitVec64). ∀(b : BitVec8). ∀(old : BitVec8).
    in108_byte(bvconst(0,8),p,n,q,b,old)=old)
}

example "failure changes no destination kind" {
    assert(∀(p : BitVec64). ∀(n : BitVec64). ∀(cell : BitVec64). ∀(old : BitVec8).
    in108_tag(bvconst(0,8),p,n,cell,old)=old)
}

example "zero count changes no kind" {
    assert(∀(p : BitVec64). ∀(cell : BitVec64). ∀(old : BitVec8).
    in108_tag(bvconst(1,8),p,bvconst(0,64),cell,old)=old)
}

example "raw input never creates a protected tag" {
    assert(∀(p : BitVec64). ∀(n : BitVec64). ∀(cell : BitVec64).
    in108_tag(bvconst(1,8),p,n,cell,bvconst(0,8))=bvconst(0,8))
}

example "short read preserves destination tail" {
    assert(∀(p : BitVec64). ∀(n : BitVec64). ∀(q : BitVec64). ∀(b : BitVec8). ∀(old : BitVec8).
    (bvuge(q,p) ∧ bvuge(bvsub(q,p),n)) → in108_byte(bvconst(1,8),p,n,q,b,old)=old)
}

example "destination authority refines each exact WRITE byte" {
    assert(∀(h : BitVec64). ∀(pos : BitVec64). ∀(tag : BitVec8). ∀(slot : BitVec64). ∀(epoch : BitVec64). ∀(descriptor_live : BitVec8). ∀(caller_domain : BitVec64). ∀(descriptor_domain : BitVec64). ∀(caller_context : BitVec64). ∀(owner_context : BitVec64). ∀(descriptor_id : BitVec64). ∀(descriptor_gen : BitVec64). ∀(lo : BitVec64). ∀(hi : BitVec64). ∀(rights : BitVec64). ∀(allocation_id : BitVec64). ∀(allocation_gen : BitVec64). ∀(allocation_live : BitVec8). ∀(base : BitVec64). ∀(extent : BitVec64). ∀(length : BitVec64). ∀(cap_object : BitVec64). ∀(cap_lo : BitVec64). ∀(cap_hi : BitVec64). ∀(cap_rights : BitVec64). ∀(fabric_current : BitVec8). ∀(i : BitVec64).
    (in108_destination(h,pos,tag,slot,epoch,descriptor_live,caller_domain,descriptor_domain,caller_context,owner_context,descriptor_id,descriptor_gen,lo,hi,rights,allocation_id,allocation_gen,allocation_live,base,extent,length,cap_object,cap_lo,cap_hi,cap_rights,fabric_current) ∧ bvult(i,length)) → repr107_access(h,bvadd(pos,i),tag,slot,epoch,descriptor_live,caller_domain,descriptor_domain,descriptor_id,descriptor_gen,lo,hi,rights,allocation_id,allocation_gen,allocation_live,base,extent,bvconst(1,64),bvconst(2,64),fabric_current,bvconst(1,8)))
}

example "source byte index stays within immutable image" {
    assert(∀(capacity : BitVec64). ∀(cursor : BitVec64). ∀(total : BitVec64). ∀(pos : BitVec64). ∀(query : BitVec64).
    (bvule(cursor,total) ∧ bvule(capacity,io108_limit()) ∧ bvuge(query,pos) ∧
     bvult(bvsub(query,pos),in108_count(capacity,cursor,total))) →
    (bvuge(in108_source_index(cursor,pos,query),cursor) ∧
     bvult(in108_source_index(cursor,pos,query),total)))
}

example "rejected commit cannot advance input cursor" {
    assert(∀(ready : BitVec8). ∀(destination_ok : BitVec8). ∀(stream_ok : BitVec8). ∀(expected_id : BitVec64). ∀(current_id : BitVec64). ∀(expected_gen : BitVec64). ∀(current_gen : BitVec64). ∀(expected_cursor : BitVec64). ∀(cursor : BitVec64). ∀(total : BitVec64). ∀(capacity : BitVec64). ∀(copied : BitVec64). ∀(phase : BitVec8). ∀(active : BitVec8). ∀(bound : BitVec8). ∀(fabric_current : BitVec8). ∀(serialized : BitVec8).
    ¬(in108_commit(ready,destination_ok,stream_ok,expected_id,current_id,expected_gen,current_gen,expected_cursor,cursor,total,capacity,copied,phase,active,bound,fabric_current,serialized)) → in108_cursor(in108_commit_flag(ready,destination_ok,stream_ok,expected_id,current_id,expected_gen,current_gen,expected_cursor,cursor,total,capacity,copied,phase,active,bound,fabric_current,serialized),cursor,copied)=cursor)
}

example "rejected commit cannot publish a destination byte" {
    assert(∀(ready : BitVec8). ∀(destination_ok : BitVec8). ∀(stream_ok : BitVec8). ∀(expected_id : BitVec64). ∀(current_id : BitVec64). ∀(expected_gen : BitVec64). ∀(current_gen : BitVec64). ∀(expected_cursor : BitVec64). ∀(cursor : BitVec64). ∀(total : BitVec64). ∀(capacity : BitVec64). ∀(copied : BitVec64). ∀(phase : BitVec8). ∀(active : BitVec8). ∀(bound : BitVec8). ∀(fabric_current : BitVec8). ∀(serialized : BitVec8). ∀(pos : BitVec64). ∀(query : BitVec64). ∀(b : BitVec8). ∀(old : BitVec8).
    ¬(in108_commit(ready,destination_ok,stream_ok,expected_id,current_id,expected_gen,current_gen,expected_cursor,cursor,total,capacity,copied,phase,active,bound,fabric_current,serialized)) → in108_byte(in108_commit_flag(ready,destination_ok,stream_ok,expected_id,current_id,expected_gen,current_gen,expected_cursor,cursor,total,capacity,copied,phase,active,bound,fabric_current,serialized),pos,copied,query,b,old)=old)
}

example "input result scalar clears result tag" {
    assert(event107_tag(bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,64),bvconst(0,64),bvconst(1,8),bvconst(1,8))=bvconst(0,8))
}

example "destination pair survives return" {
    assert(event107_tag(bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,64),bvconst(2,64),bvconst(1,8),bvconst(0,8))=bvconst(1,8))
}

example "input must drain borrow before return" {
    assert(¬(io108_return(bvconst(1,8),bvconst(0,8),bvconst(0,64),bvconst(0,64))))
}

example "input error returns sentinel" {
    assert(io108_result(bvconst(0,8),bvconst(3,64))=ptr107_max())
}


// Loader authority is separate from permission to call read_bytes. An input
// image cannot be replaced/reset while live or while any operation retains it.
// IDs select records, nonwrapping generations distinguish each provisioning.
define in108_provision(old_live : BitVec8, new_live : BitVec8,
    old_gen : BitVec64, new_gen : BitVec64, trusted_loader : BitVec8,
    drained : BitVec8, serialized : BitVec8) =
    (old_live=bvconst(0,8)) ∧ (new_live=bvconst(1,8)) ∧
    bvult(old_gen,ptr107_max()) ∧ (new_gen=bvadd(old_gen,bvconst(1,64))) ∧
    (trusted_loader=bvconst(1,8)) ∧ (drained=bvconst(1,8)) ∧ (serialized=bvconst(1,8))
define in108_detach(old_live : BitVec8, new_live : BitVec8,
    outstanding : BitVec64, trusted_owner : BitVec8, serialized : BitVec8) =
    (old_live=bvconst(1,8)) ∧ (new_live=bvconst(0,8)) ∧
    (outstanding=bvconst(0,64)) ∧ (trusted_owner=bvconst(1,8)) ∧ (serialized=bvconst(1,8))

example "trusted first input provision" {
    assert(in108_provision(bvconst(0,8),bvconst(1,8),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8)))
}

example "reject overwrite live input" {
    assert(¬(in108_provision(bvconst(1,8),bvconst(1,8),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8))))
}

example "reject zero provisioning generation" {
    assert(¬(in108_provision(bvconst(0,8),bvconst(1,8),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8),bvconst(1,8))))
}

example "reject guest provisions input" {
    assert(¬(in108_provision(bvconst(0,8),bvconst(1,8),bvconst(0,64),bvconst(1,64),bvconst(0,8),bvconst(1,8),bvconst(1,8))))
}

example "reject rebind retained source" {
    assert(¬(in108_provision(bvconst(0,8),bvconst(1,8),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(0,8),bvconst(1,8))))
}

example "reject unserialized provision" {
    assert(¬(in108_provision(bvconst(0,8),bvconst(1,8),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(0,8))))
}

example "reject input generation wrap" {
    assert(¬(in108_provision(bvconst(0,8),bvconst(1,8),ptr107_max(),bvconst(0,64),bvconst(1,8),bvconst(1,8),bvconst(1,8))))
}

example "drained input detach" {
    assert(in108_detach(bvconst(1,8),bvconst(0,8),bvconst(0,64),bvconst(1,8),bvconst(1,8)))
}

example "reject double detach" {
    assert(¬(in108_detach(bvconst(0,8),bvconst(0,8),bvconst(0,64),bvconst(1,8),bvconst(1,8))))
}

example "reject detach source still in use" {
    assert(¬(in108_detach(bvconst(1,8),bvconst(0,8),bvconst(1,64),bvconst(1,8),bvconst(1,8))))
}

example "reject foreign source detach" {
    assert(¬(in108_detach(bvconst(1,8),bvconst(0,8),bvconst(0,64),bvconst(0,8),bvconst(1,8))))
}

example "EOF whole request remains authenticated" {
    assert(in108_request(bvconst(20,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8),bvconst(4294967303,64),bvconst(3,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(11,64),bvconst(4,64),bvconst(2,64),bvconst(14,64),bvconst(2,64),bvconst(11,64),bvconst(4,64),bvconst(1,8),bvconst(4096,64),bvconst(16,64),bvconst(5,64),bvconst(11,64),bvconst(2,64),bvconst(14,64),bvconst(2,64),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(2,64),bvconst(2,64),bvconst(9,64),bvconst(4,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8),bvconst(10,64),bvconst(10,64),bvconst(9,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(1,8)))
}

example "reject EOF capacity outside view despite zero copied" {
    assert(¬(in108_request(bvconst(20,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8),bvconst(4294967303,64),bvconst(3,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(11,64),bvconst(4,64),bvconst(2,64),bvconst(7,64),bvconst(2,64),bvconst(11,64),bvconst(4,64),bvconst(1,8),bvconst(4096,64),bvconst(16,64),bvconst(5,64),bvconst(11,64),bvconst(2,64),bvconst(14,64),bvconst(2,64),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(2,64),bvconst(2,64),bvconst(9,64),bvconst(4,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8),bvconst(10,64),bvconst(10,64),bvconst(9,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(1,8))))
}

example "reject missing stream is not EOF" {
    assert(¬(in108_request(bvconst(20,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8),bvconst(4294967303,64),bvconst(3,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(11,64),bvconst(4,64),bvconst(2,64),bvconst(14,64),bvconst(2,64),bvconst(11,64),bvconst(4,64),bvconst(1,8),bvconst(4096,64),bvconst(16,64),bvconst(5,64),bvconst(11,64),bvconst(2,64),bvconst(14,64),bvconst(2,64),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(2,64),bvconst(2,64),bvconst(9,64),bvconst(4,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(1,8),bvconst(10,64),bvconst(10,64),bvconst(9,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(1,8))))
}

example "reject EOF READ-only destination" {
    assert(¬(in108_request(bvconst(20,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8),bvconst(4294967303,64),bvconst(3,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(11,64),bvconst(4,64),bvconst(2,64),bvconst(14,64),bvconst(1,64),bvconst(11,64),bvconst(4,64),bvconst(1,8),bvconst(4096,64),bvconst(16,64),bvconst(5,64),bvconst(11,64),bvconst(2,64),bvconst(14,64),bvconst(2,64),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(2,64),bvconst(2,64),bvconst(9,64),bvconst(4,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8),bvconst(10,64),bvconst(10,64),bvconst(9,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(1,8))))
}

example "short read returns three" {
    assert(io108_result(bvconst(1,8),bvconst(3,64))=bvconst(3,64))
}

example "EOF returns zero" {
    assert(io108_result(bvconst(1,8),bvconst(0,64))=bvconst(0,64))
}
