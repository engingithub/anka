// Phase 10.8 next slice: synchronous read of an immutable process-owned input.
// SPECIFICATION ONLY. No new axioms, runtime, compiler or input device claim.
// Proposed SYS_READ_BYTES=20 (current implemented syscall numbers stop at 19).
// Trap: scalar R0=20,R1=0; tagged R2/R3 destination; scalar R4=capacity,R5=0.
// Input is provisioned by trusted loader/boot policy, not a guest-selected address.
// One immutable <=1 MiB image + cursor is bound to process slot/generation,
// context and domain. No ambient global stdin, filesystem or authority transfer.
// A read validates the ENTIRE capacity even at EOF/zero count, writes exactly
// min(capacity,remaining), and atomically advances the source cursor with write.
// Zero-capacity/EOF issues no memory transaction; it never skips authentication.
// Source input cannot alias guest-writable memory. Supplied byte values below
// denote the immutable image at the checked source index, never kernel padding.
import "anka108_typed_syscall_io.kleis"

define in108_abi(number : BitVec64, reserved : BitVec64, flags : BitVec64,
    kind01 : BitVec8, kind45 : BitVec8) =
    (number=bvconst(20,64)) ∧ (reserved=bvconst(0,64)) ∧
    (flags=bvconst(0,64)) ∧ (kind01=bvconst(0,8)) ∧ (kind45=bvconst(0,8))

// Uses the existing nonwrapping view/whole-range check, but requires WRITE,
// not READ, from both descriptor and a single generation-current Fabric grant.
define in108_destination(h : BitVec64, pos : BitVec64, tag : BitVec8,
    slot : BitVec64, epoch : BitVec64, descriptor_live : BitVec8,
    caller_domain : BitVec64, descriptor_domain : BitVec64,
    caller_context : BitVec64, owner_context : BitVec64,
    descriptor_id : BitVec64, descriptor_gen : BitVec64,
    lo : BitVec64, hi : BitVec64, rights : BitVec64,
    allocation_id : BitVec64, allocation_gen : BitVec64, allocation_live : BitVec8,
    base : BitVec64, extent : BitVec64, length : BitVec64,
    cap_object : BitVec64, cap_lo : BitVec64, cap_hi : BitVec64,
    cap_rights : BitVec64, fabric_current : BitVec8) =
    repr107_lookup(h,tag,slot,epoch,descriptor_live,caller_domain,descriptor_domain) ∧
    (caller_context=owner_context) ∧
    ptr107_current(descriptor_id,descriptor_gen,allocation_id,allocation_gen,
        allocation_live,tag) ∧
    ptr107_record_valid(allocation_id,allocation_gen,base,extent) ∧
    io108_range(lo,hi,pos,extent,length) ∧
    bvule(rights,bvconst(3,64)) ∧ (bvand(rights,bvconst(2,64))=bvconst(2,64)) ∧
    (cap_object=allocation_id) ∧ bvule(cap_lo,pos) ∧ bvule(pos,cap_hi) ∧
    bvule(cap_hi,extent) ∧ bvule(length,bvsub(cap_hi,pos)) ∧
    bvule(cap_rights,bvconst(3,64)) ∧
    (bvand(cap_rights,bvconst(2,64))=bvconst(2,64)) ∧
    (fabric_current=bvconst(1,8))

define in108_stream(stream_id : BitVec64, selected_id : BitVec64,
    stream_gen : BitVec64, selected_gen : BitVec64,
    stream_context : BitVec64, caller_context : BitVec64,
    stream_domain : BitVec64, caller_domain : BitVec64,
    stream_slot : BitVec64, caller_slot : BitVec64,
    stream_process_gen : BitVec64, caller_process_gen : BitVec64,
    source_live : BitVec8, source_immutable : BitVec8,
    cursor : BitVec64, total : BitVec64) =
    bvugt(stream_id,bvconst(0,64)) ∧ bvugt(stream_gen,bvconst(0,64)) ∧
    (stream_id=selected_id) ∧ (stream_gen=selected_gen) ∧
    (stream_context=caller_context) ∧ (stream_domain=caller_domain) ∧
    (stream_slot=caller_slot) ∧ (stream_process_gen=caller_process_gen) ∧
    (source_live=bvconst(1,8)) ∧ (source_immutable=bvconst(1,8)) ∧
    bvule(cursor,total) ∧ bvule(total,bvconst(1048576,64))

// Only meaningful under valid cursor/total and bounded capacity predicates.
define in108_count(capacity : BitVec64, cursor : BitVec64, total : BitVec64) =
    if bvule(capacity,bvsub(total,cursor)) then capacity else bvsub(total,cursor)
define in108_begin(abi_ok : BitVec8, destination_ok : BitVec8,
    stream_ok : BitVec8, event_ok : BitVec8, phase : BitVec8,
    count : BitVec64, next : BitVec64, fresh : BitVec8, serialized : BitVec8) =
    (stream_ok=bvconst(1,8)) ∧
    io108_begin(abi_ok,destination_ok,event_ok,phase,count,next,fresh,serialized)

// Current certificates derive from the full predicates, not user-writable flags.
// Expected id/gen/cursor bind ONE operation; final check and all effects share
// a serialized commit boundary. Capacity remains the ORIGINAL requested range.
// Partial Fabric writes followed by an error are forbidden: preflight everything
// and use one exact-range atomic write (or a verified equivalent transaction).
define in108_commit(ready : BitVec8, destination_ok : BitVec8, stream_ok : BitVec8,
    expected_id : BitVec64, current_id : BitVec64,
    expected_gen : BitVec64, current_gen : BitVec64,
    expected_cursor : BitVec64, cursor : BitVec64, total : BitVec64,
    capacity : BitVec64, copied : BitVec64,
    phase : BitVec8, active : BitVec8, bound : BitVec8,
    fabric_current : BitVec8, serialized : BitVec8) =
    (ready=bvconst(1,8)) ∧ (destination_ok=bvconst(1,8)) ∧ (stream_ok=bvconst(1,8)) ∧
    bvugt(current_id,bvconst(0,64)) ∧ bvugt(current_gen,bvconst(0,64)) ∧
    (expected_id=current_id) ∧ (expected_gen=current_gen) ∧
    (expected_cursor=cursor) ∧ bvule(cursor,total) ∧ bvule(total,bvconst(1048576,64)) ∧
    bvule(capacity,io108_limit()) ∧ (copied=in108_count(capacity,cursor,total)) ∧
    conc107_commit(phase,active,bound,fabric_current,serialized)
define in108_commit_flag(ready : BitVec8, destination_ok : BitVec8, stream_ok : BitVec8,
    expected_id : BitVec64, current_id : BitVec64,
    expected_gen : BitVec64, current_gen : BitVec64,
    expected_cursor : BitVec64, cursor : BitVec64, total : BitVec64,
    capacity : BitVec64, copied : BitVec64,
    phase : BitVec8, active : BitVec8, bound : BitVec8,
    fabric_current : BitVec8, serialized : BitVec8) =
    if in108_commit(ready,destination_ok,stream_ok,expected_id,current_id,
        expected_gen,current_gen,expected_cursor,cursor,total,capacity,copied,
        phase,active,bound,fabric_current,serialized) then bvconst(1,8) else bvconst(0,8)
define in108_cursor(committed : BitVec8, old : BitVec64, count : BitVec64) =
    if committed=bvconst(1,8) then bvadd(old,count) else old
// Exact memory effect reuses output's proven pointwise interval frame, but its
// coordinates now name DESTINATION bytes, not the console sink.
define in108_byte(committed : BitVec8, pos : BitVec64, count : BitVec64,
    query : BitVec64, source : BitVec8, old : BitVec8) =
    io108_sink_byte(committed,pos,count,query,source,old)
// cell/pos use PHYSICAL coordinates: typed aliases must also lose kind.
// This is a raw-byte input write, never typed pointer import or tag publication.
define in108_tag(committed : BitVec8, pos : BitVec64, count : BitVec64,
    cell : BitVec64, old : BitVec8) =
    if committed=bvconst(1,8) ∧ bvugt(count,bvconst(0,64)) ∧
        (if bvule(pos,cell) then bvult(bvsub(cell,pos),count)
         else bvult(bvsub(pos,cell),bvconst(16,64)))
    then bvconst(0,8) else old
// Source cursor index for the byte mapped to destination query, checked below.
define in108_source_index(cursor : BitVec64, pos : BitVec64, query : BitVec64) =
    bvadd(cursor,bvsub(query,pos))

// Complete admission binds destination, input image, event and lease together.
define in108_request(number : BitVec64,
    reserved : BitVec64,
    flags : BitVec64,
    kind01 : BitVec8,
    kind45 : BitVec8,
    h : BitVec64,
    pos : BitVec64,
    tag : BitVec8,
    slot : BitVec64,
    epoch : BitVec64,
    descriptor_live : BitVec8,
    caller_domain : BitVec64,
    descriptor_domain : BitVec64,
    caller_context : BitVec64,
    owner_context : BitVec64,
    descriptor_id : BitVec64,
    descriptor_gen : BitVec64,
    lo : BitVec64,
    hi : BitVec64,
    rights : BitVec64,
    allocation_id : BitVec64,
    allocation_gen : BitVec64,
    allocation_live : BitVec8,
    base : BitVec64,
    extent : BitVec64,
    length : BitVec64,
    cap_object : BitVec64,
    cap_lo : BitVec64,
    cap_hi : BitVec64,
    cap_rights : BitVec64,
    fabric_current : BitVec8,
    stream_id : BitVec64,
    selected_id : BitVec64,
    stream_gen : BitVec64,
    selected_gen : BitVec64,
    stream_context : BitVec64,
    stream_domain : BitVec64,
    stream_slot : BitVec64,
    caller_slot : BitVec64,
    stream_process_gen : BitVec64,
    caller_process_gen : BitVec64,
    source_live : BitVec8,
    source_immutable : BitVec8,
    cursor : BitVec64,
    total : BitVec64,
    saved_context : BitVec64,
    saved_domain : BitVec64,
    public_depth : BitVec64,
    protected_depth : BitVec64,
    header_exact : BitVec8,
    saved_mode : BitVec8,
    phase : BitVec8,
    cpu_count : BitVec64,
    next_cpu_count : BitVec64,
    fresh : BitVec8,
    serialized : BitVec8) =
    in108_abi(number,reserved,flags,kind01,kind45) ∧
    in108_destination(h,pos,tag,slot,epoch,descriptor_live,caller_domain,descriptor_domain,caller_context,owner_context,descriptor_id,descriptor_gen,lo,hi,rights,allocation_id,allocation_gen,allocation_live,base,extent,length,cap_object,cap_lo,cap_hi,cap_rights,fabric_current) ∧
    in108_stream(stream_id,selected_id,stream_gen,selected_gen,stream_context,caller_context,stream_domain,caller_domain,stream_slot,caller_slot,stream_process_gen,caller_process_gen,source_live,source_immutable,cursor,total) ∧
    event107_admit(saved_context,caller_context,saved_domain,caller_domain,public_depth,protected_depth,header_exact,bvconst(1,8),saved_mode) ∧
    conc107_admit(phase,cpu_count,next_cpu_count,bvconst(1,8),fresh,serialized)

example "input scalar trap ABI" {
    assert(in108_abi(bvconst(20,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8)))
}

example "reject output number on input path" {
    assert(¬(in108_abi(bvconst(1,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(0,8))))
}

example "reject reserved lane" {
    assert(¬(in108_abi(bvconst(20,64),bvconst(1,64),bvconst(0,64),bvconst(0,8),bvconst(0,8))))
}

example "reject unsupported flags" {
    assert(¬(in108_abi(bvconst(20,64),bvconst(0,64),bvconst(1,64),bvconst(0,8),bvconst(0,8))))
}

example "reject tagged number" {
    assert(¬(in108_abi(bvconst(20,64),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(0,8))))
}

example "reject tagged capacity" {
    assert(¬(in108_abi(bvconst(20,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(1,8))))
}

example "write-only destination sufficient" {
    assert(in108_destination(bvconst(4294967303,64),bvconst(3,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(11,64),bvconst(4,64),bvconst(2,64),bvconst(14,64),bvconst(2,64),bvconst(11,64),bvconst(4,64),bvconst(1,8),bvconst(4096,64),bvconst(16,64),bvconst(5,64),bvconst(11,64),bvconst(2,64),bvconst(14,64),bvconst(2,64),bvconst(1,8)))
}

example "reject integer destination" {
    assert(¬(in108_destination(bvconst(4294967303,64),bvconst(3,64),bvconst(0,8),bvconst(7,64),bvconst(1,64),bvconst(1,8),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(11,64),bvconst(4,64),bvconst(2,64),bvconst(14,64),bvconst(2,64),bvconst(11,64),bvconst(4,64),bvconst(1,8),bvconst(4096,64),bvconst(16,64),bvconst(5,64),bvconst(11,64),bvconst(2,64),bvconst(14,64),bvconst(2,64),bvconst(1,8))))
}

