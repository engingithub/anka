// Proposed CC2 application pointer ABI v2, not implemented or an existing ABI.
// Imports semantic representation and concurrency contracts; no new axioms.
// Pointer size/alignment 16. Payload word0 handle, word1 byte position.
// Protected tags live in trusted CPU/Fabric side state, inaccessible to data/DMA.
// CPU pairs: R0/R1,R2/R3,R4/R5,R6/R7,R8/R9,R10/R11. R12 scalar;
// R13 FP,R14 LR,R15 SP are reserved ordinary architectural registers.
// Args consume R0..R3 lanes, pointer starts even. No stack arguments in v2 subset.
// Pointer return R0/R1, scalar R0. Expression pointer temporary R4/R5.
// All R0..R12 caller-clobbered; live pointers require typed spills across calls.
// Tagged null is not minted: canonical null remains untagged zero/zero.
import "anka107_pointer_concurrency.kleis"

define kind107_pair(start : BitVec64) =
    bvule(start,bvconst(10,64)) ∧ (bvand(start,bvconst(1,64))=bvconst(0,64))
define kind107_next_pointer_lane(lane : BitVec64) =
    bvand(bvadd(lane,bvconst(1,64)),bvsub(ptr107_max(),bvconst(1,64)))
define kind107_arg(lane : BitVec64, pointer : BitVec8,
    assigned : BitVec64, next : BitVec64) =
    bvule(lane,bvconst(4,64)) ∧
    (((pointer=bvconst(1,8)) ∧
        (assigned=kind107_next_pointer_lane(lane)) ∧ bvule(assigned,bvconst(2,64)) ∧
        (next=bvadd(assigned,bvconst(2,64)))) ∨
     ((pointer=bvconst(0,8)) ∧ bvult(lane,bvconst(4,64)) ∧
        (assigned=lane) ∧ (next=bvadd(lane,bvconst(1,64)))))

define kind107_pointer_size() = bvconst(16,64)
define kind107_pointer_alignment() = bvconst(16,64)

// Cell keys are (Fabric object identity, generation, aligned object offset),
// not virtual addresses. All aliases therefore share the protected tag entry.
define kind107_cell(offset : BitVec64, extent : BitVec64) =
    (bvand(offset,bvconst(15,64))=bvconst(0,64)) ∧
    app107_range_valid(offset,extent,bvconst(16,64))
define kind107_storage_key(object : BitVec64, gen : BitVec64, offset : BitVec64,
    tagobject : BitVec64, taggen : BitVec64, tagoffset : BitVec64) =
    (object=tagobject) ∧ (gen=taggen) ∧ (offset=tagoffset)

// Ordinary write to either half clears the pair tag before execution. Other
// pairs' tags survive. Generic arithmetic/load/MOV cannot copy pointer kind.
define kind107_raw_register(pair : BitVec64, written : BitVec64, oldtag : BitVec8) =
    if (written=pair) ∨ (written=bvadd(pair,bvconst(1,64))) then bvconst(0,8) else oldtag

// Checked intervals; tags on ALL overlapping 16-byte cells must be cleared
// before raw CPU or DMA mutation, independent of virtual alias or byte width.
define kind107_span(base : BitVec64, length : BitVec64) =
    bvugt(length,bvconst(0,64)) ∧ bvule(length,bvsub(ptr107_max(),base))
define kind107_overlap(base : BitVec64, length : BitVec64, cell : BitVec64) =
    kind107_span(base,length) ∧ kind107_span(cell,bvconst(16,64)) ∧
    bvult(base,bvadd(cell,bvconst(16,64))) ∧ bvult(cell,bvadd(base,length))
define kind107_raw_memory(base : BitVec64, length : BitVec64,
    cell : BitVec64, oldtag : BitVec8) =
    if kind107_overlap(base,length,cell) then bvconst(0,8) else oldtag

// Valid-null transport is explicit and separate from authenticated pointers.
define kind107_transport(h : BitVec64, pos : BitVec64, tag : BitVec8,
    outh : BitVec64, outpos : BitVec64, outtag : BitVec8, coherent : BitVec8) =
    repr107_transport(h,pos,tag,outh,outpos,outtag,coherent) ∨
    (repr107_null(h,pos,tag) ∧ repr107_null(outh,outpos,outtag) ∧
        (coherent=bvconst(1,8)))

// Trusted typed move/load/store/spill/reload operation. Authenticated source
// metadata, exact pair transport, permission, cell keys and concurrency protocol
// must ALL pass. No application-accessible set-tag operation is introduced.
define kind107_typed_storage(h : BitVec64, pos : BitVec64, tag : BitVec8,
    outh : BitVec64, outpos : BitVec64, outtag : BitVec8,
    offset : BitVec64, extent : BitVec64, trusted_operation : BitVec8,
    source_validated : BitVec8, exact_key : BitVec8,
    fabric_permission : BitVec8, coherent_protocol : BitVec8) =
    kind107_cell(offset,extent) ∧
    kind107_transport(h,pos,tag,outh,outpos,outtag,coherent_protocol) ∧
    (trusted_operation=bvconst(1,8)) ∧ (source_validated=bvconst(1,8)) ∧
    (exact_key=bvconst(1,8)) ∧ (fabric_permission=bvconst(1,8))

// ABI version + ordered pointer/scalar signature must match exactly.
// Signature identity refers to canonical typed metadata, not an unchecked hash.
// Domain transition and raw/syscall v1 bridging require separately verified gates.
define kind107_call(caller_version : BitVec64, callee_version : BitVec64,
    caller_signature : BitVec64, callee_signature : BitVec64,
    current_domain : BitVec64, callee_domain : BitVec64,
    slots_valid : BitVec8, tags_preserved : BitVec8, code_admitted : BitVec8) =
    (caller_version=bvconst(2,64)) ∧ (callee_version=bvconst(2,64)) ∧
    (caller_signature=callee_signature) ∧ (current_domain=callee_domain) ∧
    (slots_valid=bvconst(1,8)) ∧ (tags_preserved=bvconst(1,8)) ∧
    (code_admitted=bvconst(1,8))

// Returns use fixed registers; pointer kind must survive both words together.
define kind107_return(pointer : BitVec8, first : BitVec64, second : BitVec64,
    pair_validated : BitVec8) =
    (first=bvconst(0,64)) ∧
    (((pointer=bvconst(1,8)) ∧ (second=bvconst(1,64)) ∧ (pair_validated=bvconst(1,8))) ∨
     ((pointer=bvconst(0,8)) ∧ (pair_validated=bvconst(0,8))))

// Frame extent and base align 16. A 16-byte spill slot must fit completely.
// Lifetime association prevents a slot at a reused stack address regaining kind.
define kind107_spill(base : BitVec64, extent : BitVec64, offset : BitVec64,
    saved_scope : BitVec64, current_scope : BitVec64,
    saved_gen : BitVec64, current_gen : BitVec64, live : BitVec8) =
    (bvand(base,bvconst(15,64))=bvconst(0,64)) ∧
    (bvand(extent,bvconst(15,64))=bvconst(0,64)) ∧ kind107_span(base,extent) ∧
    kind107_cell(offset,extent) ∧ (saved_scope=current_scope) ∧
    (saved_gen=current_gen) ∧ (live=bvconst(1,8))

// Context switching saves/restores tags with the payload in trusted kernel
// storage, bound to the same thread and domain. User buffers cannot restore tags.
define kind107_context(saved_thread : BitVec64, resumed_thread : BitVec64,
    saved_domain : BitVec64, resumed_domain : BitVec64,
    protected_image : BitVec8, payload_tags_coherent : BitVec8) =
    (saved_thread=resumed_thread) ∧ (saved_domain=resumed_domain) ∧
    (protected_image=bvconst(1,8)) ∧ (payload_tags_coherent=bvconst(1,8))

example "KIND107-1 valid register pair 0" { assert(kind107_pair(bvconst(0,64))) }

