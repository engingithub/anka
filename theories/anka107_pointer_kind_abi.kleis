example "KIND107 universal ordinary register write cannot mint kind" {
    assert(∀(p : BitVec64). ∀(w : BitVec64).
        kind107_raw_register(p,w,bvconst(0,8))=bvconst(0,8))
}
example "KIND107 universal either register half invalidates kind" {
    assert(∀(p : BitVec64). kind107_pair(p) →
        (kind107_raw_register(p,bvadd(p,bvconst(1,64)),bvconst(1,8))=bvconst(0,8)))
}
example "KIND107 universal overlapping raw write clears kind" {
    assert(∀(b : BitVec64). ∀(len : BitVec64). ∀(cell : BitVec64). ∀(tag : BitVec8).
        kind107_overlap(b,len,cell) → (kind107_raw_memory(b,len,cell,tag)=bvconst(0,8)))
}
example "KIND107 universal typed nonnull transport refines representation" {
    assert(∀(h : BitVec64). ∀(pos : BitVec64). ∀(oh : BitVec64). ∀(op : BitVec64). ∀(ot : BitVec8).
        kind107_transport(h,pos,bvconst(1,8),oh,op,ot,bvconst(1,8)) →
        repr107_transport(h,pos,bvconst(1,8),oh,op,ot,bvconst(1,8)))
}
example "KIND107 universal pointer argument fits four lanes" {
    assert(∀(lane : BitVec64). ∀(assigned : BitVec64). ∀(next : BitVec64).
        kind107_arg(lane,bvconst(1,8),assigned,next) →
        (bvule(next,bvconst(4,64)) ∧ (bvand(assigned,bvconst(1,64))=bvconst(0,64))))
}

// Protected tag creation allowlist: 1 trusted descriptor issuance;
// 2 typed pair copy; 3 typed load; 4 checked derivation. Opcode identities
// are semantic operation classes, not assigned ISA instruction numbers.
// Generic integer operations (class 0) cannot set pointer-kind state.
define kind107_mint(operation : BitVec8, source_tag : BitVec8,
    source_validated : BitVec8, trusted_issuer : BitVec8,
    descriptor_validated : BitVec8) =
    ((operation=bvconst(1,8)) ∧ (trusted_issuer=bvconst(1,8)) ∧
        (descriptor_validated=bvconst(1,8))) ∨
    (((operation=bvconst(2,8)) ∨ (operation=bvconst(3,8)) ∨ (operation=bvconst(4,8))) ∧
        (source_tag=bvconst(1,8)) ∧ (source_validated=bvconst(1,8)))

// Call entry keeps kind ONLY for a pointer argument in the verified signature.
// Null incoming kind remains zero; nonargument/scratch pairs are cleared.
define kind107_entry_tag(pointer_argument : BitVec8,
    verified_lane : BitVec8, incoming_tag : BitVec8) =
    if (pointer_argument=bvconst(1,8)) ∧ (verified_lane=bvconst(1,8))
    then incoming_tag else bvconst(0,8)

// Representation/type-layout compatibility belongs in artifact/link metadata.
// Reject v1 pointer objects even when a numeric function signature happens to fit.
define kind107_link(object_abi : BitVec64, linked_abi : BitVec64,
    pointer_size : BitVec64, pointer_align : BitVec64,
    typed_metadata_verified : BitVec8) =
    (object_abi=bvconst(2,64)) ∧ (linked_abi=bvconst(2,64)) ∧
    (pointer_size=kind107_pointer_size()) ∧
    (pointer_align=kind107_pointer_alignment()) ∧ (typed_metadata_verified=bvconst(1,8))

example "KIND107 trusted allocation issues kind" { assert(kind107_mint(bvconst(1,8),bvconst(0,8),bvconst(0,8),bvconst(1,8),bvconst(1,8))) }

example "KIND107 integer instruction cannot mint kind" { assert(¬(kind107_mint(bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))) }

example "KIND107 untrusted allocation issuer" { assert(¬(kind107_mint(bvconst(1,8),bvconst(0,8),bvconst(0,8),bvconst(0,8),bvconst(1,8)))) }

example "KIND107 copy from untagged integer" { assert(¬(kind107_mint(bvconst(2,8),bvconst(0,8),bvconst(1,8),bvconst(0,8),bvconst(1,8)))) }

example "KIND107 typed load validates protected source" { assert(kind107_mint(bvconst(3,8),bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(0,8))) }

example "KIND107 derivation from unvalidated source" { assert(¬(kind107_mint(bvconst(4,8),bvconst(1,8),bvconst(0,8),bvconst(0,8),bvconst(0,8)))) }

example "KIND107 link verified v2 object" { assert(kind107_link(bvconst(2,64),bvconst(2,64),bvconst(16,64),bvconst(16,64),bvconst(1,8))) }

example "KIND107 link old eight byte pointers rejected" { assert(¬(kind107_link(bvconst(1,64),bvconst(2,64),bvconst(8,64),bvconst(8,64),bvconst(1,8)))) }

example "KIND107 link mismatched alignment rejected" { assert(¬(kind107_link(bvconst(2,64),bvconst(2,64),bvconst(16,64),bvconst(8,64),bvconst(1,8)))) }

example "KIND107 universal untyped call lane has no kind" {
    assert(∀(t : BitVec8). kind107_entry_tag(bvconst(0,8),bvconst(1,8),t)=bvconst(0,8))
}
example "KIND107 universal scratch pair cleared on call entry" {
    assert(∀(t : BitVec8). kind107_entry_tag(bvconst(1,8),bvconst(0,8),t)=bvconst(0,8))
}
example "KIND107 universal ordinary operations cannot mint tags" {
    assert(∀(t : BitVec8). ∀(valid : BitVec8). ∀(issuer : BitVec8). ∀(desc : BitVec8).
        ¬kind107_mint(bvconst(0,8),t,valid,issuer,desc))
}
example "KIND107 ABI two pointer signature allocation" {
    assert(kind107_arg(bvconst(0,64),bvconst(1,8),bvconst(0,64),bvconst(2,64)) ∧
        kind107_arg(bvconst(2,64),bvconst(1,8),bvconst(2,64),bvconst(4,64)))
}
example "KIND107 ABI int pointer int exceeds register subset" {
    assert(kind107_arg(bvconst(0,64),bvconst(0,8),bvconst(0,64),bvconst(1,64)) ∧
        kind107_arg(bvconst(1,64),bvconst(1,8),bvconst(2,64),bvconst(4,64)) ∧
        ¬kind107_arg(bvconst(4,64),bvconst(0,8),bvconst(4,64),bvconst(5,64)))
}

// Concrete pointer argument lowering composes lane assignment with actual
// handle/position/kind transport, not merely a caller-supplied preservation flag.
define kind107_pointer_argument(lane : BitVec64, assigned : BitVec64, next : BitVec64,
    h : BitVec64, pos : BitVec64, tag : BitVec8,
    outh : BitVec64, outpos : BitVec64, outtag : BitVec8, coherent : BitVec8) =
    kind107_arg(lane,bvconst(1,8),assigned,next) ∧
    kind107_transport(h,pos,tag,outh,outpos,outtag,coherent)
example "KIND107 universal argument lowering refines protected representation" {
    assert(∀(lane : BitVec64). ∀(assigned : BitVec64). ∀(next : BitVec64).
        ∀(h : BitVec64). ∀(pos : BitVec64). ∀(oh : BitVec64). ∀(op : BitVec64). ∀(ot : BitVec8).
        kind107_pointer_argument(lane,assigned,next,h,pos,bvconst(1,8),oh,op,ot,bvconst(1,8)) →
        repr107_transport(h,pos,bvconst(1,8),oh,op,ot,bvconst(1,8)))
}
example "KIND107 universal typed spill refines protected representation" {
    assert(∀(h : BitVec64). ∀(pos : BitVec64). ∀(oh : BitVec64). ∀(op : BitVec64).
        ∀(ot : BitVec8). ∀(offset : BitVec64). ∀(extent : BitVec64).
        kind107_typed_storage(h,pos,bvconst(1,8),oh,op,ot,offset,extent,
            bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)) →
        repr107_transport(h,pos,bvconst(1,8),oh,op,ot,bvconst(1,8)))
}
