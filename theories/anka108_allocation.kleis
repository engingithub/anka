    assert(¬(heap108_phase_after(heap108_publish(heap108_budget(bvconst(4352,64),bvconst(4352,64),bvconst(13056,64),bvconst(8704,64),bvconst(17408,64),bvconst(5,64),bvconst(5,64),bvconst(1,8)),heap108_layout(bvconst(17,64),bvconst(4096,64),bvconst(8192,64),bvconst(4096,64),bvconst(16384,64),bvconst(65536,64),bvconst(65536,64),bvconst(65536,64),bvconst(1,8),bvconst(1,8)),heap108_owner(bvconst(1,64),bvconst(4,64),bvconst(101,64),bvconst(7,64),bvconst(1,64),bvconst(4,64),bvconst(101,64),bvconst(7,64),bvconst(1,8)),bvconst(7,64),bvconst(0,64),bvconst(1,64),bvconst(0,8),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)),bvconst(0,8),bvconst(1,8))=bvconst(1,8)))
}

example "close retains charged backing" {
    assert(heap108_after(heap108_retire(bvconst(2,8),bvconst(1,64),bvconst(0,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)),bvconst(4352,64),bvconst(0,64))=bvconst(4352,64))
}

example "timeout cannot refund busy backing" {
    assert(¬(heap108_after(heap108_retire(bvconst(2,8),bvconst(1,64),bvconst(0,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)),bvconst(4352,64),bvconst(0,64))=bvconst(0,64)))
}

example "first competing client reserves" {
    assert(heap108_budget(bvconst(4352,64),bvconst(0,64),bvconst(8192,64),bvconst(0,64),bvconst(8192,64),bvconst(5,64),bvconst(5,64),bvconst(1,8)))
}

example "second competing client cannot overcommit global bytes" {
    assert(¬(heap108_budget(bvconst(4352,64),bvconst(0,64),bvconst(8192,64),heap108_after(heap108_budget(bvconst(4352,64),bvconst(0,64),bvconst(8192,64),bvconst(0,64),bvconst(8192,64),bvconst(5,64),bvconst(5,64),bvconst(1,8)),bvconst(0,64),bvconst(4352,64)),bvconst(8192,64),heap108_after(heap108_budget(bvconst(4352,64),bvconst(0,64),bvconst(8192,64),bvconst(0,64),bvconst(8192,64),bvconst(5,64),bvconst(5,64),bvconst(1,8)),bvconst(5,64),bvconst(6,64)),bvconst(6,64),bvconst(1,8))))
}

example "second client cannot commit old ledger snapshot" {
    assert(¬(heap108_budget(bvconst(4352,64),bvconst(0,64),bvconst(13056,64),heap108_after(heap108_budget(bvconst(4352,64),bvconst(0,64),bvconst(8192,64),bvconst(0,64),bvconst(8192,64),bvconst(5,64),bvconst(5,64),bvconst(1,8)),bvconst(0,64),bvconst(4352,64)),bvconst(17408,64),heap108_after(heap108_budget(bvconst(4352,64),bvconst(0,64),bvconst(8192,64),bvconst(0,64),bvconst(8192,64),bvconst(5,64),bvconst(5,64),bvconst(1,8)),bvconst(5,64),bvconst(6,64)),bvconst(5,64),bvconst(1,8))))
}

example "second client can use sufficient remaining global budget" {
    assert(heap108_budget(bvconst(4352,64),bvconst(0,64),bvconst(13056,64),heap108_after(heap108_budget(bvconst(4352,64),bvconst(0,64),bvconst(8192,64),bvconst(0,64),bvconst(8192,64),bvconst(5,64),bvconst(5,64),bvconst(1,8)),bvconst(0,64),bvconst(4352,64)),bvconst(9000,64),heap108_after(heap108_budget(bvconst(4352,64),bvconst(0,64),bvconst(8192,64),bvconst(0,64),bvconst(8192,64),bvconst(5,64),bvconst(5,64),bvconst(1,8)),bvconst(5,64),bvconst(6,64)),bvconst(6,64),bvconst(1,8)))
}

example "A refund leaves B account unchanged" {
    assert(heap108_account((bvconst(1,8)=bvconst(1,8)),bvconst(1,64),bvconst(2,64),bvconst(4352,64),bvconst(0,64))=bvconst(4352,64))
}

example "A death cannot select B record" {
    assert(¬(heap108_cleanup(bvconst(2,64),bvconst(4,64),bvconst(7,64),bvconst(1,64),bvconst(4,64),bvconst(7,64),bvconst(1,8),bvconst(2,8),bvconst(1,8),bvconst(1,8))))
}

example "initialization byte at 8191" {
    assert(heap108_initial_byte((bvconst(1,8)=bvconst(1,8)),bvconst(8191,64),bvconst(8192,64),bvconst(4096,64),bvconst(255,8))=bvconst(255,8))
}

example "initialization byte at 8192" {
    assert(heap108_initial_byte((bvconst(1,8)=bvconst(1,8)),bvconst(8192,64),bvconst(8192,64),bvconst(4096,64),bvconst(255,8))=bvconst(0,8))
}

example "initialization byte at 8208" {
    assert(heap108_initial_byte((bvconst(1,8)=bvconst(1,8)),bvconst(8208,64),bvconst(8192,64),bvconst(4096,64),bvconst(255,8))=bvconst(0,8))
}

example "initialization byte at 12287" {
    assert(heap108_initial_byte((bvconst(1,8)=bvconst(1,8)),bvconst(12287,64),bvconst(8192,64),bvconst(4096,64),bvconst(255,8))=bvconst(0,8))
}

example "initialization byte at 12288" {
    assert(heap108_initial_byte((bvconst(1,8)=bvconst(1,8)),bvconst(12288,64),bvconst(8192,64),bvconst(4096,64),bvconst(255,8))=bvconst(255,8))
}

example "failed allocation preserves byte" {
    assert(heap108_initial_byte((bvconst(0,8)=bvconst(1,8)),bvconst(8192,64),bvconst(8192,64),bvconst(4096,64),bvconst(255,8))=bvconst(255,8))
}

example "new owner cannot observe former payload" {
    assert(¬(heap108_initial_byte((bvconst(1,8)=bvconst(1,8)),bvconst(8192,64),bvconst(8192,64),bvconst(4096,64),bvconst(255,8))=bvconst(255,8)))
}

example "new allocation clears old physical pointer kind" {
    assert(heap108_initial_tag((bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8)),bvconst(1,8))=bvconst(0,8))
}

example "nonoverlapping pointer kind survives" {
    assert(heap108_initial_tag((bvconst(1,8)=bvconst(1,8)),(bvconst(0,8)=bvconst(1,8)),bvconst(1,8))=bvconst(1,8))
}

example "budget conservation for every admitted request" {
    assert(∀(c : BitVec64). ∀(u : BitVec64). ∀(l : BitVec64). ∀(g : BitVec64). ∀(m : BitVec64). heap108_budget(c,u,l,g,m,bvconst(5,64),bvconst(5,64),bvconst(1,8)) → (bvule(bvadd(u,c),l) ∧ bvule(bvadd(g,c),m) ∧ bvuge(bvadd(u,c),u) ∧ bvuge(bvadd(g,c),g)))
}

example "all rejected state fields are unchanged" {
    assert(∀(old : BitVec64). ∀(staged : BitVec64). heap108_after((bvconst(0,8)=bvconst(1,8)),old,staged)=old)
}

example "all unselected client accounts are unchanged" {
    assert(∀(a : BitVec64). ∀(b : BitVec64). ∀(old : BitVec64). ∀(next : BitVec64). (¬(a=b)) → (heap108_account((bvconst(1,8)=bvconst(1,8)),a,b,old,next)=old))
}

example "all successful typed accesses fit logical bytes" {
    assert(∀(p : BitVec64). ∀(n : BitVec64). ∀(w : BitVec64). heap108_access((bvconst(1,8)=bvconst(1,8)),p,n,w,bvconst(3,64),bvconst(1,64),bvconst(1,8),bvconst(1,8)) → (bvule(bvadd(p,w),n) ∧ bvugt(bvadd(p,w),p)))
}

example "every heap free starts at exact allocation origin" {
    assert(∀(p : BitVec64). ∀(lo : BitVec64). ∀(hi : BitVec64). ∀(n : BitVec64). heap108_free((bvconst(1,8)=bvconst(1,8)),p,lo,hi,n,bvconst(3,64)) → ((p=bvconst(0,64)) ∧ (lo=bvconst(0,64)) ∧ (hi=n)))
}

example "arbitrary same-address reissue cannot revive older handle" {
    assert(∀(s : BitVec64). ∀(e : BitVec64). (repr107_components(s,e) ∧ bvult(e,repr107_mask())) → ¬(heap108_current(repr107_handle(s,e),bvconst(1,8),s,bvadd(e,bvconst(1,64)),bvconst(1,8),bvconst(2,8),(bvconst(1,8)=bvconst(1,8)))))
}

example "closing excludes new accesses at every position" {
    assert(∀(h : BitVec64). ∀(s : BitVec64). ∀(e : BitVec64). ¬(heap108_current(h,bvconst(1,8),s,e,bvconst(2,8),bvconst(2,8),(bvconst(1,8)=bvconst(1,8)))))
}
