example "hostile work 0 1 18446744073709551615" { assert(ls108_spend(bvconst(0,64),bvconst(1,64),bvsub(bvconst(0,64),bvconst(1,64)))) }
example "hostile work 1 0 1" { assert(ls108_spend(bvconst(1,64),bvconst(0,64),bvconst(1,64))) }
example "hostile work 300 257 43" { assert(ls108_spend(bvconst(300,64),bvconst(257,64),bvconst(43,64))) }
example "hostile work 256 256 256" { assert(ls108_spend(bvconst(256,64),bvconst(256,64),bvconst(256,64))) }
example "hostile work 1 2 18446744073709551615" { assert(ls108_spend(bvconst(1,64),bvconst(2,64),bvsub(bvconst(0,64),bvconst(1,64)))) }
