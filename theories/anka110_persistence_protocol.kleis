example "reject error leaks outcome word 8" { assert(¬(n110_reply_frame(N110Frame(bvadd(bvshl(bvconst(3232080,64),bvconst(32,64)),bvconst(1095454273,64)),bvconst(1,64),bvconst(0,64),bvconst(42,64),bvconst(112,64),(bvconst(1,8)=bvconst(1,8)),bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),N110Reply(bvadd(bvshl(bvconst(3232336,64),bvconst(32,64)),bvconst(1095454273,64)),bvconst(1,64),bvconst(0,64),bvconst(42,64),bvconst(144,64),bvconst(1,64),bvconst(0,64),bvconst(0,64),bvconst(1,64),(bvconst(1,8)=bvconst(1,8)),bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64))))) }
example "reject older request reexecutes after peer commit" { assert(¬(n110_success(N110Frame(bvadd(bvshl(bvconst(3232080,64),bvconst(32,64)),bvconst(1095454273,64)),bvconst(1,64),bvconst(0,64),bvconst(42,64),bvconst(112,64),(bvconst(1,8)=bvconst(1,8)),bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),A109Context(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(71,64),bvconst(100,64),(bvconst(1,8)=bvconst(1,8))),P109Access(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(90,64),bvconst(110,64),A109Valid,A109Valid),N110Budget(bvconst(0,64),bvconst(4,64),bvconst(0,64),bvconst(1536,64),bvconst(512,64),bvconst(100,64),bvconst(200,64)),(bvconst(1,8)=bvconst(1,8)),P109State(bvconst(9,64),bvconst(101,64),bvconst(8,64),bvconst(2,64),bvconst(31,64),bvconst(5,64),bvconst(1,64),bvconst(8,64),bvconst(101,64),bvconst(0,64),bvconst(10,64),bvconst(20,64),bvconst(3,64)),(bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8)),P109State(bvconst(8,64),bvconst(99,64),bvconst(8,64),bvconst(1,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(99,64),bvconst(0,64),bvconst(10,64),bvconst(20,64),bvconst(3,64)),N110Reply(bvadd(bvshl(bvconst(3232336,64),bvconst(32,64)),bvconst(1095454273,64)),bvconst(1,64),bvconst(0,64),bvconst(42,64),bvconst(144,64),bvconst(0,64),bvconst(8,64),bvconst(99,64),bvconst(8,64),(bvconst(1,8)=bvconst(1,8)),bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),(bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8))))) }
example "older request leaves peer commit intact" { assert(n110_effect(N110Frame(bvadd(bvshl(bvconst(3232080,64),bvconst(32,64)),bvconst(1095454273,64)),bvconst(1,64),bvconst(0,64),bvconst(42,64),bvconst(112,64),(bvconst(1,8)=bvconst(1,8)),bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),A109Context(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(71,64),bvconst(100,64),(bvconst(1,8)=bvconst(1,8))),P109Access(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(90,64),bvconst(110,64),A109Valid,A109Valid),N110Budget(bvconst(0,64),bvconst(4,64),bvconst(0,64),bvconst(1536,64),bvconst(512,64),bvconst(100,64),bvconst(200,64)),(bvconst(1,8)=bvconst(1,8)),P109State(bvconst(9,64),bvconst(101,64),bvconst(8,64),bvconst(2,64),bvconst(31,64),bvconst(5,64),bvconst(1,64),bvconst(8,64),bvconst(101,64),bvconst(0,64),bvconst(10,64),bvconst(20,64),bvconst(3,64)),(bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8)),P109State(bvconst(9,64),bvconst(101,64),bvconst(8,64),bvconst(2,64),bvconst(31,64),bvconst(5,64),bvconst(1,64),bvconst(8,64),bvconst(101,64),bvconst(0,64),bvconst(10,64),bvconst(20,64),bvconst(3,64)))) }
example "law charged slots and bytes stay within limits" { assert(∀ slots : BitVec64 . ∀ slot_limit : BitVec64 . ∀ bytes : BitVec64 . ∀ byte_limit : BitVec64 . ∀ work : BitVec64 . ∀ now : BitVec64 . ∀ deadline : BitVec64 . ∀ ns : BitVec64 . ∀ nb : BitVec64 . n110_charge(N110Budget(slots,slot_limit,bytes,byte_limit,work,now,deadline),ns,nb) ⟹ (bvule(ns,slot_limit) ∧ bvule(nb,byte_limit) ∧ bvult(bytes,nb))) }
example "law each admitted poll strictly reduces finite work" { assert(∀ w : BitVec64 . ∀ now : BitVec64 . ∀ deadline : BitVec64 . ∀ next : BitVec64 . n110_tick(w,now,deadline,next) ⟹ bvult(next,w)) }
example "law unowned release cannot change accounting" { assert(∀ slots : BitVec64 . ∀ bytes : BitVec64 . ∀ ns : BitVec64 . ∀ nb : BitVec64 . n110_release(slots,bytes,(bvconst(1,8)=bvconst(0,8)),ns,nb) ⟹ ((ns=slots) ∧ (nb=bytes))) }
example "law incomplete response never establishes outcome" { assert(∀ bound : Bool . ∀ status : BitVec64 . n110_client_result((bvconst(1,8)=bvconst(0,8)),bound,status)=bvconst(0,8)) }
example "law unbound response never establishes outcome" { assert(∀ complete : Bool . ∀ status : BitVec64 . n110_client_result(complete,(bvconst(1,8)=bvconst(0,8)),status)=bvconst(0,8)) }
example "law uncertain status never establishes outcome" { assert(∀ complete : Bool . ∀ bound : Bool . n110_client_result(complete,bound,bvconst(5,64))=bvconst(0,8)) }
example "law request identity includes all ten words" { assert(∀ r_anchor : BitVec64 . ∀ t_anchor : BitVec64 . ∀ r_installation : BitVec64 . ∀ t_installation : BitVec64 . ∀ r_policy : BitVec64 . ∀ t_policy : BitVec64 . ∀ r_caller : BitVec64 . ∀ t_caller : BitVec64 . ∀ r_incarnation : BitVec64 . ∀ t_incarnation : BitVec64 . ∀ r_sequence : BitVec64 . ∀ t_sequence : BitVec64 . ∀ r_expected : BitVec64 . ∀ t_expected : BitVec64 . ∀ r_kind : BitVec64 . ∀ t_kind : BitVec64 . ∀ r_argument : BitVec64 . ∀ t_argument : BitVec64 . ∀ r_attempt : BitVec64 . ∀ t_attempt : BitVec64 . n110_same_request(P109Request(r_anchor,r_installation,r_policy,r_caller,r_incarnation,r_sequence,r_expected,r_kind,r_argument,r_attempt),P109Request(t_anchor,t_installation,t_policy,t_caller,t_incarnation,t_sequence,t_expected,t_kind,t_argument,t_attempt)) ⟹ ((r_anchor=t_anchor) ∧ (r_installation=t_installation) ∧ (r_policy=t_policy) ∧ (r_caller=t_caller) ∧ (r_incarnation=t_incarnation) ∧ (r_sequence=t_sequence) ∧ (r_expected=t_expected) ∧ (r_kind=t_kind) ∧ (r_argument=t_argument) ∧ (r_attempt=t_attempt))) }

// Loopback lifecycle refinement. Connection IDs are server-local, never wire
// authority. The transport owns each slot and removes it exactly once.
define n110_fresh_connection(old : BitVec64, next : BitVec64) =
    bvult(old,a109_max()) ∧ (next=bvadd(old,bvconst(1,64)))
define n110_owned_connection(active : BitVec64, requested : BitVec64, owned : Bool) =
    owned ∧ ¬(active=bvconst(0,64)) ∧ (active=requested)
define n110_eof_dispatch(length : BitVec64, eof : Bool, dispatched : Bool) =
    (length=bvconst(112,64)) ∧ eof ∧ ¬dispatched
define n110_write_advance(sent : BitVec64, count : BitVec64, next : BitVec64, current_authority : Bool) =
    current_authority ∧ bvult(sent,bvconst(144,64)) ∧ bvult(bvconst(0,64),count) ∧
    bvule(count,bvsub(bvconst(144,64),sent)) ∧ (next=bvadd(sent,count))
example "transport connection increments" { assert(n110_fresh_connection(bvconst(7,64),bvconst(8,64))) }
example "transport owned close matches" { assert(n110_owned_connection(bvconst(8,64),bvconst(8,64),(bvconst(1,8)=bvconst(1,8)))) }
example "transport exact EOF dispatch once" { assert(n110_eof_dispatch(bvconst(112,64),(bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(0,8)))) }
example "transport short write advances prefix" { assert(n110_write_advance(bvconst(0,64),bvconst(7,64),bvconst(7,64),(bvconst(1,8)=bvconst(1,8)))) }
example "transport last write completes prefix" { assert(n110_write_advance(bvconst(140,64),bvconst(4,64),bvconst(144,64),(bvconst(1,8)=bvconst(1,8)))) }
example "transport law write progress stays bounded" { assert(∀ sent : BitVec64 . ∀ count : BitVec64 . ∀ next : BitVec64 . n110_write_advance(sent,count,next,(bvconst(1,8)=bvconst(1,8))) ⟹ (bvult(sent,next) ∧ bvule(next,bvconst(144,64)))) }
example "transport law fresh identity strictly increases" { assert(∀ old : BitVec64 . ∀ next : BitVec64 . n110_fresh_connection(old,next) ⟹ bvult(old,next)) }

// Client lifecycle refinement. A connection identity belongs to the client,
// not to the wire. An unknown result permits only the same durable request.
define n110_client_io(active : BitVec64, current : BitVec64, trusted : Bool, work : BitVec64, now : BitVec64, deadline : BitVec64) =
    ¬(active=bvconst(0,64)) ∧ (active=current) ∧ trusted ∧
    bvult(bvconst(0,64),work) ∧ bvule(work,bvconst(512,64)) ∧ bvult(now,deadline)
define n110_client_half_close(phase : BitVec64, sent : BitVec64) =
    (phase=bvconst(1,64)) ∧ (sent=bvconst(112,64))
define n110_client_finish(phase : BitVec64, received : BitVec64, eof : Bool) =
    (phase=bvconst(2,64)) ∧ (received=bvconst(144,64)) ∧ eof
define n110_client_retry(unknown : Bool, old_correlation : BitVec64, new_correlation : BitVec64, old : P109Request, next : P109Request) =
    unknown ∧ ¬(new_correlation=bvconst(0,64)) ∧ ¬(old_correlation=new_correlation) ∧ n110_same_request(old,next)
example "client current verified connection may write" { assert(n110_client_io(bvconst(1,64),bvconst(1,64),(bvconst(1,8)=bvconst(1,8)),bvconst(512,64),bvconst(100,64),bvconst(200,64))) }
example "client last work unit may progress" { assert(n110_client_io(bvconst(2,64),bvconst(2,64),(bvconst(1,8)=bvconst(1,8)),bvconst(1,64),bvconst(199,64),bvconst(200,64))) }
example "client half close after exact request" { assert(n110_client_half_close(bvconst(1,64),bvconst(112,64))) }
example "client reply finish requires EOF" { assert(n110_client_finish(bvconst(2,64),bvconst(144,64),(bvconst(1,8)=bvconst(1,8)))) }
example "client unknown retry preserves request" { assert(n110_client_retry((bvconst(1,8)=bvconst(1,8)),bvconst(42,64),bvconst(43,64),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)))) }
example "client reject changed durable retry" { assert(¬n110_client_retry((bvconst(1,8)=bvconst(1,8)),bvconst(42,64),bvconst(43,64),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(100,64),bvconst(0,64)))) }
example "client reject cancelled connection poll" { assert(¬n110_client_io(bvconst(1,64),bvconst(2,64),(bvconst(1,8)=bvconst(1,8)),bvconst(512,64),bvconst(100,64),bvconst(200,64))) }
example "client reject absent server evidence" { assert(¬n110_client_io(bvconst(1,64),bvconst(1,64),(bvconst(1,8)=bvconst(0,8)),bvconst(512,64),bvconst(100,64),bvconst(200,64))) }
example "client law accepted client IO has live deadline" { assert(∀ active : BitVec64 . ∀ current : BitVec64 . ∀ work : BitVec64 . ∀ now : BitVec64 . ∀ deadline : BitVec64 . n110_client_io(active,current,(bvconst(1,8)=bvconst(1,8)),work,now,deadline) ⟹ ((active=current) ∧ bvult(now,deadline))) }
example "client law finish cannot accept tail" { assert(∀ phase : BitVec64 . ∀ received : BitVec64 . n110_client_finish(phase,received,(bvconst(1,8)=bvconst(1,8))) ⟹ (received=bvconst(144,64))) }
