// Phase 10.10 bounded persistence protocol, version 1. No new axioms.
// Word-level framing/dispatch contract; concrete byte parser refinement is NEXT.
// P109Access, A109Context, peer binding, time and settled backend are trusted
// server observations, NEVER deserialized claims. Loopback alone grants nothing.
// One request per connection, request EOF before dispatch, exact 112-byte input;
// reply is exactly 144 bytes. No provisioning, raw load, blobs or boot admission.
// Status: 0 success, 1 denied, 2 conflict/old retry, 3 exhausted,
// 4 unavailable, 5 uncertain, 6 invalid. Failure payload words must be zero.
// Missing replies are UNKNOWN outcomes: timeout/disconnect does not undo commit.
// A last-outcome retry window is bounded; a later writer can expire that window.
import "anka109_persistence.kleis"
data N110Frame = N110Frame(magic : BitVec64, version : BitVec64, flags : BitVec64, correlation : BitVec64, length : BitVec64, ended : Bool, anchor : BitVec64, installation : BitVec64, policy : BitVec64, caller : BitVec64, incarnation : BitVec64, sequence : BitVec64, expected : BitVec64, kind : BitVec64, argument : BitVec64, attempt : BitVec64)
define nf_magic(v : N110Frame) = match v { N110Frame(magic,version,flags,correlation,length,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => magic }
define nf_version(v : N110Frame) = match v { N110Frame(magic,version,flags,correlation,length,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => version }
define nf_flags(v : N110Frame) = match v { N110Frame(magic,version,flags,correlation,length,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => flags }
define nf_correlation(v : N110Frame) = match v { N110Frame(magic,version,flags,correlation,length,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => correlation }
define nf_length(v : N110Frame) = match v { N110Frame(magic,version,flags,correlation,length,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => length }
define nf_ended(v : N110Frame) = match v { N110Frame(magic,version,flags,correlation,length,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => ended }
define nf_anchor(v : N110Frame) = match v { N110Frame(magic,version,flags,correlation,length,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => anchor }
define nf_installation(v : N110Frame) = match v { N110Frame(magic,version,flags,correlation,length,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => installation }
define nf_policy(v : N110Frame) = match v { N110Frame(magic,version,flags,correlation,length,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => policy }
define nf_caller(v : N110Frame) = match v { N110Frame(magic,version,flags,correlation,length,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => caller }
define nf_incarnation(v : N110Frame) = match v { N110Frame(magic,version,flags,correlation,length,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => incarnation }
define nf_sequence(v : N110Frame) = match v { N110Frame(magic,version,flags,correlation,length,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => sequence }
define nf_expected(v : N110Frame) = match v { N110Frame(magic,version,flags,correlation,length,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => expected }
define nf_kind(v : N110Frame) = match v { N110Frame(magic,version,flags,correlation,length,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => kind }
define nf_argument(v : N110Frame) = match v { N110Frame(magic,version,flags,correlation,length,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => argument }
define nf_attempt(v : N110Frame) = match v { N110Frame(magic,version,flags,correlation,length,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => attempt }
define nf_body(v : N110Frame) = P109Request(nf_anchor(v),nf_installation(v),nf_policy(v),nf_caller(v),nf_incarnation(v),nf_sequence(v),nf_expected(v),nf_kind(v),nf_argument(v),nf_attempt(v))
data N110Budget = N110Budget(slots : BitVec64, slot_limit : BitVec64, bytes : BitVec64, byte_limit : BitVec64, work : BitVec64, now : BitVec64, deadline : BitVec64)
define nb_slots(v : N110Budget) = match v { N110Budget(slots,slot_limit,bytes,byte_limit,work,now,deadline) => slots }
define nb_slot_limit(v : N110Budget) = match v { N110Budget(slots,slot_limit,bytes,byte_limit,work,now,deadline) => slot_limit }
define nb_bytes(v : N110Budget) = match v { N110Budget(slots,slot_limit,bytes,byte_limit,work,now,deadline) => bytes }
define nb_byte_limit(v : N110Budget) = match v { N110Budget(slots,slot_limit,bytes,byte_limit,work,now,deadline) => byte_limit }
define nb_work(v : N110Budget) = match v { N110Budget(slots,slot_limit,bytes,byte_limit,work,now,deadline) => work }
define nb_now(v : N110Budget) = match v { N110Budget(slots,slot_limit,bytes,byte_limit,work,now,deadline) => now }
define nb_deadline(v : N110Budget) = match v { N110Budget(slots,slot_limit,bytes,byte_limit,work,now,deadline) => deadline }
data N110Reply = N110Reply(magic : BitVec64, version : BitVec64, flags : BitVec64, correlation : BitVec64, length : BitVec64, status : BitVec64, revision : BitVec64, value : BitVec64, boot : BitVec64, ended : Bool, anchor : BitVec64, installation : BitVec64, policy : BitVec64, caller : BitVec64, incarnation : BitVec64, sequence : BitVec64, expected : BitVec64, kind : BitVec64, argument : BitVec64, attempt : BitVec64)
define nr_magic(v : N110Reply) = match v { N110Reply(magic,version,flags,correlation,length,status,revision,value,boot,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => magic }
define nr_version(v : N110Reply) = match v { N110Reply(magic,version,flags,correlation,length,status,revision,value,boot,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => version }
define nr_flags(v : N110Reply) = match v { N110Reply(magic,version,flags,correlation,length,status,revision,value,boot,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => flags }
define nr_correlation(v : N110Reply) = match v { N110Reply(magic,version,flags,correlation,length,status,revision,value,boot,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => correlation }
define nr_length(v : N110Reply) = match v { N110Reply(magic,version,flags,correlation,length,status,revision,value,boot,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => length }
define nr_status(v : N110Reply) = match v { N110Reply(magic,version,flags,correlation,length,status,revision,value,boot,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => status }
define nr_revision(v : N110Reply) = match v { N110Reply(magic,version,flags,correlation,length,status,revision,value,boot,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => revision }
define nr_value(v : N110Reply) = match v { N110Reply(magic,version,flags,correlation,length,status,revision,value,boot,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => value }
define nr_boot(v : N110Reply) = match v { N110Reply(magic,version,flags,correlation,length,status,revision,value,boot,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => boot }
define nr_ended(v : N110Reply) = match v { N110Reply(magic,version,flags,correlation,length,status,revision,value,boot,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => ended }
define nr_anchor(v : N110Reply) = match v { N110Reply(magic,version,flags,correlation,length,status,revision,value,boot,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => anchor }
define nr_installation(v : N110Reply) = match v { N110Reply(magic,version,flags,correlation,length,status,revision,value,boot,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => installation }
define nr_policy(v : N110Reply) = match v { N110Reply(magic,version,flags,correlation,length,status,revision,value,boot,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => policy }
define nr_caller(v : N110Reply) = match v { N110Reply(magic,version,flags,correlation,length,status,revision,value,boot,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => caller }
define nr_incarnation(v : N110Reply) = match v { N110Reply(magic,version,flags,correlation,length,status,revision,value,boot,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => incarnation }
define nr_sequence(v : N110Reply) = match v { N110Reply(magic,version,flags,correlation,length,status,revision,value,boot,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => sequence }
define nr_expected(v : N110Reply) = match v { N110Reply(magic,version,flags,correlation,length,status,revision,value,boot,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => expected }
define nr_kind(v : N110Reply) = match v { N110Reply(magic,version,flags,correlation,length,status,revision,value,boot,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => kind }
define nr_argument(v : N110Reply) = match v { N110Reply(magic,version,flags,correlation,length,status,revision,value,boot,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => argument }
define nr_attempt(v : N110Reply) = match v { N110Reply(magic,version,flags,correlation,length,status,revision,value,boot,ended,anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => attempt }
define nr_body(v : N110Reply) = P109Request(nr_anchor(v),nr_installation(v),nr_policy(v),nr_caller(v),nr_incarnation(v),nr_sequence(v),nr_expected(v),nr_kind(v),nr_argument(v),nr_attempt(v))
define n110_request_magic() = bvadd(bvshl(bvconst(3232080,64),bvconst(32,64)),bvconst(1095454273,64))
define n110_reply_magic() = bvadd(bvshl(bvconst(3232336,64),bvconst(32,64)),bvconst(1095454273,64))
define n110_same_request(r : P109Request,t : P109Request) =
    (pr_anchor(r)=pr_anchor(t)) ∧ (pr_installation(r)=pr_installation(t)) ∧ (pr_policy(r)=pr_policy(t)) ∧ (pr_caller(r)=pr_caller(t)) ∧ (pr_incarnation(r)=pr_incarnation(t)) ∧ (pr_sequence(r)=pr_sequence(t)) ∧ (pr_expected(r)=pr_expected(t)) ∧ (pr_kind(r)=pr_kind(t)) ∧ (pr_argument(r)=pr_argument(t)) ∧ (pr_attempt(r)=pr_attempt(t))
define n110_shape(r : P109Request) =
    a109_nonzero(pr_anchor(r)) ∧ a109_nonzero(pr_installation(r)) ∧
    a109_nonzero(pr_caller(r)) ∧ a109_nonzero(pr_incarnation(r)) ∧
    a109_nonzero(pr_sequence(r)) ∧ a109_nonzero(pr_argument(r)) ∧
    (((pr_kind(r)=bvconst(1,64)) ∧ (pr_attempt(r)=a109_z())) ∨
     ((pr_kind(r)=bvconst(2,64)) ∧ a109_nonzero(pr_attempt(r))))
define n110_frame(f : N110Frame) =
    (nf_magic(f)=n110_request_magic()) ∧ (nf_version(f)=bvconst(1,64)) ∧
    (nf_flags(f)=a109_z()) ∧ a109_nonzero(nf_correlation(f)) ∧
    (nf_length(f)=bvconst(112,64)) ∧ nf_ended(f) ∧ n110_shape(P109Request(nf_anchor(f),nf_installation(f),nf_policy(f),nf_caller(f),nf_incarnation(f),nf_sequence(f),nf_expected(f),nf_kind(f),nf_argument(f),nf_attempt(f)))
// Guard subtraction before comparing available bytes; never accept wrapping sums.
// 384 is a logical reservation covering 113 input + 144 reply bytes and metadata.
define n110_budget(b : N110Budget) =
    a109_nonzero(nb_slot_limit(b)) ∧ bvule(nb_slot_limit(b),bvconst(64,64)) ∧
    bvult(nb_slots(b),nb_slot_limit(b)) ∧ bvule(nb_bytes(b),nb_byte_limit(b)) ∧
    bvule(bvconst(384,64),bvsub(nb_byte_limit(b),nb_bytes(b))) ∧
    a109_nonzero(nb_work(b)) ∧ bvule(nb_work(b),bvconst(512,64)) ∧
    bvult(nb_now(b),nb_deadline(b))
define n110_charge(b : N110Budget,slots : BitVec64,bytes : BitVec64) =
    n110_budget(b) ∧ (slots=a109_next(nb_slots(b))) ∧
    (bytes=bvadd(nb_bytes(b),bvconst(384,64)))
// Release only an actual owned reservation; repeated/foreign release is inert.
define n110_release(slots : BitVec64,bytes : BitVec64,owned : Bool,next_slots : BitVec64,next_bytes : BitVec64) =
    (next_slots=(if owned ∧ a109_nonzero(slots) ∧ bvule(bvconst(384,64),bytes) then bvsub(slots,bvconst(1,64)) else slots)) ∧
    (next_bytes=(if owned ∧ a109_nonzero(slots) ∧ bvule(bvconst(384,64),bytes) then bvsub(bytes,bvconst(384,64)) else bytes))
define n110_tick(work : BitVec64,now : BitVec64,deadline : BitVec64,next : BitVec64) =
    a109_nonzero(work) ∧ bvule(work,bvconst(512,64)) ∧ bvult(now,deadline) ∧
    (next=bvsub(work,bvconst(1,64)))
// The dispatcher acquires a reservation before reading; admission rechecks the
// current trusted authority after framing, immediately before backend access.
// Budget here describes the reservation's pre-acquire accounting snapshot.
define n110_dispatch(f : N110Frame,c : A109Context,a : P109Access,b : N110Budget,peer : Bool) =
    n110_frame(f) ∧ n110_budget(b) ∧ peer ∧ p109_authorized(c,P109Request(nf_anchor(f),nf_installation(f),nf_policy(f),nf_caller(f),nf_incarnation(f),nf_sequence(f),nf_expected(f),nf_kind(f),nf_argument(f),nf_attempt(f)),a)
define n110_effect(f : N110Frame,c : A109Context,a : P109Access,b : N110Budget,peer : Bool,
                   s : P109State,capacity : Bool,durable : Bool,t : P109State) =
    if n110_dispatch(f,c,a,b,peer) then p109_step(c,s,P109Request(nf_anchor(f),nf_installation(f),nf_policy(f),nf_caller(f),nf_incarnation(f),nf_sequence(f),nf_expected(f),nf_kind(f),nf_argument(f),nf_attempt(f)),a,capacity,durable,t) else p109_same(s,t)
define n110_reply_frame(f : N110Frame,r : N110Reply) =
    (nr_magic(r)=n110_reply_magic()) ∧ (nr_version(r)=bvconst(1,64)) ∧ (nr_flags(r)=a109_z()) ∧
    (nr_length(r)=bvconst(144,64)) ∧ nr_ended(r) ∧ (nr_correlation(r)=nf_correlation(f)) ∧
    n110_same_request(P109Request(nr_anchor(r),nr_installation(r),nr_policy(r),nr_caller(r),nr_incarnation(r),nr_sequence(r),nr_expected(r),nr_kind(r),nr_argument(r),nr_attempt(r)),P109Request(nf_anchor(f),nf_installation(f),nf_policy(f),nf_caller(f),nf_incarnation(f),nf_sequence(f),nf_expected(f),nf_kind(f),nf_argument(f),nf_attempt(f))) ∧ bvule(nr_status(r),bvconst(6,64)) ∧
    ((nr_status(r)=a109_z()) ∨ ((nr_revision(r)=a109_z()) ∧ (nr_value(r)=a109_z()) ∧ (nr_boot(r)=a109_z())))
// Result comes from one complete settled record, never a speculative output.
// Current authorization is rechecked for replies, including exact retries.
define n110_success(f : N110Frame,c : A109Context,a : P109Access,b : N110Budget,peer : Bool,
                    s : P109State,capacity : Bool,durable : Bool,t : P109State,
                    r : N110Reply,settled : Bool,delivered : Bool) =
    n110_dispatch(f,c,a,b,peer) ∧ n110_reply_frame(f,r) ∧ (nr_status(r)=a109_z()) ∧
    settled ∧ delivered ∧ p109_ack(c,s,P109Request(nf_anchor(f),nf_installation(f),nf_policy(f),nf_caller(f),nf_incarnation(f),nf_sequence(f),nf_expected(f),nf_kind(f),nf_argument(f),nf_attempt(f)),a,capacity,durable,delivered) ∧
    p109_step(c,s,P109Request(nf_anchor(f),nf_installation(f),nf_policy(f),nf_caller(f),nf_incarnation(f),nf_sequence(f),nf_expected(f),nf_kind(f),nf_argument(f),nf_attempt(f)),a,capacity,durable,t) ∧ p109_exact(t,P109Request(nf_anchor(f),nf_installation(f),nf_policy(f),nf_caller(f),nf_incarnation(f),nf_sequence(f),nf_expected(f),nf_kind(f),nf_argument(f),nf_attempt(f))) ∧
    (nr_revision(r)=ps_revision(t)) ∧ (nr_value(r)=ps_value(t)) ∧ (nr_boot(r)=ps_boot(t))
// An unbound/unauthenticated transport reply must never become client evidence.
// Transport epoch and matching pending request are local trusted observations.
define n110_client_accept(f : N110Frame,r : N110Reply,server_bound : Bool,pending_current : Bool) =
    n110_frame(f) ∧ n110_reply_frame(f,r) ∧ server_bound ∧ pending_current ∧ (nr_status(r)=a109_z()) ∧
    bvult(pr_expected(P109Request(nf_anchor(f),nf_installation(f),nf_policy(f),nf_caller(f),nf_incarnation(f),nf_sequence(f),nf_expected(f),nf_kind(f),nf_argument(f),nf_attempt(f))),a109_max()) ∧ (nr_revision(r)=a109_next(pr_expected(P109Request(nf_anchor(f),nf_installation(f),nf_policy(f),nf_caller(f),nf_incarnation(f),nf_sequence(f),nf_expected(f),nf_kind(f),nf_argument(f),nf_attempt(f))))) ∧
    (nr_value(r)=pr_argument(P109Request(nf_anchor(f),nf_installation(f),nf_policy(f),nf_caller(f),nf_incarnation(f),nf_sequence(f),nf_expected(f),nf_kind(f),nf_argument(f),nf_attempt(f)))) ∧
    ((pr_kind(P109Request(nf_anchor(f),nf_installation(f),nf_policy(f),nf_caller(f),nf_incarnation(f),nf_sequence(f),nf_expected(f),nf_kind(f),nf_argument(f),nf_attempt(f)))=bvconst(1,64)) ∨ a109_nonzero(nr_boot(r)))
// 0 uncertain, 1 definite success, 2 explicit non-success. A negative reply
// describes THIS dispatch, not proof an earlier timed-out identical request lost.
define n110_client_result(complete : Bool,bound : Bool,status : BitVec64) =
    if ¬complete ∨ ¬bound ∨ ¬bvule(status,bvconst(6,64)) ∨ (status=bvconst(5,64)) then bvconst(0,8)
    else if status=a109_z() then bvconst(1,8) else bvconst(2,8)
define n110_r() = P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64))
define n110_f() = N110Frame(bvadd(bvshl(bvconst(3232080,64),bvconst(32,64)),bvconst(1095454273,64)),bvconst(1,64),bvconst(0,64),bvconst(42,64),bvconst(112,64),(bvconst(1,8)=bvconst(1,8)),bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64))
define n110_b() = N110Budget(bvconst(0,64),bvconst(4,64),bvconst(0,64),bvconst(1536,64),bvconst(512,64),bvconst(100,64),bvconst(200,64))
define n110_reply() = N110Reply(bvadd(bvshl(bvconst(3232336,64),bvconst(32,64)),bvconst(1095454273,64)),bvconst(1,64),bvconst(0,64),bvconst(42,64),bvconst(144,64),bvconst(0,64),bvconst(8,64),bvconst(99,64),bvconst(8,64),(bvconst(1,8)=bvconst(1,8)),bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64))
define n110_c() = A109Context(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(71,64),bvconst(100,64),(bvconst(1,8)=bvconst(1,8)))
define n110_a() = P109Access(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(90,64),bvconst(110,64),A109Valid,A109Valid)
define n110_before() = P109State(bvconst(7,64),bvconst(55,64),bvconst(8,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64))
