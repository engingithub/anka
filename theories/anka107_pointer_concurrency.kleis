example "CONC107 universal closing cannot admit" {
    assert(∀(c : BitVec64). ∀(n : BitVec64).
        ¬conc107_admit(bvconst(2,8),c,n,bvconst(1,8),bvconst(1,8),bvconst(1,8)))
}
example "CONC107 universal retirement requires all leases zero" {
    assert(∀(c : BitVec64). ∀(d : BitVec64).
        conc107_retire(bvconst(2,8),bvconst(3,8),c,d,bvconst(1,8)) →
        ((c=bvconst(0,64)) ∧ (d=bvconst(0,64))))
}
example "CONC107 universal reuse requires drainage" {
    assert(∀(c : BitVec64). ∀(d : BitVec64). ∀(g : BitVec64). ∀(ng : BitVec64).
        conc107_reuse(bvconst(3,8),bvconst(1,8),c,d,g,ng,bvconst(1,8),bvconst(1,8)) →
        ((c=bvconst(0,64)) ∧ (d=bvconst(0,64)) ∧ ¬(g=ng)))
}
example "CONC107 universal Fabric revocation overrides lease" {
    assert(∀(p : BitVec8).
        ¬conc107_commit(p,bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(1,8)))
}
example "CONC107 universal completion count does not wrap" {
    assert(∀(c : BitVec64). ∀(n : BitVec64).
        conc107_finish(c,n,bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)) → bvult(n,c))
}

// DMA terminal evidence is composed directly with ticket consumption.
define conc107_dma_finish(count : BitVec64, next : BitVec64,
    active : BitVec8, nextactive : BitVec8, bound : BitVec8, serialized : BitVec8,
    stopped : BitVec8, drained : BitVec8, synced : BitVec8, disabled : BitVec8,
    completion_bound : BitVec8) =
    conc107_dma_terminal(stopped,drained,synced,disabled,completion_bound) ∧
    conc107_finish(count,next,active,nextactive,bound,bvconst(1,8),serialized)

// Raw DMA writes cannot create pointer-kind state. Overlapping pointer cells
// must be invalidated BEFORE device writes; coherency protocol must observe it.
define conc107_dma_tag(overlap : BitVec8, oldtag : BitVec8) =
    if overlap=bvconst(1,8) then bvconst(0,8) else oldtag

// Pointwise commit effect: denied commit preserves operand bytes.
define conc107_write_cell(phase : BitVec8, active : BitVec8, bound : BitVec8,
    fabric : BitVec8, serialized : BitVec8, value : BitVec8, old : BitVec8) =
    if conc107_commit(phase,active,bound,fabric,serialized) then value else old

example "CONC107 DMA terminal consumes last lease" { assert(conc107_dma_finish(bvconst(1,64),bvconst(0,64),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8))) }

example "CONC107 cancel request cannot finish lease" { assert(¬(conc107_dma_finish(bvconst(1,64),bvconst(0,64),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))) }

example "CONC107 equal odd snapshot rejected" { assert(¬(conc107_snapshot(bvconst(3,64),bvconst(3,64),bvconst(1,8),bvconst(1,8),bvconst(1,8)))) }

example "CONC107 count saturation cannot admit" { assert(¬(conc107_admit(bvconst(1,8),ptr107_max(),bvconst(0,64),bvconst(1,8),bvconst(1,8),bvconst(1,8)))) }

example "CONC107 storage version cannot wrap" { assert(¬(conc107_publish(ptr107_max(),bvconst(0,64),bvconst(1,8),bvconst(1,8),bvconst(1,8)))) }

example "CONC107 CPU DMA close drain retire interleaving" {
    assert(conc107_admit(bvconst(1,8),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8)) ∧
        conc107_close(bvconst(1,8),bvconst(2,8),bvconst(1,64),bvconst(1,64),bvconst(1,64),bvconst(1,64),bvconst(7,64),bvconst(7,64),bvconst(1,8),bvconst(1,8)) ∧
        conc107_finish(bvconst(1,64),bvconst(0,64),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)) ∧
        ¬conc107_retire(bvconst(2,8),bvconst(3,8),bvconst(0,64),bvconst(1,64),bvconst(1,8)) ∧
        conc107_dma_finish(bvconst(1,64),bvconst(0,64),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)) ∧
        conc107_retire(bvconst(2,8),bvconst(3,8),bvconst(0,64),bvconst(0,64),bvconst(1,8)))
}
example "CONC107 universal revoked commit changes no byte" {
    assert(∀(v : BitVec8). ∀(old : BitVec8).
        conc107_write_cell(bvconst(2,8),bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(1,8),v,old)=old)
}
example "CONC107 universal DMA overlapping pointer clears kind" {
    assert(∀(t : BitVec8). conc107_dma_tag(bvconst(1,8),t)=bvconst(0,8))
}
example "CONC107 universal DMA unrelated pointer keeps kind" {
    assert(∀(t : BitVec8). conc107_dma_tag(bvconst(0,8),t)=t)
}
