example "heap access accepts" {
    assert(¬(mf108_access(ut108_true(),ut108_true(),ut108_true(),ut108_true(),ut108_true(),bvconst(8,64),bvconst(32,64),bvconst(16,64))))
}

example "heap access rejects numeric forgery" {
    assert(¬(¬(mf108_access(ut108_false(),ut108_true(),ut108_true(),ut108_true(),ut108_true(),bvconst(8,64),bvconst(32,64),bvconst(16,64)))))
}

example "heap access rejects stale record" {
    assert(¬(¬(mf108_access(ut108_true(),ut108_false(),ut108_true(),ut108_true(),ut108_true(),bvconst(8,64),bvconst(32,64),bvconst(16,64)))))
}

example "heap access rejects same domain different context" {
    assert(¬(¬(mf108_access(ut108_true(),ut108_true(),ut108_false(),ut108_true(),ut108_true(),bvconst(8,64),bvconst(32,64),bvconst(16,64)))))
}

example "heap access rejects device path" {
    assert(¬(¬(mf108_access(ut108_true(),ut108_true(),ut108_true(),ut108_false(),ut108_true(),bvconst(8,64),bvconst(32,64),bvconst(16,64)))))
}

example "heap access rejects freed lifetime" {
    assert(¬(¬(mf108_access(ut108_true(),ut108_true(),ut108_true(),ut108_true(),ut108_false(),bvconst(8,64),bvconst(32,64),bvconst(16,64)))))
}

example "heap access rejects one past read" {
    assert(¬(¬(mf108_access(ut108_true(),ut108_true(),ut108_true(),ut108_true(),ut108_true(),bvconst(32,64),bvconst(32,64),bvconst(16,64)))))
}

example "heap access rejects past end" {
    assert(¬(¬(mf108_access(ut108_true(),ut108_true(),ut108_true(),ut108_true(),ut108_true(),bvconst(33,64),bvconst(32,64),bvconst(16,64)))))
}

example "heap access rejects overflow span" {
    assert(¬(¬(mf108_access(ut108_true(),ut108_true(),ut108_true(),ut108_true(),ut108_true(),bvconst(8,64),bvconst(32,64),ptr107_max()))))
}

example "zero-width one-past validates" {
    assert(¬(mf108_access(ut108_true(),ut108_true(),ut108_true(),ut108_true(),ut108_true(),bvconst(32,64),bvconst(32,64),bvconst(0,64))))
}

example "free null succeeds" {
    assert(¬(mf108_reply_free(ut108_true(),ut108_true(),ut108_false(),ut108_false(),ut108_false())))
}

example "free accepts" {
    assert(¬(mf108_reply_free(ut108_true(),ut108_false(),ut108_true(),ut108_true(),ut108_true())))
}

example "free rejects replayed event" {
    assert(¬(¬(mf108_reply_free(ut108_false(),ut108_false(),ut108_true(),ut108_true(),ut108_true()))))
}

example "free rejects interior or foreign pointer" {
    assert(¬(¬(mf108_reply_free(ut108_true(),ut108_false(),ut108_false(),ut108_true(),ut108_true()))))
}

example "free rejects not closed" {
    assert(¬(¬(mf108_reply_free(ut108_true(),ut108_false(),ut108_true(),ut108_false(),ut108_true()))))
}

example "free rejects not drained/retired" {
    assert(¬(¬(mf108_reply_free(ut108_true(),ut108_false(),ut108_true(),ut108_true(),ut108_false()))))
}

example "zero conversion accepts" {
    assert(¬(mf108_conversion(ut108_false(),ut108_true(),ut108_true(),ut108_true(),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,8))))
}

example "zero conversion rejects numeric expression" {
    assert(¬(¬(mf108_conversion(ut108_false(),ut108_true(),ut108_true(),ut108_false(),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,8)))))
}

example "zero conversion rejects nonzero scalar" {
    assert(¬(¬(mf108_conversion(ut108_false(),ut108_true(),ut108_true(),ut108_true(),bvconst(1,64),bvconst(0,64),bvconst(0,64),bvconst(0,8)))))
}

example "zero conversion rejects nonnull word" {
    assert(¬(¬(mf108_conversion(ut108_false(),ut108_true(),ut108_true(),ut108_true(),bvconst(0,64),bvconst(1,64),bvconst(0,64),bvconst(0,8)))))
}

example "zero conversion rejects nonnull offset" {
    assert(¬(¬(mf108_conversion(ut108_false(),ut108_true(),ut108_true(),ut108_true(),bvconst(0,64),bvconst(0,64),bvconst(1,64),bvconst(0,8)))))
}

example "zero conversion rejects forged kind" {
    assert(¬(¬(mf108_conversion(ut108_false(),ut108_true(),ut108_true(),ut108_true(),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(1,8)))))
}

example "object conversion accepts" {
    assert(¬(mf108_conversion(ut108_true(),ut108_true(),ut108_true(),ut108_false(),bvconst(1,64),bvconst(42,64),bvconst(8,64),bvconst(1,8))))
}

example "object conversion rejects changed words" {
    assert(¬(¬(mf108_conversion(ut108_true(),ut108_false(),ut108_true(),ut108_false(),bvconst(1,64),bvconst(42,64),bvconst(8,64),bvconst(1,8)))))
}

example "object conversion rejects changed kind" {
    assert(¬(¬(mf108_conversion(ut108_true(),ut108_true(),ut108_false(),ut108_false(),bvconst(1,64),bvconst(42,64),bvconst(8,64),bvconst(1,8)))))
}

example "object conversion rejects integer cast" {
    assert(¬(¬(mf108_conversion(ut108_false(),ut108_true(),ut108_true(),ut108_false(),bvconst(1,64),bvconst(42,64),bvconst(8,64),bvconst(1,8)))))
}

