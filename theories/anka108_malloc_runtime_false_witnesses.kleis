}

example "publication rejects raw alias" {
    assert(¬(¬(mf108_publish(ut108_true(),ut108_true(),ut108_true(),ut108_true(),ut108_false(),ut108_true(),ut108_true(),ut108_true()))))
}

example "publication rejects foreign owner" {
    assert(¬(¬(mf108_publish(ut108_true(),ut108_true(),ut108_true(),ut108_true(),ut108_true(),ut108_false(),ut108_true(),ut108_true()))))
}

example "publication rejects stale revision" {
    assert(¬(¬(mf108_publish(ut108_true(),ut108_true(),ut108_true(),ut108_true(),ut108_true(),ut108_true(),ut108_false(),ut108_true()))))
