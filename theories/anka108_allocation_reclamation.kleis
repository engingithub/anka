// Phase 10.8: reusable extents and bounded allocation metadata.
// SPECIFICATION ONLY. No new axioms, allocator implementation, moving GC,
// small-object suballocator, timing guarantee or physical-DMA drainage proof.
// Refines the existing PM geometry, heap lifetime/accounting and initialization
// contracts. Physical and per-owner virtual arenas use the SAME extent algebra.
// Free extents form a sorted, disjoint, maximally coalesced partition alongside
// reserved/live/closing extents. The quantified local laws preserve coverage and
// separation; implementation must maintain the global partition and exact
// selected records, apply the neighbor laws to EVERY remaining entry, and commit
// physical/virtual/registry/account state under one shared revision boundary.
// No caller-supplied 'scan passed' flag certifies that representation invariant.
//
// Proposed metadata representation: a capacity-bounded, permanently charged
// stable slot directory retains each last generation and free/reserved/live/
// closing/retired state. Bulky record pages may be evicted only when every slot
// in the page is free or permanently retired, with no readers or staged writers.
// Payload-page eviction NEVER removes, resets or renumbers directory entries.
// Generation exhaustion consumes a retired directory slot, not unbounded new
// tombstone storage. Actual byte sizes and pool backing are A2 obligations.
// Directory state: free=0, reserved=1, live=2, closing=3, exhausted=4.
// A1 lifetime phases remain available=0, live=1, closing=2, retired=3.
import "anka108_memory_initialization.kleis"

define reclaim108_zero() = bvconst(0,64)
define reclaim108_one() = bvconst(1,64)
define reclaim108_serial(revision : BitVec64, expected : BitVec64, serialized : BitVec8) =
    (revision=expected) ∧ bvult(revision,ptr107_max()) ∧ heap108_yes(serialized)
define reclaim108_interval(lo : BitVec64, hi : BitVec64, query : BitVec64) =
    bvule(lo,query) ∧ bvult(query,hi)
define reclaim108_inside(base : BitVec64, length : BitVec64, query : BitVec64) =
    reclaim108_interval(base,bvadd(base,length),query)
define reclaim108_segment(base : BitVec64, length : BitVec64) =
    (length=reclaim108_zero()) ∨ pm93g_extent_well_formed(base,length)

// Allocate the prefix of ONE actual free extent, retaining its exact suffix.
// A zero suffix is absent, not a zero-length free-list record.
define reclaim108_take(base : BitVec64, length : BitVec64, amount : BitVec64,
    pool : BitVec64, pool_size : BitVec64, free : BitVec8,
    revision : BitVec64, expected : BitVec64, serialized : BitVec8) =
    pm93g_extent_within_pool(base,length,pool,pool_size) ∧
    pm93g_extent_well_formed(base,amount) ∧ bvule(amount,length) ∧
    heap108_yes(free) ∧ reclaim108_serial(revision,expected,serialized)
define reclaim108_suffix_base(base : BitVec64, amount : BitVec64) = bvadd(base,amount)
define reclaim108_suffix_size(length : BitVec64, amount : BitVec64) = bvsub(length,amount)

// Only adjacent FREE extents may join. A live gap, overlap, reverse ordering,
// wrapping sum, or a claimed/staged/closing neighbor cannot be swallowed.
define reclaim108_join(a : BitVec64, an : BitVec64, b : BitVec64, bn : BitVec64,
    pool : BitVec64, pool_size : BitVec64, afree : BitVec8, bfree : BitVec8,
    revision : BitVec64, expected : BitVec64, serialized : BitVec8) =
    pm93g_extent_within_pool(a,an,pool,pool_size) ∧
    pm93g_extent_within_pool(b,bn,pool,pool_size) ∧
    (bvadd(a,an)=b) ∧ bvule(bn,bvsub(ptr107_max(),an)) ∧
    heap108_yes(afree) ∧ heap108_yes(bfree) ∧
    reclaim108_serial(revision,expected,serialized)

// This page-aligned candidate must be free in the CURRENT partition. An
// implementation supplies the actual selected record, not an application flag.
// Two holes are not stitched across a live extent even if total free is enough.
define reclaim108_virtual(owner : BitVec64, arena_owner : BitVec64,
    base : BitVec64, length : BitVec64, amount : BitVec64,
    pool : BitVec64, pool_size : BitVec64, free : BitVec8,
    revision : BitVec64, expected : BitVec64, serialized : BitVec8) =
    bvugt(owner,reclaim108_zero()) ∧ (owner=arena_owner) ∧
    reclaim108_take(base,length,amount,pool,pool_size,free,revision,expected,serialized)

// Exact active allocation identity: owner is a nonreused internal key binding
// process incarnation/context/domain. Query fields come from the request;
// record fields and outstanding/reference counts are trusted current state.
// Prefix/base/view validation remains heap108_free at the C boundary.
define reclaim108_release(slot : BitVec64, gen : BitVec64, owner : BitVec64,
    object : BitVec64, request_handle : BitVec64, request_owner : BitVec64,
    request_object : BitVec64, present : BitVec8, phase : BitVec8,
    cpu : BitVec64, dma : BitVec64, grants : BitVec64, maps : BitVec64,
    tags : BitVec64, placed : BitVec8, visibility : BitVec8,
    revision : BitVec64, expected : BitVec64, serialized : BitVec8) =
    repr107_components(slot,gen) ∧ (request_handle=repr107_handle(slot,gen)) ∧
    bvugt(owner,reclaim108_zero()) ∧ (request_owner=owner) ∧
    (request_object=object) ∧ heap108_yes(present) ∧
    (grants=reclaim108_zero()) ∧ (maps=reclaim108_zero()) ∧
    (tags=reclaim108_zero()) ∧ (placed=bvconst(0,8)) ∧
    heap108_retire(phase,cpu,dma,bvconst(1,8),bvconst(1,8),bvconst(1,8),
        bvconst(1,8),visibility,serialized) ∧
    reclaim108_serial(revision,expected,serialized)

// Require physical AND virtual reservations, registry room and ledger room
// together. A failed compound operation stutters all selected state. There is
// no public intermediate state after taking just one arena reservation.
define reclaim108_pair(physical : Bool, virtual : Bool, registry : Bool, budget : Bool) =
    physical ∧ virtual ∧ registry ∧ budget
define reclaim108_word(commit : Bool, before : BitVec64, after : BitVec64) =
    if commit then after else before
define reclaim108_byte(commit : Bool, before : BitVec8, after : BitVec8) =
    if commit then after else before
define reclaim108_revision(commit : Bool, revision : BitVec64) =
    if commit then bvadd(revision,reclaim108_one()) else revision
define reclaim108_present(released : Bool, before : BitVec8) =
    if released then bvconst(0,8) else before

// Pointwise free-set effects preserve every byte outside the selected extent.
// Release is only instantiated with the exact stored allocation extent.
define reclaim108_free_after_take(commit : Bool, base : BitVec64, amount : BitVec64,
    query : BitVec64, was_free : Bool) =
    if commit ∧ reclaim108_inside(base,amount,query) then (bvconst(0,8)=bvconst(1,8)) else was_free
define reclaim108_free_after_release(commit : Bool, base : BitVec64, amount : BitVec64,
    query : BitVec64, was_free : Bool) =
    if commit ∧ reclaim108_inside(base,amount,query) then (bvconst(1,8)=bvconst(1,8)) else was_free

// Stable directory bounds. Capacity is configuration, never an application-
// supplied quota; it cannot exceed the concrete 32-bit one-based slot encoding.
define reclaim108_slot(slot : BitVec64, capacity : BitVec64, gen : BitVec64) =
    bvugt(capacity,reclaim108_zero()) ∧ bvule(capacity,repr107_mask()) ∧
    bvugt(slot,reclaim108_zero()) ∧ bvule(slot,capacity) ∧ bvule(gen,repr107_mask())
define reclaim108_claim(slot : BitVec64, capacity : BitVec64, gen : BitVec64,
    state : BitVec8, resident : BitVec8, revision : BitVec64,
    expected : BitVec64, serialized : BitVec8) =
    reclaim108_slot(slot,capacity,gen) ∧ bvult(gen,repr107_mask()) ∧
    (state=bvconst(0,8)) ∧ heap108_yes(resident) ∧
    reclaim108_serial(revision,expected,serialized)
define reclaim108_generation(claim : Bool, gen : BitVec64) =
    if claim then bvadd(gen,reclaim108_one()) else gen
define reclaim108_closed_state(gen : BitVec64) =
    if gen=repr107_mask() then bvconst(4,8) else bvconst(0,8)

// Shrinking record storage preserves identity directory contents pointwise.
// Neighboring entries and pages remain unchanged; physical index != slot ID.
define reclaim108_directory_after_shrink(old_gen : BitVec64) = old_gen
define reclaim108_directory_state_after_shrink(old_state : BitVec8) = old_state
define reclaim108_slot_after_shrink(old_slot : BitVec64) = old_slot
define reclaim108_record(commit : Bool, selected : BitVec64, query : BitVec64,
    before : BitVec64, after : BitVec64) =
    if commit ∧ (selected=query) then after else before

// Fabric map entries are removable by exact object key; the identity namespace
// is separate from map storage. No counter rewind after published destruction.
// The existing narrow never-published rollback is a different contract.
define reclaim108_map_present(released : Bool, object : BitVec64, query : BitVec64,
    before : BitVec8) =
    if released ∧ (object=query) then bvconst(0,8) else before
define reclaim108_fresh_object(next_id : BitVec64, chosen : BitVec64, after : BitVec64) =
    bvult(next_id,ptr107_max()) ∧ (chosen=next_id) ∧
    (after=bvadd(next_id,reclaim108_one()))

// Rehydration reinstalls bulky storage under the existing directory key and
// generation; it is NOT allocation publication and mints no pointer authority.
// Serialized page allocation/initialization/charging must already have passed.
define reclaim108_rehydrate(slot : BitVec64, capacity : BitVec64,
    history : BitVec64, restored : BitVec64, state : BitVec8,
    resident : BitVec8, prepared : Bool, revision : BitVec64,
    expected : BitVec64, serialized : BitVec8) =
    reclaim108_slot(slot,capacity,history) ∧ (restored=history) ∧
    ((state=bvconst(0,8)) ∨ (state=bvconst(4,8))) ∧
    (resident=bvconst(0,8)) ∧ prepared ∧
    reclaim108_serial(revision,expected,serialized)

// A bounded record page is evictable iff every slot is quiescent and there is
// no reader/writer holding the page itself. Counts are exact directory-derived
// populations; pairwise slot induction establishes that census in A2. Free
// and exhausted slots need directory history but no bulky allocation record.
define reclaim108_census(width : BitVec64, free : BitVec64, reserved : BitVec64,
    live : BitVec64, closing : BitVec64, exhausted : BitVec64) =
    bvugt(width,reclaim108_zero()) ∧ bvule(width,repr107_mask()) ∧
    bvule(free,width) ∧ bvule(reserved,bvsub(width,free)) ∧
    bvule(live,bvsub(bvsub(width,free),reserved)) ∧
    bvule(closing,bvsub(bvsub(bvsub(width,free),reserved),live)) ∧
    (exhausted=bvsub(bvsub(bvsub(bvsub(width,free),reserved),live),closing))
define reclaim108_evict(width : BitVec64, free : BitVec64, reserved : BitVec64,
    live : BitVec64, closing : BitVec64, exhausted : BitVec64,
    resident : BitVec8, readers : BitVec64, writers : BitVec64,
    revision : BitVec64, expected : BitVec64, serialized : BitVec8) =
    reclaim108_census(width,free,reserved,live,closing,exhausted) ∧
    (reserved=reclaim108_zero()) ∧ (live=reclaim108_zero()) ∧
    (closing=reclaim108_zero()) ∧ heap108_yes(resident) ∧
    (readers=reclaim108_zero()) ∧ (writers=reclaim108_zero()) ∧
    reclaim108_serial(revision,expected,serialized)
define reclaim108_resident(evicted : Bool, before : BitVec8) =
    if evicted then bvconst(0,8) else before

// Count induction over a sorted partition with no adjacent free records.
// Prefix invariant: free <= claimed + (last_is_free ? 1 : 0). The empty prefix
// starts at (0,0,0); appending a claimed extent or a nonadjacent free extent
// preserves it. Therefore a complete pool has at most K+1 free extents for K
// nonfree extents. Bounded prefix guards avoid wrapping during the scan.
define reclaim108_prefix(free : BitVec64, claimed : BitVec64, last : BitVec8) =
    bvult(claimed,ptr107_max()) ∧
    (((last=bvconst(0,8)) ∧ bvule(free,claimed)) ∨
     ((last=bvconst(1,8)) ∧ bvule(free,bvadd(claimed,reclaim108_one()))))
define reclaim108_append_claim(free : BitVec64, claimed : BitVec64, last : BitVec8) =
    reclaim108_prefix(free,claimed,last) ∧
    bvult(claimed,bvsub(ptr107_max(),reclaim108_one()))
define reclaim108_append_free(free : BitVec64, claimed : BitVec64, last : BitVec8) =
    reclaim108_prefix(free,claimed,last) ∧ (last=bvconst(0,8)) ∧ bvult(free,ptr107_max())

// Admission reserves the proven worst-case free-record capacity. Sorted maximal
// coalescing, exact partition coverage and the census loop remain obligations.
// Reserve release bookkeeping at admission so free never needs unbudgeted
// scratch. Initial physical and virtual pools are separately partitioned.
define reclaim108_extent_capacity(claim_capacity : BitVec64, free_capacity : BitVec64) =
    bvule(claim_capacity,bvsub(ptr107_max(),reclaim108_one())) ∧
    (free_capacity=bvadd(claim_capacity,reclaim108_one()))

// Resource charging separates permanently reserved infrastructure, actual
// occupied backing, resident metadata, and other retained/staged storage.
// Fixed includes full directory and both bounded arena-index capacities.
// Each category is disjoint; backing for metadata is not charged twice.
define reclaim108_ledger(fixed : BitVec64, payload : BitVec64,
    metadata : BitVec64, retained : BitVec64, limit : BitVec64) =
    bvugt(fixed,reclaim108_zero()) ∧
    bvuge(bvadd(fixed,payload),fixed) ∧
    bvuge(bvadd(bvadd(fixed,payload),metadata),bvadd(fixed,payload)) ∧
    bvuge(bvadd(bvadd(bvadd(fixed,payload),metadata),retained),bvadd(bvadd(fixed,payload),metadata)) ∧
    bvule(bvadd(bvadd(bvadd(fixed,payload),metadata),retained),limit)
define reclaim108_total(fixed : BitVec64, payload : BitVec64,
    metadata : BitVec64, retained : BitVec64) =
    bvadd(bvadd(bvadd(fixed,payload),metadata),retained)
// Pending retirement keeps its full charge; only exact completed release
// changes the ledger. The permanent directory is never included in a refund.
define reclaim108_refund(released : Bool, payload : BitVec64, actual : BitVec64) =
    if released ∧ bvule(actual,payload) then bvsub(payload,actual) else payload
define reclaim108_metadata_refund(evicted : Bool, metadata : BitVec64,
    page_bytes : BitVec64, actual_returned : BitVec64) =
    if evicted ∧ bvugt(page_bytes,reclaim108_zero()) ∧
       bvule(page_bytes,metadata) ∧ (actual_returned=page_bytes)
    then bvsub(metadata,page_bytes) else metadata
// A resident allocation must pass this charge before publication. Reusable
// reserved pools already live in fixed and are not counted as a fresh page.
define reclaim108_grow(fixed : BitVec64, payload : BitVec64, metadata : BitVec64,
    retained : BitVec64, amount : BitVec64, limit : BitVec64) =
    reclaim108_ledger(fixed,payload,metadata,retained,limit) ∧
    bvugt(amount,reclaim108_zero()) ∧
    bvule(amount,bvsub(ptr107_max(),payload)) ∧
    bvule(amount,bvsub(limit,reclaim108_total(fixed,payload,metadata,retained)))

// Closed-cycle backing/accounting result. A successful allocate/free pair
// restores backing and reusable virtual extent; generation/revision history
// advances and is deliberately NOT rolled back. Finite epochs may ultimately
// cause explicit admission failure; no infinite-success/liveness theorem.
define reclaim108_cycle_payload(payload : BitVec64, amount : BitVec64) =
    reclaim108_refund((bvconst(1,8)=bvconst(1,8)),bvadd(payload,amount),amount)
define reclaim108_cycle_free(base : BitVec64, amount : BitVec64,
    query : BitVec64, before : Bool) =
    reclaim108_free_after_release((bvconst(1,8)=bvconst(1,8)),base,amount,query,
        reclaim108_free_after_take((bvconst(1,8)=bvconst(1,8)),base,amount,query,before))

// Constructive two-client geometry: A owns [0x1000,0x2000), B owns
// [0x2000,0x3000), and [0x3000,0x5000) is free. Free A first: no join across B.
// Free B, join B+tail then A+(B+tail), yielding the entire original four pages.
// This is a small trace of the defined operations, not an arbitrary-list proof.
define reclaim108_trace_join_b() =
    reclaim108_join(bvconst(8192,64),bvconst(4096,64),bvconst(12288,64),bvconst(8192,64),
        bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(1,8),bvconst(7,64),bvconst(7,64),bvconst(1,8))
define reclaim108_trace_join_a() =
    reclaim108_trace_join_b() ∧
    reclaim108_join(bvconst(4096,64),bvconst(4096,64),bvconst(8192,64),bvconst(12288,64),
        bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(1,8),bvconst(8,64),bvconst(8,64),bvconst(1,8))

// WITNESSES BELOW

example "reclaim108_take accepts" {
    assert(reclaim108_take(bvconst(4096,64),bvconst(16384,64),bvconst(4096,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8)))
}

example "reclaim108_take rejects empty request" {
    assert(¬(reclaim108_take(bvconst(4096,64),bvconst(16384,64),bvconst(0,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8))))
}

example "reclaim108_take rejects partial page" {
    assert(¬(reclaim108_take(bvconst(4096,64),bvconst(16384,64),bvconst(4097,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8))))
}

example "reclaim108_take rejects unaligned start" {
    assert(¬(reclaim108_take(bvconst(4097,64),bvconst(16384,64),bvconst(4096,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8))))
}

example "reclaim108_take rejects larger than hole" {
    assert(¬(reclaim108_take(bvconst(4096,64),bvconst(16384,64),bvconst(20480,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8))))
}

example "reclaim108_take rejects outside pool" {
    assert(¬(reclaim108_take(bvconst(0,64),bvconst(16384,64),bvconst(4096,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8))))
}

example "reclaim108_take rejects partial free record" {
    assert(¬(reclaim108_take(bvconst(4096,64),bvconst(16385,64),bvconst(4096,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8))))
}

example "reclaim108_take rejects occupied extent" {
    assert(¬(reclaim108_take(bvconst(4096,64),bvconst(16384,64),bvconst(4096,64),bvconst(4096,64),bvconst(16384,64),bvconst(0,8),bvconst(5,64),bvconst(5,64),bvconst(1,8))))
}

example "reclaim108_take rejects stale revision" {
    assert(¬(reclaim108_take(bvconst(4096,64),bvconst(16384,64),bvconst(4096,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(5,64),bvconst(4,64),bvconst(1,8))))
}

example "reclaim108_take rejects revision exhaustion" {
    assert(¬(reclaim108_take(bvconst(4096,64),bvconst(16384,64),bvconst(4096,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvsub(ptr107_max(),bvconst(0,64)),bvsub(ptr107_max(),bvconst(0,64)),bvconst(1,8))))
}

example "reclaim108_take rejects no serialization" {
    assert(¬(reclaim108_take(bvconst(4096,64),bvconst(16384,64),bvconst(4096,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(0,8))))
}

example "reclaim108_take rejects wrapped end" {
    assert(¬(reclaim108_take(bvsub(ptr107_max(),bvconst(4095,64)),bvconst(8192,64),bvconst(4096,64),bvsub(ptr107_max(),bvconst(4095,64)),bvconst(8192,64),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8))))
}

example "exact-fit removes entire hole" {
    assert(reclaim108_take(bvconst(4096,64),bvconst(4096,64),bvconst(4096,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8)))
}

example "exact-fit leaves no suffix" {
    assert(reclaim108_suffix_size(bvconst(4096,64),bvconst(4096,64))=bvconst(0,64))
}

example "reclaim108_join accepts" {
    assert(reclaim108_join(bvconst(4096,64),bvconst(4096,64),bvconst(8192,64),bvconst(8192,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8)))
}

example "reclaim108_join rejects live intervening page" {
    assert(¬(reclaim108_join(bvconst(4096,64),bvconst(4096,64),bvconst(12288,64),bvconst(4096,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8))))
}

example "reclaim108_join rejects overlap" {
    assert(¬(reclaim108_join(bvconst(4096,64),bvconst(4096,64),bvconst(4096,64),bvconst(8192,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8))))
}

example "reclaim108_join rejects reverse ordering" {
    assert(¬(reclaim108_join(bvconst(8192,64),bvconst(4096,64),bvconst(4096,64),bvconst(8192,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8))))
}

example "reclaim108_join rejects occupied left" {
    assert(¬(reclaim108_join(bvconst(4096,64),bvconst(4096,64),bvconst(8192,64),bvconst(8192,64),bvconst(4096,64),bvconst(16384,64),bvconst(0,8),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8))))
}

example "reclaim108_join rejects occupied right" {
    assert(¬(reclaim108_join(bvconst(4096,64),bvconst(4096,64),bvconst(8192,64),bvconst(8192,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(0,8),bvconst(5,64),bvconst(5,64),bvconst(1,8))))
}

example "reclaim108_join rejects empty neighbor" {
    assert(¬(reclaim108_join(bvconst(4096,64),bvconst(4096,64),bvconst(8192,64),bvconst(0,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8))))
}

example "reclaim108_join rejects outside pool" {
    assert(¬(reclaim108_join(bvconst(4096,64),bvconst(4096,64),bvconst(8192,64),bvconst(16384,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8))))
}

example "reclaim108_join rejects stale coalescing snapshot" {
    assert(¬(reclaim108_join(bvconst(4096,64),bvconst(4096,64),bvconst(8192,64),bvconst(8192,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(1,8),bvconst(5,64),bvconst(4,64),bvconst(1,8))))
}

example "reclaim108_join rejects no serialization" {
    assert(¬(reclaim108_join(bvconst(4096,64),bvconst(4096,64),bvconst(8192,64),bvconst(8192,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(0,8))))
}

example "reclaim108_virtual accepts" {
    assert(reclaim108_virtual(bvconst(101,64),bvconst(101,64),bvconst(8192,64),bvconst(8192,64),bvconst(4096,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8)))
}

example "reclaim108_virtual rejects different process incarnation arena" {
    assert(¬(reclaim108_virtual(bvconst(101,64),bvconst(102,64),bvconst(8192,64),bvconst(8192,64),bvconst(4096,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8))))
}

example "reclaim108_virtual rejects missing owner" {
    assert(¬(reclaim108_virtual(bvconst(0,64),bvconst(0,64),bvconst(8192,64),bvconst(8192,64),bvconst(4096,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8))))
