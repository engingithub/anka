}

example "retained host capacity remains charged" {
    assert(reclaim108_metadata_refund((bvconst(1,8)=bvconst(1,8)),bvconst(8192,64),bvconst(4096,64),bvconst(0,64))=bvconst(8192,64))
}

example "retained host capacity remains charged cannot produce 4096" {
    assert(¬(reclaim108_metadata_refund((bvconst(1,8)=bvconst(1,8)),bvconst(8192,64),bvconst(4096,64),bvconst(0,64))=bvconst(4096,64)))
}

example "exactly returned page refunded" {
    assert(reclaim108_metadata_refund((bvconst(1,8)=bvconst(1,8)),bvconst(8192,64),bvconst(4096,64),bvconst(4096,64))=bvconst(4096,64))
}

example "exactly returned page refunded cannot produce 0" {
    assert(¬(reclaim108_metadata_refund((bvconst(1,8)=bvconst(1,8)),bvconst(8192,64),bvconst(4096,64),bvconst(4096,64))=bvconst(0,64)))
}

example "failed eviction receives no refund" {
    assert(reclaim108_metadata_refund((bvconst(0,8)=bvconst(1,8)),bvconst(8192,64),bvconst(4096,64),bvconst(4096,64))=bvconst(8192,64))
}

example "failed eviction receives no refund cannot produce 4096" {
    assert(¬(reclaim108_metadata_refund((bvconst(0,8)=bvconst(1,8)),bvconst(8192,64),bvconst(4096,64),bvconst(4096,64))=bvconst(4096,64)))
}

example "live neighbor object survives table shrink" {
    assert(reclaim108_map_present((bvconst(1,8)=bvconst(1,8)),bvconst(44,64),bvconst(45,64),bvconst(1,8))=bvconst(1,8))
}

example "live neighbor object survives table shrink cannot produce 0" {
    assert(¬(reclaim108_map_present((bvconst(1,8)=bvconst(1,8)),bvconst(44,64),bvconst(45,64),bvconst(1,8))=bvconst(0,8)))
}

example "selected object entry removed" {
    assert(reclaim108_map_present((bvconst(1,8)=bvconst(1,8)),bvconst(44,64),bvconst(44,64),bvconst(1,8))=bvconst(0,8))
}

example "selected object entry removed cannot produce 1" {
    assert(¬(reclaim108_map_present((bvconst(1,8)=bvconst(1,8)),bvconst(44,64),bvconst(44,64),bvconst(1,8))=bvconst(1,8)))
}

example "generation exhaustion leaves permanent state" {
    assert(reclaim108_closed_state(repr107_mask())=bvconst(4,8))
}

example "generation exhaustion leaves permanent state cannot produce 0" {
    assert(¬(reclaim108_closed_state(repr107_mask())=bvconst(0,8)))
}

example "ordinary generation becomes reusable" {
    assert(reclaim108_closed_state(bvconst(7,64))=bvconst(0,8))
}

example "ordinary generation becomes reusable cannot produce 4" {
    assert(¬(reclaim108_closed_state(bvconst(7,64))=bvconst(4,8)))
}

example "last generation survives metadata shrink" {
    assert(reclaim108_directory_after_shrink(bvconst(7,64))=bvconst(7,64))
}

example "last generation survives metadata shrink cannot produce 0" {
    assert(¬(reclaim108_directory_after_shrink(bvconst(7,64))=bvconst(0,64)))
}

example "live slot index survives metadata shrink" {
    assert(reclaim108_slot_after_shrink(bvconst(3,64))=bvconst(3,64))
}

example "live slot index survives metadata shrink cannot produce 1" {
    assert(¬(reclaim108_slot_after_shrink(bvconst(3,64))=bvconst(1,64)))
}

example "failed virtual admission restores physical reservation" {
    assert(reclaim108_word(reclaim108_pair((bvconst(1,8)=bvconst(1,8)),(bvconst(0,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8))),bvconst(16384,64),bvconst(12288,64))=bvconst(16384,64))
}

example "failed virtual admission restores physical reservation cannot produce 12288" {
    assert(¬(reclaim108_word(reclaim108_pair((bvconst(1,8)=bvconst(1,8)),(bvconst(0,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8))),bvconst(16384,64),bvconst(12288,64))=bvconst(12288,64)))
}

example "failed metadata admission preserves generation" {
    assert(reclaim108_generation(reclaim108_pair((bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8)),(bvconst(0,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8))),bvconst(7,64))=bvconst(7,64))
}

example "failed metadata admission preserves generation cannot produce 8" {
    assert(¬(reclaim108_generation(reclaim108_pair((bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8)),(bvconst(0,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8))),bvconst(7,64))=bvconst(8,64)))
}

example "failed budget admission preserves revision" {
    assert(reclaim108_revision(reclaim108_pair((bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8)),(bvconst(0,8)=bvconst(1,8))),bvconst(5,64))=bvconst(5,64))
}

example "failed budget admission preserves revision cannot produce 6" {
    assert(¬(reclaim108_revision(reclaim108_pair((bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8)),(bvconst(0,8)=bvconst(1,8))),bvconst(5,64))=bvconst(6,64)))
}

example "split preserves exact byte coverage" {
    assert(∀(lo : BitVec64). ∀(mid : BitVec64). ∀(hi : BitVec64). ∀(q : BitVec64). (bvule(lo,mid) ∧ bvule(mid,hi)) → (reclaim108_interval(lo,hi,q)=(reclaim108_interval(lo,mid,q) ∨ reclaim108_interval(mid,hi,q))))
}

example "take computes ordered split endpoints" {
    assert(∀(b : BitVec64). ∀(n : BitVec64). ∀(k : BitVec64). reclaim108_take(b,n,k,b,n,bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8)) → (bvule(b,bvadd(b,k)) ∧ bvule(bvadd(b,k),bvadd(b,n))))
}

example "split never duplicates a byte" {
    assert(∀(b : BitVec64). ∀(n : BitVec64). ∀(k : BitVec64). ∀(q : BitVec64). reclaim108_take(b,n,k,b,n,bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8)) → ¬(reclaim108_inside(b,k,q) ∧ reclaim108_inside(bvadd(b,k),bvsub(n,k),q)))
}

example "split preserves total length" {
    assert(∀(b : BitVec64). ∀(n : BitVec64). ∀(k : BitVec64). reclaim108_take(b,n,k,b,n,bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8)) → (bvadd(k,bvsub(n,k))=n))
}

example "split preserves aligned remainder" {
    assert(∀(b : BitVec64). ∀(n : BitVec64). ∀(k : BitVec64). reclaim108_take(b,n,k,b,n,bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8)) → reclaim108_segment(bvadd(b,k),bvsub(n,k)))
}

example "join computes same final endpoint" {
    assert(∀(a : BitVec64). ∀(an : BitVec64). ∀(b : BitVec64). ∀(bn : BitVec64). ∀(pool : BitVec64). ∀(size : BitVec64). reclaim108_join(a,an,b,bn,pool,size,bvconst(1,8),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8)) → (bvadd(a,bvadd(an,bn))=bvadd(b,bn)))
}

example "join preserves exact union" {
    assert(∀(a : BitVec64). ∀(b : BitVec64). ∀(end : BitVec64). ∀(q : BitVec64). (bvult(a,b) ∧ bvult(b,end)) → (reclaim108_interval(a,end,q)=(reclaim108_interval(a,b,q) ∨ reclaim108_interval(b,end,q))))
}

example "joined interval remains within pool" {
    assert(∀(a : BitVec64). ∀(b : BitVec64). ∀(end : BitVec64). ∀(pool : BitVec64). ∀(pool_end : BitVec64). (bvule(pool,a) ∧ bvult(a,b) ∧ bvult(b,end) ∧ bvule(end,pool_end)) → (bvule(pool,a) ∧ bvule(end,pool_end) ∧ bvult(a,end)))
}

example "join preserves separation from every nonempty other interval" {
    assert(∀(a : BitVec64). ∀(b : BitVec64). ∀(end : BitVec64). ∀(c : BitVec64). ∀(ce : BitVec64). (bvult(a,b) ∧ bvult(b,end) ∧ bvult(c,ce) ∧ (bvule(b,c) ∨ bvule(ce,a)) ∧ (bvule(end,c) ∨ bvule(ce,b))) → (bvule(end,c) ∨ bvule(ce,a)))
}

example "failed compound transition preserves arbitrary state" {
    assert(∀(p : Bool). ∀(v : Bool). ∀(r : Bool). ∀(b : Bool). ∀(old : BitVec64). ∀(next : BitVec64). ¬(reclaim108_pair(p,v,r,b)) → (reclaim108_word(reclaim108_pair(p,v,r,b),old,next)=old))
}

example "unselected record stays unchanged" {
    assert(∀(selected : BitVec64). ∀(query : BitVec64). ∀(old : BitVec64). ∀(next : BitVec64). ¬(selected=query) → (reclaim108_record((bvconst(1,8)=bvconst(1,8)),selected,query,old,next)=old))
}

example "free operation preserves neighboring bytes" {
    assert(∀(b : BitVec64). ∀(n : BitVec64). ∀(q : BitVec64). ∀(old : Bool). ¬(reclaim108_inside(b,n,q)) → (reclaim108_free_after_release((bvconst(1,8)=bvconst(1,8)),b,n,q,old)=old))
}

example "allocation/free restores exact prior free set" {
    assert(∀(b : BitVec64). ∀(n : BitVec64). ∀(k : BitVec64). ∀(q : BitVec64). ∀(old : Bool). (reclaim108_inside(b,k,q) → old) → (reclaim108_cycle_free(b,k,q,old)=old))
}

example "allocated page cannot remain free" {
    assert(∀(b : BitVec64). ∀(n : BitVec64). ∀(q : BitVec64). ∀(old : Bool). reclaim108_inside(b,n,q) → ¬(reclaim108_free_after_take((bvconst(1,8)=bvconst(1,8)),b,n,q,old)))
}

example "slot reuse rejects every previous generation" {
    assert(∀(s : BitVec64). ∀(g : BitVec64). (repr107_components(s,g) ∧ bvult(g,repr107_mask())) → ¬(heap108_current(repr107_handle(s,g),bvconst(1,8),s,reclaim108_generation((bvconst(1,8)=bvconst(1,8)),g),bvconst(1,8),bvconst(2,8),(bvconst(1,8)=bvconst(1,8)))))
}

example "fresh generation works after page rehydration" {
    assert(∀(g : BitVec64). bvult(g,repr107_mask()) → heap108_current(repr107_handle(bvconst(3,64),bvadd(g,bvconst(1,64))),bvconst(1,8),bvconst(3,64),reclaim108_generation((bvconst(1,8)=bvconst(1,8)),reclaim108_directory_after_shrink(g)),bvconst(1,8),bvconst(2,8),(bvconst(1,8)=bvconst(1,8))))
}

example "page shrink preserves all generation history" {
    assert(∀(g : BitVec64). reclaim108_directory_after_shrink(g)=g)
}

example "page shrink preserves all slot identities" {
    assert(∀(s : BitVec64). reclaim108_slot_after_shrink(s)=s)
}

example "page shrink preserves all directory states" {
    assert(∀(s : BitVec8). reclaim108_directory_state_after_shrink(s)=s)
}

example "no active record on evictable page" {
    assert(∀(w : BitVec64). ∀(f : BitVec64). ∀(r : BitVec64). ∀(l : BitVec64). ∀(c : BitVec64). ∀(x : BitVec64). reclaim108_evict(w,f,r,l,c,x,bvconst(1,8),bvconst(0,64),bvconst(0,64),bvconst(5,64),bvconst(5,64),bvconst(1,8)) → ((r=bvconst(0,64)) ∧ (l=bvconst(0,64)) ∧ (c=bvconst(0,64)) ∧ (bvadd(f,x)=w)))
}

example "ledger bounds exact total" {
    assert(∀(f : BitVec64). ∀(p : BitVec64). ∀(m : BitVec64). ∀(r : BitVec64). ∀(limit : BitVec64). reclaim108_ledger(f,p,m,r,limit) → bvule(reclaim108_total(f,p,m,r),limit))
}

example "checked category addition cannot wrap" {
    assert(∀(a : BitVec64). ∀(b : BitVec64). bvuge(bvadd(a,b),a) → bvule(b,bvsub(ptr107_max(),a)))
}

example "admission residual preserves global bound" {
    assert(∀(used : BitVec64). ∀(n : BitVec64). ∀(limit : BitVec64). (bvule(used,limit) ∧ bvule(n,bvsub(limit,used))) → (bvule(bvadd(used,n),limit) ∧ bvuge(bvadd(used,n),used)))
}

example "updated categories equal old total plus admitted charge" {
    assert(∀(f : BitVec64). ∀(p : BitVec64). ∀(m : BitVec64). ∀(r : BitVec64). ∀(n : BitVec64). reclaim108_total(f,bvadd(p,n),m,r)=bvadd(reclaim108_total(f,p,m,r),n))
}

example "admission prevents backing charge wrap" {
    assert(∀(f : BitVec64). ∀(p : BitVec64). ∀(m : BitVec64). ∀(r : BitVec64). ∀(n : BitVec64). ∀(limit : BitVec64). reclaim108_grow(f,p,m,r,n,limit) → bvule(n,bvsub(ptr107_max(),p)))
}

example "one closed churn cycle restores backing charge" {
    assert(∀(p : BitVec64). ∀(n : BitVec64). bvule(n,bvsub(ptr107_max(),p)) → (reclaim108_cycle_payload(p,n)=p))
}

example "released backing cannot increase charge" {
    assert(∀(p : BitVec64). ∀(n : BitVec64). bvule(reclaim108_refund((bvconst(1,8)=bvconst(1,8)),p,n),p))
}

example "metadata refund cannot increase charge" {
    assert(∀(m : BitVec64). ∀(n : BitVec64). ∀(actual : BitVec64). bvule(reclaim108_metadata_refund((bvconst(1,8)=bvconst(1,8)),m,n,actual),m))
}

example "directory charge remains after complete release" {
    assert(∀(f : BitVec64). ∀(p : BitVec64). ∀(m : BitVec64). bvugt(m,bvconst(0,64)) → (reclaim108_total(f,reclaim108_refund((bvconst(1,8)=bvconst(1,8)),p,p),reclaim108_metadata_refund((bvconst(1,8)=bvconst(1,8)),m,m,m),bvconst(0,64))=f))
}

example "partition count induction starts empty" {
    assert(reclaim108_prefix(bvconst(0,64),bvconst(0,64),bvconst(0,8)))
}

example "append claimed extent preserves count bound" {
    assert(∀(f : BitVec64). ∀(c : BitVec64). ∀(last : BitVec8). reclaim108_append_claim(f,c,last) → reclaim108_prefix(f,bvadd(c,bvconst(1,64)),bvconst(0,8)))
}

example "append separated free extent preserves count bound" {
    assert(∀(f : BitVec64). ∀(c : BitVec64). ∀(last : BitVec8). reclaim108_append_free(f,c,last) → reclaim108_prefix(bvadd(f,bvconst(1,64)),c,bvconst(1,8)))
}

example "canonical partition has at most claimed plus one holes" {
    assert(∀(f : BitVec64). ∀(c : BitVec64). ∀(last : BitVec8). reclaim108_prefix(f,c,last) → bvule(f,bvadd(c,bvconst(1,64))))
}

example "adjacent free records must coalesce" {
    assert(¬(reclaim108_append_free(bvconst(1,64),bvconst(0,64),bvconst(1,8))))
}

example "hole count exceeds bounded directory" {
    assert(¬(reclaim108_prefix(bvconst(66,64),bvconst(64,64),bvconst(1,8))))
}

example "free B joins with tail" {
    assert(reclaim108_trace_join_b())
}

example "free A after B restores whole arena" {
    assert(reclaim108_trace_join_a())
}

example "reclaimed arena accepts whole-pool allocation" {
    assert(reclaim108_trace_join_a() ∧ reclaim108_take(bvconst(4096,64),bvconst(16384,64),bvconst(16384,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(9,64),bvconst(9,64),bvconst(1,8)))
}

example "live B may be swallowed during free A" {
    assert(¬(reclaim108_join(bvconst(4096,64),bvconst(4096,64),bvconst(12288,64),bvconst(8192,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8))))
}

example "same virtual address can serve a fresh lifetime" {
    assert(reclaim108_virtual(bvconst(101,64),bvconst(101,64),bvconst(8192,64),bvconst(8192,64),bvconst(4096,64),bvconst(4096,64),bvconst(16384,64),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8)) ∧ reclaim108_claim(bvconst(3,64),bvconst(64,64),bvconst(7,64),bvconst(0,8),bvconst(1,8),bvconst(5,64),bvconst(5,64),bvconst(1,8)))
}

example "saved event alias revives at reused virtual address" {
    assert(¬(heap108_current(repr107_handle(bvconst(3,64),bvconst(7,64)),bvconst(1,8),bvconst(3,64),bvconst(8,64),bvconst(1,8),bvconst(2,8),(bvconst(1,8)=bvconst(1,8)))))
}

example "reused virtual range does not replace initialization" {
    assert(¬(init108_heap_gate((bvconst(0,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8)),bvconst(17,64),bvconst(4096,64),bvconst(4096,64))))
}

example "coalescing grants permission to skip scrub" {
    assert(¬(init108_heap_gate((bvconst(0,8)=bvconst(1,8)),reclaim108_trace_join_a(),bvconst(17,64),bvconst(4096,64),bvconst(4096,64))))
}

example "three differently sized cycles preserve payload baseline" {
    assert(reclaim108_cycle_payload(reclaim108_cycle_payload(reclaim108_cycle_payload(bvconst(8192,64),bvconst(4096,64)),bvconst(8192,64)),bvconst(12288,64))=bvconst(8192,64))
}

example "three differently sized cycles preserve payload baseline cannot produce 32768" {
    assert(¬(reclaim108_cycle_payload(reclaim108_cycle_payload(reclaim108_cycle_payload(bvconst(8192,64),bvconst(4096,64)),bvconst(8192,64)),bvconst(12288,64))=bvconst(32768,64)))
}

example "metadata allocate-evict cycle preserves fixed baseline" {
    assert(reclaim108_total(bvconst(4096,64),bvconst(0,64),reclaim108_metadata_refund((bvconst(1,8)=bvconst(1,8)),bvconst(4096,64),bvconst(4096,64),bvconst(4096,64)),bvconst(0,64))=bvconst(4096,64))
}

example "metadata allocate-evict cycle preserves fixed baseline cannot produce 0" {
    assert(¬(reclaim108_total(bvconst(4096,64),bvconst(0,64),reclaim108_metadata_refund((bvconst(1,8)=bvconst(1,8)),bvconst(4096,64),bvconst(4096,64),bvconst(4096,64)),bvconst(0,64))=bvconst(0,64)))
}
