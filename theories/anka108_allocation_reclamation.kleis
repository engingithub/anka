}

example "completed release refunds exact backing" {
    assert(reclaim108_refund((bvconst(1,8)=bvconst(1,8)),bvconst(8192,64),bvconst(4096,64))=bvconst(4096,64))
}

example "completed release refunds exact backing cannot produce 0" {
    assert(¬(reclaim108_refund((bvconst(1,8)=bvconst(1,8)),bvconst(8192,64),bvconst(4096,64))=bvconst(0,64)))
}

example "oversized refund stutters" {
    assert(reclaim108_refund((bvconst(1,8)=bvconst(1,8)),bvconst(4096,64),bvconst(8192,64))=bvconst(4096,64))
}

example "oversized refund stutters cannot produce 18446744073709547520" {
