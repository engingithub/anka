example "reclaim108_grow rejects unbounded wrapping charge" {
    assert(¬(reclaim108_grow(bvconst(4096,64),bvconst(8192,64),bvconst(4096,64),bvconst(1024,64),bvsub(ptr107_max(),bvconst(0,64)),bvconst(21504,64))))
