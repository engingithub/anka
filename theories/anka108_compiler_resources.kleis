// C1: shared compiler resource/ABI contract, revision 2. Specification only.
// No new axioms. Existing ABI-1/bootstrap gates retain their enforced limits.
// Imports reuse protected allocation admission and pointwise account rules;
// this file does not weaken private-heap ownership to support legacy raw loads.
//
// Trusted checks below concern ONE current serialized snapshot. They are not
// bits accepted from the guest. Exact binding keys resolve immutable records
// containing source/root, ordered dependencies, tools, profile and resource plan.
// Job, owner and attempt IDs are nonreused trusted names, not capabilities.
// The owner record contains ProcessKey incarnation, context and domain.
//
// Concrete internal ABI: little-endian u64 fields; header=128, region=128,
// reply=128 bytes. The region's protected pair occupies offsets 32/40 and must
// have authenticated kind state; serialized words cannot manufacture it.
// Full field layout, inventory, assumptions and C2-C5 gates are in DN-71 C1.
import "anka108_allocation.kleis"

define res108_z() = bvconst(0,64)
define res108_one() = bvconst(1,64)
define res108_true() = (bvconst(1,8)=bvconst(1,8))
define res108_false() = (bvconst(0,8)=bvconst(1,8))
define res108_page(x : BitVec64) =
    bvugt(x,res108_z()) ∧ bvule(x,heap108_signed_max()) ∧
    (bvand(x,bvconst(4095,64))=res108_z())
define res108_add(a : BitVec64, b : BitVec64, limit : BitVec64) =
    bvule(a,limit) ∧ bvule(b,bvsub(limit,a))
define res108_round(n : BitVec64) =
    bvand(bvadd(n,bvconst(4095,64)),bvsub(res108_z(),bvconst(4096,64)))

// Count*stride is checked BEFORE multiplication or address formation. Logical
// bounds are independent of the page-rounded backing and never widen to it.
define res108_table(count : BitVec64, stride : BitVec64, capacity : BitVec64) =
    bvugt(stride,res108_z()) ∧ bvule(capacity,heap108_signed_max()) ∧
    bvule(count,bvudiv(capacity,stride))
define res108_span(offset : BitVec64, width : BitVec64, capacity : BitVec64) =
    bvule(capacity,heap108_signed_max()) ∧ bvule(offset,capacity) ∧
    bvule(width,bvsub(capacity,offset))
define res108_reservation(used : BitVec64, width : BitVec64, capacity : BitVec64) =
    bvugt(width,res108_z()) ∧ res108_span(used,width,capacity)
define res108_cursor(ok : Bool, used : BitVec64, width : BitVec64) =
    if ok then bvadd(used,width) else used

// ABI magic is the u64 value 0x41435232 ("ACR2"). Only version 2 is decoded by
// this route. Total includes every declared record; no trailing hidden records.
define res108_header(magic : BitVec64, version : BitVec64, header : BitVec64,
    count : BitVec64, max_count : BitVec64, stride : BitVec64,
    total : BitVec64, reply : BitVec64, reserved : BitVec64) =
    (magic=bvconst(1094930994,64)) ∧ (version=bvconst(2,64)) ∧
    (header=bvconst(128,64)) ∧ (stride=bvconst(128,64)) ∧
    bvugt(count,res108_z()) ∧ bvule(count,max_count) ∧ bvule(max_count,bvconst(16,64)) ∧
    res108_table(count,stride,bvsub(heap108_signed_max(),header)) ∧
    (total=bvadd(header,bvmul(count,stride))) ∧
    (reply=bvconst(128,64)) ∧ (reserved=res108_z())
define res108_record_offset(index : BitVec64) =
    bvadd(bvconst(128,64),bvmul(index,bvconst(128,64)))
define res108_pair_offset(index : BitVec64) =
    bvadd(res108_record_offset(index),bvconst(32,64))
define res108_fresh(before : BitVec64, after : BitVec64) =
    bvult(before,ptr107_max()) ∧ (after=bvadd(before,res108_one()))
// Source text starts at position zero in ABI 2; its length is in the descriptor.
// Any final legacy word fetch still fits initialized logical storage. Padding
// is excluded from text length, emitted bytes and source identity.
define res108_source(length : BitVec64, capacity : BitVec64, padding_zero : Bool) =
    bvule(length,bvsub(heap108_signed_max(),bvconst(7,64))) ∧
    bvule(bvand(bvadd(length,bvconst(7,64)),bvsub(res108_z(),bvconst(8,64))),capacity) ∧
    padding_zero

// Binding is matched word-by-word to the frozen coordinator record. Apply to
// source/root, tools, ordered dependencies, profile and immutable budget plan.
define res108_binding(value : BitVec64, expected : BitVec64,
    present : Bool, current : Bool, exact : Bool) =
    bvugt(value,res108_z()) ∧ (value=expected) ∧ present ∧ current ∧ exact
define res108_identity(job : BitVec64, attempt : BitVec64, owner : BitVec64,
    expected_job : BitVec64, expected_attempt : BitVec64,
    expected_owner : BitVec64, live : Bool, authenticated : Bool) =
    bvugt(job,res108_z()) ∧ bvugt(attempt,res108_z()) ∧ bvugt(owner,res108_z()) ∧
    (job=expected_job) ∧ (attempt=expected_attempt) ∧ (owner=expected_owner) ∧
    live ∧ authenticated

// A region descriptor describes authority already installed for this exact
// compiler owner. Tool RX images use the separate immutable tool binding, not
// these data-region records. resource=1 is immutable effective source and 15
// is the READ-only request; other roles are private RW data enumerated in DN-71.
// Supported growth IDs are an
// explicit producer/plan subset, not every syntactically recognized resource.
define res108_resource(resource : BitVec64) =
    bvuge(resource,res108_one()) ∧ bvule(resource,bvconst(16,64))
define res108_region(resource : BitVec64, capacity : BitVec64,
    valid_bytes : BitVec64, stride : BitVec64, count : BitVec64,
    rounded : BitVec64, rights : BitVec64, position : BitVec64,
    reserved : BitVec64, pointer_current : Bool, owner_exact : Bool,
    object_binding : Bool, mapping_exact : Bool, no_raw_bypass : Bool) =
    res108_resource(resource) ∧ heap108_size(capacity) ∧
    bvule(valid_bytes,capacity) ∧ res108_table(count,stride,capacity) ∧
    pm93g_rounding_valid(capacity,rounded) ∧ (position=res108_z()) ∧
    (reserved=res108_z()) ∧ pointer_current ∧ owner_exact ∧ object_binding ∧
    mapping_exact ∧ no_raw_bypass ∧
    (if (resource=res108_one()) ∨ (resource=bvconst(15,64))
     then rights=res108_one() else rights=bvconst(3,64))
// The trusted decoder folds all fields/records and all pairs. A true prefix
// cannot hide a rejected later record; duplicate role IDs are forbidden.
define res108_fold(prefix : Bool, next : Bool) = prefix ∧ next
define res108_pair(id_a : BitVec64, id_b : BitVec64,
    start_a : BitVec64, size_a : BitVec64, start_b : BitVec64,
    size_b : BitVec64, different_backing : Bool) =
    ¬(id_a=id_b) ∧ different_backing ∧
    vm93g_range_well_formed(start_a,size_a) ∧
    vm93g_range_well_formed(start_b,size_b) ∧
    vm93g_disjoint(start_a,size_a,start_b,size_b)

// Billing folds every retained-capacity class: payload rounding, shadow,
// metadata, images, stacks, scratch/copies, publications and legacy history.
// A storage identity is charged once; references do not silently add or remove
// its charge. The complete ledger/census remains an implementation obligation.
define res108_bill(prior : BitVec64, amount : BitVec64, total : BitVec64) =
    res108_add(prior,amount,ptr107_max()) ∧ (total=bvadd(prior,amount))
define res108_admit(charge : BitVec64, job_used : BitVec64, job_limit : BitVec64,
    owner_used : BitVec64, owner_limit : BitVec64, total : BitVec64,
    ceiling : BitVec64, revision : BitVec64, expected : BitVec64,
    exact_ledger : BitVec8) =
    bvule(job_used,owner_used) ∧ res108_add(job_used,charge,job_limit) ∧
    heap108_budget(charge,owner_used,owner_limit,total,ceiling,revision,expected,exact_ledger)
define res108_charged(ok : Bool, before : BitVec64, amount : BitVec64) =
    if ok then bvadd(before,amount) else before
define res108_account(ok : Bool, owner : BitVec64, query : BitVec64,
    before : BitVec64, after : BitVec64) = heap108_account(ok,owner,query,before,after)

// The supervisor meters work before each bounded slice. No zero-cost retry or
// reset of cumulative work; cleanup has separately reserved service capacity.
define res108_work(spent : BitVec64, slice : BitVec64, budget : BitVec64) =
    bvugt(slice,res108_z()) ∧ res108_add(spent,slice,budget)
define res108_launch(header : Bool, identity : Bool, bindings : Bool,
    all_regions : Bool, all_pairs : Bool, budget : Bool, initialized : Bool,
    cleanup_reserved : Bool, entry_kinds : Bool, revision : BitVec64,
    expected : BitVec64, serialized : Bool) =
    header ∧ identity ∧ bindings ∧ all_regions ∧ all_pairs ∧ budget ∧
    initialized ∧ cleanup_reserved ∧ entry_kinds ∧
    (revision=expected) ∧ serialized

// Guest reply tags: 0 Success, 1 NeedCapacity, 2 SourceRejected,
// 3 RepresentationRejected. Coordinator-only outcomes: 4 BudgetDenied,
// 5 ExecutionFailure, 6 ProtocolRejected; guest reports cannot select these.
// Every guest report requires normal transport exit and exact frozen controls.
// An execution fault is supervisor outcome 5, never an automatic retry hint.
define res108_report(magic : BitVec64, version : BitVec64,
    identity : Bool, bindings : Bool, controls : Bool,
    normal_exit : Bool, exit_code : BitVec64, no_execution : Bool,
    stopped : Bool, drained : Bool, reserved : BitVec64) =
    (magic=bvconst(1094930994,64)) ∧ (version=bvconst(2,64)) ∧
    identity ∧ bindings ∧ controls ∧ normal_exit ∧ (exit_code=res108_z()) ∧
    no_execution ∧ stopped ∧ drained ∧ (reserved=res108_z())
define res108_success(status : BitVec64, used : BitVec64, capacity : BitVec64,
    resource : BitVec64, minimum : BitVec64, detail : BitVec64,
    consumed : BitVec64, source_length : BitVec64, report : Bool,
    artifact_valid : Bool) =
    report ∧ artifact_valid ∧ (status=res108_z()) ∧
    bvuge(used,bvconst(112,64)) ∧ bvule(used,capacity) ∧
    bvule(capacity,heap108_signed_max()) ∧
    (bvand(used,bvconst(7,64))=res108_z()) ∧
    (resource=res108_z()) ∧ (minimum=res108_z()) ∧ (detail=res108_z()) ∧
    (consumed=source_length)
define res108_need(status : BitVec64, resource : BitVec64,
    selected : BitVec64, minimum : BitVec64, capacity : BitVec64,
    used : BitVec64, detail : BitVec64, consumed : BitVec64,
    source_length : BitVec64, report : Bool, growth_supported : Bool) =
    report ∧ growth_supported ∧ (status=res108_one()) ∧
    res108_resource(resource) ∧ (resource=selected) ∧
    bvugt(minimum,capacity) ∧ bvule(minimum,heap108_signed_max()) ∧
    (used=res108_z()) ∧ (detail=res108_z()) ∧ bvule(consumed,source_length)
define res108_rejected(status : BitVec64, resource : BitVec64,
    minimum : BitVec64, used : BitVec64, detail : BitVec64,
    consumed : BitVec64, source_length : BitVec64, report : Bool) =
    report ∧ ((status=bvconst(2,64)) ∨ (status=bvconst(3,64))) ∧
    (resource=res108_z()) ∧ (minimum=res108_z()) ∧ (used=res108_z()) ∧
    bvugt(detail,res108_z()) ∧ bvule(consumed,source_length)

// Growth capacities and per-resource ceilings are page aligned. Saturate the
// geometric target at the admitted ceiling, never modulo-add then compare.
// A well-formed requirement beyond the ceiling yields BudgetDenied. Values
// <= current capacity or above signed AC2 range are protocol errors.
define res108_growth(old : BitVec64, minimum : BitVec64, limit : BitVec64) =
    res108_page(old) ∧ res108_page(limit) ∧ bvugt(minimum,old) ∧ bvule(minimum,limit)
define res108_geometric(old : BitVec64, limit : BitVec64) =
    if bvule(old,bvsub(limit,old)) then bvadd(old,old) else limit
define res108_next_capacity(old : BitVec64, minimum : BitVec64, limit : BitVec64) =
    if bvuge(res108_round(minimum),res108_geometric(old,limit))
    then res108_round(minimum) else res108_geometric(old,limit)

// All old aliases are fenced centrally. Return/scrub can finish after denial;
// no refund, reuse, new attempt or publication follows mere timeout/notification.
define res108_drained(fenced : Bool, cpu : BitVec64, dma : BitVec64,
    readers : BitVec64, writers : BitVec64, grants_gone : Bool,
    current_census : Bool) =
    fenced ∧ (cpu=res108_z()) ∧ (dma=res108_z()) ∧
    (readers=res108_z()) ∧ (writers=res108_z()) ∧ grants_gone ∧ current_census
define res108_released(drained : Bool, exact_return : Bool, clean_bytes : Bool,
    clean_kinds : Bool, current_receipt : Bool, amount : BitVec64, held : BitVec64) =
    drained ∧ exact_return ∧ clean_bytes ∧ clean_kinds ∧ current_receipt ∧
    bvugt(amount,res108_z()) ∧ bvule(amount,held)
define res108_refund(released : Bool, held : BitVec64, amount : BitVec64) =
    if released then bvsub(held,amount) else held
define res108_retry(need : Bool, growth : Bool, released : Bool,
    new_admission : Bool, frozen_current : Bool, fresh_workspace : Bool,
    attempt : BitVec64, remaining : BitVec64, work : Bool) =
    need ∧ growth ∧ released ∧ new_admission ∧ frozen_current ∧ fresh_workspace ∧
    bvugt(attempt,res108_z()) ∧ bvult(attempt,ptr107_max()) ∧
    bvugt(remaining,res108_z()) ∧ work
define res108_attempt(retry : Bool, old : BitVec64) =
    if retry then bvadd(old,res108_one()) else old
define res108_retries(retry : Bool, remaining : BitVec64) =
    if retry then bvsub(remaining,res108_one()) else remaining

// Old register/spill/saved-event copies all authenticate the current trusted
// row. Reusing the same physical address never revalidates an old identity.
define res108_alias(job : BitVec64, attempt : BitVec64, owner : BitVec64,
    current_job : BitVec64, current_attempt : BitVec64, current_owner : BitVec64,
    generation : BitVec64, current_generation : BitVec64, live : Bool, kind : Bool) =
    res108_identity(job,attempt,owner,current_job,current_attempt,current_owner,live,kind) ∧
    bvugt(generation,res108_z()) ∧ (generation=current_generation)

// Copy only the validated used prefix in bounded Fabric transactions. Full
// image validity, source/tool lineage and publication authority are independent
// trusted checks; a syntactically valid guest status does not establish them.
define res108_copy(used : BitVec64, cursor : BitVec64, chunk : BitVec64,
    current_read_grant : Bool) =
    current_read_grant ∧ bvugt(chunk,res108_z()) ∧ bvule(chunk,bvconst(65536,64)) ∧
    res108_span(cursor,chunk,used)
define res108_publish(success : Bool, frozen_current : Bool, authority : Bool,
    used : BitVec64, copied : BitVec64, logical_size : BitVec64,
    read_only : Bool, fresh_object : Bool, charged : Bool, drained : Bool,
    epoch : BitVec64, result_ready : Bool) =
    success ∧ frozen_current ∧ authority ∧ (copied=used) ∧ (logical_size=used) ∧
    read_only ∧ fresh_object ∧ charged ∧ drained ∧
    bvult(epoch,ptr107_max()) ∧ result_ready
define res108_epoch(published : Bool, epoch : BitVec64) =
    if published then bvadd(epoch,res108_one()) else epoch
// New publication inserts one fresh key; existing receipt/dependency entries
// remain immutable and charged until their own validated retention release.
define res108_receipt(published : Bool, fresh_key : BitVec64, query : BitVec64,
    before : BitVec64, new_value : BitVec64) =
    if published ∧ (fresh_key=query) then new_value else before

// Determinism is conditional on the GUEST serializer producing the canonical
// bytes for the frozen job. This model states that obligation per byte; it does
// not prove the C serializer, use a host compiler, or identify equal receipts.
define res108_canonical(candidate : BitVec8, canonical : BitVec8,
    frozen_job : Bool, guest_serialized : Bool) =
    frozen_job ∧ guest_serialized ∧ (candidate=canonical)

// C1 WITNESSES

example "table accepts" {
    assert(res108_table(bvconst(64,64),bvconst(80,64),bvconst(5120,64)))
}

example "table rejects multiplication wrap" {
    assert(¬(res108_table(ptr107_max(),bvconst(80,64),bvconst(5120,64))))
}

example "table rejects short storage" {
    assert(¬(res108_table(bvconst(64,64),bvconst(80,64),bvconst(5119,64))))
}

example "table rejects zero stride" {
    assert(¬(res108_table(bvconst(64,64),bvconst(0,64),bvconst(5120,64))))
}

example "reservation accepts" {
    assert(res108_reservation(bvconst(4090,64),bvconst(6,64),bvconst(4096,64)))
}

example "reservation rejects overrun" {
    assert(¬(res108_reservation(bvconst(4090,64),bvconst(7,64),bvconst(4096,64))))
}

example "reservation rejects wrapped cursor" {
    assert(¬(res108_reservation(ptr107_max(),bvconst(6,64),bvconst(4096,64))))
}

example "reservation rejects empty operation" {
    assert(¬(res108_reservation(bvconst(4090,64),bvconst(0,64),bvconst(4096,64))))
}

example "ABI header accepts" {
    assert(res108_header(bvconst(1094930994,64),bvconst(2,64),bvconst(128,64),bvconst(3,64),bvconst(16,64),bvconst(128,64),bvconst(512,64),bvconst(128,64),bvconst(0,64)))
}

example "ABI header rejects ABI1" {
    assert(¬(res108_header(bvconst(1094930994,64),bvconst(1,64),bvconst(128,64),bvconst(3,64),bvconst(16,64),bvconst(128,64),bvconst(512,64),bvconst(128,64),bvconst(0,64))))
}

example "ABI header rejects unknown revision" {
    assert(¬(res108_header(bvconst(1094930994,64),bvconst(3,64),bvconst(128,64),bvconst(3,64),bvconst(16,64),bvconst(128,64),bvconst(512,64),bvconst(128,64),bvconst(0,64))))
}

example "ABI header rejects wrong magic" {
    assert(¬(res108_header(bvconst(0,64),bvconst(2,64),bvconst(128,64),bvconst(3,64),bvconst(16,64),bvconst(128,64),bvconst(512,64),bvconst(128,64),bvconst(0,64))))
}

example "ABI header rejects short header" {
    assert(¬(res108_header(bvconst(1094930994,64),bvconst(2,64),bvconst(120,64),bvconst(3,64),bvconst(16,64),bvconst(128,64),bvconst(512,64),bvconst(128,64),bvconst(0,64))))
}

example "ABI header rejects empty directory" {
    assert(¬(res108_header(bvconst(1094930994,64),bvconst(2,64),bvconst(128,64),bvconst(0,64),bvconst(16,64),bvconst(128,64),bvconst(128,64),bvconst(128,64),bvconst(0,64))))
}

example "ABI header rejects descriptor budget" {
    assert(¬(res108_header(bvconst(1094930994,64),bvconst(2,64),bvconst(128,64),bvconst(17,64),bvconst(16,64),bvconst(128,64),bvconst(2304,64),bvconst(128,64),bvconst(0,64))))
}

example "ABI header rejects wrong stride" {
    assert(¬(res108_header(bvconst(1094930994,64),bvconst(2,64),bvconst(128,64),bvconst(3,64),bvconst(16,64),bvconst(64,64),bvconst(512,64),bvconst(128,64),bvconst(0,64))))
}

example "ABI header rejects wrapped count" {
    assert(¬(res108_header(bvconst(1094930994,64),bvconst(2,64),bvconst(128,64),ptr107_max(),ptr107_max(),bvconst(128,64),bvconst(512,64),bvconst(128,64),bvconst(0,64))))
}

example "ABI header rejects trailing record" {
    assert(¬(res108_header(bvconst(1094930994,64),bvconst(2,64),bvconst(128,64),bvconst(3,64),bvconst(16,64),bvconst(128,64),bvconst(640,64),bvconst(128,64),bvconst(0,64))))
}

example "ABI header rejects wrong reply size" {
    assert(¬(res108_header(bvconst(1094930994,64),bvconst(2,64),bvconst(128,64),bvconst(3,64),bvconst(16,64),bvconst(128,64),bvconst(512,64),bvconst(120,64),bvconst(0,64))))
}

example "ABI header rejects reserved bits" {
    assert(¬(res108_header(bvconst(1094930994,64),bvconst(2,64),bvconst(128,64),bvconst(3,64),bvconst(16,64),bvconst(128,64),bvconst(512,64),bvconst(128,64),bvconst(1,64))))
}

example "frozen binding accepts" {
    assert(res108_binding(bvconst(7,64),bvconst(7,64),res108_true(),res108_true(),res108_true()))
}

example "frozen binding rejects substitution" {
    assert(¬(res108_binding(bvconst(8,64),bvconst(7,64),res108_true(),res108_true(),res108_true())))
}

example "frozen binding rejects revocation" {
    assert(¬(res108_binding(bvconst(7,64),bvconst(7,64),res108_true(),res108_false(),res108_true())))
}

example "frozen binding rejects inexact record" {
    assert(¬(res108_binding(bvconst(7,64),bvconst(7,64),res108_true(),res108_true(),res108_false())))
}

example "job identity accepts" {
    assert(res108_identity(bvconst(7,64),bvconst(3,64),bvconst(9,64),bvconst(7,64),bvconst(3,64),bvconst(9,64),res108_true(),res108_true()))
}

example "job identity rejects old attempt" {
    assert(¬(res108_identity(bvconst(7,64),bvconst(2,64),bvconst(9,64),bvconst(7,64),bvconst(3,64),bvconst(9,64),res108_true(),res108_true())))
}

example "job identity rejects foreign owner" {
    assert(¬(res108_identity(bvconst(7,64),bvconst(3,64),bvconst(8,64),bvconst(7,64),bvconst(3,64),bvconst(9,64),res108_true(),res108_true())))
}

example "job identity rejects dead incarnation" {
    assert(¬(res108_identity(bvconst(7,64),bvconst(3,64),bvconst(9,64),bvconst(7,64),bvconst(3,64),bvconst(9,64),res108_false(),res108_true())))
}

example "job identity rejects unauthenticated words" {
    assert(¬(res108_identity(bvconst(7,64),bvconst(3,64),bvconst(9,64),bvconst(7,64),bvconst(3,64),bvconst(9,64),res108_true(),res108_false())))
}

example "private region accepts" {
    assert(res108_region(bvconst(3,64),bvconst(8192,64),bvconst(0,64),bvconst(8,64),bvconst(1024,64),bvconst(8192,64),bvconst(3,64),bvconst(0,64),bvconst(0,64),res108_true(),res108_true(),res108_true(),res108_true(),res108_true()))
}

example "private region rejects unknown resource" {
    assert(¬(res108_region(bvconst(17,64),bvconst(8192,64),bvconst(0,64),bvconst(8,64),bvconst(1024,64),bvconst(8192,64),bvconst(3,64),bvconst(0,64),bvconst(0,64),res108_true(),res108_true(),res108_true(),res108_true(),res108_true())))
}

example "private region rejects empty allocation" {
    assert(¬(res108_region(bvconst(3,64),bvconst(0,64),bvconst(0,64),bvconst(8,64),bvconst(0,64),bvconst(8192,64),bvconst(3,64),bvconst(0,64),bvconst(0,64),res108_true(),res108_true(),res108_true(),res108_true(),res108_true())))
}

example "private region rejects used prefix overflow" {
    assert(¬(res108_region(bvconst(3,64),bvconst(8192,64),bvconst(8193,64),bvconst(8,64),bvconst(1024,64),bvconst(8192,64),bvconst(3,64),bvconst(0,64),bvconst(0,64),res108_true(),res108_true(),res108_true(),res108_true(),res108_true())))
}

example "private region rejects table overflow" {
    assert(¬(res108_region(bvconst(3,64),bvconst(8192,64),bvconst(0,64),bvconst(8,64),bvconst(1025,64),bvconst(8192,64),bvconst(3,64),bvconst(0,64),bvconst(0,64),res108_true(),res108_true(),res108_true(),res108_true(),res108_true())))
}

example "private region rejects insufficient backing" {
    assert(¬(res108_region(bvconst(3,64),bvconst(8192,64),bvconst(0,64),bvconst(8,64),bvconst(1024,64),bvconst(4096,64),bvconst(3,64),bvconst(0,64),bvconst(0,64),res108_true(),res108_true(),res108_true(),res108_true(),res108_true())))
}

example "private region rejects execute rights" {
    assert(¬(res108_region(bvconst(3,64),bvconst(8192,64),bvconst(0,64),bvconst(8,64),bvconst(1024,64),bvconst(8192,64),bvconst(7,64),bvconst(0,64),bvconst(0,64),res108_true(),res108_true(),res108_true(),res108_true(),res108_true())))
