}

example "law: reservation commit stays within logical bound" {
    assert(∀(o : BitVec64). ∀(w : BitVec64). ∀(c : BitVec64). res108_reservation(o,w,c) → bvule(res108_cursor(res108_true(),o,w),c))
}

example "law: failed reservation preserves cursor" {
    assert(∀(o : BitVec64). ∀(w : BitVec64). ∀(c : BitVec64). ¬res108_reservation(o,w,c) → (res108_cursor(res108_reservation(o,w,c),o,w)=o))
}

example "law: full record fold cannot ignore rejection" {
    assert(∀(p : Bool). ¬res108_fold(p,res108_false()))
}

example "law: ABI directory extent is bounded" {
