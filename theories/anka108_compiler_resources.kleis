    assert(¬(res108_producer_hint(bvconst(9223372036854775800,64),bvconst(9223372036854775800,64),bvconst(9223372036854775800,64),bvconst(17,64))))
}

example "law: name offsets survive bounded packing" {
    assert(∀(s : BitVec64). ∀(n : BitVec64).
      (bvule(s,bvconst(65528,64)) ∧ bvule(n,bvconst(63,64))) →
      ((bvlshr(res108_name_pack(s,n),bvconst(8,64))=s) ∧
       (bvand(res108_name_pack(s,n),bvconst(255,64))=n)))
}
// Same universal obligation, proved by an exhaustive split of the error code:
//   forall f,t,c,e: hint(f,t,c,e) -> c < minimum(f,t,c,e) <= signed_max.
// The first law proves that every accepted hint selects code 17 or code 18.
// The next two prove the unchanged conclusion for ALL f,t,c in each case.
// Together these cover every e; they are not sampled boundary witnesses.
// No hint guard, arithmetic definition, assumption or solver limit is changed.
example "law: producer hint excludes other codes" {
    assert(∀(f : BitVec64). ∀(t : BitVec64). ∀(c : BitVec64). ∀(e : BitVec64).
      res108_producer_hint(f,t,c,e) → ((e=bvconst(17,64)) ∨ (e=bvconst(18,64))))
}
example "law: producer word hint is strictly larger and representable" {
    assert(∀(f : BitVec64). ∀(t : BitVec64). ∀(c : BitVec64).
      res108_producer_hint(f,t,c,bvconst(17,64)) →
      (bvugt(res108_producer_min(f,t,c,bvconst(17,64)),c) ∧
       bvule(res108_producer_min(f,t,c,bvconst(17,64)),heap108_signed_max())))
}
example "law: producer metadata hint is strictly larger and representable" {
    assert(∀(f : BitVec64). ∀(t : BitVec64). ∀(c : BitVec64).
      res108_producer_hint(f,t,c,bvconst(18,64)) →
      (bvugt(res108_producer_min(f,t,c,bvconst(18,64)),c) ∧
       bvule(res108_producer_min(f,t,c,bvconst(18,64)),heap108_signed_max())))
}

// C2.4 linker transport control +88: 0 preserves application policy;
// 2 selects one protected compiler tool and its exact ABI-2 entry signature.
// These checks supplement, never replace, AOM/frame/call/metadata validation.
define res108_tool_link_input(profile : BitVec64, modules : BitVec64,
    protected : Bool, bytes : BitVec64) =
    bvugt(modules,res108_z()) ∧ bvugt(bytes,res108_z()) ∧
    (((profile=res108_z()) ∧ bvule(bytes,bvconst(262144,64))) ∨
     ((profile=bvconst(2,64)) ∧ (modules=bvconst(1,64)) ∧ protected ∧
      bvule(bytes,bvconst(1048576,64))))
define res108_tool_link_entry(profile : BitVec64, entry : BitVec64,
    main_name : Bool, result : BitVec64, argc : BitVec64,
    p0 : BitVec64, p1 : BitVec64) =
    (entry=res108_z()) ∧ main_name ∧ (result=bvconst(1,64)) ∧
    (((profile=res108_z()) ∧ (argc=res108_z()) ∧ (p0=res108_z()) ∧ (p1=res108_z())) ∨
     ((profile=bvconst(2,64)) ∧ (argc=bvconst(2,64)) ∧
      (p0=bvconst(2001,64)) ∧ (p1=bvconst(1001,64))))

example "tool link: application exact input bound" {
    assert(res108_tool_link_input(bvconst(0,64),bvconst(2,64),res108_true(),bvconst(262144,64)))
}

example "tool link: application cannot borrow compiler bound" {
    assert(¬(res108_tool_link_input(bvconst(0,64),bvconst(1,64),res108_true(),bvconst(262145,64))))
}

example "tool link: compiler exact input bound" {
    assert(res108_tool_link_input(bvconst(2,64),bvconst(1,64),res108_true(),bvconst(1048576,64)))
}

example "tool link: compiler input beyond bound" {
    assert(¬(res108_tool_link_input(bvconst(2,64),bvconst(1,64),res108_true(),bvconst(1048577,64))))
}

example "tool link: compiler rejects multiple modules" {
    assert(¬(res108_tool_link_input(bvconst(2,64),bvconst(2,64),res108_true(),bvconst(4096,64))))
}

example "tool link: compiler rejects legacy input" {
    assert(¬(res108_tool_link_input(bvconst(2,64),bvconst(1,64),res108_false(),bvconst(4096,64))))
}

example "tool link: unknown linker profile rejected" {
    assert(¬(res108_tool_link_input(bvconst(3,64),bvconst(1,64),res108_true(),bvconst(4096,64))))
}

example "tool link: compiler rejects empty input" {
    assert(¬(res108_tool_link_input(bvconst(2,64),bvconst(1,64),res108_true(),bvconst(0,64))))
}

example "tool link: compiler exact entry signature" {
    assert(res108_tool_link_entry(bvconst(2,64),bvconst(0,64),res108_true(),bvconst(1,64),bvconst(2,64),bvconst(2001,64),bvconst(1001,64)))
}

example "tool link: application exact entry signature" {
    assert(res108_tool_link_entry(bvconst(0,64),bvconst(0,64),res108_true(),bvconst(1,64),bvconst(0,64),bvconst(0,64),bvconst(0,64)))
}

example "tool link: compiler rejects application entry" {
    assert(¬(res108_tool_link_entry(bvconst(2,64),bvconst(0,64),res108_true(),bvconst(1,64),bvconst(0,64),bvconst(0,64),bvconst(0,64))))
}

example "tool link: application rejects compiler entry" {
    assert(¬(res108_tool_link_entry(bvconst(0,64),bvconst(0,64),res108_true(),bvconst(1,64),bvconst(2,64),bvconst(2001,64),bvconst(1001,64))))
}

example "tool link: compiler rejects swapped pointer types" {
    assert(¬(res108_tool_link_entry(bvconst(2,64),bvconst(0,64),res108_true(),bvconst(1,64),bvconst(2,64),bvconst(1001,64),bvconst(2001,64))))
}

example "tool link: compiler rejects scalar parameter" {
    assert(¬(res108_tool_link_entry(bvconst(2,64),bvconst(0,64),res108_true(),bvconst(1,64),bvconst(2,64),bvconst(2001,64),bvconst(1,64))))
}

example "tool link: compiler rejects shifted entry" {
    assert(¬(res108_tool_link_entry(bvconst(2,64),bvconst(8,64),res108_true(),bvconst(1,64),bvconst(2,64),bvconst(2001,64),bvconst(1001,64))))
}

example "tool link: compiler rejects wrong name" {
    assert(¬(res108_tool_link_entry(bvconst(2,64),bvconst(0,64),res108_false(),bvconst(1,64),bvconst(2,64),bvconst(2001,64),bvconst(1001,64))))
}

example "tool link: compiler rejects wrong return type" {
    assert(¬(res108_tool_link_entry(bvconst(2,64),bvconst(0,64),res108_true(),bvconst(2,64),bvconst(2,64),bvconst(2001,64),bvconst(1001,64))))
}

example "law: compiler link input is one protected bounded module" {
    assert(∀(n : BitVec64). ∀(p : Bool). ∀(b : BitVec64).
      res108_tool_link_input(bvconst(2,64),n,p,b) →
      ((n=bvconst(1,64)) ∧ p ∧ bvule(b,bvconst(1048576,64))))
}
example "law: compiler link entry preserves exact pointer types" {
    assert(∀(a : BitVec64). ∀(x : BitVec64). ∀(y : BitVec64).
      res108_tool_link_entry(bvconst(2,64),res108_z(),res108_true(),bvconst(1,64),a,x,y) →
      ((a=bvconst(2,64)) ∧ (x=bvconst(2001,64)) ∧ (y=bvconst(1001,64))))
}
