}

// C2.4: numeric selectors are internal offsets, never raw memory authority.
// Actual PLOAD/PADD/PREAD/PWRITE still require the authenticated region token.
define res108_selector(a : BitVec64, ws : BitVec64, out : BitVec64) =
    (bvand(a,bvconst(7,64))=res108_z()) ∧
    ((bvuge(a,bvconst(49152,64)) ∧ bvult(a,bvconst(73728,64)) ∧
      res108_span(bvsub(a,bvconst(49152,64)),bvconst(8,64),ws)) ∨
     (bvuge(a,bvconst(73728,64)) ∧
      res108_span(bvsub(a,bvconst(73728,64)),bvconst(8,64),out)))
define res108_producer_extra(code : BitVec64) =
    if code=bvconst(18,64) then bvconst(56,64) else bvconst(8,64)
define res108_producer_min(front : BitVec64, tail : BitVec64, cap : BitVec64, code : BitVec64) =
    bvadd(bvadd(front,bvsub(cap,tail)),res108_producer_extra(code))
define res108_producer_hint(front : BitVec64, tail : BitVec64, cap : BitVec64, code : BitVec64) =
    ((code=bvconst(17,64)) ∨ (code=bvconst(18,64))) ∧
    bvule(front,tail) ∧ bvule(tail,cap) ∧ bvule(cap,heap108_signed_max()) ∧
    res108_add(front,bvsub(cap,tail),heap108_signed_max()) ∧
    res108_add(bvadd(front,bvsub(cap,tail)),res108_producer_extra(code),heap108_signed_max()) ∧
    bvugt(res108_producer_min(front,tail,cap,code),cap)
define res108_name_pack(start : BitVec64, length : BitVec64) =
    bvor(bvshl(start,bvconst(8,64)),length)

example "producer selector 49152" {
    assert(res108_selector(bvconst(49152,64),bvconst(24576,64),bvconst(4096,64)))
}

example "producer selector 73720" {
    assert(res108_selector(bvconst(73720,64),bvconst(24576,64),bvconst(4096,64)))
}

