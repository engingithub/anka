}

example "law: nonselected owner preserved" {
    assert(∀(a : BitVec64). ∀(b : BitVec64). ∀(old : BitVec64). ∀(new : BitVec64). ∀(ok : Bool). ¬(a=b) → (res108_account(ok,a,b,old,new)=old))
}

example "law: failed admission changes no charge" {
    assert(∀(old : BitVec64). ∀(n : BitVec64). res108_charged(res108_false(),old,n)=old)
}

example "law: work is cumulative and bounded" {
    assert(∀(w : BitVec64). ∀(s : BitVec64). ∀(b : BitVec64). res108_work(w,s,b) → (bvugt(bvadd(w,s),w) ∧ bvule(bvadd(w,s),b)))
}

example "law: growth is strict" {
    assert(∀(o : BitVec64). ∀(n : BitVec64). ∀(l : BitVec64). res108_growth(o,n,l) → bvugt(res108_next_capacity(o,n,l),o))
}

example "law: growth respects ceiling" {
    assert(∀(o : BitVec64). ∀(n : BitVec64). ∀(l : BitVec64). res108_growth(o,n,l) → bvule(res108_next_capacity(o,n,l),l))
}

example "law: growth covers minimum" {
    assert(∀(o : BitVec64). ∀(n : BitVec64). ∀(l : BitVec64). res108_growth(o,n,l) → bvuge(res108_next_capacity(o,n,l),n))
}

example "law: growth remains page aligned" {
    assert(∀(o : BitVec64). ∀(n : BitVec64). ∀(l : BitVec64). res108_growth(o,n,l) → res108_page(res108_next_capacity(o,n,l)))
}

example "law: retry advances fresh identity" {
    assert(∀(a : BitVec64). ∀(r : BitVec64). res108_retry(res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),a,r,res108_true()) → bvugt(res108_attempt(res108_true(),a),a))
}

example "law: retry decreases finite allowance" {
    assert(∀(a : BitVec64). ∀(r : BitVec64). res108_retry(res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),a,r,res108_true()) → bvult(res108_retries(res108_true(),r),r))
}

example "law: denied retry preserves identity" {
    assert(∀(a : BitVec64). res108_attempt(res108_false(),a)=a)
}

example "law: unreleased memory retains charges" {
    assert(∀(h : BitVec64). ∀(n : BitVec64). res108_refund(res108_false(),h,n)=h)
}

example "law: released bytes cannot underflow held charge" {
    assert(∀(n : BitVec64). ∀(h : BitVec64). res108_released(res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),n,h) → bvule(res108_refund(res108_true(),h,n),h))
}

example "law: stale attempt aliases fail" {
    assert(∀(j : BitVec64). ∀(a : BitVec64). ∀(b : BitVec64). ∀(o : BitVec64). ∀(g : BitVec64). ¬(a=b) → ¬res108_alias(j,a,o,j,b,o,g,g,res108_true(),res108_true()))
}

example "law: stale generation aliases fail" {
    assert(∀(j : BitVec64). ∀(a : BitVec64). ∀(o : BitVec64). ∀(g : BitVec64). ∀(h : BitVec64). ¬(g=h) → ¬res108_alias(j,a,o,j,a,o,g,h,res108_true(),res108_true()))
}

example "law: prefix copy cannot expose capacity tail" {
    assert(∀(n : BitVec64). ∀(c : BitVec64). ∀(k : BitVec64). res108_copy(n,c,k,res108_true()) → bvule(bvadd(c,k),n))
}

example "law: failed publication preserves epoch" {
    assert(∀(e : BitVec64). res108_epoch(res108_false(),e)=e)
}

example "law: new receipt preserves all previous keys" {
    assert(∀(k : BitVec64). ∀(q : BitVec64). ∀(old : BitVec64). ∀(new : BitVec64). ∀(ok : Bool). ¬(k=q) → (res108_receipt(ok,k,q,old,new)=old))
}

example "law: conditional canonical bytes equal" {
    assert(∀(a : BitVec8). ∀(b : BitVec8). ∀(c : BitVec8). (res108_canonical(a,c,res108_true(),res108_true()) ∧ res108_canonical(b,c,res108_true(),res108_true())) → (a=b))
}

example "law: fresh job identity never wraps" {
    assert(∀(a : BitVec64). ∀(b : BitVec64). res108_fresh(a,b) → bvugt(b,a))
}

example "law: protected record pair is aligned" {
    assert(∀(i : BitVec64). (bvand(res108_pair_offset(i),bvconst(15,64))=bvconst(0,64)))
}

example "law: declared record remains inside request" {
    assert(∀(i : BitVec64). ∀(n : BitVec64). ∀(m : BitVec64). ∀(t : BitVec64). (res108_header(bvconst(1094930994,64),bvconst(2,64),bvconst(128,64),n,m,bvconst(128,64),t,bvconst(128,64),bvconst(0,64)) ∧ bvult(i,n)) → bvule(bvadd(res108_record_offset(i),bvconst(128,64)),t))
}

// C2.3: trusted initialized overlays before FIRST publication. Immutable
// registry/Fabric rights must agree; this never seals an existing RW alias.
define res108_load_role(r : BitVec64) = (r=bvconst(1,64)) ∨ (r=bvconst(2,64)) ∨ (r=bvconst(3,64)) ∨ (r=bvconst(15,64)) ∨ (r=bvconst(16,64))
define res108_load_rights(r : BitVec64) = if (r=bvconst(1,64)) ∨ (r=bvconst(15,64)) then bvconst(1,64) else bvconst(3,64)
define res108_load_publish(role : BitVec64, logical : BitVec64, payload : BitVec64,
    reserved : Bool, full_zero : Bool, current_owner : Bool, private_drain : Bool,
    exact_overlay : Bool, authentic_cells : Bool) =
    res108_load_role(role) ∧ bvugt(logical,bvconst(0,64)) ∧ bvule(logical,heap108_signed_max()) ∧ bvule(payload,logical) ∧ reserved ∧ full_zero ∧ current_owner ∧ private_drain ∧ exact_overlay ∧ authentic_cells
define res108_loaded_access(rights : BitVec64, registry_rights : BitVec64, write : Bool, current : Bool) =
    (rights=registry_rights) ∧ ((rights=bvconst(1,64)) ∨ (rights=bvconst(3,64))) ∧ current ∧ (¬write ∨ (rights=bvconst(3,64)))
define res108_loader_entry(fresh : Bool, all_published : Bool, typed_request : Bool,
    typed_reply : Bool, exact_source : Bool, complete_roles : Bool) =
    fresh ∧ all_published ∧ typed_request ∧ typed_reply ∧ exact_source ∧ complete_roles

example "loader publication role 1" {
    assert(res108_load_publish(bvconst(1,64),bvconst(8,64),bvconst(3,64),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true()))
}

