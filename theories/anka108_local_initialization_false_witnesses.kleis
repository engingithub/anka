// Every assertion must be explicitly disproved by Z3; parse errors are not evidence.
import "anka108_local_initialization.kleis"

example "hostile local108_geometry accepts" {
    assert(¬(local108_geometry(bvconst(6144,64),bvconst(4096,64),bvconst(8192,64),bvconst(64,64),bvconst(16384,64),bvconst(65536,64))))
}

