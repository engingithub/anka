}

example "hostile local108_read accepts" {
    assert(¬(local108_read(local108_trace_issued(),repr107_handle(bvconst(3,64),bvconst(8,64)),bvconst(3,64),bvconst(8,64),bvconst(1,8),bvconst(3,64),bvconst(3,64),bvconst(8,64),bvconst(0,64),bvconst(1,64))))
}

example "local108_read admits not issued" {
    assert(local108_read(local108_false(),repr107_handle(bvconst(3,64),bvconst(8,64)),bvconst(3,64),bvconst(8,64),bvconst(1,8),bvconst(3,64),bvconst(3,64),bvconst(8,64),bvconst(0,64),bvconst(1,64)))
}

example "local108_read admits retired alias from prior occupant" {
    assert(local108_read(local108_trace_issued(),repr107_handle(bvconst(3,64),bvconst(7,64)),bvconst(3,64),bvconst(8,64),bvconst(1,8),bvconst(3,64),bvconst(3,64),bvconst(8,64),bvconst(0,64),bvconst(1,64)))
}

example "local108_read admits untagged numeric copy" {
    assert(local108_read(local108_trace_issued(),repr107_handle(bvconst(3,64),bvconst(8,64)),bvconst(3,64),bvconst(8,64),bvconst(0,8),bvconst(3,64),bvconst(3,64),bvconst(8,64),bvconst(0,64),bvconst(1,64)))
}

example "local108_read admits different domain" {
    assert(local108_read(local108_trace_issued(),repr107_handle(bvconst(3,64),bvconst(8,64)),bvconst(3,64),bvconst(8,64),bvconst(1,8),bvconst(3,64),bvconst(4,64),bvconst(8,64),bvconst(0,64),bvconst(1,64)))
}

example "local108_read admits one-past read" {
    assert(local108_read(local108_trace_issued(),repr107_handle(bvconst(3,64),bvconst(8,64)),bvconst(3,64),bvconst(8,64),bvconst(1,8),bvconst(3,64),bvconst(3,64),bvconst(8,64),bvconst(8,64),bvconst(1,64)))
}

example "local108_read admits wide access past local" {
    assert(local108_read(local108_trace_issued(),repr107_handle(bvconst(3,64),bvconst(8,64)),bvconst(3,64),bvconst(8,64),bvconst(1,8),bvconst(3,64),bvconst(3,64),bvconst(8,64),bvconst(7,64),bvconst(8,64)))
}

example "local108_read admits frame padding as local payload" {
    assert(local108_read(local108_trace_issued(),repr107_handle(bvconst(3,64),bvconst(8,64)),bvconst(3,64),bvconst(8,64),bvconst(1,8),bvconst(3,64),bvconst(3,64),bvconst(8,64),bvconst(32,64),bvconst(1,64)))
}

example "local108_read admits zero-width read" {
    assert(local108_read(local108_trace_issued(),repr107_handle(bvconst(3,64),bvconst(8,64)),bvconst(3,64),bvconst(8,64),bvconst(1,8),bvconst(3,64),bvconst(3,64),bvconst(8,64),bvconst(0,64),bvconst(0,64)))
}

example "hostile fresh valid local read returns zero" {
    assert(¬(local108_read(local108_trace_issued(),repr107_handle(bvconst(3,64),bvconst(8,64)),bvconst(3,64),bvconst(8,64),bvconst(1,8),bvconst(3,64),bvconst(3,64),bvconst(8,64),bvconst(0,64),bvconst(1,64)) ∧ (local108_trace_byte(bvconst(91,8),bvconst(18368,64))=bvconst(0,8))))
}

example "hostile same slot generation advances" {
    assert(¬(repr107_publish(bvconst(3,64),bvconst(7,64),bvconst(8,64),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8))))
}

example "hostile generation exhaustion cannot reuse" {
    assert(¬(¬(repr107_publish(bvconst(3,64),repr107_mask(),bvconst(0,64),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))))
}

example "hostile clean bytes cannot mint pointer kind" {
    assert(¬(local108_trace_tag(bvconst(0,8),bvconst(18384,64))=bvconst(0,8)))
}

example "hostile typed incoming pointer can be stored after clean entry" {
    assert(¬(local108_trace_issued() ∧ kind107_typed_storage(repr107_handle(bvconst(4,64),bvconst(8,64)),bvconst(0,64),bvconst(1,8),repr107_handle(bvconst(4,64),bvconst(8,64)),bvconst(0,64),bvconst(1,8),bvconst(16,64),bvconst(64,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8))))
}

example "hostile stale argument cannot get kind from zeroing" {
    assert(¬(¬(kind107_typed_storage(repr107_handle(bvconst(4,64),bvconst(8,64)),bvconst(0,64),bvconst(1,8),repr107_handle(bvconst(4,64),bvconst(8,64)),bvconst(0,64),bvconst(1,8),bvconst(16,64),bvconst(64,64),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))))
}

example "hostile event restore preserves argument words" {
    assert(¬(event107_word(bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(0,64),bvconst(0,64),bvconst(42,64),bvconst(0,64),bvconst(91,64))=bvconst(42,64)))
}

example "hostile event restore preserves pointer kind but not lifetime" {
    assert(¬(event107_tag(bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(0,8))=bvconst(1,8) ∧ ¬(repr107_lookup(repr107_handle(bvconst(3,64),bvconst(7,64)),bvconst(1,8),bvconst(3,64),bvconst(8,64),bvconst(1,8),bvconst(3,64),bvconst(3,64)))))
}
