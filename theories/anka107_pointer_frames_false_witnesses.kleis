example "FALSE all failed exits preserve allocation state" { assert(¬(∀(owner : BitVec64). ∀(retiring : BitVec64). ∀(old : BitVec8). frame107_alive(bvconst(0,8),owner,retiring,old)=old)) }

example "FALSE all parent allocations survive child exit" { assert(¬(∀(owner : BitVec64). ∀(retiring : BitVec64). ∀(old : BitVec8). ¬(owner=retiring) → (frame107_alive(bvconst(1,8),owner,retiring,old)=old))) }

example "FALSE all accepted frame bases stay in stack" { assert(¬(∀(cursor : BitVec64). ∀(low : BitVec64). ∀(high : BitVec64). ∀(size : BitVec64). frame107_enter(bvconst(7,64),bvconst(7,64),bvconst(3,64),bvconst(3,64),cursor,low,high,size,bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)) → (bvuge(frame107_base(cursor,size),low) ∧ bvule(frame107_base(cursor,size),cursor)))) }

example "FALSE all local intervals avoid arithmetic wrap" { assert(¬(∀(offset : BitVec64). ∀(length : BitVec64). ∀(size : BitVec64). frame107_local(offset,length,size,bvconst(1,64)) → (bvuge(bvadd(offset,length),offset) ∧ bvule(bvadd(offset,length),size)))) }
