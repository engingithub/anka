example "FALSE child exit preserves parent local" { assert(¬(frame107_alive(bvconst(1,8),bvconst(8,64),bvconst(9,64),bvconst(1,8))=bvconst(1,8))) }

example "FALSE failed exit preserves local" { assert(¬(frame107_alive(bvconst(0,8),bvconst(9,64),bvconst(9,64),bvconst(1,8))=bvconst(1,8))) }

example "FALSE cursor restored after retirement" { assert(¬(frame107_cursor(bvconst(1,8),bvconst(4096,64),bvconst(3968,64))=bvconst(4096,64))) }

example "FALSE failed exit preserves cursor" { assert(¬(frame107_cursor(bvconst(0,8),bvconst(4096,64),bvconst(3968,64))=bvconst(3968,64))) }

example "FALSE fresh generation reuse" { assert(¬(frame107_reuse(bvconst(1,8),bvconst(1,8),bvconst(1,8)))) }

example "FALSE reuse before retirement" { assert(¬(¬(frame107_reuse(bvconst(0,8),bvconst(1,8),bvconst(1,8))))) }

