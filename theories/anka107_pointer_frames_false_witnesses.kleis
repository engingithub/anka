// Deliberately false claims; every assertion must be explicitly disproved.
import "anka107_pointer_frames.kleis"

example "FALSE owned aligned frame reserves atomically" { assert(¬(frame107_enter(bvconst(7,64),bvconst(7,64),bvconst(3,64),bvconst(3,64),bvconst(4096,64),bvconst(1024,64),bvconst(8192,64),bvconst(128,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))) }

example "FALSE wrong context cannot enter" { assert(¬(¬(frame107_enter(bvconst(7,64),bvconst(8,64),bvconst(3,64),bvconst(3,64),bvconst(4096,64),bvconst(1024,64),bvconst(8192,64),bvconst(128,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8))))) }

example "FALSE wrong domain cannot enter" { assert(¬(¬(frame107_enter(bvconst(7,64),bvconst(7,64),bvconst(3,64),bvconst(4,64),bvconst(4096,64),bvconst(1024,64),bvconst(8192,64),bvconst(128,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8))))) }

