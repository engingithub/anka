example "FALSE unauthenticated manifest cannot enter" { assert(¬(¬(frame107_enter(bvconst(7,64),bvconst(7,64),bvconst(3,64),bvconst(3,64),bvconst(4096,64),bvconst(1024,64),bvconst(8192,64),bvconst(128,64),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8))))) }

example "FALSE wrong entry PC cannot enter" { assert(¬(¬(frame107_enter(bvconst(7,64),bvconst(7,64),bvconst(3,64),bvconst(3,64),bvconst(4096,64),bvconst(1024,64),bvconst(8192,64),bvconst(128,64),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8))))) }

example "FALSE duplicate activation cannot enter" { assert(¬(¬(frame107_enter(bvconst(7,64),bvconst(7,64),bvconst(3,64),bvconst(3,64),bvconst(4096,64),bvconst(1024,64),bvconst(8192,64),bvconst(128,64),bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8))))) }

