example "FALSE invalid alignment interval" { assert(¬(¬(frame107_local(bvconst(0,64),bvconst(16,64),bvconst(128,64),bvconst(3,64))))) }

example "FALSE adjacent slots" { assert(¬(frame107_disjoint(bvconst(0,64),bvconst(16,64),bvconst(16,64),bvconst(64,64)))) }

