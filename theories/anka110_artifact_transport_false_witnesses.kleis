import "anka110_artifact_transport.kleis"
example "hostile full slots" { assert(ag110_admit(bvconst(2,64),bvconst(2,64),bvconst(32768,64),bvconst(65536,64),bvconst(4265,64),bvconst(9,64),A109Valid)) }
example "hostile byte denial" { assert(ag110_admit(bvconst(1,64),bvconst(2,64),bvconst(32768,64),bvconst(65535,64),bvconst(4265,64),bvconst(9,64),A109Valid)) }
example "hostile used beyond limit" { assert(ag110_admit(bvconst(1,64),bvconst(2,64),bvconst(65537,64),bvconst(65536,64),bvconst(4265,64),bvconst(9,64),A109Valid)) }
example "hostile unfunded ingress" { assert(ag110_admit(bvconst(1,64),bvconst(2,64),bvconst(32768,64),bvconst(65536,64),bvconst(4264,64),bvconst(9,64),A109Valid)) }
example "hostile zero channel" { assert(ag110_admit(bvconst(1,64),bvconst(2,64),bvconst(32768,64),bvconst(65536,64),bvconst(4265,64),bvconst(0,64),A109Valid)) }
example "hostile unknown binder" { assert(ag110_admit(bvconst(1,64),bvconst(2,64),bvconst(32768,64),bvconst(65536,64),bvconst(4265,64),bvconst(9,64),A109Unknown)) }
example "hostile invalid binder" { assert(ag110_admit(bvconst(1,64),bvconst(2,64),bvconst(32768,64),bvconst(65536,64),bvconst(4265,64),bvconst(9,64),A109Invalid)) }
example "hostile no work" { assert(ag110_step(bvconst(0,64),bvconst(99,64),bvconst(100,64))) }
example "hostile deadline reached" { assert(ag110_step(bvconst(2,64),bvconst(100,64),bvconst(100,64))) }
example "hostile deadline past" { assert(ag110_step(bvconst(2,64),bvconst(101,64),bvconst(100,64))) }
example "hostile reading cannot dispatch" { assert(ag110_dispatch(bvconst(0,64),as110_true(),bvconst(168,64),as110_true(),as110_true(),A109Valid)) }
example "hostile sending cannot redispatch" { assert(ag110_dispatch(bvconst(2,64),as110_true(),bvconst(168,64),as110_true(),as110_true(),A109Valid)) }
example "hostile closed cannot dispatch" { assert(ag110_dispatch(bvconst(3,64),as110_true(),bvconst(168,64),as110_true(),as110_true(),A109Valid)) }
example "hostile missing EOF" { assert(ag110_dispatch(bvconst(1,64),as110_false(),bvconst(168,64),as110_true(),as110_true(),A109Valid)) }
example "hostile short frame" { assert(ag110_dispatch(bvconst(1,64),as110_true(),bvconst(167,64),as110_true(),as110_true(),A109Valid)) }
example "hostile extra byte" { assert(ag110_dispatch(bvconst(1,64),as110_true(),bvconst(4265,64),as110_true(),as110_true(),A109Valid)) }
example "hostile bad canonical" { assert(ag110_dispatch(bvconst(1,64),as110_true(),bvconst(168,64),as110_false(),as110_true(),A109Valid)) }
example "hostile no lane" { assert(ag110_dispatch(bvconst(1,64),as110_true(),bvconst(168,64),as110_true(),as110_false(),A109Valid)) }
example "hostile unknown dispatch authority" { assert(ag110_dispatch(bvconst(1,64),as110_true(),bvconst(168,64),as110_true(),as110_true(),A109Unknown)) }
example "hostile wrong write phase" { assert(ag110_disclose(bvconst(1,64),bvconst(64,64),bvconst(300,64),bvconst(64,64),as110_true(),as110_true(),as110_true(),A109Valid,A109Valid)) }
example "hostile overrun prefix" { assert(ag110_disclose(bvconst(2,64),bvconst(301,64),bvconst(300,64),bvconst(64,64),as110_true(),as110_true(),as110_true(),A109Valid,A109Valid)) }
example "hostile zero write" { assert(ag110_disclose(bvconst(2,64),bvconst(64,64),bvconst(300,64),bvconst(0,64),as110_true(),as110_true(),as110_true(),A109Valid,A109Valid)) }
example "hostile oversize write" { assert(ag110_disclose(bvconst(2,64),bvconst(64,64),bvconst(300,64),bvconst(65,64),as110_true(),as110_true(),as110_true(),A109Valid,A109Valid)) }
example "hostile suffix overrun" { assert(ag110_disclose(bvconst(2,64),bvconst(299,64),bvconst(300,64),bvconst(64,64),as110_true(),as110_true(),as110_true(),A109Valid,A109Valid)) }
example "hostile write outside lane" { assert(ag110_disclose(bvconst(2,64),bvconst(64,64),bvconst(300,64),bvconst(64,64),as110_false(),as110_true(),as110_true(),A109Valid,A109Valid)) }
example "hostile retargeted caller" { assert(ag110_disclose(bvconst(2,64),bvconst(64,64),bvconst(300,64),bvconst(64,64),as110_true(),as110_false(),as110_true(),A109Valid,A109Valid)) }
example "hostile stale ticket" { assert(ag110_disclose(bvconst(2,64),bvconst(64,64),bvconst(300,64),bvconst(64,64),as110_true(),as110_true(),as110_false(),A109Valid,A109Valid)) }
example "hostile revoked channel" { assert(ag110_disclose(bvconst(2,64),bvconst(64,64),bvconst(300,64),bvconst(64,64),as110_true(),as110_true(),as110_true(),A109Invalid,A109Valid)) }
example "hostile revoked grant" { assert(ag110_disclose(bvconst(2,64),bvconst(64,64),bvconst(300,64),bvconst(64,64),as110_true(),as110_true(),as110_true(),A109Valid,A109Invalid)) }
example "hostile prefix advances without write" { assert(ag110_transient(bvconst(64,64),bvconst(65,64),bvconst(9,64),bvconst(8,64))) }
example "hostile work replenished" { assert(ag110_transient(bvconst(64,64),bvconst(64,64),bvconst(9,64),bvconst(10,64))) }
example "hostile busy free work" { assert(ag110_transient(bvconst(64,64),bvconst(64,64),bvconst(9,64),bvconst(9,64))) }
example "hostile unreserved refund" { assert(ag110_close(as110_false(),as110_true(),as110_true(),as110_true(),as110_true())) }
example "hostile refund omitted" { assert(ag110_close(as110_true(),as110_false(),as110_true(),as110_true(),as110_true())) }
example "hostile socket retained" { assert(ag110_close(as110_true(),as110_true(),as110_false(),as110_true(),as110_true())) }
example "hostile bytes retained" { assert(ag110_close(as110_true(),as110_true(),as110_true(),as110_false(),as110_true())) }
example "hostile commit rolled back" { assert(ag110_close(as110_true(),as110_true(),as110_true(),as110_true(),as110_false())) }
example "hostile channel reuse" { assert(ag110_next(bvconst(4,64),bvconst(4,64))) }
example "hostile channel wrap" { assert(ag110_next(a109_max(),a109_z())) }
example "hostile double refund denied" { assert(ag110_refund(bvconst(1,64),bvconst(0,64),bvconst(32768,64),bvconst(0,64),bvconst(100,64),bvconst(100,64),as110_false())) }
example "hostile peer slot refund denied" { assert(ag110_refund(bvconst(2,64),bvconst(0,64),bvconst(65536,64),bvconst(0,64),bvconst(100,64),bvconst(100,64),as110_true())) }
example "hostile ingress refill denied" { assert(ag110_refund(bvconst(2,64),bvconst(1,64),bvconst(65536,64),bvconst(32768,64),bvconst(100,64),bvconst(4365,64),as110_true())) }
