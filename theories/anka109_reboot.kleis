// T2 boot admission after durable reservation. No cryptographic primitive chosen.
// Trusted freshness evidence binds the current installation, policy, durable head
// and a new boot-attempt challenge. Challenge uniqueness across reboot/snapshot
// restore is an external assumption; replay resistance is conditional upon it.
// A record reservation is not execution. Current artifact admission is a trusted
// result bound to the exact selected artifact/profile/provenance (T4 refinement).
import "anka109_persistence.kleis"
import "anka109_enrollment.kleis"
define b109_admit(c : A109Context,s : P109State,r : P109Request,a : P109Access,e : A109Enrollment,head : BitVec64,boot : BitVec64,fresh : A109Verdict,artifact : A109Verdict,active : Bool) =
    p109_replay(c,s,r,a) ∧ (pr_kind(r)=bvconst(2,64)) ∧
    enr_enrolled(e) ∧ a109_nonzero(enr_revision(e)) ∧ a109_nonzero(enr_person(e)) ∧
    (enr_anchor(e)=ctx_anchor(c)) ∧ (enr_installation(e)=ctx_installation(c)) ∧
    (ps_revision(s)=head) ∧ (ps_boot(s)=boot) ∧ a109_nonzero(boot) ∧
    a109_nonzero(ctx_challenge(c)) ∧ (pr_attempt(r)=ctx_challenge(c)) ∧
    (ps_value(s)=pr_argument(r)) ∧ a109_nonzero(ps_value(s)) ∧
    (fresh=A109Valid) ∧ (artifact=A109Valid) ∧ ¬active
define b109_step(c : A109Context,s : P109State,r : P109Request,a : P109Access,e : A109Enrollment,head : BitVec64,boot : BitVec64,fresh : A109Verdict,artifact : A109Verdict,active : Bool,next_active : Bool) =
    next_active = (active ∨ b109_admit(c,s,r,a,e,head,boot,fresh,artifact,active))
// Crash destroys volatile execution authority. Durable reservation survives;
// next boot must have a fresh external challenge and a newly reserved incarnation.
define b109_crash(next_active : Bool) = ¬next_active
define b109_context(active : Bool,current_boot : BitVec64,saved_boot : BitVec64) =
    active ∧ a109_nonzero(current_boot) ∧ (current_boot=saved_boot)
example "current reserved boot admitted" { assert(b109_admit(A109Context(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(71,64),bvconst(100,64),(bvconst(1,8)=bvconst(1,8))),P109State(bvconst(8,64),bvconst(55,64),bvconst(9,64),bvconst(1,64),bvconst(30,64),bvconst(4,64),bvconst(2,64),bvconst(7,64),bvconst(55,64),bvconst(71,64),bvconst(10,64),bvconst(20,64),bvconst(3,64)),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(2,64),bvconst(55,64),bvconst(71,64)),P109Access(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(2,64),bvconst(90,64),bvconst(110,64),A109Valid,A109Valid),A109Enrollment(bvconst(10,64),bvconst(20,64),bvconst(30,64),bvconst(1,64),(bvconst(1,8)=bvconst(1,8))),bvconst(8,64),bvconst(9,64),A109Valid,A109Valid,(bvconst(1,8)=bvconst(0,8)))) }
