example "reject foreign enrollment" { assert(¬(b109_admit(A109Context(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(71,64),bvconst(100,64),(bvconst(1,8)=bvconst(1,8))),P109State(bvconst(8,64),bvconst(55,64),bvconst(9,64),bvconst(1,64),bvconst(30,64),bvconst(4,64),bvconst(2,64),bvconst(7,64),bvconst(55,64),bvconst(71,64),bvconst(10,64),bvconst(20,64),bvconst(3,64)),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(2,64),bvconst(55,64),bvconst(71,64)),P109Access(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(2,64),bvconst(90,64),bvconst(110,64),A109Valid,A109Valid),A109Enrollment(bvconst(10,64),bvconst(21,64),bvconst(30,64),bvconst(1,64),(bvconst(1,8)=bvconst(1,8))),bvconst(8,64),bvconst(9,64),A109Valid,A109Valid,(bvconst(1,8)=bvconst(0,8))))) }
example "saved prior context rejected" { assert(¬b109_context((bvconst(1,8)=bvconst(1,8)),bvconst(9,64),bvconst(8,64))) }
example "current context accepted" { assert(b109_context((bvconst(1,8)=bvconst(1,8)),bvconst(9,64),bvconst(9,64))) }
example "crash drops active state" { assert(b109_crash((bvconst(1,8)=bvconst(0,8)))) }
example "crash cannot keep active state" { assert(¬b109_crash((bvconst(1,8)=bvconst(1,8)))) }
example "stopped context denied" { assert(¬b109_context((bvconst(1,8)=bvconst(0,8)),bvconst(9,64),bvconst(9,64))) }
example "law: stale execution incarnation always rejected" { assert(∀ active : Bool . ∀ current : BitVec64 . ∀ saved : BitVec64 . (current ≠ saved) ⟹ ¬b109_context(active,current,saved)) }
example "law: crash never restores authority" { assert(∀ active : Bool . b109_crash(active) ⟹ ¬active) }
example "law: boot admission requires current attempt" { assert(∀ c_anchor : BitVec64 . ∀ c_installation : BitVec64 . ∀ c_epoch : BitVec64 . ∀ c_challenge : BitVec64 . ∀ c_now : BitVec64 . ∀ c_selected : Bool . ∀ s_revision : BitVec64 . ∀ s_value : BitVec64 . ∀ s_boot : BitVec64 . ∀ s_sequence : BitVec64 . ∀ s_caller : BitVec64 . ∀ s_incarnation : BitVec64 . ∀ s_kind : BitVec64 . ∀ s_expected : BitVec64 . ∀ s_argument : BitVec64 . ∀ s_attempt : BitVec64 . ∀ s_anchor : BitVec64 . ∀ s_installation : BitVec64 . ∀ s_policy : BitVec64 . ∀ r_anchor : BitVec64 . ∀ r_installation : BitVec64 . ∀ r_policy : BitVec64 . ∀ r_caller : BitVec64 . ∀ r_incarnation : BitVec64 . ∀ r_sequence : BitVec64 . ∀ r_expected : BitVec64 . ∀ r_kind : BitVec64 . ∀ r_argument : BitVec64 . ∀ r_attempt : BitVec64 . ∀ a_anchor : BitVec64 . ∀ a_installation : BitVec64 . ∀ a_policy : BitVec64 . ∀ a_caller : BitVec64 . ∀ a_incarnation : BitVec64 . ∀ a_kind : BitVec64 . ∀ a_first : BitVec64 . ∀ a_until : BitVec64 . ∀ a_authentic : A109Verdict . ∀ a_status : A109Verdict . ∀ t_revision : BitVec64 . ∀ t_value : BitVec64 . ∀ t_boot : BitVec64 . ∀ t_sequence : BitVec64 . ∀ t_caller : BitVec64 . ∀ t_incarnation : BitVec64 . ∀ t_kind : BitVec64 . ∀ t_expected : BitVec64 . ∀ t_argument : BitVec64 . ∀ t_attempt : BitVec64 . ∀ t_anchor : BitVec64 . ∀ t_installation : BitVec64 . ∀ t_policy : BitVec64 . ∀ e_anchor : BitVec64 . ∀ e_installation : BitVec64 . ∀ e_person : BitVec64 . ∀ e_revision : BitVec64 . ∀ e_enrolled : Bool . ∀ head : BitVec64 . ∀ boot : BitVec64 . ∀ fresh : A109Verdict . ∀ artifact : A109Verdict . ∀ active : Bool . b109_admit(A109Context(c_anchor,c_installation,c_epoch,c_challenge,c_now,c_selected),P109State(s_revision,s_value,s_boot,s_sequence,s_caller,s_incarnation,s_kind,s_expected,s_argument,s_attempt,s_anchor,s_installation,s_policy),P109Request(r_anchor,r_installation,r_policy,r_caller,r_incarnation,r_sequence,r_expected,r_kind,r_argument,r_attempt),P109Access(a_anchor,a_installation,a_policy,a_caller,a_incarnation,a_kind,a_first,a_until,a_authentic,a_status),A109Enrollment(e_anchor,e_installation,e_person,e_revision,e_enrolled),head,boot,fresh,artifact,active) ⟹ (r_attempt=c_challenge)) }
example "law: boot admission requires enrollment" { assert(∀ c_anchor : BitVec64 . ∀ c_installation : BitVec64 . ∀ c_epoch : BitVec64 . ∀ c_challenge : BitVec64 . ∀ c_now : BitVec64 . ∀ c_selected : Bool . ∀ s_revision : BitVec64 . ∀ s_value : BitVec64 . ∀ s_boot : BitVec64 . ∀ s_sequence : BitVec64 . ∀ s_caller : BitVec64 . ∀ s_incarnation : BitVec64 . ∀ s_kind : BitVec64 . ∀ s_expected : BitVec64 . ∀ s_argument : BitVec64 . ∀ s_attempt : BitVec64 . ∀ s_anchor : BitVec64 . ∀ s_installation : BitVec64 . ∀ s_policy : BitVec64 . ∀ r_anchor : BitVec64 . ∀ r_installation : BitVec64 . ∀ r_policy : BitVec64 . ∀ r_caller : BitVec64 . ∀ r_incarnation : BitVec64 . ∀ r_sequence : BitVec64 . ∀ r_expected : BitVec64 . ∀ r_kind : BitVec64 . ∀ r_argument : BitVec64 . ∀ r_attempt : BitVec64 . ∀ a_anchor : BitVec64 . ∀ a_installation : BitVec64 . ∀ a_policy : BitVec64 . ∀ a_caller : BitVec64 . ∀ a_incarnation : BitVec64 . ∀ a_kind : BitVec64 . ∀ a_first : BitVec64 . ∀ a_until : BitVec64 . ∀ a_authentic : A109Verdict . ∀ a_status : A109Verdict . ∀ t_revision : BitVec64 . ∀ t_value : BitVec64 . ∀ t_boot : BitVec64 . ∀ t_sequence : BitVec64 . ∀ t_caller : BitVec64 . ∀ t_incarnation : BitVec64 . ∀ t_kind : BitVec64 . ∀ t_expected : BitVec64 . ∀ t_argument : BitVec64 . ∀ t_attempt : BitVec64 . ∀ t_anchor : BitVec64 . ∀ t_installation : BitVec64 . ∀ t_policy : BitVec64 . ∀ e_anchor : BitVec64 . ∀ e_installation : BitVec64 . ∀ e_person : BitVec64 . ∀ e_revision : BitVec64 . ∀ e_enrolled : Bool . ∀ head : BitVec64 . ∀ boot : BitVec64 . ∀ fresh : A109Verdict . ∀ artifact : A109Verdict . ∀ active : Bool . b109_admit(A109Context(c_anchor,c_installation,c_epoch,c_challenge,c_now,c_selected),P109State(s_revision,s_value,s_boot,s_sequence,s_caller,s_incarnation,s_kind,s_expected,s_argument,s_attempt,s_anchor,s_installation,s_policy),P109Request(r_anchor,r_installation,r_policy,r_caller,r_incarnation,r_sequence,r_expected,r_kind,r_argument,r_attempt),P109Access(a_anchor,a_installation,a_policy,a_caller,a_incarnation,a_kind,a_first,a_until,a_authentic,a_status),A109Enrollment(e_anchor,e_installation,e_person,e_revision,e_enrolled),head,boot,fresh,artifact,active) ⟹ e_enrolled) }
example "law: boot admission requires positive fresh durable incarnation" { assert(∀ c_anchor : BitVec64 . ∀ c_installation : BitVec64 . ∀ c_epoch : BitVec64 . ∀ c_challenge : BitVec64 . ∀ c_now : BitVec64 . ∀ c_selected : Bool . ∀ s_revision : BitVec64 . ∀ s_value : BitVec64 . ∀ s_boot : BitVec64 . ∀ s_sequence : BitVec64 . ∀ s_caller : BitVec64 . ∀ s_incarnation : BitVec64 . ∀ s_kind : BitVec64 . ∀ s_expected : BitVec64 . ∀ s_argument : BitVec64 . ∀ s_attempt : BitVec64 . ∀ s_anchor : BitVec64 . ∀ s_installation : BitVec64 . ∀ s_policy : BitVec64 . ∀ r_anchor : BitVec64 . ∀ r_installation : BitVec64 . ∀ r_policy : BitVec64 . ∀ r_caller : BitVec64 . ∀ r_incarnation : BitVec64 . ∀ r_sequence : BitVec64 . ∀ r_expected : BitVec64 . ∀ r_kind : BitVec64 . ∀ r_argument : BitVec64 . ∀ r_attempt : BitVec64 . ∀ a_anchor : BitVec64 . ∀ a_installation : BitVec64 . ∀ a_policy : BitVec64 . ∀ a_caller : BitVec64 . ∀ a_incarnation : BitVec64 . ∀ a_kind : BitVec64 . ∀ a_first : BitVec64 . ∀ a_until : BitVec64 . ∀ a_authentic : A109Verdict . ∀ a_status : A109Verdict . ∀ t_revision : BitVec64 . ∀ t_value : BitVec64 . ∀ t_boot : BitVec64 . ∀ t_sequence : BitVec64 . ∀ t_caller : BitVec64 . ∀ t_incarnation : BitVec64 . ∀ t_kind : BitVec64 . ∀ t_expected : BitVec64 . ∀ t_argument : BitVec64 . ∀ t_attempt : BitVec64 . ∀ t_anchor : BitVec64 . ∀ t_installation : BitVec64 . ∀ t_policy : BitVec64 . ∀ e_anchor : BitVec64 . ∀ e_installation : BitVec64 . ∀ e_person : BitVec64 . ∀ e_revision : BitVec64 . ∀ e_enrolled : Bool . ∀ head : BitVec64 . ∀ boot : BitVec64 . ∀ fresh : A109Verdict . ∀ artifact : A109Verdict . ∀ active : Bool . b109_admit(A109Context(c_anchor,c_installation,c_epoch,c_challenge,c_now,c_selected),P109State(s_revision,s_value,s_boot,s_sequence,s_caller,s_incarnation,s_kind,s_expected,s_argument,s_attempt,s_anchor,s_installation,s_policy),P109Request(r_anchor,r_installation,r_policy,r_caller,r_incarnation,r_sequence,r_expected,r_kind,r_argument,r_attempt),P109Access(a_anchor,a_installation,a_policy,a_caller,a_incarnation,a_kind,a_first,a_until,a_authentic,a_status),A109Enrollment(e_anchor,e_installation,e_person,e_revision,e_enrolled),head,boot,fresh,artifact,active) ⟹ (bvugt(boot,a109_z()) ∧ (s_boot=boot) ∧ (s_revision=head) ∧ (fresh=A109Valid))) }
example "law: boot admission cannot repeat while active" { assert(∀ c_anchor : BitVec64 . ∀ c_installation : BitVec64 . ∀ c_epoch : BitVec64 . ∀ c_challenge : BitVec64 . ∀ c_now : BitVec64 . ∀ c_selected : Bool . ∀ s_revision : BitVec64 . ∀ s_value : BitVec64 . ∀ s_boot : BitVec64 . ∀ s_sequence : BitVec64 . ∀ s_caller : BitVec64 . ∀ s_incarnation : BitVec64 . ∀ s_kind : BitVec64 . ∀ s_expected : BitVec64 . ∀ s_argument : BitVec64 . ∀ s_attempt : BitVec64 . ∀ s_anchor : BitVec64 . ∀ s_installation : BitVec64 . ∀ s_policy : BitVec64 . ∀ r_anchor : BitVec64 . ∀ r_installation : BitVec64 . ∀ r_policy : BitVec64 . ∀ r_caller : BitVec64 . ∀ r_incarnation : BitVec64 . ∀ r_sequence : BitVec64 . ∀ r_expected : BitVec64 . ∀ r_kind : BitVec64 . ∀ r_argument : BitVec64 . ∀ r_attempt : BitVec64 . ∀ a_anchor : BitVec64 . ∀ a_installation : BitVec64 . ∀ a_policy : BitVec64 . ∀ a_caller : BitVec64 . ∀ a_incarnation : BitVec64 . ∀ a_kind : BitVec64 . ∀ a_first : BitVec64 . ∀ a_until : BitVec64 . ∀ a_authentic : A109Verdict . ∀ a_status : A109Verdict . ∀ t_revision : BitVec64 . ∀ t_value : BitVec64 . ∀ t_boot : BitVec64 . ∀ t_sequence : BitVec64 . ∀ t_caller : BitVec64 . ∀ t_incarnation : BitVec64 . ∀ t_kind : BitVec64 . ∀ t_expected : BitVec64 . ∀ t_argument : BitVec64 . ∀ t_attempt : BitVec64 . ∀ t_anchor : BitVec64 . ∀ t_installation : BitVec64 . ∀ t_policy : BitVec64 . ∀ e_anchor : BitVec64 . ∀ e_installation : BitVec64 . ∀ e_person : BitVec64 . ∀ e_revision : BitVec64 . ∀ e_enrolled : Bool . ∀ head : BitVec64 . ∀ boot : BitVec64 . ∀ fresh : A109Verdict . ∀ artifact : A109Verdict . ∀ active : Bool . b109_admit(A109Context(c_anchor,c_installation,c_epoch,c_challenge,c_now,c_selected),P109State(s_revision,s_value,s_boot,s_sequence,s_caller,s_incarnation,s_kind,s_expected,s_argument,s_attempt,s_anchor,s_installation,s_policy),P109Request(r_anchor,r_installation,r_policy,r_caller,r_incarnation,r_sequence,r_expected,r_kind,r_argument,r_attempt),P109Access(a_anchor,a_installation,a_policy,a_caller,a_incarnation,a_kind,a_first,a_until,a_authentic,a_status),A109Enrollment(e_anchor,e_installation,e_person,e_revision,e_enrolled),head,boot,fresh,artifact,active) ⟹ ¬active) }
