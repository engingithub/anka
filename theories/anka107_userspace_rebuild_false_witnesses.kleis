// Deliberately false assertions; every one must be explicitly disproved.
import "anka107_userspace_rebuild.kleis"

example "FALSE-P107-2 accept unverified fixed point" {
    assert(rebuild107_producer_valid(false,bvconst(7,64),bvconst(7,64),bvconst(3,64),bvconst(3,64),true,true,true)=true)
}

example "FALSE-P107-3 accept different compiler object" {
    assert(rebuild107_producer_valid(true,bvconst(7,64),bvconst(8,64),bvconst(3,64),bvconst(3,64),true,true,true)=true)
}

example "FALSE-P107-4 accept stale compiler generation" {
