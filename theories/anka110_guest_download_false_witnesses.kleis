// Every deliberately false claim must be explicitly DISPROVED by Z3.
import "anka110_guest_download.kleis"
example "hostile owner one byte short" { assert(gd110_quota(bvconst(14032,64),bvconst(8192,64),bvconst(40,64),bvconst(22263,64),bvconst(80,64),bvconst(22304,64))) }
example "hostile global one byte short" { assert(gd110_quota(bvconst(14032,64),bvconst(8192,64),bvconst(40,64),bvconst(22264,64),bvconst(80,64),bvconst(22303,64))) }
example "hostile other owner consumes allowance" { assert(gd110_quota(bvconst(14032,64),bvconst(8192,64),bvconst(41,64),bvconst(22264,64),bvconst(80,64),bvconst(22304,64))) }
example "hostile peer consumes global allowance" { assert(gd110_quota(bvconst(14032,64),bvconst(8192,64),bvconst(40,64),bvconst(22264,64),bvconst(81,64),bvconst(22304,64))) }
example "hostile private zero" { assert(gd110_quota(bvconst(0,64),bvconst(8192,64),bvconst(40,64),bvconst(22264,64),bvconst(80,64),bvconst(22304,64))) }
