example "hostile scratch wrap" { assert(gd110_quota(bvconst(14032,64),a109_max(),bvconst(40,64),bvconst(22264,64),bvconst(80,64),bvconst(22304,64))) }
example "hostile request lacks overlength byte" { assert(gd110_buffers(bvconst(7026,64),bvconst(168,64),bvconst(4297,64),bvconst(512,64),bvconst(2048,64))) }
example "hostile reply lacks overlength byte" { assert(gd110_buffers(bvconst(7026,64),bvconst(169,64),bvconst(4296,64),bvconst(512,64),bvconst(2048,64))) }
example "hostile scratch short" { assert(gd110_buffers(bvconst(7025,64),bvconst(169,64),bvconst(4297,64),bvconst(512,64),bvconst(2048,64))) }
example "hostile queues undercounted" { assert(gd110_buffers(bvconst(7026,64),bvconst(169,64),bvconst(4297,64),bvconst(512,64),bvconst(2049,64))) }
