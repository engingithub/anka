example "law: every different connection rejects the old evidence" {
    assert(∀ other : BitVec64 . ¬(other=bvconst(6,64)) ⟹ ¬(v110_verified(A109Context(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(71,64),bvconst(100,64),(bvconst(1,8)=bvconst(1,8))),
        E110Observation(bvconst(5,64),other,bvconst(7,64),bvconst(40,64),bvconst(30,64),bvconst(1,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(9,64),bvconst(71,64),(bvconst(1,8)=bvconst(1,8)),A109Valid),
        V110Credential(bvconst(27,64),bvconst(10,64),bvconst(30,64),bvconst(1,64),bvconst(20,64),bvconst(3,64),bvconst(88,64),bvconst(90,64),bvconst(110,64),A109Valid),
        V110Status(bvconst(27,64),bvconst(10,64),bvconst(3,64),bvconst(9,64),bvconst(96,64),bvconst(105,64),A109Valid),
        V110Possession(bvconst(10,64),bvconst(27,64),bvconst(88,64),bvconst(5,64),bvconst(6,64),bvconst(7,64),bvconst(40,64),bvconst(30,64),bvconst(1,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(9,64),bvconst(71,64),A109Valid))))
}
example "law: every different status serial rejects the old evidence" {
    assert(∀ other : BitVec64 . ¬(other=bvconst(9,64)) ⟹ ¬(v110_verified(A109Context(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(71,64),bvconst(100,64),(bvconst(1,8)=bvconst(1,8))),
        E110Observation(bvconst(5,64),bvconst(6,64),bvconst(7,64),bvconst(40,64),bvconst(30,64),bvconst(1,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(9,64),bvconst(71,64),(bvconst(1,8)=bvconst(1,8)),A109Valid),
        V110Credential(bvconst(27,64),bvconst(10,64),bvconst(30,64),bvconst(1,64),bvconst(20,64),bvconst(3,64),bvconst(88,64),bvconst(90,64),bvconst(110,64),A109Valid),
        V110Status(bvconst(27,64),bvconst(10,64),bvconst(3,64),other,bvconst(96,64),bvconst(105,64),A109Valid),
        V110Possession(bvconst(10,64),bvconst(27,64),bvconst(88,64),bvconst(5,64),bvconst(6,64),bvconst(7,64),bvconst(40,64),bvconst(30,64),bvconst(1,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(9,64),bvconst(71,64),A109Valid))))
}
