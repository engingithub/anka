    assert(¬(cw108_finish(a23_true(),a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),bvconst(2,64),bvconst(0,64),bvconst(41,64),bvconst(1,8),bvconst(1,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8))))
}

example "finish old work: rejects zero operation" {
    assert(¬(cw108_finish(a23_true(),a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),bvconst(2,64),bvconst(9,64),bvconst(0,64),bvconst(1,8),bvconst(1,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8))))
}

example "finish old work: rejects counter underflow" {
    assert(¬(cw108_finish(a23_true(),a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),bvconst(2,64),bvconst(9,64),bvconst(41,64),bvconst(1,8),bvconst(0,64),bvconst(0,64),ptr107_max(),bvconst(0,64),bvconst(1,8),bvconst(1,8))))
}

example "finish old work: rejects wrong decrement" {
    assert(¬(cw108_finish(a23_true(),a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),bvconst(2,64),bvconst(9,64),bvconst(41,64),bvconst(1,8),bvconst(1,64),bvconst(0,64),bvconst(1,64),bvconst(0,64),bvconst(1,8),bvconst(1,8))))
}

example "finish old work: rejects unknown class" {
    assert(¬(cw108_finish(a23_true(),a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),bvconst(2,64),bvconst(9,64),bvconst(41,64),bvconst(3,8),bvconst(1,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8))))
}

example "finish old work: rejects CPU completion altering DMA" {
    assert(¬(cw108_finish(a23_true(),a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),bvconst(2,64),bvconst(9,64),bvconst(41,64),bvconst(1,8),bvconst(1,64),bvconst(1,64),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8))))
}

example "finish old work: rejects DMA completion consuming CPU" {
    assert(¬(cw108_finish(a23_true(),a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),bvconst(2,64),bvconst(9,64),bvconst(41,64),bvconst(2,8),bvconst(1,64),bvconst(1,64),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(1,8))))
}

example "finish old work: rejects duplicate completion" {
    assert(¬(cw108_finish(a23_true(),a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),bvconst(2,64),bvconst(9,64),bvconst(41,64),bvconst(1,8),bvconst(1,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(1,8))))
}

example "finish old work: rejects unlocked completion" {
    assert(¬(cw108_finish(a23_true(),a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),bvconst(2,64),bvconst(9,64),bvconst(41,64),bvconst(1,8),bvconst(1,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(0,8))))
}

example "drain readiness: valid" {
    assert(cw108_ready(a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),a23_true(),bvconst(0,64),bvconst(0,64),bvconst(0,64),a23_true(),a23_true(),a23_true(),bvconst(1,8)))
}

example "drain readiness: rejects foreign job" {
    assert(¬(cw108_ready(a23_false(),a23_true(),bvconst(3,8),bvconst(1,8),a23_true(),bvconst(0,64),bvconst(0,64),bvconst(0,64),a23_true(),a23_true(),a23_true(),bvconst(1,8))))
}

example "drain readiness: rejects dead worker lease" {
    assert(¬(cw108_ready(a23_true(),a23_false(),bvconst(3,8),bvconst(1,8),a23_true(),bvconst(0,64),bvconst(0,64),bvconst(0,64),a23_true(),a23_true(),a23_true(),bvconst(1,8))))
}

example "drain readiness: rejects live heap" {
    assert(¬(cw108_ready(a23_true(),a23_true(),bvconst(2,8),bvconst(1,8),a23_true(),bvconst(0,64),bvconst(0,64),bvconst(0,64),a23_true(),a23_true(),a23_true(),bvconst(1,8))))
}

example "drain readiness: rejects wrong job stage" {
    assert(¬(cw108_ready(a23_true(),a23_true(),bvconst(3,8),bvconst(2,8),a23_true(),bvconst(0,64),bvconst(0,64),bvconst(0,64),a23_true(),a23_true(),a23_true(),bvconst(1,8))))
}

example "drain readiness: rejects incomplete or stale census" {
    assert(¬(cw108_ready(a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),a23_false(),bvconst(0,64),bvconst(0,64),bvconst(0,64),a23_true(),a23_true(),a23_true(),bvconst(1,8))))
}

example "drain readiness: rejects CPU work outstanding" {
    assert(¬(cw108_ready(a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),a23_true(),bvconst(1,64),bvconst(0,64),bvconst(0,64),a23_true(),a23_true(),a23_true(),bvconst(1,8))))
}

example "drain readiness: rejects DMA work outstanding" {
    assert(¬(cw108_ready(a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),a23_true(),bvconst(0,64),bvconst(1,64),bvconst(0,64),a23_true(),a23_true(),a23_true(),bvconst(1,8))))
}

example "drain readiness: rejects unregistered source conflict" {
    assert(¬(cw108_ready(a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),a23_true(),bvconst(0,64),bvconst(0,64),bvconst(1,64),a23_true(),a23_true(),a23_true(),bvconst(1,8))))
}

example "drain readiness: rejects open admission path" {
    assert(¬(cw108_ready(a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),a23_true(),bvconst(0,64),bvconst(0,64),bvconst(0,64),a23_false(),a23_true(),a23_true(),bvconst(1,8))))
}

example "drain readiness: rejects invisible old effects" {
    assert(¬(cw108_ready(a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),a23_true(),bvconst(0,64),bvconst(0,64),bvconst(0,64),a23_true(),a23_false(),a23_true(),bvconst(1,8))))
}

example "drain readiness: rejects lost custody" {
    assert(¬(cw108_ready(a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),a23_true(),bvconst(0,64),bvconst(0,64),bvconst(0,64),a23_true(),a23_true(),a23_false(),bvconst(1,8))))
}

example "drain readiness: rejects unlocked observation" {
    assert(¬(cw108_ready(a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),a23_true(),bvconst(0,64),bvconst(0,64),bvconst(0,64),a23_true(),a23_true(),a23_true(),bvconst(0,8))))
}

example "trace: all three admissions" {
    assert(cw108_trace_cpu_submit() ∧ cw108_trace_dma_submit() ∧ cw108_trace_b_submit())
}

example "trace: claim while old work remains" {
    assert(cw108_trace_claim() ∧ (cw108_trace_cpu_count()=bvconst(1,64)) ∧ (cw108_trace_dma_count()=bvconst(1,64)))
}

example "trace: exact terminal CPU consumed" {
    assert(cw108_trace_cpu_finish() ∧ (cw108_trace_cpu_after()=bvconst(0,64)))
}

example "trace: faulted DMA requires real terminal fencing" {
    assert(cw108_trace_dma_finish() ∧ (cw108_trace_dma_after()=bvconst(0,64)))
}

example "trace: current drain readiness" {
    assert(cw108_trace_ready())
}

example "trace: B still has its own outstanding operation" {
    assert(cw108_trace_ready() ∧ (cw108_trace_b_count()=bvconst(1,64)))
}

example "trace: consumed CPU cannot complete twice" {
    assert(¬(cw108_finish(a23_true(),a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),bvconst(2,64),bvconst(9,64),bvconst(41,64),bvconst(1,8),cw108_trace_cpu_after(),bvconst(0,64),ptr107_max(),bvconst(0,64),cw108_ticket_active(cw108_trace_cpu_finish(),cw108_trace_cpu_active()),bvconst(1,8))))
}

example "trace: ready is not publication" {
    assert(¬(a23_visible(cw108_trace_closed(),a23_true())))
}

example "law: empty census" {
    assert(∀(cap : BitVec64). (bvule(cap,repr107_mask()) → cw108_census(cap,bvconst(0,64),bvconst(0,64),bvconst(0,64))))
}

example "law: scan induction" {
    assert(∀(cap : BitVec64). ∀(n : BitVec64). ∀(c : BitVec64). ∀(d : BitVec64). ∀(a : BitVec8). ∀(j : BitVec64). ∀(q : BitVec64). ∀(valid : Bool). ∀(kind : BitVec8). (cw108_scan(cap,n,c,d,a,j,valid,kind) → cw108_census(cap,bvadd(n,bvconst(1,64)),cw108_tally(c,a,j,q,kind,bvconst(1,8)),cw108_tally(d,a,j,q,kind,bvconst(2,8)))))
}

example "law: foreign job does not change either count" {
    assert(∀(c : BitVec64). ∀(d : BitVec64). ∀(j : BitVec64). ∀(q : BitVec64). ∀(a : BitVec8). ∀(k : BitVec8). (¬(j=q) → ((cw108_tally(c,a,j,q,k,bvconst(1,8))=c) ∧ (cw108_tally(d,a,j,q,k,bvconst(2,8))=d))))
}

example "law: free rows do not count" {
    assert(∀(n : BitVec64). ∀(j : BitVec64). ∀(q : BitVec64). ∀(k : BitVec8). (cw108_tally(n,bvconst(0,8),j,q,k,k)=n))
}

example "law: fenced worker always loses use" {
    assert(∀(bound : Bool). ∀(e : BitVec64). ∀(w : BitVec64). ∀(re : BitVec64). ∀(rw : BitVec64). (¬cw108_lease(bound,a23_false(),bvconst(1,8),e,w,re,rw)))
}

example "law: claimed lease cannot be claimed again" {
    assert(∀(e : BitVec64). ∀(w : BitVec64). ∀(r : BitVec64). (¬cw108_claim(a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),e,bvconst(0,8),w,r,r,bvconst(1,8))))
}

example "law: failed claim preserves epoch" {
    assert(∀(e : BitVec64). (cw108_claim_epoch(a23_false(),e)=e))
}

example "law: last claim epoch reaches MAX without wrapping" {
    assert(cw108_claim_epoch(a23_true(),bvsub(ptr107_max(),bvconst(1,64)))=ptr107_max())
}

example "law: failed finish preserves count and active state" {
    assert(∀(n : BitVec64). ∀(a : BitVec8). ((cw108_after_finish(a23_false(),n)=n) ∧ (cw108_ticket_active(a23_false(),a)=a)))
}

example "law: successful finish consumes one active ticket" {
    assert(∀(slot : BitVec64). ∀(gen : BitVec64). ∀(op : BitVec64). ∀(n : BitVec64). ∀(next : BitVec64). (cw108_finish(a23_true(),a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),slot,gen,op,bvconst(1,8),n,bvconst(0,64),next,bvconst(0,64),bvconst(1,8),bvconst(1,8)) → (bvugt(n,bvconst(0,64)) ∧ (next=cw108_after_finish(a23_true(),n)) ∧ (cw108_ticket_active(a23_true(),bvconst(1,8))=bvconst(0,8)))))
}

example "law: terminal completion refines Undertaker finish" {
    assert(∀(slot : BitVec64). ∀(gen : BitVec64). ∀(op : BitVec64). ∀(n : BitVec64). ∀(next : BitVec64). (cw108_finish(a23_true(),a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),slot,gen,op,bvconst(1,8),n,bvconst(0,64),next,bvconst(0,64),bvconst(1,8),bvconst(1,8)) → ut108_finish_old(a23_true(),bvconst(1,8),slot,gen,slot,gen,op,op,n,next,bvconst(1,8),bvconst(1,8),bvconst(1,8))))
}

example "law: cleanup revision never decreases" {
    assert(∀(r : BitVec64). ∀(commit : Bool). (bvuge(cw108_cleanup_revision(commit,r),r)))
}

example "law: cleanup revision remains saturated" {
    assert(cw108_cleanup_revision(a23_true(),ptr107_max())=ptr107_max())
}

example "law: same revision cannot authorize a cached scan" {
    assert(∀(cap : BitVec64). ∀(c : BitVec64). ∀(d : BitVec64). ∀(r : BitVec64). (¬cw108_scan_complete(cap,cap,c,d,r,r,a23_false(),bvconst(1,8))))
}

example "law: prepared backend is never terminal" {
    assert(∀(bound : Bool). ∀(pin : Bool). ∀(stopped : Bool). ∀(visible : Bool). (¬cw108_terminal(bound,pin,bvconst(2,8),stopped,visible)))
}

example "law: fault without fencing is not terminal" {
    assert(∀(bound : Bool). ∀(pin : Bool). ∀(visible : Bool). (¬cw108_terminal(bound,pin,bvconst(4,8),a23_false(),visible)))
}

example "law: readiness requires both counts and unknown sources zero" {
    assert(∀(c : BitVec64). ∀(d : BitVec64). ∀(u : BitVec64). (cw108_ready(a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),a23_true(),c,d,u,a23_true(),a23_true(),a23_true(),bvconst(1,8)) → ((c=bvconst(0,64)) ∧ (d=bvconst(0,64)) ∧ (u=bvconst(0,64)))))
}

example "law: other directory entries preserved" {
    assert(∀(selected : BitVec64). ∀(query : BitVec64). ∀(old : BitVec64). ∀(next : BitVec64). ∀(commit : Bool). (¬(selected=query) → (cw108_field(commit,selected,query,old,next)=old)))
}

example "law: rejection preserves selected directory entry" {
    assert(∀(s : BitVec64). ∀(old : BitVec64). ∀(next : BitVec64). (cw108_field(a23_false(),s,s,old,next)=old))
}

example "law: held payload and fixed storage never refunded" {
    assert(∀(payload : BitVec64). ∀(fixed : BitVec64). ((cw108_held(payload)=payload) ∧ (cw108_held(fixed)=fixed)))
}

example "law: closed stage still excludes every old alias" {
    assert(∀(h : BitVec64). ∀(s : BitVec64). ∀(g : BitVec64). ∀(tag : BitVec8). (¬a23_current(h,tag,s,g,bvconst(3,8),a23_true())))
}

example "law: finish preserves the other work class" {
    assert(∀(commit : Bool). ∀(k : BitVec8). ∀(q : BitVec8). ∀(n : BitVec64). (¬(k=q) → (cw108_finish_count(commit,k,q,n)=n)))
}

example "law: DMA completion cannot decrement CPU" {
    assert(∀(c : BitVec64). ∀(d : BitVec64). ∀(nc : BitVec64). ∀(nd : BitVec64). (cw108_finish(a23_true(),a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),bvconst(2,64),bvconst(9,64),bvconst(42,64),bvconst(2,8),c,d,nc,nd,bvconst(1,8),bvconst(1,8)) → ((nc=c) ∧ (nd=bvsub(d,bvconst(1,64))))))
}

example "law: one removed matching row agrees with census decrement" {
    assert(∀(others : BitVec64). (bvult(others,ptr107_max()) → (cw108_after_finish(a23_true(),cw108_tally(others,bvconst(1,8),bvconst(21,64),bvconst(21,64),bvconst(1,8),bvconst(1,8)))=cw108_tally(others,bvconst(0,8),bvconst(21,64),bvconst(21,64),bvconst(1,8),bvconst(1,8)))))
}

example "law: successful issuance strictly advances operation identity" {
    assert(∀(n : BitVec64). ((bvugt(n,bvconst(0,64)) ∧ bvult(n,ptr107_max())) → bvugt(a23_next(a23_true(),n),n)))
}
