// Each deliberately false assertion MUST be explicitly disproved by Z3.
// Parser/evaluation errors, unknown and timeout do not count as evidence.
import "anka108_async_reclamation.kleis"

example "HOSTILE ut108_queue rejects armed over capacity" {
    assert(ut108_queue(bvconst(4,64),bvconst(5,64),bvconst(2,64)))
}

