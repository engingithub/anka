example "HOSTILE semantic probe another client may lose bytes" {
    assert(∀(q : BitVec64). (q=bvconst(4096,64)) → (ut108_trace_byte(bvconst(173,8),q)=bvconst(0,8)))
}

example "HOSTILE semantic probe only logical bytes need clearing" {
    assert(∀(q : BitVec64). (q=bvconst(17,64)) → (ut108_trace_byte(bvconst(173,8),q)=bvconst(173,8)))
}

example "HOSTILE semantic probe clean already means uncharged" {
    assert(ut108_charge_held(bvconst(4,8))=ut108_false())
}

