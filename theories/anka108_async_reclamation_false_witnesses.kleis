    assert(∀(q : BitVec64). (q=bvconst(4095,64)) → (ut108_trace_byte(bvconst(173,8),q)=bvconst(173,8)))
}

example "HOSTILE semantic probe scrub may preserve pointer kind" {
    assert(∀(q : BitVec64). (q=bvconst(12272,64)) → (ut108_trace_tag(bvconst(1,8),q)=bvconst(1,8)))
