// AR110: concrete bounded artifact READ framing/disclosure refinement.
// No new axioms; uses SR110 custody and AG110 serialized IO. Host-only SR110 R1
// passed 20 tests; this file specifies the next wire extension, not its Rust codec.
// Request: existing ANKAUP01/1 header, opcode 7, exactly 168 bytes, no payload.
// Header word 5 is the requested read count, NOT appended request bytes.
// Reply: ANKARD01 + LE64 version=1, echo_length=168, data_length=count;
// exact 168-byte request echo followed by exactly count bytes. Total 200+count.
// Complete canonical decoding, current evidence, immutable-content validation,
// actual-stream binding and serialized updates are runtime obligations. Bool /
// Verdict arguments are trusted observations, never client-supplied verdicts.
import "anka110_stored_retrieval.kleis"
import "anka110_artifact_transport.kleis"
// Flat fields mirror wire words and avoid nested selector expansion in Z3.
// All request words, including role, retain the full wire width.
data AR110Request = AR110Request(magic : BitVec64,version : BitVec64,op : BitVec64,correlation : BitVec64,ticket : BitVec64,offset : BitVec64,count : BitVec64,publish_request : BitVec64,expected : BitVec64,reserved : BitVec64,anchor : BitVec64,installation : BitVec64,artifact : BitVec64,generation : BitVec64,role : BitVec64,profile : BitVec64,size : BitVec64,image : BitVec64,metadata : BitVec64,dependencies : BitVec64,provenance : BitVec64)
define arq_magic(q : AR110Request) = match q { AR110Request(magic,version,op,correlation,ticket,offset,count,publish_request,expected,reserved,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => magic }
define arq_version(q : AR110Request) = match q { AR110Request(magic,version,op,correlation,ticket,offset,count,publish_request,expected,reserved,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => version }
define arq_op(q : AR110Request) = match q { AR110Request(magic,version,op,correlation,ticket,offset,count,publish_request,expected,reserved,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => op }
define arq_correlation(q : AR110Request) = match q { AR110Request(magic,version,op,correlation,ticket,offset,count,publish_request,expected,reserved,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => correlation }
define arq_ticket(q : AR110Request) = match q { AR110Request(magic,version,op,correlation,ticket,offset,count,publish_request,expected,reserved,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => ticket }
define arq_offset(q : AR110Request) = match q { AR110Request(magic,version,op,correlation,ticket,offset,count,publish_request,expected,reserved,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => offset }
define arq_count(q : AR110Request) = match q { AR110Request(magic,version,op,correlation,ticket,offset,count,publish_request,expected,reserved,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => count }
define arq_publish_request(q : AR110Request) = match q { AR110Request(magic,version,op,correlation,ticket,offset,count,publish_request,expected,reserved,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => publish_request }
define arq_expected(q : AR110Request) = match q { AR110Request(magic,version,op,correlation,ticket,offset,count,publish_request,expected,reserved,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => expected }
define arq_reserved(q : AR110Request) = match q { AR110Request(magic,version,op,correlation,ticket,offset,count,publish_request,expected,reserved,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => reserved }
define arq_anchor(q : AR110Request) = match q { AR110Request(magic,version,op,correlation,ticket,offset,count,publish_request,expected,reserved,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => anchor }
define arq_installation(q : AR110Request) = match q { AR110Request(magic,version,op,correlation,ticket,offset,count,publish_request,expected,reserved,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => installation }
define arq_artifact(q : AR110Request) = match q { AR110Request(magic,version,op,correlation,ticket,offset,count,publish_request,expected,reserved,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => artifact }
define arq_generation(q : AR110Request) = match q { AR110Request(magic,version,op,correlation,ticket,offset,count,publish_request,expected,reserved,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => generation }
define arq_role(q : AR110Request) = match q { AR110Request(magic,version,op,correlation,ticket,offset,count,publish_request,expected,reserved,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => role }
define arq_profile(q : AR110Request) = match q { AR110Request(magic,version,op,correlation,ticket,offset,count,publish_request,expected,reserved,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => profile }
define arq_size(q : AR110Request) = match q { AR110Request(magic,version,op,correlation,ticket,offset,count,publish_request,expected,reserved,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => size }
define arq_image(q : AR110Request) = match q { AR110Request(magic,version,op,correlation,ticket,offset,count,publish_request,expected,reserved,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => image }
define arq_metadata(q : AR110Request) = match q { AR110Request(magic,version,op,correlation,ticket,offset,count,publish_request,expected,reserved,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => metadata }
define arq_dependencies(q : AR110Request) = match q { AR110Request(magic,version,op,correlation,ticket,offset,count,publish_request,expected,reserved,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => dependencies }
define arq_provenance(q : AR110Request) = match q { AR110Request(magic,version,op,correlation,ticket,offset,count,publish_request,expected,reserved,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => provenance }
define ar110_bound(q : AR110Request,m : SL110Artifact) =
    (arq_anchor(q)=sa_anchor(m)) ∧
    (arq_installation(q)=sa_installation(m)) ∧
    (arq_artifact(q)=sa_artifact(m)) ∧
    (arq_generation(q)=sa_generation(m)) ∧
    (arq_role(q)=bvconst(2,64)) ∧ (sa_role(m)=bvconst(2,8)) ∧
    (arq_profile(q)=sa_profile(m)) ∧
    (arq_size(q)=sa_size(m)) ∧
    (arq_image(q)=sa_image(m)) ∧
    (arq_metadata(q)=sa_metadata(m)) ∧
    (arq_dependencies(q)=sa_dependencies(m)) ∧
    (arq_provenance(q)=sa_provenance(m))
define ar110_lane_bound(q : AR110Request,s : SR110State) =
    (arq_anchor(q)=srr_anchor(s)) ∧
    (arq_installation(q)=srr_installation(s)) ∧
    (arq_artifact(q)=srr_artifact(s)) ∧
    (arq_generation(q)=srr_generation(s)) ∧
    (arq_role(q)=bvconst(2,64)) ∧ (srr_role(s)=bvconst(2,8)) ∧
    (arq_profile(q)=srr_profile(s)) ∧
    (arq_size(q)=srr_size(s)) ∧
    (arq_image(q)=srr_image(s)) ∧
    (arq_metadata(q)=srr_metadata(s)) ∧
    (arq_dependencies(q)=srr_dependencies(s)) ∧
    (arq_provenance(q)=srr_provenance(s))
define ar110_request_magic() = bvconst(3544421233838476865,64)
define ar110_reply_magic() = bvconst(3544408026814041665,64)
define ar110_request(q : AR110Request,actual : BitVec64,eof : Bool) =
    (arq_magic(q)=ar110_request_magic()) ∧ (arq_version(q)=a109_one()) ∧
    (arq_op(q)=bvconst(7,64)) ∧ a109_nonzero(arq_correlation(q)) ∧
    (actual=bvconst(168,64)) ∧ eof ∧ (arq_ticket(q)=a109_z()) ∧
    (arq_publish_request(q)=a109_z()) ∧ (arq_expected(q)=a109_z()) ∧ (arq_reserved(q)=a109_z()) ∧
    a109_nonzero(arq_anchor(q)) ∧ a109_nonzero(arq_installation(q)) ∧
    a109_nonzero(arq_artifact(q)) ∧ a109_nonzero(arq_generation(q)) ∧
    (arq_role(q)=bvconst(2,64)) ∧
    ((arq_profile(q)=a109_one()) ∨ (arq_profile(q)=bvconst(2,64))) ∧
    a109_nonzero(arq_image(q)) ∧ a109_nonzero(arq_metadata(q)) ∧
    a109_nonzero(arq_dependencies(q)) ∧ a109_nonzero(arq_provenance(q)) ∧
    cs110_chunk(arq_size(q),arq_offset(q),arq_count(q),bvconst(4096,64))
// Exact echo means all 168 canonical bytes, including every manifest identity.
define ar110_same_read(a : AR110Request,b : AR110Request) =
    (arq_magic(a)=arq_magic(b)) ∧
    (arq_version(a)=arq_version(b)) ∧
    (arq_op(a)=arq_op(b)) ∧
    (arq_ticket(a)=arq_ticket(b)) ∧
    (arq_offset(a)=arq_offset(b)) ∧
    (arq_count(a)=arq_count(b)) ∧
    (arq_publish_request(a)=arq_publish_request(b)) ∧
    (arq_expected(a)=arq_expected(b)) ∧
    (arq_reserved(a)=arq_reserved(b)) ∧
    (arq_anchor(a)=arq_anchor(b)) ∧ (arq_installation(a)=arq_installation(b)) ∧ (arq_artifact(a)=arq_artifact(b)) ∧ (arq_generation(a)=arq_generation(b)) ∧ (arq_role(a)=arq_role(b)) ∧ (arq_profile(a)=arq_profile(b)) ∧ (arq_size(a)=arq_size(b)) ∧ (arq_image(a)=arq_image(b)) ∧ (arq_metadata(a)=arq_metadata(b)) ∧ (arq_dependencies(a)=arq_dependencies(b)) ∧ (arq_provenance(a)=arq_provenance(b))
define ar110_echo(a : AR110Request,b : AR110Request) =
    ar110_same_read(a,b) ∧ (arq_correlation(a)=arq_correlation(b))
define ar110_reply(q : AR110Request,echo : AR110Request,magic : BitVec64,version : BitVec64,
    echo_length : BitVec64,n : BitVec64,actual : BitVec64,eof : Bool,
    connection : BitVec64,observed_connection : BitVec64,server : A109Verdict,read : A109Verdict,content : A109Verdict) =
    ar110_request(q,bvconst(168,64),as110_true()) ∧ ar110_echo(q,echo) ∧
    (magic=ar110_reply_magic()) ∧ (version=a109_one()) ∧ (echo_length=bvconst(168,64)) ∧
    (n=arq_count(q)) ∧ (actual=bvadd(bvconst(200,64),n)) ∧ eof ∧
    a109_nonzero(connection) ∧ (connection=observed_connection) ∧
    (server=A109Valid) ∧ (read=A109Valid) ∧ (content=A109Valid)
// Called before any request bytes are sent. IDs alone are not authentication.
define ar110_client_send(q : AR110Request,connection : BitVec64,server : A109Verdict,
    read : A109Verdict,bound : Bool,funded : Bool,work : BitVec64,now : BitVec64,deadline : BitVec64) =
    ar110_request(q,bvconst(168,64),as110_true()) ∧ a109_nonzero(connection) ∧
    (server=A109Valid) ∧ (read=A109Valid) ∧ bound ∧ funded ∧ ag110_step(work,now,deadline)
// The storage caller's incarnation is AS110's nonzero identity, not a raw Kernel
// process incarnation. Published manifest selection is exact, never "latest".
define ar110_dispatch(q : AR110Request,actual : BitVec64,eof : Bool,published : SL110Artifact,
    phase : BitVec64,connection : BitVec64,owner : BitVec64,inc : BitVec64,
    caller : A109Verdict,read : A109Verdict,content : A109Verdict,funded : Bool,lane : Bool,
    work : BitVec64,now : BitVec64,deadline : BitVec64) =
    ar110_request(q,actual,eof) ∧ (phase=bvconst(3,64)) ∧ ar110_bound(q,published) ∧
    at110_admit(connection,caller,owner,inc,as110_true(),funded) ∧ lane ∧
    (read=A109Valid) ∧ (content=A109Valid) ∧ ag110_step(work,now,deadline)
// Check immediately before EVERY write, including echoed metadata/header bytes.
// Earlier authorized prefixes cannot be recalled; revocation stops the suffix.
define ar110_disclose(sent : BitVec64,total : BitVec64,n : BitVec64,lane : Bool,same : Bool,
    bound : Bool,caller : A109Verdict,read : A109Verdict,content : A109Verdict,
    work : BitVec64,now : BitVec64,deadline : BitVec64) =
    bvule(bvconst(201,64),total) ∧ bvule(total,bvconst(4296,64)) ∧
    ag110_disclose(bvconst(2,64),sent,total,n,lane,same,bound,caller,read) ∧
    (content=A109Valid) ∧ ag110_step(work,now,deadline)
// Distinct from the pre-existing upload scratch calculation. Charge BOTH
// fixed frame capacities plus measured metadata, in addition to private image
// custody. Reject overflow before addition/allocation. Scan/work costs are extra.
define ar110_buffers(available : BitVec64,metadata : BitVec64,request_capacity : BitVec64,reply_capacity : BitVec64) =
    bvule(bvconst(169,64),request_capacity) ∧ bvule(bvconst(4297,64),reply_capacity) ∧
    bvule(request_capacity,available) ∧ bvule(reply_capacity,bvsub(available,request_capacity)) ∧
    bvule(metadata,bvsub(bvsub(available,request_capacity),reply_capacity))
// Retry is a new authenticated stream; request identity/range stays pinned.
// Correlation is monotone per lane and cannot wrap. Work/deadline never refill.
define ar110_retry(old : AR110Request,fresh : AR110Request,old_channel : BitVec64,new_channel : BitVec64,
    before : BitVec64,after : BitVec64,old_deadline : BitVec64,new_deadline : BitVec64,now : BitVec64,
    server : A109Verdict,read : A109Verdict,bound : Bool) =
    ar110_request(old,bvconst(168,64),as110_true()) ∧ ar110_request(fresh,bvconst(168,64),as110_true()) ∧
    ar110_same_read(old,fresh) ∧ bvult(arq_correlation(old),arq_correlation(fresh)) ∧
    a109_nonzero(old_channel) ∧ a109_nonzero(new_channel) ∧ ¬(old_channel=new_channel) ∧
    a109_nonzero(before) ∧ (after=bvsub(before,a109_one())) ∧
    (old_deadline=new_deadline) ∧ bvult(now,old_deadline) ∧
    (server=A109Valid) ∧ (read=A109Valid) ∧ bound
// Bridge into SR110: a partial wire reply advances no private cursor. Only a
// complete ar110_reply verdict can commit a contiguous range. Manifest changes
// close the owned lane. A stale/foreign local ticket cannot select another lane.
define ar110_receive(s : SR110State,t : SR110State,q : AR110Request,boot : BitVec64,ticket : BitVec64,
    owner : BitVec64,inc : BitVec64,active_boot : BitVec64,live : Bool,now : BitVec64,
    read : A109Verdict,server : A109Verdict,result : BitVec64,scope : Bool,reply : Bool) =
    sr110_receive(s,t,boot,ticket,owner,inc,active_boot,live,now,read,server,
      arq_offset(q),arq_count(q),result,
      scope ∧ ar110_request(q,bvconst(168,64),as110_true()) ∧ ar110_lane_bound(q,s),reply)
// The backend remains read-only: publication/selection and ledger do not change.
define ar110_backend_same(before : SL110Artifact,after : SL110Artifact,selected : BitVec64,next_selected : BitVec64,
    generation : BitVec64,next_generation : BitVec64,revision : BitVec64,next_revision : BitVec64,
    usage : BitVec64,next_usage : BitVec64) =
    sl110_exact(before,after) ∧ (selected=next_selected) ∧ (generation=next_generation) ∧
    (revision=next_revision) ∧ (usage=next_usage)

example "read first full range" { assert(ar110_request(AR110Request(bvconst(3544421233838476865,64),bvconst(1,64),bvconst(7,64),bvconst(9,64),bvconst(0,64),bvconst(0,64),bvconst(4096,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(10,64),bvconst(20,64),bvconst(40,64),bvconst(2,64),bvconst(2,64),bvconst(1,64),bvconst(10000,64),bvconst(101,64),bvconst(102,64),bvconst(103,64),bvconst(104,64)),bvconst(168,64),as110_true())) }
example "read final short range" { assert(ar110_request(AR110Request(bvconst(3544421233838476865,64),bvconst(1,64),bvconst(7,64),bvconst(9,64),bvconst(0,64),bvconst(9999,64),bvconst(1,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(10,64),bvconst(20,64),bvconst(40,64),bvconst(2,64),bvconst(2,64),bvconst(1,64),bvconst(10000,64),bvconst(101,64),bvconst(102,64),bvconst(103,64),bvconst(104,64)),bvconst(168,64),as110_true())) }
example "large profile remains supported" { assert(ar110_request(AR110Request(bvconst(3544421233838476865,64),bvconst(1,64),bvconst(7,64),bvconst(9,64),bvconst(0,64),bvconst(0,64),bvconst(4096,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(10,64),bvconst(20,64),bvconst(40,64),bvconst(2,64),bvconst(2,64),bvconst(2,64),bvconst(10000,64),bvconst(101,64),bvconst(102,64),bvconst(103,64),bvconst(104,64)),bvconst(168,64),as110_true())) }
