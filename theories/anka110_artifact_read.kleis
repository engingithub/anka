example "read changes selection generation rejected" { assert(¬(ar110_backend_same(SL110Artifact(bvconst(10,64),bvconst(20,64),bvconst(40,64),bvconst(2,64),bvconst(2,8),bvconst(1,64),bvconst(10000,64),bvconst(101,64),bvconst(102,64),bvconst(103,64),bvconst(104,64)),SL110Artifact(bvconst(10,64),bvconst(20,64),bvconst(40,64),bvconst(2,64),bvconst(2,8),bvconst(1,64),bvconst(10000,64),bvconst(101,64),bvconst(102,64),bvconst(103,64),bvconst(104,64)),bvconst(55,64),bvconst(55,64),bvconst(3,64),bvconst(4,64),bvconst(8,64),bvconst(8,64),bvconst(12000,64),bvconst(12000,64)))) }
example "read increments publication revision rejected" { assert(¬(ar110_backend_same(SL110Artifact(bvconst(10,64),bvconst(20,64),bvconst(40,64),bvconst(2,64),bvconst(2,8),bvconst(1,64),bvconst(10000,64),bvconst(101,64),bvconst(102,64),bvconst(103,64),bvconst(104,64)),SL110Artifact(bvconst(10,64),bvconst(20,64),bvconst(40,64),bvconst(2,64),bvconst(2,8),bvconst(1,64),bvconst(10000,64),bvconst(101,64),bvconst(102,64),bvconst(103,64),bvconst(104,64)),bvconst(55,64),bvconst(55,64),bvconst(3,64),bvconst(3,64),bvconst(8,64),bvconst(9,64),bvconst(12000,64),bvconst(12000,64)))) }
example "read refunds persistent storage rejected" { assert(¬(ar110_backend_same(SL110Artifact(bvconst(10,64),bvconst(20,64),bvconst(40,64),bvconst(2,64),bvconst(2,8),bvconst(1,64),bvconst(10000,64),bvconst(101,64),bvconst(102,64),bvconst(103,64),bvconst(104,64)),SL110Artifact(bvconst(10,64),bvconst(20,64),bvconst(40,64),bvconst(2,64),bvconst(2,8),bvconst(1,64),bvconst(10000,64),bvconst(101,64),bvconst(102,64),bvconst(103,64),bvconst(104,64)),bvconst(55,64),bvconst(55,64),bvconst(3,64),bvconst(3,64),bvconst(8,64),bvconst(8,64),bvconst(12000,64),bvconst(0,64)))) }
example "legacy upload still rejects new read opcode" { assert(¬(at110_frame(bvconst(1,64),bvconst(7,64),bvconst(9,64),bvconst(0,64),bvconst(168,64),as110_true(),bvconst(0,64)))) }
example "legacy append geometry unchanged" { assert(at110_frame(bvconst(1,64),bvconst(2,64),bvconst(9,64),bvconst(64,64),bvconst(232,64),as110_true(),bvconst(0,64))) }
example "law bounded read cannot wrap" { assert(∀ size : BitVec64 . ∀ off : BitVec64 . ∀ n : BitVec64 . cs110_chunk(size,off,n,bvconst(4096,64)) ⟹ (bvule(bvadd(off,n),size) ∧ bvule(off,bvadd(off,n)))) }
example "law reply capacity fits fixed maximum" { assert(∀ n : BitVec64 . bvule(n,bvconst(4096,64)) ⟹ bvule(bvadd(bvconst(200,64),n),bvconst(4296,64))) }
example "wire role 258 cannot truncate to linked role" { assert(¬(ar110_request(AR110Request(bvconst(3544421233838476865,64),bvconst(1,64),bvconst(7,64),bvconst(9,64),bvconst(0,64),bvconst(0,64),bvconst(4096,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(10,64),bvconst(20,64),bvconst(40,64),bvconst(2,64),bvconst(258,64),bvconst(1,64),bvconst(10000,64),bvconst(101,64),bvconst(102,64),bvconst(103,64),bvconst(104,64)),bvconst(168,64),as110_true()))) }
example "wire role 65538 cannot truncate to linked role" { assert(¬(ar110_request(AR110Request(bvconst(3544421233838476865,64),bvconst(1,64),bvconst(7,64),bvconst(9,64),bvconst(0,64),bvconst(0,64),bvconst(4096,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(10,64),bvconst(20,64),bvconst(40,64),bvconst(2,64),bvconst(65538,64),bvconst(1,64),bvconst(10000,64),bvconst(101,64),bvconst(102,64),bvconst(103,64),bvconst(104,64)),bvconst(168,64),as110_true()))) }
