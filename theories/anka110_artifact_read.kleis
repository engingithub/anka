example "request op 8 rejected" { assert(¬(ar110_request(AR110Request(bvconst(3544421233838476865,64),bvconst(1,64),bvconst(8,64),bvconst(9,64),bvconst(0,64),bvconst(0,64),bvconst(4096,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(10,64),bvconst(20,64),bvconst(40,64),bvconst(2,64),bvconst(2,64),bvconst(1,64),bvconst(10000,64),bvconst(101,64),bvconst(102,64),bvconst(103,64),bvconst(104,64)),bvconst(168,64),as110_true()))) }
