// Each unsafe claim must be explicitly disproved.
import "anka110_caller_verifier.kleis"

example "false: recognized A without grant cannot read" {
    assert(v110_read(A109Context(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(71,64),bvconst(100,64),(bvconst(1,8)=bvconst(1,8))),
        E110Observation(bvconst(5,64),bvconst(6,64),bvconst(7,64),bvconst(40,64),bvconst(30,64),bvconst(1,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(9,64),bvconst(71,64),(bvconst(1,8)=bvconst(1,8)),A109Valid),
        V110Credential(bvconst(27,64),bvconst(10,64),bvconst(30,64),bvconst(1,64),bvconst(20,64),bvconst(3,64),bvconst(88,64),bvconst(90,64),bvconst(110,64),A109Valid),
        V110Status(bvconst(27,64),bvconst(10,64),bvconst(3,64),bvconst(9,64),bvconst(96,64),bvconst(105,64),A109Valid),
        V110Possession(bvconst(10,64),bvconst(27,64),bvconst(88,64),bvconst(5,64),bvconst(6,64),bvconst(7,64),bvconst(40,64),bvconst(30,64),bvconst(1,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(9,64),bvconst(71,64),A109Valid),
        A109Identity(bvconst(10,64),bvconst(30,64),bvconst(1,64),bvconst(20,64),bvconst(3,64),bvconst(71,64),bvconst(90,64),bvconst(110,64),A109Valid,A109Valid,A109Valid),
        K110Key(bvconst(10,64),bvconst(30,64),bvconst(1,64),bvconst(88,64),A109Valid),
        E110Binding(bvconst(5,64),bvconst(6,64),bvconst(7,64),bvconst(40,64),bvconst(30,64),bvconst(1,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(9,64),bvconst(71,64),A109Valid),
        K110Signer(bvconst(5,64),bvconst(6,64),bvconst(7,64),bvconst(88,64),A109Valid),
        (bvconst(1,8)=bvconst(0,8)),
        E110Permit(bvconst(10,64),bvconst(30,64),bvconst(1,64),bvconst(20,64),bvconst(3,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(95,64),bvconst(108,64),A109Valid,A109Valid),
        bvconst(9,64),
        P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),
        P109Access(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(95,64),bvconst(108,64),A109Valid,A109Valid),
        (bvconst(1,8)=bvconst(1,8))))
}
