// Phase 10.10 evidence admission, refining Phase 10.9 recognition and T2 access.
// Zero axioms. This is a TECHNOLOGY-NEUTRAL VALIDATOR-OUTPUT CONTRACT, not a
// signature algorithm, token parser, wire ABI, or implemented authentication.
// Context/Observation come from the trusted current authority/channel lane.
// Identity/Permit/Binding are immutable, provenance-protected validator outputs.
// A guest cannot construct Valid, choose current observations or set serial/live.
// All Valid verdicts concern EVERY associated field, not a subset of a token.
// Opaque BitVec64 binding/runtime handles model equality, NOT cryptographic strength.
// Runtime freshness across restart requires an external fresh challenge/channel
// root; restarting a local integer counter does not satisfy this obligation.
// No executable grant or boot admission is created by recognizing storage.
import "anka110_persistence_protocol.kleis"

// Roles: 1=persistence caller, 2=storage server. Principal kind remains the
// existing person/installation/workload classification, independent of role.
data E110Observation = E110Observation(runtime : BitVec64, connection : BitVec64, binding : BitVec64, local : BitVec64, peer : BitVec64, kind : BitVec64, incarnation : BitVec64, role : BitVec64, operation : BitVec64, serial : BitVec64, challenge : BitVec64, live : Bool, channel : A109Verdict)
define eo_runtime(v : E110Observation) = match v { E110Observation(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,live,channel) => runtime }
define eo_connection(v : E110Observation) = match v { E110Observation(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,live,channel) => connection }
define eo_binding(v : E110Observation) = match v { E110Observation(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,live,channel) => binding }
define eo_local(v : E110Observation) = match v { E110Observation(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,live,channel) => local }
define eo_peer(v : E110Observation) = match v { E110Observation(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,live,channel) => peer }
define eo_kind(v : E110Observation) = match v { E110Observation(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,live,channel) => kind }
define eo_incarnation(v : E110Observation) = match v { E110Observation(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,live,channel) => incarnation }
define eo_role(v : E110Observation) = match v { E110Observation(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,live,channel) => role }
define eo_operation(v : E110Observation) = match v { E110Observation(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,live,channel) => operation }
define eo_serial(v : E110Observation) = match v { E110Observation(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,live,channel) => serial }
define eo_challenge(v : E110Observation) = match v { E110Observation(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,live,channel) => challenge }
define eo_live(v : E110Observation) = match v { E110Observation(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,live,channel) => live }
define eo_channel(v : E110Observation) = match v { E110Observation(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,live,channel) => channel }

// Binding proof covers direction, both principals, role, operation, challenge,
// runtime/connection/channel identity and the current authority snapshot serial.
data E110Binding = E110Binding(runtime : BitVec64, connection : BitVec64, binding : BitVec64, local : BitVec64, peer : BitVec64, kind : BitVec64, incarnation : BitVec64, role : BitVec64, operation : BitVec64, serial : BitVec64, challenge : BitVec64, validated : A109Verdict)
define eb_runtime(v : E110Binding) = match v { E110Binding(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,validated) => runtime }
define eb_connection(v : E110Binding) = match v { E110Binding(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,validated) => connection }
define eb_binding(v : E110Binding) = match v { E110Binding(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,validated) => binding }
define eb_local(v : E110Binding) = match v { E110Binding(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,validated) => local }
define eb_peer(v : E110Binding) = match v { E110Binding(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,validated) => peer }
define eb_kind(v : E110Binding) = match v { E110Binding(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,validated) => kind }
define eb_incarnation(v : E110Binding) = match v { E110Binding(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,validated) => incarnation }
define eb_role(v : E110Binding) = match v { E110Binding(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,validated) => role }
define eb_operation(v : E110Binding) = match v { E110Binding(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,validated) => operation }
define eb_serial(v : E110Binding) = match v { E110Binding(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,validated) => serial }
define eb_challenge(v : E110Binding) = match v { E110Binding(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,validated) => challenge }
define eb_validated(v : E110Binding) = match v { E110Binding(runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,validated) => validated }

// Direct selected-anchor permit; recognition by itself is not permission.
data E110Permit = E110Permit(issuer : BitVec64, subject : BitVec64, kind : BitVec64, audience : BitVec64, policy : BitVec64, incarnation : BitVec64, role : BitVec64, operation : BitVec64, first : BitVec64, until : BitVec64, authentic : A109Verdict, status : A109Verdict)
define ep_issuer(v : E110Permit) = match v { E110Permit(issuer,subject,kind,audience,policy,incarnation,role,operation,first,until,authentic,status) => issuer }
define ep_subject(v : E110Permit) = match v { E110Permit(issuer,subject,kind,audience,policy,incarnation,role,operation,first,until,authentic,status) => subject }
define ep_kind(v : E110Permit) = match v { E110Permit(issuer,subject,kind,audience,policy,incarnation,role,operation,first,until,authentic,status) => kind }
define ep_audience(v : E110Permit) = match v { E110Permit(issuer,subject,kind,audience,policy,incarnation,role,operation,first,until,authentic,status) => audience }
define ep_policy(v : E110Permit) = match v { E110Permit(issuer,subject,kind,audience,policy,incarnation,role,operation,first,until,authentic,status) => policy }
define ep_incarnation(v : E110Permit) = match v { E110Permit(issuer,subject,kind,audience,policy,incarnation,role,operation,first,until,authentic,status) => incarnation }
define ep_role(v : E110Permit) = match v { E110Permit(issuer,subject,kind,audience,policy,incarnation,role,operation,first,until,authentic,status) => role }
define ep_operation(v : E110Permit) = match v { E110Permit(issuer,subject,kind,audience,policy,incarnation,role,operation,first,until,authentic,status) => operation }
define ep_first(v : E110Permit) = match v { E110Permit(issuer,subject,kind,audience,policy,incarnation,role,operation,first,until,authentic,status) => first }
define ep_until(v : E110Permit) = match v { E110Permit(issuer,subject,kind,audience,policy,incarnation,role,operation,first,until,authentic,status) => until }
define ep_authentic(v : E110Permit) = match v { E110Permit(issuer,subject,kind,audience,policy,incarnation,role,operation,first,until,authentic,status) => authentic }
define ep_status(v : E110Permit) = match v { E110Permit(issuer,subject,kind,audience,policy,incarnation,role,operation,first,until,authentic,status) => status }

define e110_observation(c : A109Context, o : E110Observation) =
    a109_context(c) ∧ a109_nonzero(eo_runtime(o)) ∧ a109_nonzero(eo_connection(o)) ∧
    a109_nonzero(eo_binding(o)) ∧ a109_nonzero(eo_local(o)) ∧ a109_nonzero(eo_peer(o)) ∧
    a109_kind(eo_kind(o)) ∧ a109_nonzero(eo_incarnation(o)) ∧ a109_nonzero(eo_serial(o)) ∧
    (eo_challenge(o)=ctx_challenge(c)) ∧ eo_live(o) ∧ (eo_channel(o)=A109Valid) ∧
    ((eo_role(o)=bvconst(1,64)) ∨ (eo_role(o)=bvconst(2,64))) ∧
    ((eo_operation(o)=bvconst(1,64)) ∨ (eo_operation(o)=bvconst(2,64)))
define e110_bound(o : E110Observation, b : E110Binding) =
    (eo_runtime(o)=eb_runtime(b)) ∧ (eo_connection(o)=eb_connection(b)) ∧ (eo_binding(o)=eb_binding(b)) ∧ (eo_local(o)=eb_local(b)) ∧ (eo_peer(o)=eb_peer(b)) ∧ (eo_kind(o)=eb_kind(b)) ∧ (eo_incarnation(o)=eb_incarnation(b)) ∧ (eo_role(o)=eb_role(b)) ∧ (eo_operation(o)=eb_operation(b)) ∧ (eo_serial(o)=eb_serial(b)) ∧ (eo_challenge(o)=eb_challenge(b)) ∧ (eb_validated(b)=A109Valid)
define e110_admit(c : A109Context, i : A109Identity, p : E110Permit, b : E110Binding, o : E110Observation) =
    e110_observation(c,o) ∧ e110_bound(o,b) ∧
    a109_recognize(c,i,eo_peer(o),eo_kind(o)) ∧
    (ep_issuer(p)=ctx_anchor(c)) ∧ (ep_subject(p)=eo_peer(o)) ∧ (ep_kind(p)=eo_kind(o)) ∧
    (ep_audience(p)=ctx_installation(c)) ∧ (ep_policy(p)=ctx_epoch(c)) ∧
    (ep_incarnation(p)=eo_incarnation(o)) ∧ (ep_role(p)=eo_role(o)) ∧ (ep_operation(p)=eo_operation(o)) ∧
    a109_window(ctx_now(c),ep_first(p),ep_until(p)) ∧
    (ep_authentic(p)=A109Valid) ∧ (ep_status(p)=A109Valid)
// Recheck at each use/commit/reply; a previously good cache is not authority.
// The expected serial is frozen at admission; serial changes fence the use.
// This predicate must be checked in the same trusted serialized authority lane
// as the effect. Concurrent policy changes cannot be ruled out by syntax alone.
define e110_use(c : A109Context, i : A109Identity, p : E110Permit, b : E110Binding, o : E110Observation, expected_serial : BitVec64) =
    e110_admit(c,i,p,b,o) ∧ (expected_serial=eo_serial(o))
define e110_first(i : A109Identity,p : E110Permit) = if bvult(ident_first(i),ep_first(p)) then ep_first(p) else ident_first(i)
define e110_until(i : A109Identity,p : E110Permit) = if bvult(ident_until(i),ep_until(p)) then ident_until(i) else ep_until(p)
// Exact projection into existing P109Access. No wider validity, role, namespace,
// incarnation or operation may be substituted. No binding is erased from the
// retained admission: every use must re-evaluate e110_use, never just P109Access.
define e110_client_access(c : A109Context, i : A109Identity, p : E110Permit, b : E110Binding, o : E110Observation, expected_serial : BitVec64, r : P109Request, a : P109Access) =
    e110_use(c,i,p,b,o,expected_serial) ∧ (eo_role(o)=bvconst(1,64)) ∧ n110_shape(r) ∧
    (pr_anchor(r)=ctx_anchor(c)) ∧ (pr_installation(r)=ctx_installation(c)) ∧ (pr_policy(r)=ctx_epoch(c)) ∧
    (pr_caller(r)=eo_peer(o)) ∧ (pr_incarnation(r)=eo_incarnation(o)) ∧ (pr_kind(r)=eo_operation(o)) ∧
    (pa_anchor(a)=pr_anchor(r)) ∧ (pa_installation(a)=pr_installation(r)) ∧ (pa_policy(a)=pr_policy(r)) ∧
    (pa_caller(a)=pr_caller(r)) ∧ (pa_incarnation(a)=pr_incarnation(r)) ∧ (pa_kind(a)=pr_kind(r)) ∧
    (pa_first(a)=e110_first(i,p)) ∧ (pa_until(a)=e110_until(i,p)) ∧
    (pa_authentic(a)=A109Valid) ∧ (pa_status(a)=A109Valid)
// Client-side recognition of the explicitly expected storage server. A person's
// identity cannot stand in for an installation/workload server in this profile.
// This does NOT admit the request caller, storage mutation or executable startup.
define e110_server(c : A109Context, i : A109Identity, p : E110Permit, b : E110Binding, o : E110Observation, expected_serial : BitVec64, expected_server : BitVec64, r : P109Request) =
    e110_use(c,i,p,b,o,expected_serial) ∧ (eo_role(o)=bvconst(2,64)) ∧
    ((eo_kind(o)=bvconst(2,64)) ∨ (eo_kind(o)=bvconst(3,64))) ∧
    (eo_peer(o)=expected_server) ∧ n110_shape(r) ∧
    (pr_anchor(r)=ctx_anchor(c)) ∧ (pr_installation(r)=ctx_installation(c)) ∧
    (pr_policy(r)=ctx_epoch(c)) ∧ (pr_kind(r)=eo_operation(o))

example "recognized person with separate operation permit" { assert(e110_client_access(A109Context(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(71,64),bvconst(100,64),(bvconst(1,8)=bvconst(1,8))),A109Identity(bvconst(10,64),bvconst(30,64),bvconst(1,64),bvconst(20,64),bvconst(3,64),bvconst(71,64),bvconst(90,64),bvconst(110,64),A109Valid,A109Valid,A109Valid),E110Permit(bvconst(10,64),bvconst(30,64),bvconst(1,64),bvconst(20,64),bvconst(3,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(95,64),bvconst(108,64),A109Valid,A109Valid),E110Binding(bvconst(5,64),bvconst(6,64),bvconst(7,64),bvconst(40,64),bvconst(30,64),bvconst(1,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(9,64),bvconst(71,64),A109Valid),E110Observation(bvconst(5,64),bvconst(6,64),bvconst(7,64),bvconst(40,64),bvconst(30,64),bvconst(1,64),bvconst(4,64),bvconst(1,64),bvconst(1,64),bvconst(9,64),bvconst(71,64),(bvconst(1,8)=bvconst(1,8)),A109Valid),bvconst(9,64),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),P109Access(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(95,64),bvconst(108,64),A109Valid,A109Valid))) }
