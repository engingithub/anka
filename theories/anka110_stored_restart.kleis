// RR110: independent service/guest restart before ordinary stored-image launch.
// Bounded composition of T2 boot reservation/admission, GD110 and SR110/T1.
// No new axioms. These are permitted transitions, not a liveness proof or a
// cryptographic verifier. All observations are trusted, serialized with use.
// Nonrollback freshness comes from OUTSIDE the rolled-back durable store and
// guest snapshot. A Rust process-local counter is only a local realm identity.
// Selected bootstrap A and ordinary executable B are deliberately distinct.
import "anka110_guest_download.kleis"

data RR110Boot = RR110Boot(anchor : BitVec64,installation : BitVec64,policy : BitVec64,boot : BitVec64,attempt : BitVec64,realm : BitVec64,active : Bool)
data RR110Fresh = RR110Fresh(anchor : BitVec64,installation : BitVec64,policy : BitVec64,head : BitVec64,selected : BitVec64,boot : BitVec64,attempt : BitVec64,realm : BitVec64,verdict : A109Verdict)
data RR110Service = RR110Service(anchor : BitVec64,installation : BitVec64,incarnation : BitVec64,channel : BitVec64)
data RR110Session = RR110Session(boot : BitVec64,attempt : BitVec64,realm : BitVec64,service : BitVec64,channel : BitVec64,owner : BitVec64,inc : BitVec64,ticket : BitVec64)
data RR110Handle = RR110Handle(boot : BitVec64,attempt : BitVec64,realm : BitVec64,kind : BitVec64,serial : BitVec64,owner : BitVec64,inc : BitVec64)

define rrb_anchor(x : RR110Boot) = match x { RR110Boot(anchor,installation,policy,boot,attempt,realm,active) => anchor }
define rrb_installation(x : RR110Boot) = match x { RR110Boot(anchor,installation,policy,boot,attempt,realm,active) => installation }
define rrb_policy(x : RR110Boot) = match x { RR110Boot(anchor,installation,policy,boot,attempt,realm,active) => policy }
define rrb_boot(x : RR110Boot) = match x { RR110Boot(anchor,installation,policy,boot,attempt,realm,active) => boot }
define rrb_attempt(x : RR110Boot) = match x { RR110Boot(anchor,installation,policy,boot,attempt,realm,active) => attempt }
define rrb_realm(x : RR110Boot) = match x { RR110Boot(anchor,installation,policy,boot,attempt,realm,active) => realm }
define rrb_active(x : RR110Boot) = match x { RR110Boot(anchor,installation,policy,boot,attempt,realm,active) => active }
define rrf_anchor(x : RR110Fresh) = match x { RR110Fresh(anchor,installation,policy,head,selected,boot,attempt,realm,verdict) => anchor }
define rrf_installation(x : RR110Fresh) = match x { RR110Fresh(anchor,installation,policy,head,selected,boot,attempt,realm,verdict) => installation }
define rrf_policy(x : RR110Fresh) = match x { RR110Fresh(anchor,installation,policy,head,selected,boot,attempt,realm,verdict) => policy }
define rrf_head(x : RR110Fresh) = match x { RR110Fresh(anchor,installation,policy,head,selected,boot,attempt,realm,verdict) => head }
define rrf_selected(x : RR110Fresh) = match x { RR110Fresh(anchor,installation,policy,head,selected,boot,attempt,realm,verdict) => selected }
define rrf_boot(x : RR110Fresh) = match x { RR110Fresh(anchor,installation,policy,head,selected,boot,attempt,realm,verdict) => boot }
define rrf_attempt(x : RR110Fresh) = match x { RR110Fresh(anchor,installation,policy,head,selected,boot,attempt,realm,verdict) => attempt }
define rrf_realm(x : RR110Fresh) = match x { RR110Fresh(anchor,installation,policy,head,selected,boot,attempt,realm,verdict) => realm }
define rrf_verdict(x : RR110Fresh) = match x { RR110Fresh(anchor,installation,policy,head,selected,boot,attempt,realm,verdict) => verdict }
define rrv_anchor(x : RR110Service) = match x { RR110Service(anchor,installation,incarnation,channel) => anchor }
define rrv_installation(x : RR110Service) = match x { RR110Service(anchor,installation,incarnation,channel) => installation }
define rrv_incarnation(x : RR110Service) = match x { RR110Service(anchor,installation,incarnation,channel) => incarnation }
define rrv_channel(x : RR110Service) = match x { RR110Service(anchor,installation,incarnation,channel) => channel }
define rrz_boot(x : RR110Session) = match x { RR110Session(boot,attempt,realm,service,channel,owner,inc,ticket) => boot }
define rrz_attempt(x : RR110Session) = match x { RR110Session(boot,attempt,realm,service,channel,owner,inc,ticket) => attempt }
define rrz_realm(x : RR110Session) = match x { RR110Session(boot,attempt,realm,service,channel,owner,inc,ticket) => realm }
define rrz_service(x : RR110Session) = match x { RR110Session(boot,attempt,realm,service,channel,owner,inc,ticket) => service }
define rrz_channel(x : RR110Session) = match x { RR110Session(boot,attempt,realm,service,channel,owner,inc,ticket) => channel }
define rrz_owner(x : RR110Session) = match x { RR110Session(boot,attempt,realm,service,channel,owner,inc,ticket) => owner }
define rrz_inc(x : RR110Session) = match x { RR110Session(boot,attempt,realm,service,channel,owner,inc,ticket) => inc }
define rrz_ticket(x : RR110Session) = match x { RR110Session(boot,attempt,realm,service,channel,owner,inc,ticket) => ticket }
define rrh_boot(x : RR110Handle) = match x { RR110Handle(boot,attempt,realm,kind,serial,owner,inc) => boot }
define rrh_attempt(x : RR110Handle) = match x { RR110Handle(boot,attempt,realm,kind,serial,owner,inc) => attempt }
define rrh_realm(x : RR110Handle) = match x { RR110Handle(boot,attempt,realm,kind,serial,owner,inc) => realm }
define rrh_kind(x : RR110Handle) = match x { RR110Handle(boot,attempt,realm,kind,serial,owner,inc) => kind }
define rrh_serial(x : RR110Handle) = match x { RR110Handle(boot,attempt,realm,kind,serial,owner,inc) => serial }
define rrh_owner(x : RR110Handle) = match x { RR110Handle(boot,attempt,realm,kind,serial,owner,inc) => owner }
define rrh_inc(x : RR110Handle) = match x { RR110Handle(boot,attempt,realm,kind,serial,owner,inc) => inc }

define rr110_empty(b : RR110Boot) =
    (rrb_anchor(b)=a109_z()) ∧ (rrb_installation(b)=a109_z()) ∧ (rrb_policy(b)=a109_z()) ∧
    (rrb_boot(b)=a109_z()) ∧ (rrb_attempt(b)=a109_z()) ∧ (rrb_realm(b)=a109_z()) ∧ ¬rrb_active(b)
define rr110_boot_same(b : RR110Boot,t : RR110Boot) =
    (rrb_anchor(b)=rrb_anchor(t)) ∧ (rrb_installation(b)=rrb_installation(t)) ∧ (rrb_policy(b)=rrb_policy(t)) ∧
    (rrb_boot(b)=rrb_boot(t)) ∧ (rrb_attempt(b)=rrb_attempt(t)) ∧ (rrb_realm(b)=rrb_realm(t)) ∧ (rrb_active(b)=rrb_active(t))
define rr110_service_same(v : RR110Service,w : RR110Service) =
    (rrv_anchor(v)=rrv_anchor(w)) ∧ (rrv_installation(v)=rrv_installation(w)) ∧
    (rrv_incarnation(v)=rrv_incarnation(w)) ∧ (rrv_channel(v)=rrv_channel(w))
define rr110_live(b : RR110Boot,h : P109State) =
    b109_context(rrb_active(b),ps_boot(h),rrb_boot(b)) ∧
    a109_nonzero(rrb_attempt(b)) ∧ a109_nonzero(rrb_realm(b)) ∧
    (rrb_anchor(b)=ps_anchor(h)) ∧ (rrb_installation(b)=ps_installation(h)) ∧ (rrb_policy(b)=ps_policy(h))

// A new guest reserves an incarnation BEFORE boot admission. An exact retry
// recovers the one retained durable outcome without incrementing any counter.
// No reply is needed for durability; admission reloads the actual durable head.
// Rejection is represented by unchanged state, not by a success predicate.
define rr110_reserve(c : A109Context,h : P109State,t : P109State,r : P109Request,a : P109Access,
    b : RR110Boot,capacity : Bool,durable : Bool) =
    if rr110_empty(b) ∧ (pr_kind(r)=bvconst(2,64)) ∧ a109_nonzero(ctx_challenge(c)) ∧
        (pr_attempt(r)=ctx_challenge(c)) ∧ (ps_anchor(h)=ctx_anchor(c)) ∧ (ps_installation(h)=ctx_installation(c)) ∧
        (p109_replay(c,h,r,a) ∨ ¬(pr_attempt(r)=ps_attempt(h)))
    then p109_step(c,h,r,a,capacity,durable,t)
    else p109_same(h,t)

// The freshness verifier independently binds ALL fields to current external
// evidence. Equality alone is not authentication. Unknown/invalid fails closed.
// 'bootstrap' is independently verified evidence for the exact selected A and
// its dependencies/metadata, including the trusted download infrastructure.
// It is not evidence that arbitrary target B may execute.
define rr110_fresh(c : A109Context,h : P109State,f : RR110Fresh) =
    (rrf_verdict(f)=A109Valid) ∧ (rrf_anchor(f)=ctx_anchor(c)) ∧ (rrf_installation(f)=ctx_installation(c)) ∧
    (rrf_policy(f)=ctx_epoch(c)) ∧ a109_nonzero(rrf_policy(f)) ∧
    (rrf_head(f)=ps_revision(h)) ∧ (rrf_selected(f)=ps_value(h)) ∧
    (rrf_boot(f)=ps_boot(h)) ∧ (rrf_attempt(f)=ctx_challenge(c)) ∧ a109_nonzero(rrf_realm(f))
define rr110_admit(c : A109Context,h : P109State,t : P109State,r : P109Request,a : P109Access,
    en : A109Enrollment,f : RR110Fresh,bootstrap : A109Verdict,b : RR110Boot,n : RR110Boot) =
    p109_same(h,t) ∧
    (if rr110_empty(b) ∧ rr110_fresh(c,h,f) ∧
        b109_admit(c,h,r,a,en,rrf_head(f),rrf_boot(f),rrf_verdict(f),bootstrap,rrb_active(b))
     then (rrb_anchor(n)=ctx_anchor(c)) ∧ (rrb_installation(n)=ctx_installation(c)) ∧ (rrb_policy(n)=ctx_epoch(c)) ∧
          (rrb_boot(n)=ps_boot(h)) ∧ (rrb_attempt(n)=ctx_challenge(c)) ∧ (rrb_realm(n)=rrf_realm(f)) ∧ rrb_active(n)
     else rr110_boot_same(b,n))

// Guest crash invalidates every volatile handle through the inactive boot root.
// It does NOT imply memory scrub, DMA drain, quota refund, or peer survival in
// the crashed guest. Cleanup still needs GD110/SR110 custody/drain/scrub gates.
// A service outside that guest survives; retained files and boot record survive.
define rr110_crash(h : P109State,t : P109State,m : SL110Artifact,n : SL110Artifact,
    v : RR110Service,w : RR110Service,next : RR110Boot) =
    p109_same(h,t) ∧ sl110_exact(m,n) ∧ rr110_service_same(v,w) ∧ rr110_empty(next)

// Service incarnation is independently authenticated CURRENT service identity,
// unique across restart/snapshot restore, not a local socket descriptor. Reopen
// invalidates channels, preserves the running guest and its unaffected peer.
// The same disk counter cannot supply anti-rollback for this identity either.
define rr110_reopen(h : P109State,t : P109State,m : SL110Artifact,n : SL110Artifact,
    b : RR110Boot,next : RR110Boot,v : RR110Service,w : RR110Service,
    incarnation : BitVec64,current : A109Verdict,peer : SL110Peer,next_peer : SL110Peer) =
    p109_same(h,t) ∧ sl110_exact(m,n) ∧ rr110_boot_same(b,next) ∧ sl110_peer_same(peer,next_peer) ∧
    (current=A109Valid) ∧ a109_nonzero(incarnation) ∧ ¬(incarnation=rrv_incarnation(v)) ∧
    (rrv_anchor(v)=ps_anchor(h)) ∧ (rrv_installation(v)=ps_installation(h)) ∧
    (rrv_anchor(w)=rrv_anchor(v)) ∧ (rrv_installation(w)=rrv_installation(v)) ∧
    (rrv_incarnation(w)=incarnation) ∧ (rrv_channel(w)=a109_z())
// Channel serials never wrap or reuse within one service incarnation. They may
// reuse numeric values in a new service: the qualified pair remains different.
define rr110_connect(v : RR110Service,w : RR110Service,channel : BitVec64,current : A109Verdict) =
    (current=A109Valid) ∧ a109_nonzero(rrv_anchor(v)) ∧ a109_nonzero(rrv_installation(v)) ∧
    a109_nonzero(rrv_incarnation(v)) ∧ bvult(rrv_channel(v),channel) ∧
    (rrv_anchor(w)=rrv_anchor(v)) ∧ (rrv_installation(w)=rrv_installation(v)) ∧
    (rrv_incarnation(w)=rrv_incarnation(v)) ∧ (rrv_channel(w)=channel)

// Tokens here denote actual captured runtime bindings; they are NOT wire fields
// a guest can synthesize. Owner incarnation zero is valid when actually current.
define rr110_session(b : RR110Boot,h : P109State,v : RR110Service,z : RR110Session,s : SR110State) =
    rr110_live(b,h) ∧ (rrv_anchor(v)=rrb_anchor(b)) ∧ (rrv_installation(v)=rrb_installation(b)) ∧
    a109_nonzero(rrv_incarnation(v)) ∧ a109_nonzero(rrv_channel(v)) ∧
    (rrz_boot(z)=rrb_boot(b)) ∧ (rrz_attempt(z)=rrb_attempt(b)) ∧ (rrz_realm(z)=rrb_realm(b)) ∧
    (rrz_service(z)=rrv_incarnation(v)) ∧ (rrz_channel(z)=rrv_channel(v)) ∧
    (srr_anchor(s)=rrb_anchor(b)) ∧ (srr_installation(s)=rrb_installation(b)) ∧
    (srr_revision(s)=ps_revision(h)) ∧ (srr_selected(s)=ps_value(h)) ∧
    a109_nonzero(rrz_owner(z)) ∧ sr110_owned(s,rrz_boot(z),rrz_ticket(z),rrz_owner(z),rrz_inc(z))
// Kind: process=1, socket=2, heap=3, admission=4, pointer=5, frame=6.
// The issuer must additionally verify current serial/generation, owner and
// permissions in its live table. This root check never issues a capability.
define rr110_handle(b : RR110Boot,h : P109State,k : RR110Handle,kind : BitVec64,
    owner : BitVec64,inc : BitVec64,issued : A109Verdict) =
    rr110_live(b,h) ∧ (issued=A109Valid) ∧ bvule(a109_one(),kind) ∧ bvule(kind,bvconst(6,64)) ∧
    (rrh_kind(k)=kind) ∧ a109_nonzero(rrh_serial(k)) ∧
    (rrh_boot(k)=rrb_boot(b)) ∧ (rrh_attempt(k)=rrb_attempt(b)) ∧ (rrh_realm(k)=rrb_realm(b)) ∧
    a109_nonzero(owner) ∧ (rrh_owner(k)=owner) ∧ (rrh_inc(k)=inc)

// Compose the actual GD110 authenticated EOF transition. It still needs exact
// framing, real EOF, content verification, bounded work and original deadline.
// Service restart cannot silently replace the captured session for an old reply.
define rr110_eof(b : RR110Boot,h : P109State,v : RR110Service,z : RR110Session,
    s : SR110State,t : SR110State,x : GD110Exchange,y : GD110Exchange,q : AR110Request,echo : AR110Request,
    e : GD110Observation,magic : BitVec64,version : BitVec64,echo_length : BitVec64,count : BitVec64,eof : Bool) =
    rr110_session(b,h,v,z,s) ∧ (gdx_channel(x)=rrz_channel(z)) ∧
    gd110_eof(s,t,x,y,q,echo,e,magic,version,echo_length,count,eof)

// Ordinary launch B uses freshly checked read+dependency evidence AND actual
// T1 execute admission. The trusted execute binding attests the identity's
// mapping to THIS boot/realm/custodian; identity equality from a prior boot is
// insufficient. Boot selection A and every durable field remain unchanged.
// Denied owned SR110 admission moves to closing, preserving charge until scrub.
define rr110_launch(b : RR110Boot,v : RR110Service,z : RR110Session,h : P109State,nh : P109State,
    s : SR110State,t : SR110State,c : A109Context,e : A109Identity,en : A109Enrollment,g : A109Grant,q : A109Request,
    ad : A109Admission,expected : BitVec64,next_ad : A109Admission,read : A109Verdict,dependencies : A109Verdict,
    execute_binding : A109Verdict,fresh : Bool,tags_clean : Bool,sealed : Bool,drained : Bool,layout : Bool) =
    p109_same(h,nh) ∧ rr110_session(b,h,v,z,s) ∧ (ctx_epoch(c)=rrb_policy(b)) ∧
    sr110_launch(s,t,rrz_boot(z),rrz_ticket(z),rrz_owner(z),rrz_inc(z),rrb_boot(b),rrb_active(b),ctx_now(c),read,dependencies,
        c,e,en,g,q,ad,expected,next_ad,(fresh ∧ (execute_binding=A109Valid)),tags_clean,sealed,drained,layout)



// A retired realm may remain charged after guest death. Cleanup uses its actual
// retained custody token, not a live read/execute grant or a new realm's ledger.
// Foreign/invalid custody leaves the whole state unchanged. Revocation, physical
// drain and scrub must all complete before the existing SR110 release refunds.
define rr110_release(realm : BitVec64,z : RR110Session,custody : A109Verdict,s : SR110State,t : SR110State,
    revoked : Bool,drained : Bool,scrubbed : Bool) =
    if (custody=A109Valid) ∧ a109_nonzero(realm) ∧ (realm=rrz_realm(z))
    then sr110_release(s,t,rrz_boot(z),rrz_ticket(z),rrz_owner(z),rrz_inc(z),revoked,drained,scrubbed)
    else sr110_same(s,t)

// Concrete scenario: bootstrap A=55, retained target B=40, peer C=6.
