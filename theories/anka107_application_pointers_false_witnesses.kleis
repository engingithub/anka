example "FALSE-P107-24 opposite last byte" {
    assert(¬app107_range_valid(bvconst(15,64),bvconst(16,64),bvconst(1,64)))
}

example "FALSE-P107-25 opposite last word" {
    assert(¬app107_range_valid(bvconst(8,64),bvconst(16,64),bvconst(8,64)))
}

example "FALSE-P107-26 opposite one past access" {
    assert(app107_range_valid(bvconst(16,64),bvconst(16,64),bvconst(1,64)))
}

example "FALSE-P107-27 opposite cross extent" {
    assert(app107_range_valid(bvconst(12,64),bvconst(16,64),bvconst(8,64)))
}

example "FALSE-P107-28 opposite zero width" {
    assert(app107_range_valid(bvconst(0,64),bvconst(16,64),bvconst(0,64)))
}

example "FALSE-P107-29 opposite offset outside extent" {
    assert(app107_range_valid(bvconst(17,64),bvconst(16,64),bvconst(1,64)))
}

example "FALSE-P107-30 opposite huge width wrap attempt" {
    assert(app107_range_valid(bvconst(8,64),bvconst(16,64),bvsub(bvconst(0,64),bvconst(1,64))))
}

example "FALSE-P107-31 opposite char pointer byte scaling" {
    assert(¬app107_forward_step_valid(bvconst(0,64),bvconst(16,64),bvconst(16,64),bvconst(1,64)))
}

