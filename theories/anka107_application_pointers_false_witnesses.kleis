// Deliberately false assertions; every one must be explicitly disproved.
import "anka107_application_pointers.kleis"

example "FALSE-P107-1 opposite typed application profile" {
    assert(app107_profile_valid(true,false)=false)
}

example "FALSE-P107-2 opposite bootstrap exception rejected" {
    assert(app107_profile_valid(true,true)=true)
}

example "FALSE-P107-3 opposite unselected profile rejected" {
    assert(app107_profile_valid(false,false)=true)
}

example "FALSE-P107-4 opposite matching pointer assignment" {
    assert(app107_pointer_assignment_valid(true,true,false)=false)
}

example "FALSE-P107-5 opposite mismatched pointee rejected" {
    assert(app107_pointer_assignment_valid(true,false,false)=true)
}

example "FALSE-P107-6 opposite implicit integer conversion rejected" {
    assert(app107_pointer_assignment_valid(true,true,true)=true)
}

example "FALSE-P107-7 opposite integer dereference rejected" {
    assert(app107_pointer_assignment_valid(false,true,false)=true)
}

example "FALSE-P107-9 accept missing boundary_declared" {
    assert(app107_typed_boundary_valid(false,true,true,true,true)=true)
}

example "FALSE-P107-10 accept missing signature_exact" {
    assert(app107_typed_boundary_valid(true,false,true,true,true)=true)
}

example "FALSE-P107-11 accept missing typed_pointer_result" {
    assert(app107_typed_boundary_valid(true,true,false,true,true)=true)
}

example "FALSE-P107-12 accept missing explicit_address_contract" {
    assert(app107_typed_boundary_valid(true,true,true,false,true)=true)
}

example "FALSE-P107-13 accept missing fabric_checks_preserved" {
    assert(app107_typed_boundary_valid(true,true,true,true,false)=true)
}

example "FALSE-P107-15 accept missing range_valid" {
