    assert(a22_installed(
        bvconst(7,64),bvconst(1,64),bvconst(0,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),
        bvconst(1,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(1,64),bvconst(1,64),
