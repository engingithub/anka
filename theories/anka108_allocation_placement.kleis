example "all projections stutter after physical preparation" {
    assert(let commit = a22_admit(
        bvconst(1,64),bvconst(4096,64),bvconst(7,64),bvconst(7,64),bvconst(7,64),bvconst(0,8),
        bvconst(4,64),bvconst(6,64),bvconst(4,64),bvconst(1,64),bvconst(0,64),bvconst(4096,64),
        bvconst(16384,64),bvconst(4096,64),bvconst(16384,64),bvconst(4,64),bvconst(6,64),bvconst(0,64),
        bvconst(1,64),bvconst(0,64),bvconst(65536,64),bvconst(16384,64),bvconst(65536,64),bvconst(16384,64),
        bvconst(1,64),bvconst(4,64),bvconst(0,64),bvconst(0,8),bvconst(0,64),bvconst(4,64),
        bvconst(0,8),bvconst(1,64),bvconst(1064,64),bvconst(0,64),bvconst(65536,64),bvconst(0,64),
        bvconst(32768,64),bvconst(5,64),bvconst(5,64),bvconst(5,64),bvconst(5,64),bvconst(5,64),
        bvconst(1,8)) in
        ((a22_charge_after(commit,bvconst(8192,64),bvconst(4096,64))=bvconst(8192,64)) ∧ (a22_charge_after(commit,bvconst(4096,64),bvconst(4096,64))=bvconst(4096,64)) ∧ (a22_count_after(commit,bvconst(2,64))=bvconst(2,64)) ∧ (a22_count_after(commit,bvconst(1,64))=bvconst(1,64)) ∧ (a22_holes_after(commit,bvconst(3,64),bvconst(4096,64),bvconst(4096,64))=bvconst(3,64)) ∧ (a22_holes_after(commit,bvconst(2,64),bvconst(8192,64),bvconst(4096,64))=bvconst(2,64)) ∧ (a22_state_after(commit,bvconst(0,8))=bvconst(0,8)) ∧ (a22_count_after(commit,bvconst(9,64))=bvconst(9,64)) ∧ (a22_count_after(commit,bvconst(5,64))=bvconst(5,64)) ∧ (a22_row(commit,bvconst(1,64),bvconst(1,64),bvconst(4096,64),bvconst(8192,64))=bvconst(4096,64)) ∧ (a22_row(commit,bvconst(1,64),bvconst(1,64),bvconst(65536,64),bvconst(69632,64))=bvconst(65536,64))))
}

