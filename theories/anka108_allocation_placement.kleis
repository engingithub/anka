example "cancellation refunds exactly once and leaves other owner charged" {
    assert(let release = a22_cancel(
        bvconst(7,64),bvconst(1,64),bvconst(1,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),
        bvconst(1,64),bvconst(1,64),bvconst(1,8),bvconst(0,8),bvconst(0,8),bvconst(1,8),
        bvconst(1,8),bvconst(1,8),bvconst(4096,64),bvconst(4096,64),bvconst(12288,64),bvconst(4096,64),
        bvconst(6,64),bvconst(6,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,64),
        bvconst(1,64),bvconst(4096,64),bvconst(4096,64),bvconst(4096,64),bvconst(7,64),bvconst(1,64),
        bvconst(1,64),bvconst(1,64),bvconst(65536,64),bvconst(4096,64),bvconst(65536,64),bvconst(7,64),
        bvconst(1,64),bvconst(1,64),bvconst(1,64)) in
        ((a22_refund(release,bvconst(12288,64),bvconst(4096,64))=bvconst(8192,64)) ∧ (a22_refund(release,bvconst(4096,64),bvconst(4096,64))=bvconst(0,64)) ∧ (a22_count_release(release,bvconst(2,64))=bvconst(1,64)) ∧ (a22_cancel_state(release,bvconst(1,8),bvconst(1,64))=bvconst(0,8))))
}

example "duplicate cancellation cannot refund again" {
    assert(let release = a22_cancel(
        bvconst(7,64),bvconst(1,64),bvconst(1,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),
        bvconst(1,64),bvconst(1,64),bvconst(0,8),bvconst(0,8),bvconst(0,8),bvconst(0,8),
        bvconst(0,8),bvconst(0,8),bvconst(4096,64),bvconst(4096,64),bvconst(8192,64),bvconst(0,64),
        bvconst(7,64),bvconst(7,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,64),
        bvconst(1,64),bvconst(4096,64),bvconst(4096,64),bvconst(4096,64),bvconst(7,64),bvconst(1,64),
        bvconst(1,64),bvconst(1,64),bvconst(65536,64),bvconst(4096,64),bvconst(65536,64),bvconst(7,64),
        bvconst(1,64),bvconst(1,64),bvconst(1,64)) in
        (¬(release) ∧ (a22_refund(release,bvconst(8192,64),bvconst(4096,64))=bvconst(8192,64))))
}

