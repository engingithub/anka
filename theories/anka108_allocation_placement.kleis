        bvconst(0,8),bvsub(ptr107_max(),bvconst(1,64)),bvconst(1064,64),bvconst(0,64),bvconst(65536,64),bvconst(0,64),
        bvconst(32768,64),bvsub(ptr107_max(),bvconst(1,64)),bvsub(ptr107_max(),bvconst(1,64)),bvsub(ptr107_max(),bvconst(1,64)),bvsub(ptr107_max(),bvconst(1,64)),bvsub(ptr107_max(),bvconst(1,64)),
        bvconst(1,8)))
}

