        bvconst(16384,64),a22_false(),bvconst(0,64),bvconst(0,64),a22_true(),bvconst(16384,64),
        bvconst(4096,64),bvconst(4,64),bvconst(6,64),bvconst(1,64),bvconst(1,64),bvconst(0,64),
        bvconst(65536,64),bvconst(16384,64),a22_false(),bvconst(0,64),bvconst(0,64),a22_true(),
        bvconst(69632,64),bvconst(12288,64))) in
        (a ∧ b ∧ release ∧ (a22_refund(release,bvconst(12288,64),bvconst(4096,64))=bvconst(8192,64)) ∧ (a22_row(release,bvconst(1,64),bvconst(2,64),bvconst(8192,64),bvconst(0,64))=bvconst(8192,64)) ∧ (a22_row(release,bvconst(7,64),bvconst(8,64),bvconst(8192,64),bvconst(0,64))=bvconst(8192,64)) ∧ ¬(a22_right_join(a22_true(),bvconst(16384,64),bvconst(4096,64),bvconst(4096,64))) ∧ (a22_coalesced_holes(bvconst(1,64),a22_false(),a22_false())=bvconst(2,64)) ∧ (a22_return_size(bvconst(4096,64),bvconst(0,64),bvconst(12288,64),a22_false(),a22_true())=bvconst(16384,64)) ∧ (a22_cleanup_revision(bvconst(8,64))=bvconst(9,64))))
}

example "return B after A recovers full physical and B virtual arenas" {
    assert(let release = (a22_cancel(
        bvconst(8,64),bvconst(2,64),bvconst(1,64),bvconst(2,64),bvconst(8,64),bvconst(2,64),
        bvconst(1,64),bvconst(2,64),bvconst(1,8),bvconst(0,8),bvconst(0,8),bvconst(1,8),
        bvconst(1,8),bvconst(1,8),bvconst(8192,64),bvconst(8192,64),bvconst(8192,64),bvconst(8192,64),
        bvconst(9,64),bvconst(9,64),bvconst(1,8),bvconst(8,64),bvconst(2,64),bvconst(1,64),
        bvconst(2,64),bvconst(8192,64),bvconst(8192,64),bvconst(8192,64),bvconst(8,64),bvconst(2,64),
        bvconst(1,64),bvconst(2,64),bvconst(131072,64),bvconst(8192,64),bvconst(131072,64),bvconst(8,64),
        bvconst(2,64),bvconst(1,64),bvconst(2,64)) ∧ a22_return_pair(
        bvconst(8192,64),bvconst(131072,64),bvconst(8192,64),bvconst(8192,64),bvconst(131072,64),bvconst(8192,64),
        bvconst(4,64),bvconst(6,64),bvconst(1,64),bvconst(2,64),bvconst(1,64),bvconst(4096,64),
        bvconst(16384,64),a22_true(),bvconst(4096,64),bvconst(4096,64),a22_true(),bvconst(16384,64),
        bvconst(4096,64),bvconst(4,64),bvconst(6,64),bvconst(1,64),bvconst(1,64),bvconst(0,64),
        bvconst(131072,64),bvconst(16384,64),a22_false(),bvconst(0,64),bvconst(0,64),a22_true(),
        bvconst(139264,64),bvconst(8192,64))) in
        (release ∧ (a22_refund(release,bvconst(8192,64),bvconst(8192,64))=bvconst(0,64)) ∧ (a22_count_release(release,bvconst(1,64))=bvconst(0,64)) ∧ (a22_return_base(bvconst(8192,64),bvconst(4096,64),a22_true())=bvconst(4096,64)) ∧ (a22_return_size(bvconst(8192,64),bvconst(4096,64),bvconst(4096,64),a22_true(),a22_true())=bvconst(16384,64)) ∧ (a22_coalesced_holes(bvconst(2,64),a22_true(),a22_true())=bvconst(1,64)) ∧ (a22_return_size(bvconst(8192,64),bvconst(0,64),bvconst(8192,64),a22_false(),a22_true())=bvconst(16384,64)) ∧ a22_counts(bvconst(4,64),bvconst(6,64),bvconst(0,64),bvconst(1,64))))
}

example "reusing A physical hole consumes fresh identity and B virtual space" {
    assert(let commit = a22_admit(
        bvconst(1,64),bvconst(4096,64),bvconst(8,64),bvconst(8,64),bvconst(8,64),bvconst(0,8),
        bvconst(4,64),bvconst(6,64),bvconst(1,64),bvconst(2,64),bvconst(0,64),bvconst(4096,64),
        bvconst(4096,64),bvconst(4096,64),bvconst(16384,64),bvconst(4,64),bvconst(6,64),bvconst(1,64),
        bvconst(1,64),bvconst(0,64),bvconst(139264,64),bvconst(8192,64),bvconst(131072,64),bvconst(16384,64),
        bvconst(1,64),bvconst(4,64),bvconst(1,64),bvconst(0,8),bvconst(0,64),bvconst(4,64),
        bvconst(0,8),bvconst(3,64),bvconst(1224,64),bvconst(8192,64),bvconst(65536,64),bvconst(8192,64),
        bvconst(32768,64),bvconst(9,64),bvconst(9,64),bvconst(9,64),bvconst(9,64),bvconst(9,64),
        bvconst(1,8)) in
        (commit ∧ (a22_count_after(commit,bvconst(1,64))=bvconst(2,64)) ∧ (a22_count_after(commit,bvconst(3,64))=bvconst(4,64)) ∧ (a22_holes_after(commit,bvconst(2,64),bvconst(4096,64),bvconst(4096,64))=bvconst(1,64)) ∧ (a22_charge_after(commit,bvconst(8192,64),bvconst(4096,64))=bvconst(12288,64)) ∧ (a22_authority_after_reservation()=bvconst(0,8))))
}

example "new private reservation does not authorize an old owner token" {
    assert(¬(a22_cancel(
        bvconst(7,64),bvconst(1,64),bvconst(1,64),bvconst(1,64),bvconst(8,64),bvconst(1,64),
        bvconst(2,64),bvconst(3,64),bvconst(1,8),bvconst(0,8),bvconst(0,8),bvconst(1,8),
        bvconst(1,8),bvconst(1,8),bvconst(4096,64),bvconst(4096,64),bvconst(12288,64),bvconst(4096,64),
        bvconst(6,64),bvconst(6,64),bvconst(1,8),bvconst(8,64),bvconst(1,64),bvconst(2,64),
        bvconst(3,64),bvconst(4096,64),bvconst(4096,64),bvconst(4096,64),bvconst(8,64),bvconst(1,64),
        bvconst(2,64),bvconst(3,64),bvconst(65536,64),bvconst(4096,64),bvconst(65536,64),bvconst(8,64),
        bvconst(1,64),bvconst(2,64),bvconst(3,64))))
}

example "law insertion workspace is always bounded" {
    assert(∀(k : BitVec64). ∀(cap : BitVec64). ∀(c : BitVec64). ∀(n : BitVec64). ∀(i : BitVec64). (a22_insert(k,cap,c,n,i)) → ((bvule(a22_insert_holes(n),cap) ∧ bvugt(a22_insert_holes(n),n))))
}

example "law maximum encoded capacity plus workspace cannot wrap" {
    assert(∀(k : BitVec64). ∀(cap : BitVec64). (a22_capacity(k,cap)) → (bvugt(bvadd(k,bvconst(2,64)),k)))
}

example "law take preserves canonical count bound" {
    assert(∀(k : BitVec64). ∀(cap : BitVec64). ∀(c : BitVec64). ∀(n : BitVec64). ∀(length : BitVec64). ∀(amount : BitVec64). ((a22_counts(k,cap,c,n) ∧ bvult(c,k) ∧ bvugt(n,bvconst(0,64)) ∧ bvugt(amount,bvconst(0,64)) ∧ bvule(amount,length))) → (a22_counts(k,cap,bvadd(c,bvconst(1,64)),a22_take_holes(n,length,amount))))
}

example "law erase reads an active old row" {
    assert(∀(n : BitVec64). ∀(i : BitVec64). ∀(q : BitVec64). ((bvugt(n,bvconst(0,64)) ∧ bvult(i,n) ∧ bvult(q,bvsub(n,bvconst(1,64))))) → ((bvult(a22_erase_source(q,i),n) ∧ ¬((a22_erase_source(q,i)=i)))))
}

example "law insert reads an active old row except new slot" {
    assert(∀(n : BitVec64). ∀(i : BitVec64). ∀(q : BitVec64). ((bvult(n,ptr107_max()) ∧ bvule(i,n) ∧ bvult(q,bvadd(n,bvconst(1,64))) ∧ ¬((q=i)))) → (bvult(a22_insert_source(q,i),n)))
}

example "law erase then insert index inverse" {
    assert(∀(n : BitVec64). ∀(i : BitVec64). ∀(q : BitVec64). ((bvugt(n,bvconst(0,64)) ∧ bvult(i,n) ∧ bvult(q,bvsub(n,bvconst(1,64))))) → ((a22_insert_source(a22_erase_source(q,i),i)=q)))
}

example "law insert then erase index inverse" {
    assert(∀(n : BitVec64). ∀(i : BitVec64). ∀(q : BitVec64). ((bvult(n,ptr107_max()) ∧ bvule(i,n) ∧ bvult(q,bvadd(n,bvconst(1,64))) ∧ ¬((q=i)))) → ((a22_erase_source(a22_insert_source(q,i),i)=q)))
}

example "law erase shift cannot duplicate a row" {
    assert(∀(n : BitVec64). ∀(i : BitVec64). ∀(q : BitVec64). ∀(r : BitVec64). ((bvugt(n,bvconst(0,64)) ∧ bvult(i,n) ∧ bvult(q,bvsub(n,bvconst(1,64))) ∧ bvult(r,bvsub(n,bvconst(1,64))) ∧ ¬((q=r)))) → (¬((a22_erase_source(q,i)=a22_erase_source(r,i)))))
}

example "law insert shift cannot duplicate a surviving row" {
    assert(∀(n : BitVec64). ∀(i : BitVec64). ∀(q : BitVec64). ∀(r : BitVec64). (((bvult(n,ptr107_max()) ∧ bvule(i,n) ∧ bvult(q,bvadd(n,bvconst(1,64))) ∧ ¬((q=i))) ∧ bvult(r,bvadd(n,bvconst(1,64))) ∧ ¬((r=i)) ∧ ¬((q=r)))) → (¬((a22_insert_source(q,i)=a22_insert_source(r,i)))))
}

example "law prefix take preserves selected end" {
    assert(∀(b : BitVec64). ∀(length : BitVec64). ∀(amount : BitVec64). ∀(i : BitVec64). (bvadd(a22_partial_base(i,i,b,amount),a22_partial_size(i,i,length,amount))=bvadd(b,length)))
}

example "law partial take cannot leave a zero length hole" {
    assert(∀(length : BitVec64). ∀(amount : BitVec64). (bvult(amount,length)) → (bvugt(bvsub(length,amount),bvconst(0,64))))
}

example "law prefix take preserves all other row fields" {
    assert(∀(q : BitVec64). ∀(i : BitVec64). ∀(b : BitVec64). ∀(length : BitVec64). ∀(amount : BitVec64). (¬((q=i))) → (((a22_partial_base(q,i,b,amount)=b) ∧ (a22_partial_size(q,i,length,amount)=length))))
}

example "law coalescing uses no more than insertion capacity" {
    assert(∀(n : BitVec64). ∀(l : Bool). ∀(r : Bool). ((bvult(n,ptr107_max()) ∧ ((l ∨ r) → bvuge(n,bvconst(1,64))) ∧ ((l ∧ r) → bvuge(n,bvconst(2,64))))) → (bvule(a22_coalesced_holes(n,l,r),bvadd(n,bvconst(1,64)))))
}

example "law selected reservation leaves other records unchanged" {
    assert(∀(s : BitVec64). ∀(q : BitVec64). ∀(before : BitVec64). ∀(after : BitVec64). ∀(commit : Bool). (¬((s=q))) → ((a22_row(commit,s,q,before,after)=before)))
}

example "law rejected admission preserves counts and bytes" {
    assert(∀(n : BitVec64). ∀(b : BitVec64). ∀(amount : BitVec64). ∀(length : BitVec64). ((a22_count_after(a22_false(),n)=n) ∧ (a22_charge_after(a22_false(),b,amount)=b) ∧ (a22_holes_after(a22_false(),n,length,amount)=n)))
}

example "law commit state is reserved exactly on success" {
    assert(∀(commit : Bool). ((a22_state_after(commit,bvconst(0,8))=bvconst(1,8))=commit))
}

example "law physical and virtual claim counts advance together" {
    assert(∀(p : BitVec64). ∀(v : BitVec64). ∀(commit : Bool). ((bvult(p,ptr107_max()) ∧ bvult(v,ptr107_max()))) → ((bvsub(a22_count_after(commit,p),p)=bvsub(a22_count_after(commit,v),v))))
}

example "law admitted budget supplies both residual bounds" {
    assert(∀(amount : BitVec64). ∀(fixed : BitVec64). ∀(used : BitVec64). ∀(ceiling : BitVec64). ∀(own : BitVec64). ∀(limit : BitVec64). (a22_budget(amount,fixed,used,ceiling,own,limit)) → ((a22_fits(bvadd(fixed,used),amount,ceiling) ∧ a22_fits(own,amount,limit))))
}

example "law each residual bound preserves its ceiling" {
    assert(∀(used : BitVec64). ∀(amount : BitVec64). ∀(limit : BitVec64). (a22_fits(used,amount,limit)) → ((bvule(bvadd(used,amount),limit) ∧ bvule(used,bvadd(used,amount)))))
}

example "law admitted charge addition does not wrap" {
    assert(∀(amount : BitVec64). ∀(fixed : BitVec64). ∀(used : BitVec64). ∀(ceiling : BitVec64). ∀(own : BitVec64). ∀(limit : BitVec64). (a22_budget(amount,fixed,used,ceiling,own,limit)) → ((bvugt(bvadd(used,amount),used) ∧ bvugt(bvadd(own,amount),own))))
}

example "law actual 16 byte rows cannot be charged as fewer rows" {
    assert(∀(actual : BitVec64). ∀(requested : BitVec64). ∀(bytes : BitVec64). ((a22_storage(actual,bvconst(16,64),bytes) ∧ bvult(requested,actual))) → (bvugt(bytes,bvmul(requested,bvconst(16,64)))))
}

example "law fixed charge is the exact sum of all six regions" {
    assert(∀(old : BitVec64). ∀(p : BitVec64). ∀(v : BitVec64). ∀(claims : BitVec64). ∀(arenas : BitVec64). ∀(scratch : BitVec64). ∀(total : BitVec64). (a22_fixed(old,p,v,claims,arenas,scratch,total)) → ((total=bvadd(bvadd(bvadd(bvadd(bvadd(old,p),v),claims),arenas),scratch))))
}

example "law each checked fixed charge step retains old and new bytes" {
    assert(∀(before : BitVec64). ∀(extra : BitVec64). (a22_add(before,extra)) → ((bvule(before,bvadd(before,extra)) ∧ (bvsub(bvadd(before,extra),before)=extra))))
}

example "law successful admission invalidates every old plan stamp" {
    assert(∀(r : BitVec64). (bvult(r,ptr107_max())) → (¬(a22_snapshot(bvadd(r,bvconst(1,64)),r,r,r,r,bvconst(1,8)))))
}

example "law terminal revision cannot admit any plan" {
    assert(∀(e : BitVec64). ∀(p : BitVec64). ∀(v : BitVec64). ∀(m : BitVec64). ¬(a22_snapshot(ptr107_max(),e,p,v,m,bvconst(1,8))))
}

example "law cleanup revision never decreases" {
    assert(∀(r : BitVec64). bvule(r,a22_cleanup_revision(r)))
}

example "law exact binding includes owner generation and job" {
    assert(∀(o : BitVec64). ∀(s : BitVec64). ∀(g : BitVec64). ∀(j : BitVec64). ∀(ro : BitVec64). ∀(rs : BitVec64). ∀(rg : BitVec64). ∀(rj : BitVec64). (a22_binding(o,s,g,j,ro,rs,rg,rj)) → (((o=ro) ∧ (s=rs) ∧ (g=rg) ∧ (j=rj))))
}

example "law construction supplies the same fresh key to all four records" {
    assert(∀(o : BitVec64). ∀(s : BitVec64). ∀(g : BitVec64). ∀(j : BitVec64). ((bvugt(o,bvconst(0,64)) ∧ bvugt(s,bvconst(0,64)) ∧ bvule(s,bvconst(4294967295,64)) ∧ bvult(g,bvconst(4294967295,64)) ∧ bvugt(j,bvconst(0,64)) ∧ bvult(j,ptr107_max()))) → (a22_installed(o,s,g,j,o,s,bvadd(g,bvconst(1,64)),j,o,s,bvadd(g,bvconst(1,64)),j,o,s,bvadd(g,bvconst(1,64)),j,o,s,bvadd(g,bvconst(1,64)),j)))
}

example "law stale generation cannot select a reused row" {
    assert(∀(o : BitVec64). ∀(s : BitVec64). ∀(g : BitVec64). ∀(j : BitVec64). ∀(newer : BitVec64). (¬((g=newer))) → (¬(a22_binding(o,s,g,j,o,s,newer,j))))
}

example "law cancellation refunds exactly the held amount" {
    assert(∀(used : BitVec64). ∀(amount : BitVec64). (bvule(amount,used)) → ((bvadd(a22_refund(a22_true(),used,amount),amount)=used)))
}

example "law rejected cancellation preserves charge and state" {
    assert(∀(used : BitVec64). ∀(amount : BitVec64). ∀(gen : BitVec64). ∀(phase : BitVec8). ((a22_refund(a22_false(),used,amount)=used) ∧ (a22_cancel_state(a22_false(),phase,gen)=phase)))
}

example "law cancellation preserves other owner charge" {
    assert(∀(used : BitVec64). ∀(own : BitVec64). ∀(other : BitVec64). ∀(amount : BitVec64). ((bvule(own,used) ∧ bvule(other,bvsub(used,own)) ∧ bvule(amount,own))) → (bvule(other,a22_refund(a22_true(),used,amount))))
}

example "law reserve cancel cycle restores payload quota" {
    assert(∀(used : BitVec64). ∀(amount : BitVec64). (bvule(amount,bvsub(ptr107_max(),used))) → ((a22_refund(a22_true(),a22_charge_after(a22_true(),used,amount),amount)=used)))
}

example "law exhausted generation remains exhausted on cancel" {
    assert( (a22_cancel_state(a22_true(),bvconst(1,8),bvconst(4294967295,64))=bvconst(4,8)))
}

example "law reused slot has a different protected handle" {
    assert(∀(s : BitVec64). ∀(g : BitVec64). ((repr107_components(s,g) ∧ bvult(g,bvconst(4294967295,64)))) → (¬((repr107_handle(s,g)=repr107_handle(s,bvadd(g,bvconst(1,64)))))))
}
