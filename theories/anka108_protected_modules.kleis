    assert(pm108_after(pm108_publish((bvconst(0,8)=bvconst(1,8)),bvconst(1,8),bvconst(3,64),bvconst(3,64),bvconst(99,64),bvconst(1,64),bvconst(11,64),bvconst(12,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)),bvconst(77,64),bvconst(99,64))=bvconst(77,64))
}

example "PM108 failed link preserves previous receipt" {
    assert(pm108_after(pm108_publish((bvconst(0,8)=bvconst(1,8)),bvconst(1,8),bvconst(3,64),bvconst(3,64),bvconst(99,64),bvconst(1,64),bvconst(11,64),bvconst(12,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)),bvconst(177,64),bvconst(199,64))=bvconst(177,64))
}

example "PM108 rejects failed link advances epoch" {
    assert(¬(pm108_epoch(pm108_publish((bvconst(0,8)=bvconst(1,8)),bvconst(1,8),bvconst(3,64),bvconst(3,64),bvconst(99,64),bvconst(1,64),bvconst(11,64),bvconst(12,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)),bvconst(3,64))=bvconst(4,64)))
}

example "PM108 universal frame remapping stays inside final table" {
    assert(∀(p : BitVec64). ∀(i : BitVec64). ∀(n : BitVec64). ∀(t : BitVec64). ∀(g : BitVec64).
        pm108_frame_index(p,i,n,t,g) → bvult(g,t))
}

example "PM108 universal frame remapping is injective within each module" {
    assert(∀(p : BitVec64). ∀(i : BitVec64). ∀(j : BitVec64). ∀(n : BitVec64). ∀(t : BitVec64). ∀(g : BitVec64).
        (pm108_frame_index(p,i,n,t,g) ∧ pm108_frame_index(p,j,n,t,g)) → (i=j))
}

example "PM108 universal successive module frame ranges cannot alias" {
    assert(∀(p : BitVec64). ∀(n : BitVec64). ∀(i : BitVec64). ∀(j : BitVec64). ∀(m : BitVec64). ∀(t : BitVec64). ∀(a : BitVec64). ∀(b : BitVec64).
        (pm108_frame_index(p,i,n,t,a) ∧ pm108_frame_index(bvadd(p,n),j,m,t,b)) → bvult(a,b))
}

example "PM108 universal checked frame index fits PFRAME immediate" {
    assert(∀(p : BitVec64). ∀(i : BitVec64). ∀(n : BitVec64). ∀(t : BitVec64). ∀(g : BitVec64).
        pm108_frame_index(p,i,n,t,g) → bvult(g,bvconst(67108864,64)))
}

example "PM108 universal frame range rebasing preserves its extent" {
    assert(∀(b : BitVec64). ∀(c : BitVec64). ∀(s : BitVec64). ∀(e : BitVec64). ∀(os : BitVec64). ∀(oe : BitVec64).
        pm108_frame_range(b,c,s,e,os,oe) → (bvsub(oe,os)=bvsub(e,s)))
}

example "PM108 universal representable CALL encode decode roundtrip" {
    assert(∀(pc : BitVec64). ∀(target : BitVec64).
        pm108_displacement(pc,target) → (pm108_call_target(pc,pm108_call_word(pc,target))=target))
}

example "PM108 universal uniform code rebasing preserves local CALL encoding" {
    assert(∀(b : BitVec64). ∀(pc : BitVec64). ∀(target : BitVec64).
        (pm108_aligned8(b) ∧ pm108_displacement(pc,target) ∧ bvule(pc,bvsub(ptr107_max(),b)) ∧ bvule(target,bvsub(ptr107_max(),b))) →
        (pm108_call_word(bvadd(b,pc),bvadd(b,target))=pm108_call_word(pc,target)))
}

example "PM108 universal dependency fold cannot skip completion positions" {
    assert(∀(n : BitVec64). ∀(d : BitVec64). ∀(i : BitVec64). ∀(next : BitVec64).
        pm108_consume(n,d,i,bvconst(1,8),next) → ((i=d) ∧ bvule(next,n) ∧ bvugt(next,d)))
}

example "PM108 universal failure preserves every existing visible field" {
    assert(∀(old : BitVec64). ∀(staged : BitVec64). pm108_after((bvconst(0,8)=bvconst(1,8)),old,staged)=old)
}

example "PM108 universal same decision exposes artifact and receipt together" {
    assert(∀(commit : Bool). ∀(a : BitVec64). ∀(r : BitVec64). ∀(na : BitVec64). ∀(nr : BitVec64).
        ((pm108_after(commit,a,na)=na) ∧ (pm108_after(commit,r,nr)=nr)) ∨
        ((pm108_after(commit,a,na)=a) ∧ (pm108_after(commit,r,nr)=r)))
}

example "PM108 universal relocatable modules never satisfy execution admission" {
    assert(∀(u : BitVec64). ∀(r : BitVec64). ¬(pm108_execute(bvconst(1,8),u,r,(bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8)))))
}

example "PM108 universal successful publication cannot wrap the epoch" {
    assert(∀(e : BitVec64). pm108_publish((bvconst(1,8)=bvconst(1,8)),bvconst(1,8),e,e,bvconst(99,64),bvconst(1,64),bvconst(11,64),bvconst(12,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)) → bvugt(pm108_epoch((bvconst(1,8)=bvconst(1,8)),e),e))
}
