}

example "PM108 publication advances one epoch" {
    assert(pm108_epoch(pm108_publish(pm108_ready(bvconst(2,64),bvconst(2,64),bvconst(0,64),bvconst(0,64),bvconst(2,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,8)),bvconst(1,8),bvconst(3,64),bvconst(3,64),bvconst(99,64),bvconst(1,64),bvconst(11,64),bvconst(12,64),bvconst(1,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)),bvconst(3,64))=bvconst(4,64))
}

