// GD110: guest-driven, bounded multi-range download into SR110 private custody.
// No new axioms. AR110 wire bytes and AT110/GA110 upload behavior are unchanged.
// Runtime refinement obligations: derive observations from the actual owner,
// typed pointers, socket/NIC, reservation ledger and serialized evidence lane.
// Neither guest return codes nor wire fields may supply these observations.
// This models permitted transitions; rejected operations must not mutate either
// state. The adapter closes its owned lane on fatal errors using gd110_cancel.
// No new execution grant, publication, durable selection or reboot is modeled.
import "anka110_artifact_read.kleis"

// 0 reserved/unopened, 1 sending, 2 receiving, 3 EOF-validated, 4 closing,
// 5 range committed, 6 scratch released. Private image custody is separate.
data GD110Exchange = GD110Exchange(phase : BitVec64,boot : BitVec64,ticket : BitVec64,owner : BitVec64,inc : BitVec64,channel : BitVec64,correlation : BitVec64,offset : BitVec64,count : BitVec64,accepted : BitVec64,sent : BitVec64,received : BitVec64,clock : BitVec64,charge : BitVec64)
data GD110Observation = GD110Observation(boot : BitVec64,live : Bool,now : BitVec64,channel : BitVec64,server : A109Verdict,read : A109Verdict,content : A109Verdict,bound : Bool,typed : Bool,lane : Bool,accounted : A109Verdict,exact : Bool)

// Selectors and complete frame relations follow below. No omitted field may
// change implicitly, including the monotone correlation and local ticket.
define gdx_phase(s : GD110Exchange) = match s { GD110Exchange(phase,boot,ticket,owner,inc,channel,correlation,offset,count,accepted,sent,received,clock,charge) => phase }
define gdx_boot(s : GD110Exchange) = match s { GD110Exchange(phase,boot,ticket,owner,inc,channel,correlation,offset,count,accepted,sent,received,clock,charge) => boot }
define gdx_ticket(s : GD110Exchange) = match s { GD110Exchange(phase,boot,ticket,owner,inc,channel,correlation,offset,count,accepted,sent,received,clock,charge) => ticket }
define gdx_owner(s : GD110Exchange) = match s { GD110Exchange(phase,boot,ticket,owner,inc,channel,correlation,offset,count,accepted,sent,received,clock,charge) => owner }
define gdx_inc(s : GD110Exchange) = match s { GD110Exchange(phase,boot,ticket,owner,inc,channel,correlation,offset,count,accepted,sent,received,clock,charge) => inc }
define gdx_channel(s : GD110Exchange) = match s { GD110Exchange(phase,boot,ticket,owner,inc,channel,correlation,offset,count,accepted,sent,received,clock,charge) => channel }
define gdx_correlation(s : GD110Exchange) = match s { GD110Exchange(phase,boot,ticket,owner,inc,channel,correlation,offset,count,accepted,sent,received,clock,charge) => correlation }
define gdx_offset(s : GD110Exchange) = match s { GD110Exchange(phase,boot,ticket,owner,inc,channel,correlation,offset,count,accepted,sent,received,clock,charge) => offset }
define gdx_count(s : GD110Exchange) = match s { GD110Exchange(phase,boot,ticket,owner,inc,channel,correlation,offset,count,accepted,sent,received,clock,charge) => count }
define gdx_accepted(s : GD110Exchange) = match s { GD110Exchange(phase,boot,ticket,owner,inc,channel,correlation,offset,count,accepted,sent,received,clock,charge) => accepted }
define gdx_sent(s : GD110Exchange) = match s { GD110Exchange(phase,boot,ticket,owner,inc,channel,correlation,offset,count,accepted,sent,received,clock,charge) => sent }
define gdx_received(s : GD110Exchange) = match s { GD110Exchange(phase,boot,ticket,owner,inc,channel,correlation,offset,count,accepted,sent,received,clock,charge) => received }
define gdx_clock(s : GD110Exchange) = match s { GD110Exchange(phase,boot,ticket,owner,inc,channel,correlation,offset,count,accepted,sent,received,clock,charge) => clock }
define gdx_charge(s : GD110Exchange) = match s { GD110Exchange(phase,boot,ticket,owner,inc,channel,correlation,offset,count,accepted,sent,received,clock,charge) => charge }
define gdo_boot(s : GD110Observation) = match s { GD110Observation(boot,live,now,channel,server,read,content,bound,typed,lane,accounted,exact) => boot }
define gdo_live(s : GD110Observation) = match s { GD110Observation(boot,live,now,channel,server,read,content,bound,typed,lane,accounted,exact) => live }
define gdo_now(s : GD110Observation) = match s { GD110Observation(boot,live,now,channel,server,read,content,bound,typed,lane,accounted,exact) => now }
define gdo_channel(s : GD110Observation) = match s { GD110Observation(boot,live,now,channel,server,read,content,bound,typed,lane,accounted,exact) => channel }
define gdo_server(s : GD110Observation) = match s { GD110Observation(boot,live,now,channel,server,read,content,bound,typed,lane,accounted,exact) => server }
define gdo_read(s : GD110Observation) = match s { GD110Observation(boot,live,now,channel,server,read,content,bound,typed,lane,accounted,exact) => read }
define gdo_content(s : GD110Observation) = match s { GD110Observation(boot,live,now,channel,server,read,content,bound,typed,lane,accounted,exact) => content }
define gdo_bound(s : GD110Observation) = match s { GD110Observation(boot,live,now,channel,server,read,content,bound,typed,lane,accounted,exact) => bound }
define gdo_typed(s : GD110Observation) = match s { GD110Observation(boot,live,now,channel,server,read,content,bound,typed,lane,accounted,exact) => typed }
define gdo_lane(s : GD110Observation) = match s { GD110Observation(boot,live,now,channel,server,read,content,bound,typed,lane,accounted,exact) => lane }
define gdo_accounted(s : GD110Observation) = match s { GD110Observation(boot,live,now,channel,server,read,content,bound,typed,lane,accounted,exact) => accounted }
define gdo_exact(s : GD110Observation) = match s { GD110Observation(boot,live,now,channel,server,read,content,bound,typed,lane,accounted,exact) => exact }
define gd110_same(x : GD110Exchange,y : GD110Exchange) =
    (gdx_phase(y)=gdx_phase(x)) ∧ (gdx_boot(y)=gdx_boot(x)) ∧ (gdx_ticket(y)=gdx_ticket(x)) ∧ (gdx_owner(y)=gdx_owner(x)) ∧ (gdx_inc(y)=gdx_inc(x)) ∧ (gdx_channel(y)=gdx_channel(x)) ∧ (gdx_correlation(y)=gdx_correlation(x)) ∧ (gdx_offset(y)=gdx_offset(x)) ∧ (gdx_count(y)=gdx_count(x)) ∧ (gdx_accepted(y)=gdx_accepted(x)) ∧ (gdx_sent(y)=gdx_sent(x)) ∧ (gdx_received(y)=gdx_received(x)) ∧ (gdx_clock(y)=gdx_clock(x)) ∧ (gdx_charge(y)=gdx_charge(x))
define gd110_frame(x : GD110Exchange,y : GD110Exchange,phase : BitVec64,accepted : BitVec64,sent : BitVec64,received : BitVec64,now : BitVec64,charge : BitVec64) =
    (gdx_boot(y)=gdx_boot(x)) ∧ (gdx_ticket(y)=gdx_ticket(x)) ∧ (gdx_owner(y)=gdx_owner(x)) ∧ (gdx_inc(y)=gdx_inc(x)) ∧ (gdx_channel(y)=gdx_channel(x)) ∧ (gdx_correlation(y)=gdx_correlation(x)) ∧ (gdx_offset(y)=gdx_offset(x)) ∧ (gdx_count(y)=gdx_count(x)) ∧
    (gdx_phase(y)=phase) ∧ (gdx_accepted(y)=accepted) ∧ (gdx_sent(y)=sent) ∧ (gdx_received(y)=received) ∧ (gdx_clock(y)=now) ∧ (gdx_charge(y)=charge)
define gd110_open_frame(x : GD110Exchange,y : GD110Exchange,q : AR110Request,channel : BitVec64,now : BitVec64) =
    (gdx_boot(y)=gdx_boot(x)) ∧ (gdx_ticket(y)=gdx_ticket(x)) ∧ (gdx_owner(y)=gdx_owner(x)) ∧ (gdx_inc(y)=gdx_inc(x)) ∧ (gdx_charge(y)=gdx_charge(x)) ∧
    (gdx_phase(y)=a109_one()) ∧ (gdx_channel(y)=channel) ∧ (gdx_correlation(y)=arq_correlation(q)) ∧
    (gdx_offset(y)=arq_offset(q)) ∧ (gdx_count(y)=arq_count(q)) ∧ (gdx_accepted(y)=a109_z()) ∧
    (gdx_sent(y)=a109_z()) ∧ (gdx_received(y)=a109_z()) ∧ (gdx_clock(y)=now)

// Subtraction guards precede every sum; other_owner is this owner's existing
// charge outside this download. SR110 peer_charge aggregates ALL other retained
// bytes, including other_owner. Derive these figures from the same ledger; the
// owner subset must fit within the peer aggregate and is not counted twice.
define gd110_quota(private : BitVec64,scratch : BitVec64,other_owner : BitVec64,owner_limit : BitVec64,peers : BitVec64,global_limit : BitVec64) =
    a109_nonzero(private) ∧ a109_nonzero(scratch) ∧ bvule(other_owner,owner_limit) ∧
    bvule(private,bvsub(owner_limit,other_owner)) ∧ bvule(scratch,bvsub(bvsub(owner_limit,other_owner),private)) ∧
    bvule(other_owner,peers) ∧ bvule(peers,global_limit) ∧
    bvule(private,bvsub(global_limit,peers)) ∧ bvule(scratch,bvsub(bvsub(global_limit,peers),private))
// Queue charge includes BOTH typed socket directions, pending NIC/DMA storage,
// command input, overlength probe, and measured adapter metadata not in metadata.
// It is an actual disjoint accounting projection, never a guest estimate.
define gd110_buffers(scratch : BitVec64,request : BitVec64,reply : BitVec64,metadata : BitVec64,queues : BitVec64) =
    ar110_buffers(scratch,metadata,request,reply) ∧ a109_nonzero(queues) ∧
    bvule(queues,bvsub(bvsub(bvsub(scratch,request),reply),metadata))
define gd110_advance(before : BitVec64,n : BitVec64,total : BitVec64) =
    bvule(before,total) ∧ bvule(n,bvsub(total,before))
define gd110_owned(s : SR110State,x : GD110Exchange) =
    sr110_owned(s,gdx_boot(x),gdx_ticket(x),gdx_owner(x),gdx_inc(x))
define gd110_context(s : SR110State,x : GD110Exchange,e : GD110Observation) =
    (srr_phase(s)=a109_one()) ∧ gd110_owned(s,x) ∧ (gdo_boot(e)=gdx_boot(x)) ∧ gdo_live(e) ∧
    bvule(gdx_clock(x),gdo_now(e)) ∧ ag110_step(srr_work(s),gdo_now(e),srr_deadline(s)) ∧
    a109_nonzero(gdx_charge(x)) ∧ (gdo_accounted(e)=A109Valid)
define gd110_bound(s : SR110State,x : GD110Exchange,q : AR110Request) =
    ar110_request(q,bvconst(168,64),as110_true()) ∧ ar110_lane_bound(q,s) ∧
    (arq_correlation(q)=gdx_correlation(x)) ∧ (arq_offset(q)=gdx_offset(x)) ∧
    (arq_count(q)=gdx_count(x)) ∧ (gdx_offset(x)=srr_cursor(s))
define gd110_guard(s : SR110State,x : GD110Exchange,q : AR110Request,e : GD110Observation) =
    gd110_context(s,x,e) ∧ gd110_bound(s,x,q) ∧ (gdo_channel(e)=gdx_channel(x)) ∧
    gdo_typed(e) ∧ gdo_lane(e) ∧ gdo_exact(e) ∧
    ar110_client_send(q,gdx_channel(x),gdo_server(e),gdo_read(e),gdo_bound(e),
      gdo_accounted(e)=A109Valid,srr_work(s),gdo_now(e),srr_deadline(s))
// Every poll, including transient zero progress, consumes shared session work.
// This charge survives child/socket replacement, range changes and retry.
define gd110_step(s : SR110State,t : SR110State,x : GD110Exchange,y : GD110Exchange,e : GD110Observation,
    phase : BitVec64,accepted : BitVec64,sent : BitVec64,received : BitVec64) =
    sr110_change(s,t,srr_phase(s),srr_cursor(s),sr110_spend(srr_work(s)),srr_charge(s)) ∧
    gd110_frame(x,y,phase,accepted,sent,received,gdo_now(e),gdx_charge(x))
// Start only an unopened reservation or the next contiguous range after commit.
// old_dead/drained/scrubbed are vacuously true for a genuinely unopened lane.
// A new range cannot inherit a still-live channel or old response scratch.
define gd110_start(s : SR110State,t : SR110State,x : GD110Exchange,y : GD110Exchange,q : AR110Request,e : GD110Observation,
    request : BitVec64,reply : BitVec64,metadata : BitVec64,queues : BitVec64,
    other_owner : BitVec64,owner_limit : BitVec64,global_limit : BitVec64,old_dead : Bool,drained : Bool,scrubbed : Bool) =
    gd110_context(s,x,e) ∧ ((gdx_phase(x)=a109_z()) ∨ (gdx_phase(x)=bvconst(5,64))) ∧
    old_dead ∧ drained ∧ scrubbed ∧ gdo_typed(e) ∧ gdo_lane(e) ∧ gdo_exact(e) ∧
    gd110_buffers(gdx_charge(x),request,reply,metadata,queues) ∧
    gd110_quota(srr_charge(s),gdx_charge(x),other_owner,owner_limit,srr_peer_charge(s),global_limit) ∧
    ar110_lane_bound(q,s) ∧ (arq_offset(q)=srr_cursor(s)) ∧
    bvult(gdx_correlation(x),arq_correlation(q)) ∧ ¬(gdx_channel(x)=gdo_channel(e)) ∧
    ar110_client_send(q,gdo_channel(e),gdo_server(e),gdo_read(e),gdo_bound(e),
      gdo_accounted(e)=A109Valid,srr_work(s),gdo_now(e),srr_deadline(s)) ∧
    sr110_change(s,t,srr_phase(s),srr_cursor(s),sr110_spend(srr_work(s)),srr_charge(s)) ∧
    gd110_open_frame(x,y,q,gdo_channel(e),gdo_now(e))
// accepted is what typed ssend accepted; sent is actual wire progress. They are
// different counters. exact covers byte comparison against the frozen request.
define gd110_send(s : SR110State,t : SR110State,x : GD110Exchange,y : GD110Exchange,q : AR110Request,e : GD110Observation,
    accepted : BitVec64,sent : BitVec64) =
    (gdx_phase(x)=a109_one()) ∧ gd110_guard(s,x,q,e) ∧
    gd110_advance(gdx_accepted(x),accepted,bvconst(168,64)) ∧
    gd110_advance(gdx_sent(x),sent,bvconst(168,64)) ∧
    bvule(gdx_sent(x),gdx_accepted(x)) ∧
    bvule(bvadd(gdx_sent(x),sent),bvadd(gdx_accepted(x),accepted)) ∧
    (gdx_received(x)=a109_z()) ∧
    gd110_step(s,t,x,y,e,a109_one(),bvadd(gdx_accepted(x),accepted),bvadd(gdx_sent(x),sent),a109_z())
define gd110_fin(s : SR110State,t : SR110State,x : GD110Exchange,y : GD110Exchange,q : AR110Request,e : GD110Observation,half_closed : Bool) =
    (gdx_phase(x)=a109_one()) ∧ gd110_guard(s,x,q,e) ∧ half_closed ∧
    (gdx_accepted(x)=bvconst(168,64)) ∧ (gdx_sent(x)=bvconst(168,64)) ∧ (gdx_received(x)=a109_z()) ∧
    gd110_step(s,t,x,y,e,bvconst(2,64),gdx_accepted(x),gdx_sent(x),a109_z())
// Until real EOF, even a buffer of exactly 200+count bytes is only a candidate.
// n=0 means a nonblocking transient observation, NOT EOF or successful completion.
// An observed extra byte is a fatal error handled by cancellation, never copied.
define gd110_fragment(s : SR110State,t : SR110State,x : GD110Exchange,y : GD110Exchange,q : AR110Request,e : GD110Observation,n : BitVec64) =
    (gdx_phase(x)=bvconst(2,64)) ∧ gd110_guard(s,x,q,e) ∧
    gd110_advance(gdx_received(x),n,bvadd(bvconst(200,64),arq_count(q))) ∧
    gd110_step(s,t,x,y,e,bvconst(2,64),gdx_accepted(x),gdx_sent(x),bvadd(gdx_received(x),n))
// Echo/header values are decoded from actual typed receive bytes, never supplied
// by a guest success status. Probe again after transient EAGAIN until real EOF.
define gd110_eof(s : SR110State,t : SR110State,x : GD110Exchange,y : GD110Exchange,q : AR110Request,echo : AR110Request,
    e : GD110Observation,magic : BitVec64,version : BitVec64,echo_length : BitVec64,n : BitVec64,eof : Bool) =
    (gdx_phase(x)=bvconst(2,64)) ∧ gd110_guard(s,x,q,e) ∧
    ar110_reply(q,echo,magic,version,echo_length,n,gdx_received(x),eof,
      gdx_channel(x),gdo_channel(e),gdo_server(e),gdo_read(e),gdo_content(e)) ∧
    gd110_step(s,t,x,y,e,bvconst(3,64),gdx_accepted(x),gdx_sent(x),gdx_received(x))
// At-most-once range commit. The private-copy observation includes immutable
// ownership of the validated receive bytes and exact copy into cursor..cursor+n.
// Current authority is checked AGAIN after EOF, at the serialized copy boundary.
define gd110_commit(s : SR110State,t : SR110State,x : GD110Exchange,y : GD110Exchange,q : AR110Request,e : GD110Observation,private_copy : Bool) =
    (gdx_phase(x)=bvconst(3,64)) ∧ gd110_guard(s,x,q,e) ∧ (gdo_content(e)=A109Valid) ∧ private_copy ∧
    ar110_receive(s,t,q,gdx_boot(x),gdx_ticket(x),gdx_owner(x),gdx_inc(x),gdo_boot(e),gdo_live(e),gdo_now(e),
      gdo_read(e),gdo_server(e),a109_one(),as110_true(),as110_true()) ∧
    gd110_frame(x,y,bvconst(5,64),gdx_accepted(x),gdx_sent(x),gdx_received(x),gdo_now(e),gdx_charge(x))
// Only interrupted request/reply phases may retry. A validated range must be
// committed or cancelled; completed/closing/released exchanges cannot retry.
define gd110_retry(s : SR110State,t : SR110State,x : GD110Exchange,y : GD110Exchange,old : AR110Request,fresh : AR110Request,e : GD110Observation,
    old_dead : Bool,drained : Bool,scrubbed : Bool) =
    ((gdx_phase(x)=a109_one()) ∨ (gdx_phase(x)=bvconst(2,64))) ∧ gd110_context(s,x,e) ∧ gd110_bound(s,x,old) ∧
    old_dead ∧ drained ∧ scrubbed ∧ gdo_typed(e) ∧ gdo_lane(e) ∧ gdo_exact(e) ∧
    ar110_retry(old,fresh,gdx_channel(x),gdo_channel(e),srr_work(s),srr_work(t),
      srr_deadline(s),srr_deadline(t),gdo_now(e),gdo_server(e),gdo_read(e),gdo_bound(e)) ∧
    sr110_change(s,t,srr_phase(s),srr_cursor(s),sr110_spend(srr_work(s)),srr_charge(s)) ∧
    gd110_open_frame(x,y,fresh,gdo_channel(e),gdo_now(e))
// Cleanup requires the exact local ticket, not continuing remote authorization.
// Stale/foreign requests are explicit no-ops on BOTH states.
define gd110_cancel(s : SR110State,t : SR110State,x : GD110Exchange,y : GD110Exchange,
    boot : BitVec64,ticket : BitVec64,owner : BitVec64,inc : BitVec64) =
    if gd110_owned(s,x) ∧ sr110_owned(s,boot,ticket,owner,inc) ∧
      ((srr_phase(s)=a109_one()) ∨ (srr_phase(s)=bvconst(2,64))) ∧
      ((gdx_phase(x)=a109_z()) ∨ (gdx_phase(x)=a109_one()) ∨ (gdx_phase(x)=bvconst(2,64)) ∨
       (gdx_phase(x)=bvconst(3,64)) ∨ (gdx_phase(x)=bvconst(5,64)))
    then sr110_cancel(s,t,boot,ticket,owner,inc) ∧
      gd110_frame(x,y,bvconst(4,64),gdx_accepted(x),gdx_sent(x),gdx_received(x),gdx_clock(x),gdx_charge(x))
    else sr110_same(s,t) ∧ gd110_same(x,y)
// Successful range completion can release socket scratch while retaining private
// image bytes. A failed lane remains SR110-closing until its independent cleanup.
// Double release is rejected. Revoke and drain include guest aliases and NIC DMA.
define gd110_release(s : SR110State,t : SR110State,x : GD110Exchange,y : GD110Exchange,
    boot : BitVec64,ticket : BitVec64,owner : BitVec64,inc : BitVec64,dead : Bool,revoked : Bool,drained : Bool,scrubbed : Bool) =
    gd110_owned(s,x) ∧ sr110_owned(s,boot,ticket,owner,inc) ∧ a109_nonzero(gdx_charge(x)) ∧
    (((gdx_phase(x)=bvconst(4,64)) ∧ (srr_phase(s)=bvconst(4,64))) ∨
     ((gdx_phase(x)=bvconst(5,64)) ∧ (srr_phase(s)=a109_one()))) ∧
    dead ∧ revoked ∧ drained ∧ scrubbed ∧ sr110_same(s,t) ∧
    gd110_frame(x,y,bvconst(6,64),a109_z(),a109_z(),a109_z(),gdx_clock(x),a109_z())
// Handoff only after the entire exact envelope is assembled and scratch released.
// SR110 performs canonical geometry, byte/metadata/ordered dependency checks.
// Phase 2 is private and non-runnable. Fresh execution is still sr110_launch.
define gd110_validate(s : SR110State,t : SR110State,x : GD110Exchange,e : GD110Observation,actual : SL110Artifact,
    image : BitVec64,code : BitVec64,lit : BitVec64,entry : BitVec64,count : BitVec64,
    bytes : A109Verdict,metadata : A109Verdict,dependencies : A109Verdict) =
    (gdx_phase(x)=bvconst(6,64)) ∧ (gdx_charge(x)=a109_z()) ∧ gd110_owned(s,x) ∧
    (srr_phase(s)=a109_one()) ∧ (gdo_boot(e)=gdx_boot(x)) ∧ gdo_live(e) ∧
    bvule(gdx_clock(x),gdo_now(e)) ∧ ag110_step(srr_work(s),gdo_now(e),srr_deadline(s)) ∧
    (gdo_read(e)=A109Valid) ∧ (gdo_server(e)=A109Valid) ∧ (gdo_content(e)=A109Valid) ∧
    (gdo_accounted(e)=A109Valid) ∧ gdo_lane(e) ∧ gdo_exact(e) ∧
    sr110_envelope(s,actual,image,code,lit,entry,count,bytes,metadata,dependencies) ∧
    sr110_validate(s,t,gdx_boot(x),gdx_ticket(x),gdx_owner(x),gdx_inc(x),gdo_boot(e),gdo_live(e),gdo_now(e),gdo_read(e),as110_true())
// Concrete witness fixtures. Helper names are local to this refinement.


example "exact owner and global quota" { assert(gd110_quota(bvconst(14032,64),bvconst(8192,64),bvconst(40,64),bvconst(22264,64),bvconst(80,64),bvconst(22304,64))) }
example "owner one byte short" { assert(¬(gd110_quota(bvconst(14032,64),bvconst(8192,64),bvconst(40,64),bvconst(22263,64),bvconst(80,64),bvconst(22304,64)))) }
example "global one byte short" { assert(¬(gd110_quota(bvconst(14032,64),bvconst(8192,64),bvconst(40,64),bvconst(22264,64),bvconst(80,64),bvconst(22303,64)))) }
example "other owner consumes allowance" { assert(¬(gd110_quota(bvconst(14032,64),bvconst(8192,64),bvconst(41,64),bvconst(22264,64),bvconst(80,64),bvconst(22304,64)))) }
example "peer consumes global allowance" { assert(¬(gd110_quota(bvconst(14032,64),bvconst(8192,64),bvconst(40,64),bvconst(22264,64),bvconst(81,64),bvconst(22304,64)))) }
example "private zero" { assert(¬(gd110_quota(bvconst(0,64),bvconst(8192,64),bvconst(40,64),bvconst(22264,64),bvconst(80,64),bvconst(22304,64)))) }
example "scratch zero" { assert(¬(gd110_quota(bvconst(14032,64),bvconst(0,64),bvconst(40,64),bvconst(22264,64),bvconst(80,64),bvconst(22304,64)))) }
example "private wrap" { assert(¬(gd110_quota(a109_max(),bvconst(8192,64),bvconst(40,64),bvconst(22264,64),bvconst(80,64),bvconst(22304,64)))) }
example "scratch wrap" { assert(¬(gd110_quota(bvconst(14032,64),a109_max(),bvconst(40,64),bvconst(22264,64),bvconst(80,64),bvconst(22304,64)))) }
example "both frames and queues fit" { assert(gd110_buffers(bvconst(7026,64),bvconst(169,64),bvconst(4297,64),bvconst(512,64),bvconst(2048,64))) }
example "request lacks overlength byte" { assert(¬(gd110_buffers(bvconst(7026,64),bvconst(168,64),bvconst(4297,64),bvconst(512,64),bvconst(2048,64)))) }
example "reply lacks overlength byte" { assert(¬(gd110_buffers(bvconst(7026,64),bvconst(169,64),bvconst(4296,64),bvconst(512,64),bvconst(2048,64)))) }
example "scratch short" { assert(¬(gd110_buffers(bvconst(7025,64),bvconst(169,64),bvconst(4297,64),bvconst(512,64),bvconst(2048,64)))) }
