example "law bounded prefix addition cannot wrap" { assert(∀ before : BitVec64 . ∀ n : BitVec64 . ∀ total : BitVec64 . gd110_advance(before,n,total) ⟹ (bvuge(bvadd(before,n),before) ∧ bvule(bvadd(before,n),total))) }
example "law combined quota cannot wrap" { assert(∀ private : BitVec64 . ∀ scratch : BitVec64 . ∀ limit : BitVec64 . gd110_quota(private,scratch,a109_z(),limit,a109_z(),limit) ⟹ (bvuge(bvadd(private,scratch),private) ∧ bvule(bvadd(private,scratch),limit))) }
example "law session work cannot increase" { assert(∀ work : BitVec64 . bvule(sr110_spend(work),work)) }
