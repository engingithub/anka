import "anka108_workspace_directory.kleis"
example "hostile: count 1 structures False" { assert(¬(wd108_count(bvconst(1,64),res108_false()))) }
example "hostile: count 128 structures False" { assert(¬(wd108_count(bvconst(128,64),res108_false()))) }
example "hostile: count 4096 structures False" { assert(¬(wd108_count(bvconst(4096,64),res108_false()))) }
example "hostile: count 4097 structures False" { assert(¬(¬(wd108_count(bvconst(4097,64),res108_false())))) }
example "hostile: count 0 structures False" { assert(¬(¬(wd108_count(bvconst(0,64),res108_false())))) }
example "hostile: count 16 structures True" { assert(¬(wd108_count(bvconst(16,64),res108_true()))) }
example "hostile: count 17 structures True" { assert(¬(wd108_count(bvconst(17,64),res108_true()))) }
example "hostile: valid table" { assert(¬(wd108_record(bvconst(24576,64),bvconst(24576,64),bvconst(128,64),bvconst(80,64),bvconst(80,64),bvconst(0,64),bvconst(65536,64)))) }
example "hostile: overlap" { assert(¬(¬(wd108_record(bvconst(24568,64),bvconst(24576,64),bvconst(128,64),bvconst(80,64),bvconst(80,64),bvconst(0,64),bvconst(65536,64))))) }
example "hostile: wrong stride" { assert(¬(¬(wd108_record(bvconst(24576,64),bvconst(24576,64),bvconst(128,64),bvconst(8,64),bvconst(80,64),bvconst(0,64),bvconst(65536,64))))) }
example "hostile: reserved data" { assert(¬(¬(wd108_record(bvconst(24576,64),bvconst(24576,64),bvconst(128,64),bvconst(80,64),bvconst(80,64),bvconst(1,64),bvconst(65536,64))))) }
example "hostile: short workspace" { assert(¬(¬(wd108_record(bvconst(24576,64),bvconst(24576,64),bvconst(128,64),bvconst(80,64),bvconst(80,64),bvconst(0,64),bvconst(32768,64))))) }
example "hostile: overflow count" { assert(¬(¬(wd108_record(bvconst(24576,64),bvconst(24576,64),ptr107_max(),bvconst(80,64),bvconst(80,64),bvconst(0,64),bvconst(65536,64))))) }
example "hostile: frames 128 128" { assert(¬(wd108_frames(bvconst(128,64),bvconst(128,64)))) }
example "hostile: frames 128 64" { assert(¬(¬(wd108_frames(bvconst(128,64),bvconst(64,64))))) }
example "hostile: frames 64 128" { assert(¬(¬(wd108_frames(bvconst(64,64),bvconst(128,64))))) }
example "hostile: profile 0 length 768" { assert(¬(wd108_request(bvconst(0,64),bvconst(768,64)))) }
example "hostile: profile 1 length 1024" { assert(¬(wd108_request(bvconst(1,64),bvconst(1024,64)))) }
example "hostile: profile 1 length 768" { assert(¬(¬(wd108_request(bvconst(1,64),bvconst(768,64))))) }
example "hostile: profile 0 length 1024" { assert(¬(¬(wd108_request(bvconst(0,64),bvconst(1024,64))))) }
example "hostile: profile 2 length 1024" { assert(¬(¬(wd108_request(bvconst(2,64),bvconst(1024,64))))) }
