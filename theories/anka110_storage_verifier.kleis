// E11: client verifies the configured storage service. Zero new axioms.
// d and s use E9's direction-independent credential and fresh status lookup.
// This proof is a distinct primitive result: verify the STORAGE-SERVER domain
// over (issuer, credential ref, all signed scope fields) with the actual signer.
// A caller-domain proof cannot be decoded as this type. The verdict belongs
// to the entire message; opaque refs model equality, not entropy or signatures.
import "anka110_caller_verifier.kleis"

data W110Possession = W110Possession(issuer : BitVec64, refid : BitVec64, signer : BitVec64, runtime : BitVec64, connection : BitVec64, binding : BitVec64, local : BitVec64, peer : BitVec64, kind : BitVec64, incarnation : BitVec64, role : BitVec64, operation : BitVec64, serial : BitVec64, challenge : BitVec64, signature : A109Verdict)
define w110_signed(p : W110Possession, d : V110Credential, c : A109Context, o : E110Observation) = match p {
    W110Possession(issuer,refid,signer,runtime,connection,binding,local,peer,kind,incarnation,role,operation,serial,challenge,signature) =>
        (signature=A109Valid) ∧ (issuer=ctx_anchor(c)) ∧ (refid=v110_id(d)) ∧ (signer=v110_key(d)) ∧
        (runtime=eo_runtime(o)) ∧ (connection=eo_connection(o)) ∧ (binding=eo_binding(o)) ∧
        (local=eo_local(o)) ∧ (peer=eo_peer(o)) ∧ (kind=eo_kind(o)) ∧ (incarnation=eo_incarnation(o)) ∧
        (role=eo_role(o)) ∧ (operation=eo_operation(o)) ∧ (serial=eo_serial(o)) ∧ (challenge=eo_challenge(o))
}

// runtime/connection/binding/local come from the actual client channel;
// expected_server is selected by trusted configuration, not by the responder.
// The binding identifies the actual endpoint pair. Socket addresses alone
// authenticate neither end. present is current permit-lookup presence.
define w110_current(c : A109Context, o : E110Observation, d : V110Credential, s : V110Status, p : W110Possession,
                    runtime : BitVec64, connection : BitVec64, binding : BitVec64, local : BitVec64, expected_server : BitVec64,
                    present : Bool, i : A109Identity, permit : E110Permit, b : E110Binding, serial : BitVec64, r : P109Request) =
    (eo_runtime(o)=runtime) ∧ (eo_connection(o)=connection) ∧ (eo_binding(o)=binding) ∧ (eo_local(o)=local) ∧
    v110_credential(d,c,o) ∧ v110_status(s,d,c,o) ∧ w110_signed(p,d,c,o) ∧ v110_interval(d,i) ∧
    present ∧ e110_server(c,i,permit,b,o,serial,expected_server,r)

// One send poll, not the body of the TCP stack. current is w110_current
// evaluated for THIS poll; usable is current client budget/deadline/seal.
// count is actual short-write progress. A denied poll emits no bytes, even
// if the stream would accept a write; previously sent bytes stay sent.
define w110_can_advance(sent : BitVec64, count : BitVec64, current : Bool, usable : Bool) =
    current ∧ usable ∧ bvult(sent,bvconst(112,64)) ∧ bvule(count,bvsub(bvconst(112,64),sent))
define w110_sent(sent : BitVec64, count : BitVec64, current : Bool, usable : Bool, next : BitVec64) =
    (w110_can_advance(sent,count,current,usable) ∧ (next=bvadd(sent,count))) ∨
    (¬w110_can_advance(sent,count,current,usable) ∧ (next=sent))

// Receive-terminal decision ONLY, not a transition on an incomplete stream.
// current is recomputed AFTER EOF, or false on transport/authority loss.
// usable also requires the frozen admission/request and an unexpired budget.
// Reuse exact wire echo, size, EOF, canonical status and success invariants.
// N110 codes: 0=Unknown, 1=success, 2=recognized negative outcome.
// No backend state is read or modified by this client knowledge transition.
define w110_reply_ready(f : N110Frame, reply : N110Reply, r : P109Request, current : Bool, usable : Bool) =
    current ∧ usable ∧ n110_frame(f) ∧ (pr_anchor(r)=nf_anchor(f)) ∧ (pr_installation(r)=nf_installation(f)) ∧ (pr_policy(r)=nf_policy(f)) ∧
    (pr_caller(r)=nf_caller(f)) ∧ (pr_incarnation(r)=nf_incarnation(f)) ∧ (pr_sequence(r)=nf_sequence(f)) ∧
    (pr_expected(r)=nf_expected(f)) ∧ (pr_kind(r)=nf_kind(f)) ∧ (pr_argument(r)=nf_argument(f)) ∧
    (pr_attempt(r)=nf_attempt(f)) ∧ n110_reply_frame(f,reply)
define w110_success(f : N110Frame, reply : N110Reply, r : P109Request, current : Bool, usable : Bool) =
    w110_reply_ready(f,reply,r,current,usable) ∧ n110_client_accept(f,reply,current,usable)
define w110_negative(f : N110Frame, reply : N110Reply, r : P109Request, current : Bool, usable : Bool) =
    w110_reply_ready(f,reply,r,current,usable) ∧ ¬(nr_status(reply)=a109_z()) ∧ ¬(nr_status(reply)=bvconst(5,64))
define w110_result(f : N110Frame, reply : N110Reply, r : P109Request, current : Bool, usable : Bool, result : BitVec8) =
    ((result=bvconst(1,8)) ∧ w110_success(f,reply,r,current,usable)) ∨
    ((result=bvconst(2,8)) ∧ w110_negative(f,reply,r,current,usable)) ∨
    ((result=bvconst(0,8)) ∧ ¬w110_success(f,reply,r,current,usable) ∧ ¬w110_negative(f,reply,r,current,usable))

// E11 witnesses
example "configured storage workload may receive first bytes" {
    assert(w110_sent(bvconst(0,64),bvconst(16,64),w110_current(A109Context(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(71,64),bvconst(100,64),(bvconst(1,8)=bvconst(1,8))),
        E110Observation(bvconst(5,64),bvconst(6,64),bvconst(7,64),bvconst(30,64),bvconst(40,64),bvconst(3,64),bvconst(4,64),bvconst(2,64),bvconst(1,64),bvconst(9,64),bvconst(71,64),(bvconst(1,8)=bvconst(1,8)),A109Valid),
        V110Credential(bvconst(27,64),bvconst(10,64),bvconst(40,64),bvconst(3,64),bvconst(20,64),bvconst(3,64),bvconst(88,64),bvconst(90,64),bvconst(110,64),A109Valid),
        V110Status(bvconst(27,64),bvconst(10,64),bvconst(3,64),bvconst(9,64),bvconst(96,64),bvconst(105,64),A109Valid),
        W110Possession(bvconst(10,64),bvconst(27,64),bvconst(88,64),bvconst(5,64),bvconst(6,64),bvconst(7,64),bvconst(30,64),bvconst(40,64),bvconst(3,64),bvconst(4,64),bvconst(2,64),bvconst(1,64),bvconst(9,64),bvconst(71,64),A109Valid),
        bvconst(5,64),
        bvconst(6,64),
        bvconst(7,64),
        bvconst(30,64),
        bvconst(40,64),
        (bvconst(1,8)=bvconst(1,8)),
        A109Identity(bvconst(10,64),bvconst(40,64),bvconst(3,64),bvconst(20,64),bvconst(3,64),bvconst(71,64),bvconst(90,64),bvconst(110,64),A109Valid,A109Valid,A109Valid),
        E110Permit(bvconst(10,64),bvconst(40,64),bvconst(3,64),bvconst(20,64),bvconst(3,64),bvconst(4,64),bvconst(2,64),bvconst(1,64),bvconst(95,64),bvconst(108,64),A109Valid,A109Valid),
        E110Binding(bvconst(5,64),bvconst(6,64),bvconst(7,64),bvconst(30,64),bvconst(40,64),bvconst(3,64),bvconst(4,64),bvconst(2,64),bvconst(1,64),bvconst(9,64),bvconst(71,64),A109Valid),
        bvconst(9,64),
        P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64))),(bvconst(1,8)=bvconst(1,8)),bvconst(16,64)))
}
