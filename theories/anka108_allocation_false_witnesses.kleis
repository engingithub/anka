// Intentionally false assertions. Every example must be explicitly
// disproved by Z3; unknown, evaluation failure and timeout do not pass.
import "anka108_allocation.kleis"

example "HOSTILE heap108_charge rejects zero request" {
    assert(heap108_charge(bvconst(0,64),bvconst(4096,64),bvconst(256,64),bvconst(4352,64)))
}

example "HOSTILE heap108_charge rejects negative signed request" {
    assert(heap108_charge(bvsub(ptr107_max(),bvconst(0,64)),bvconst(4096,64),bvconst(256,64),bvconst(4352,64)))
}

