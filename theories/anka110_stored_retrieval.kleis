// SR110: bounded retrieval of a CS110 envelope and fresh live-launch admission.
// No new axioms. One private lane, a snapshot of durable selection, and one
// arbitrary unaffected peer (its charge aggregates all other retained bytes).
// All relations specify complete before/after state. No new wire opcode here.
// Current read/server authority, measured storage overhead, owner liveness,
// monotonic time, byte/parser/dependency validation and physical cleanup facts
// are trusted observations, never caller success flags. Rust must derive them
// and serialize authority use, custody and grant consumption at the boundary.
// This is not a cryptographic proof, concrete parser, hardware drain model or
// general filesystem. Exact content identities do not mean hashes or pointers.
import "anka110_compiler_storage_binding.kleis"
data SR110State = SR110State(phase : BitVec64,boot : BitVec64,ticket : BitVec64,owner : BitVec64,inc : BitVec64,cursor : BitVec64,work : BitVec64,charge : BitVec64,high : BitVec64,deadline : BitVec64,selected : BitVec64,selected_gen : BitVec64,revision : BitVec64,peer : BitVec64,peer_charge : BitVec64,peer_running : BitVec64,anchor : BitVec64,installation : BitVec64,artifact : BitVec64,generation : BitVec64,role : BitVec8,profile : BitVec64,size : BitVec64,image : BitVec64,metadata : BitVec64,dependencies : BitVec64,provenance : BitVec64)
define srr_phase(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => phase }
define srr_boot(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => boot }
define srr_ticket(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => ticket }
define srr_owner(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => owner }
define srr_inc(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => inc }
define srr_cursor(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => cursor }
define srr_work(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => work }
define srr_charge(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => charge }
define srr_high(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => high }
define srr_deadline(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => deadline }
define srr_selected(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => selected }
define srr_selected_gen(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => selected_gen }
define srr_revision(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => revision }
define srr_peer(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => peer }
define srr_peer_charge(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => peer_charge }
define srr_peer_running(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => peer_running }
define srr_anchor(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => anchor }
define srr_installation(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => installation }
define srr_artifact(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => artifact }
define srr_generation(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => generation }
define srr_role(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => role }
define srr_profile(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => profile }
define srr_size(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => size }
define srr_image(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => image }
define srr_metadata(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => metadata }
define srr_dependencies(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => dependencies }
define srr_provenance(s : SR110State) = match s { SR110State(phase,boot,ticket,owner,inc,cursor,work,charge,high,deadline,selected,selected_gen,revision,peer,peer_charge,peer_running,anchor,installation,artifact,generation,role,profile,size,image,metadata,dependencies,provenance) => provenance }
define sr110_same(s : SR110State,t : SR110State) = (srr_phase(t)=srr_phase(s)) ∧ (srr_boot(t)=srr_boot(s)) ∧ (srr_ticket(t)=srr_ticket(s)) ∧ (srr_owner(t)=srr_owner(s)) ∧ (srr_inc(t)=srr_inc(s)) ∧ (srr_cursor(t)=srr_cursor(s)) ∧ (srr_work(t)=srr_work(s)) ∧ (srr_charge(t)=srr_charge(s)) ∧ (srr_high(t)=srr_high(s)) ∧ (srr_deadline(t)=srr_deadline(s)) ∧ (srr_selected(t)=srr_selected(s)) ∧ (srr_selected_gen(t)=srr_selected_gen(s)) ∧ (srr_revision(t)=srr_revision(s)) ∧ (srr_peer(t)=srr_peer(s)) ∧ (srr_peer_charge(t)=srr_peer_charge(s)) ∧ (srr_peer_running(t)=srr_peer_running(s)) ∧ (srr_anchor(t)=srr_anchor(s)) ∧ (srr_installation(t)=srr_installation(s)) ∧ (srr_artifact(t)=srr_artifact(s)) ∧ (srr_generation(t)=srr_generation(s)) ∧ (srr_role(t)=srr_role(s)) ∧ (srr_profile(t)=srr_profile(s)) ∧ (srr_size(t)=srr_size(s)) ∧ (srr_image(t)=srr_image(s)) ∧ (srr_metadata(t)=srr_metadata(s)) ∧ (srr_dependencies(t)=srr_dependencies(s)) ∧ (srr_provenance(t)=srr_provenance(s))
define sr110_change(s : SR110State,t : SR110State,phase : BitVec64,cursor : BitVec64,work : BitVec64,charge : BitVec64) = (srr_boot(t)=srr_boot(s)) ∧ (srr_ticket(t)=srr_ticket(s)) ∧ (srr_owner(t)=srr_owner(s)) ∧ (srr_inc(t)=srr_inc(s)) ∧ (srr_high(t)=srr_high(s)) ∧ (srr_deadline(t)=srr_deadline(s)) ∧ (srr_selected(t)=srr_selected(s)) ∧ (srr_selected_gen(t)=srr_selected_gen(s)) ∧ (srr_revision(t)=srr_revision(s)) ∧ (srr_peer(t)=srr_peer(s)) ∧ (srr_peer_charge(t)=srr_peer_charge(s)) ∧ (srr_peer_running(t)=srr_peer_running(s)) ∧ (srr_anchor(t)=srr_anchor(s)) ∧ (srr_installation(t)=srr_installation(s)) ∧ (srr_artifact(t)=srr_artifact(s)) ∧ (srr_generation(t)=srr_generation(s)) ∧ (srr_role(t)=srr_role(s)) ∧ (srr_profile(t)=srr_profile(s)) ∧ (srr_size(t)=srr_size(s)) ∧ (srr_image(t)=srr_image(s)) ∧ (srr_metadata(t)=srr_metadata(s)) ∧ (srr_dependencies(t)=srr_dependencies(s)) ∧ (srr_provenance(t)=srr_provenance(s)) ∧ (srr_phase(t)=phase) ∧ (srr_cursor(t)=cursor) ∧ (srr_work(t)=work) ∧ (srr_charge(t)=charge)

// 0 empty, 1 receiving, 2 privately validated/frozen, 3 child custody,
// 4 closing. Phase 3 alone is runnable. Child cleanup is the existing runtime
// lifetime protocol, not the private retrieval cancellation operation.
define sr110_owned(s : SR110State,boot : BitVec64,ticket : BitVec64,owner : BitVec64,inc : BitVec64) =
    (boot=srr_boot(s)) ∧ a109_nonzero(boot) ∧ (ticket=srr_ticket(s)) ∧ a109_nonzero(ticket) ∧
    (ticket=srr_high(s)) ∧ (owner=srr_owner(s)) ∧ (inc=srr_inc(s))
// Zero process incarnation is valid when it equals the actual live owner.
define sr110_bound(s : SR110State,m : SL110Artifact) =
    (srr_anchor(s)=sa_anchor(m)) ∧ (srr_installation(s)=sa_installation(m)) ∧
    (srr_artifact(s)=sa_artifact(m)) ∧ (srr_generation(s)=sa_generation(m)) ∧
    (srr_role(s)=sa_role(m)) ∧ (srr_profile(s)=sa_profile(m)) ∧ (srr_size(s)=sa_size(m)) ∧
    (srr_image(s)=sa_image(m)) ∧ (srr_metadata(s)=sa_metadata(m)) ∧
    (srr_dependencies(s)=sa_dependencies(m)) ∧ (srr_provenance(s)=sa_provenance(m))
// Manifest is frozen before reservation. 'size' is the full envelope, not code.
// Identity resolution/published is an independent current trusted observation.
define sr110_can_begin(s : SR110State,owner : BitVec64,inc : BitVec64,overhead : BitVec64,
    owner_limit : BitVec64,global_limit : BitVec64,work : BitVec64,now : BitVec64,deadline : BitVec64,
    read : A109Verdict,server : A109Verdict,published : A109Verdict) =
    (srr_phase(s)=a109_z()) ∧ (srr_charge(s)=a109_z()) ∧ a109_nonzero(srr_boot(s)) ∧
    a109_nonzero(owner) ∧ a109_nonzero(srr_anchor(s)) ∧ a109_nonzero(srr_installation(s)) ∧
    a109_nonzero(srr_artifact(s)) ∧ a109_nonzero(srr_generation(s)) ∧
    (srr_role(s)=bvconst(2,8)) ∧ ((srr_profile(s)=a109_one()) ∨ (srr_profile(s)=bvconst(2,64))) ∧
    a109_nonzero(srr_image(s)) ∧ a109_nonzero(srr_metadata(s)) ∧ a109_nonzero(srr_dependencies(s)) ∧ a109_nonzero(srr_provenance(s)) ∧
    (read=A109Valid) ∧ (server=A109Valid) ∧ (published=A109Valid) ∧
    as110_charge(srr_size(s),overhead,owner_limit,srr_peer_charge(s),global_limit) ∧
    a109_nonzero(work) ∧ bvult(now,deadline) ∧ bvult(srr_high(s),a109_max())
define sr110_begin(s : SR110State,t : SR110State,owner : BitVec64,inc : BitVec64,overhead : BitVec64,
    owner_limit : BitVec64,global_limit : BitVec64,work : BitVec64,now : BitVec64,deadline : BitVec64,
    read : A109Verdict,server : A109Verdict,published : A109Verdict) =
    if sr110_can_begin(s,owner,inc,overhead,owner_limit,global_limit,work,now,deadline,read,server,published) then
(srr_boot(t)=srr_boot(s)) ∧ (srr_selected(t)=srr_selected(s)) ∧ (srr_selected_gen(t)=srr_selected_gen(s)) ∧ (srr_revision(t)=srr_revision(s)) ∧ (srr_peer(t)=srr_peer(s)) ∧ (srr_peer_charge(t)=srr_peer_charge(s)) ∧ (srr_peer_running(t)=srr_peer_running(s)) ∧ (srr_anchor(t)=srr_anchor(s)) ∧ (srr_installation(t)=srr_installation(s)) ∧ (srr_artifact(t)=srr_artifact(s)) ∧ (srr_generation(t)=srr_generation(s)) ∧ (srr_role(t)=srr_role(s)) ∧ (srr_profile(t)=srr_profile(s)) ∧ (srr_size(t)=srr_size(s)) ∧ (srr_image(t)=srr_image(s)) ∧ (srr_metadata(t)=srr_metadata(s)) ∧ (srr_dependencies(t)=srr_dependencies(s)) ∧ (srr_provenance(t)=srr_provenance(s)) ∧
    (srr_phase(t)=a109_one()) ∧ (srr_ticket(t)=bvadd(srr_high(s),a109_one())) ∧ (srr_high(t)=srr_ticket(t)) ∧
    (srr_owner(t)=owner) ∧ (srr_inc(t)=inc) ∧ (srr_cursor(t)=a109_z()) ∧ (srr_work(t)=work) ∧
    (srr_charge(t)=bvadd(srr_size(s),overhead)) ∧ (srr_deadline(t)=deadline)
    else sr110_same(s,t)
define sr110_spend(work : BitVec64) = if a109_nonzero(work) then bvsub(work,a109_one()) else a109_z()
// 'bound' is complete decoded request echo equality: namespace, full manifest,
// boot/owner/incarnation/lane ticket, connection, correlation, offset and length.
// Its projection must be derived from the actual frozen outstanding request.
define sr110_reply(bound : Bool,connection : BitVec64,correlation : BitVec64,
    observed_connection : BitVec64,observed_correlation : BitVec64,n : BitVec64,received : BitVec64,
    eof : Bool,canonical : Bool,range : A109Verdict) =
    bound ∧ a109_nonzero(connection) ∧ a109_nonzero(correlation) ∧
    (connection=observed_connection) ∧ (correlation=observed_correlation) ∧
    (n=received) ∧ eof ∧ canonical ∧ (range=A109Valid)
// Result 0 = incomplete/lost reply, 1 = full reply, 2 = error. Retrying consumes
// the SAME remaining work and deadline; only a complete authorized range advances.
// 'scope' validates the requested manifest/range against current read/server
// evidence, under the actual connection's lane. Fresh authority is required at
// enqueue, disclosure, and final EOF acceptance; no caller controls the verdict.
define sr110_receive(s : SR110State,t : SR110State,boot : BitVec64,ticket : BitVec64,owner : BitVec64,inc : BitVec64,
    active_boot : BitVec64,live : Bool,now : BitVec64,read : A109Verdict,server : A109Verdict,
    off : BitVec64,n : BitVec64,result : BitVec64,scope : Bool,reply : Bool) =
    if (srr_phase(s)=a109_one()) ∧ sr110_owned(s,boot,ticket,owner,inc) then
      if (active_boot=boot) ∧ live ∧ bvult(now,srr_deadline(s)) ∧ a109_nonzero(srr_work(s)) ∧
         (read=A109Valid) ∧ (server=A109Valid) ∧ scope ∧ (off=srr_cursor(s)) ∧
         cs110_chunk(srr_size(s),off,n,bvconst(4096,64)) then
        if result=a109_z() then sr110_change(s,t,a109_one(),srr_cursor(s),sr110_spend(srr_work(s)),srr_charge(s))
        else if (result=a109_one()) ∧ reply then
          sr110_change(s,t,a109_one(),bvadd(off,n),sr110_spend(srr_work(s)),srr_charge(s))
        else sr110_change(s,t,bvconst(4,64),srr_cursor(s),sr110_spend(srr_work(s)),srr_charge(s))
      else sr110_change(s,t,bvconst(4,64),srr_cursor(s),sr110_spend(srr_work(s)),srr_charge(s))
    else sr110_same(s,t)
// Frozen request, read scope and byte-range verdicts are explicit refinement
// obligations, not cryptographic authentication inferred from identifiers.
define sr110_envelope(s : SR110State,actual : SL110Artifact,image : BitVec64,code : BitVec64,lit : BitVec64,
    entry : BitVec64,count : BitVec64,bytes : A109Verdict,metadata : A109Verdict,dependencies : A109Verdict) =
    (srr_cursor(s)=srr_size(s)) ∧ sr110_bound(s,actual) ∧
    (bytes=A109Valid) ∧ (metadata=A109Valid) ∧ (dependencies=A109Valid) ∧
    cs110_geometry(image,code,lit,entry,srr_profile(s),count) ∧
    (cs110_length(image,count)=srr_size(s))
define sr110_validate(s : SR110State,t : SR110State,boot : BitVec64,ticket : BitVec64,owner : BitVec64,inc : BitVec64,
    active_boot : BitVec64,live : Bool,now : BitVec64,read : A109Verdict,validated : Bool) =
    if (srr_phase(s)=a109_one()) ∧ sr110_owned(s,boot,ticket,owner,inc) then
      if (active_boot=boot) ∧ live ∧ bvult(now,srr_deadline(s)) ∧ a109_nonzero(srr_work(s)) ∧
         (read=A109Valid) ∧ (srr_cursor(s)=srr_size(s)) ∧ validated
      then sr110_change(s,t,bvconst(2,64),srr_cursor(s),sr110_spend(srr_work(s)),srr_charge(s))
      else sr110_change(s,t,bvconst(4,64),srr_cursor(s),sr110_spend(srr_work(s)),srr_charge(s))
    else sr110_same(s,t)
// This is the actual T1 admission predicate, not a read->execute implication.
// Exact bytes/ordered dependencies are frozen in phase 2; a final current
// dependency/provenance observation is required again at the commit point.
define sr110_execute(s : SR110State,c : A109Context,e : A109Identity,en : A109Enrollment,g : A109Grant,
    q : A109Request,ad : A109Admission,expected : BitVec64) =
    (ctx_anchor(c)=srr_anchor(s)) ∧ (ctx_installation(c)=srr_installation(s)) ∧
    (rq_subject(q)=srr_owner(s)) ∧ (rq_purpose(q)=bvconst(3,64)) ∧ (rq_resource(q)=srr_artifact(s)) ∧
    a109_grant_allowed(c,e,en,g,q,srr_size(s),as110_true(),srr_generation(s),ad,expected,as110_true())
define sr110_launch(s : SR110State,t : SR110State,boot : BitVec64,ticket : BitVec64,owner : BitVec64,inc : BitVec64,
    active_boot : BitVec64,live : Bool,now : BitVec64,read : A109Verdict,dependencies : A109Verdict,
    c : A109Context,e : A109Identity,en : A109Enrollment,g : A109Grant,q : A109Request,
    ad : A109Admission,expected : BitVec64,next_ad : A109Admission,
    fresh : Bool,tags_clean : Bool,sealed : Bool,drained : Bool,layout : Bool) =
    if (srr_phase(s)=bvconst(2,64)) ∧ sr110_owned(s,boot,ticket,owner,inc) then
      if (active_boot=boot) ∧ live ∧ bvult(now,srr_deadline(s)) ∧ a109_nonzero(srr_work(s)) ∧
         (ctx_now(c)=now) ∧ (read=A109Valid) ∧ (dependencies=A109Valid) ∧ fresh ∧ tags_clean ∧ sealed ∧ drained ∧ layout ∧
         sr110_execute(s,c,e,en,g,q,ad,expected) then
        sr110_change(s,t,bvconst(3,64),srr_cursor(s),sr110_spend(srr_work(s)),srr_charge(s)) ∧
        a109_admit_step(c,e,en,g,q,srr_size(s),as110_true(),srr_generation(s),ad,expected,as110_true(),next_ad)
      else sr110_change(s,t,bvconst(4,64),srr_cursor(s),sr110_spend(srr_work(s)),srr_charge(s)) ∧ a109_same_admission(ad,next_ad)
    else sr110_same(s,t) ∧ a109_same_admission(ad,next_ad)
// Cancellation does not require a still-valid remote grant. Revoke all local
// authority, drain captured physical work, and scrub before releasing the charge.
// Failed cleanup retains custody; no timeout or queued death event means drained.
define sr110_cancel(s : SR110State,t : SR110State,boot : BitVec64,ticket : BitVec64,owner : BitVec64,inc : BitVec64) =
    if ((srr_phase(s)=a109_one()) ∨ (srr_phase(s)=bvconst(2,64))) ∧ sr110_owned(s,boot,ticket,owner,inc)
    then sr110_change(s,t,bvconst(4,64),srr_cursor(s),srr_work(s),srr_charge(s)) else sr110_same(s,t)
define sr110_release(s : SR110State,t : SR110State,boot : BitVec64,ticket : BitVec64,owner : BitVec64,inc : BitVec64,
    revoked : Bool,drained : Bool,scrubbed : Bool) =
    if (srr_phase(s)=bvconst(4,64)) ∧ sr110_owned(s,boot,ticket,owner,inc) ∧ revoked ∧ drained ∧ scrubbed
    then sr110_change(s,t,a109_z(),a109_z(),a109_z(),a109_z()) else sr110_same(s,t)
