        bvconst(2,64),bvconst(8192,64),bvconst(8192,64),bvconst(8192,64),bvconst(8,64),bvconst(2,64),
        bvconst(1,64),bvconst(2,64),bvconst(131072,64),bvconst(8192,64),bvconst(131072,64),bvconst(8,64),
        bvconst(2,64),bvconst(1,64),bvconst(2,64)) ∧ a22_return_pair(
        bvconst(8192,64),bvconst(131072,64),bvconst(8192,64),bvconst(8192,64),bvconst(131072,64),bvconst(8192,64),
        bvconst(4,64),bvconst(6,64),bvconst(1,64),bvconst(2,64),bvconst(1,64),bvconst(4096,64),
        bvconst(16384,64),a22_true(),bvconst(4096,64),bvconst(4096,64),a22_true(),bvconst(16384,64),
        bvconst(4096,64),bvconst(4,64),bvconst(6,64),bvconst(1,64),bvconst(1,64),bvconst(0,64),
        bvconst(131072,64),bvconst(16384,64),a22_false(),bvconst(0,64),bvconst(0,64),a22_true(),
        bvconst(139264,64),bvconst(8192,64))) in
        (release ∧ (a22_refund(release,bvconst(8192,64),bvconst(8192,64))=bvconst(0,64)) ∧ (a22_count_release(release,bvconst(1,64))=bvconst(0,64)) ∧ (a22_return_base(bvconst(8192,64),bvconst(4096,64),a22_true())=bvconst(4096,64)) ∧ (a22_return_size(bvconst(8192,64),bvconst(4096,64),bvconst(4096,64),a22_true(),a22_true())=bvconst(16384,64)) ∧ (a22_coalesced_holes(bvconst(2,64),a22_true(),a22_true())=bvconst(1,64)) ∧ (a22_return_size(bvconst(8192,64),bvconst(0,64),bvconst(8192,64),a22_false(),a22_true())=bvconst(16384,64)) ∧ a22_counts(bvconst(4,64),bvconst(6,64),bvconst(0,64),bvconst(1,64)))))
}

example "hostile: reusing A physical hole consumes fresh identity and B virtual space" {
    assert(¬(let commit = a22_admit(
        bvconst(1,64),bvconst(4096,64),bvconst(8,64),bvconst(8,64),bvconst(8,64),bvconst(0,8),
        bvconst(4,64),bvconst(6,64),bvconst(1,64),bvconst(2,64),bvconst(0,64),bvconst(4096,64),
        bvconst(4096,64),bvconst(4096,64),bvconst(16384,64),bvconst(4,64),bvconst(6,64),bvconst(1,64),
        bvconst(1,64),bvconst(0,64),bvconst(139264,64),bvconst(8192,64),bvconst(131072,64),bvconst(16384,64),
        bvconst(1,64),bvconst(4,64),bvconst(1,64),bvconst(0,8),bvconst(0,64),bvconst(4,64),
        bvconst(0,8),bvconst(3,64),bvconst(1224,64),bvconst(8192,64),bvconst(65536,64),bvconst(8192,64),
        bvconst(32768,64),bvconst(9,64),bvconst(9,64),bvconst(9,64),bvconst(9,64),bvconst(9,64),
        bvconst(1,8)) in
        (commit ∧ (a22_count_after(commit,bvconst(1,64))=bvconst(2,64)) ∧ (a22_count_after(commit,bvconst(3,64))=bvconst(4,64)) ∧ (a22_holes_after(commit,bvconst(2,64),bvconst(4096,64),bvconst(4096,64))=bvconst(1,64)) ∧ (a22_charge_after(commit,bvconst(8192,64),bvconst(4096,64))=bvconst(12288,64)) ∧ (a22_authority_after_reservation()=bvconst(0,8)))))
}

