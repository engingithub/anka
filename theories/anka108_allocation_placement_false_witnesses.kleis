        bvconst(65536,64),bvconst(16384,64),a22_false(),bvconst(0,64),bvconst(0,64),a22_true(),
        bvconst(69632,64),bvconst(12288,64)))
}

example "hostile: late virtual return failure preserves both claims and all charges" {
    assert(¬(let release = (a22_cancel(
        bvconst(7,64),bvconst(1,64),bvconst(1,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),
        bvconst(1,64),bvconst(1,64),bvconst(1,8),bvconst(0,8),bvconst(0,8),bvconst(1,8),
        bvconst(1,8),bvconst(1,8),bvconst(4096,64),bvconst(4096,64),bvconst(12288,64),bvconst(4096,64),
        bvconst(6,64),bvconst(6,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,64),
        bvconst(1,64),bvconst(4096,64),bvconst(4096,64),bvconst(4096,64),bvconst(7,64),bvconst(1,64),
        bvconst(1,64),bvconst(1,64),bvconst(65536,64),bvconst(4096,64),bvconst(65536,64),bvconst(7,64),
        bvconst(1,64),bvconst(1,64),bvconst(1,64)) ∧ a22_return_pair(
        bvconst(4096,64),bvconst(65536,64),bvconst(4096,64),bvconst(4096,64),bvconst(65536,64),bvconst(4096,64),
        bvconst(4,64),bvconst(6,64),bvconst(2,64),bvconst(1,64),bvconst(0,64),bvconst(4096,64),
        bvconst(16384,64),a22_false(),bvconst(0,64),bvconst(0,64),a22_true(),bvconst(16384,64),
        bvconst(4096,64),bvconst(4,64),bvconst(6,64),bvconst(1,64),bvconst(1,64),bvconst(0,64),
        bvconst(65536,64),bvconst(16384,64),a22_false(),bvconst(0,64),bvconst(0,64),a22_true(),
        bvconst(65536,64),bvconst(12288,64))) in
        (¬(release) ∧ (a22_refund(release,bvconst(12288,64),bvconst(4096,64))=bvconst(12288,64)) ∧ (a22_count_release(release,bvconst(2,64))=bvconst(2,64)) ∧ (a22_count_release(release,bvconst(1,64))=bvconst(1,64)) ∧ (a22_row(release,bvconst(1,64),bvconst(1,64),bvconst(4096,64),bvconst(0,64))=bvconst(4096,64)) ∧ (a22_row(release,bvconst(1,64),bvconst(1,64),bvconst(65536,64),bvconst(0,64))=bvconst(65536,64)))))
}

example "hostile: two clients reserve then A closes without disturbing B" {
    assert(¬(let a = a22_admit(
        bvconst(1,64),bvconst(4096,64),bvconst(7,64),bvconst(7,64),bvconst(7,64),bvconst(0,8),
        bvconst(4,64),bvconst(6,64),bvconst(0,64),bvconst(1,64),bvconst(0,64),bvconst(4096,64),
        bvconst(16384,64),bvconst(4096,64),bvconst(16384,64),bvconst(4,64),bvconst(6,64),bvconst(0,64),
        bvconst(1,64),bvconst(0,64),bvconst(65536,64),bvconst(16384,64),bvconst(65536,64),bvconst(16384,64),
        bvconst(1,64),bvconst(4,64),bvconst(0,64),bvconst(0,8),bvconst(0,64),bvconst(4,64),
        bvconst(0,8),bvconst(1,64),bvconst(1224,64),bvconst(0,64),bvconst(65536,64),bvconst(0,64),
        bvconst(32768,64),bvconst(5,64),bvconst(5,64),bvconst(5,64),bvconst(5,64),bvconst(5,64),
        bvconst(1,8)) in
        let b = a22_admit(
        bvconst(8192,64),bvconst(8192,64),bvconst(8,64),bvconst(8,64),bvconst(8,64),bvconst(0,8),
        bvconst(4,64),bvconst(6,64),bvconst(1,64),bvconst(1,64),bvconst(0,64),bvconst(8192,64),
        bvconst(12288,64),bvconst(4096,64),bvconst(16384,64),bvconst(4,64),bvconst(6,64),bvconst(0,64),
        bvconst(1,64),bvconst(0,64),bvconst(131072,64),bvconst(16384,64),bvconst(131072,64),bvconst(16384,64),
        bvconst(2,64),bvconst(4,64),bvconst(0,64),bvconst(0,8),bvconst(1,64),bvconst(4,64),
        bvconst(0,8),bvconst(2,64),bvconst(1224,64),a22_charge_after(a,bvconst(0,64),bvconst(4096,64)),bvconst(65536,64),bvconst(0,64),
        bvconst(32768,64),a22_count_after(a,bvconst(5,64)),bvconst(6,64),bvconst(6,64),bvconst(6,64),bvconst(6,64),
        bvconst(1,8)) in
        let release = (a22_cancel(
        bvconst(7,64),bvconst(1,64),bvconst(1,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),
        bvconst(1,64),bvconst(1,64),bvconst(3,8),bvconst(0,8),bvconst(0,8),bvconst(1,8),
        bvconst(1,8),bvconst(1,8),bvconst(4096,64),bvconst(4096,64),a22_charge_after(b,bvconst(4096,64),bvconst(8192,64)),bvconst(4096,64),
        bvconst(8,64),bvconst(8,64),bvconst(1,8),bvconst(7,64),bvconst(1,64),bvconst(1,64),
        bvconst(1,64),bvconst(4096,64),bvconst(4096,64),bvconst(4096,64),bvconst(7,64),bvconst(1,64),
        bvconst(1,64),bvconst(1,64),bvconst(65536,64),bvconst(4096,64),bvconst(65536,64),bvconst(7,64),
        bvconst(1,64),bvconst(1,64),bvconst(1,64)) ∧ a22_return_pair(
        bvconst(4096,64),bvconst(65536,64),bvconst(4096,64),bvconst(4096,64),bvconst(65536,64),bvconst(4096,64),
        bvconst(4,64),bvconst(6,64),bvconst(2,64),bvconst(1,64),bvconst(0,64),bvconst(4096,64),
        bvconst(16384,64),a22_false(),bvconst(0,64),bvconst(0,64),a22_true(),bvconst(16384,64),
        bvconst(4096,64),bvconst(4,64),bvconst(6,64),bvconst(1,64),bvconst(1,64),bvconst(0,64),
        bvconst(65536,64),bvconst(16384,64),a22_false(),bvconst(0,64),bvconst(0,64),a22_true(),
        bvconst(69632,64),bvconst(12288,64))) in
        (a ∧ b ∧ release ∧ (a22_refund(release,bvconst(12288,64),bvconst(4096,64))=bvconst(8192,64)) ∧ (a22_row(release,bvconst(1,64),bvconst(2,64),bvconst(8192,64),bvconst(0,64))=bvconst(8192,64)) ∧ (a22_row(release,bvconst(7,64),bvconst(8,64),bvconst(8192,64),bvconst(0,64))=bvconst(8192,64)) ∧ ¬(a22_right_join(a22_true(),bvconst(16384,64),bvconst(4096,64),bvconst(4096,64))) ∧ (a22_coalesced_holes(bvconst(1,64),a22_false(),a22_false())=bvconst(2,64)) ∧ (a22_return_size(bvconst(4096,64),bvconst(0,64),bvconst(12288,64),a22_false(),a22_true())=bvconst(16384,64)) ∧ (a22_cleanup_revision(bvconst(8,64))=bvconst(9,64)))))
}

example "hostile: return B after A recovers full physical and B virtual arenas" {
    assert(¬(let release = (a22_cancel(
        bvconst(8,64),bvconst(2,64),bvconst(1,64),bvconst(2,64),bvconst(8,64),bvconst(2,64),
