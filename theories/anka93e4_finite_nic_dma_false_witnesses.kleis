// Every example is deliberately false and must be rejected.
import "anka93e4_finite_nic_dma.kleis"

example "FALSE-NIC93E4-1 TX succeeds without READ authority" {
    assert(nic93e4_tx_accept(true,true,true,false,true,true)=true)
}

example "FALSE-NIC93E4-2 RX succeeds without WRITE authority" {
    assert(nic93e4_rx_accept(true,true,true,true,false,true,true)=true)
}

example "FALSE-NIC93E4-3 TX accepts zero length" {
    assert(nic93e4_tx_length_valid(bvconst(0,16)))
}

example "FALSE-NIC93E4-4 TX accepts 1515-byte ordinary frame" {
    assert(nic93e4_tx_length_valid(bvconst(1515,16)))
}

example "FALSE-NIC93E4-5 rejected RX dequeues private packet" {
    assert(nic93e4_rx_queue_after_reject(bvconst(7,5))=bvconst(6,5))
}

example "FALSE-NIC93E4-6 rejected preflight creates DMA domain" {
    assert(nic93e4_dma_domains_after_reject(bvconst(9,8))=bvconst(10,8))
}

example "FALSE-NIC93E4-7 queued packet alone is pair-attributed DMA" {
    assert(nic93e4_pair_contribution(false,true,true)=bvconst(1,3))
}

example "FALSE-NIC93E4-8 terminal completion still delays pair quiescence" {
    assert(nic93e4_pair_contribution(true,false,true)=bvconst(1,3))
}

example "FALSE-NIC93E4-9 faulted TX appends a host frame" {
    assert(nic93e4_tx_sink_delta(false,true)=bvconst(1,3))
}

example "FALSE-NIC93E4-10 failed DMA reports requested byte count" {
    assert(nic93e4_transfer_len(false,bvconst(64,16))=bvconst(64,16))
}

example "FALSE-NIC93E4-11 finite TX completion is unsolicited RX activity" {
    assert(nic93e4_completion_advances_rx_epoch(true))
}
