// DN-71 A2.3.5 hostile witnesses: EVERY assertion must be explicitly
// disproved. Unknown/timeout/evaluation failure is not evidence of rejection.
import "anka108_cleanup_workers.kleis"

example "storage: valid" {
    assert(¬(cw108_storage(bvconst(2,64),bvconst(2,64),bvconst(64,64),bvconst(128,64),bvconst(4,64),bvconst(4,64),bvconst(128,64),bvconst(512,64),bvconst(2,64),bvconst(2,64),bvconst(32,64),bvconst(64,64),bvconst(4096,64),bvconst(256,64),bvconst(5056,64),bvconst(8192,64),a23_true())))
}

example "storage: exact fixed budget" {
    assert(¬(cw108_storage(bvconst(2,64),bvconst(2,64),bvconst(64,64),bvconst(128,64),bvconst(4,64),bvconst(4,64),bvconst(128,64),bvconst(512,64),bvconst(2,64),bvconst(2,64),bvconst(32,64),bvconst(64,64),bvconst(4096,64),bvconst(256,64),bvconst(5056,64),bvconst(5056,64),a23_true())))
}

