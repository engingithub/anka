example "trace: all three admissions" {
    assert(¬(cw108_trace_cpu_submit() ∧ cw108_trace_dma_submit() ∧ cw108_trace_b_submit()))
}

example "trace: claim while old work remains" {
    assert(¬(cw108_trace_claim() ∧ (cw108_trace_cpu_count()=bvconst(1,64)) ∧ (cw108_trace_dma_count()=bvconst(1,64))))
}

example "trace: exact terminal CPU consumed" {
    assert(¬(cw108_trace_cpu_finish() ∧ (cw108_trace_cpu_after()=bvconst(0,64))))
}

example "trace: faulted DMA requires real terminal fencing" {
    assert(¬(cw108_trace_dma_finish() ∧ (cw108_trace_dma_after()=bvconst(0,64))))
}

example "trace: current drain readiness" {
    assert(¬(cw108_trace_ready()))
}

example "trace: B still has its own outstanding operation" {
    assert(¬(cw108_trace_ready() ∧ (cw108_trace_b_count()=bvconst(1,64))))
}

example "trace: consumed CPU cannot complete twice" {
    assert(cw108_finish(a23_true(),a23_true(),a23_true(),bvconst(3,8),bvconst(1,8),bvconst(2,64),bvconst(9,64),bvconst(41,64),bvconst(1,8),cw108_trace_cpu_after(),bvconst(0,64),ptr107_max(),bvconst(0,64),cw108_ticket_active(cw108_trace_cpu_finish(),cw108_trace_cpu_active()),bvconst(1,8)))
}

example "trace: ready is not publication" {
    assert(a23_visible(cw108_trace_closed(),a23_true()))
}
