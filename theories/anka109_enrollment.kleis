// T1 enrollment: explicit selected anchor + recognized PERSON + independent
// root-issued installation-specific enrollment entitlement. No automatic admin
// or execute grant. Commit is one exclusive state transition after all checks;
// preflight means trusted reserved durable-record capacity, not a guest flag.
// Serial equality is checked again at commit. Runtime crash persistence remains
// unimplemented; this model proves atomic abstract transitions only.
import "anka109_recognition.kleis"
data A109EnrollPermit = A109EnrollPermit(issuer : BitVec64, person : BitVec64, installation : BitVec64, epoch : BitVec64, first : BitVec64, until : BitVec64, enroll : Bool, authentic : A109Verdict, status : A109Verdict)
define enp_issuer(v : A109EnrollPermit) = match v { A109EnrollPermit(issuer, person, installation, epoch, first, until, enroll, authentic, status) => issuer }
define enp_person(v : A109EnrollPermit) = match v { A109EnrollPermit(issuer, person, installation, epoch, first, until, enroll, authentic, status) => person }
define enp_installation(v : A109EnrollPermit) = match v { A109EnrollPermit(issuer, person, installation, epoch, first, until, enroll, authentic, status) => installation }
define enp_epoch(v : A109EnrollPermit) = match v { A109EnrollPermit(issuer, person, installation, epoch, first, until, enroll, authentic, status) => epoch }
define enp_first(v : A109EnrollPermit) = match v { A109EnrollPermit(issuer, person, installation, epoch, first, until, enroll, authentic, status) => first }
define enp_until(v : A109EnrollPermit) = match v { A109EnrollPermit(issuer, person, installation, epoch, first, until, enroll, authentic, status) => until }
define enp_enroll(v : A109EnrollPermit) = match v { A109EnrollPermit(issuer, person, installation, epoch, first, until, enroll, authentic, status) => enroll }
define enp_authentic(v : A109EnrollPermit) = match v { A109EnrollPermit(issuer, person, installation, epoch, first, until, enroll, authentic, status) => authentic }
define enp_status(v : A109EnrollPermit) = match v { A109EnrollPermit(issuer, person, installation, epoch, first, until, enroll, authentic, status) => status }
data A109Enrollment = A109Enrollment(anchor : BitVec64, installation : BitVec64, person : BitVec64, revision : BitVec64, enrolled : Bool)
define enr_anchor(v : A109Enrollment) = match v { A109Enrollment(anchor, installation, person, revision, enrolled) => anchor }
define enr_installation(v : A109Enrollment) = match v { A109Enrollment(anchor, installation, person, revision, enrolled) => installation }
define enr_person(v : A109Enrollment) = match v { A109Enrollment(anchor, installation, person, revision, enrolled) => person }
define enr_revision(v : A109Enrollment) = match v { A109Enrollment(anchor, installation, person, revision, enrolled) => revision }
define enr_enrolled(v : A109Enrollment) = match v { A109Enrollment(anchor, installation, person, revision, enrolled) => enrolled }
define a109_enroll_allowed(c : A109Context, e : A109Identity, p : A109EnrollPermit, old : A109Enrollment, expected : BitVec64, preflight : Bool) =
    a109_recognize(c,e,enp_person(p),bvconst(1,64)) ∧
    (enp_issuer(p)=ctx_anchor(c)) ∧ (enp_installation(p)=ctx_installation(c)) ∧ (enp_epoch(p)=ctx_epoch(c)) ∧
    a109_window(ctx_now(c),enp_first(p),enp_until(p)) ∧ enp_enroll(p) ∧
    (enp_authentic(p)=A109Valid) ∧ (enp_status(p)=A109Valid) ∧
    ¬enr_enrolled(old) ∧ (enr_anchor(old)=a109_z()) ∧ (enr_installation(old)=a109_z()) ∧ (enr_person(old)=a109_z()) ∧
    (expected=enr_revision(old)) ∧ bvult(expected,a109_max()) ∧ preflight
// Complete before/after relation; every retained field is constrained.
define a109_enroll_step(c : A109Context, e : A109Identity, p : A109EnrollPermit, old : A109Enrollment, expected : BitVec64, preflight : Bool, next : A109Enrollment) =
    ((enr_anchor(next)=(if a109_enroll_allowed(c,e,p,old,expected,preflight) then ctx_anchor(c) else enr_anchor(old))) ∧
    (enr_installation(next)=(if a109_enroll_allowed(c,e,p,old,expected,preflight) then ctx_installation(c) else enr_installation(old))) ∧
    (enr_person(next)=(if a109_enroll_allowed(c,e,p,old,expected,preflight) then enp_person(p) else enr_person(old))) ∧
    (enr_revision(next)=(if a109_enroll_allowed(c,e,p,old,expected,preflight) then a109_next(expected) else enr_revision(old))) ∧
    (enr_enrolled(next)=(if a109_enroll_allowed(c,e,p,old,expected,preflight) then (bvconst(1,8)=bvconst(1,8)) else enr_enrolled(old))))
define a109_same_enrollment(a : A109Enrollment,b : A109Enrollment) = ((enr_anchor(a)=enr_anchor(b)) ∧ (enr_installation(a)=enr_installation(b)) ∧ (enr_person(a)=enr_person(b)) ∧ (enr_revision(a)=enr_revision(b)) ∧ (enr_enrolled(a)=enr_enrolled(b)))

example "recognized authorized person enrolls" { assert(a109_enroll_allowed(A109Context(bvconst(10,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(100,64), (bvconst(1,8)=bvconst(1,8))),A109Identity(bvconst(10,64), bvconst(30,64), bvconst(1,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(90,64), bvconst(110,64), A109Valid, A109Valid, A109Valid),A109EnrollPermit(bvconst(10,64), bvconst(30,64), bvconst(20,64), bvconst(3,64), bvconst(90,64), bvconst(110,64), (bvconst(1,8)=bvconst(1,8)), A109Valid, A109Valid),A109Enrollment(bvconst(0,64), bvconst(0,64), bvconst(0,64), bvconst(0,64), (bvconst(1,8)=bvconst(0,8))),bvconst(0,64),(bvconst(1,8)=bvconst(1,8)))) }
