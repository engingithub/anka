// Concrete ABI v2 artifact and expanded compiler source admission. No axioms.
import "anka107_pointer_frames.kleis"
// Literal metadata is little-endian u64 words, header magic/version/code/count.
// Structural validation and exact code equality are obligations of the parser.
define artifact107_admit(version : BitVec64, code : BitVec64, metadata_code : BitVec64,
    count : BitVec64, sealed : BitVec8, generation : BitVec8,
    exact_bytes : BitVec8, structure : BitVec8, consumed_all : BitVec8) =
    (version=bvconst(2,64)) ∧ (code=metadata_code) ∧ bvugt(code,bvconst(0,64)) ∧
    bvugt(count,bvconst(0,64)) ∧ bvule(count,bvconst(4096,64)) ∧
    (sealed=bvconst(1,8)) ∧ (generation=bvconst(1,8)) ∧
    (exact_bytes=bvconst(1,8)) ∧ (structure=bvconst(1,8)) ∧ (consumed_all=bvconst(1,8))
// Dynamically placed extended source may not overlap workspace/code/output.
// Its pointer/limit are trusted invocation control, never application authority.
define artifact107_source(base : BitVec64, size : BitVec64, length : BitVec64,
    mapping : BitVec8, disjoint : BitVec8) =
    bvuge(size,bvconst(8,64)) ∧ bvule(length,bvsub(size,bvconst(8,64))) ∧
    bvule(base,bvsub(bvsub(bvconst(0,64),bvconst(1,64)),size)) ∧
    (mapping=bvconst(1,8)) ∧ (disjoint=bvconst(1,8))

example "sealed exact v2 artifact" { assert(artifact107_admit(bvconst(2,64),bvconst(256,64),bvconst(256,64),bvconst(2,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8))) }

example "wrong version" { assert(¬(artifact107_admit(bvconst(1,64),bvconst(256,64),bvconst(256,64),bvconst(2,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))) }

example "wrong code extent" { assert(¬(artifact107_admit(bvconst(2,64),bvconst(256,64),bvconst(248,64),bvconst(2,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))) }

example "empty manifests" { assert(¬(artifact107_admit(bvconst(2,64),bvconst(256,64),bvconst(256,64),bvconst(0,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))) }

example "manifest exhaustion" { assert(¬(artifact107_admit(bvconst(2,64),bvconst(256,64),bvconst(256,64),bvconst(4097,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))) }

example "writable artifact" { assert(¬(artifact107_admit(bvconst(2,64),bvconst(256,64),bvconst(256,64),bvconst(2,64),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))) }

example "stale artifact" { assert(¬(artifact107_admit(bvconst(2,64),bvconst(256,64),bvconst(256,64),bvconst(2,64),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))) }

example "substitute code" { assert(¬(artifact107_admit(bvconst(2,64),bvconst(256,64),bvconst(256,64),bvconst(2,64),bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1,8)))) }

example "malformed manifest" { assert(¬(artifact107_admit(bvconst(2,64),bvconst(256,64),bvconst(256,64),bvconst(2,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(1,8)))) }

example "trailing metadata" { assert(¬(artifact107_admit(bvconst(2,64),bvconst(256,64),bvconst(256,64),bvconst(2,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,8)))) }

example "expanded source fits" { assert(artifact107_source(bvconst(1048576,64),bvconst(32768,64),bvconst(30000,64),bvconst(1,8),bvconst(1,8))) }

example "source overruns header capacity" { assert(¬(artifact107_source(bvconst(1048576,64),bvconst(32768,64),bvconst(32761,64),bvconst(1,8),bvconst(1,8)))) }

example "source mapping missing" { assert(¬(artifact107_source(bvconst(1048576,64),bvconst(32768,64),bvconst(30000,64),bvconst(0,8),bvconst(1,8)))) }

example "source overlaps workspace" { assert(¬(artifact107_source(bvconst(1048576,64),bvconst(32768,64),bvconst(30000,64),bvconst(1,8),bvconst(0,8)))) }

example "all admitted source lengths fit" { assert(∀(base : BitVec64). ∀(size : BitVec64). ∀(length : BitVec64). artifact107_source(base,size,length,bvconst(1,8),bvconst(1,8)) → (bvuge(bvadd(length,bvconst(8,64)),length) ∧ bvule(bvadd(length,bvconst(8,64)),size))) }

// First protected compiler slice exposes scalar EXIT only. Legacy numeric
// address syscalls cannot bypass allocation-associated application pointers.
define artifact107_syscall(profile : BitVec8, number : BitVec64) =
    (profile=bvconst(0,8)) ∨ ((profile=bvconst(1,8)) ∧ (number=bvconst(0,64)))
example "protected scalar exit" { assert(artifact107_syscall(bvconst(1,8),bvconst(0,64))) }
example "protected raw address syscall denied" { assert(¬(artifact107_syscall(bvconst(1,8),bvconst(1,64)))) }
example "legacy syscall retains admission" { assert(artifact107_syscall(bvconst(0,8),bvconst(1,64))) }

// Word-index lowering uses eight checked PADD transitions, not a wrapping MUL.
// These positive-delta obligations connect the concrete sequence to ptr107_step.
define artifact107_step(p : BitVec64, d : BitVec64) =
    bvule(p,bvsub(bvsub(bvconst(0,64),bvconst(1,64)),d))
define artifact107_word_chain(p : BitVec64, d : BitVec64) =
    artifact107_step(bvadd(p,bvmul(d,bvconst(0,64))),d) ∧
    artifact107_step(bvadd(p,bvmul(d,bvconst(1,64))),d) ∧
    artifact107_step(bvadd(p,bvmul(d,bvconst(2,64))),d) ∧
    artifact107_step(bvadd(p,bvmul(d,bvconst(3,64))),d) ∧
    artifact107_step(bvadd(p,bvmul(d,bvconst(4,64))),d) ∧
    artifact107_step(bvadd(p,bvmul(d,bvconst(5,64))),d) ∧
    artifact107_step(bvadd(p,bvmul(d,bvconst(6,64))),d) ∧
    artifact107_step(bvadd(p,bvmul(d,bvconst(7,64))),d)
define artifact107_negatable(d : BitVec64) = ¬(d=bvshl(bvconst(1,64),bvconst(63,64)))
example "checked word traversal" { assert(artifact107_word_chain(bvconst(0,64),bvconst(1,64))) }
example "wrapping scale cannot be admitted" { assert(¬(artifact107_word_chain(bvconst(0,64),bvconst(2305843009213693952,64)))) }
example "every checked scaling step is nonwrapping" { assert(∀(p : BitVec64). ∀(d : BitVec64). artifact107_step(p,d) → bvuge(bvadd(p,d),p)) }
example "signed minimum cannot be negated" { assert(¬(artifact107_negatable(bvshl(bvconst(1,64),bvconst(63,64))))) }
example "negative one may be negated" { assert(artifact107_negatable(bvsub(bvconst(0,64),bvconst(1,64)))) }
