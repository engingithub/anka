example "law: complete transition is deterministic" { assert(∀ c_anchor : BitVec64 . ∀ c_installation : BitVec64 . ∀ c_epoch : BitVec64 . ∀ c_challenge : BitVec64 . ∀ c_now : BitVec64 . ∀ c_selected : Bool . ∀ s_revision : BitVec64 . ∀ s_value : BitVec64 . ∀ s_boot : BitVec64 . ∀ s_sequence : BitVec64 . ∀ s_caller : BitVec64 . ∀ s_incarnation : BitVec64 . ∀ s_kind : BitVec64 . ∀ s_expected : BitVec64 . ∀ s_argument : BitVec64 . ∀ s_attempt : BitVec64 . ∀ s_anchor : BitVec64 . ∀ s_installation : BitVec64 . ∀ s_policy : BitVec64 . ∀ r_anchor : BitVec64 . ∀ r_installation : BitVec64 . ∀ r_policy : BitVec64 . ∀ r_caller : BitVec64 . ∀ r_incarnation : BitVec64 . ∀ r_sequence : BitVec64 . ∀ r_expected : BitVec64 . ∀ r_kind : BitVec64 . ∀ r_argument : BitVec64 . ∀ r_attempt : BitVec64 . ∀ a_anchor : BitVec64 . ∀ a_installation : BitVec64 . ∀ a_policy : BitVec64 . ∀ a_caller : BitVec64 . ∀ a_incarnation : BitVec64 . ∀ a_kind : BitVec64 . ∀ a_first : BitVec64 . ∀ a_until : BitVec64 . ∀ a_authentic : A109Verdict . ∀ a_status : A109Verdict . ∀ t_revision : BitVec64 . ∀ t_value : BitVec64 . ∀ t_boot : BitVec64 . ∀ t_sequence : BitVec64 . ∀ t_caller : BitVec64 . ∀ t_incarnation : BitVec64 . ∀ t_kind : BitVec64 . ∀ t_expected : BitVec64 . ∀ t_argument : BitVec64 . ∀ t_attempt : BitVec64 . ∀ t_anchor : BitVec64 . ∀ t_installation : BitVec64 . ∀ t_policy : BitVec64 . ∀ u_revision : BitVec64 . ∀ u_value : BitVec64 . ∀ u_boot : BitVec64 . ∀ u_sequence : BitVec64 . ∀ u_caller : BitVec64 . ∀ u_incarnation : BitVec64 . ∀ u_kind : BitVec64 . ∀ u_expected : BitVec64 . ∀ u_argument : BitVec64 . ∀ u_attempt : BitVec64 . ∀ u_anchor : BitVec64 . ∀ u_installation : BitVec64 . ∀ u_policy : BitVec64 . ∀ cap : Bool . ∀ dur : Bool . (p109_step(A109Context(c_anchor,c_installation,c_epoch,c_challenge,c_now,c_selected),P109State(s_revision,s_value,s_boot,s_sequence,s_caller,s_incarnation,s_kind,s_expected,s_argument,s_attempt,s_anchor,s_installation,s_policy),P109Request(r_anchor,r_installation,r_policy,r_caller,r_incarnation,r_sequence,r_expected,r_kind,r_argument,r_attempt),P109Access(a_anchor,a_installation,a_policy,a_caller,a_incarnation,a_kind,a_first,a_until,a_authentic,a_status),cap,dur,P109State(t_revision,t_value,t_boot,t_sequence,t_caller,t_incarnation,t_kind,t_expected,t_argument,t_attempt,t_anchor,t_installation,t_policy)) ∧ p109_step(A109Context(c_anchor,c_installation,c_epoch,c_challenge,c_now,c_selected),P109State(s_revision,s_value,s_boot,s_sequence,s_caller,s_incarnation,s_kind,s_expected,s_argument,s_attempt,s_anchor,s_installation,s_policy),P109Request(r_anchor,r_installation,r_policy,r_caller,r_incarnation,r_sequence,r_expected,r_kind,r_argument,r_attempt),P109Access(a_anchor,a_installation,a_policy,a_caller,a_incarnation,a_kind,a_first,a_until,a_authentic,a_status),cap,dur,P109State(u_revision,u_value,u_boot,u_sequence,u_caller,u_incarnation,u_kind,u_expected,u_argument,u_attempt,u_anchor,u_installation,u_policy))) ⟹ p109_same(P109State(t_revision,t_value,t_boot,t_sequence,t_caller,t_incarnation,t_kind,t_expected,t_argument,t_attempt,t_anchor,t_installation,t_policy),P109State(u_revision,u_value,u_boot,u_sequence,u_caller,u_incarnation,u_kind,u_expected,u_argument,u_attempt,u_anchor,u_installation,u_policy))) }
