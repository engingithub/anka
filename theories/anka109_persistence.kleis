// T2 persistence core. No new axioms; finite-width transition contracts.
// One installation record, one serialized writer, concurrent requesters.
// value/argument are opaque equality identities for validated immutable records,
// NOT cryptographic hashes, local ObjectIds or serialized receipt authority.
// Authority evidence is trusted validator output over the bound grant/request;
// it is not a caller-provided Boolean. T3 supplies concrete derivation/validation.
// durable=true means the backend atomically persisted EVERY next-state field.
// This assumes an honest crash-recoverable backend, not whole-store anti-rollback.
// Fixed one-outcome retry window: older sequence numbers reject, never re-execute.
import "anka109_recognition.kleis"
data P109State = P109State(revision : BitVec64, value : BitVec64, boot : BitVec64, sequence : BitVec64, caller : BitVec64, incarnation : BitVec64, kind : BitVec64, expected : BitVec64, argument : BitVec64, attempt : BitVec64, anchor : BitVec64, installation : BitVec64, policy : BitVec64)
define ps_revision(v : P109State) = match v { P109State(revision,value,boot,sequence,caller,incarnation,kind,expected,argument,attempt,anchor,installation,policy) => revision }
define ps_value(v : P109State) = match v { P109State(revision,value,boot,sequence,caller,incarnation,kind,expected,argument,attempt,anchor,installation,policy) => value }
define ps_boot(v : P109State) = match v { P109State(revision,value,boot,sequence,caller,incarnation,kind,expected,argument,attempt,anchor,installation,policy) => boot }
define ps_sequence(v : P109State) = match v { P109State(revision,value,boot,sequence,caller,incarnation,kind,expected,argument,attempt,anchor,installation,policy) => sequence }
define ps_caller(v : P109State) = match v { P109State(revision,value,boot,sequence,caller,incarnation,kind,expected,argument,attempt,anchor,installation,policy) => caller }
define ps_incarnation(v : P109State) = match v { P109State(revision,value,boot,sequence,caller,incarnation,kind,expected,argument,attempt,anchor,installation,policy) => incarnation }
define ps_kind(v : P109State) = match v { P109State(revision,value,boot,sequence,caller,incarnation,kind,expected,argument,attempt,anchor,installation,policy) => kind }
define ps_expected(v : P109State) = match v { P109State(revision,value,boot,sequence,caller,incarnation,kind,expected,argument,attempt,anchor,installation,policy) => expected }
define ps_argument(v : P109State) = match v { P109State(revision,value,boot,sequence,caller,incarnation,kind,expected,argument,attempt,anchor,installation,policy) => argument }
define ps_attempt(v : P109State) = match v { P109State(revision,value,boot,sequence,caller,incarnation,kind,expected,argument,attempt,anchor,installation,policy) => attempt }
define ps_anchor(v : P109State) = match v { P109State(revision,value,boot,sequence,caller,incarnation,kind,expected,argument,attempt,anchor,installation,policy) => anchor }
define ps_installation(v : P109State) = match v { P109State(revision,value,boot,sequence,caller,incarnation,kind,expected,argument,attempt,anchor,installation,policy) => installation }
define ps_policy(v : P109State) = match v { P109State(revision,value,boot,sequence,caller,incarnation,kind,expected,argument,attempt,anchor,installation,policy) => policy }
data P109Request = P109Request(anchor : BitVec64, installation : BitVec64, policy : BitVec64, caller : BitVec64, incarnation : BitVec64, sequence : BitVec64, expected : BitVec64, kind : BitVec64, argument : BitVec64, attempt : BitVec64)
define pr_anchor(v : P109Request) = match v { P109Request(anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => anchor }
define pr_installation(v : P109Request) = match v { P109Request(anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => installation }
define pr_policy(v : P109Request) = match v { P109Request(anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => policy }
define pr_caller(v : P109Request) = match v { P109Request(anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => caller }
define pr_incarnation(v : P109Request) = match v { P109Request(anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => incarnation }
define pr_sequence(v : P109Request) = match v { P109Request(anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => sequence }
define pr_expected(v : P109Request) = match v { P109Request(anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => expected }
define pr_kind(v : P109Request) = match v { P109Request(anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => kind }
define pr_argument(v : P109Request) = match v { P109Request(anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => argument }
define pr_attempt(v : P109Request) = match v { P109Request(anchor,installation,policy,caller,incarnation,sequence,expected,kind,argument,attempt) => attempt }
data P109Access = P109Access(anchor : BitVec64, installation : BitVec64, policy : BitVec64, caller : BitVec64, incarnation : BitVec64, kind : BitVec64, first : BitVec64, until : BitVec64, authentic : A109Verdict, status : A109Verdict)
define pa_anchor(v : P109Access) = match v { P109Access(anchor,installation,policy,caller,incarnation,kind,first,until,authentic,status) => anchor }
define pa_installation(v : P109Access) = match v { P109Access(anchor,installation,policy,caller,incarnation,kind,first,until,authentic,status) => installation }
define pa_policy(v : P109Access) = match v { P109Access(anchor,installation,policy,caller,incarnation,kind,first,until,authentic,status) => policy }
define pa_caller(v : P109Access) = match v { P109Access(anchor,installation,policy,caller,incarnation,kind,first,until,authentic,status) => caller }
define pa_incarnation(v : P109Access) = match v { P109Access(anchor,installation,policy,caller,incarnation,kind,first,until,authentic,status) => incarnation }
define pa_kind(v : P109Access) = match v { P109Access(anchor,installation,policy,caller,incarnation,kind,first,until,authentic,status) => kind }
define pa_first(v : P109Access) = match v { P109Access(anchor,installation,policy,caller,incarnation,kind,first,until,authentic,status) => first }
define pa_until(v : P109Access) = match v { P109Access(anchor,installation,policy,caller,incarnation,kind,first,until,authentic,status) => until }
define pa_authentic(v : P109Access) = match v { P109Access(anchor,installation,policy,caller,incarnation,kind,first,until,authentic,status) => authentic }
define pa_status(v : P109Access) = match v { P109Access(anchor,installation,policy,caller,incarnation,kind,first,until,authentic,status) => status }

define p109_authorized(c : A109Context, r : P109Request, a : P109Access) =
    ctx_selected(c) ∧ a109_nonzero(ctx_anchor(c)) ∧ a109_nonzero(ctx_installation(c)) ∧
    (pr_anchor(r)=ctx_anchor(c)) ∧ (pr_installation(r)=ctx_installation(c)) ∧ (pr_policy(r)=ctx_epoch(c)) ∧
    (pa_anchor(a)=pr_anchor(r)) ∧ (pa_installation(a)=pr_installation(r)) ∧ (pa_policy(a)=pr_policy(r)) ∧
    a109_nonzero(pr_caller(r)) ∧ a109_nonzero(pr_incarnation(r)) ∧
    (pa_caller(a)=pr_caller(r)) ∧ (pa_incarnation(a)=pr_incarnation(r)) ∧ (pa_kind(a)=pr_kind(r)) ∧
    ((pr_kind(r)=bvconst(1,64)) ∨ (pr_kind(r)=bvconst(2,64))) ∧
    (pa_authentic(a)=A109Valid) ∧ (pa_status(a)=A109Valid) ∧
    a109_window(ctx_now(c),pa_first(a),pa_until(a))
// The current anchor/installation/policy are supplied by trusted observations
// for this store; equality of two stale caller-supplied records is insufficient.
define p109_exact(s : P109State, r : P109Request) =
    a109_nonzero(ps_sequence(s)) ∧ (ps_anchor(s)=pr_anchor(r)) ∧ (ps_installation(s)=pr_installation(r)) ∧ (ps_policy(s)=pr_policy(r)) ∧ (ps_sequence(s)=pr_sequence(r)) ∧
    (ps_caller(s)=pr_caller(r)) ∧ (ps_incarnation(s)=pr_incarnation(r)) ∧
    (ps_kind(s)=pr_kind(r)) ∧ (ps_expected(s)=pr_expected(r)) ∧
    (ps_argument(s)=pr_argument(r)) ∧ (ps_attempt(s)=pr_attempt(r))
define p109_replay(c : A109Context,s : P109State,r : P109Request,a : P109Access) =
    p109_authorized(c,r,a) ∧ p109_exact(s,r)
define p109_new(c : A109Context,s : P109State,r : P109Request,a : P109Access,capacity : Bool) =
    p109_authorized(c,r,a) ∧ capacity ∧ bvult(ps_revision(s),a109_max()) ∧
    bvult(ps_sequence(s),a109_max()) ∧ (pr_sequence(r)=a109_next(ps_sequence(s))) ∧
    (pr_expected(r)=ps_revision(s)) ∧ a109_nonzero(pr_argument(r)) ∧
    (((pr_kind(r)=bvconst(1,64)) ∧ (pr_attempt(r)=a109_z())) ∨
     ((pr_kind(r)=bvconst(2,64)) ∧ (pr_argument(r)=ps_value(s)) ∧
      a109_nonzero(pr_attempt(r)) ∧ bvult(ps_boot(s),a109_max())))
define p109_same(s : P109State,t : P109State) = (ps_revision(s)=ps_revision(t)) ∧ (ps_value(s)=ps_value(t)) ∧ (ps_boot(s)=ps_boot(t)) ∧ (ps_sequence(s)=ps_sequence(t)) ∧ (ps_caller(s)=ps_caller(t)) ∧ (ps_incarnation(s)=ps_incarnation(t)) ∧ (ps_kind(s)=ps_kind(t)) ∧ (ps_expected(s)=ps_expected(t)) ∧ (ps_argument(s)=ps_argument(t)) ∧ (ps_attempt(s)=ps_attempt(t)) ∧ (ps_anchor(s)=ps_anchor(t)) ∧ (ps_installation(s)=ps_installation(t)) ∧ (ps_policy(s)=ps_policy(t))
define p109_step(c : A109Context,s : P109State,r : P109Request,a : P109Access,capacity : Bool,durable : Bool,t : P109State) =
    (ps_revision(t)=(if p109_new(c,s,r,a,capacity) ∧ durable then a109_next(ps_revision(s)) else ps_revision(s))) ∧
    (ps_value(t)=(if p109_new(c,s,r,a,capacity) ∧ durable then (if pr_kind(r)=bvconst(1,64) then pr_argument(r) else ps_value(s)) else ps_value(s))) ∧
    (ps_boot(t)=(if p109_new(c,s,r,a,capacity) ∧ durable then (if pr_kind(r)=bvconst(2,64) then a109_next(ps_boot(s)) else ps_boot(s)) else ps_boot(s))) ∧
    (ps_sequence(t)=(if p109_new(c,s,r,a,capacity) ∧ durable then pr_sequence(r) else ps_sequence(s))) ∧
    (ps_caller(t)=(if p109_new(c,s,r,a,capacity) ∧ durable then pr_caller(r) else ps_caller(s))) ∧
    (ps_incarnation(t)=(if p109_new(c,s,r,a,capacity) ∧ durable then pr_incarnation(r) else ps_incarnation(s))) ∧
    (ps_kind(t)=(if p109_new(c,s,r,a,capacity) ∧ durable then pr_kind(r) else ps_kind(s))) ∧
    (ps_expected(t)=(if p109_new(c,s,r,a,capacity) ∧ durable then pr_expected(r) else ps_expected(s))) ∧
    (ps_argument(t)=(if p109_new(c,s,r,a,capacity) ∧ durable then pr_argument(r) else ps_argument(s))) ∧
    (ps_attempt(t)=(if p109_new(c,s,r,a,capacity) ∧ durable then pr_attempt(r) else ps_attempt(s))) ∧
    (ps_anchor(t)=(if p109_new(c,s,r,a,capacity) ∧ durable then pr_anchor(r) else ps_anchor(s))) ∧
    (ps_installation(t)=(if p109_new(c,s,r,a,capacity) ∧ durable then pr_installation(r) else ps_installation(s))) ∧
    (ps_policy(t)=(if p109_new(c,s,r,a,capacity) ∧ durable then pr_policy(r) else ps_policy(s)))
// ACK is possible only for a complete durable new record or an exact retained
// outcome under CURRENT read/use authority. A missing reply says nothing about commit.
define p109_ack(c : A109Context,s : P109State,r : P109Request,a : P109Access,capacity : Bool,durable : Bool,delivered : Bool) =
    delivered ∧ (p109_replay(c,s,r,a) ∨ (p109_new(c,s,r,a,capacity) ∧ durable))
example "valid conditional write" { assert(p109_new(A109Context(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(71,64),bvconst(100,64),(bvconst(1,8)=bvconst(1,8))),P109State(bvconst(7,64),bvconst(55,64),bvconst(8,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64)),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),P109Access(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(90,64),bvconst(110,64),A109Valid,A109Valid),(bvconst(1,8)=bvconst(1,8)))) }
example "atomic full record" { assert(p109_step(A109Context(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(71,64),bvconst(100,64),(bvconst(1,8)=bvconst(1,8))),P109State(bvconst(7,64),bvconst(55,64),bvconst(8,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64)),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),P109Access(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(90,64),bvconst(110,64),A109Valid,A109Valid),(bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8)),P109State(bvconst(8,64),bvconst(99,64),bvconst(8,64),bvconst(1,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(99,64),bvconst(0,64),bvconst(10,64),bvconst(20,64),bvconst(3,64)))) }
example "exact retry returns retained outcome" { assert(p109_replay(A109Context(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(71,64),bvconst(100,64),(bvconst(1,8)=bvconst(1,8))),P109State(bvconst(8,64),bvconst(99,64),bvconst(8,64),bvconst(1,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(99,64),bvconst(0,64),bvconst(10,64),bvconst(20,64),bvconst(3,64)),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),P109Access(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(90,64),bvconst(110,64),A109Valid,A109Valid))) }
example "retry does not rewrite" { assert(p109_step(A109Context(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(71,64),bvconst(100,64),(bvconst(1,8)=bvconst(1,8))),P109State(bvconst(8,64),bvconst(99,64),bvconst(8,64),bvconst(1,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(99,64),bvconst(0,64),bvconst(10,64),bvconst(20,64),bvconst(3,64)),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),P109Access(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(90,64),bvconst(110,64),A109Valid,A109Valid),(bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8)),P109State(bvconst(8,64),bvconst(99,64),bvconst(8,64),bvconst(1,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(99,64),bvconst(0,64),bvconst(10,64),bvconst(20,64),bvconst(3,64)))) }
example "crash before commit preserves all fields" { assert(p109_step(A109Context(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(71,64),bvconst(100,64),(bvconst(1,8)=bvconst(1,8))),P109State(bvconst(7,64),bvconst(55,64),bvconst(8,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64)),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),P109Access(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(90,64),bvconst(110,64),A109Valid,A109Valid),(bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(0,8)),P109State(bvconst(7,64),bvconst(55,64),bvconst(8,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64)))) }
example "denied quota preserves all fields" { assert(p109_step(A109Context(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(71,64),bvconst(100,64),(bvconst(1,8)=bvconst(1,8))),P109State(bvconst(7,64),bvconst(55,64),bvconst(8,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64)),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),P109Access(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(90,64),bvconst(110,64),A109Valid,A109Valid),(bvconst(1,8)=bvconst(0,8)),(bvconst(1,8)=bvconst(1,8)),P109State(bvconst(7,64),bvconst(55,64),bvconst(8,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64)))) }
