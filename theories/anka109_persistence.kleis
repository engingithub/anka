example "boot reservation increments only boot and revision" { assert(p109_step(A109Context(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(71,64),bvconst(100,64),(bvconst(1,8)=bvconst(1,8))),P109State(bvconst(7,64),bvconst(55,64),bvconst(8,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64)),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(2,64),bvconst(55,64),bvconst(71,64)),P109Access(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(2,64),bvconst(90,64),bvconst(110,64),A109Valid,A109Valid),(bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8)),P109State(bvconst(8,64),bvconst(55,64),bvconst(9,64),bvconst(1,64),bvconst(30,64),bvconst(4,64),bvconst(2,64),bvconst(7,64),bvconst(55,64),bvconst(71,64),bvconst(10,64),bvconst(20,64),bvconst(3,64)))) }
example "reject request anchor" { assert(¬(p109_new(A109Context(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(71,64),bvconst(100,64),(bvconst(1,8)=bvconst(1,8))),P109State(bvconst(7,64),bvconst(55,64),bvconst(8,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64)),P109Request(bvconst(11,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),P109Access(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(90,64),bvconst(110,64),A109Valid,A109Valid),(bvconst(1,8)=bvconst(1,8))))) }
