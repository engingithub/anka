example "SA110 163 counter increment never wraps" {
    assert(∀(v : BitVec64). bvule(v,sa110_inc(v)))
}

example "SA110 164 highwater never decreases" {
    assert(∀(a : BitVec64,b : BitVec64). bvule(a,sa110_max(a,b)) ∧ bvule(b,sa110_max(a,b)))
}

