// SA110: single-owner serialized authority state machine, not a deployed service.
// No new axioms. Import KC110 without weakening its candidate, time or scope gates.
// Identities are collision-free equality handles, not truncated hashes or wire IDs.
// All transitions below are ONE atomic local critical section, including effect
// submission. Their before-state is the unique current state, never a guest copy.
// Control attestation must establish exclusive mediation of relevant issuer/admin,
// grant, policy and key changes. The accepted Keycloak CLI DOES NOT establish it.
// Unmediated remote changes cannot be ordered by local mutexes or introspection.
// Mode 0 closed, 1 open, 2 poisoned. No live/boot authority is implemented here.
import "anka110_keycloak_adapter.kleis"


data SA110State = SA110State(domain : BitVec64, installation : BitVec64, issuer : BitVec64, policy : BitVec64, keyset : BitVec64, incarnation : BitVec64, revision : BitVec64, next_seq : BitVec64, remaining : BitVec64, deadline : BitVec64, last_tick : BitVec64, last_wall : BitVec64, effects : BitVec64, boot : BitVec64, mode : BitVec64, pending : BitVec64, controlled : A109Verdict)

define sas_domain(v : SA110State) = match v { SA110State(domain,installation,issuer,policy,keyset,incarnation,revision,next_seq,remaining,deadline,last_tick,last_wall,effects,boot,mode,pending,controlled) => domain }

define sas_installation(v : SA110State) = match v { SA110State(domain,installation,issuer,policy,keyset,incarnation,revision,next_seq,remaining,deadline,last_tick,last_wall,effects,boot,mode,pending,controlled) => installation }

define sas_issuer(v : SA110State) = match v { SA110State(domain,installation,issuer,policy,keyset,incarnation,revision,next_seq,remaining,deadline,last_tick,last_wall,effects,boot,mode,pending,controlled) => issuer }

define sas_policy(v : SA110State) = match v { SA110State(domain,installation,issuer,policy,keyset,incarnation,revision,next_seq,remaining,deadline,last_tick,last_wall,effects,boot,mode,pending,controlled) => policy }

define sas_keyset(v : SA110State) = match v { SA110State(domain,installation,issuer,policy,keyset,incarnation,revision,next_seq,remaining,deadline,last_tick,last_wall,effects,boot,mode,pending,controlled) => keyset }

define sas_incarnation(v : SA110State) = match v { SA110State(domain,installation,issuer,policy,keyset,incarnation,revision,next_seq,remaining,deadline,last_tick,last_wall,effects,boot,mode,pending,controlled) => incarnation }

define sas_revision(v : SA110State) = match v { SA110State(domain,installation,issuer,policy,keyset,incarnation,revision,next_seq,remaining,deadline,last_tick,last_wall,effects,boot,mode,pending,controlled) => revision }

define sas_next_seq(v : SA110State) = match v { SA110State(domain,installation,issuer,policy,keyset,incarnation,revision,next_seq,remaining,deadline,last_tick,last_wall,effects,boot,mode,pending,controlled) => next_seq }

define sas_remaining(v : SA110State) = match v { SA110State(domain,installation,issuer,policy,keyset,incarnation,revision,next_seq,remaining,deadline,last_tick,last_wall,effects,boot,mode,pending,controlled) => remaining }

define sas_deadline(v : SA110State) = match v { SA110State(domain,installation,issuer,policy,keyset,incarnation,revision,next_seq,remaining,deadline,last_tick,last_wall,effects,boot,mode,pending,controlled) => deadline }

define sas_last_tick(v : SA110State) = match v { SA110State(domain,installation,issuer,policy,keyset,incarnation,revision,next_seq,remaining,deadline,last_tick,last_wall,effects,boot,mode,pending,controlled) => last_tick }

define sas_last_wall(v : SA110State) = match v { SA110State(domain,installation,issuer,policy,keyset,incarnation,revision,next_seq,remaining,deadline,last_tick,last_wall,effects,boot,mode,pending,controlled) => last_wall }

define sas_effects(v : SA110State) = match v { SA110State(domain,installation,issuer,policy,keyset,incarnation,revision,next_seq,remaining,deadline,last_tick,last_wall,effects,boot,mode,pending,controlled) => effects }

define sas_boot(v : SA110State) = match v { SA110State(domain,installation,issuer,policy,keyset,incarnation,revision,next_seq,remaining,deadline,last_tick,last_wall,effects,boot,mode,pending,controlled) => boot }

define sas_mode(v : SA110State) = match v { SA110State(domain,installation,issuer,policy,keyset,incarnation,revision,next_seq,remaining,deadline,last_tick,last_wall,effects,boot,mode,pending,controlled) => mode }

define sas_pending(v : SA110State) = match v { SA110State(domain,installation,issuer,policy,keyset,incarnation,revision,next_seq,remaining,deadline,last_tick,last_wall,effects,boot,mode,pending,controlled) => pending }

define sas_controlled(v : SA110State) = match v { SA110State(domain,installation,issuer,policy,keyset,incarnation,revision,next_seq,remaining,deadline,last_tick,last_wall,effects,boot,mode,pending,controlled) => controlled }

data SA110Proposal = SA110Proposal(domain : BitVec64, incarnation : BitVec64, revision : BitVec64, sequence : BitVec64, token : BitVec64, keyset : BitVec64, at_tick : BitVec64, scope_installation : BitVec64, scope_policy : BitVec64, scope_peer : BitVec64, scope_kind : BitVec64, scope_artifact : BitVec64, scope_generation : BitVec64, scope_request : BitVec64, scope_operation : BitVec64, scope_role : BitVec64, scope_runtime : BitVec64, scope_connection : BitVec64, scope_binding : BitVec64, scope_local : BitVec64, scope_incarnation : BitVec64, scope_serial : BitVec64, scope_challenge : BitVec64)

define sar_domain(v : SA110Proposal) = match v { SA110Proposal(domain,incarnation,revision,sequence,token,keyset,at_tick,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge) => domain }

define sar_incarnation(v : SA110Proposal) = match v { SA110Proposal(domain,incarnation,revision,sequence,token,keyset,at_tick,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge) => incarnation }

define sar_revision(v : SA110Proposal) = match v { SA110Proposal(domain,incarnation,revision,sequence,token,keyset,at_tick,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge) => revision }

define sar_sequence(v : SA110Proposal) = match v { SA110Proposal(domain,incarnation,revision,sequence,token,keyset,at_tick,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge) => sequence }

define sar_token(v : SA110Proposal) = match v { SA110Proposal(domain,incarnation,revision,sequence,token,keyset,at_tick,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge) => token }

define sar_keyset(v : SA110Proposal) = match v { SA110Proposal(domain,incarnation,revision,sequence,token,keyset,at_tick,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge) => keyset }

define sar_at_tick(v : SA110Proposal) = match v { SA110Proposal(domain,incarnation,revision,sequence,token,keyset,at_tick,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge) => at_tick }

define sar_scope_installation(v : SA110Proposal) = match v { SA110Proposal(domain,incarnation,revision,sequence,token,keyset,at_tick,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge) => scope_installation }

define sar_scope_policy(v : SA110Proposal) = match v { SA110Proposal(domain,incarnation,revision,sequence,token,keyset,at_tick,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge) => scope_policy }

define sar_scope_peer(v : SA110Proposal) = match v { SA110Proposal(domain,incarnation,revision,sequence,token,keyset,at_tick,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge) => scope_peer }

define sar_scope_kind(v : SA110Proposal) = match v { SA110Proposal(domain,incarnation,revision,sequence,token,keyset,at_tick,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge) => scope_kind }

define sar_scope_artifact(v : SA110Proposal) = match v { SA110Proposal(domain,incarnation,revision,sequence,token,keyset,at_tick,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge) => scope_artifact }

define sar_scope_generation(v : SA110Proposal) = match v { SA110Proposal(domain,incarnation,revision,sequence,token,keyset,at_tick,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge) => scope_generation }

define sar_scope_request(v : SA110Proposal) = match v { SA110Proposal(domain,incarnation,revision,sequence,token,keyset,at_tick,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge) => scope_request }

define sar_scope_operation(v : SA110Proposal) = match v { SA110Proposal(domain,incarnation,revision,sequence,token,keyset,at_tick,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge) => scope_operation }

define sar_scope_role(v : SA110Proposal) = match v { SA110Proposal(domain,incarnation,revision,sequence,token,keyset,at_tick,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge) => scope_role }

define sar_scope_runtime(v : SA110Proposal) = match v { SA110Proposal(domain,incarnation,revision,sequence,token,keyset,at_tick,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge) => scope_runtime }

define sar_scope_connection(v : SA110Proposal) = match v { SA110Proposal(domain,incarnation,revision,sequence,token,keyset,at_tick,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge) => scope_connection }

define sar_scope_binding(v : SA110Proposal) = match v { SA110Proposal(domain,incarnation,revision,sequence,token,keyset,at_tick,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge) => scope_binding }

define sar_scope_local(v : SA110Proposal) = match v { SA110Proposal(domain,incarnation,revision,sequence,token,keyset,at_tick,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge) => scope_local }

define sar_scope_incarnation(v : SA110Proposal) = match v { SA110Proposal(domain,incarnation,revision,sequence,token,keyset,at_tick,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge) => scope_incarnation }

define sar_scope_serial(v : SA110Proposal) = match v { SA110Proposal(domain,incarnation,revision,sequence,token,keyset,at_tick,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge) => scope_serial }

define sar_scope_challenge(v : SA110Proposal) = match v { SA110Proposal(domain,incarnation,revision,sequence,token,keyset,at_tick,scope_installation,scope_policy,scope_peer,scope_kind,scope_artifact,scope_generation,scope_request,scope_operation,scope_role,scope_runtime,scope_connection,scope_binding,scope_local,scope_incarnation,scope_serial,scope_challenge) => scope_challenge }

data SA110Ack = SA110Ack(domain : BitVec64, incarnation : BitVec64, revision : BitVec64, command : BitVec64, policy : BitVec64, keyset : BitVec64, checked : A109Verdict, enabled : A109Verdict)

define saa_domain(v : SA110Ack) = match v { SA110Ack(domain,incarnation,revision,command,policy,keyset,checked,enabled) => domain }

define saa_incarnation(v : SA110Ack) = match v { SA110Ack(domain,incarnation,revision,command,policy,keyset,checked,enabled) => incarnation }

define saa_revision(v : SA110Ack) = match v { SA110Ack(domain,incarnation,revision,command,policy,keyset,checked,enabled) => revision }

define saa_command(v : SA110Ack) = match v { SA110Ack(domain,incarnation,revision,command,policy,keyset,checked,enabled) => command }

define saa_policy(v : SA110Ack) = match v { SA110Ack(domain,incarnation,revision,command,policy,keyset,checked,enabled) => policy }

define saa_keyset(v : SA110Ack) = match v { SA110Ack(domain,incarnation,revision,command,policy,keyset,checked,enabled) => keyset }

define saa_checked(v : SA110Ack) = match v { SA110Ack(domain,incarnation,revision,command,policy,keyset,checked,enabled) => checked }

define saa_enabled(v : SA110Ack) = match v { SA110Ack(domain,incarnation,revision,command,policy,keyset,checked,enabled) => enabled }

define sa110_p_scope(r : SA110Proposal,s : KC110Scope) =
    (sar_scope_installation(r)=kcs_installation(s)) ∧ (sar_scope_policy(r)=kcs_policy(s)) ∧ (sar_scope_peer(r)=kcs_peer(s)) ∧ (sar_scope_kind(r)=kcs_kind(s)) ∧ (sar_scope_artifact(r)=kcs_artifact(s)) ∧ (sar_scope_generation(r)=kcs_generation(s)) ∧ (sar_scope_request(r)=kcs_request(s)) ∧ (sar_scope_operation(r)=kcs_operation(s)) ∧ (sar_scope_role(r)=kcs_role(s)) ∧ (sar_scope_runtime(r)=kcs_runtime(s)) ∧ (sar_scope_connection(r)=kcs_connection(s)) ∧ (sar_scope_binding(r)=kcs_binding(s)) ∧ (sar_scope_local(r)=kcs_local(s)) ∧ (sar_scope_incarnation(r)=kcs_incarnation(s)) ∧ (sar_scope_serial(r)=kcs_serial(s)) ∧ (sar_scope_challenge(r)=kcs_challenge(s))


define sa110_inc(v : BitVec64) = if bvult(v,a109_max()) then bvadd(v,bvconst(1,64)) else v
define sa110_max(a : BitVec64,b : BitVec64) = if bvule(a,b) then b else a
define sa110_wellformed(a : SA110State) =
    kc110_nz(sas_domain(a)) ∧ kc110_nz(sas_installation(a)) ∧ kc110_nz(sas_issuer(a)) ∧
    kc110_nz(sas_policy(a)) ∧ kc110_nz(sas_keyset(a)) ∧ kc110_nz(sas_incarnation(a)) ∧
    kc110_nz(sas_revision(a)) ∧ kc110_nz(sas_next_seq(a)) ∧
    bvule(sas_remaining(a),bvconst(512,64)) ∧ bvule(sas_mode(a),bvconst(2,64)) ∧
    ((sas_mode(a)=bvconst(1,64)) → (sas_pending(a)=bvconst(0,64)))
define sa110_clock(a : SA110State,wall : BitVec64,tick : BitVec64) =
    bvule(sas_last_wall(a),wall) ∧ bvule(sas_last_tick(a),tick)
define sa110_fault(a : SA110State,wall : BitVec64,tick : BitVec64) =
    ¬sa110_clock(a,wall,tick) ∨ (sas_next_seq(a)=a109_max()) ∨ (sas_effects(a)=a109_max())
define sa110_budget(a : SA110State,wall : BitVec64,tick : BitVec64) =
    sa110_clock(a,wall,tick) ∧ kc110_nz(sas_remaining(a)) ∧
    bvult(tick,sas_deadline(a)) ∧ bvult(sas_next_seq(a),a109_max())
// Even denied or malformed attempts consume work and sequence without wrap.
// Every administrative transition spends from the same original operation budget.
define sa110_cost(a : SA110State,n : SA110State,wall : BitVec64,tick : BitVec64) =
    (sas_remaining(n)=(if kc110_nz(sas_remaining(a)) then bvsub(sas_remaining(a),bvconst(1,64)) else bvconst(0,64))) ∧
    (sas_next_seq(n)=sa110_inc(sas_next_seq(a))) ∧
    (sas_last_tick(n)=sa110_max(sas_last_tick(a),tick)) ∧
    (sas_last_wall(n)=sa110_max(sas_last_wall(a),wall))


define sa110_attempt_frame(a : SA110State,n : SA110State) =
    (sas_domain(n)=sas_domain(a)) ∧ (sas_installation(n)=sas_installation(a)) ∧ (sas_issuer(n)=sas_issuer(a)) ∧ (sas_policy(n)=sas_policy(a)) ∧ (sas_keyset(n)=sas_keyset(a)) ∧ (sas_incarnation(n)=sas_incarnation(a)) ∧ (sas_revision(n)=sas_revision(a)) ∧ (sas_deadline(n)=sas_deadline(a)) ∧ (sas_boot(n)=sas_boot(a)) ∧ (sas_pending(n)=sas_pending(a)) ∧ (sas_controlled(n)=sas_controlled(a))

define sa110_barrier_frame(a : SA110State,n : SA110State) =
    (sas_domain(n)=sas_domain(a)) ∧ (sas_installation(n)=sas_installation(a)) ∧ (sas_issuer(n)=sas_issuer(a)) ∧ (sas_policy(n)=sas_policy(a)) ∧ (sas_keyset(n)=sas_keyset(a)) ∧ (sas_incarnation(n)=sas_incarnation(a)) ∧ (sas_deadline(n)=sas_deadline(a)) ∧ (sas_effects(n)=sas_effects(a)) ∧ (sas_boot(n)=sas_boot(a)) ∧ (sas_controlled(n)=sas_controlled(a))

define sa110_complete_frame(a : SA110State,n : SA110State) =
    (sas_domain(n)=sas_domain(a)) ∧ (sas_installation(n)=sas_installation(a)) ∧ (sas_issuer(n)=sas_issuer(a)) ∧ (sas_incarnation(n)=sas_incarnation(a)) ∧ (sas_revision(n)=sas_revision(a)) ∧ (sas_deadline(n)=sas_deadline(a)) ∧ (sas_effects(n)=sas_effects(a)) ∧ (sas_boot(n)=sas_boot(a)) ∧ (sas_controlled(n)=sas_controlled(a))

define sa110_establish_frame(a : SA110State,n : SA110State) =
    (sas_domain(n)=sas_domain(a)) ∧ (sas_installation(n)=sas_installation(a)) ∧ (sas_issuer(n)=sas_issuer(a)) ∧ (sas_policy(n)=sas_policy(a)) ∧ (sas_keyset(n)=sas_keyset(a)) ∧ (sas_incarnation(n)=sas_incarnation(a)) ∧ (sas_revision(n)=sas_revision(a)) ∧ (sas_deadline(n)=sas_deadline(a)) ∧ (sas_effects(n)=sas_effects(a)) ∧ (sas_boot(n)=sas_boot(a)) ∧ (sas_pending(n)=sas_pending(a))

define sa110_recover_frame(a : SA110State,n : SA110State) =
    (sas_domain(n)=sas_domain(a)) ∧ (sas_installation(n)=sas_installation(a)) ∧ (sas_issuer(n)=sas_issuer(a)) ∧ (sas_policy(n)=sas_policy(a)) ∧ (sas_keyset(n)=sas_keyset(a)) ∧ (sas_deadline(n)=sas_deadline(a)) ∧ (sas_effects(n)=sas_effects(a)) ∧ (sas_boot(n)=sas_boot(a))

define sa110_invalidate_frame(a : SA110State,n : SA110State) =
    (sas_domain(n)=sas_domain(a)) ∧ (sas_installation(n)=sas_installation(a)) ∧ (sas_issuer(n)=sas_issuer(a)) ∧ (sas_policy(n)=sas_policy(a)) ∧ (sas_keyset(n)=sas_keyset(a)) ∧ (sas_incarnation(n)=sas_incarnation(a)) ∧ (sas_deadline(n)=sas_deadline(a)) ∧ (sas_effects(n)=sas_effects(a)) ∧ (sas_boot(n)=sas_boot(a)) ∧ (sas_pending(n)=sas_pending(a))


// The proposal is untrusted/copied metadata. It has NO validity bit. Current
// authority is recomputed from owned state and exact KC110 evidence at each use.
define sa110_slot(a : SA110State,r : SA110Proposal,c : KC110Config,t : KC110Token,
    s : KC110Scope,wall : BitVec64,tick : BitVec64) =
    sa110_wellformed(a) ∧ (sas_mode(a)=bvconst(1,64)) ∧ (sas_pending(a)=bvconst(0,64)) ∧
    (sas_controlled(a)=A109Valid) ∧ sa110_budget(a,wall,tick) ∧ bvult(sas_effects(a),a109_max()) ∧
    (sas_installation(a)=kcc_installation(c)) ∧ (sas_issuer(a)=kcc_issuer(c)) ∧
    (sas_policy(a)=kcc_policy(c)) ∧ (sas_keyset(a)=kcc_keyset(c)) ∧
    (sar_domain(r)=sas_domain(a)) ∧ (sar_incarnation(r)=sas_incarnation(a)) ∧
    (sar_revision(r)=sas_revision(a)) ∧ (sar_sequence(r)=sas_next_seq(a)) ∧
    (sar_keyset(r)=sas_keyset(a)) ∧ (sar_token(r)=kct_reference(t)) ∧
    (sar_at_tick(r)=tick) ∧ sa110_p_scope(r,s)
define sa110_allow(a : SA110State,r : SA110Proposal,c : KC110Config,t : KC110Token,
    i : KC110Status,m : KC110Mapping,s : KC110Scope,p : KC110Proof,g : KC110Grant,
    wall : BitVec64,tick : BitVec64,query : BitVec64,bytes : BitVec64,channel : A109Verdict,gate : Bool) =
    sa110_slot(a,r,c,t,s,wall,tick) ∧
    kc110_candidate(c,t,i,m,s,p,g,wall,tick,query,bytes,channel) ∧ gate
// No cached `ready` parameter: the same atomic transition recomputes authority,
// applies the existing gate, consumes accounting, and emits at most one effect.
define sa110_attempt(a : SA110State,n : SA110State,r : SA110Proposal,c : KC110Config,t : KC110Token,
    i : KC110Status,m : KC110Mapping,s : KC110Scope,p : KC110Proof,g : KC110Grant,
    wall : BitVec64,tick : BitVec64,query : BitVec64,bytes : BitVec64,channel : A109Verdict,gate : Bool,emitted : BitVec64) =
    sa110_wellformed(a) ∧ sa110_attempt_frame(a,n) ∧ sa110_cost(a,n,wall,tick) ∧
    (sas_mode(n)=(if sa110_fault(a,wall,tick) then bvconst(2,64) else sas_mode(a))) ∧
    kc110_effect(sa110_allow(a,r,c,t,i,m,s,p,g,wall,tick,query,bytes,channel,gate),gate,
        sas_effects(a),sas_effects(n),emitted)
// Linearization point for revoke, key/policy/grant changes and authority loss.
// Close and advance revision BEFORE the remote/admin action is permitted to run.
// No effect is emitted; failure/outage after this point leaves the lane closed.
define sa110_barrier(a : SA110State,n : SA110State,command : BitVec64,wall : BitVec64,tick : BitVec64) =
    sa110_wellformed(a) ∧ (sas_pending(a)=bvconst(0,64)) ∧ kc110_nz(command) ∧
    sa110_barrier_frame(a,n) ∧ sa110_cost(a,n,wall,tick) ∧
    (sas_revision(n)=sa110_inc(sas_revision(a))) ∧ (sas_pending(n)=command) ∧
    (sas_mode(n)=(if sa110_fault(a,wall,tick) ∨ (sas_revision(a)=a109_max()) ∨
        (sas_mode(a)=bvconst(2,64)) then bvconst(2,64) else bvconst(0,64)))
// `checked` is a trusted control-plane verification of the ENTIRE requested
// change and outcome, not an HTTP 200, introspection active bit or guest flag.
define sa110_ack(a : SA110State,h : SA110Ack) =
    (saa_checked(h)=A109Valid) ∧ kc110_nz(sas_pending(a)) ∧
    (saa_domain(h)=sas_domain(a)) ∧ (saa_incarnation(h)=sas_incarnation(a)) ∧
    (saa_revision(h)=sas_revision(a)) ∧ (saa_command(h)=sas_pending(a)) ∧
    kc110_nz(saa_policy(h)) ∧ kc110_nz(saa_keyset(h))
define sa110_reopen(a : SA110State,h : SA110Ack,wall : BitVec64,tick : BitVec64) =
    (sas_mode(a)=bvconst(0,64)) ∧ (sas_controlled(a)=A109Valid) ∧
    sa110_ack(a,h) ∧ (saa_enabled(h)=A109Valid) ∧ sa110_budget(a,wall,tick) ∧
    ¬sa110_fault(a,wall,tick)
define sa110_complete(a : SA110State,n : SA110State,h : SA110Ack,wall : BitVec64,tick : BitVec64) =
    sa110_wellformed(a) ∧ sa110_complete_frame(a,n) ∧ sa110_cost(a,n,wall,tick) ∧
    (sas_policy(n)=(if sa110_ack(a,h) then saa_policy(h) else sas_policy(a))) ∧
    (sas_keyset(n)=(if sa110_ack(a,h) then saa_keyset(h) else sas_keyset(a))) ∧
    (sas_pending(n)=(if sa110_ack(a,h) then bvconst(0,64) else sas_pending(a))) ∧
    (sas_mode(n)=(if sa110_fault(a,wall,tick) ∨ (sas_mode(a)=bvconst(2,64)) then bvconst(2,64)
        else if sa110_reopen(a,h,wall,tick) then bvconst(1,64) else bvconst(0,64)))
// Detected loss of mediation, lock poisoning or uncertain owner integrity is
// terminal for this bounded stream, even if an admin command is already pending.
define sa110_invalidate(a : SA110State,n : SA110State,wall : BitVec64,tick : BitVec64) =
    sa110_wellformed(a) ∧ sa110_invalidate_frame(a,n) ∧ sa110_cost(a,n,wall,tick) ∧
    (sas_revision(n)=sa110_inc(sas_revision(a))) ∧ (sas_controlled(n)=A109Unknown) ∧
    (sas_mode(n)=bvconst(2,64))
// Establishing exclusive mediation is a deployment precondition, not supplied
// by KC110. Attestation covers this exact owned domain/config/incarnation and
// reconciliation of uncertain external actions. Establish alone stays closed.
define sa110_establish(a : SA110State,n : SA110State,attested : A109Verdict,wall : BitVec64,tick : BitVec64) =
    sa110_wellformed(a) ∧ (sas_mode(a)=bvconst(0,64)) ∧ (sas_pending(a)=bvconst(0,64)) ∧
    sa110_establish_frame(a,n) ∧ sa110_cost(a,n,wall,tick) ∧
    (sas_controlled(n)=(if attested=A109Valid ∧ sa110_budget(a,wall,tick) then A109Valid else A109Unknown)) ∧
    (sas_mode(n)=(if sa110_fault(a,wall,tick) then bvconst(2,64) else bvconst(0,64)))
// Recovery never restores an open lane or carries a current receipt across a
// restart. External non-reuse evidence is required, separate from boot permission.
// Even recovery preserves this operation's deadline/work/effects/boot frame.
define sa110_recover(a : SA110State,n : SA110State,incarnation : BitVec64,fresh : A109Verdict,
    wall : BitVec64,tick : BitVec64) =
    sa110_wellformed(a) ∧ sa110_recover_frame(a,n) ∧ sa110_cost(a,n,wall,tick) ∧
    (sas_incarnation(n)=(if fresh=A109Valid ∧ bvult(sas_incarnation(a),incarnation) then incarnation else sas_incarnation(a))) ∧
    (sas_revision(n)=sa110_inc(sas_revision(a))) ∧ (sas_pending(n)=bvconst(0,64)) ∧
    (sas_controlled(n)=A109Unknown) ∧
    (sas_mode(n)=(if fresh=A109Valid ∧ bvult(sas_incarnation(a),incarnation) ∧
        bvult(sas_revision(a),a109_max()) ∧ ¬sa110_fault(a,wall,tick) ∧ ¬(sas_mode(a)=bvconst(2,64))
        then bvconst(0,64) else bvconst(2,64)))


// A fence record is merely the KC110 projection of a successful atomic use.
// It is not a durable bearer receipt. A copied record cannot replace state checks.
define sa110_fence(a : SA110State,r : SA110Proposal,c : KC110Config,t : KC110Token,
    s : KC110Scope,f : KC110Fence,wall : BitVec64,tick : BitVec64) =
    sa110_slot(a,r,c,t,s,wall,tick) ∧ kc110_fence(c,t,s,f,sas_next_seq(a),tick)



// Composition checks the existing KC110 ready predicate with the owned budget.
// Runtime receipt construction/consumption must remain inside the same guard.
define sa110_kc_ready(a : SA110State,r : SA110Proposal,c : KC110Config,t : KC110Token,
    i : KC110Status,m : KC110Mapping,s : KC110Scope,p : KC110Proof,g : KC110Grant,f : KC110Fence,
    wall : BitVec64,tick : BitVec64,query : BitVec64,bytes : BitVec64,channel : A109Verdict,gate : Bool) =
    sa110_fence(a,r,c,t,s,f,wall,tick) ∧ gate ∧
    kc110_ready(c,t,i,m,s,p,g,f,KC110Budget(sas_remaining(a),sas_deadline(a),sas_last_tick(a)),
        wall,tick,query,bytes,channel,sas_next_seq(a))


