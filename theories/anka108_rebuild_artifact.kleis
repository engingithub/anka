example "rb108_open rejects reused session" {
    assert(¬(rb108_open(bvconst(1,8),bvconst(7,64),bvconst(7,64),bvconst(3,64),bvconst(3,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,8),bvconst(1,8),bvconst(1048576,64))))
