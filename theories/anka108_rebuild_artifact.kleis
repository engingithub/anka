// Phase 10.8: bounded rebuild artifact channel and atomic publication receipt.
// SPECIFICATION ONLY. No new axioms, syscall number, runtime or durability claim.
// Imports are authoritative prerequisites, not evidence that their C/Rust
// implementations refine these predicates. Certificates below MUST be derived
// by trusted checks; no certificate is an application-supplied success bit.
import "anka107_userspace_rebuild.kleis"
import "anka108_typed_input.kleis"

// One session, one output, no seek/overwrite. Artifact bound is 1 MiB;
// individual copies use the existing <=64 KiB exact-range I/O discipline.
// Phases: 0 collecting, 1 frozen/validated, 2 published, 3 aborted.
define rb108_limit() = bvconst(1048576,64)
define rb108_capacity(capacity : BitVec64) =
    bvugt(capacity,bvconst(0,64)) ∧ bvule(capacity,rb108_limit())

// A private session is bound to the actual process incarnation, context/domain,
// and a nonreused session identity. Neither a logical name nor an address is key.
define rb108_owner(session : BitVec64, presented_session : BitVec64,
    slot : BitVec64, caller_slot : BitVec64,
    process_gen : BitVec64, caller_gen : BitVec64,
    context : BitVec64, caller_context : BitVec64,
    domain : BitVec64, caller_domain : BitVec64) =
    bvugt(session,bvconst(0,64)) ∧ bvugt(process_gen,bvconst(0,64)) ∧
    (session=presented_session) ∧ (slot=caller_slot) ∧
    (process_gen=caller_gen) ∧ (context=caller_context) ∧ (domain=caller_domain)

// Identity comparison is in addition to exact immutable bytes/profile checks.
// source is the exact effective input publication; its source-bundle/include/
// preprocessing lineage is checked by rebuild107_sources_valid, not by a name.
// profile is an immutable versioned profile publication, not a mutable enum.
define rb108_binding(compiler : BitVec64, actual_compiler : BitVec64,
    compiler_gen : BitVec64, actual_compiler_gen : BitVec64,
    source : BitVec64, actual_source : BitVec64,
    source_gen : BitVec64, actual_source_gen : BitVec64,
    profile : BitVec64, actual_profile : BitVec64,
    profile_gen : BitVec64, actual_profile_gen : BitVec64) =
    bvugt(compiler_gen,bvconst(0,64)) ∧ bvugt(source_gen,bvconst(0,64)) ∧
    bvugt(profile_gen,bvconst(0,64)) ∧
    (compiler=actual_compiler) ∧ (compiler_gen=actual_compiler_gen) ∧
    (source=actual_source) ∧ (source_gen=actual_source_gen) ∧
    (profile=actual_profile) ∧ (profile_gen=actual_profile_gen)

// Restates rebuild107_producer_valid using canonical BitVec8 certificates.
// source/profile certificates require existing source-bundle/profile checks;
// host certificate requires all five flags false in rebuild107_host_boundary_valid.
// Execution does not grant publication. Only certificate value 1 is accepted.
// The system-compiler workspace profile needs an explicit adapter refinement;
// it is not silently reclassified as a protected-pointer application.
define rb108_open(fixed_point : BitVec8, expected_compiler : BitVec64,
    compiler : BitVec64, expected_gen : BitVec64, compiler_gen : BitVec64,
    sealed : BitVec8, current : BitVec8, execute : BitVec8,
    owner_checked : BitVec8, binding_checked : BitVec8,
    sources_checked : BitVec8, profile_checked : BitVec8, host_checked : BitVec8,
    fresh_session : BitVec8, publication_authority : BitVec8, capacity : BitVec64) =
    bvugt(compiler_gen,bvconst(0,64)) ∧
    (fixed_point=bvconst(1,8)) ∧ (expected_compiler=compiler) ∧ (expected_gen=compiler_gen) ∧
    (sealed=bvconst(1,8)) ∧ (current=bvconst(1,8)) ∧ (execute=bvconst(1,8)) ∧
    (owner_checked=bvconst(1,8)) ∧ (binding_checked=bvconst(1,8)) ∧ (sources_checked=bvconst(1,8)) ∧ (profile_checked=bvconst(1,8)) ∧
    (host_checked=bvconst(1,8)) ∧ (fresh_session=bvconst(1,8)) ∧ (publication_authority=bvconst(1,8)) ∧ rb108_capacity(capacity)

// owner/binding and Fabric READ/lease evidence must be rechecked at copying.
// span_checked authenticates the FULL requested range. Protected application
// syscalls use io108_buffer plus protected event ownership. Trusted compiler
// transport uses ad108_read's selected private arena/current READ grant (DN-63),
// never invented pointer tags. The adapter is a distinct trusted interface.
// Exact transaction rights apply in either case; copy_complete means private
// staging finished before the single serialized append. No borrowed address
// may survive return. The output accumulator itself has no guest write grant.
define rb108_append(phase : BitVec8, used : BitVec64, capacity : BitVec64,
    offset : BitVec64, count : BitVec64, owner_checked : BitVec8,
    binding_current : BitVec8, span_checked : BitVec8, copy_complete : BitVec8,
    serialized : BitVec8, drained : BitVec8) =
    (phase=bvconst(0,8)) ∧ rb108_capacity(capacity) ∧ bvule(used,capacity) ∧
    (offset=used) ∧ bvugt(count,bvconst(0,64)) ∧ bvule(count,io108_limit()) ∧
    bvule(count,bvsub(capacity,used)) ∧ (owner_checked=bvconst(1,8)) ∧ (binding_current=bvconst(1,8)) ∧
    (span_checked=bvconst(1,8)) ∧ (copy_complete=bvconst(1,8)) ∧ (serialized=bvconst(1,8)) ∧ (drained=bvconst(1,8))

define rb108_used(accepted : BitVec8, used : BitVec64, count : BitVec64) =
    if (accepted=bvconst(1,8)) then bvadd(used,count) else used

// Pointwise copy model: staged is the byte from the authenticated source at
// query-used. Equality is exact byte equality, not an assumed collision-free hash.
define rb108_byte(accepted : BitVec8, used : BitVec64, count : BitVec64,
    query : BitVec64, staged : BitVec8, old : BitVec8) =
    if (accepted=bvconst(1,8)) ∧ bvuge(query,used) ∧ bvult(bvsub(query,used),count)
    then staged else old

// EOF alone is not compile success. AOM validation is over exactly used bytes,
// consumes the whole object (no trailing garbage), and checks its admitted
// target profile. Producer identity is coordinator-owned receipt metadata,
// not an AOM header field. The source cursor is the actual private input cursor
// or the exact compiler-source position checked by the DN-63 adapter.
// Error, abort, nonzero exit, truncated output, live leases or mutable staging
// cannot prepare a publication. AOM v1 object data is NOT a linked executable.
define rb108_prepare(phase : BitVec8, used : BitVec64, capacity : BitVec64,
    declared : BitVec64, cursor : BitVec64, source_size : BitVec64,
    exit_code : BitVec64, aom_exact : BitVec8, binding_current : BitVec8,
    owner_checked : BitVec8, source_exact : BitVec8, frozen : BitVec8, drained : BitVec8) =
    (phase=bvconst(0,8)) ∧ rb108_capacity(capacity) ∧
    bvugt(used,bvconst(0,64)) ∧ bvule(used,capacity) ∧ (used=declared) ∧
    bvule(source_size,rb108_limit()) ∧ (cursor=source_size) ∧
    (exit_code=bvconst(0,64)) ∧ (aom_exact=bvconst(1,8)) ∧ (binding_current=bvconst(1,8)) ∧ (owner_checked=bvconst(1,8)) ∧
    (source_exact=bvconst(1,8)) ∧ (frozen=bvconst(1,8)) ∧ (drained=bvconst(1,8))

define rb108_prepared_phase(accepted : BitVec8, old : BitVec8) =
    if (accepted=bvconst(1,8)) then bvconst(1,8) else old

// Exact receipt equality includes compiler/source/profile identity+generation,
// output identity+generation and length. Receipt bytes also contain versioned
// source-bundle/root/include/preprocessing lineage checked above. A digest may
// be an index, but is not substituted for exact identity or byte validation.
define rb108_receipt(binding_checked : BitVec8,
    output : BitVec64, receipt_output : BitVec64,
    generation : BitVec64, receipt_generation : BitVec64,
    used : BitVec64, receipt_length : BitVec64,
    lineage_exact : BitVec8, bytes_exact : BitVec8) =
    (binding_checked=bvconst(1,8)) ∧ (output=receipt_output) ∧
    (generation=receipt_generation) ∧ (used=receipt_length) ∧
    (lineage_exact=bvconst(1,8)) ∧ (bytes_exact=bvconst(1,8))

// Linearization point: output + receipt become visible together, or neither.
// expected epoch prevents stale concurrent commits; epoch increment cannot wrap.
// A reserved fresh object generation must be rechecked under serialization.
// atomic_pair requires one indivisible artifact+receipt publication. This is
// process-visible atomicity, NOT a claim of persistent crash consistency. A
// future durable implementation additionally needs a storage/recovery refinement.
// Published AOM has READ only. Link/seal/execute remain separate downstream gates.
define rb108_publish(phase : BitVec8, expected_epoch : BitVec64,
    current_epoch : BitVec64, output : BitVec64, generation : BitVec64,
    source : BitVec64, compiler : BitVec64, rights : BitVec64,
    owner_checked : BitVec8, binding_current : BitVec8, publication_authority : BitVec8,
    reservation_current : BitVec8, immutable_exact : BitVec8, receipt_checked : BitVec8,
    atomic_pair : BitVec8, serialized : BitVec8, drained : BitVec8) =
    (phase=bvconst(1,8)) ∧ (expected_epoch=current_epoch) ∧
    bvult(current_epoch,ptr107_max()) ∧ bvugt(generation,bvconst(0,64)) ∧
    ¬(output=source) ∧ ¬(output=compiler) ∧ (rights=bvconst(1,64)) ∧
    (owner_checked=bvconst(1,8)) ∧ (binding_current=bvconst(1,8)) ∧ (publication_authority=bvconst(1,8)) ∧
    (reservation_current=bvconst(1,8)) ∧ (immutable_exact=bvconst(1,8)) ∧ (receipt_checked=bvconst(1,8)) ∧
    (atomic_pair=bvconst(1,8)) ∧ (serialized=bvconst(1,8)) ∧ (drained=bvconst(1,8))

define rb108_epoch(committed : BitVec8, old : BitVec64) =
    if (committed=bvconst(1,8)) then bvadd(old,bvconst(1,64)) else old
define rb108_phase(committed : BitVec8, old : BitVec8) =
    if (committed=bvconst(1,8)) then bvconst(2,8) else old
// One shared commit decision is used for BOTH visibility slots. Existing
// unrelated publications are preserved; failure never exposes the staged pair.
define rb108_visible(committed : BitVec8, new_key : BitVec64, old_key : BitVec64) =
    if (committed=bvconst(1,8)) then new_key else old_key
// Abort is terminal for an unpublished session. It cannot undo publication.
// Lease drain and private staging destruction are required before reclaim/reuse.
define rb108_abort(phase : BitVec8, drained : BitVec8) =
    ((phase=bvconst(0,8)) ∨ (phase=bvconst(1,8))) ∧ (drained=bvconst(1,8))

define rb108_names_grant_authority() = (bvconst(0,8)=bvconst(1,8))
define rb108_object_grants_execution() = (bvconst(0,8)=bvconst(1,8))

// Operation: 0 append, 1 prepare, 2 publish, 3 abort. Only phase transitions
// are projected here: append byte/length changes use rb108_byte/rb108_used.
// Certificates MUST equal the corresponding actual predicate above; they
// cannot be independently chosen. State/certificates are protected, not syscall
// arguments. Operation validation and the effect occur in the same critical
// section. A rejected operation stutters; an explicit drained abort retires.
// A published session and an aborted session are terminal even with forged
// operation certificates in this abstract transition projection.
define rb108_step(phase : BitVec8, operation : BitVec8,
    prepare_checked : BitVec8,
    publish_checked : BitVec8, drained : BitVec8) =
    if (operation=bvconst(1,8)) ∧ (phase=bvconst(0,8)) ∧
        (prepare_checked=bvconst(1,8)) then bvconst(1,8)
    else if (operation=bvconst(2,8)) ∧ (phase=bvconst(1,8)) ∧
        (publish_checked=bvconst(1,8)) then bvconst(2,8)
    else if (operation=bvconst(3,8)) ∧ rb108_abort(phase,drained)
        then bvconst(3,8)
    else phase

// Reclaim a private accumulator only after a terminal state and complete drain;
// published immutable bytes/receipt remain owned by the artifact store.
define rb108_reclaim(phase : BitVec8, drained : BitVec8,
    pending_cpu : BitVec64, pending_dma : BitVec64) =
    ((phase=bvconst(2,8)) ∨ (phase=bvconst(3,8))) ∧
    (drained=bvconst(1,8)) ∧ (pending_cpu=bvconst(0,64)) ∧
    (pending_dma=bvconst(0,64))

example "rb108_owner accepts complete evidence" {
    assert(rb108_owner(bvconst(9,64),bvconst(9,64),bvconst(2,64),bvconst(2,64),bvconst(3,64),bvconst(3,64),bvconst(4,64),bvconst(4,64),bvconst(5,64),bvconst(5,64)))
}

example "rb108_owner rejects wrong session" {
    assert(¬(rb108_owner(bvconst(9,64),bvconst(10,64),bvconst(2,64),bvconst(2,64),bvconst(3,64),bvconst(3,64),bvconst(4,64),bvconst(4,64),bvconst(5,64),bvconst(5,64))))
}

example "rb108_owner rejects zero session" {
    assert(¬(rb108_owner(bvconst(0,64),bvconst(9,64),bvconst(2,64),bvconst(2,64),bvconst(3,64),bvconst(3,64),bvconst(4,64),bvconst(4,64),bvconst(5,64),bvconst(5,64))))
}

example "rb108_owner rejects other process" {
    assert(¬(rb108_owner(bvconst(9,64),bvconst(9,64),bvconst(2,64),bvconst(3,64),bvconst(3,64),bvconst(3,64),bvconst(4,64),bvconst(4,64),bvconst(5,64),bvconst(5,64))))
}

example "rb108_owner rejects reused process slot" {
    assert(¬(rb108_owner(bvconst(9,64),bvconst(9,64),bvconst(2,64),bvconst(2,64),bvconst(3,64),bvconst(4,64),bvconst(4,64),bvconst(4,64),bvconst(5,64),bvconst(5,64))))
}

example "rb108_owner rejects other context" {
    assert(¬(rb108_owner(bvconst(9,64),bvconst(9,64),bvconst(2,64),bvconst(2,64),bvconst(3,64),bvconst(3,64),bvconst(4,64),bvconst(5,64),bvconst(5,64),bvconst(5,64))))
}

example "rb108_owner rejects other domain" {
    assert(¬(rb108_owner(bvconst(9,64),bvconst(9,64),bvconst(2,64),bvconst(2,64),bvconst(3,64),bvconst(3,64),bvconst(4,64),bvconst(4,64),bvconst(5,64),bvconst(6,64))))
}

example "rb108_binding accepts complete evidence" {
    assert(rb108_binding(bvconst(7,64),bvconst(7,64),bvconst(3,64),bvconst(3,64),bvconst(8,64),bvconst(8,64),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(5,64),bvconst(5,64)))
}

example "rb108_binding rejects other compiler" {
    assert(¬(rb108_binding(bvconst(7,64),bvconst(10,64),bvconst(3,64),bvconst(3,64),bvconst(8,64),bvconst(8,64),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(5,64),bvconst(5,64))))
}

example "rb108_binding rejects stale compiler" {
    assert(¬(rb108_binding(bvconst(7,64),bvconst(7,64),bvconst(3,64),bvconst(2,64),bvconst(8,64),bvconst(8,64),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(5,64),bvconst(5,64))))
}

example "rb108_binding rejects other source" {
    assert(¬(rb108_binding(bvconst(7,64),bvconst(7,64),bvconst(3,64),bvconst(3,64),bvconst(8,64),bvconst(10,64),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(5,64),bvconst(5,64))))
}

example "rb108_binding rejects stale source" {
    assert(¬(rb108_binding(bvconst(7,64),bvconst(7,64),bvconst(3,64),bvconst(3,64),bvconst(8,64),bvconst(8,64),bvconst(4,64),bvconst(3,64),bvconst(9,64),bvconst(9,64),bvconst(5,64),bvconst(5,64))))
