    assert(rb108_abort(bvconst(1,8),bvconst(1,8)))
}

example "logical names never authorize" {
    assert(¬(rb108_names_grant_authority()))
}

example "object publication never grants execution" {
    assert(¬(rb108_object_grants_execution()))
}

example "failed append preserves exact length" {
    assert(∀(u : BitVec64). ∀(n : BitVec64). rb108_used(bvconst(0,8),u,n)=u)
}

example "failed append preserves every byte" {
    assert(∀(u : BitVec64). ∀(n : BitVec64). ∀(q : BitVec64). ∀(b : BitVec8). ∀(old : BitVec8). rb108_byte(bvconst(0,8),u,n,q,b,old)=old)
}

example "append preserves prefix" {
    assert(∀(u : BitVec64). ∀(n : BitVec64). ∀(q : BitVec64). ∀(b : BitVec8). ∀(old : BitVec8). bvult(q,u) → (rb108_byte(bvconst(1,8),u,n,q,b,old)=old))
}

example "append preserves suffix" {
    assert(∀(u : BitVec64). ∀(n : BitVec64). ∀(q : BitVec64). ∀(b : BitVec8). ∀(old : BitVec8). (bvuge(q,u) ∧ bvuge(bvsub(q,u),n)) → (rb108_byte(bvconst(1,8),u,n,q,b,old)=old))
}

example "accepted bytes equal authenticated staging" {
    assert(∀(u : BitVec64). ∀(n : BitVec64). ∀(q : BitVec64). ∀(b : BitVec8). ∀(old : BitVec8). (bvuge(q,u) ∧ bvult(bvsub(q,u),n)) → (rb108_byte(bvconst(1,8),u,n,q,b,old)=b))
}

example "bounded append cannot wrap" {
    assert(∀(u : BitVec64). ∀(c : BitVec64). ∀(n : BitVec64). (rb108_capacity(c) ∧ bvule(u,c) ∧ bvule(n,bvsub(c,u))) → (bvuge(rb108_used(bvconst(1,8),u,n),u) ∧ bvule(rb108_used(bvconst(1,8),u,n),c)))
}

example "failed publication preserves previous artifact and receipt" {
    assert(∀(a : BitVec64). ∀(r : BitVec64). ∀(old_a : BitVec64). ∀(old_r : BitVec64). (rb108_visible(bvconst(0,8),a,old_a)=old_a) ∧ (rb108_visible(bvconst(0,8),r,old_r)=old_r))
}

example "successful publication exposes exact pair" {
    assert(∀(a : BitVec64). ∀(r : BitVec64). ∀(old_a : BitVec64). ∀(old_r : BitVec64). (rb108_visible(bvconst(1,8),a,old_a)=a) ∧ (rb108_visible(bvconst(1,8),r,old_r)=r))
}

example "failed publication preserves epoch and phase" {
    assert(∀(e : BitVec64). ∀(p : BitVec8). (rb108_epoch(bvconst(0,8),e)=e) ∧ (rb108_phase(bvconst(0,8),p)=p))
}

example "successful publication retires session" {
    assert(∀(p : BitVec8). rb108_phase(bvconst(1,8),p)=bvconst(2,8))
}

example "publication epoch strictly advances without wrap" {
    assert(∀(e : BitVec64). bvult(e,ptr107_max()) → bvugt(rb108_epoch(bvconst(1,8),e),e))
}

example "published phase rejects append for every offset" {
    assert(∀(u : BitVec64). ∀(c : BitVec64). ∀(o : BitVec64). ∀(n : BitVec64). ¬(rb108_append(bvconst(2,8),u,c,o,n,bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8))))
}

example "frozen phase rejects append for every offset" {
    assert(∀(u : BitVec64). ∀(c : BitVec64). ∀(o : BitVec64). ∀(n : BitVec64). ¬(rb108_append(bvconst(1,8),u,c,o,n,bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8))))
}

example "failed preparation preserves phase" {
    assert(∀(p : BitVec8). rb108_prepared_phase(bvconst(0,8),p)=p)
}

example "terminal abort cannot be revived" {
    assert(∀(op : BitVec8). ∀(p : BitVec8). ∀(c : BitVec8). ∀(d : BitVec8). rb108_step(bvconst(3,8),op,p,c,d)=bvconst(3,8))
}

example "publication cannot be undone" {
    assert(∀(op : BitVec8). ∀(p : BitVec8). ∀(c : BitVec8). ∀(d : BitVec8). rb108_step(bvconst(2,8),op,p,c,d)=bvconst(2,8))
}

example "no direct collection to publication" {
    assert(∀(op : BitVec8). ∀(p : BitVec8). ∀(c : BitVec8). ∀(d : BitVec8). ¬(rb108_step(bvconst(0,8),op,p,c,d)=bvconst(2,8)))
}

example "publication transition requires frozen state and matching operation" {
    assert(∀(phase : BitVec8). ∀(op : BitVec8). ∀(p : BitVec8). ∀(c : BitVec8). ∀(d : BitVec8). ((rb108_step(phase,op,p,c,d)=bvconst(2,8)) ∧ ¬(phase=bvconst(2,8))) → ((phase=bvconst(1,8)) ∧ (op=bvconst(2,8)) ∧ (c=bvconst(1,8))))
}

example "unknown operation preserves state" {
    assert(∀(phase : BitVec8). ∀(p : BitVec8). ∀(c : BitVec8). ∀(d : BitVec8). rb108_step(phase,bvconst(255,8),p,c,d)=phase)
}

example "pending DMA prevents reclaim" {
    assert(∀(p : BitVec8). ¬(rb108_reclaim(p,bvconst(1,8),bvconst(0,64),bvconst(1,64))))
}

example "pending CPU access prevents reclaim" {
    assert(∀(p : BitVec8). ¬(rb108_reclaim(p,bvconst(1,8),bvconst(1,64),bvconst(0,64))))
}

example "reject collecting storage reclaim" {
    assert(¬(rb108_reclaim(bvconst(0,8),bvconst(1,8),bvconst(0,64),bvconst(0,64))))
}

example "reject frozen storage reclaim" {
    assert(¬(rb108_reclaim(bvconst(1,8),bvconst(1,8),bvconst(0,64),bvconst(0,64))))
}

example "reject aborted undrained storage reclaim" {
    assert(¬(rb108_reclaim(bvconst(3,8),bvconst(0,8),bvconst(0,64),bvconst(0,64))))
}
