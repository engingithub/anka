example "rb108_open rejects zero accumulator" {
    assert(¬(rb108_open(bvconst(1,8),bvconst(7,64),bvconst(7,64),bvconst(3,64),bvconst(3,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(0,64))))
