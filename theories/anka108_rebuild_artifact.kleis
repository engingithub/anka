example "rb108_append accepts complete evidence" {
    assert(rb108_append(bvconst(0,8),bvconst(16,64),bvconst(128,64),bvconst(16,64),bvconst(32,64),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8),bvconst(1,8)))
