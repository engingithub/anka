example "rb108_binding rejects zero compiler generation" {
    assert(¬(rb108_binding(bvconst(7,64),bvconst(7,64),bvconst(0,64),bvconst(3,64),bvconst(8,64),bvconst(8,64),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(5,64),bvconst(5,64))))
