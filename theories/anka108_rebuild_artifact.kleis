example "rb108_binding rejects other profile" {
    assert(¬(rb108_binding(bvconst(7,64),bvconst(7,64),bvconst(3,64),bvconst(3,64),bvconst(8,64),bvconst(8,64),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(10,64),bvconst(5,64),bvconst(5,64))))
}

example "rb108_binding rejects stale profile" {
    assert(¬(rb108_binding(bvconst(7,64),bvconst(7,64),bvconst(3,64),bvconst(3,64),bvconst(8,64),bvconst(8,64),bvconst(4,64),bvconst(4,64),bvconst(9,64),bvconst(9,64),bvconst(5,64),bvconst(4,64))))
