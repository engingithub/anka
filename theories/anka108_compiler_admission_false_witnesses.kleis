import "anka108_compiler_admission.kleis"
example "hostile ca108_configure bypass authority" { assert(ca108_configure(res108_false(),res108_true(),res108_true(),res108_true(),res108_true())) }
example "hostile ca108_configure bypass quota" { assert(ca108_configure(res108_true(),res108_false(),res108_true(),res108_true(),res108_true())) }
