example "hostile step 4 257" { assert(ca108_step(bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(257,64),res108_true())) }

example "hostile pending frame fits" { assert(¬(ca108_frame(bvconst(15000,64),bvconst(663,64),bvconst(16384,64)))) }
example "hostile pending frame exceeds" { assert(ca108_frame(bvconst(16000,64),bvconst(663,64),bvconst(16384,64))) }
example "hostile old profile exceeds" { assert(ca108_frame(bvconst(3800,64),bvconst(663,64),bvconst(4096,64))) }
example "hostile frame wrap" { assert(ca108_frame(bvsub(bvconst(0,64),bvconst(1,64)),bvconst(1,64),bvconst(16384,64))) }
example "hostile pool full" { assert(¬(ca108_pool(bvconst(16384,64),bvconst(16384,64),bvconst(4096,64),res108_true()))) }
example "hostile pool uncharged" { assert(ca108_pool(bvconst(1,64),bvconst(1,64),bvconst(0,64),res108_false())) }
example "hostile compiler envelope 0" { assert(¬(ca108_compiler_step(bvconst(127,64),bvconst(127,64),bvconst(1,64),bvconst(16384,64),bvconst(256,64),res108_true()))) }
