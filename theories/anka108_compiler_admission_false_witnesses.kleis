example "hostile compiler envelope 5" { assert(ca108_compiler_step(bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),res108_true())) }
example "hostile compiler envelope 6" { assert(ca108_compiler_step(bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(257,64),res108_true())) }
example "hostile compiler envelope 7" { assert(ca108_compiler_step(bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(1,64),res108_false())) }
