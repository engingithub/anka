example "hostile excess slots" { assert(ca108_slots(bvconst(9,64))) }
example "hostile step 0 128" { assert(ca108_step(bvconst(128,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(1,64),res108_true())) }
example "hostile step 1 128" { assert(ca108_step(bvconst(0,64),bvconst(128,64),bvconst(0,64),bvconst(0,64),bvconst(1,64),res108_true())) }
example "hostile step 2 2" { assert(ca108_step(bvconst(0,64),bvconst(0,64),bvconst(2,64),bvconst(0,64),bvconst(1,64),res108_true())) }
example "hostile step 3 4097" { assert(ca108_step(bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(4097,64),bvconst(1,64),res108_true())) }
