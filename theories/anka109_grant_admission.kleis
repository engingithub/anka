// T1 direct-anchor grant admission. No delegated issuers in this first slice.
// Purpose: memory=1, invoke=2, execute=3, administer=4. Resource kinds:
// object=1, service=2, artifact=3, installation=4. These are semantic labels,
// not new Fabric permission bits. Memory uses existing R/W/X/A/S rights masks.
// Resource selection is resolved from trusted runtime state. observed,
// object_size and object_active are actual generation/geometry/state observations,
// never caller-controlled claims. Grant and request must BOTH match observed.
// Nonmemory purposes have zero byte range/rights and exact kind/purpose matching.
// A candidate grant is NOT an executable capability. Successful admission
// retains one decision record; actual issuance/use requires later refinement.
// One serialized lane is modeled, with current challenge consumption and a
// nonwrapping revision. Failure preserves its prior result; peer lanes untouched.
import "anka109_enrollment.kleis"
data A109Grant = A109Grant(issuer : BitVec64, subject : BitVec64, kind : BitVec64, installation : BitVec64, epoch : BitVec64, purpose : BitVec64, resource : BitVec64, generation : BitVec64, resource_kind : BitVec64, off : BitVec64, len : BitVec64, rights : BitVec8, first : BitVec64, until : BitVec64, authentic : A109Verdict, status : A109Verdict)
define gr_issuer(v : A109Grant) = match v { A109Grant(issuer, subject, kind, installation, epoch, purpose, resource, generation, resource_kind, off, len, rights, first, until, authentic, status) => issuer }
define gr_subject(v : A109Grant) = match v { A109Grant(issuer, subject, kind, installation, epoch, purpose, resource, generation, resource_kind, off, len, rights, first, until, authentic, status) => subject }
define gr_kind(v : A109Grant) = match v { A109Grant(issuer, subject, kind, installation, epoch, purpose, resource, generation, resource_kind, off, len, rights, first, until, authentic, status) => kind }
define gr_installation(v : A109Grant) = match v { A109Grant(issuer, subject, kind, installation, epoch, purpose, resource, generation, resource_kind, off, len, rights, first, until, authentic, status) => installation }
define gr_epoch(v : A109Grant) = match v { A109Grant(issuer, subject, kind, installation, epoch, purpose, resource, generation, resource_kind, off, len, rights, first, until, authentic, status) => epoch }
define gr_purpose(v : A109Grant) = match v { A109Grant(issuer, subject, kind, installation, epoch, purpose, resource, generation, resource_kind, off, len, rights, first, until, authentic, status) => purpose }
define gr_resource(v : A109Grant) = match v { A109Grant(issuer, subject, kind, installation, epoch, purpose, resource, generation, resource_kind, off, len, rights, first, until, authentic, status) => resource }
define gr_generation(v : A109Grant) = match v { A109Grant(issuer, subject, kind, installation, epoch, purpose, resource, generation, resource_kind, off, len, rights, first, until, authentic, status) => generation }
define gr_resource_kind(v : A109Grant) = match v { A109Grant(issuer, subject, kind, installation, epoch, purpose, resource, generation, resource_kind, off, len, rights, first, until, authentic, status) => resource_kind }
define gr_off(v : A109Grant) = match v { A109Grant(issuer, subject, kind, installation, epoch, purpose, resource, generation, resource_kind, off, len, rights, first, until, authentic, status) => off }
define gr_len(v : A109Grant) = match v { A109Grant(issuer, subject, kind, installation, epoch, purpose, resource, generation, resource_kind, off, len, rights, first, until, authentic, status) => len }
define gr_rights(v : A109Grant) = match v { A109Grant(issuer, subject, kind, installation, epoch, purpose, resource, generation, resource_kind, off, len, rights, first, until, authentic, status) => rights }
define gr_first(v : A109Grant) = match v { A109Grant(issuer, subject, kind, installation, epoch, purpose, resource, generation, resource_kind, off, len, rights, first, until, authentic, status) => first }
define gr_until(v : A109Grant) = match v { A109Grant(issuer, subject, kind, installation, epoch, purpose, resource, generation, resource_kind, off, len, rights, first, until, authentic, status) => until }
define gr_authentic(v : A109Grant) = match v { A109Grant(issuer, subject, kind, installation, epoch, purpose, resource, generation, resource_kind, off, len, rights, first, until, authentic, status) => authentic }
define gr_status(v : A109Grant) = match v { A109Grant(issuer, subject, kind, installation, epoch, purpose, resource, generation, resource_kind, off, len, rights, first, until, authentic, status) => status }
data A109Request = A109Request(subject : BitVec64, kind : BitVec64, purpose : BitVec64, resource : BitVec64, generation : BitVec64, resource_kind : BitVec64, off : BitVec64, len : BitVec64, rights : BitVec8)
define rq_subject(v : A109Request) = match v { A109Request(subject, kind, purpose, resource, generation, resource_kind, off, len, rights) => subject }
define rq_kind(v : A109Request) = match v { A109Request(subject, kind, purpose, resource, generation, resource_kind, off, len, rights) => kind }
define rq_purpose(v : A109Request) = match v { A109Request(subject, kind, purpose, resource, generation, resource_kind, off, len, rights) => purpose }
define rq_resource(v : A109Request) = match v { A109Request(subject, kind, purpose, resource, generation, resource_kind, off, len, rights) => resource }
define rq_generation(v : A109Request) = match v { A109Request(subject, kind, purpose, resource, generation, resource_kind, off, len, rights) => generation }
define rq_resource_kind(v : A109Request) = match v { A109Request(subject, kind, purpose, resource, generation, resource_kind, off, len, rights) => resource_kind }
define rq_off(v : A109Request) = match v { A109Request(subject, kind, purpose, resource, generation, resource_kind, off, len, rights) => off }
define rq_len(v : A109Request) = match v { A109Request(subject, kind, purpose, resource, generation, resource_kind, off, len, rights) => len }
define rq_rights(v : A109Request) = match v { A109Request(subject, kind, purpose, resource, generation, resource_kind, off, len, rights) => rights }
data A109Admission = A109Admission(revision : BitVec64,challenge : BitVec64,anchor : BitVec64,installation : BitVec64,epoch : BitVec64,request_subject : BitVec64,request_kind : BitVec64,request_purpose : BitVec64,request_resource : BitVec64,request_generation : BitVec64,request_resource_kind : BitVec64,request_off : BitVec64,request_len : BitVec64,request_rights : BitVec8,occupied : Bool)
define ad_revision(v : A109Admission) = match v { A109Admission(revision,challenge,anchor,installation,epoch,request_subject,request_kind,request_purpose,request_resource,request_generation,request_resource_kind,request_off,request_len,request_rights,occupied) => revision }
define ad_challenge(v : A109Admission) = match v { A109Admission(revision,challenge,anchor,installation,epoch,request_subject,request_kind,request_purpose,request_resource,request_generation,request_resource_kind,request_off,request_len,request_rights,occupied) => challenge }
define ad_anchor(v : A109Admission) = match v { A109Admission(revision,challenge,anchor,installation,epoch,request_subject,request_kind,request_purpose,request_resource,request_generation,request_resource_kind,request_off,request_len,request_rights,occupied) => anchor }
define ad_installation(v : A109Admission) = match v { A109Admission(revision,challenge,anchor,installation,epoch,request_subject,request_kind,request_purpose,request_resource,request_generation,request_resource_kind,request_off,request_len,request_rights,occupied) => installation }
define ad_epoch(v : A109Admission) = match v { A109Admission(revision,challenge,anchor,installation,epoch,request_subject,request_kind,request_purpose,request_resource,request_generation,request_resource_kind,request_off,request_len,request_rights,occupied) => epoch }
define ad_request_subject(v : A109Admission) = match v { A109Admission(revision,challenge,anchor,installation,epoch,request_subject,request_kind,request_purpose,request_resource,request_generation,request_resource_kind,request_off,request_len,request_rights,occupied) => request_subject }
define ad_request_kind(v : A109Admission) = match v { A109Admission(revision,challenge,anchor,installation,epoch,request_subject,request_kind,request_purpose,request_resource,request_generation,request_resource_kind,request_off,request_len,request_rights,occupied) => request_kind }
define ad_request_purpose(v : A109Admission) = match v { A109Admission(revision,challenge,anchor,installation,epoch,request_subject,request_kind,request_purpose,request_resource,request_generation,request_resource_kind,request_off,request_len,request_rights,occupied) => request_purpose }
define ad_request_resource(v : A109Admission) = match v { A109Admission(revision,challenge,anchor,installation,epoch,request_subject,request_kind,request_purpose,request_resource,request_generation,request_resource_kind,request_off,request_len,request_rights,occupied) => request_resource }
define ad_request_generation(v : A109Admission) = match v { A109Admission(revision,challenge,anchor,installation,epoch,request_subject,request_kind,request_purpose,request_resource,request_generation,request_resource_kind,request_off,request_len,request_rights,occupied) => request_generation }
define ad_request_resource_kind(v : A109Admission) = match v { A109Admission(revision,challenge,anchor,installation,epoch,request_subject,request_kind,request_purpose,request_resource,request_generation,request_resource_kind,request_off,request_len,request_rights,occupied) => request_resource_kind }
define ad_request_off(v : A109Admission) = match v { A109Admission(revision,challenge,anchor,installation,epoch,request_subject,request_kind,request_purpose,request_resource,request_generation,request_resource_kind,request_off,request_len,request_rights,occupied) => request_off }
define ad_request_len(v : A109Admission) = match v { A109Admission(revision,challenge,anchor,installation,epoch,request_subject,request_kind,request_purpose,request_resource,request_generation,request_resource_kind,request_off,request_len,request_rights,occupied) => request_len }
define ad_request_rights(v : A109Admission) = match v { A109Admission(revision,challenge,anchor,installation,epoch,request_subject,request_kind,request_purpose,request_resource,request_generation,request_resource_kind,request_off,request_len,request_rights,occupied) => request_rights }
define ad_occupied(v : A109Admission) = match v { A109Admission(revision,challenge,anchor,installation,epoch,request_subject,request_kind,request_purpose,request_resource,request_generation,request_resource_kind,request_off,request_len,request_rights,occupied) => occupied }
define a109_resource(g : A109Grant, q : A109Request, object_size : BitVec64, object_active : Bool,observed : BitVec64) =
    (gr_resource(g)=rq_resource(q)) ∧ a109_nonzero(rq_resource(q)) ∧
    (gr_generation(g)=rq_generation(q)) ∧ (rq_generation(q)=observed) ∧ a109_nonzero(rq_generation(q)) ∧
    (gr_resource_kind(g)=rq_resource_kind(q)) ∧ (gr_purpose(g)=rq_purpose(q)) ∧
    (if rq_purpose(q)=bvconst(1,64) then
        (rq_resource_kind(q)=bvconst(1,64)) ∧
        a109_span(gr_off(g),gr_len(g),object_size) ∧ a109_span(rq_off(q),rq_len(q),object_size) ∧
        a109_within(rq_off(q),rq_len(q),gr_off(g),gr_len(g)) ∧
        ¬(rq_rights(q)=bvconst(0,8)) ∧ a109_rights(bvconst(31,8),gr_rights(g)) ∧ a109_rights(gr_rights(g),rq_rights(q)) ∧
        (if object_active then (bvand(gr_rights(g),bvconst(4,8))=bvconst(0,8))
         else (bvand(gr_rights(g),bvconst(26,8))=bvconst(0,8)))
     else
        ((rq_purpose(q)=bvconst(2,64)) ∨ (rq_purpose(q)=bvconst(3,64)) ∨ (rq_purpose(q)=bvconst(4,64))) ∧
        (rq_resource_kind(q)=rq_purpose(q)) ∧
        (gr_off(g)=a109_z()) ∧ (gr_len(g)=a109_z()) ∧ (gr_rights(g)=bvconst(0,8)) ∧
        (rq_off(q)=a109_z()) ∧ (rq_len(q)=a109_z()) ∧ (rq_rights(q)=bvconst(0,8)))
define a109_grant_allowed(c : A109Context, e : A109Identity, s : A109Enrollment, g : A109Grant, q : A109Request, size : BitVec64, active : Bool,observed : BitVec64, old : A109Admission, expected : BitVec64, preflight : Bool) =
    a109_recognize(c,e,rq_subject(q),rq_kind(q)) ∧ enr_enrolled(s) ∧
    (enr_anchor(s)=ctx_anchor(c)) ∧ (enr_installation(s)=ctx_installation(c)) ∧
    (gr_issuer(g)=ctx_anchor(c)) ∧ (gr_subject(g)=rq_subject(q)) ∧ (gr_kind(g)=rq_kind(q)) ∧
    (gr_installation(g)=ctx_installation(c)) ∧ (gr_epoch(g)=ctx_epoch(c)) ∧
    a109_window(ctx_now(c),gr_first(g),gr_until(g)) ∧ (gr_authentic(g)=A109Valid) ∧ (gr_status(g)=A109Valid) ∧
    a109_resource(g,q,size,active,observed) ∧ ¬ad_occupied(old) ∧
    (expected=ad_revision(old)) ∧ bvult(expected,a109_max()) ∧ bvugt(ctx_challenge(c),ad_challenge(old)) ∧ preflight
// Complete before/after relation, including the retained request fields.
define a109_admit_step(c : A109Context, e : A109Identity, s : A109Enrollment, g : A109Grant, q : A109Request, size : BitVec64, active : Bool,observed : BitVec64, old : A109Admission, expected : BitVec64, preflight : Bool, next : A109Admission) =
    ((ad_revision(next)=(if a109_grant_allowed(c,e,s,g,q,size,active,observed,old,expected,preflight) then a109_next(expected) else ad_revision(old))) ∧
    (ad_challenge(next)=(if a109_grant_allowed(c,e,s,g,q,size,active,observed,old,expected,preflight) then ctx_challenge(c) else ad_challenge(old))) ∧
    (ad_anchor(next)=(if a109_grant_allowed(c,e,s,g,q,size,active,observed,old,expected,preflight) then ctx_anchor(c) else ad_anchor(old))) ∧
    (ad_installation(next)=(if a109_grant_allowed(c,e,s,g,q,size,active,observed,old,expected,preflight) then ctx_installation(c) else ad_installation(old))) ∧
    (ad_epoch(next)=(if a109_grant_allowed(c,e,s,g,q,size,active,observed,old,expected,preflight) then ctx_epoch(c) else ad_epoch(old))) ∧
    ((ad_request_subject(next)=(if a109_grant_allowed(c,e,s,g,q,size,active,observed,old,expected,preflight) then rq_subject(q) else ad_request_subject(old))) ∧
    (ad_request_kind(next)=(if a109_grant_allowed(c,e,s,g,q,size,active,observed,old,expected,preflight) then rq_kind(q) else ad_request_kind(old))) ∧
    (ad_request_purpose(next)=(if a109_grant_allowed(c,e,s,g,q,size,active,observed,old,expected,preflight) then rq_purpose(q) else ad_request_purpose(old))) ∧
    (ad_request_resource(next)=(if a109_grant_allowed(c,e,s,g,q,size,active,observed,old,expected,preflight) then rq_resource(q) else ad_request_resource(old))) ∧
    (ad_request_generation(next)=(if a109_grant_allowed(c,e,s,g,q,size,active,observed,old,expected,preflight) then rq_generation(q) else ad_request_generation(old))) ∧
    (ad_request_resource_kind(next)=(if a109_grant_allowed(c,e,s,g,q,size,active,observed,old,expected,preflight) then rq_resource_kind(q) else ad_request_resource_kind(old))) ∧
    (ad_request_off(next)=(if a109_grant_allowed(c,e,s,g,q,size,active,observed,old,expected,preflight) then rq_off(q) else ad_request_off(old))) ∧
    (ad_request_len(next)=(if a109_grant_allowed(c,e,s,g,q,size,active,observed,old,expected,preflight) then rq_len(q) else ad_request_len(old))) ∧
    (ad_request_rights(next)=(if a109_grant_allowed(c,e,s,g,q,size,active,observed,old,expected,preflight) then rq_rights(q) else ad_request_rights(old)))) ∧
    (ad_occupied(next)=(if a109_grant_allowed(c,e,s,g,q,size,active,observed,old,expected,preflight) then (bvconst(1,8)=bvconst(1,8)) else ad_occupied(old))))
define a109_same_admission(a : A109Admission,b : A109Admission) = ((ad_revision(a)=ad_revision(b)) ∧ (ad_challenge(a)=ad_challenge(b)) ∧ (ad_anchor(a)=ad_anchor(b)) ∧ (ad_installation(a)=ad_installation(b)) ∧ (ad_epoch(a)=ad_epoch(b)) ∧ ((ad_request_subject(a)=ad_request_subject(b)) ∧ (ad_request_kind(a)=ad_request_kind(b)) ∧ (ad_request_purpose(a)=ad_request_purpose(b)) ∧ (ad_request_resource(a)=ad_request_resource(b)) ∧ (ad_request_generation(a)=ad_request_generation(b)) ∧ (ad_request_resource_kind(a)=ad_request_resource_kind(b)) ∧ (ad_request_off(a)=ad_request_off(b)) ∧ (ad_request_len(a)=ad_request_len(b)) ∧ (ad_request_rights(a)=ad_request_rights(b))) ∧ (ad_occupied(a)=ad_occupied(b)))

example "recognized scoped memory read admitted" { assert(a109_grant_allowed(A109Context(bvconst(10,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(100,64), (bvconst(1,8)=bvconst(1,8))),A109Identity(bvconst(10,64), bvconst(30,64), bvconst(1,64), bvconst(20,64), bvconst(3,64), bvconst(7,64), bvconst(90,64), bvconst(110,64), A109Valid, A109Valid, A109Valid),A109Enrollment(bvconst(10,64), bvconst(20,64), bvconst(30,64), bvconst(1,64), (bvconst(1,8)=bvconst(1,8))),A109Grant(bvconst(10,64), bvconst(30,64), bvconst(1,64), bvconst(20,64), bvconst(3,64), bvconst(1,64), bvconst(40,64), bvconst(2,64), bvconst(1,64), bvconst(16,64), bvconst(128,64), bvconst(3,8), bvconst(90,64), bvconst(110,64), A109Valid, A109Valid),A109Request(bvconst(30,64), bvconst(1,64), bvconst(1,64), bvconst(40,64), bvconst(2,64), bvconst(1,64), bvconst(32,64), bvconst(16,64), bvconst(1,8)),bvconst(256,64),(bvconst(1,8)=bvconst(1,8)),bvconst(2,64),A109Admission(bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(0,64),bvconst(30,64), bvconst(1,64), bvconst(1,64), bvconst(40,64), bvconst(2,64), bvconst(1,64), bvconst(32,64), bvconst(16,64), bvconst(1,8),(bvconst(1,8)=bvconst(0,8))),bvconst(0,64),(bvconst(1,8)=bvconst(1,8)))) }
