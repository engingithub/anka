// C2.5 ABI-2 capture -> admission -> owner release -> atomic publication.
// Specification/refinement only. No new axioms; no implementation proof.
// Phases: 0 executing, 1 capturing, 2 admitted private candidate,
// 3 producer released / candidate ready, 4 published, 5 aborted.
// Bool certificates below are trusted CURRENT runtime observations, never
// guest flags. Each guard and update linearizes under exclusive coordinator
// custody. Across yields, paused producer + fenced scheduler + excluded other
// writers preserve the source snapshot. Merely seeing SYS_EXIT is insufficient.
// Object/owner/binding IDs denote context-qualified immutable records; their
// injective encoding and concrete byte validators are refinement obligations.
import "anka108_compiler_resources.kleis"

define pub108_z() = bvconst(0,64)
define pub108_one() = bvconst(1,64)
define pub108_live_phase(p : BitVec8) = bvule(p,bvconst(3,8))

// The trusted job carries every frozen input binding; apply this equality
// separately to source/bundle, tool lineage, profile, dependencies and plan.
define pub108_binding(actual : BitVec64, frozen : BitVec64, current : Bool) =
    res108_binding(actual,frozen,res108_true(),current,res108_true())
define pub108_owner(job : BitVec64, attempt : BitVec64, owner : BitVec64,
    frozen_job : BitVec64, frozen_attempt : BitVec64, frozen_owner : BitVec64,
    incarnation : BitVec64, frozen_incarnation : BitVec64, current : Bool) =
    res108_identity(job,attempt,owner,frozen_job,frozen_attempt,frozen_owner,
        current,res108_true()) ∧ bvugt(incarnation,pub108_z()) ∧
    (incarnation=frozen_incarnation)

// artifact_valid=true here deliberately means WIRE SHAPE ONLY; success status
// is not AOM validation. pub108_admit is required after all bytes are copied.
define pub108_metadata(status : BitVec64, used : BitVec64, capacity : BitVec64,
    resource : BitVec64, minimum : BitVec64, detail : BitVec64,
    consumed : BitVec64, source_length : BitVec64, report : Bool) =
    res108_success(status,used,capacity,resource,minimum,detail,consumed,
        source_length,report,res108_true())

define pub108_freeze(phase : BitVec8, metadata : Bool, owner : Bool,
    bindings : Bool, actual_exit : Bool, exit_code : BitVec64,
    protected_controls : Bool, scheduler_fenced : Bool, exclusive_writers : Bool,
    cpu : BitVec64, dma : BitVec64, current_census : Bool,
    heap_live : Bool, staging_reserved : Bool) =
    (phase=bvconst(0,8)) ∧ metadata ∧ owner ∧ bindings ∧ actual_exit ∧
    (exit_code=pub108_z()) ∧ protected_controls ∧ scheduler_fenced ∧
    exclusive_writers ∧ (cpu=pub108_z()) ∧ (dma=pub108_z()) ∧
    current_census ∧ heap_live ∧ staging_reserved

// Snapshot includes real owner/incarnation, output object/generation, position
// zero and exact capacity; protected kind cannot be manufactured from words.
define pub108_snapshot(owner : Bool, object : BitVec64, expected_object : BitVec64,
    generation : BitVec64, expected_generation : BitVec64, position : BitVec64,
    capacity : BitVec64, expected_capacity : BitVec64, kind : Bool,
    live : Bool, custody : Bool) =
    owner ∧ (object=expected_object) ∧ bvugt(generation,pub108_z()) ∧
    (generation=expected_generation) ∧ (position=pub108_z()) ∧
    (capacity=expected_capacity) ∧ heap108_size(capacity) ∧ kind ∧ live ∧ custody

define pub108_chunk(used : BitVec64, copied : BitVec64) =
    if bvult(copied,used) then
        (if bvule(bvsub(used,copied),bvconst(4096,64))
         then bvsub(used,copied) else bvconst(4096,64)) else pub108_z()
define pub108_copy(phase : BitVec8, used : BitVec64, copied : BitVec64,
    offset : BitVec64, count : BitVec64, snapshot : Bool,
    frozen : Bool, charged_private_stage : Bool, exact_read : Bool) =
    (phase=bvconst(1,8)) ∧ bvuge(used,bvconst(112,64)) ∧
    bvule(used,heap108_signed_max()) ∧ (offset=copied) ∧
    (count=pub108_chunk(used,copied)) ∧ snapshot ∧ frozen ∧
    charged_private_stage ∧ exact_read ∧
    res108_copy(used,copied,count,snapshot) ∧ bvule(count,bvconst(4096,64))
define pub108_cursor(commit : Bool, copied : BitVec64, count : BitVec64) =
    if commit then bvadd(copied,count) else copied
// Pointwise byte model: source is the byte at THE SAME offset in the frozen
// output. Quantification over q expresses exact copying, not digest equality.
define pub108_byte(commit : Bool, copied : BitVec64, count : BitVec64,
    q : BitVec64, source : BitVec8, before : BitVec8) =
    if commit ∧ bvuge(q,copied) ∧ bvult(q,bvadd(copied,count))
    then source else before

// Role 1 closed application; role 2 relocatable protected module; linked image
// role 3 requires the independent linker route. Every declared byte consumed.
define pub108_admit(phase : BitVec8, used : BitVec64, copied : BitVec64,
    declared : BitVec64, exact_aom : Bool, all_frames : Bool,
    role : BitVec8, imports : BitVec64, relocations : BitVec64,
    module_valid : Bool, closed_valid : Bool, bindings : Bool,
    immutable_stage : Bool) =
    (phase=bvconst(1,8)) ∧ bvuge(used,bvconst(112,64)) ∧
    bvule(used,heap108_signed_max()) ∧ (bvand(used,bvconst(7,64))=pub108_z()) ∧
    (copied=used) ∧ (declared=used) ∧ exact_aom ∧ all_frames ∧ bindings ∧
    immutable_stage ∧
    (((role=bvconst(1,8)) ∧ (imports=pub108_z()) ∧ (relocations=pub108_z()) ∧ closed_valid)
     ∨ ((role=bvconst(2,8)) ∧ module_valid))

// Capture data must survive independently before retiring the producer. On
// any abort the candidate is discarded, not published. Actual scrub/return is
// still mandatory: an abort flag does not refund memory or make it reusable.
define pub108_queue_cleanup(phase : BitVec8, abort : Bool,
    independent_candidate : Bool, central_fence : Bool) =
    central_fence ∧ pub108_live_phase(phase) ∧
    (abort ∨ ((phase=bvconst(2,8)) ∧ independent_candidate))
define pub108_ready(phase : BitVec8, admitted : Bool, retained_stage : Bool,
    released : Bool, exact_owner_release : Bool) =
    (phase=bvconst(2,8)) ∧ admitted ∧ retained_stage ∧ released ∧ exact_owner_release

// Reserve peak residency before allocating: producer + stage + artifact +
// receipt/lineage metadata. Values are charged extents, not just used payload.
// Other clients' charge is already included in held; no ignored temporary copy.
define pub108_reserve(held : BitVec64, stage : BitVec64, artifact : BitVec64,
    metadata : BitVec64, used : BitVec64, limit : BitVec64) =
    bvugt(used,pub108_z()) ∧ bvule(used,stage) ∧ bvule(used,artifact) ∧
    bvugt(metadata,pub108_z()) ∧ res108_add(held,stage,limit) ∧
    res108_add(bvadd(held,stage),artifact,limit) ∧
    res108_add(bvadd(bvadd(held,stage),artifact),metadata,limit)
define pub108_charge(commit : Bool, held : BitVec64, amount : BitVec64) =
    if commit then bvadd(held,amount) else held
define pub108_retained(released : Bool, held : BitVec64, producer_charge : BitVec64) =
    res108_refund(released,held,producer_charge)
// Caller must compose refund with res108_released, not supply a timeout bit.

// Current exact receipt fields, not guest names/digests. Apply field equality
// to all frozen inputs and owner/attempt; output fields are bound explicitly.
define pub108_receipt(object : BitVec64, receipt_object : BitVec64,
    generation : BitVec64, receipt_generation : BitVec64,
    used : BitVec64, receipt_length : BitVec64,
    role : BitVec8, receipt_role : BitVec8, abi : BitVec64,
    source_offset : BitVec64, all_bindings_exact : Bool) =
    bvugt(object,pub108_z()) ∧ (object=receipt_object) ∧
    bvugt(generation,pub108_z()) ∧ (generation=receipt_generation) ∧
    (used=receipt_length) ∧ (role=receipt_role) ∧
    ((role=bvconst(1,8)) ∨ (role=bvconst(2,8))) ∧
    (abi=bvconst(2,64)) ∧ (source_offset=pub108_z()) ∧ all_bindings_exact

// Fresh exact-length immutable object is in separate custody from all producer
// regions and the staging buffer. prior_visible means the candidate key already
// exists: never replace an older record. No fallible step after pair insertion.
define pub108_publish(phase : BitVec8, expected_epoch : BitVec64, epoch : BitVec64,
    used : BitVec64, copied : BitVec64, logical : BitVec64, rights : BitVec64,
    admitted : Bool, bindings : Bool, authority : Bool, fresh : Bool,
    disjoint : Bool, sealed : Bool, charged : Bool, owner_released : Bool,
    receipt : Bool, private_ready : Bool, prior_visible : Bool,
    serialized : Bool) =
    (phase=bvconst(3,8)) ∧ (expected_epoch=epoch) ∧
    bvuge(used,bvconst(112,64)) ∧ bvule(used,heap108_signed_max()) ∧
    (rights=pub108_one()) ∧ disjoint ∧ sealed ∧ receipt ∧
    ¬prior_visible ∧ serialized ∧
    res108_publish(admitted,bindings,authority,used,copied,logical,
        (rights=pub108_one()),fresh,charged,owner_released,epoch,private_ready)
define pub108_phase(commit : Bool, target : BitVec8, old : BitVec8) =
    if commit then target else old
// Artifact+receipt live in ONE immutable record. Both observations project
// this same insertion; there is no separately writable receipt visibility bit.
define pub108_record(commit : Bool, key : BitVec64, query : BitVec64,
    before : BitVec64, candidate_record : BitVec64) =
    res108_receipt(commit,key,query,before,candidate_record)

// WITNESSES follow. Successes and independent hostile counterclaims exercise
// guards; universal laws establish transition arithmetic and pointwise framing.
// GENERATED WITNESSES

example "binding accepts" {
    assert(pub108_binding(bvconst(7,64),bvconst(7,64),res108_true()))
}

example "binding rejects substitution" {
    assert(¬(pub108_binding(bvconst(8,64),bvconst(7,64),res108_true())))
}

example "binding rejects stale record" {
    assert(¬(pub108_binding(bvconst(7,64),bvconst(7,64),res108_false())))
}

example "binding rejects absent identity" {
    assert(¬(pub108_binding(bvconst(0,64),bvconst(7,64),res108_true())))
}

