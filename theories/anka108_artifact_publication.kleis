}

example "law: bounded chunk advances without overflow" {
    assert(∀(u : BitVec64). ∀(c : BitVec64). ∀(n : BitVec64). (pub108_copy(bvconst(1,8),u,c,c,n,res108_true(),res108_true(),res108_true(),res108_true()) → (bvugt(bvadd(c,n),c) ∧ bvule(bvadd(c,n),u) ∧ bvule(n,bvconst(4096,64)))))
}

example "law: remaining byte measure strictly decreases" {
    assert(∀(u : BitVec64). ∀(c : BitVec64). ∀(n : BitVec64). (pub108_copy(bvconst(1,8),u,c,c,n,res108_true(),res108_true(),res108_true(),res108_true()) → bvult(bvsub(u,bvadd(c,n)),bvsub(u,c))))
}

example "law: selected chunk always has legal geometry" {
    assert(∀(u : BitVec64). ∀(c : BitVec64). ((bvuge(u,bvconst(112,64)) ∧ bvule(u,heap108_signed_max()) ∧ bvult(c,u)) → pub108_copy(bvconst(1,8),u,c,c,pub108_chunk(u,c),res108_true(),res108_true(),res108_true(),res108_true())))
}

example "law: first chunk exact pointwise bytes" {
    assert(∀(q : BitVec64). ∀(s : BitVec8). ∀(b : BitVec8). (bvult(q,bvconst(4096,64)) → (pub108_byte(res108_true(),bvconst(0,64),bvconst(4096,64),q,s,b)=s)))
}

example "law: three chunk composition copies exact used prefix" {
    assert(∀(q : BitVec64). ∀(s : BitVec8). ∀(b : BitVec8). (bvult(q,bvconst(8872,64)) → (pub108_byte(res108_true(),bvconst(8192,64),bvconst(680,64),q,s,pub108_byte(res108_true(),bvconst(4096,64),bvconst(4096,64),q,s,pub108_byte(res108_true(),bvconst(0,64),bvconst(4096,64),q,s,b)))=s)))
}

example "law: unused output tail is not copied" {
    assert(∀(q : BitVec64). ∀(s : BitVec8). ∀(b : BitVec8). (bvuge(q,bvconst(8872,64)) → (pub108_byte(res108_true(),bvconst(8192,64),bvconst(680,64),q,s,b)=b)))
}

example "law: failed read preserves byte and cursor" {
    assert(∀(q : BitVec64). ∀(s : BitVec8). ∀(b : BitVec8). ∀(c : BitVec64). ((pub108_byte(res108_false(),c,bvconst(4096,64),q,s,b)=b) ∧ (pub108_cursor(res108_false(),c,bvconst(4096,64))=c)))
}

example "law: checked allocation bounds next subtotal without wrap" {
    assert(∀(h : BitVec64). ∀(n : BitVec64). ∀(l : BitVec64). (res108_add(h,n,l) → (bvule(bvadd(h,n),l) ∧ bvuge(bvadd(h,n),h))))
}

example "law: peak reservation checks stage subtotal" {
    assert(∀(h : BitVec64). ∀(s : BitVec64). ∀(a : BitVec64). ∀(m : BitVec64). ∀(l : BitVec64). (pub108_reserve(h,s,a,m,bvconst(8872,64),l) → res108_add(h,s,l)))
}

example "law: peak reservation checks artifact subtotal" {
    assert(∀(h : BitVec64). ∀(s : BitVec64). ∀(a : BitVec64). ∀(m : BitVec64). ∀(l : BitVec64). (pub108_reserve(h,s,a,m,bvconst(8872,64),l) → res108_add(bvadd(h,s),a,l)))
}

example "law: peak reservation checks metadata subtotal" {
    assert(∀(h : BitVec64). ∀(s : BitVec64). ∀(a : BitVec64). ∀(m : BitVec64). ∀(l : BitVec64). (pub108_reserve(h,s,a,m,bvconst(8872,64),l) → res108_add(bvadd(bvadd(h,s),a),m,l)))
}

example "law: producer release preserves independent candidate charge" {
    assert(∀(p : BitVec64). ∀(candidate : BitVec64). (res108_add(p,candidate,heap108_signed_max()) → (pub108_retained(res108_true(),bvadd(p,candidate),p)=candidate)))
}

example "law: pending cleanup refunds nothing" {
    assert(∀(h : BitVec64). ∀(p : BitVec64). (pub108_retained(res108_false(),h,p)=h))
}

example "law: other client publication unchanged" {
    assert(∀(key : BitVec64). ∀(q : BitVec64). ∀(old : BitVec64). ∀(candidate : BitVec64). (¬(key=q) → (pub108_record(res108_true(),key,q,old,candidate)=old)))
}

example "law: failed publication preserves every record and epoch" {
    assert(∀(key : BitVec64). ∀(q : BitVec64). ∀(old : BitVec64). ∀(candidate : BitVec64). ∀(epoch : BitVec64). ((pub108_record(res108_false(),key,q,old,candidate)=old) ∧ (res108_epoch(res108_false(),epoch)=epoch)))
}

example "law: successful insertion exposes complete record" {
    assert(∀(key : BitVec64). ∀(old : BitVec64). ∀(candidate : BitVec64). (pub108_record(res108_true(),key,key,old,candidate)=candidate))
}

example "law: failed transition preserves phase" {
    assert(∀(old : BitVec8). ∀(target : BitVec8). (pub108_phase(res108_false(),target,old)=old))
}

example "law: old process incarnation cannot capture" {
    assert(∀(i : BitVec64). ∀(j : BitVec64). (¬(i=j) → ¬pub108_owner(bvconst(71,64),bvconst(3,64),bvconst(9,64),bvconst(71,64),bvconst(3,64),bvconst(9,64),i,j,res108_true())))
}

// C2.5c: another client may publish while this candidate is being compiled.
// Refresh changes only the candidate's expected epoch, never visible records.
// It requires current exact candidate/custodian/charge/producer-release and
// full provenance revalidation plus authority under the same exclusive Kernel.
define pub108_refresh(old : BitVec64, current : BitVec64, ready : Bool,
    custody : Bool, charged : Bool, released : Bool, bindings : Bool,
    authority : Bool, serialized : Bool) =
    bvule(old,current) ∧ bvult(current,ptr107_max()) ∧ ready ∧ custody ∧
    charged ∧ released ∧ bindings ∧ authority ∧ serialized
define pub108_expected(refresh : Bool, old : BitVec64, current : BitVec64) =
    if refresh then current else old

example "law: rejected refresh preserves expectation" {
    assert(∀(old : BitVec64). ∀(current : BitVec64). (pub108_expected(res108_false(),old,current)=old))
}
example "law: accepted refresh selects observed current epoch" {
    assert(∀(old : BitVec64). ∀(current : BitVec64). (pub108_expected(res108_true(),old,current)=current))
}

example "refresh after peer commit" {
    assert(pub108_refresh(bvconst(7,64),bvconst(8,64),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true()))
}

example "refresh unchanged epoch" {
    assert(pub108_refresh(bvconst(7,64),bvconst(7,64),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true()))
}

example "refresh backwards" {
    assert(¬pub108_refresh(bvconst(8,64),bvconst(7,64),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true()))
}

example "refresh exhausted" {
    assert(¬pub108_refresh(bvconst(7,64),ptr107_max(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true()))
}

example "refresh requires ready" {
    assert(¬pub108_refresh(bvconst(7,64),bvconst(8,64),res108_false(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true()))
}

example "refresh requires custody" {
    assert(¬pub108_refresh(bvconst(7,64),bvconst(8,64),res108_true(),res108_false(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true()))
}

example "refresh requires charged" {
    assert(¬pub108_refresh(bvconst(7,64),bvconst(8,64),res108_true(),res108_true(),res108_false(),res108_true(),res108_true(),res108_true(),res108_true()))
}

example "refresh requires released" {
    assert(¬pub108_refresh(bvconst(7,64),bvconst(8,64),res108_true(),res108_true(),res108_true(),res108_false(),res108_true(),res108_true(),res108_true()))
}

example "refresh requires bindings" {
    assert(¬pub108_refresh(bvconst(7,64),bvconst(8,64),res108_true(),res108_true(),res108_true(),res108_true(),res108_false(),res108_true(),res108_true()))
}

example "refresh requires authority" {
    assert(¬pub108_refresh(bvconst(7,64),bvconst(8,64),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_false(),res108_true()))
}

example "refresh requires serialized" {
    assert(¬pub108_refresh(bvconst(7,64),bvconst(8,64),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_false()))
}

// C2.6: ABI-2 capture uses its authentic attempt capacity, not the legacy
// 262144-byte ABI-1 envelope. This guard precedes allocation and validation.
// held/limit are the shared account observations; reservation must ALSO satisfy
// the existing global/placement/slot guards. No certificate authorizes bytes.
define pub108_stage_charge(used : BitVec64) =
    bvadd(bvmul(used,bvconst(32,64)),bvconst(4096,64))
define pub108_capture_budget(used : BitVec64, capacity : BitVec64,
    held : BitVec64, limit : BitVec64) =
    bvuge(used,bvconst(112,64)) ∧ (bvand(used,bvconst(7,64))=pub108_z()) ∧
    bvule(used,capacity) ∧ bvule(capacity,heap108_signed_max()) ∧
    bvule(used,bvconst(288230376151711615,64)) ∧
    bvule(limit,heap108_signed_max()) ∧
    res108_add(held,pub108_stage_charge(used),limit)

example "law: capture cannot exceed authentic capacity" {
    assert(∀(u : BitVec64). ∀(c : BitVec64). ∀(h : BitVec64). ∀(l : BitVec64).
        (pub108_capture_budget(u,c,h,l) → bvule(u,c)))
}
example "law: capture staging charge does not wrap" {
    assert(∀(u : BitVec64). ∀(c : BitVec64). ∀(h : BitVec64). ∀(l : BitVec64).
        (pub108_capture_budget(u,c,h,l) →
         (bvuge(pub108_stage_charge(u),u) ∧ bvule(pub108_stage_charge(u),heap108_signed_max()))))
}
example "law: capture leaves peers within the shared budget" {
    assert(∀(u : BitVec64). ∀(c : BitVec64). ∀(h : BitVec64). ∀(l : BitVec64).
        (pub108_capture_budget(u,c,h,l) →
         (bvuge(bvadd(h,pub108_stage_charge(u)),h) ∧ bvule(bvadd(h,pub108_stage_charge(u)),l))))
}
example "law: larger adequate capacity does not change stage charge" {
    assert(∀(u : BitVec64). ∀(c : BitVec64). ∀(d : BitVec64). ∀(h : BitVec64). ∀(l : BitVec64).
        ((pub108_capture_budget(u,c,h,l) ∧ bvuge(d,c) ∧ bvule(d,heap108_signed_max())) →
         pub108_capture_budget(u,d,h,l)))
}

example "capture budget: legacy boundary" {
    assert(pub108_capture_budget(bvconst(262144,64),bvconst(262144,64),bvconst(0,64),bvconst(16777216,64)))
}

example "capture budget: beyond legacy boundary" {
    assert(pub108_capture_budget(bvconst(262152,64),bvconst(524288,64),bvconst(0,64),bvconst(16777216,64)))
}

example "capture budget: larger adequate arena" {
    assert(pub108_capture_budget(bvconst(262152,64),bvconst(1048576,64),bvconst(0,64),bvconst(16777216,64)))
}

example "capture budget: exact staging budget" {
    assert(pub108_capture_budget(bvconst(262152,64),bvconst(524288,64),bvconst(1024,64),bvconst(8393984,64)))
}

example "capture budget: staging budget short" {
    assert(¬pub108_capture_budget(bvconst(262152,64),bvconst(524288,64),bvconst(1024,64),bvconst(8393983,64)))
}

example "capture budget: used above actual capacity" {
    assert(¬pub108_capture_budget(bvconst(262152,64),bvconst(262144,64),bvconst(0,64),bvconst(16777216,64)))
}

example "capture budget: unaligned used" {
    assert(¬pub108_capture_budget(bvconst(262153,64),bvconst(524288,64),bvconst(0,64),bvconst(16777216,64)))
}

example "capture budget: short header" {
    assert(¬pub108_capture_budget(bvconst(104,64),bvconst(4096,64),bvconst(0,64),bvconst(16777216,64)))
}

example "capture budget: multiplication overflow" {
    assert(¬pub108_capture_budget(bvconst(576460752303423488,64),bvconst(576460752303423488,64),bvconst(0,64),bvconst(9223372036854775807,64)))
}

example "capture budget: peer charge denies stage" {
    assert(¬pub108_capture_budget(bvconst(262152,64),bvconst(524288,64),bvconst(16777216,64),bvconst(16777216,64)))
}

// Published-module consumption is a NEW check at link time. A prior commit
// does not imply current provenance/read authority. Identity is resolved from
// this Kernel's records; ordered list positions are compared pointwise. The
// certificates denote current runtime checks, not caller or guest flags.
define pub108_link_input(role : BitVec8, abi : BitVec64, offset : BitVec64,
    length : BitVec64, bound : BitVec64, receipt_current : Bool,
    provenance_current : Bool, read_only : Bool, exact_copy : Bool,
    protected_module : Bool, same_linker : Bool) =
    (role=bvconst(2,8)) ∧ (abi=bvconst(2,64)) ∧ (offset=pub108_z()) ∧
    bvuge(length,bvconst(112,64)) ∧ bvule(length,bound) ∧
    bvule(bound,heap108_signed_max()) ∧ receipt_current ∧ provenance_current ∧
    read_only ∧ exact_copy ∧ protected_module ∧ same_linker

define pub108_link_order(position : BitVec64, frozen_position : BitVec64,
    epoch : BitVec64, frozen_epoch : BitVec64) =
    (position=frozen_position) ∧ (epoch=frozen_epoch) ∧ bvugt(epoch,pub108_z())

define pub108_link_dispatch(count : BitVec64, profile : BitVec8,
    execution_authority : Bool, every_input : Bool, exact_order : Bool,
    stage_reserved : Bool, exclusive_custody : Bool) =
    bvugt(count,pub108_z()) ∧ bvule(count,bvconst(4096,64)) ∧
    ((profile=bvconst(0,8)) ∨ (profile=bvconst(3,8))) ∧ execution_authority ∧
    every_input ∧ exact_order ∧ stage_reserved ∧ exclusive_custody

// The linked bytes remain borrowed charged data. This guard does not issue
// EXECUTE rights, publish an artifact, or certify the isolated runner's entire
// host-memory footprint. C2 whole-machine accounting remains separate.
define pub108_link_retain(dispatch : Bool, guest_success : Bool,
    exact_output : Bool, inputs_current : Bool, selected_profile : BitVec8,
    executed_profile : BitVec8, length : BitVec64, reserved : BitVec64) =
    dispatch ∧ guest_success ∧ exact_output ∧ inputs_current ∧
    (selected_profile=executed_profile) ∧ bvugt(length,pub108_z()) ∧
    bvule(length,reserved)

example "link consumer: current protected module" {
    assert(pub108_link_input(bvconst(2,8),bvconst(2,64),bvconst(0,64),bvconst(512,64),bvconst(1024,64),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true()))
}

example "link consumer: closed role" {
    assert(¬(pub108_link_input(bvconst(1,8),bvconst(2,64),bvconst(0,64),bvconst(512,64),bvconst(1024,64),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true())))
}

example "link consumer: linked image role" {
