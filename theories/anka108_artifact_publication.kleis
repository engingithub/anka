}

example "linked publication: already visible" {
 assert(¬(pub108_link_commit(bvconst(3,64),bvconst(3,64),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_false())))
}

example "linked publication: epoch exhausted" {
 assert(¬(pub108_link_commit(bvsub(pub108_z(),pub108_one()),bvsub(pub108_z(),pub108_one()),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true())))
}

example "linked publication: read rejects custodian" {
 assert(¬(pub108_link_access(res108_false(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true())))
}

example "linked publication: read rejects host charge" {
 assert(¬(pub108_link_access(res108_true(),res108_false(),res108_true(),res108_true(),res108_true(),res108_true())))
}

example "linked publication: read rejects heap authority" {
 assert(¬(pub108_link_access(res108_true(),res108_true(),res108_false(),res108_true(),res108_true(),res108_true())))
}

example "linked publication: read rejects dependency" {
 assert(¬(pub108_link_access(res108_true(),res108_true(),res108_true(),res108_false(),res108_true(),res108_true())))
}

example "linked publication: read rejects bytes" {
 assert(¬(pub108_link_access(res108_true(),res108_true(),res108_true(),res108_true(),res108_false(),res108_true())))
}

example "linked publication: read rejects profile" {
 assert(¬(pub108_link_access(res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_false())))
}

example "linked publication: read current exact record" {
 assert(pub108_link_access(res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true()))
}

// Receipt-to-execution refinement. These certificates are checked by the host
// under one exclusive Kernel borrow, before allocating the isolated runner.
// Existing publication remains READ-only; execution uses a fresh sealed copy.
// This contract does not certify isolated-runner whole-machine accounting.
define pub108_execute(current : Bool, authority : Bool, profile : Bool,
    entry : BitVec64, code : BitVec64, metadata : BitVec64, length : BitVec64,
    limit : BitVec64, quantum : BitVec64, rounds : BitVec64) =
    current ∧ authority ∧ profile ∧ (entry=pub108_z()) ∧
    bvugt(code,pub108_z()) ∧ (code=metadata) ∧ bvult(metadata,length) ∧
    bvule(length,limit) ∧ bvugt(quantum,pub108_z()) ∧ bvugt(rounds,pub108_z()) ∧
    bvule(quantum,bvconst(200000,64)) ∧ bvule(rounds,bvconst(10000,64))

define pub108_execute_epoch(before : BitVec64, admitted : Bool) = before

example "execution never changes publication epoch" {
 assert(∀(e : BitVec64). ∀(a : Bool). pub108_execute_epoch(e,a)=e)
}
example "execution requires current receipt and separate authority" {
 assert(∀(c : Bool). ∀(a : Bool). ∀(p : Bool).
   pub108_execute(c,a,p,pub108_z(),bvconst(32,64),bvconst(32,64),bvconst(96,64),bvconst(1048576,64),bvconst(1000,64),bvconst(100,64)) → (c ∧ a ∧ p))
}

example "execution admission: valid" {
 assert(pub108_execute(res108_true(),res108_true(),res108_true(),bvconst(0,64),bvconst(32,64),bvconst(32,64),bvconst(96,64),bvconst(1048576,64),bvconst(1000,64),bvconst(100,64)))
}

example "execution admission: stale receipt" {
 assert(¬(pub108_execute(res108_false(),res108_true(),res108_true(),bvconst(0,64),bvconst(32,64),bvconst(32,64),bvconst(96,64),bvconst(1048576,64),bvconst(1000,64),bvconst(100,64))))
}

example "execution admission: absent authority" {
 assert(¬(pub108_execute(res108_true(),res108_false(),res108_true(),bvconst(0,64),bvconst(32,64),bvconst(32,64),bvconst(96,64),bvconst(1048576,64),bvconst(1000,64),bvconst(100,64))))
}

example "execution admission: profile substitution" {
 assert(¬(pub108_execute(res108_true(),res108_true(),res108_false(),bvconst(0,64),bvconst(32,64),bvconst(32,64),bvconst(96,64),bvconst(1048576,64),bvconst(1000,64),bvconst(100,64))))
}

example "execution admission: nonzero entry" {
 assert(¬(pub108_execute(res108_true(),res108_true(),res108_true(),bvconst(8,64),bvconst(32,64),bvconst(32,64),bvconst(96,64),bvconst(1048576,64),bvconst(1000,64),bvconst(100,64))))
}

example "execution admission: empty code" {
 assert(¬(pub108_execute(res108_true(),res108_true(),res108_true(),bvconst(0,64),bvconst(0,64),bvconst(32,64),bvconst(96,64),bvconst(1048576,64),bvconst(1000,64),bvconst(100,64))))
}

example "execution admission: metadata gap" {
 assert(¬(pub108_execute(res108_true(),res108_true(),res108_true(),bvconst(0,64),bvconst(32,64),bvconst(40,64),bvconst(96,64),bvconst(1048576,64),bvconst(1000,64),bvconst(100,64))))
}

example "execution admission: no metadata" {
 assert(¬(pub108_execute(res108_true(),res108_true(),res108_true(),bvconst(0,64),bvconst(32,64),bvconst(32,64),bvconst(32,64),bvconst(1048576,64),bvconst(1000,64),bvconst(100,64))))
}

example "execution admission: over profile limit" {
 assert(¬(pub108_execute(res108_true(),res108_true(),res108_true(),bvconst(0,64),bvconst(32,64),bvconst(32,64),bvconst(96,64),bvconst(64,64),bvconst(1000,64),bvconst(100,64))))
}

example "execution admission: zero quantum" {
 assert(¬(pub108_execute(res108_true(),res108_true(),res108_true(),bvconst(0,64),bvconst(32,64),bvconst(32,64),bvconst(96,64),bvconst(1048576,64),bvconst(0,64),bvconst(100,64))))
}

example "execution admission: zero rounds" {
 assert(¬(pub108_execute(res108_true(),res108_true(),res108_true(),bvconst(0,64),bvconst(32,64),bvconst(32,64),bvconst(96,64),bvconst(1048576,64),bvconst(1000,64),bvconst(0,64))))
}

example "execution admission: excess quantum" {
 assert(¬(pub108_execute(res108_true(),res108_true(),res108_true(),bvconst(0,64),bvconst(32,64),bvconst(32,64),bvconst(96,64),bvconst(1048576,64),bvconst(200001,64),bvconst(100,64))))
}

example "execution admission: excess rounds" {
 assert(¬(pub108_execute(res108_true(),res108_true(),res108_true(),bvconst(0,64),bvconst(32,64),bvconst(32,64),bvconst(96,64),bvconst(1048576,64),bvconst(1000,64),bvconst(10001,64))))
}

// Explicit C-function process entry: a trusted, exact-image-bound launcher
// executes a real CALL before main. No loader writes the return-authority stack.
// The launcher is sealed in the already-owned trap page after its HALT handler.
// Original application code/metadata and publication bytes remain unchanged.
define pub108_startup_binding(selected : Bool, sealed : Bool, protected : Bool,
 actual_object : BitVec64, bound_object : BitVec64,
 actual_generation : BitVec64, bound_generation : BitVec64,
 actual_code : BitVec64, bound_code : BitVec64,
 actual_image : BitVec64, bound_image : BitVec64, offset : BitVec64, entry : BitVec64) =
 selected ∧ sealed ∧ protected ∧ (actual_object=bound_object) ∧
 (actual_generation=bound_generation) ∧ (actual_code=bound_code) ∧
 (actual_image=bound_image) ∧ (offset=pub108_z()) ∧ (entry=pub108_z()) ∧
 bvugt(actual_code,pub108_z()) ∧ bvult(actual_code,actual_image)
define pub108_startup_return(bound : Bool, actual_call : Bool, live_launcher : Bool,
 frames_retired : Bool, target_matches : Bool) =
 bound ∧ actual_call ∧ live_launcher ∧ frames_retired ∧ target_matches
example "startup cannot authorize RET without actual CALL" {
 assert(∀(b : Bool). ∀(l : Bool). ∀(f : Bool). ∀(t : Bool).
  ¬(pub108_startup_return(b,res108_false(),l,f,t)))
}
example "startup requires retired main frame" {
 assert(∀(b : Bool). ∀(c : Bool). ∀(l : Bool). ∀(t : Bool).
  ¬(pub108_startup_return(b,c,l,res108_false(),t)))
}

example "startup: exact binding" { assert(pub108_startup_binding(res108_true(),res108_true(),res108_true(),bvconst(7,64),bvconst(7,64),bvconst(2,64),bvconst(2,64),bvconst(64,64),bvconst(64,64),bvconst(128,64),bvconst(128,64),bvconst(0,64),bvconst(0,64))) }

example "startup: absent selection" { assert(¬(pub108_startup_binding(res108_false(),res108_true(),res108_true(),bvconst(7,64),bvconst(7,64),bvconst(2,64),bvconst(2,64),bvconst(64,64),bvconst(64,64),bvconst(128,64),bvconst(128,64),bvconst(0,64),bvconst(0,64)))) }

example "startup: unsealed" { assert(¬(pub108_startup_binding(res108_true(),res108_false(),res108_true(),bvconst(7,64),bvconst(7,64),bvconst(2,64),bvconst(2,64),bvconst(64,64),bvconst(64,64),bvconst(128,64),bvconst(128,64),bvconst(0,64),bvconst(0,64)))) }

example "startup: legacy image" { assert(¬(pub108_startup_binding(res108_true(),res108_true(),res108_false(),bvconst(7,64),bvconst(7,64),bvconst(2,64),bvconst(2,64),bvconst(64,64),bvconst(64,64),bvconst(128,64),bvconst(128,64),bvconst(0,64),bvconst(0,64)))) }

example "startup: wrong object" { assert(¬(pub108_startup_binding(res108_true(),res108_true(),res108_true(),bvconst(8,64),bvconst(7,64),bvconst(2,64),bvconst(2,64),bvconst(64,64),bvconst(64,64),bvconst(128,64),bvconst(128,64),bvconst(0,64),bvconst(0,64)))) }

example "startup: stale generation" { assert(¬(pub108_startup_binding(res108_true(),res108_true(),res108_true(),bvconst(7,64),bvconst(7,64),bvconst(3,64),bvconst(2,64),bvconst(64,64),bvconst(64,64),bvconst(128,64),bvconst(128,64),bvconst(0,64),bvconst(0,64)))) }

example "startup: changed code" { assert(¬(pub108_startup_binding(res108_true(),res108_true(),res108_true(),bvconst(7,64),bvconst(7,64),bvconst(2,64),bvconst(2,64),bvconst(72,64),bvconst(64,64),bvconst(128,64),bvconst(128,64),bvconst(0,64),bvconst(0,64)))) }

example "startup: changed image" { assert(¬(pub108_startup_binding(res108_true(),res108_true(),res108_true(),bvconst(7,64),bvconst(7,64),bvconst(2,64),bvconst(2,64),bvconst(64,64),bvconst(64,64),bvconst(136,64),bvconst(128,64),bvconst(0,64),bvconst(0,64)))) }

example "startup: interior offset" { assert(¬(pub108_startup_binding(res108_true(),res108_true(),res108_true(),bvconst(7,64),bvconst(7,64),bvconst(2,64),bvconst(2,64),bvconst(64,64),bvconst(64,64),bvconst(128,64),bvconst(128,64),bvconst(8,64),bvconst(0,64)))) }

example "startup: nonzero entry" { assert(¬(pub108_startup_binding(res108_true(),res108_true(),res108_true(),bvconst(7,64),bvconst(7,64),bvconst(2,64),bvconst(2,64),bvconst(64,64),bvconst(64,64),bvconst(128,64),bvconst(128,64),bvconst(0,64),bvconst(8,64)))) }

example "startup return: all return guards" { assert(pub108_startup_return(res108_true(),res108_true(),res108_true(),res108_true(),res108_true())) }

example "startup return: binding" { assert(¬(pub108_startup_return(res108_false(),res108_true(),res108_true(),res108_true(),res108_true()))) }

example "startup return: actual CALL" { assert(¬(pub108_startup_return(res108_true(),res108_false(),res108_true(),res108_true(),res108_true()))) }

example "startup return: launcher generation" { assert(¬(pub108_startup_return(res108_true(),res108_true(),res108_false(),res108_true(),res108_true()))) }

example "startup return: frame retirement" { assert(¬(pub108_startup_return(res108_true(),res108_true(),res108_true(),res108_false(),res108_true()))) }

example "startup return: return target" { assert(¬(pub108_startup_return(res108_true(),res108_true(),res108_true(),res108_true(),res108_false()))) }
