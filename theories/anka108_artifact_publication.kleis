example "law: link order cannot substitute epoch or position" {
 assert(∀(p : BitVec64). ∀(q : BitVec64). ∀(e : BitVec64). ∀(f : BitVec64).
   (pub108_link_order(p,q,e,f) → ((p=q) ∧ (e=f) ∧ bvugt(e,pub108_z()))))
}
example "law: link dispatch requires execution authority" {
 assert(∀(n : BitVec64). ∀(p : BitVec8). ∀(a : Bool). ∀(v : Bool).
   ∀(o : Bool). ∀(s : Bool). ∀(c : Bool).
   (pub108_link_dispatch(n,p,a,v,o,s,c) → a))
}
example "law: link dispatch excludes compiler producer ABI profile" {
 assert(∀(n : BitVec64). ∀(a : Bool). ∀(v : Bool). ∀(o : Bool). ∀(s : Bool). ∀(c : Bool).
   ¬pub108_link_dispatch(n,bvconst(2,8),a,v,o,s,c))
}
example "law: retained linked output stays inside reserved bytes" {
 assert(∀(d : Bool). ∀(g : Bool). ∀(e : Bool). ∀(i : Bool).
   ∀(p : BitVec8). ∀(q : BitVec8). ∀(n : BitVec64). ∀(r : BitVec64).
   (pub108_link_retain(d,g,e,i,p,q,n,r) → (bvule(n,r) ∧ (p=q) ∧ i)))
}

// Linked publication transfers already-charged host custody, then adds a
// separately charged immutable heap artifact. Commit linearizes at one record
// insertion; source module records are preserved. This is in-memory persistence,
// not disk durability and not application execution admission.
define pub108_link_commit(expected : BitVec64, epoch : BitVec64,
    authority : Bool, live_custodian : Bool, current_inputs : Bool,
    validated_link : Bool, read_only_artifact : Bool, host_charge : Bool,
    heap_charge : Bool, fresh_object : Bool, private_result : Bool) =
    (expected=epoch) ∧ bvult(epoch,bvsub(pub108_z(),pub108_one())) ∧
    authority ∧ live_custodian ∧ current_inputs ∧ validated_link ∧
    read_only_artifact ∧ host_charge ∧ heap_charge ∧ fresh_object ∧ private_result

define pub108_link_epoch(commit : Bool, old : BitVec64) =
    if commit then bvadd(old,pub108_one()) else old

define pub108_link_access(live : Bool, host_charge : Bool, heap_live : Bool,
    current_inputs : Bool, exact_bytes : Bool, profile_bound : Bool) =
    live ∧ host_charge ∧ heap_live ∧ current_inputs ∧ exact_bytes ∧ profile_bound

example "law: failed link publication preserves epoch" {
 assert(∀(e : BitVec64). pub108_link_epoch(res108_false(),e)=e)
}
example "law: linked publication cannot wrap epoch" {
 assert(∀(e : BitVec64). ∀(a : Bool). ∀(l : Bool). ∀(i : Bool).
   ∀(v : Bool). ∀(r : Bool). ∀(h : Bool). ∀(b : Bool). ∀(f : Bool). ∀(p : Bool).
   (pub108_link_commit(e,e,a,l,i,v,r,h,b,f,p) →
    bvugt(pub108_link_epoch(res108_true(),e),e)))
}
example "law: revoked dependencies deny linked read" {
 assert(∀(l : Bool). ∀(h : Bool). ∀(b : Bool). ∀(e : Bool). ∀(p : Bool).
   ¬pub108_link_access(l,h,b,res108_false(),e,p))
}

example "linked publication: commit charged read-only result" {
 assert(pub108_link_commit(bvconst(3,64),bvconst(3,64),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true()))
}

example "linked publication: stale epoch" {
 assert(¬(pub108_link_commit(bvconst(2,64),bvconst(3,64),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true(),res108_true())))
}

example "linked publication: authority absent" {
