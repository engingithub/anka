example "init108_binding another owner requires its own receipt" {
    assert(init108_binding(bvconst(50,64),bvconst(50,64),bvconst(12,64),bvconst(12,64),bvconst(9,64),bvconst(9,64),bvconst(102,64),bvconst(102,64),bvconst(8192,64),bvconst(8192,64),bvconst(32,64),bvconst(32,64)))
}

example "init108_publish accepts" {
    assert(init108_publish(init108_trace_binding(),bvconst(1,8),bvconst(32,64),bvconst(32,64),bvconst(7,64),bvconst(7,64),bvconst(1,8),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8)))
}

example "init108_publish rejects different receipt binding" {
    assert(¬(init108_publish((bvconst(0,8)=bvconst(1,8)),bvconst(1,8),bvconst(32,64),bvconst(32,64),bvconst(7,64),bvconst(7,64),bvconst(1,8),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8))))
}

example "init108_publish rejects dirty phase" {
    assert(¬(init108_publish(init108_trace_binding(),bvconst(0,8),bvconst(32,64),bvconst(32,64),bvconst(7,64),bvconst(7,64),bvconst(1,8),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8))))
}

example "init108_publish rejects already published allocation" {
    assert(¬(init108_publish(init108_trace_binding(),bvconst(2,8),bvconst(32,64),bvconst(32,64),bvconst(7,64),bvconst(7,64),bvconst(1,8),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8))))
}

example "init108_publish rejects partial prefix" {
    assert(¬(init108_publish(init108_trace_binding(),bvconst(1,8),bvconst(16,64),bvconst(32,64),bvconst(7,64),bvconst(7,64),bvconst(1,8),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8))))
}

example "init108_publish rejects only logical bytes scrubbed" {
    assert(¬(init108_publish(init108_trace_binding(),bvconst(1,8),bvconst(17,64),bvconst(32,64),bvconst(7,64),bvconst(7,64),bvconst(1,8),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8))))
}

example "init108_publish rejects oversized cursor" {
    assert(¬(init108_publish(init108_trace_binding(),bvconst(1,8),bvconst(48,64),bvconst(32,64),bvconst(7,64),bvconst(7,64),bvconst(1,8),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8))))
}

example "init108_publish rejects stale completion stamp" {
    assert(¬(init108_publish(init108_trace_binding(),bvconst(1,8),bvconst(32,64),bvconst(32,64),bvconst(7,64),bvconst(6,64),bvconst(1,8),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8))))
}

example "init108_publish rejects lost reservation" {
    assert(¬(init108_publish(init108_trace_binding(),bvconst(1,8),bvconst(32,64),bvconst(32,64),bvconst(7,64),bvconst(7,64),bvconst(0,8),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8))))
}

example "init108_publish rejects early reader already admitted" {
    assert(¬(init108_publish(init108_trace_binding(),bvconst(1,8),bvconst(32,64),bvconst(32,64),bvconst(7,64),bvconst(7,64),bvconst(1,8),bvconst(1,64),bvconst(0,64),bvconst(1,8),bvconst(1,8))))
}

example "init108_publish rejects late writer still admitted" {
    assert(¬(init108_publish(init108_trace_binding(),bvconst(1,8),bvconst(32,64),bvconst(32,64),bvconst(7,64),bvconst(7,64),bvconst(1,8),bvconst(0,64),bvconst(1,64),bvconst(1,8),bvconst(1,8))))
}

example "init108_publish rejects bytes or pointer tags not visible" {
    assert(¬(init108_publish(init108_trace_binding(),bvconst(1,8),bvconst(32,64),bvconst(32,64),bvconst(7,64),bvconst(7,64),bvconst(1,8),bvconst(0,64),bvconst(0,64),bvconst(0,8),bvconst(1,8))))
}

example "init108_publish rejects unserialized grant publication" {
    assert(¬(init108_publish(init108_trace_binding(),bvconst(1,8),bvconst(32,64),bvconst(32,64),bvconst(7,64),bvconst(7,64),bvconst(1,8),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(0,8))))
}

example "init108_mutation accepts" {
    assert(init108_mutation(bvconst(1,8),bvconst(7,64),bvconst(1,8),bvconst(1,8)))
}

example "init108_mutation rejects untrusted writer" {
    assert(¬(init108_mutation(bvconst(1,8),bvconst(7,64),bvconst(0,8),bvconst(1,8))))
}

example "init108_mutation rejects counter wrap" {
    assert(¬(init108_mutation(bvconst(1,8),bvsub(ptr107_max(),bvconst(0,64)),bvconst(1,8),bvconst(1,8))))
}

example "init108_mutation rejects unserialized invalidation" {
    assert(¬(init108_mutation(bvconst(1,8),bvconst(7,64),bvconst(1,8),bvconst(0,8))))
}

example "init108_new_read accepts" {
    assert(init108_new_read(bvconst(2,8),bvconst(17,64),bvconst(32,64),bvconst(0,64),bvconst(1,64),bvconst(1,8)))
}

example "init108_new_read rejects read during scrub" {
    assert(¬(init108_new_read(bvconst(1,8),bvconst(17,64),bvconst(32,64),bvconst(0,64),bvconst(1,64),bvconst(1,8))))
}

example "init108_new_read rejects read before scrub" {
    assert(¬(init108_new_read(bvconst(0,8),bvconst(17,64),bvconst(32,64),bvconst(0,64),bvconst(1,64),bvconst(1,8))))
}

example "init108_new_read rejects read rounded padding" {
    assert(¬(init108_new_read(bvconst(2,8),bvconst(17,64),bvconst(32,64),bvconst(17,64),bvconst(1,64),bvconst(1,8))))
}

example "init108_new_read rejects straddling logical end" {
    assert(¬(init108_new_read(bvconst(2,8),bvconst(17,64),bvconst(32,64),bvconst(16,64),bvconst(2,64),bvconst(1,8))))
}

example "init108_new_read rejects invalid authority" {
    assert(¬(init108_new_read(bvconst(2,8),bvconst(17,64),bvconst(32,64),bvconst(0,64),bvconst(1,64),bvconst(0,8))))
}

example "init108_new_read rejects oversized logical allocation" {
    assert(¬(init108_new_read(bvconst(2,8),bvconst(33,64),bvconst(32,64),bvconst(0,64),bvconst(1,64),bvconst(1,8))))
}

example "init108_new_read rejects overflowing width" {
    assert(¬(init108_new_read(bvconst(2,8),bvconst(17,64),bvconst(32,64),bvconst(0,64),bvsub(ptr107_max(),bvconst(0,64)),bvconst(1,8))))
}

example "init108_new_read last logical byte" {
    assert(init108_new_read(bvconst(2,8),bvconst(17,64),bvconst(32,64),bvconst(16,64),bvconst(1,64),bvconst(1,8)))
}

example "init108_write accepts" {
    assert(init108_write(bvconst(2,8),bvconst(9,64),bvconst(9,64),bvconst(1,8),bvconst(1,8)))
}

example "init108_write rejects old DMA or CPU epoch" {
    assert(¬(init108_write(bvconst(2,8),bvconst(8,64),bvconst(9,64),bvconst(1,8),bvconst(1,8))))
}

example "init108_write rejects writer during scrub" {
    assert(¬(init108_write(bvconst(1,8),bvconst(9,64),bvconst(9,64),bvconst(1,8),bvconst(1,8))))
}

example "init108_write rejects writer before scrub" {
    assert(¬(init108_write(bvconst(0,8),bvconst(9,64),bvconst(9,64),bvconst(1,8),bvconst(1,8))))
}

example "init108_write rejects duplicate completion" {
    assert(¬(init108_write(bvconst(2,8),bvconst(9,64),bvconst(9,64),bvconst(0,8),bvconst(1,8))))
}

example "init108_write rejects revoked grant" {
    assert(¬(init108_write(bvconst(2,8),bvconst(9,64),bvconst(9,64),bvconst(1,8),bvconst(0,8))))
}

example "init108_heap_gate accepts" {
    assert(init108_heap_gate((bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8)),bvconst(17,64),bvconst(4096,64),bvconst(4096,64)))
}

example "init108_heap_gate rejects uninitialized memory" {
    assert(¬(init108_heap_gate((bvconst(0,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8)),bvconst(17,64),bvconst(4096,64),bvconst(4096,64))))
}

example "init108_heap_gate rejects unprepared allocation" {
    assert(¬(init108_heap_gate((bvconst(1,8)=bvconst(1,8)),(bvconst(0,8)=bvconst(1,8)),bvconst(17,64),bvconst(4096,64),bvconst(4096,64))))
}

example "init108_heap_gate rejects scrub only logical bytes" {
    assert(¬(init108_heap_gate((bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8)),bvconst(17,64),bvconst(4096,64),bvconst(17,64))))
}

example "init108_heap_gate rejects different rounded backing" {
    assert(¬(init108_heap_gate((bvconst(1,8)=bvconst(1,8)),(bvconst(1,8)=bvconst(1,8)),bvconst(17,64),bvconst(4096,64),bvconst(8192,64))))
}

example "two completed chunks permit publication" {
    assert(init108_trace_publish())
}

example "new valid allocation can actually read" {
    assert(init108_new_read(init108_trace_live(),bvconst(17,64),bvconst(32,64),bvconst(16,64),bvconst(1,64),bvconst(1,8)))
}

example "old payload byte 0 is erased" {
    assert(init108_trace_byte(bvconst(165,8),bvconst(0,64))=bvconst(0,8))
}

example "old payload byte 15 is erased" {
    assert(init108_trace_byte(bvconst(165,8),bvconst(15,64))=bvconst(0,8))
}

example "old payload byte 16 is erased" {
    assert(init108_trace_byte(bvconst(165,8),bvconst(16,64))=bvconst(0,8))
}

example "old payload byte 31 is erased" {
    assert(init108_trace_byte(bvconst(165,8),bvconst(31,64))=bvconst(0,8))
}

example "adjacent live storage is unchanged" {
    assert(init108_trace_byte(bvconst(165,8),bvconst(32,64))=bvconst(165,8))
}

example "new valid pointer cannot recover old secret" {
    assert(¬(init108_trace_byte(bvconst(165,8),bvconst(0,64))=bvconst(165,8)))
}

example "same-owner reuse receives zero rather than prior payload" {
    assert(init108_trace_byte(bvconst(23,8),bvconst(16,64))=bvconst(0,8))
}

example "old physical pointer kind at 8192 is cleared" {
    assert(init108_trace_tag(bvconst(1,8),bvconst(8192,64))=bvconst(0,8))
}

example "old physical pointer kind at 8208 is cleared" {
    assert(init108_trace_tag(bvconst(1,8),bvconst(8208,64))=bvconst(0,8))
}

example "neighbor pointer-cell kind is preserved" {
    assert(init108_trace_tag(bvconst(1,8),bvconst(8224,64))=bvconst(1,8))
}

example "new storage cannot inherit old pointer kind" {
    assert(¬(init108_trace_tag(bvconst(1,8),bvconst(8192,64))=bvconst(1,8)))
}

example "partial scrub cannot become observable" {
    assert(¬(init108_publish(init108_trace_binding(),bvconst(1,8),init108_trace_done1(),bvconst(32,64),init108_trace_version1(),bvconst(6,64),bvconst(1,8),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8))))
}

example "failed scrub does not advance progress" {
    assert(init108_done(init108_chunk(bvconst(1,8),bvconst(0,64),bvconst(16,64),bvconst(32,64),bvconst(5,64),bvconst(4,64),bvconst(1,8),bvconst(1,8)),bvconst(0,64),bvconst(16,64))=bvconst(0,64))
}

example "failed scrub preserves private bytes" {
    assert(init108_byte(init108_chunk(bvconst(1,8),bvconst(0,64),bvconst(16,64),bvconst(32,64),bvconst(5,64),bvconst(4,64),bvconst(1,8),bvconst(1,8)),bvconst(0,64),bvconst(16,64),bvconst(0,64),bvconst(165,8))=bvconst(165,8))
}

example "failed scrub cannot forge completion" {
    assert(¬(init108_publish(init108_trace_binding(),bvconst(1,8),init108_done(init108_chunk(bvconst(1,8),bvconst(0,64),bvconst(16,64),bvconst(32,64),bvconst(5,64),bvconst(4,64),bvconst(1,8),bvconst(1,8)),bvconst(0,64),bvconst(32,64)),bvconst(32,64),bvconst(7,64),bvconst(7,64),bvconst(1,8),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8))))
}

example "intervening trusted write invalidates completed prefix" {
    assert(init108_dirty_done(init108_mutation(bvconst(1,8),bvconst(7,64),bvconst(1,8),bvconst(1,8)),bvconst(32,64))=bvconst(0,64))
}

example "intervening write rejects old receipt" {
    assert(¬(init108_publish(init108_trace_binding(),bvconst(1,8),init108_dirty_done(init108_mutation(bvconst(1,8),bvconst(7,64),bvconst(1,8),bvconst(1,8)),bvconst(32,64)),bvconst(32,64),init108_version(init108_mutation(bvconst(1,8),bvconst(7,64),bvconst(1,8),bvconst(1,8)),bvconst(7,64)),bvconst(7,64),bvconst(1,8),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8))))
}

example "restoring cursor alone cannot restore stale receipt" {
    assert(¬(init108_publish(init108_trace_binding(),bvconst(1,8),bvconst(32,64),bvconst(32,64),init108_version(init108_mutation(bvconst(1,8),bvconst(7,64),bvconst(1,8),bvconst(1,8)),bvconst(7,64)),bvconst(7,64),bvconst(1,8),bvconst(0,64),bvconst(0,64),bvconst(1,8),bvconst(1,8))))
}

example "delayed old write cannot restore secret after scrub" {
    assert(init108_write_byte(init108_write(init108_trace_live(),bvconst(8,64),bvconst(9,64),bvconst(1,8),bvconst(1,8)),bvconst(165,8),init108_trace_byte(bvconst(165,8),bvconst(0,64)))=bvconst(0,8))
}

example "late completion cannot contaminate new allocation" {
    assert(¬(init108_write_byte(init108_write(init108_trace_live(),bvconst(8,64),bvconst(9,64),bvconst(1,8),bvconst(1,8)),bvconst(165,8),init108_trace_byte(bvconst(165,8),bvconst(0,64)))=bvconst(165,8)))
}

example "explicit new initializer determines final contents" {
    assert(init108_overlay((bvconst(1,8)=bvconst(1,8)),bvconst(4,64),bvconst(0,64),bvconst(66,8),init108_trace_byte(bvconst(165,8),bvconst(0,64)))=bvconst(66,8))
}

example "initializer remainder stays zero" {
    assert(init108_overlay((bvconst(1,8)=bvconst(1,8)),bvconst(4,64),bvconst(16,64),bvconst(66,8),init108_trace_byte(bvconst(165,8),bvconst(16,64)))=bvconst(0,8))
}

example "unapproved initializer does not restore old payload" {
    assert(¬(init108_overlay((bvconst(0,8)=bvconst(1,8)),bvconst(4,64),bvconst(0,64),bvconst(165,8),init108_trace_byte(bvconst(165,8),bvconst(0,64)))=bvconst(165,8)))
}

example "different prior secrets yield identical new-allocation bytes" {
    assert(∀(a : BitVec8). ∀(b : BitVec8). ∀(q : BitVec64). bvult(q,bvconst(32,64)) → (init108_trace_byte(a,q)=init108_trace_byte(b,q)))
}

example "every logical byte of the fresh readable allocation is zero" {
    assert(∀(s : BitVec8). ∀(q : BitVec64). init108_new_read(init108_trace_live(),bvconst(17,64),bvconst(32,64),q,bvconst(1,64),bvconst(1,8)) → (init108_trace_byte(s,q)=bvconst(0,8)))
}

example "scrub prefix invariant is inductive for every admitted chunk" {
    assert(∀(d : BitVec64). ∀(c : BitVec64). ∀(n : BitVec64). ∀(q : BitVec64). ∀(old : BitVec8). (init108_chunk(bvconst(1,8),d,c,n,bvconst(5,64),bvconst(5,64),bvconst(1,8),bvconst(1,8)) ∧ bvult(q,bvadd(d,c)) ∧ (¬(bvult(q,d)) ∨ (old=bvconst(0,8)))) → (init108_byte((bvconst(1,8)=bvconst(1,8)),d,c,q,old)=bvconst(0,8)))
}

example "chunk cannot alter any byte outside its exact interval" {
    assert(∀(d : BitVec64). ∀(c : BitVec64). ∀(q : BitVec64). ∀(old : BitVec8). ¬(bvule(d,q) ∧ bvult(bvsub(q,d),c)) → (init108_byte((bvconst(1,8)=bvconst(1,8)),d,c,q,old)=old))
}

example "failed chunk preserves all pointer kinds" {
    assert(∀(b : BitVec64). ∀(d : BitVec64). ∀(c : BitVec64). ∀(cell : BitVec64). ∀(old : BitVec8). init108_tag((bvconst(0,8)=bvconst(1,8)),b,d,c,cell,old)=old)
}

example "completed storage contains no inherited pointer kind" {
    assert(∀(old : BitVec8). ∀(cell : BitVec64). (init108_aligned(cell) ∧ bvuge(cell,bvconst(8192,64)) ∧ bvult(cell,bvconst(8224,64))) → (init108_trace_tag(old,cell)=bvconst(0,8)))
}

example "tag clearing composes with the initialized-prefix invariant" {
    assert(∀(b : BitVec64). ∀(d : BitVec64). ∀(c : BitVec64). ∀(n : BitVec64). ∀(cell : BitVec64). ∀(old : BitVec8). (init108_range(b,n) ∧ init108_chunk(bvconst(1,8),d,c,n,bvconst(5,64),bvconst(5,64),bvconst(1,8),bvconst(1,8)) ∧ kind107_overlap(b,bvadd(d,c),cell) ∧ (¬(kind107_overlap(b,d,cell)) ∨ (old=bvconst(0,8)))) → (init108_tag((bvconst(1,8)=bvconst(1,8)),b,d,c,cell,old)=bvconst(0,8)))
}

example "same approved initializer preserves prior-secret independence" {
    assert(∀(a : BitVec8). ∀(b : BitVec8). ∀(input : BitVec8). ∀(q : BitVec64). bvult(q,bvconst(32,64)) → (init108_overlay((bvconst(1,8)=bvconst(1,8)),bvconst(4,64),q,input,init108_trace_byte(a,q))=init108_overlay((bvconst(1,8)=bvconst(1,8)),bvconst(4,64),q,input,init108_trace_byte(b,q))))
}
