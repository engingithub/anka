example "init108_chunk rejects overrun rounded backing" {
    assert(¬(init108_chunk(bvconst(1,8),bvconst(0,64),bvconst(48,64),bvconst(32,64),bvconst(5,64),bvconst(5,64),bvconst(1,8),bvconst(1,8))))
