    assert(¬(sc110_collect(SC110State(bvconst(31,64),bvconst(3,8),bvconst(0,8),bvconst(2,8),bvconst(4,64),bvconst(67305985,64)),SC110State(bvconst(32,64),bvconst(4,8),bvconst(4,8),bvconst(0,8),bvconst(0,64),bvconst(0,64)),sc110_true(),sc110_true(),bvconst(33,64),bvconst(33,64),bvconst(91,64),bvconst(91,64),bvconst(2,64))))
}

example "FALSE SC110 142 collection cannot reset next ID" {
    assert(¬(¬sc110_collect(SC110State(bvconst(31,64),bvconst(3,8),bvconst(0,8),bvconst(2,8),bvconst(4,64),bvconst(67305985,64)),SC110State(bvconst(32,64),bvconst(4,8),bvconst(4,8),bvconst(0,8),bvconst(0,64),bvconst(0,64)),sc110_true(),sc110_false(),bvconst(33,64),bvconst(0,64),bvconst(91,64),bvconst(91,64),bvconst(0,64))))
}

example "FALSE SC110 143 collection cannot clear fault history" {
    assert(¬(¬sc110_collect(SC110State(bvconst(31,64),bvconst(3,8),bvconst(0,8),bvconst(2,8),bvconst(4,64),bvconst(67305985,64)),SC110State(bvconst(32,64),bvconst(4,8),bvconst(4,8),bvconst(0,8),bvconst(0,64),bvconst(0,64)),sc110_true(),sc110_false(),bvconst(33,64),bvconst(33,64),bvconst(91,64),bvconst(0,64),bvconst(0,64))))
}

example "FALSE SC110 144 submission consumes exactly one ID" {
    assert(¬(sc110_id_step(bvconst(31,64),bvconst(31,64),bvconst(32,64))))
}

example "FALSE SC110 145 submission cannot reuse ID" {
    assert(¬(¬sc110_id_step(bvconst(31,64),bvconst(30,64),bvconst(32,64))))
}

example "FALSE SC110 146 ID exhaustion outside admitted scope" {
    assert(¬(¬sc110_id_step(sc110_max(),sc110_max(),bvconst(0,64))))
}
