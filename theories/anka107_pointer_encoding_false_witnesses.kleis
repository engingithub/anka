example "FALSE invalid profile no dispatch" { assert(¬(¬(encoding107_execute(encoding107_r(bvconst(38,32),bvconst(4,32),bvconst(2,32),bvconst(0,32),bvconst(0,32)),bvconst(0,8),bvconst(1,8))))) }

example "FALSE valid encoding cannot manufacture kind" { assert(¬(¬(encoding107_execute(encoding107_r(bvconst(38,32),bvconst(4,32),bvconst(2,32),bvconst(0,32),bvconst(0,32)),bvconst(1,8),bvconst(0,8))))) }

example "FALSE all R fields round trip" { assert(¬(∀(op : BitVec32). ∀(d : BitVec32). ∀(s : BitVec32). ∀(t : BitVec32). ∀(f : BitVec32). (bvule(op,bvconst(63,32)) ∧ bvule(d,bvconst(15,32)) ∧ bvule(s,bvconst(15,32)) ∧ bvule(t,bvconst(15,32)) ∧ bvule(f,bvconst(16383,32))) → (encoding107_op(encoding107_r(op,d,s,t,f))=op ∧ encoding107_d(encoding107_r(op,d,s,t,f))=d ∧ encoding107_s(encoding107_r(op,d,s,t,f))=s ∧ encoding107_t(encoding107_r(op,d,s,t,f))=t ∧ encoding107_f(encoding107_r(op,d,s,t,f))=f))) }

example "FALSE all I immediates round trip" { assert(¬(∀(bits : BitVec32). bvule(bits,bvconst(262143,32)) → (encoding107_imm(encoding107_i(bvconst(40,32),bvconst(4,32),bvconst(2,32),bits))=bits))) }

example "FALSE assembler rejects oversized register before encoding" { assert(¬(¬(encoding107_r_inputs(bvconst(38,32),bvconst(16,32),bvconst(2,32),bvconst(0,32),bvconst(0,32))))) }

example "FALSE assembler rejects oversized function before encoding" { assert(¬(¬(encoding107_r_inputs(bvconst(38,32),bvconst(4,32),bvconst(2,32),bvconst(0,32),bvconst(16384,32))))) }
