}

example "FALSE-META107-11 release live allocation" {
    assert(¬(ptr107_release(bvconst(7,64),bvconst(2,64),bvconst(7,64),bvconst(2,64),bvconst(1,8),bvconst(0,8),bvconst(1,8))))
