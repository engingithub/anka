// Every assertion must be explicitly disproved; Unknown is failure.
import "anka107_pointer_metadata.kleis"

example "FALSE-META107-1 initial allocation" {
    assert(¬(ptr107_create(bvconst(7,64),bvconst(0,64),bvconst(1,64),bvconst(0,8),bvconst(1,8),bvconst(4096,64),bvconst(32,64),bvconst(1,8),bvconst(1,8))))
}

example "FALSE-META107-2 reuse advances generation" {
    assert(¬(ptr107_create(bvconst(7,64),bvconst(1,64),bvconst(2,64),bvconst(0,8),bvconst(1,8),bvconst(4096,64),bvconst(32,64),bvconst(1,8),bvconst(1,8))))
}

example "FALSE-META107-3 live slot overwrite" {
    assert(ptr107_create(bvconst(7,64),bvconst(1,64),bvconst(2,64),bvconst(1,8),bvconst(1,8),bvconst(4096,64),bvconst(32,64),bvconst(1,8),bvconst(1,8)))
}

example "FALSE-META107-4 reuse same generation" {
