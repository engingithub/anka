}

example "FALSE-META107-5 generation exhausted" {
    assert(ptr107_create(bvconst(7,64),bvsub(bvconst(0,64),bvconst(1,64)),bvconst(2,64),bvconst(0,8),bvconst(1,8),bvconst(4096,64),bvconst(32,64),bvconst(1,8),bvconst(1,8)))
}

example "FALSE-META107-6 zero identity" {
