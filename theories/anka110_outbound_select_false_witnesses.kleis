import "anka110_outbound_select.kleis"

example "hostile: owned live connection" { assert(¬(os110_bound(sk_true(),sk_true(),bvconst(6,64),bvconst(6,64)))) }
example "hostile: foreign connection" { assert(os110_bound(sk_true(),sk_true(),bvconst(6,64),bvconst(7,64))) }
example "hostile: exhausted work or deadline" { assert(os110_bound(sk_true(),sk_false(),bvconst(6,64),bvconst(6,64))) }
example "hostile: SYN without payload" { assert(¬(os110_syn(bvconst(0,8),sk_true(),sk_true(),bvconst(0,64),sk_true()))) }
example "hostile: SYN carries application data" { assert(os110_syn(bvconst(0,8),sk_true(),sk_true(),bvconst(1,64),sk_true())) }
example "hostile: unconfigured SYN route" { assert(os110_syn(bvconst(0,8),sk_true(),sk_false(),bvconst(0,64),sk_true())) }
example "hostile: matching SYN ACK including sequence wrap" { assert(¬(os110_connected(bvconst(1,8),sk_true(),sk_true(),sk_true(),sk_true(),bvconst(0,64),bvconst(4294967295,32),bvconst(0,32),sk_true()))) }
example "hostile: wrong reverse tuple" { assert(os110_connected(bvconst(1,8),sk_true(),sk_false(),sk_true(),sk_true(),bvconst(0,64),bvconst(4294967295,32),bvconst(0,32),sk_true())) }
example "hostile: wrong acknowledgment" { assert(os110_connected(bvconst(1,8),sk_true(),sk_true(),sk_true(),sk_true(),bvconst(0,64),bvconst(4294967295,32),bvconst(1,32),sk_true())) }
example "hostile: FIN or wrong flags" { assert(os110_connected(bvconst(1,8),sk_true(),sk_true(),sk_true(),sk_false(),bvconst(0,64),bvconst(4294967295,32),bvconst(0,32),sk_true())) }
example "hostile: unvalidated headers" { assert(os110_connected(bvconst(1,8),sk_true(),sk_true(),sk_false(),sk_true(),bvconst(0,64),bvconst(4294967295,32),bvconst(0,32),sk_true())) }
example "hostile: early data in handshake" { assert(os110_connected(bvconst(1,8),sk_true(),sk_true(),sk_true(),sk_true(),bvconst(1,64),bvconst(4294967295,32),bvconst(0,32),sk_true())) }
example "hostile: failed final ACK" { assert(os110_connected(bvconst(1,8),sk_true(),sk_true(),sk_true(),sk_true(),bvconst(0,64),bvconst(4294967295,32),bvconst(0,32),sk_false())) }
example "hostile: authorized first short copy" { assert(¬(os110_write(bvconst(2,8),sk_true(),os110_fixture_evidence(bvconst(6,64)),sk_true(),bvconst(0,64),bvconst(0,64),bvconst(64,64),bvconst(112,64),bvconst(64,64)))) }
example "hostile: proof for previous connection" { assert(os110_write(bvconst(2,8),sk_true(),os110_fixture_evidence(bvconst(7,64)),sk_true(),bvconst(0,64),bvconst(0,64),bvconst(64,64),bvconst(112,64),bvconst(64,64))) }
example "hostile: handshake without storage evidence" { assert(os110_write(bvconst(2,8),sk_true(),sk_false(),sk_true(),bvconst(0,64),bvconst(0,64),bvconst(64,64),bvconst(112,64),bvconst(64,64))) }
example "hostile: wrong request suffix" { assert(os110_write(bvconst(2,8),sk_true(),os110_fixture_evidence(bvconst(6,64)),sk_false(),bvconst(0,64),bvconst(0,64),bvconst(64,64),bvconst(112,64),bvconst(64,64))) }
example "hostile: short copy then drain then queue remainder" { assert(¬(os110_emit(bvconst(2,8),sk_true(),sk_true(),sk_true(),bvconst(64,64),bvconst(0,64),bvconst(64,64),bvconst(64,64)) ∧ os110_write(bvconst(2,8),sk_true(),sk_true(),sk_true(),bvconst(64,64),bvconst(64,64),bvconst(64,64),bvconst(48,64),bvconst(48,64)))) }
example "hostile: backpressure cannot accept another byte" { assert(os110_write(bvconst(2,8),sk_true(),sk_true(),sk_true(),bvconst(64,64),bvconst(0,64),bvconst(64,64),bvconst(48,64),bvconst(1,64))) }
example "hostile: cannot queue beyond frozen request" { assert(os110_write(bvconst(2,8),sk_true(),sk_true(),sk_true(),bvconst(100,64),bvconst(100,64),bvconst(64,64),bvconst(13,64),bvconst(13,64))) }
example "hostile: no close on incomplete request" { assert(os110_close(bvconst(2,8),sk_true(),sk_true(),bvconst(111,64),bvconst(111,64),bvconst(64,64))) }
example "hostile: close latches even with 48 pending" { assert(¬(os110_next(bvconst(2,8),os110_close(bvconst(2,8),sk_true(),sk_true(),bvconst(112,64),bvconst(64,64),bvconst(64,64)),bvconst(3,8)))) }
example "hostile: writes rejected as soon as close is latched" { assert(os110_write(bvconst(3,8),sk_true(),os110_fixture_evidence(bvconst(6,64)),sk_true(),bvconst(0,64),bvconst(0,64),bvconst(64,64),bvconst(112,64),bvconst(64,64))) }
example "hostile: in flight prefix on closing stream" { assert(¬(os110_emit(bvconst(3,8),sk_true(),sk_true(),sk_true(),bvconst(112,64),bvconst(64,64),bvconst(64,64),bvconst(48,64)))) }
example "hostile: revocation between enqueue and NIC commit" { assert(os110_emit(bvconst(3,8),sk_true(),sk_false(),sk_true(),bvconst(112,64),bvconst(64,64),bvconst(64,64),bvconst(48,64))) }
example "hostile: uncommitted wire offer keeps cursor" { assert(¬(os110_cursor(bvconst(64,64),bvconst(48,64),os110_emit(bvconst(3,8),sk_true(),sk_true(),sk_false(),bvconst(112,64),bvconst(64,64),bvconst(64,64),bvconst(48,64)),bvconst(64,64)))) }
example "hostile: FIN overtakes last byte" { assert(os110_fin(bvconst(3,8),sk_true(),sk_true(),bvconst(112,64),bvconst(111,64),bvconst(64,64),sk_true())) }
example "hostile: authority lost before FIN" { assert(os110_fin(bvconst(3,8),sk_true(),sk_false(),bvconst(112,64),bvconst(112,64),bvconst(64,64),sk_true())) }
example "hostile: failed FIN stays pending" { assert(¬(os110_next(bvconst(3,8),os110_fin(bvconst(3,8),sk_true(),sk_true(),bvconst(112,64),bvconst(112,64),bvconst(64,64),sk_false()),bvconst(3,8)))) }
example "hostile: committed FIN enables reply" { assert(¬(os110_next(bvconst(3,8),os110_fin(bvconst(3,8),sk_true(),sk_true(),bvconst(112,64),bvconst(112,64),bvconst(64,64),sk_true()),bvconst(4,8)))) }
example "hostile: duplicate logical FIN" { assert(os110_fin(bvconst(4,8),sk_true(),sk_true(),bvconst(112,64),bvconst(112,64),bvconst(64,64),sk_true())) }
example "hostile: ordered RX after complete local half close" { assert(¬(os110_rx(bvconst(4,8),sk_true(),sk_true(),sk_false(),bvconst(64,64),bvconst(0,64),bvconst(0,64),bvconst(64,64)) ∧ os110_rx(bvconst(4,8),sk_true(),sk_true(),sk_false(),bvconst(64,64),bvconst(0,64),bvconst(64,64),bvconst(64,64)) ∧ os110_rx(bvconst(4,8),sk_true(),sk_true(),sk_false(),bvconst(64,64),bvconst(0,64),bvconst(128,64),bvconst(16,64)))) }
example "hostile: receive fragment would overflow" { assert(os110_rx(bvconst(4,8),sk_true(),sk_true(),sk_false(),bvconst(64,64),bvconst(63,64),bvconst(63,64),bvconst(2,64))) }
example "hostile: data after peer FIN" { assert(os110_rx(bvconst(4,8),sk_true(),sk_true(),sk_true(),bvconst(64,64),bvconst(0,64),bvconst(64,64),bvconst(1,64))) }
example "hostile: out of order response fragment" { assert(os110_rx(bvconst(4,8),sk_true(),sk_false(),sk_false(),bvconst(64,64),bvconst(0,64),bvconst(64,64),bvconst(1,64))) }
example "hostile: tail cannot be discarded and salvaged" { assert(os110_terminal(bvconst(4,8),sk_true(),bvconst(144,64),bvconst(0,64),os110_intact(sk_true(),bvconst(144,64),bvconst(1,64)),sk_true())) }
example "hostile: short reply at EOF" { assert(os110_terminal(bvconst(4,8),sk_true(),bvconst(143,64),bvconst(0,64),sk_true(),sk_true())) }
example "hostile: 144 bytes without EOF" { assert(os110_terminal(bvconst(4,8),sk_true(),bvconst(144,64),bvconst(0,64),sk_true(),sk_false())) }
example "hostile: FIN with unread bytes" { assert(os110_terminal(bvconst(4,8),sk_true(),bvconst(144,64),bvconst(1,64),sk_true(),sk_true())) }
example "hostile: guest accepts exact reply after both FINs" { assert(¬(os110_success(bvconst(4,8),sk_true(),bvconst(144,64),bvconst(0,64),sk_true(),sk_true(),N110Frame(bvadd(bvshl(bvconst(3232080,64),bvconst(32,64)),bvconst(1095454273,64)),bvconst(1,64),bvconst(0,64),bvconst(42,64),bvconst(112,64),(bvconst(1,8)=bvconst(1,8)),bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),N110Reply(bvadd(bvshl(bvconst(3232336,64),bvconst(32,64)),bvconst(1095454273,64)),bvconst(1,64),bvconst(0,64),bvconst(42,64),bvconst(144,64),bvconst(0,64),bvconst(8,64),bvconst(99,64),bvconst(8,64),(bvconst(1,8)=bvconst(1,8)),bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),os110_fixture_evidence(bvconst(6,64))))) }
example "hostile: EOF server evidence pertains to different connection" { assert(os110_success(bvconst(4,8),sk_true(),bvconst(144,64),bvconst(0,64),sk_true(),sk_true(),N110Frame(bvadd(bvshl(bvconst(3232080,64),bvconst(32,64)),bvconst(1095454273,64)),bvconst(1,64),bvconst(0,64),bvconst(42,64),bvconst(112,64),(bvconst(1,8)=bvconst(1,8)),bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),N110Reply(bvadd(bvshl(bvconst(3232336,64),bvconst(32,64)),bvconst(1095454273,64)),bvconst(1,64),bvconst(0,64),bvconst(42,64),bvconst(144,64),bvconst(0,64),bvconst(8,64),bvconst(99,64),bvconst(8,64),(bvconst(1,8)=bvconst(1,8)),bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),os110_fixture_evidence(bvconst(7,64)))) }
example "hostile: new connection exact retry after unknown" { assert(¬(os110_retry(sk_true(),bvconst(6,64),bvconst(7,64),bvconst(42,64),bvconst(43,64),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64))))) }
example "hostile: replaying correlation on reconnect" { assert(os110_retry(sk_true(),bvconst(6,64),bvconst(7,64),bvconst(42,64),bvconst(42,64),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)))) }
example "hostile: old stream cannot be reused for retry" { assert(os110_retry(sk_true(),bvconst(6,64),bvconst(6,64),bvconst(42,64),bvconst(43,64),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)))) }
example "hostile: retry changing selected value" { assert(os110_retry(sk_true(),bvconst(6,64),bvconst(7,64),bvconst(42,64),bvconst(43,64),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(99,64),bvconst(0,64)),P109Request(bvconst(10,64),bvconst(20,64),bvconst(3,64),bvconst(30,64),bvconst(4,64),bvconst(1,64),bvconst(7,64),bvconst(1,64),bvconst(98,64),bvconst(0,64)))) }
example "hostile: active open then matched final ACK" { assert(¬(os110_control(bvconst(0,8),bvconst(0,8),sk_true(),sk_true(),sk_true(),sk_true(),sk_true(),bvconst(0,64),bvconst(9,32),bvconst(10,32),sk_false(),bvconst(0,64),bvconst(0,64),bvconst(64,64),sk_true(),bvconst(1,8)) ∧ os110_control(bvconst(1,8),bvconst(1,8),sk_true(),sk_true(),sk_true(),sk_true(),sk_true(),bvconst(0,64),bvconst(9,32),bvconst(10,32),sk_false(),bvconst(0,64),bvconst(0,64),bvconst(64,64),sk_true(),bvconst(2,8)))) }
example "hostile: close before final drain then commit FIN" { assert(¬(os110_control(bvconst(2,8),bvconst(2,8),sk_true(),sk_true(),sk_true(),sk_true(),sk_true(),bvconst(0,64),bvconst(9,32),bvconst(10,32),sk_true(),bvconst(112,64),bvconst(64,64),bvconst(64,64),sk_true(),bvconst(3,8)) ∧ os110_control(bvconst(3,8),bvconst(3,8),sk_true(),sk_true(),sk_true(),sk_true(),sk_true(),bvconst(0,64),bvconst(9,32),bvconst(10,32),sk_true(),bvconst(112,64),bvconst(64,64),bvconst(64,64),sk_true(),bvconst(3,8)) ∧ os110_control(bvconst(3,8),bvconst(3,8),sk_true(),sk_true(),sk_true(),sk_true(),sk_true(),bvconst(0,64),bvconst(9,32),bvconst(10,32),sk_true(),bvconst(112,64),bvconst(112,64),bvconst(64,64),sk_true(),bvconst(4,8)))) }
example "hostile: early close cannot skip handshake" { assert(¬(os110_control(bvconst(1,8),bvconst(2,8),sk_true(),sk_true(),sk_true(),sk_true(),sk_true(),bvconst(0,64),bvconst(9,32),bvconst(10,32),sk_true(),bvconst(112,64),bvconst(112,64),bvconst(64,64),sk_true(),bvconst(1,8)))) }
example "hostile: revoked FIN event cannot advance" { assert(¬(os110_control(bvconst(3,8),bvconst(3,8),sk_true(),sk_true(),sk_true(),sk_true(),sk_true(),bvconst(0,64),bvconst(9,32),bvconst(10,32),sk_false(),bvconst(112,64),bvconst(112,64),bvconst(64,64),sk_true(),bvconst(3,8)))) }
example "hostile: late handshake does not reopen RX-only connection" { assert(¬(os110_control(bvconst(4,8),bvconst(1,8),sk_true(),sk_true(),sk_true(),sk_true(),sk_true(),bvconst(0,64),bvconst(9,32),bvconst(10,32),sk_true(),bvconst(0,64),bvconst(0,64),bvconst(64,64),sk_true(),bvconst(4,8)))) }
